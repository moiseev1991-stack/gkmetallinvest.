# ============================================================================
#  gkmetallinvest.ru — 301-редиректы со старого сайта (uCoz) на новый (Astro)
#  Хостинг: Timeweb (Apache). Файл кладётся в public/ → копируется в корень dist/
#  Формат: RedirectMatch (mod_alias), якоря ^...$ + опциональный слэш /?$
#  Цели — абсолютные https-адреса: Apache стоит за nginx и видит запрос как
#  http, поэтому относительная цель превращается в http:// и даёт лишний круг.
#  На Vercel этот файл игнорируется — активен только на Apache.
# ============================================================================

# --- Канонический хост: техдомены (cv724723.tw1.ru, www и пр.) → основной -----
#  Любой запрос с хостом ≠ gkmetallinvest.ru отправляем 301 на основной домен,
#  чтобы поисковик не индексировал технические зеркала как дубли.
#  /.well-known/ исключаем — на случай ACME-проверки сертификата.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{HTTP_HOST} !^gkmetallinvest\.ru$ [NC]
  RewriteRule ^ https://gkmetallinvest.ru%{REQUEST_URI} [L,R=301]

  # --- http → https -----------------------------------------------------------
  #  Timeweb снимает HTTPS на nginx и сообщает Apache об https заголовком
  #  X-HTTPS: 1 (справка Timeweb «Типовые перенаправления»). Ошибись условие —
  #  вся https-версия уйдёт в бесконечный редирект; условие проверено на живом
  #  сайте 2026-09-26 (http → 301, https → без редиректа).
  #  Три признака https через «И»: редирект только если нет ни одного.
  RewriteCond %{REQUEST_URI} !^/\.well-known/ [NC]
  RewriteCond %{HTTP:X-HTTPS} !1
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteCond %{HTTPS} !on
  RewriteRule ^ https://gkmetallinvest.ru%{REQUEST_URI} [L,R=301]

  # --- Папка без слэша (/uslugi) → со слэшем, сразу на https -----------------
  #  Иначе слэш дописывает mod_dir и по той же причине отдаёт http://.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+[^/])$ https://gkmetallinvest.ru/$1/ [L,R=301]
</IfModule>

# --- Каталог: гео-фиксы Перми на новых слагах (должны идти ДО catch-all) ------
RedirectMatch 301 ^/list/v-perme/?$             https://gkmetallinvest.ru/list-nerzhaveyushchiy/v-permi/
RedirectMatch 301 ^/truba/v-perme/?$            https://gkmetallinvest.ru/truba-nerzhaveyushchaya/v-permi/
RedirectMatch 301 ^/krug/v-perme/?$             https://gkmetallinvest.ru/krug-nerzhaveyushchiy/v-permi/
RedirectMatch 301 ^/rulon/v-perme/?$            https://gkmetallinvest.ru/rulon-nerzhaveyushchiy/v-permi/
RedirectMatch 301 ^/polosa/v-perme/?$           https://gkmetallinvest.ru/polosa-nerzhaveyushchaya/v-permi/
RedirectMatch 301 ^/provoloka/v-perme/?$        https://gkmetallinvest.ru/provoloka-nerzhaveyushchaya/v-permi/
RedirectMatch 301 ^/ugolok-shveller/v-perme/?$  https://gkmetallinvest.ru/ugolok-shveller-nerzhaveyushchiy/v-permi/
RedirectMatch 301 ^/detali-truboprovoda/v-perme/?$  https://gkmetallinvest.ru/detali-truboprovoda/v-permi/

# --- Каталог: переименование слагов под ключи (старый слаг → новый) -----------
RedirectMatch 301 ^/list(/.*)?$                 https://gkmetallinvest.ru/list-nerzhaveyushchiy$1
RedirectMatch 301 ^/rulon(/.*)?$                https://gkmetallinvest.ru/rulon-nerzhaveyushchiy$1
RedirectMatch 301 ^/krug(/.*)?$                 https://gkmetallinvest.ru/krug-nerzhaveyushchiy$1
RedirectMatch 301 ^/truba(/.*)?$                https://gkmetallinvest.ru/truba-nerzhaveyushchaya$1
RedirectMatch 301 ^/polosa(/.*)?$               https://gkmetallinvest.ru/polosa-nerzhaveyushchaya$1
RedirectMatch 301 ^/provoloka(/.*)?$            https://gkmetallinvest.ru/provoloka-nerzhaveyushchaya$1
RedirectMatch 301 ^/ugolok-shveller(/.*)?$      https://gkmetallinvest.ru/ugolok-shveller-nerzhaveyushchiy$1

# --- Каталог: uCoz-пути -------------------------------------------------------
RedirectMatch 301 ^/provolokanerzh/?$           https://gkmetallinvest.ru/provoloka-nerzhaveyushchaya/
RedirectMatch 301 ^/(lenta|catalog/lenta|cataloglent)/?$   https://gkmetallinvest.ru/lenta-nerzhaveyushchaya/
RedirectMatch 301 ^/folga/?$                    https://gkmetallinvest.ru/folga-nerzhaveyushchaya/
RedirectMatch 301 ^/catalog/truba/?$            https://gkmetallinvest.ru/truba-nerzhaveyushchaya/
RedirectMatch 301 ^/catalog/krug/prutok/?$      https://gkmetallinvest.ru/krug-nerzhaveyushchiy/
RedirectMatch 301 ^/(listdeco|ral/08u)/?$       https://gkmetallinvest.ru/dekorativnye-listy/

# --- Услуги ------------------------------------------------------------------
RedirectMatch 301 ^/(uslugi/rezka|peremotkanerjaveyki)/?$   https://gkmetallinvest.ru/uslugi/rezka-rulonov/
RedirectMatch 301 ^/uslugi/perforation/?$       https://gkmetallinvest.ru/uslugi/perforaciya-listov/
RedirectMatch 301 ^/shlifovka/polirovka/?$      https://gkmetallinvest.ru/uslugi/polirovka/

# --- Тематические запасные ---------------------------------------------------
RedirectMatch 301 ^/nerjaveykaizkitaya/?$       https://gkmetallinvest.ru/postavka-nerzhaveyushchego-metalloprokata/
RedirectMatch 301 ^/all/?$                       https://gkmetallinvest.ru/karta-sayta/
RedirectMatch 301 ^/alyuminiy/?$                 https://gkmetallinvest.ru/
RedirectMatch 301 ^/vacancy/?$                   https://gkmetallinvest.ru/kontakty/
RedirectMatch 301 ^/contacts/?$                  https://gkmetallinvest.ru/kontakty/
RedirectMatch 301 ^/policy/?$                    https://gkmetallinvest.ru/politika-konfidencialnosti/
RedirectMatch 301 ^/publicoffer/?$               https://gkmetallinvest.ru/publichnaya-oferta/

# --- Оборудование и услуги, которых нет на новом сайте → раздел «Услуги» -------
RedirectMatch 301 ^/(oborudovanie|vseoborudovanie|gibka)/?$   https://gkmetallinvest.ru/uslugi/
RedirectMatch 301 ^/(laser|lasertrub)/?$         https://gkmetallinvest.ru/uslugi/lazernaya-rezka/
RedirectMatch 301 ^/gidroabraziv/?$              https://gkmetallinvest.ru/uslugi/gidroabrazivnaya-rezka/

# --- Старые uCoz-страницы pageXXXX.html --------------------------------------
RedirectMatch 301 ^/page69390555\.html$          https://gkmetallinvest.ru/truba-nerzhaveyushchaya/
RedirectMatch 301 ^/page70855587\.html$          https://gkmetallinvest.ru/uslugi/perforaciya-listov/
RedirectMatch 301 ^/(page70854427|page70854587|page70854803|page70854999|page70855333)\.html$   https://gkmetallinvest.ru/uslugi/
RedirectMatch 301 ^/(page67050501|page69346493|page70855153|page70855255|page70855399|page70855439|page70855511)\.html$   https://gkmetallinvest.ru/postavka-nerzhaveyushchego-metalloprokata/
