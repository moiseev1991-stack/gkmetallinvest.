{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/pagefind/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/slaider/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/produkt/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    }
  ],
  "redirects": [
    { "source": "/policy", "destination": "/politika-konfidencialnosti/", "permanent": true },
    { "source": "/policy/", "destination": "/politika-konfidencialnosti/", "permanent": true },
    { "source": "/publicoffer", "destination": "/publichnaya-oferta/", "permanent": true },
    { "source": "/publicoffer/", "destination": "/publichnaya-oferta/", "permanent": true },
    { "source": "/all", "destination": "/postavka-nerzhaveyushchego-metalloprokata/", "permanent": true },
    { "source": "/list", "destination": "/list/", "permanent": true },
    { "source": "/catalog/truba", "destination": "/truba/", "permanent": true },
    { "source": "/catalog/krug/prutok", "destination": "/krug/", "permanent": true },
    { "source": "/catalog/lenta", "destination": "/lenta-nerzhaveyushchaya/", "permanent": true },
    { "source": "/lenta", "destination": "/lenta-nerzhaveyushchaya/", "permanent": true },
    { "source": "/lenta/", "destination": "/lenta-nerzhaveyushchaya/", "permanent": true },
    { "source": "/rulon", "destination": "/rulon/", "permanent": true },
    { "source": "/listdeco", "destination": "/dekorativnye-listy/", "permanent": true },
    { "source": "/uslugi/perforation", "destination": "/uslugi/perforaciya-listov/", "permanent": true },
    { "source": "/list/v-perme/", "destination": "/list/v-permi/", "permanent": true },
    { "source": "/truba/v-perme/", "destination": "/truba/v-permi/", "permanent": true },
    { "source": "/krug/v-perme/", "destination": "/krug/v-permi/", "permanent": true },
    { "source": "/rulon/v-perme/", "destination": "/rulon/v-permi/", "permanent": true },
    { "source": "/polosa/v-perme/", "destination": "/polosa/v-permi/", "permanent": true },
    { "source": "/provoloka/v-perme/", "destination": "/provoloka/v-permi/", "permanent": true },
    { "source": "/ugolok-shveller/v-perme/", "destination": "/ugolok-shveller/v-permi/", "permanent": true },
    { "source": "/detali-truboprovoda/v-perme/", "destination": "/detali-truboprovoda/v-permi/", "permanent": true }
  ]
}
