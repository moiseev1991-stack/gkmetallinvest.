---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any).truba as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Чем бесшовная труба отличается от ЭСВ?',
		a: 'Бесшовная труба производится прокаткой/прошивкой заготовки без сварного шва — выдерживает высокие давления и нагрузки. ГОСТ 9941, AISI 304/316L/321. Электросварная (ЭСВ) — лист сворачивается и сваривается продольным швом. Дешевле, проще в производстве, подходит для интерьеров, мебели, средне­нагруженных систем.',
	},
	{
		q: 'Какие диаметры и стенки есть в наличии?',
		a: 'Бесшовные: Ø 6–273 мм, стенка 2–16 мм. Электросварные круглые: Ø 8–219 мм, стенка 1–6 мм. Квадратные: 10×10 … 120×120 мм. Прямоугольные: 20×10 … 200×100 мм. Для нестандартных размеров — изготовление под заявку.',
	},
	{
		q: 'Можно ли заказать резку трубы в размер?',
		a: 'Да, режем трубы в размер от 1 шт с точностью ±1 мм — дисковыми и ленточными пилами. Возможна полировка торцов, фасонная резка под углом.',
	},
	{
		q: 'Подходит ли труба AISI 304 для пищевой промышленности?',
		a: 'Да, AISI 304 — базовая марка для пищевых трубопроводов и оборудования. Для контакта с кислотами, маринадами, рассолами лучше брать AISI 316L (молибден улучшает коррозионную стойкость). Для CIP-моек и стерильных сред — полированная Ra ≤ 0,8 мкм.',
	},
	{
		q: 'Какие документы выдаются на партию трубы?',
		a: 'Сертификат завода (ГОСТ 9941, ГОСТ 11068, EN 10217, ASTM A312), паспорт качества с результатами гидроиспытания, маркировка плавки и партии. Документы — оригиналы в груз или ЭДО.',
	},
	{
		q: 'Сроки доставки трубы по России?',
		a: 'Москва 1–2 дня, СПб 2–3, Урал 3–4, Сибирь 5–7 рабочих дней. Возим автотранспортом, ж/д контейнерами и ТК. Длинномер до 12 м — собственными машинами или специализированным транспортом ТК.',
	},
];
---

<CatalogHubTemplate
	title="Труба нержавеющая — бесшовная и ЭСВ, цена за тонну в Нижнем Новгороде"
	description="Труба нержавеющая бесшовная ГОСТ 9941, электросварная AISI круглая/квадратная/прямоугольная, перфорированная. Ø 6–273 мм, стенка 1–16 мм. 1048 позиций."
	h1="Труба нержавеющая"
	intro={`Бесшовные трубы по ГОСТ 9941 (Ø 6–273, стенка 2–16 мм) и электросварные AISI — круглые, квадратные, прямоугольные, перфорированные. Никелесодержащие марки AISI 304, 316L, 321 и 12Х18Н10Т, ферритная AISI 430. Самый большой раздел нашего прайса — ${skus.length} позиций со склада в Нижнем Новгороде.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Труба нержавеющая' }]}
	hubHref="/truba/"
	hubLabel="Труба нержавеющая"
	faq={faq}
>
	<PriceTable hub="truba" title="Прайс на трубу нержавеющую" measure="Ø × стенка" />

	<HubExtras
		hubHref="/truba/"
		hubLabel="Труба нержавеющая"
		hubLabelGenitive="трубу нержавеющую"
		grades={grades}
	/>

	<section class="block">
		<h2>Что входит в раздел</h2>
		<ul class="list-plain">
			<li><strong>Бесшовные трубы</strong> ГОСТ 9941 — горячекатаные и холоднокатаные, для нагнетания и пара. Ø 6–273 мм, стенка 1–16 мм</li>
			<li><strong>Электросварные круглые</strong> — AISI 304/304L/316L/321/430. Ø 8–219 мм, стенка 1–6 мм. Для пищевой промышленности и интерьеров</li>
			<li><strong>Электросварные квадратные</strong> — 10×10…120×120, для каркасов и мебели</li>
			<li><strong>Электросварные прямоугольные</strong> — 20×10…200×100, для архитектуры и оборудования</li>
			<li><strong>Перфорированные</strong> — с круглой и щелевой перфорацией под фильтры и дренаж</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Пищевая, фарма, парфюмерия — технологические трубопроводы (AISI 304, 316L)</li>
			<li>Молочная, пивоваренная — стерильные линии и CIP (AISI 316L полированная)</li>
			<li>Архитектура — перила, ограждения, мебель (зеркало BA + полировка)</li>
			<li>Котельная и пароводы — высокотемпературные среды до 600 °C (AISI 321 / 12Х18Н10Т)</li>
			<li>Морская и химия — стойкость к хлоридам и кислотам (AISI 316L, 904L)</li>
		</ul>
	</section>

	<section class="block">
		<h2>Обработка</h2>
		<p>
			Резка в размер от 1 шт ±1 мм. Полировка наружная — до зеркала Ra ≤ 0,4 мкм.
			Электрохимическая полировка для пищевых линий. Гибка трубогибом — по чертежу.
		</p>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода — ГОСТ 9941, ГОСТ 11068, EN 10217 / ASTM A312</li>
			<li>Гидроиспытание под давлением, паспорт на партию</li>
			<li>Маркировка плавки и партии</li>
			<li>Отгрузка из Нижнего Новгорода, доставка автотранспортом, ж/д, ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
	.block p a { color: var(--color-primary-600); }
</style>
