---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteUrl } from '../../data/site';

const title = 'Справочник — нержавеющая сталь: типы, отличия, обозначения';
const description = 'Что такое нержавеющая сталь (нержавейка, inox, инокс). Аустенитные, ферритные, мартенситные и дуплексные марки — состав, свойства, магнитные качества и применение.';

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: [
		{
			'@type': 'Question',
			name: 'Что такое нержавеющая сталь?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Нержавеющая сталь (нержавейка, inox, инокс) — группа коррозионно-стойких сталей с содержанием хрома не ниже 10,5%. Хром образует на поверхности пассивную плёнку Cr₂O₃, защищающую металл от ржавчины.',
			},
		},
		{
			'@type': 'Question',
			name: 'Магнитится ли нержавейка?',
			acceptedAnswer: {
				'@type': 'Answer',
				text: 'Зависит от структуры. Аустенитные марки (AISI 304, 316L, 321) в свежекатаном состоянии не магнитятся. После холодного наклёпа часть аустенита переходит в мартенсит, и материал может слабо притягивать магнит. Ферритные (AISI 430) и мартенситные (20Х13, 40Х13) марки магнитятся всегда.',
			},
		},
	],
};

const breadcrumbsJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Главная', item: `${siteUrl}/` },
		{ '@type': 'ListItem', position: 2, name: 'Справочник', item: `${siteUrl}/spravochnik/` },
	],
};
---

<BaseLayout
	title={title}
	description={description}
	canonical="/spravochnik/"
	jsonLd={[faqJsonLd, breadcrumbsJsonLd]}
>
	<section class="section seo-info" aria-labelledby="seo-info-title">
		<div class="container">
			<span class="eyebrow">Справочник</span>
			<h1 id="seo-info-title" class="section-title">Что такое нержавеющая сталь — типы, отличия, обозначения</h1>
			<p class="section-sub">Кратко о терминологии: нержавейка, нержавеющая сталь, inox, инокс — это синонимы. Разбираемся, какие бывают виды нержавейки и чем они отличаются по структуре.</p>

			<div class="seo-info__lead">
				<p>
					Нержавеющая сталь (она же <strong>нержавейка</strong>, в международной маркировке — <strong>inox</strong>, в русской транскрипции — <strong>инокс</strong>) — это группа коррозионно-стойких сталей с содержанием хрома не ниже 10,5 %. Именно хром образует на поверхности тонкую пассивную плёнку оксида Cr₂O₃, которая защищает металл от ржавчины. По структуре кристаллической решётки выделяют 4 основных типа.
				</p>
			</div>

			<div class="seo-info__grid">
				<article class="seo-info__card">
					<h2 class="seo-info__h">Аустенитная сталь</h2>
					<p class="seo-info__type">Cr-Ni, γ-Fe, не магнитная</p>
					<p class="seo-info__text">
						Самый распространённый класс — содержит 16–26 % хрома и 6–22 % никеля. Аустенитная сталь пластична, отлично сваривается, держит температуру до 800 °C. Марки: <a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a> (08Х18Н10), AISI 316L (для агрессивных сред с хлоридами), AISI 321 (12Х18Н10Т, со стабилизацией титаном).
					</p>
				</article>

				<article class="seo-info__card">
					<h2 class="seo-info__h">Ферритная сталь</h2>
					<p class="seo-info__type">Cr без Ni, α-Fe, магнитная</p>
					<p class="seo-info__text">
						Содержит 12–18 % хрома, никеля почти нет. Ферритная сталь дешевле аустенитной за счёт отсутствия дорогого никеля, магнитится, хорошо штампуется. Основная марка — <a href="/list-nerzhaveyushchiy/aisi-430/">AISI 430</a> (08Х17). Применяется в декоре, бытовой технике, выхлопных системах.
					</p>
				</article>

				<article class="seo-info__card">
					<h2 class="seo-info__h">Мартенситная сталь</h2>
					<p class="seo-info__type">Cr + повышенный C, твёрдая, магнитная</p>
					<p class="seo-info__text">
						Содержит 12–17 % хрома и углерод 0,1–1,2 %. Мартенситная сталь твёрдая, прочная, но плохо варится и менее коррозионно-стойкая. Марки: 20Х13, 30Х13, 40Х13, AISI 420, AISI 440. Идёт на ножи, медицинский инструмент, валы насосов.
					</p>
				</article>

				<article class="seo-info__card">
					<h2 class="seo-info__h">Дуплексная сталь</h2>
					<p class="seo-info__type">50/50 аустенит + феррит, двухфазная</p>
					<p class="seo-info__text">
						Дуплексная сталь сочетает структуру аустенита и феррита в пропорции около 50/50. Это даёт прочность вдвое выше, чем у AISI 304, и стойкость к питтинговой коррозии в морской воде. Основные марки — 1.4462 (SAF 2205) и 1.4410 (SAF 2507). Применение: химия, нефтегаз, опреснение.
					</p>
				</article>
			</div>

			<h2 class="section-title seo-info__h2-second">Магнитится ли нержавейка</h2>
			<div class="seo-info__answer">
				<p>
					<strong>Зависит от структуры стали.</strong> Аустенитные марки (AISI 304, 316L, 321) в свежекатаном состоянии не магнитные — никель стабилизирует γ-фазу с гранецентрированной кубической решёткой, в которой нет магнитных доменов. После холодного наклёпа (гибка, штамповка) часть аустенита переходит в мартенсит — и материал может слабо притягивать магнит. Ферритные (AISI 430) и мартенситные (20Х13, 40Х13) марки магнитятся всегда: их α-фаза с объёмно-центрированной решёткой ферромагнитна.
				</p>
				<p>
					<strong>Практический тест.</strong> Чтобы дома отличить 304 от 430, поднесите магнит: <a href="/list-nerzhaveyushchiy/aisi-430/">AISI 430</a> прилипает, <a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a> — нет. Этот способ работает только для исходного листа без сильной механической обработки. Полный список марок и наличие — в разделе <a href="/list-nerzhaveyushchiy/">«Лист нержавеющий»</a>.
				</p>
			</div>

			<div class="seo-info__related">
				<h2 class="seo-info__h2-second section-title">Смежные разделы</h2>
				<ul>
					<li><a href="/blog/magnitit-li-nerzhaveika/">Магнитится ли нержавейка — подробная статья</a></li>
					<li><a href="/blog/aisi-304-vs-316l-vs-321/">AISI 304, 316L и 321 — что выбрать</a></li>
					<li><a href="/gost/">Справочник ГОСТов на нержавеющий металлопрокат</a></li>
					<li><a href="/list-nerzhaveyushchiy/">Каталог: лист нержавеющий</a></li>
				</ul>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.seo-info .section-title {
		max-width: 56ch;
	}
	.seo-info__lead {
		max-width: 78ch;
		margin: var(--space-4) 0 var(--space-6);
	}
	.seo-info__lead p {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--color-text);
	}
	.seo-info__grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: var(--space-4);
		margin-bottom: var(--space-8);
	}
	.seo-info__card {
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-xs);
		transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
	}
	.seo-info__card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	.seo-info__h {
		margin: 0 0 var(--space-1);
		font-size: 1.05rem;
		color: var(--color-text);
	}
	.seo-info__type {
		margin: 0 0 var(--space-2);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--color-accent);
		letter-spacing: 0.02em;
	}
	.seo-info__text {
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.55;
		color: var(--color-muted);
	}
	.seo-info__text a,
	.seo-info__answer a,
	.seo-info__related a {
		color: var(--color-accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.seo-info__text a:hover,
	.seo-info__answer a:hover,
	.seo-info__related a:hover {
		color: var(--color-text);
	}
	.seo-info__h2-second {
		margin-top: var(--space-6);
		max-width: 56ch;
	}
	.seo-info__answer {
		max-width: 78ch;
		margin-top: var(--space-4);
		display: grid;
		gap: var(--space-3);
	}
	.seo-info__answer p {
		margin: 0;
		font-size: 0.98rem;
		line-height: 1.6;
		color: var(--color-text);
	}
	.seo-info__related {
		margin-top: var(--space-8);
		padding-top: var(--space-6);
		border-top: 1px solid var(--color-border);
	}
	.seo-info__related ul {
		max-width: 78ch;
		margin: var(--space-3) 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: var(--space-2);
	}
	.seo-info__related li {
		font-size: 0.98rem;
		line-height: 1.5;
	}
</style>
