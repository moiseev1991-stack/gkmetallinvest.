	{ label: 'ГОСТ 5949-2018 — металлопродукция из сталей нержавеющих и сплавов на железоникелевой основе, табл. 3', href: 'https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/1/gost_5949-2018_mezhgosudarstvennyy_standart.html' },
	{ label: 'ГОСТ 10885-85 — сталь листовая горячекатаная двухслойная коррозионно-стойкая, п. 2.8', href: 'https://files.stroyinf.ru/Data2/1/4294847/4294847555.htm' },
	{ label: 'ASTM A240 — N08904 (904L): химический состав и механические свойства листа' },
	{ label: 'ASTM B424 — N08825: лист, минимальные механические свойства в отожжённом состоянии' },
	{ label: 'Special Metals — INCOLOY alloy 825: состав, плотность, коррозионная стойкость, стандарты', href: 'https://www.specialmetals.com/documents/technical-bulletins/incoloy/incoloy-alloy-825.pdf' },
	{ label: 'VDM Metals — Alloy 825, Data Sheet No. 4101: допуски по ASME и VdTÜV', href: 'https://www.vdm-metals.com/fileadmin/user_upload/Downloads/Data_Sheets/Data_Sheet_VDM_Alloy_825.pdf' },
	{ label: 'Outokumpu — Ultra range datasheet: Ultra 904L, PRE, серная кислота, сварка' },
	{ label: 'ATI — 904L Technical Data Sheet: допускаемые напряжения по ASME Section VIII', href: 'https://www.atimaterials.com/Products/Documents/datasheets/stainless-specialty-steel/superaustenitic/ati_904l_tds_en_v1.pdf' },
	{ label: 'Sandmeyer Steel — Alloy 904L Specification Sheet: коррозия в фосфорной кислоте', href: 'https://www.sandmeyersteel.com/wp-content/uploads/Alloy904L-SpecSheet.pdf' },
	{ label: 'SteelNumber — X1NiCrMoCu31-27-4 (1.4563) по EN 10088-3', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=274' },
	{ label: 'Марочник сталей и сплавов — 06ХН28МДТ: аналоги, физические свойства', href: 'http://www.splav-kharkov.com/mat_start.php?name_id=332' },
	{ label: 'Справочная карточка 06ХН28МДТ (ЭИ943): назначение, коррозионные испытания — stalmaximum.ru', href: 'https://stalmaximum.ru/stali-i-splavy-vysokolegirovannye/06khn28mdt-0kh23n28m3d3t-ei-943/' },
	{ label: 'СпецЭлектрод — электроды ОЗЛ-17У: назначение и режимы', href: 'https://www.spetselectrode.ru/electrod/ozl17u.htm' },
