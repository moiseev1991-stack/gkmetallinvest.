	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная, табл. 2 и п. 3.8', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'ГОСТ 9941-81 — трубы бесшовные холодно- и теплодеформированные из коррозионно-стойкой стали, табл. 1–3, п. 2.10 и 4.12', href: 'https://meganorm.ru/Data2/1/4294850/4294850480.htm' },
