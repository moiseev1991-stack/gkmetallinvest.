---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../data/site';

const title = 'Статьи о нержавейке — блог ГК Металлинвест';
const description = 'Блог о нержавеющем металлопрокате: разборы марок AISI и ГОСТ, ответы на технические вопросы, гайды по выбору проката и проверке стали.';

/* Список статей блога. Добавляем сюда по мере роста — рендер автоматический. */
const posts = [
	{
		slug: 'kak-varit-nerzhaveyku',
		title: 'Как варить нержавейку: электроды, проволока и режимы сварки',
		lead: 'Для AISI 304 — ОЗЛ-8, для 12Х18Н10Т — ЦЛ-11 с ниобием, для 316L — ЭА-400/10У и проволока ER316L. Токи по паспортам, полярность и почему нельзя перегревать шов.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 7,
		cover: '/img/blog/kak-varit-nerzhaveyku.webp?v=2',
	},
	{
		slug: 'pittingovaya-korroziya',
		title: 'Питтинговая коррозия нержавейки: причины и какие марки устойчивы',
		lead: 'Хлориды пробивают пассивную плёнку точечными язвами. Индекс PREN: 430 — 16, 304 — 18–20, 316L — 24, 2205 — 35, 2507 — 43. Для морской воды нужен PREN больше 40.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/pittingovaya-korroziya.webp?v=2',
	},
	{
		slug: 'harakteristiki-aisi-304-321-316',
		title: 'Характеристики AISI 304, 321 и 316L: состав, свойства и аналоги ГОСТ',
		lead: 'Состав по ASTM A240 и ГОСТ 5632-2014, прочность листа, плотность и теплопроводность. Почему 12Х18Н10Т и 321, 03Х17Н14М3 и 316L — аналоги, но не одно и то же.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 7,
		cover: '/img/blog/harakteristiki-aisi-304-321-316.webp?v=2',
	},
	{
		slug: 'teplovye-svoystva-nerzhaveyki',
		title: 'Теплопроводность, теплоёмкость и тепловое расширение нержавейки',
		lead: 'У AISI 304 и 316L — около 15 Вт/(м·К), втрое ниже углеродистой стали; расширение 16–17 × 10⁻⁶ 1/К. Таблица по маркам и расчёт удлинения.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/teplovye-svoystva-nerzhaveyki.webp?v=2',
	},
	{
		slug: 'pochemu-rzhaveet-nerzhaveyka',
		title: 'Почему ржавеет нержавейка и как отличить её от обычной стали',
		lead: 'Чаще всего ржавеют частицы железа на поверхности, а не сама сталь. Хлориды, побежалость, щели, дешёвые марки. Как отличить нержавейку и AISI 201 от 304.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/pochemu-rzhaveet-nerzhaveyka.webp?v=2',
	},
	{
		slug: 'poverhnosti-nerzhaveyushchego-lista',
		title: 'Поверхности нержавеющего листа 2B, BA, 4N, 8K, HL: что означают',
		lead: '2B и BA получают на прокатном стане, 4N, HL и 8K — шлифовкой и полировкой. Соответствие EN 10088-2 и ASTM A480, шероховатость Ra и выбор отделки.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/poverhnosti-nerzhaveyushchego-lista.webp?v=2',
	},
	{
		slug: 'zharoprochnaya-nerzhaveyka',
		title: 'Жаропрочная нержавейка: 310S, 309S, 20Х23Н18 и сталь для дымохода',
		lead: 'По ГОСТ 5632 длительно: 304 и 12Х18Н10Т — до 800 °C, 20Х23Н18 — до 1000 °C. Почему 321 ставят на выхлоп и какую сталь брать для дымохода газового котла и бани.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 7,
		cover: '/img/blog/zharoprochnaya-nerzhaveyka.webp?v=2',
	},
	{
		slug: 'chem-rezat-nerzhaveyku',
		title: 'Чем резать нержавейку: лазер, плазма, гидроабразив, болгарка',
		lead: 'Лазер с азотом — чистая кромка до 20–40 мм, плазма — толстый металл, гидроабразив — без нагрева. Болгаркой — только кругами INOX.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/chem-rezat-nerzhaveyku.webp?v=2',
	},
	{
		slug: 'kak-pochistit-nerzhaveyku',
		title: 'Как почистить нержавейку и убрать цвета побежалости после сварки',
		lead: 'Вода и мягкое средство, налёт — уксусом, вдоль рисок. Нельзя хлорку и стальную вату. Таблица цветов побежалости и как восстановить стойкость шва.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/kak-pochistit-nerzhaveyku.webp?v=2',
	},
	{
		slug: 'mezhkristallitnaya-korroziya',
		title: 'Межкристаллитная коррозия: зачем в 12Х18Н10Т титан, а в 316L мало углерода',
		lead: 'При нагреве до 450–850 °C хром уходит в карбиды по границам зёрен. Защита — титан или углерод до 0,03 %. Испытания по ГОСТ 6032 и ASTM A262.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/mezhkristallitnaya-korroziya.webp?v=2',
	},
	{
		slug: 'tverdost-nerzhaveyushchey-stali',
		title: 'Твёрдость нержавеющей стали по маркам: HB и HRC',
		lead: 'Аустенит в поставке — до 201–217 HB, дуплекс 2205 — до 293 HB. После закалки: 30Х13 ≥ 48 HRC, 40Х13 ≥ 50 HRC, 95Х18 ≥ 55 HRC. Нагартовка и перевод HB в HRC.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/tverdost-nerzhaveyushchey-stali.webp?v=2',
	},
	{
		slug: 'nerzhaveyka-dlya-morskoy-vody',
		title: 'Нержавейка для морской воды и бассейнов: 316L, дуплекс 2205 и выше',
		lead: '316L — для морской атмосферы и брызг, для погружения нужен PREN больше 40. В крытых бассейнах опасно коррозионное растрескивание — какие марки допустимы.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/nerzhaveyka-dlya-morskoy-vody.webp?v=2',
	},
	{
		slug: 'nerzhaveyka-ili-otsinkovka',
		title: 'Нержавейка или оцинковка: что выбрать и что служит дольше',
		lead: 'Цинк расходуется: в городе 0,4–2,1 мкм в год. Нержавейка защищена по всей толщине. Сварка, пищевой контакт, крепёж и выбор для кровли, ограждений и пищевки.',
		date: '2026-09-19',
		dateLabel: '19 сентября 2026',
		readingMin: 6,
		cover: '/img/blog/nerzhaveyka-ili-otsinkovka.webp?v=2',
	},
	{
		slug: 'analogi-marok-nerzhaveyki',
		title: 'Аналоги марок нержавейки: таблица AISI, ГОСТ и EN',
		lead: 'AISI 304 = 08Х18Н10 = 1.4301, 316L = 03Х17Н14М3 = 1.4404, 321 = 12Х18Н10Т = 1.4541, 430 = 12Х17. Полная таблица соответствия марок и как читать обозначения.',
		date: '2026-07-17',
		dateLabel: '17 июля 2026',
		readingMin: 5,
		cover: '/img/blog/analogi-marok-nerzhaveyki.svg?v=2',
	},
	{
		slug: 'chto-takoe-nerzhaveyushchaya-stal',
		title: 'Что такое нержавеющая сталь: состав, классы и применение',
		lead: 'Нержавейка — сплав железа с хромом от 10,5 %. Хром образует пассивную плёнку Cr₂O₃, которая защищает от коррозии. Разбираем состав, классы и марки простыми словами.',
		date: '2026-07-17',
		dateLabel: '17 июля 2026',
		readingMin: 6,
		cover: '/img/blog/chto-takoe-nerzhaveyushchaya-stal.svg',
	},
	{
		slug: 'plotnost-nerzhaveyushchey-stali',
		title: 'Плотность нержавеющей стали: таблица по маркам и расчёт веса',
		lead: 'Плотность нержавейки — 7,7–8,0 г/см³. Аустенит (304, 316L, 12Х18Н10Т) — 7,9–8,0, феррит и мартенсит (430, 40Х13) — 7,7. Таблица по маркам и формула расчёта веса проката.',
		date: '2026-07-17',
		dateLabel: '17 июля 2026',
		readingMin: 5,
		cover: '/img/blog/plotnost-nerzhaveyushchey-stali.svg',
	},
	{
		slug: 'temperatura-plavleniya-nerzhaveyki',
		title: 'Температура плавления нержавейки: таблица и рабочие температуры',
		lead: 'Нержавейка плавится при 1400–1450 °C, но эксплуатируется только до +800 °C (304, 316L) или +1000 °C для жаропрочной 310S. Таблица по маркам и разница с рабочей температурой.',
		date: '2026-07-17',
		dateLabel: '17 июля 2026',
		readingMin: 5,
		cover: '/img/blog/temperatura-plavleniya-nerzhaveyki.svg',
	},
	{
		slug: 'martensitnaya-stal-20h13-40h13',
		title: 'Сталь 20Х13, 30Х13, 40Х13: мартенситная нержавейка (AISI 420)',
		lead: 'Мартенситные хромистые стали с 13 % хрома. Различаются углеродом: твёрдость после закалки от 43–48 до 52–55 HRC. Магнитятся, идут на ножи, инструмент и валы.',
		date: '2026-07-17',
		dateLabel: '17 июля 2026',
		readingMin: 6,
		cover: '/img/blog/martensitnaya-stal-20h13-40h13.svg',
	},
	{
		slug: 'vidy-nerzhaveyushchey-stali',
		title: 'Виды нержавеющей стали: аустенит, феррит, мартенсит, дуплекс',
		lead: 'Нержавейку делят на 4 класса по структуре: аустенит (304, 316L, 321), феррит (430, 409), мартенсит (410, 420), дуплекс (2205). Чем различаются, где применяют, какие магнитятся.',
		date: '2026-07-17',
		dateLabel: '17 июля 2026',
		readingMin: 7,
		cover: '/img/blog/vidy-nerzhaveyushchey-stali.svg',
	},
	{
		slug: 'pishchevaya-nerzhaveyka',
		title: 'Пищевая нержавейка: какие марки разрешены и как выбрать',
		lead: 'Для контакта с продуктами разрешены аустенитные AISI 304 и 316L. 304 — база для молочки и выпечки, 316L — для солей, кислот и рассолов. Поверхности 2B/BA и требования ГОСТ.',
		date: '2026-07-17',
		dateLabel: '17 июля 2026',
		readingMin: 6,
		cover: '/img/blog/pishchevaya-nerzhaveyka.svg',
	},
	{
		slug: 'aisi-304-vs-316l-vs-321',
		title: 'AISI 304 vs 316L vs 321 — какую марку нержавейки выбрать',
		lead: 'Прямой ответ: 304 для общих задач, 316L для хлоридов и морской воды, 321 для горячих сварных узлов. Сравнение по составу, цене и температурному диапазону.',
		date: '2026-05-23',
		dateLabel: '23 мая 2026',
		readingMin: 6,
		cover: '/img/blog/aisi-304-vs-316l-vs-321.svg?v=2',
	},
	{
		slug: 'magnitit-li-nerzhaveika',
		title: 'Магнитится ли нержавейка',
		lead: 'Аустенит (AISI 304, 316L, 321) — нет. Феррит и мартенсит (AISI 430, 20Х13, 40Х13) — да. Почему 304 слабо магнитится после гибки и как проверить марку дома.',
		date: '2026-05-22',
		dateLabel: '22 мая 2026',
		readingMin: 4,
		cover: '/img/blog/magnitit-li-nerzhaveika.svg',
	},
];

const baseUrl = siteUrl.replace(/\/$/, '');

const blogJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Blog',
	name: 'Блог ГК Металлинвест',
	description,
	url: `${baseUrl}/blog/`,
	publisher: {
		'@type': 'Organization',
		name: siteName,
		url: siteUrl,
	},
	blogPost: posts.map((p) => ({
		'@type': 'BlogPosting',
		headline: p.title,
		datePublished: p.date,
		url: `${baseUrl}/blog/${p.slug}/`,
		description: p.lead,
	})),
};
---

<BaseLayout title={title} description={description} jsonLd={blogJsonLd}>
	<div class="container blog">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Блог' }]} />

		<header class="blog__hero">
			<span class="blog__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M3 2h7l3 3v9H3V2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
					<path d="M10 2v3h3M5 8h6M5 11h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
				Блог
			</span>
			<h1 class="blog__h1">Статьи о нержавеющей стали и металлопрокате</h1>
			<p class="blog__lead">
				Технические разборы, ответы на частые вопросы, гайды по выбору марки и формата
				проката. Без воды — только факты по составу, ГОСТам и применению нержавейки.
			</p>
		</header>

		<div class="blog__list">
			{posts.map((p) => (
				<article class="blog__card">
						{p.cover && (
							<a class="blog__card-cover" href={`/blog/${p.slug}/`} tabindex="-1" aria-hidden="true">
								<img src={p.cover} alt="" width="1200" height="630" loading="lazy" />
							</a>
						)}
					<div class="blog__card-meta">
						<time datetime={p.date}>{p.dateLabel}</time>
						<span>·</span>
						<span>чтение {p.readingMin} мин</span>
					</div>
					<h2 class="blog__card-title">
						<a href={`/blog/${p.slug}/`}>{p.title}</a>
					</h2>
					<p class="blog__card-lead">{p.lead}</p>
					<a class="blog__card-link" href={`/blog/${p.slug}/`}>
						<span>Читать статью</span>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</article>
			))}
		</div>
	</div>

	<CtaSection
		title="Не нашли ответ в статьях?"
		text="Менеджер подберёт марку и сортамент под вашу задачу — пришлёт КП в течение 30 минут."
	/>
</BaseLayout>

<style>
	.blog { padding-block: var(--space-8); min-width: 0; }

	.blog__hero { margin-bottom: var(--space-7); max-width: 75ch; }
	.blog__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		margin-bottom: var(--space-3);
	}
	.blog__h1 {
		font-size: clamp(1.7rem, 3.5vw, 2.4rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-3);
	}
	.blog__lead {
		font-size: 1.05rem;
		line-height: 1.6;
		max-width: 70ch;
		color: var(--color-text);
		margin: 0;
	}

	.blog__list {
		display: grid;
		gap: var(--space-5);
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		margin-bottom: var(--space-10);
	}
	.blog__card {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.blog__card:hover {
		border-color: var(--color-primary-500);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	.blog__card-cover {
		display: block;
		margin: calc(-1 * var(--space-5)) calc(-1 * var(--space-5)) 0;
		border-top-left-radius: var(--radius-lg);
		border-top-right-radius: var(--radius-lg);
		overflow: hidden;
		border-bottom: 1px solid var(--color-border);
	}
	.blog__card-cover img {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 1200 / 630;
		object-fit: cover;
	}
	.blog__card-meta {
		display: flex;
		gap: 0.5rem;
		font-size: 0.82rem;
		color: var(--color-muted);
	}
	.blog__card-title {
		font-size: 1.2rem;
		line-height: 1.3;
		margin: 0;
		letter-spacing: -0.01em;
	}
	.blog__card-title a {
		color: var(--color-text);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
	}
	.blog__card-title a:hover { color: var(--color-primary-600); }
	.blog__card-lead {
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-muted);
		margin: 0;
	}
	.blog__card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 0.95rem;
		background: var(--color-primary-50);
		border: 1px solid var(--color-primary-100);
		border-radius: var(--radius-pill);
		color: var(--color-primary-600);
		font-weight: 500;
		font-size: 0.9rem;
		text-decoration: none;
		align-self: flex-start;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.blog__card-link:hover {
		background: var(--color-primary-100);
		border-color: var(--color-primary-500);
		text-decoration: none;
	}
	.blog__card-link svg { transition: transform var(--dur-fast) var(--ease-out); }
	.blog__card-link:hover svg { transform: translateX(2px); }
</style>
