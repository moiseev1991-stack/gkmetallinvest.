---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'tablica', anchor: 'Таблица обозначений', summary: 'EN 10088-2 и ASTM A480' },
	{ id: 'prokatnye', anchor: '2B, 2D, BA, 1D', summary: 'Поверхности с прокатного стана' },
	{ id: 'shlifovka', anchor: '4N, HL, сатин', summary: 'Шлифованные поверхности' },
	{ id: 'zerkalo', anchor: '8K и зеркало', summary: 'Полированные поверхности' },
	{ id: 'ra', anchor: 'Шероховатость Ra', summary: 'Почему её указывают отдельно' },
	{ id: 'vybor', anchor: 'Как выбрать', summary: 'Под пищевку, фасад, интерьер' },
];

const faq = [
	{
		q: 'Чем поверхность 2B отличается от BA?',
		a: '2B — матовая поверхность: лист после холодной прокатки отжигают, травят и слегка прокатывают полированными валками, Ra около 0,1–0,5 мкм. BA (по EN — 2R) — блестящая: лист отжигают в защитной бескислородной атмосфере без травления, Ra около 0,05–0,1 мкм. BA глаже и легче моется, но это не полированное зеркало.',
	},
	{
		q: 'Что такое 4N и HL?',
		a: '4N — рыночное название шлифованной поверхности, соответствующей No.4 по ASTM A480: направленный штрих от абразивной ленты, поставщики называют зерно P120–P180. HL (hairline) — японское обозначение шлифовки с длинным непрерывным штрихом, похожим на волос. Обе поверхности матовые, с видимым направлением рисок.',
	},
	{
		q: '8K и No.8 — это одно и то же?',
		a: 'По сути да: обе обозначают зеркальную полированную поверхность. No.8 — обозначение ASTM A480 (по EN — 2P), 8K — китайское рыночное название. Производители указывают для 8K шероховатость около 0,05 мкм и выше 95 % отражения, но это данные продавцов, а не норма стандарта.',
	},
	{
		q: 'Какая поверхность нужна для пищевого оборудования?',
		a: 'Чаще всего 2B или BA — они гладкие и легко моются, либо шлифовка с заданной шероховатостью. Главное — указать в заказе требуемую Ra (например, не более 0,8 мкм), потому что само обозначение отделки конкретную шероховатость не гарантирует.',
	},
	{
		q: 'Какая шероховатость у поверхности 2B?',
		a: 'Обычно Ra 0,1–0,5 мкм по данным ISSF и BSSA. У разных заводов она отличается, поэтому для ответственных изделий Ra указывают в заказе отдельно.',
	},
	{
		q: 'Зачем на листе плёнка и какая нужна под лазерную резку?',
		a: 'Плёнка защищает поверхность от царапин при транспортировке, резке и монтаже. Обычно это полиэтилен толщиной около 40–100 мкм. Для лазерной резки выпускают специальную плёнку, которая не мешает резу; её тип подбирают под лазер (оптоволоконный или CO₂).',
	},
	{
		q: 'Какую поверхность выбрать для уличного фасада?',
		a: 'Гладкую: чем меньше шероховатость, тем меньше на поверхности задерживается грязь и соли. ASSDA и BSSA рекомендуют для прибрежных зон Ra меньше 0,5 мкм и вертикальное направление рисок. Шлифовку 2G (No.3) применяют только в помещениях.',
	},
];

const sources = [
	{ label: 'ASTM A480 — отделки поверхности нержавеющего листа (п. 11, Note 3)' },
	{ label: 'EN 10088-2 — обозначения отделок 1D, 2D, 2B, 2R, 2G, 2J, 2K, 2P' },
	{ label: 'ISSF — Surface finishes (учебный модуль)', href: 'https://www.imoa.info/download_files/stainless-steel/issf/educational/Module_08_Surface_Finishes_en.pdf' },
	{ label: 'BSSA — Specifying finishes for stainless steel flat products', href: 'https://bssa.org.uk/bssa_articles/specifying-finishes-for-stainless-steel-flat-products-sheet-and-plate/' },
	{ label: 'worldstainless — измерение шероховатости нержавеющей стали', href: 'https://worldstainless.org/wp-content/uploads/2025/02/RoughnessMeasurement_EN.pdf' },
	{ label: 'Euro Inox — Guide to stainless steel finishes', href: 'https://www.imoa.info/download_files/stainless-steel/euroinox/Finishes.pdf' },
];

const related = [
	{ label: 'Лист нержавеющий — все поверхности в каталоге', href: '/list-nerzhaveyushchiy/' },
	{ label: 'Декоративные листы: зеркало, 8K, DECO', href: '/dekorativnye-listy/' },
	{ label: 'Полировка нержавеющей стали', href: '/uslugi/polirovka/' },
	{ label: 'Шлифование нержавеющей стали', href: '/uslugi/shlifovanie/' },
	{ label: 'Нанесение защитной плёнки', href: '/uslugi/nanesenie-plenki/' },
	{ label: 'Пищевая нержавейка: какие марки разрешены', href: '/blog/pishchevaya-nerzhaveyka/' },
];
---

<BlogArticle
	slug="poverhnosti-nerzhaveyushchego-lista"
	title="Поверхности нержавейки 2B, BA, 4N, 8K, HL"
	description="Что означают поверхности нержавеющего листа 2B, BA, 2D, 4N, HL, 8K: как их получают, шероховатость Ra, соответствие EN 10088-2 и ASTM A480."
	h1="Поверхности нержавеющего листа 2B, BA, 4N, 8K, HL: что означают"
	eyebrow="Справочник"
	datePublished="2026-09-19"
	dateModified="2026-09-19"
	readingMin={6}
	answer="<strong>Буквы на листе обозначают способ получения поверхности, а не её точную гладкость.</strong> 2B и BA получают прямо на прокатном стане: 2B — матовая поверхность после отжига, травления и лёгкой прокатки полированными валками, BA — блестящая после отжига в защитной атмосфере. 4N, HL и 8K — механическая шлифовка или полировка поверх 2B или BA. Если важна гладкость, например для пищевого оборудования, в заказе отдельно указывают шероховатость Ra."
	keyFacts={[
		'2B (EN 2B): холодная прокатка, отжиг, травление, дрессировка — Ra ≈ 0,1–0,5 мкм',
		'BA (EN 2R): светлый отжиг в защитной атмосфере — Ra ≈ 0,05–0,1 мкм',
		'4N ≈ No.4 (EN 2J): шлифовка с направленным штрихом',
		'8K ≈ No.8 (EN 2P): зеркальная полировка, Ra &lt; 0,1 мкм',
		'Обозначение отделки не гарантирует Ra — её указывают в заказе отдельно',
	]}
	coverAlt="Поверхности нержавеющего листа 2B, BA, 4N, 8K и HL"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Поверхность нержавеющего листа', '2B', 'BA', 'Шероховатость Ra']}
	cta={{ title: 'Нужен лист с определённой поверхностью?', text: '2B, BA, 4N, HL, 8K, с плёнкой и без — подберём по марке, толщине и формату.' }}
>
	<section id="tablica">
		<h2>Таблица обозначений поверхностей</h2>
		<div class="ba-table">
			<table>
				<caption>Отделки листа по EN 10088-2 и ASTM A480</caption>
				<thead>
					<tr><th>EN 10088-2</th><th>ASTM A480</th><th>Как получают</th><th>Типичная Ra, мкм</th></tr>
				</thead>
				<tbody>
					<tr><td>1D</td><td>No.1</td><td>Горячая прокатка, отжиг, травление; грубая матовая</td><td>3,5–7,5</td></tr>
					<tr><td>2D</td><td>2D</td><td>Холодная прокатка, отжиг, травление; матовая</td><td>0,4–1,0</td></tr>
					<tr><td>2B</td><td>2B</td><td>Как 2D плюс лёгкая прокатка полированными валками</td><td>0,1–0,5</td></tr>
					<tr><td>2R</td><td>BA</td><td>Холодная прокатка и светлый отжиг в бескислородной атмосфере</td><td>0,05–0,1</td></tr>
					<tr><td>2G</td><td>No.3</td><td>Шлифовка абразивом</td><td>до 1,0 (ASTM)</td></tr>
					<tr><td>2J</td><td>No.4</td><td>Шлифовка лентой или щёткой, направленный штрих</td><td>до 0,64 (ASTM)</td></tr>
					<tr><td>2K</td><td>—</td><td>Сатинирование для фасадов</td><td>менее 0,5 поперёк штриха</td></tr>
					<tr><td>2P</td><td>No.8</td><td>Механическая полировка до зеркала</td><td>менее 0,1</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Шероховатость — по данным ISSF, BSSA и worldstainless. Соответствие 2J и 2K номерам ASTM у разных
			источников немного расходится.
		</p>
	</section>

	<section id="prokatnye">
		<h2>Поверхности с прокатного стана: 1D, 2D, 2B, BA</h2>
		<ul>
			<li><strong>1D (No.1)</strong> — горячекатаный толстый лист после отжига и травления. Матовая шероховатая поверхность для технических задач.</li>
			<li><strong>2D</strong> — холоднокатаная матовая поверхность; хорошо удерживает смазку, поэтому подходит для глубокой вытяжки.</li>
			<li><strong>2B</strong> — самая распространённая отделка холоднокатаного листа и основа для последующей шлифовки и полировки. Ровная, слегка блестящая.</li>
			<li><strong>BA (2R)</strong> — самая гладкая из прокатных поверхностей: зеркальный блеск без механической полировки, легко моется. На рынке иногда пишут «2BA», но стандартное обозначение — BA или 2R.</li>
		</ul>
	</section>

	<section id="shlifovka">
		<h2>Шлифованные поверхности: 4N, HL, сатин</h2>
		<p>
			Шлифованную поверхность получают абразивной лентой или щёткой, поэтому на ней виден направленный
			штрих. Чем мельче зерно абразива, тем ниже шероховатость.
		</p>
		<div class="ba-table">
			<table>
				<caption>Шероховатость в зависимости от зерна абразива (worldstainless)</caption>
				<thead>
					<tr><th>Зерно</th><th class="num">P120</th><th class="num">P180</th><th class="num">P240</th><th class="num">P320</th><th class="num">P600</th></tr>
				</thead>
				<tbody>
					<tr><td>Ra, мкм</td><td class="num">1,32</td><td class="num">0,76</td><td class="num">0,38</td><td class="num">0,30</td><td class="num">0,13</td></tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>4N</strong> — рыночное название шлифовки No.4. Российские поставщики называют зерно P120–P180, иногда до P240.</li>
			<li><strong>HL (hairline)</strong> — японское обозначение шлифовки с длинным непрерывным штрихом «под волос». Популярна в лифтах, облицовке и мебели.</li>
			<li><strong>No.6</strong> — более мягкий матовый вид, получают щёткой по поверхности No.4.</li>
		</ul>
	</section>

	<section id="zerkalo">
		<h2>Зеркальные поверхности: 8K, No.8, No.7</h2>
		<p>
			Зеркало получают многоступенчатой полировкой всё более мелким абразивом с финальной доводкой пастой.
			По ASTM A480 это No.8, по EN 10088-2 — 2P. <strong>8K</strong> — китайское рыночное название той же
			зеркальной отделки. Для 8K продавцы указывают шероховатость около 0,05 мкм и отражение выше 95 %, но
			это не норма стандарта. No.7 — «недополированное» зеркало, на котором остаются следы шлифовки.
		</p>
		<p>
			Зеркальный лист чаще всего поставляют с защитной плёнкой. Обычная плёнка — полиэтилен толщиной
			около 40–100 мкм; для лазерной резки выпускают специальную плёнку.
		</p>
	</section>

	<section id="ra">
		<h2>Почему шероховатость Ra указывают отдельно</h2>
		<p>
			Стандарт ASTM A480 прямо оговаривает: номер отделки описывает способ получения поверхности, а не
			заданную шероховатость. У разных заводов Ra одной и той же отделки отличается. Поэтому если
			шероховатость важна — для пищевого, фармацевтического оборудования или фасадов, — её указывают в
			заказе числом: например, «2B, Ra не более 0,5 мкм».
		</p>
	</section>

	<section id="vybor">
		<h2>Какую поверхность выбрать</h2>
		<div class="ba-table">
			<table>
				<caption>Поверхность под задачу</caption>
				<thead>
					<tr><th>Задача</th><th>Поверхность</th></tr>
				</thead>
				<tbody>
					<tr><td>Пищевое и технологическое оборудование, ёмкости</td><td>2B, BA или шлифовка с заданной Ra</td></tr>
					<tr><td>Глубокая вытяжка</td><td>2D</td></tr>
					<tr><td>Кухонное оборудование, бытовая техника</td><td>4N, HL, BA</td></tr>
					<tr><td>Лифты, интерьер, мебель</td><td>HL, 4N, 8K, декоративные листы</td></tr>
					<tr><td>Уличные фасады, особенно у моря</td><td>Гладкие отделки с Ra &lt; 0,5 мкм, 2K; шлифовка 2G — только в помещениях</td></tr>
					<tr><td>Декор, вывески, зеркальные элементы</td><td>8K (No.8)</td></tr>
				</tbody>
			</table>
		</div>
	</section>
</BlogArticle>
