const faq = [
	{
		q: 'Что такое дуплексная сталь простыми словами?',
		a: 'Это нержавейка, в структуре которой одновременно есть две фазы — аустенит, как у AISI 304 и 316L, и феррит, как у AISI 430. Обычно их примерно поровну: у современного 2205 феррита 40–50 %. От аустенита дуплекс берёт вязкость и свариваемость, от феррита — прочность и стойкость к коррозионному растрескиванию в хлоридах. По ГОСТ 5632-2014 такие стали относятся к аустенито-ферритному классу.',
	},
	{
		q: 'Что выбрать: 2205 или 2507?',
		a: '2205 — стандартный дуплекс: 22–23 % хрома, 3,0–3,5 % молибдена, PREN около 35, предел текучести листа по ASTM A240 от 450 МПа. Супердуплекс 2507 легирован сильнее — 24–26 % хрома, 3–5 % молибдена, 0,24–0,32 % азота, PREN около 43 и предел текучести от 550 МПа. 2507 берут, когда стойкости 2205 не хватает, прежде всего для морской воды со щелями, где нужен PREN больше 40. Варить 2507 сложнее: погонная энергия по IMOA 0,3–1,5 кДж/мм, межваликовая температура — не выше 100 °C.',
	},
	{
		q: 'Магнитится ли дуплексная сталь?',
		a: 'Да. Примерно половина структуры — феррит, поэтому IMOA называет дуплексные стали ферромагнитными. Магнитом дуплекс не отличить от ферритной или мартенситной нержавейки, а 2205 — от 2507. Марку подтверждают сертификатом с химическим анализом плавки, а долю феррита в сварном шве измеряют ферритометром в единицах FN.',
	},
	{
		q: 'Есть ли российский аналог стали 2205?',
		a: 'Да, 03Х22Н5АМ3 по ГОСТ 5632-2014: углерода до 0,030 %, хрома 21–23 %, никеля 4,5–6,5 %, молибдена 2,5–3,5 %, азота 0,08–0,20 %. По основным элементам она совпадает с исходной версией 2205 — UNS S31803, серы ГОСТ допускает меньше. У версии S32205 диапазоны уже: хрома 22–23 %, молибдена 3,0–3,5 %, азота 0,14–0,20 %, поэтому для сварных конструкций азот лучше оговаривать в заказе. Аналога супердуплекса 2507 в ГОСТ 5632-2014 нет.',
	},
	{
		q: 'До какой температуры можно применять дуплексную сталь?',
		a: 'Для сосудов под давлением ASME допускает дуплекс до 315 °C, немецкие нормы TÜV — до 250–300 °C в зависимости от марки и наличия сварки. Выше начинается охрупчивание 475 °C: в интервале 300–525 °C в феррите выделяется α-штрих-фаза, и сталь теряет ударную вязкость. При 700–950 °C у 2205 образуется сигма-фаза. Для работы при нагреве дуплекс не подходит — там применяют жаростойкие аустенитные марки.',
	},
	{
		q: 'Какой присадкой варить дуплекс 2205?',
		a: 'Присадкой типа 2209 — по ISO 14343 это 22 9 3 NL. В ней на 2–4 % больше никеля, чем в основном металле, чтобы в шве образовалось достаточно аустенита. Для 2507 берут 25 9 4 NL (ER2594), для соединения дуплекса с углеродистой сталью — 2209, 309L или 309LMo. Без присадки шов получается почти ферритным, и после сварки нужна закалка.',
	},
];

const sources = [
	{ label: 'IMOA — Practical Guidelines for the Fabrication of Duplex Stainless Steels, 3-е издание: составы, PREN, механика, температуры фазовых превращений, сварка, применение', href: 'https://www.imoa.info/download_files/stainless-steel/Duplex_Stainless_Steel_3rd_Edition.pdf' },
	{ label: 'ASTM A240/A240M — лист и полоса из нержавеющей стали: состав и механические свойства S32101, S32304, S31803, S32205, S32750, S30403, S31603' },
	{ label: 'Outokumpu — Forta range: технические данные дуплексных сталей (PRE, типовой состав, физические свойства, сварочные материалы)', href: 'https://www.outokumpu.com/en/products/product-ranges/forta' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1 (класс 5, аустенито-ферритные стали) и приложение А', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'EN 10088-2 — нержавеющие стали, лист и полоса общего назначения: 1.4362, 1.4462, 1.4410' },
	{ label: 'ASTM A923 — методы выявления вредных интерметаллических фаз в дуплексных сталях' },
];

const related = [
	{ label: 'Аустенитная нержавеющая сталь', href: '/blog/austenitnaya-stal/' },
	{ label: 'Ферритная нержавеющая сталь', href: '/blog/ferritnaya-stal/' },
	{ label: 'Магнитится ли нержавейка', href: '/blog/magnitit-li-nerzhaveika/' },
	{ label: 'Лист нержавеющий Duplex 2205', href: '/list-nerzhaveyushchiy/duplex-2205/' },
	{ label: 'Аналоги марок нержавейки: AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
	{ label: 'Характеристики AISI 304, 321 и 316L', href: '/blog/harakteristiki-aisi-304-321-316/' },
];
---

<BlogArticle
	slug="dupleksnaya-stal"
	title="Дуплексная сталь 2205 и 2507: состав и свойства"
	description="Дуплексная сталь 2205 и 2507: состав по ASTM A240, PREN 35 и 43, прочность вдвое выше 316L, сварка, пределы по температуре и аналог 03Х22Н5АМ3 по ГОСТ."
	h1="Дуплексная сталь: 2205 и 2507 — состав, свойства, где применяют"
	eyebrow="Справочник"
	datePublished="2026-09-26"
	dateModified="2026-09-26"
	readingMin={11}
	answer="<strong>Дуплексная сталь — нержавейка с двухфазной структурой из аустенита и феррита примерно поровну: у современного 2205 феррита 40–50 %.</strong> Стандартный дуплекс 2205 (UNS S32205 и S31803, EN 1.4462) содержит 22–23 % хрома, 3,0–3,5 % молибдена и 0,14–0,20 % азота, его PREN около 35; супердуплекс 2507 (S32750, 1.4410) — 24–26 % хрома и PREN около 43. Предел текучести листа по ASTM A240 — от 450 и 550 МПа против 170 МПа у 316L, но из-за охрупчивания феррита при 300–525 °C дуплекс работает только до 250–315 °C."
	keyFacts={[
		'Структура: аустенит + феррит; у 2205 обычно 40–50 % феррита, по ГОСТ 5632 — аустенито-ферритный класс',
		'σ0,2 листа по ASTM A240: 2205 — от 450 МПа, 2507 — от 550 МПа, 316L — от 170 МПа',
		'PREN (Outokumpu): 316L — 24, 2101 и 2304 — 26, 2205 — 35, 2507 — 43',
		'Сварка: присадка 2209 с избытком никеля, межваликовая температура до 150 °C, у 2507 — до 100 °C',
		'Верхний предел — 315 °C по ASME; аналог 2205 по ГОСТ 5632-2014 — 03Х22Н5АМ3, аналога 2507 нет',
	]}
	coverAlt="Дуплексная сталь 2205 и 2507: состав, PREN, прочность и применение"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Дуплексная сталь', 'Duplex 2205', 'Super duplex 2507', 'Нержавеющая сталь']}
	cta={{ title: 'Нужен нержавеющий прокат?', text: 'Поставляем лист, круг и трубу из нержавеющей стали — пришлите марку, размеры и объём для расчёта.' }}
>
	<section id="chto-takoe">
		<h2>Что такое дуплексная сталь</h2>
		<p>
			Дуплексная, или аустенитно-ферритная, нержавейка — сталь, в структуре которой одновременно есть
			аустенит и феррит. ГОСТ 5632-2014 относит к аустенито-ферритному классу стали, в которых феррита
			больше 10 %. Промышленные дуплексы балансируют ближе к равным долям: по данным IMOA, свойства
			сохраняются, пока каждой фазы 30–70 %, а у современного 2205 феррита обычно 40–50 %.
		</p>
		<p>
			Баланс фаз задают легированием. Хром и молибден стабилизируют феррит, никель и азот — аустенит.
			Хрома в дуплексе обычно не меньше 20 %, никеля — около 1,5–7 %, тогда как хромоникелевым сталям
			серии 300 нужно от 6 % никеля. Азот — самый сильный упрочнитель твёрдого раствора, к тому же он замедляет выделение
			вредных фаз при сварке. Чем дуплекс отличается от других классов в целом — в статье
			<a href="/blog/vidy-nerzhaveyushchey-stali/">виды нержавеющей стали</a>.
		</p>
		<p>
			Первые дуплексы выплавили в Швеции в 1930 году для сульфитной целлюлозной промышленности. Второе
			поколение, легированное азотом, появилось в конце 1970-х, когда осваивали месторождения Северного
			моря: азот приблизил вязкость и коррозионную стойкость околошовной зоны к основному металлу. По
			данным IMOA, на 2205 приходится почти 60 % потребления дуплекса.
		</p>
		<div class="ba-table">
			<table>
				<caption>Группы дуплексных сталей (классификация IMOA)</caption>
				<thead>
					<tr><th>Группа</th><th>Типичные марки</th><th>Cr, %</th><th>Mo, %</th><th class="num">PREN</th></tr>
				</thead>
				<tbody>
					<tr><td>Экономнолегированный (lean duplex)</td><td>2101 (S32101), 2304 (S32304)</td><td>21,0–24,5</td><td>до 0,8</td><td class="num">25–28</td></tr>
					<tr><td>Lean duplex с молибденом</td><td>S32003</td><td>19,5–22,5</td><td>1,5–2,0</td><td class="num">30–31</td></tr>
					<tr><td>Стандартный дуплекс</td><td>2205 (S32205, S31803)</td><td>21,0–23,0</td><td>2,5–3,5</td><td class="num">33–36</td></tr>
					<tr><td>Супердуплекс</td><td>2507 (S32750), S32760</td><td>24,0–26,0</td><td>3,0–5,0</td><td class="num">40–43</td></tr>
					<tr><td>Гипердуплекс</td><td>S32707</td><td>26,0–29,0</td><td>4,0–5,0</td><td class="num">49–50</td></tr>
				</tbody>
			</table>
		</div>
	</section>

	<section id="sostav">
		<h2>Состав 2205, 2507 и lean-дуплексов</h2>
		<p>
			Названия марок отражают номинальный состав: 2205 — около 22 % хрома и 5 % никеля, 2507 — 25 % хрома
			и 7 % никеля, 2304 — 23 % и 4 %. Это не номера AISI, а сложившиеся обозначения: «2205» может
			означать и S31803, и S32205, поэтому в заказе надёжнее указывать номер UNS или EN.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав по ASTM A240, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка, UNS</th><th>C</th><th>Mn</th><th>Cr</th><th>Ni</th><th>Mo</th><th>N</th><th>Cu</th></tr>
				</thead>
				<tbody>
					<tr><td>2101, S32101</td><td>0,040</td><td>4,0–6,0</td><td>21,0–22,0</td><td>1,35–1,70</td><td>0,10–0,80</td><td>0,20–0,25</td><td>0,10–0,80</td></tr>
					<tr><td>2304, S32304</td><td>0,030</td><td>2,50</td><td>21,5–24,5</td><td>3,0–5,5</td><td>0,05–0,60</td><td>0,05–0,20</td><td>0,05–0,60</td></tr>
					<tr><td>2205, S31803</td><td>0,030</td><td>2,00</td><td>21,0–23,0</td><td>4,5–6,5</td><td>2,5–3,5</td><td>0,08–0,20</td><td>—</td></tr>
					<tr><td>2205, S32205</td><td>0,030</td><td>2,00</td><td>22,0–23,0</td><td>4,5–6,5</td><td>3,0–3,5</td><td>0,14–0,20</td><td>—</td></tr>
					<tr><td>2507, S32750</td><td>0,030</td><td>1,20</td><td>24,0–26,0</td><td>6,0–8,0</td><td>3,0–5,0</td><td>0,24–0,32</td><td>0,50</td></tr>
					<tr><td>316L, S31603 — для сравнения</td><td>0,030</td><td>2,00</td><td>16,0–18,0</td><td>10,0–14,0</td><td>2,0–3,0</td><td>0,10</td><td>—</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Кремния в дуплексах по ASTM A240 до 1,00 % (у 2507 — до 0,80 %), фосфора — до 0,030–0,040 %,
			серы — до 0,020–0,030 %. У 2205 две версии. Исходная S31803 допускает азот от 0,08 %, и, по данным
			IMOA, при азоте у нижней границы металл нестабильно вёл себя при термообработке и сварке. Практика
			показала, что для сварных конструкций нужно не меньше 0,14 % азота, — так появилась S32205 с более
			узкими диапазонами. Современный 2205 обычно выплавляют по составу S32205.
		</p>
		<p>
			Европейские обозначения по EN 10088: 2205 — 1.4462 (X2CrNiMoN22-5-3), 2507 — 1.4410
			(X2CrNiMoN25-7-4), 2304 — 1.4362 (X2CrNiN23-4), 2101 — 1.4162 (X2CrMnNiN21-5-1). По хрому
			(21–23 %) и молибдену (2,5–3,5 %) 1.4462 совпадает с S31803, азота допускает 0,10–0,22 %. Прокат по ASTM
			выпускают по отдельным стандартам: лист — A240, пруток — A276 и A479, трубы — A789 и A790, поковки
			и фланцы — A182 (F51 — S31803, F60 — S32205, F53 — S32750).
		</p>

		<h3>Российские аналоги по ГОСТ 5632-2014</h3>
		<p>
			В ГОСТ 5632-2014 к аустенито-ферритному классу отнесено 11 марок. Ближайший аналог 2205 —
			03Х22Н5АМ3: по основным элементам, включая азот 0,08–0,20 %, её состав совпадает с S31803, а серы
			ГОСТ допускает меньше — до 0,015 %. Приложение А называет её сталью для трубных систем
			теплообменного оборудования атомных энергетических установок (АЭУ) с повышенной стойкостью в водных
			средах с хлор-ионами. Супердуплекса типа 2507 с 24–26 % хрома и 0,24–0,32 % азота в ГОСТ 5632-2014 нет —
			его заказывают по ASTM или EN.
		</p>
		<div class="ba-table">
			<table>
				<caption>Дуплексные марки ГОСТ 5632-2014, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка</th><th>C</th><th>Cr</th><th>Ni</th><th>Mo</th><th>Прочее</th><th>Назначение по приложению А</th></tr>
				</thead>
				<tbody>
					<tr><td>03Х22Н5АМ3</td><td>0,030</td><td>21–23</td><td>4,5–6,5</td><td>2,5–3,5</td><td>N 0,08–0,20</td><td>Трубные системы теплообменников АЭУ; ближайший аналог 2205</td></tr>
					<tr><td>03Х23Н6</td><td>0,030</td><td>22–24</td><td>5,3–6,3</td><td>—</td><td>Mn 1,0–2,0</td><td>Аппаратура химического машиностроения; прочнее 08Х18Н10Т</td></tr>
					<tr><td>03Х22Н6М2</td><td>0,030</td><td>21–23</td><td>5,5–6,5</td><td>1,8–2,5</td><td>Mn 1,0–2,0</td><td>Аппаратура химического машиностроения; прочнее 03Х17Н14М3</td></tr>
					<tr><td>08Х22Н6Т (ЭП53)</td><td>0,08</td><td>21–23</td><td>5,3–6,3</td><td>—</td><td>Ti 5·C–0,65</td><td>Заменитель 12Х18Н10Т и 08Х18Н10Т в сварной аппаратуре до 300 °C</td></tr>
					<tr><td>08Х21Н6М2Т (ЭП54)</td><td>0,08</td><td>20–22</td><td>5,5–6,5</td><td>1,8–2,5</td><td>Ti 0,20–0,40</td><td>Заменитель 10Х17Н13М2Т в уксусно-, серно- и фосфорнокислых средах</td></tr>
					<tr><td>12Х21Н5Т (ЭИ811)</td><td>0,09–0,14</td><td>20–22</td><td>4,8–5,8</td><td>—</td><td>Ti 0,25–0,50</td><td>Сварные и паяные конструкции в агрессивных средах</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			В марках 03Х23Н6, 03Х22Н6М2 и сталях с титаном азот не нормирован, поэтому прямыми аналогами 2304 или
			2205 их считать нельзя. В тот же класс ГОСТ относит и жаростойкие стали вроде 20Х23Н13 (аналог 309S) —
			к коррозионно-стойким дуплексам они не относятся.
		</p>
	</section>

	<section id="svoystva">
		<h2>Прочность: сравнение с 304L и 316L</h2>
		<p>
			По IMOA, предел текучести дуплекса после закалки более чем вдвое выше, чем у аустенитных сталей без
			азота. На практике это позволяет уменьшить толщину стенки сосуда, трубы или листа при той же
			нагрузке, если конструкцию не ограничивают устойчивость и жёсткость.
		</p>
		<div class="ba-table">
			<table>
				<caption>Лист по ASTM A240: минимальные механические свойства и максимальная твёрдость</caption>
				<thead>
					<tr><th>Марка, UNS</th><th class="num">σ0,2, МПа</th><th class="num">σв, МПа</th><th class="num">δ, %</th><th class="num">Твёрдость</th></tr>
				</thead>
				<tbody>
					<tr><td>304L, S30403</td><td class="num">170</td><td class="num">485</td><td class="num">40</td><td class="num">201 HB</td></tr>
					<tr><td>316L, S31603</td><td class="num">170</td><td class="num">485</td><td class="num">40</td><td class="num">217 HB</td></tr>
					<tr><td>2101, S32101, толщина до 5 мм</td><td class="num">530</td><td class="num">700</td><td class="num">30</td><td class="num">290 HB</td></tr>
					<tr><td>2101, S32101, толщина больше 5 мм</td><td class="num">450</td><td class="num">650</td><td class="num">30</td><td class="num">290 HB</td></tr>
					<tr><td>2304, S32304</td><td class="num">400</td><td class="num">600</td><td class="num">25</td><td class="num">290 HB</td></tr>
					<tr><td>2205, S31803</td><td class="num">450</td><td class="num">620</td><td class="num">25</td><td class="num">293 HB</td></tr>
					<tr><td>2205, S32205</td><td class="num">450</td><td class="num">655</td><td class="num">25</td><td class="num">293 HB</td></tr>
					<tr><td>2507, S32750</td><td class="num">550</td><td class="num">795</td><td class="num">15</td><td class="num">310 HB</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			По EN 10088-2 для горячекатаного листа требования близкие: 1.4362 — σ0,2 от 400 МПа и σв от 630 МПа,
			1.4462 — от 460 и 640 МПа, 1.4410 — от 530 и 730 МПа. Удлинение у 1.4362 и 1.4462 — от 25 %, у
			1.4410 — от 20 %.
		</p>
		<p>
			У прочности есть обратная сторона. Пластичность дуплекса примерно вдвое ниже, чем у аустенита: при
			гибке нужны большие радиусы и усилия, пружинение сильнее. Предельная толщина реза на гильотине, по
			IMOA, — около 75 % от толщины для 304 и 316, для супердуплекса — около 65 %. Ударную вязкость дуплекс
			хорошо сохраняет до −40 °C, но в отличие от аустенита у него есть переход в хрупкое состояние.
		</p>
		<ul>
			<li><strong>Физические свойства.</strong> По данным Outokumpu, у 2101, 2304, 2205 и 2507 плотность 7,8 г/см³, модуль упругости 200 ГПа, теплопроводность около 15 Вт/(м·К). Коэффициент теплового расширения при 20–100 °C — 13 × 10⁻⁶ 1/К против 16,4 × 10⁻⁶ у AISI 304 (IMOA), поэтому локальные термические напряжения у сварных швов ниже, чем у аустенита.</li>
			<li><strong>Магнитность.</strong> Из-за феррита дуплекс ферромагнитен и притягивает магнит. Отличить им 2205 от ферритной стали или от 2507 нельзя. Долю феррита в шве измеряют ферритометром в единицах FN по AWS A4.2 или EN ISO 8249.</li>
		</ul>
	</section>

	<section id="korroziya">
		<h2>Коррозионная стойкость: PREN, КРН, кислоты</h2>
		<p>
			Стойкость к питтингу и щелевой коррозии определяют хром, молибден и азот. Для сравнения марок
			используют индекс PREN — формула и критическая температура питтинга разобраны в статье
			<a href="/blog/pittingovaya-korroziya/">питтинговая коррозия</a>. Здесь — только цифры по дуплексам.
		</p>
		<div class="ba-table">
			<table>
				<caption>PREN: типовой состав Outokumpu и диапазон IMOA</caption>
				<thead>
					<tr><th>Марка</th><th class="num">PREN по Outokumpu</th><th class="num">Диапазон по IMOA</th></tr>
				</thead>
				<tbody>
					<tr><td>304L</td><td class="num">18</td><td class="num">18–19</td></tr>
					<tr><td>316L</td><td class="num">24</td><td class="num">24–25</td></tr>
					<tr><td>2101 (S32101)</td><td class="num">26</td><td class="num">25–27</td></tr>
					<tr><td>2304 (S32304)</td><td class="num">26</td><td class="num">25–28</td></tr>
					<tr><td>2205 (S31803 / S32205)</td><td class="num">35</td><td class="num">33–35 / 35–36</td></tr>
					<tr><td>2507 (S32750)</td><td class="num">43</td><td class="num">40–43</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			По оценке Outokumpu, в растворах хлоридов 2101 стойче 304L, а в отдельных случаях не уступает 316L;
			2304 в большинстве случаев равноценна 316L; 2205 и 2507 заметно выше. Для погружения в морскую воду
			со щелями нужен PREN больше 40, то есть супердуплекс. Какая марка нужна для атмосферы, брызг и
			погружения — в статье <a href="/blog/nerzhaveyka-dlya-morskoy-vody/">нержавейка для морской воды</a>.
		</p>
		<ul>
			<li><strong>Коррозионное растрескивание под напряжением.</strong> Главное преимущество дуплекса перед 304 и 316. Если феррита в структуре не меньше 30 %, сталь намного устойчивее аустенита к хлоридному КРН (IMOA). В испытании каплями раствора NaCl при 120 °C дуплекс растрескивается при напряжениях, составляющих гораздо большую долю предела текучести, чем 316. Поэтому его рассматривают там, где 304 и 316 уже трескались, например для горячих поверхностей под теплоизоляцией.</li>
			<li><strong>Кислоты.</strong> В серной кислоте 2205 и 2507 при концентрации примерно до 15 % превосходят многие высоконикелевые аустенитные стали и лучше 316 и 317 минимум до 40 %. Высокий хром помогает в окислительных кислотах. В серной кислоте средней концентрации и в соляной кислоте никеля для дуплекса не хватает.</li>
			<li><strong>Межкристаллитная коррозия.</strong> Углерода в современных марках не больше 0,030–0,040 %, и двухфазная структура хорошо сопротивляется МКК (Outokumpu).</li>
			<li><strong>Водород.</strong> Феррит склонен к водородному охрупчиванию, поэтому в средах с наводороживанием дуплекс применяют только после оценки условий. Самый известный пример — высокопрочные скважинные трубы для газа с небольшим содержанием сероводорода и рассола: для 2205 здесь есть диаграммы допустимых температур и давлений H₂S.</li>
		</ul>
	</section>

	<section id="svarka">
		<h2>Сварка дуплексной стали</h2>
		<p>
			Главная задача при сварке — сохранить баланс фаз в шве и околошовной зоне и не допустить выделения
			сигма-фазы и нитридов хрома. Слишком малая погонная энергия даёт шов и зону термического влияния
			с избытком феррита: падают вязкость и коррозионная стойкость. Слишком большая — повышает риск
			интерметаллидов. Поэтому режим задают диапазоном.
		</p>
		<div class="ba-table">
			<table>
				<caption>Режимы и присадки: рекомендации IMOA и Outokumpu</caption>
				<thead>
					<tr><th>Параметр</th><th>2304, 2101</th><th>2205</th><th>2507</th></tr>
				</thead>
				<tbody>
					<tr><td>Погонная энергия, кДж/мм</td><td>0,5–1,5</td><td>0,5–2,5</td><td>0,3–1,5</td></tr>
					<tr><td>Межваликовая температура, не выше</td><td>150 °C</td><td>150 °C</td><td>100 °C</td></tr>
					<tr><td>Присадка по ISO 14343 (AWS)</td><td>23 7 NL или 22 9 3 NL</td><td>22 9 3 NL (2209)</td><td>25 9 4 NL (2594)</td></tr>
					<tr><td>Минимальная температура закалки</td><td>980 °C (2304), 1020 °C (2101)</td><td>1040 °C</td><td>1025–1125 °C</td></tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>Подогрев</strong> не нужен и может навредить. Допустим только чтобы убрать влагу — равномерно, примерно до 100 °C.</li>
			<li><strong>Присадка</strong> «перелегирована» никелем: в ней на 2–4 % больше никеля, чем в основном металле, чтобы в шве образовалось достаточно аустенита. Шов без присадки получается почти ферритным — после такой сварки нужна закалка. Исключение — 2101: по Outokumpu, в ряде случаев её варят без присадки.</li>
			<li><strong>Защитный газ</strong> — аргон. Добавка азота (1–2 % по Outokumpu для TIG и плазмы, до 3 % по IMOA) помогает удержать азот в шве. Водород в защитный и поддувочный газ не добавляют из-за риска водородного охрупчивания феррита, кислород и CO₂ снижают стойкость шва.</li>
			<li><strong>Поджиги дуги</strong> вне разделки дают участки с очень быстрым охлаждением и избытком феррита — их делают только в самом шве.</li>
			<li><strong>Термообработка после сварки</strong> для снятия напряжений не нужна и вредна: нагрев выше 315 °C грозит выделением вредных фаз. Если термообработка необходима — только полная закалка с быстрым охлаждением в воде.</li>
			<li><strong>Разнородные соединения.</strong> С углеродистой сталью дуплекс варят присадками 309L, 309LMo или дуплексной 2209, с аустенитом 304 и 316 — чаще всего 309LMo (IMOA, Outokumpu).</li>
		</ul>
		<p>
			Если вязкость и стойкость шва подтверждены испытаниями, IMOA считает приемлемой долю феррита в нём
			25–75 %, по магнитным измерениям — FN 30–90. Отсутствие
			интерметаллидов проверяют коррозионным испытанием по ASTM A923, метод C: основной металл 2205
			испытывают при 25 °C, шов — при 22 °C, основной металл 2507 — при 40 °C. Общие правила сварки
			нержавейки — в статье <a href="/blog/kak-varit-nerzhaveyku/">как варить нержавейку</a>.
		</p>
	</section>

	<section id="temperatura">
		<h2>Ограничения по температуре</h2>
		<p>
			Верхний предел у дуплекса низкий из-за охрупчивания 475 °C. При 300–525 °C в феррите выделяется
			α-штрих-фаза: сначала растёт твёрдость, затем падает ударная вязкость. Благодаря аустениту эффект
			слабее, чем у чисто ферритных сталей, но он затрагивает все дуплексы, сильнее — молибденовые.
			При 700–1000 °C за минуты образуются сигма- и хи-фазы: они снижают и вязкость, и стойкость к
			питтингу, а убрать их можно только повторной закалкой.
		</p>
		<div class="ba-table">
			<table>
				<caption>Температурные интервалы и пределы применения (IMOA)</caption>
				<thead>
					<tr><th>Показатель</th><th>2205</th><th>2507</th></tr>
				</thead>
				<tbody>
					<tr><td>Охрупчивание 475 °C (α-штрих-фаза)</td><td>300–525 °C</td><td>300–525 °C</td></tr>
					<tr><td>Выделение нитридов и карбидов</td><td>450–800 °C</td><td>450–800 °C</td></tr>
					<tr><td>Образование сигма-фазы</td><td>700–950 °C</td><td>700–1000 °C</td></tr>
					<tr><td>Предел допускаемых напряжений по ASME</td><td>315 °C</td><td>315 °C</td></tr>
					<tr><td>Предел по нормам TÜV</td><td>280 °C без сварки, 250 °C со сваркой</td><td>250 °C (бесшовные трубы)</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			У lean-дуплекса 2304 предел TÜV — 300 °C, при сварке присадкой 2205/2209 — 250 °C. Российский
			ГОСТ 5632-2014 для 08Х22Н6Т ограничивает рабочую температуру сварной аппаратуры 300 °C. Для печей,
			выхлопа и других горячих узлов дуплекс не подходит — там работают жаростойкие аустенитные марки.
		</p>
		<p>
			Прокат дуплекса поставляют закалённым: толстый лист после нагрева охлаждают в воде, тонкий рулонный —
			на воздухе. Чем быстрее металл проходит интервал 700–1000 °C, тем меньше риск сигма-фазы. После
			горячей гибки или штамповки деталь снова закаливают, а в печь её загружают горячей, чтобы не греть
			медленно через опасный интервал (IMOA).
		</p>
	</section>

	<section id="primenenie">
		<h2>Где применяют дуплексную сталь</h2>
		<ul>
			<li><strong>Нефтегаз.</strong> Промысловые и технологические трубопроводы, сепараторы, скрубберы, насосы; на шельфе — насосно-компрессорные трубы, манифольды, узлы фонтанной арматуры. 2205 широко применяли на морских платформах для промысловых газопроводов и технологических линий: высокая прочность позволила уменьшить толщину стенок и массу. Из супердуплекса делают прутки, поковки, крепёж и трубки управляющих шлангокабелей.</li>
			<li><strong>Опреснение.</strong> Корпуса испарителей установок MSF и MED. В 2003 году 2205 выбрали для цельнодуплексных испарителей станций Melittah и Zuara в Ливии. С 2004 года испарители собирают из двух марок: 2205 — для самых агрессивных зон, более экономный lean-дуплекс — для остальных. По такой схеме из 2205 и S32101 построены Taweelah B (Абу-Даби), Jebel Ali L2 (Дубай) и Ras Abu Fontas B2 (Катар).</li>
			<li><strong>Химия и перевозка химгрузов.</strong> Грузовые танки химовозов, сосуды, теплообменники, насосы, фланцы и арматура.</li>
			<li><strong>Целлюлозно-бумажная промышленность.</strong> Варочные котлы, отбельное оборудование, резервуары для щёлоков. Дуплекс заменил здесь аустенит и углеродистую сталь: при том же давлении стенка тоньше, меньше сварки.</li>
			<li><strong>Мосты и архитектура.</strong> На мост Стоункаттерс в Гонконге в 2006 году ушло 2000 т листа и труб 2205, на мост Helix в Сингапуре — 570 т 2205. Кровлю нового аэропорта Дохи площадью около 195 000 м² сделали из lean-дуплекса S32003 — примерно 1600 т. Дуплекс применяют и как арматуру для мостовых плит.</li>
			<li><strong>Пищевые ёмкости.</strong> Lean-дуплекс S32101 и 2304 ставят в резервуары для продуктов и вина как более дешёвую замену 304 и 304L.</li>
		</ul>
		<p>
			Логика выбора простая. Lean-дуплекс заменяет 304L и 316L там, где важна прочность или есть риск КРН.
			2205 берут, когда 316L не хватает стойкости к хлоридам или нужна вдвое большая прочность при рабочей
			температуре до 250–315 °C. 2507 — для морской воды со щелями, горячих рассолов и других сред, где
			требуется PREN больше 40.
		</p>
	</section>
