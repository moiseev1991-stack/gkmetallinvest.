	{ id: 'sostav', anchor: 'Состав и аналоги по ГОСТ', summary: 'ASTM A240, EN 10088, 03Х22Н5АМ3' },
	{ id: 'svoystva', anchor: 'Прочность против 316L', summary: 'σ0,2, твёрдость, физика, магнитность' },
	{ id: 'korroziya', anchor: 'Коррозионная стойкость', summary: 'PREN, КРН, кислоты, водород' },
	{ id: 'svarka', anchor: 'Сварка', summary: 'Погонная энергия, присадка 2209' },
	{ id: 'temperatura', anchor: 'Ограничения по температуре', summary: '475 °C, сигма-фаза, 315 °C по ASME' },
