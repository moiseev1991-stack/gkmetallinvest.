					<tr><td class="num">25</td><td class="num">33,7</td><td class="num">32</td><td>32, 33, 34, 35 × 1,2–3,0</td></tr>
					<tr><td class="num">32</td><td class="num">42,4</td><td class="num">38</td><td>38, 40, 42, 43 × 1,2–3,0</td></tr>
					<tr><td class="num">40</td><td class="num">48,3</td><td class="num">45</td><td>45 × 1,2–3,0; 48 × 1,4–3,0</td></tr>
					<tr><td class="num">50</td><td class="num">60,3</td><td class="num">57</td><td>57, 60 × 1,4–3,0</td></tr>
					<tr><td class="num">65</td><td class="num">76,1</td><td class="num">76</td><td>76 × 1,4–4,0</td></tr>
