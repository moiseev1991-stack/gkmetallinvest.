---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sostav', anchor: 'Класс и состав', summary: 'ГОСТ 5632-2014 и ASTM A276' },
	{ id: 'analogi', anchor: 'Аналоги 431', summary: 'EN 1.4057, SUS431, где совпадения нет' },
	{ id: 'termoobrabotka', anchor: 'Термообработка и механика', summary: 'Закалка, отпуск, запретный интервал' },
	{ id: 'svoystva', anchor: 'Физические свойства', summary: 'Плотность, магнитность, нагрев' },
	{ id: 'korroziya', anchor: 'Коррозионная стойкость', summary: 'Лучше 410 и 420, близко к 304' },
	{ id: 'svarka', anchor: 'Сварка и обработка', summary: 'Подогрев, присадка, резание' },
	{ id: 'primenenie', anchor: 'Применение', summary: 'Валы, крепёж, насосы; почему не 304 и 420' },
	{ id: 'sortament', anchor: 'Сортамент и стандарты', summary: 'Круг и шестигранник, ГОСТ 5949-2018' },
	{ id: 'sravnenie', anchor: '431, 303, 302 и 304', summary: 'Справочное сравнение с таблицей' },
];

const faq = [
	{
		q: 'Что за сталь AISI 431 и какой у неё аналог?',
		a: 'AISI 431 (UNS S43100) — нержавеющая сталь мартенситного класса по ASTM (14Х17Н2 по ГОСТ 5632-2014 относится к мартенсито-ферритному классу) с хромом 15–17 % и никелем 1,25–2,50 % по ASTM A276. Российский аналог — 14Х17Н2 (ЭИ268) по ГОСТ 5632-2014: углерод 0,11–0,17 %, хром 16–18 %, никель 1,5–2,5 %. Европейский аналог — 1.4057 (X17CrNi16-2) по EN 10088-3, японский — SUS431. Пределы по составу у стандартов не совпадают, поэтому соответствие проверяют по анализу плавки.',
	},
	{
		q: 'Магнитится ли 14Х17Н2?',
		a: 'Да. 14Х17Н2 ферромагнитна и в отожжённом, и в закалённом состоянии. Магнит отличит её от аустенитных 304, 321 и 12Х18Н10Т, но не от 12Х13, 40Х13 или AISI 430. Марку подтверждают сертификатом с анализом плавки или спектральным анализом: по никелю 1,5–2,5 % она отличается от безникелевых хромистых сталей.',
	},
	{
		q: 'Чем 14Х17Н2 отличается от 12Х18Н10Т?',
		a: '12Х18Н10Т — аустенитная сталь с 9–11 % никеля: немагнитная, закалкой не упрочняется, хорошо сваривается. 14Х17Н2 — мартенситная, с 1,5–2,5 % никеля: ферромагнитная, упрочняется закалкой и отпуском. По ГОСТ 5949-2018 после закалки и отпуска 14Х17Н2 даёт предел текучести не менее 635–835 МПа, а у 12Х18Н10Т он составляет от 196 МПа. Коррозионная стойкость 14Х17Н2 близка к AISI 304 или чуть ниже, сварка трудная.',
	},
	{
		q: 'Варится ли 14Х17Н2?',
		a: 'Сваривается трудно, с риском трещин. Марочник сталей и сплавов относит 14Х17Н2 к трудносвариваемым. Atlas Steels рекомендует подогрев 200–300 °C и термообработку после сварки при 650 °C. Присадка 410 даёт шов, близкий по свойствам к основному металлу; присадки 308L, 309 и 310 дают более пластичный шов, но без равной прочности. Для сварных конструкций, как правило, берут аустенитные марки.',
	},
	{
		q: 'Чем AISI 303 отличается от 304?',
		a: 'Серой. В 303 по ASTM сера не менее 0,15 %, а в 304 — не более 0,030 %. Сера дробит стружку: 303 — лучшая по обрабатываемости резанием среди аустенитных сталей, её берут для деталей токарных автоматов. Платой становятся коррозионная стойкость ниже 304 (сульфиды становятся очагами питтинга), плохая свариваемость и худшая гибка. Atlas Steels не рекомендует 303 для морской среды. Подробнее — в справочной части статьи.',
	},
	{
		q: 'Что такое AISI 302?',
		a: 'Старая аустенитная марка 18/8: по ASTM A276 в ней до 0,15 % углерода, 17–19 % хрома и 8–10 % никеля. От 304 она отличается углеродом (у 304 — до 0,08 %) и более узким интервалом по хрому. Ближайшая марка ГОСТ 5632-2014 — 12Х18Н9 (до 0,12 % углерода); 15Х18Н9 с углеродом 0,13–0,21 % даёт верхнюю часть диапазона. Для листа и сортового проката общего назначения обычно берут 304, а 302 чаще встречается в пружинной проволоке.',
	},
];

const sources = [
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1 (14Х17Н2: номер 2-4; 12Х18Н9, 12Х18Н10Е, 15Х18Н9), приложение А', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5949-2018 — металлопродукция из сталей нержавеющих: табл. 1 (твёрдость HB) и табл. 3 (механические свойства)', href: 'https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/1/gost_5949-2018_mezhgosudarstvennyy_standart.html' },
	{ label: 'Марочник сталей и сплавов — 14Х17Н2: состав по ГОСТ 5632-72, механика, физические свойства, зарубежные аналоги, виды поставки', href: 'http://www.splav-kharkov.com/mat_start.php?name_id=325' },
	{ label: 'Atlas Steels — Stainless Steel 431 Grade Data Sheet: ASTM A276, термообработка, коррозия, сварка, применение (2021)', href: 'https://atlassteels.com.au/wp-content/uploads/2021/06/Stainless-Steel-431-Grade-Data-Sheet-28-04-21.pdf' },
	{ label: 'Deutsche Edelstahlwerke (Swiss Steel Group) — технический лист 1.4057 (X17CrNi16-2): термообработка QT800 и QT900, сварка, охрупчивание', href: 'https://swisssteel-group.com/content-media/documents/Data-Sheets/Stainless-Steel/Datenblatt_4057_UK.pdf' },
	{ label: 'Rodacciai — X17CrNi16-2, 1.4057, EN 10088-3: состав, механические свойства, режимы термообработки', href: 'https://www.rodacciai.com/UPLOAD/datasheets/431_X17CrNi16-2-Nr.1.4057-ENG.pdf' },
	{ label: 'AZoM — Stainless Steel Grade 431 (UNS S43100): механика по температурам отпуска, коррозия, сварка', href: 'https://www.azom.com/article.aspx?ArticleID=1023' },
	{ label: 'Boltport — ASTM A276: состав и механика типов 302, 304 и 431 (сводка)', href: 'https://boltport.com/specifications/astm-a276/' },
	{ label: 'Atlas Steels — Stainless Steel 303, 303Se Grade Data Sheet: ASTM A582, коррозия, сварка, обработка (2021)', href: 'https://atlassteels.com.au/wp-content/uploads/2021/06/Stainless-Steel-303-303Se-Grade-Data-Sheet-23-04-21.pdf' },
	{ label: 'Abrams Industries — 303 (1.4305, X8CrNiS18-9): сера 0,15–0,35 %', href: 'https://us.abrams-industries.com/steel/stainless-steel/303' },
	{ label: 'Optimum Spring — AISI 302/304 Stainless Steel Spring Wire (ASTM A313)', href: 'https://optimumspring.com/technical_resources/materials/stainless_steels/302_304_stainless_steel_spring_wire.aspx' },
	{ label: 'ASTM A276 — прутки и профили из нержавеющей стали (типы 302, 303, 304, 431)' },
	{ label: 'ASTM A582 — прутки из автоматной нержавеющей стали (тип 303)' },
	{ label: 'EN 10088-3 — сортовой прокат: 1.4057 (X17CrNi16-2), 1.4305 (X8CrNiS18-9)' },
];

const related = [
	{ label: 'Сталь 40Х13: характеристики, аналог AISI 420, твёрдость', href: '/blog/stal-40h13/' },
	{ label: 'Сталь 20Х13, 30Х13, 40Х13: мартенситная нержавейка', href: '/blog/martensitnaya-stal-20h13-40h13/' },
	{ label: 'AISI 430: характеристики, аналог 12Х17', href: '/blog/aisi-430-harakteristiki/' },
	{ label: 'Характеристики AISI 304, 316L и 321: сравнение', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'Аналоги марок нержавейки: AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
	{ label: 'Круг, квадрат, шестигранник нержавеющие — каталог', href: '/krug-nerzhaveyushchiy/' },
];
---

<BlogArticle
	slug="aisi-431-14h17n2"
	title="AISI 431 (14Х17Н2): аналог, состав и свойства"
	description="AISI 431 (14Х17Н2): аналоги EN 1.4057 и SUS431, состав по ГОСТ 5632 и ASTM A276, термообработка, магнитность, сварка и отличия от AISI 303 и 302."
	h1="AISI 431 (14Х17Н2): аналог, состав, свойства и отличия от 303 и 302"
	eyebrow="Справочник"
	datePublished="2026-10-05"
	dateModified="2026-10-06"
	readingMin={10}
	answer="<strong>AISI 431 (14Х17Н2) — мартенситная по ASTM (мартенсито-ферритная по ГОСТ 5632-2014) хромоникелевая нержавеющая сталь: по ГОСТ 5632-2014 в 14Х17Н2 содержится 0,11–0,17 % углерода, 16–18 % хрома и 1,5–2,5 % никеля.</strong> Зарубежные аналоги — AISI 431 (ASTM A276), 1.4057 (X17CrNi16-2) по EN 10088-3 и SUS431. Сталь упрочняется закалкой и отпуском: по ГОСТ 5949-2018 после отпуска при 275–350 °C предел прочности — не менее 1080 МПа. Она магнитится, по коррозионной стойкости близка к AISI 304 или чуть ниже, сваривается трудно. Применяют её для валов, осей, крепежа и деталей насосов."
	keyFacts={[
		'Состав: ГОСТ 5632-2014 — C 0,11–0,17 %, Cr 16–18 %, Ni 1,5–2,5 %; ASTM A276 — C ≤ 0,20 %, Cr 15–17 %, Ni 1,25–2,50 %',
		'Аналоги: 1.4057 (X17CrNi16-2), SUS431; пределы по составу у стандартов разные, полного совпадения нет',
		'ГОСТ 5949-2018: закалка 975–1040 °C в масле, отпуск 275–350 °C — σв ≥ 1080 МПа, σ0,2 ≥ 835 МПа; отпуск 620–660 °C — σв ≥ 835 МПа, KCU ≥ 75 Дж/см²',
		'Плотность 7,70–7,75 г/см³, ферромагнитна; отпуск при 425–600 °C не применяют из-за потери ударной вязкости',
		'Сварка трудная: подогрев 200–300 °C и отпуск после сварки; для сварных конструкций берут аустенитные марки',
	]}
	coverAlt="AISI 431 (14Х17Н2): химический состав, аналоги 1.4057 и SUS431, свойства и отличия от 303 и 302"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['AISI 431', '14Х17Н2', 'EN 1.4057', 'Мартенситная нержавеющая сталь', 'AISI 303', 'AISI 302']}
	cta={{ title: 'Нужен круг или шестигранник AISI 431?', text: 'Поставляем круг и шестигранник AISI 431 (14Х17Н2) со склада — пришлите диаметр или размер под ключ, длину и объём для расчёта. Отгружаем с сертификатом завода-изготовителя.' }}
>
	<section id="sostav">
		<h2>Что такое AISI 431 и 14Х17Н2: класс и химический состав</h2>
		<p>
			AISI 431 (UNS S43100) — нержавеющая сталь мартенситного класса с добавкой никеля. Хрома в ней 15–17 %,
			никеля 1,25–2,50 % по ASTM A276. Российская 14Х17Н2 (прежнее обозначение 1Х17Н2, марка ЭИ268) в
			ГОСТ 5632-2014 относится к мартенсито-ферритному классу, порядковый номер марки 2-4. Название читается
			так: 14 — около 0,14 % углерода, Х17 — около 17 % хрома, Н2 — около 2 % никеля.
		</p>
		<p>
			Сталь закаливается и после термообработки прочнее аустенитных марок. Никель делает её вязче и
			коррозионно-стойче, чем хромистые стали с 13 % хрома (12Х13, 20Х13, 40Х13). Производители описывают её
			как марку для случаев, когда стойкости или вязкости 12-процентных хромистых сталей не хватает.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка, стандарт</th><th>C</th><th>Si</th><th>Mn</th><th>Cr</th><th>Ni</th><th>S</th><th>P</th></tr>
				</thead>
				<tbody>
					<tr><td>14Х17Н2 — ГОСТ 5632-2014</td><td>0,11–0,17</td><td>0,80</td><td>0,80</td><td>16,0–18,0</td><td>1,5–2,5</td><td>0,025</td><td>0,030</td></tr>
					<tr><td>AISI 431 — ASTM A276</td><td>0,20</td><td>1,00</td><td>1,00</td><td>15,0–17,0</td><td>1,25–2,50</td><td>0,030</td><td>0,040</td></tr>
					<tr><td>1.4057 / X17CrNi16-2 — EN 10088-3</td><td>0,12–0,22</td><td>1,00</td><td>1,50</td><td>15,0–17,0</td><td>1,50–2,50</td><td>0,030</td><td>0,040</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Марочник сталей и сплавов приводит состав по ГОСТ 5632-72: пределы по основным элементам те же,
			дополнительно ограничены титан (до 0,2 %) и медь (до 0,3 %). Заменителем 14Х17Н2 марочник называет
			20Х17Н2.
		</p>
	</section>

	<section id="analogi">
		<h2>Аналог AISI 431: EN 1.4057, SUS431 и где совпадения нет</h2>
		<div class="ba-table">
			<table>
				<caption>Обозначения 14Х17Н2 в разных стандартах</caption>
				<thead>
					<tr><th>Страна, стандарт</th><th>Обозначение</th></tr>
				</thead>
				<tbody>
					<tr><td>Россия, ГОСТ 5632-2014</td><td>14Х17Н2 (ЭИ268)</td></tr>
					<tr><td>США, ASTM A276, UNS</td><td>AISI 431, UNS S43100</td></tr>
					<tr><td>Европа, EN 10088-3</td><td>1.4057, X17CrNi16-2</td></tr>
					<tr><td>Япония, JIS</td><td>SUS431</td></tr>
					<tr><td>Франция, Великобритания</td><td>Z15CN16-02, 431S29</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Все эти марки считают аналогами, но совпадают они не полностью. Хром в ГОСТ — 16–18 %, в ASTM и EN —
			15–17 %: общий участок только 16–17 %. Углерод в ГОСТ — 0,11–0,17 %, в EN — 0,12–0,22 %, в ASTM — не более
			0,20 % без нижней границы. Никель по ГОСТ и EN — 1,5–2,5 %, по ASTM нижняя граница 1,25 %.
		</p>
		<p>
			Плавка с 16,5 % хрома, 0,15 % углерода и 2,0 % никеля подходит под все три стандарта. Плавка с 15,5 %
			хрома соответствует AISI 431 и 1.4057, но не 14Х17Н2. Плавка с 0,19 % углерода проходит по ASTM и EN, но не
			по ГОСТ. Поэтому при замене марки в заказе указывают нужный стандарт, а соответствие проверяют по
			сертификату с анализом плавки. Общая таблица соответствия марок — в статье об
			<a href="/blog/analogi-marok-nerzhaveyki/">аналогах нержавейки</a>.
		</p>
	</section>

	<section id="termoobrabotka">
		<h2>Термообработка и механические свойства</h2>
		<p>
			Свойства 14Х17Н2 задаёт термообработка. ГОСТ 5949-2018 нормирует для неё два режима: закалку в масле с
			низким или высоким отпуском. В поставке твёрдость прутка — не более 285 HB (табл. 1).
		</p>
		<div class="ba-table">
			<table>
				<caption>Механические свойства 14Х17Н2 по ГОСТ 5949-2018, табл. 3 (не менее)</caption>
				<thead>
					<tr><th>Режим</th><th class="num">σв, МПа</th><th class="num">σ0,2, МПа</th><th class="num">δ5, %</th><th class="num">ψ, %</th><th class="num">KCU, Дж/см²</th></tr>
				</thead>
				<tbody>
					<tr><td>Закалка 975–1040 °C, масло; отпуск 275–350 °C, воздух</td><td class="num">1080</td><td class="num">835</td><td class="num">10</td><td class="num">30</td><td class="num">49</td></tr>
					<tr><td>Закалка 1000–1030 °C, масло; отпуск 620–660 °C, воздух</td><td class="num">835</td><td class="num">635</td><td class="num">16</td><td class="num">55</td><td class="num">75</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Размер образцов в таблице — по данным марочника сталей и сплавов, пруток Ø 60 мм. Низкий отпуск даёт
			максимальную прочность, высокий — вязкость и пластичность. ГОСТ 5632-2014 отмечает, что наибольшей
			коррозионной стойкостью 14Х17Н2 обладает после закалки с высоким отпуском.
		</p>
		<div class="ba-table">
			<table>
				<caption>AISI 431 после закалки: типичные свойства по температуре отпуска (Atlas Steels)</caption>
				<thead>
					<tr><th>Температура отпуска</th><th class="num">σв, МПа</th><th class="num">σ0,2, МПа</th><th class="num">δ, %</th><th class="num">Твёрдость, HB</th><th class="num">Ударная вязкость Izod, Дж</th></tr>
				</thead>
				<tbody>
					<tr><td>300 °C</td><td class="num">1320</td><td class="num">1020</td><td class="num">20</td><td class="num">380</td><td class="num">75</td></tr>
					<tr><td>400 °C</td><td class="num">1310</td><td class="num">1010</td><td class="num">22</td><td class="num">395</td><td class="num">80</td></tr>
					<tr><td>500 °C</td><td class="num">1350</td><td class="num">1030</td><td class="num">20</td><td class="num">395</td><td class="num">55</td></tr>
					<tr><td>600 °C</td><td class="num">1030</td><td class="num">800</td><td class="num">20</td><td class="num">310</td><td class="num">45</td></tr>
					<tr><td>700 °C</td><td class="num">920</td><td class="num">700</td><td class="num">20</td><td class="num">290</td><td class="num">70</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Прочность держится почти на одном уровне до 500 °C, а ударная вязкость после отпуска при 500 и 600 °C
			заметно ниже, чем после 300, 400 и 700 °C. Это отпускная хрупкость.
		</p>
		<div class="ba-table">
			<table>
				<caption>Механические свойства 1.4057 по EN 10088-3 (Rodacciai, Swiss Steel Group)</caption>
				<thead>
					<tr><th>Состояние</th><th class="num">σ0,2, МПа, не менее</th><th class="num">σв, МПа</th><th class="num">A5, %, не менее</th></tr>
				</thead>
				<tbody>
					<tr><td>Отожжённое +A, до 100 мм</td><td class="num">—</td><td class="num">до 950, не более 295 HB</td><td class="num">—</td></tr>
					<tr><td>Закалка и отпуск +QT800, до 60 мм</td><td class="num">600</td><td class="num">800–950</td><td class="num">14</td></tr>
					<tr><td>Закалка и отпуск +QT900, до 60 мм</td><td class="num">700</td><td class="num">900–1050</td><td class="num">12</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Atlas Steels отмечает, что сталь закаливается примерно до 40 HRC. Для сравнения, 40Х13 после закалки
			даёт не менее 50 HRC (<a href="/blog/stal-40h13/">статья о стали 40Х13</a>). Как твёрдость распределяется по
			остальным маркам — в статье о <a href="/blog/tverdost-nerzhaveyushchey-stali/">твёрдости нержавеющей
			стали</a>.
		</p>

		<h3>Режимы термообработки</h3>
		<ul>
			<li><strong>Закалка.</strong> ГОСТ 5949-2018 — 975–1040 °C, масло (или 1000–1030 °C для режима с высоким отпуском). EN 10088-3 — 950–1050 °C, воздух или масло. Atlas Steels — 980–1065 °C, выдержка около получаса, воздух или масло.</li>
			<li><strong>Отпуск.</strong> Низкий — 275–350 °C (ГОСТ 5949-2018), высокий — 620–660 °C. По EN: QT800 — отпуск при 750–800 °C и повторный при 650–700 °C, QT900 — при 600–650 °C. Если никель на нижней границе, для QT800 достаточно одного отпуска при 620–720 °C (Swiss Steel Group).</li>
			<li><strong>Отжиг.</strong> Данные расходятся. Rodacciai и Swiss Steel Group дают смягчающий отжиг 680–800 °C с охлаждением в печи или на воздухе. Atlas Steels пишет, что полный отжиг непрактичен — сталь закаливается и при медленном охлаждении, — и предлагает промежуточный отжиг при 620–660 °C.</li>
			<li><strong>Интервал, которого избегают.</strong> Atlas Steels и AZoM — отпуск при 425–600 °C из-за потери ударной вязкости; Swiss Steel Group — 420–520 °C (охрупчивание «475 °C»), в том числе при эксплуатации. Марочник сталей и сплавов указывает, что 14Х17Н2 склонна к отпускной хрупкости. Режимы ГОСТ 5949-2018 в этот интервал не попадают.</li>
		</ul>
	</section>

	<section id="svoystva">
		<h2>Плотность, магнитность и физические свойства</h2>
		<div class="ba-table">
			<table>
				<caption>Физические свойства 14Х17Н2 / AISI 431</caption>
				<thead>
					<tr><th>Свойство</th><th>Значение</th><th>Источник</th></tr>
				</thead>
				<tbody>
					<tr><td>Плотность при 20 °C</td><td>7,75 г/см³ (7750 кг/м³)</td><td>Марочник сталей и сплавов</td></tr>
					<tr><td>Плотность при 20 °C</td><td>7,70 г/см³</td><td>Atlas Steels, Swiss Steel Group</td></tr>
					<tr><td>Модуль упругости при 20 °C</td><td>197 ГПа (200 ГПа)</td><td>Марочник (Atlas Steels)</td></tr>
					<tr><td>Коэффициент теплового расширения, 20–100 °C</td><td>9,8 × 10⁻⁶ 1/К (10,0–10,2 × 10⁻⁶ 1/К)</td><td>Марочник (Swiss Steel Group, Atlas Steels)</td></tr>
					<tr><td>Теплопроводность при 20 °C</td><td>20,9 Вт/(м·К)</td><td>Марочник сталей и сплавов</td></tr>
					<tr><td>Удельная теплоёмкость при 20 °C</td><td>460 Дж/(кг·К)</td><td>Atlas Steels, Swiss Steel Group</td></tr>
					<tr><td>Удельное электросопротивление при 20 °C</td><td>0,72 мкОм·м (0,70 мкОм·м)</td><td>Марочник (Swiss Steel Group)</td></tr>
					<tr><td>Критические точки</td><td>Ac1 = 720 °C, Ac3 = 830 °C, Ar1 = 700 °C</td><td>Марочник сталей и сплавов</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			В скобках — значения второго источника, они немного расходятся. На заказ это не влияет: круг Ø 20 мм при
			7,75 г/см³ весит около 2,43 кг на метр. В <a href="/kalkulyator-vesa/">калькуляторе веса металлопроката</a>
			для 14Х17Н2 заложено 7,75 г/см³.
		</p>
		<p>
			<strong>Магнитность.</strong> Сталь ферромагнитна. Магнит отличает 14Х17Н2 от аустенитных 304, 321 и
			12Х18Н10Т, но не от 40Х13, 12Х13 или AISI 430. Почему одни нержавейки магнитятся, а другие нет, — в статье
			<a href="/blog/magnitit-li-nerzhaveika/">магнитится ли нержавейка</a>.
		</p>
		<p>
			<strong>Нагрев.</strong> Atlas Steels называет стойкость к окалинообразованию 925 °C при периодическом и
			870 °C при постоянном нагреве, но не рекомендует работать выше температуры отпуска: прочность падает.
			Swiss Steel Group указывает температуру применения около 400 °C.
		</p>
	</section>

	<section id="korroziya">
		<h2>Коррозионная стойкость</h2>
		<p>
			Atlas Steels называет 431 лучшей по коррозионной стойкости среди мартенситных марок: хрома больше, чем в
			12Х13 и 40Х13, и есть никель. Общая стойкость, по тем же данным, примерно такая же, как у AISI 304, или
			немного ниже. AZoM пишет, что сталь заметно стойка к солёной воде.
		</p>
		<ul>
			<li><strong>Где хватает.</strong> Atlas Steels отмечает хорошую стойкость в широком круге сред. ГОСТ 5632-2014 называет детали, работающие в агрессивных средах и при пониженных температурах, марочник — детали компрессоров на нитрозном газе.</li>
			<li><strong>Морская вода.</strong> Atlas Steels: приемлемая стойкость в холодной морской воде, но не в тёплой тропической. Для постоянного контакта с морской водой берут другие марки — какие, разобрано в статье о <a href="/blog/nerzhaveyka-dlya-morskoy-vody/">нержавейке для морской воды</a>.</li>
			<li><strong>Состояние.</strong> Наибольшая стойкость — после закалки с высоким отпуском (ГОСТ 5632-2014) и на гладкой поверхности (Atlas Steels, Swiss Steel Group): у полированной стали она выше, чем у шероховатой.</li>
			<li><strong>Межкристаллитная коррозия.</strong> Swiss Steel Group отмечает, что выпадение карбидов хрома делает 1.4057 склонной к межкристаллитной коррозии. Подробнее о механизме — в статье о <a href="/blog/mezhkristallitnaya-korroziya/">межкристаллитной коррозии</a>.</li>
		</ul>
	</section>

	<section id="svarka">
		<h2>Сварка, резание и холодная деформация</h2>
		<p>
			Марочник сталей и сплавов относит 14Х17Н2 к трудносвариваемым: нужны подогрев 200–300 °C и термообработка
			после сварки. Atlas Steels называет сварку трудной из-за риска трещин. Swiss Steel Group оценивает
			свариваемость 1.4057 как хорошую, но только при подогреве 100–300 °C и отпуске сразу после сварки.
		</p>
		<ul>
			<li><strong>Подогрев.</strong> 200–300 °C перед сваркой (Atlas Steels, марочник); 100–300 °C при присадке, близкой к основному металлу (Swiss Steel Group).</li>
			<li><strong>После сварки.</strong> Отпуск при 650 °C (Atlas Steels). Для лучших свойств изделие термообрабатывают целиком (Swiss Steel Group).</li>
			<li><strong>Присадка.</strong> 410 — шов, близкий по свойствам к основному металлу; 308L, 309 или 310 — более пластичный шов, но без равной прочности (Atlas Steels).</li>
			<li><strong>Защитный газ.</strong> Без азота и газов, содержащих углерод: они ухудшают свойства шва (Swiss Steel Group). После сварки удаляют брызги и цвета побежалости — иначе стойкость шва ниже.</li>
		</ul>
		<p>
			Общие правила сварки нержавейки — в статье о <a href="/blog/kak-varit-nerzhaveyku/">сварке нержавеющей стали</a>.
		</p>
		<p>
			<strong>Резание.</strong> В отожжённом состоянии сталь обрабатывается относительно легко; выше 30 HRC
			обработка становится трудной (Atlas Steels, AZoM). Swiss Steel Group оценивает обрабатываемость как
			невысокую: 1.4057 режется как углеродистая сталь той же твёрдости. Заготовку обрабатывают до размера, затем
			закаливают. О выборе сверла и режимов — в статье о <a href="/blog/chem-sverlit-nerzhaveyku/">сверлении
			нержавейки</a>.
		</p>
		<p>
			<strong>Холодная деформация.</strong> Atlas Steels не рекомендует 431 для холодной высадки, гибки,
			глубокой вытяжки и накатки: у неё высокая текучесть, и деформировать её трудно.
		</p>
	</section>

	<section id="primenenie">
		<h2>Где применяют AISI 431 (14Х17Н2)</h2>
		<p>
			ГОСТ 5632-2014 (приложение А) называет для 14Х17Н2 рабочие лопатки, диски, валы, втулки и другие детали,
			а также детали, работающие в агрессивных средах и при пониженных температурах в химической, авиационной и
			других отраслях. Марочник добавляет фланцы, крепёж и детали компрессоров на нитрозном газе. Справочники
			производителей уточняют:
		</p>
		<ul>
			<li><strong>Валы и оси</strong> — валы насосов, гребные валы (Atlas Steels, AZoM).</li>
			<li><strong>Крепёж</strong> — болты, гайки, шпильки (Atlas Steels, AZoM).</li>
			<li><strong>Судовое оборудование</strong> — морская фурнитура в холодной воде (Atlas Steels).</li>
			<li><strong>Отрасли</strong> — авиация, автомобилестроение, химическая и нефтехимическая промышленность, машиностроение (Swiss Steel Group).</li>
			<li><strong>Лабораторное оборудование</strong> (AZoM).</li>
		</ul>
		<h3>Почему 431, а не 304 или 420</h3>
		<ul>
			<li><strong>304 и 12Х18Н10Т не упрочняются термообработкой.</strong> Предел текучести отожжённой 304 по ASTM A276 — от 205 МПа. У 14Х17Н2 по ГОСТ 5949-2018 он не менее 635–835 МПа — в три–четыре раза больше. Взамен вы получаете ферромагнитность, трудную сварку и стойкость к коррозии на уровне 304 или чуть ниже.</li>
			<li><strong>420 и 40Х13 тверже, но коррозионно слабее.</strong> Закалённая 40Х13 даёт от 50 HRC, 431 — около 40 HRC, зато у неё больше хрома и есть никель. Для режущего инструмента и деталей на износ берут 420 или 40Х13, для валов и крепежа в коррозионной среде — 431.</li>
			<li><strong>Если нужна ещё более высокая твёрдость</strong>, Atlas Steels советует 440C, а если достаточно меньшей прочности — 410.</li>
		</ul>
	</section>

	<section id="sortament">
		<h2>Сортамент и стандарты на круг и шестигранник</h2>
		<p>
			Технические требования к сортовому прокату из 14Х17Н2 задаёт ГОСТ 5949-2018, состав — ГОСТ 5632-2014.
			Прокат бывает горячекатаным, кованым или калиброванным, термообработанным или нагартованным. Состояние
			поставки и твёрдость оговаривайте при заказе.
		</p>
		<div class="ba-table">
			<table>
				<caption>Виды проката из 14Х17Н2 (марочник сталей и сплавов, ГОСТ 5949-2018)</caption>
				<thead>
					<tr><th>Вид проката</th><th>Сортамент</th></tr>
				</thead>
				<tbody>
					<tr><td>Круг горячекатаный</td><td>ГОСТ 2590</td></tr>
					<tr><td>Круг и квадрат кованые</td><td>ГОСТ 1133</td></tr>
					<tr><td>Круг калиброванный</td><td>ГОСТ 7417</td></tr>
					<tr><td>Круг со специальной отделкой поверхности</td><td>ГОСТ 14955</td></tr>
					<tr><td>Шестигранник горячекатаный</td><td>ГОСТ 2879</td></tr>
					<tr><td>Шестигранник калиброванный</td><td>ГОСТ 8560</td></tr>
					<tr><td>Прутки шлифованные, нагартованные или термообработанные</td><td>ГОСТ 18907-73</td></tr>
