					<tr><td class="num">1,5</td><td class="num">0,9</td><td class="num">85–95</td><td class="num">19–20</td><td class="num">4,6–5,2</td><td class="num">14</td></tr>
					<tr><td class="num">2</td><td class="num">0,9</td><td class="num">105–110</td><td class="num">20–21</td><td class="num">5,8–7,0</td><td class="num">14</td></tr>
					<tr><td class="num">3</td><td class="num">0,9</td><td class="num">125–130</td><td class="num">20–21</td><td class="num">7,6–8,3</td><td class="num">14</td></tr>
					<tr><td class="num">3</td><td class="num">1,1</td><td class="num">100–120</td><td class="num">19–20</td><td class="num">2,5–3,2</td><td class="num">14</td></tr>
					<tr><td class="num">4</td><td class="num">1,1</td><td class="num">135–150</td><td class="num">21</td><td class="num">3,8–4,4</td><td class="num">14</td></tr>
					<tr><td class="num">5</td><td class="num">1,1</td><td class="num">170–175</td><td class="num">22</td><td class="num">5,6–6,4</td><td class="num">14</td></tr>
