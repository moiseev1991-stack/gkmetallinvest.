---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'mozhno-li', anchor: 'Можно ли варить', summary: 'Когда полуавтомат, а когда TIG' },
	{ id: 'gaz', anchor: 'Защитный газ', summary: 'Почему не CO2, смеси M12 и M13, расход' },
	{ id: 'provoloka', anchor: 'Проволока', summary: 'ER308LSi, ER347Si, ER316LSi, ER309LSi' },
	{ id: 'rezhimy', anchor: 'Режимы', summary: 'Перенос металла, ток, напряжение, подача' },
	{ id: 'podgotovka', anchor: 'Подготовка', summary: 'Канал, ролики, кромки, поддув корня' },
	{ id: 'tehnika', anchor: 'Техника', summary: 'Вылет, угол, валики, межпроходная температура' },
	{ id: 'posle', anchor: 'После сварки', summary: 'Побежалость, травление, пассивация' },
	{ id: 'oshibki', anchor: 'Ошибки и дефекты', summary: 'Поры, брызги, прожоги, ржавые пятна' },
];

const faq = [
	{
		q: 'Можно ли варить нержавейку полуавтоматом?',
		a: 'Да. Аустенитные стали AISI 304, 321, 316L варят полуавтоматом проволокой из нержавейки в смеси аргона с 1–3 % активного газа, постоянным током обратной полярности. Способ оправдан на металле от 1 мм, на длинных швах и в серийном производстве. Для листа тоньше 1 мм, корня ответственных стыков и видимых пищевых швов обычно выбирают аргонодуговую сварку (TIG).',
	},
	{
		q: 'Какой газ нужен для сварки нержавейки полуавтоматом?',
		a: 'Смесь аргона с 2–3 % углекислого газа (группа M12 по ISO 14175) или аргона с 1–2 % кислорода (M13). Для короткой дуги Lincoln Electric рекомендует трёхкомпонентную смесь 90 % гелия, 7,5 % аргона и 2,5 % CO2: валик получается плоским, а сплавление — лучше. Расход — около 7–14 л/мин при короткой дуге и 14–19 л/мин при струйном переносе.',
	},
	{
		q: 'Можно ли варить нержавейку углекислотой?',
		a: 'Сплошной нержавеющей проволокой в чистом CO2 — нет. В дуге углекислый газ распадается, кислород окисляет хром, кремний и марганец, углерод переходит в шов, а перенос металла идёт крупными каплями с брызгами. Стойкость шва к коррозии падает. Чистый CO2 допустим только для порошковой проволоки, рассчитанной на него, например класса E308LT1-1 по AWS A5.22.',
	},
	{
		q: 'Какая проволока нужна для сварки нержавейки полуавтоматом?',
		a: 'Проволоку подбирают под марку стали, для полуавтомата — с индексом Si. Для AISI 304 и 08Х18Н10 — ER308LSi, для 12Х18Н10Т и AISI 321 — ER347Si, для 316L и 10Х17Н13М2Т — ER316LSi, для соединения нержавейки с углеродистой сталью — ER309LSi. Ближайшие российские аналоги по ГОСТ 2246-70 — Св-01Х19Н9, Св-07Х19Н10Б, Св-04Х19Н11М3 и Св-07Х25Н13.',
	},
	{
		q: 'Как настроить полуавтомат для сварки нержавейки?',
		a: 'Поставьте тефлоновый канал вместо стального, ролики и наконечник под диаметр проволоки, полярность — плюс на горелке. Для листа 1–2 мм проволокой 0,9 мм Lincoln Electric приводит 55–110 А, 19–21 В и подачу 3–7 м/мин в гелиевой смеси. Вылет — 10–13 мм. Точный режим подбирают пробными швами на обрезках того же металла.',
	},
	{
		q: 'Можно ли варить нержавейку с чёрным металлом полуавтоматом?',
		a: 'Да, проволокой ER309LSi (российский аналог — Св-07Х25Н13). Обычная ER308LSi при разбавлении углеродистой сталью даёт в шве мартенсит, а он хрупкий и склонен к трещинам. Варят короткой дугой с малым тепловложением и держат проволоку ближе к нержавеющей кромке. Углеродистую сталь с углеродом до 0,20 % по данным Nickel Institute сваривают без подогрева.',
	},
];

const sources = [
	{ label: 'Lincoln Electric C4.200 — Gas Metal Arc Welding Guide: защитные газы, режимы для нержавеющей стали, ток перехода к струйному переносу', href: 'http://static.gasandsupply.com/docs/LIN_c4200.pdf' },
	{ label: 'Lincoln Electric — MIG Welding Stainless Steel: газы для короткой дуги', href: 'https://www.lincolnelectric.com/en/welding-and-cutting-resource-center/process-and-theory/mig-welding-stainless-steel' },
	{ label: 'Nickel Institute № 9002 — Welding of Stainless Steels and Other Joining Methods: GMAW, типы переноса, режимы короткой дуги', href: 'https://nickelinstitute.org/media/1854/weldingofstainlessssteelandotherjoiningmethods_9002_.pdf' },
	{ label: 'Nickel Institute № 14018 — Guidelines for Welding Dissimilar Metals: разбавление, присадка 309 для стали с нержавейкой', href: 'https://nickelinstitute.org/media/o3dnv2vx/14018_guidelinesforweldingdissimilarmetals.pdf' },
	{ label: 'ISO 14175:2008 «Сварочные материалы. Газы и газовые смеси для сварки плавлением и родственных процессов» (в России — ГОСТ Р ИСО 14175-2010)', href: 'https://www.iso.org/standard/39569.html' },
	{ label: 'ASSDA — Shielding gases for welding and their effects on stainless steel properties', href: 'https://www.assda.asn.au/blog/311-shielding-gases-for-welding-and-their-effects-on-stainless-steel-properties' },
	{ label: 'AWS A5.9/A5.9M — проволока и прутки из нержавеющей стали: ER308LSi, ER316LSi, ER347Si, ER309LSi' },
	{ label: 'ISO 14343 — сварочные материалы для нержавеющих и жаростойких сталей: G 19 9 L Si, G 19 12 3 L Si, G 19 9 Nb Si, G 23 12 L Si' },
	{ label: 'AWS A5.22 — порошковая проволока для нержавеющей стали: E308LT1-1, E308LT1-4, E308LT0-3' },
	{ label: 'ГОСТ 2246-70 «Проволока стальная сварочная. Технические условия»', href: 'https://vsegost.com/Catalog/17/17923.shtml' },
	{ label: 'ISO 4063 (ГОСТ Р ИСО 4063-2010) — номера процессов сварки: 131 MIG, 135 и 136 MAG' },
	{ label: 'BA-MIG 347Si — паспорт проволоки ER347Si (G 19 9 Nb Si): стали 1.4541 (321), газ M12, M13', href: 'https://www.subarcflux.com/en/products/mig-detail/ba-mig-347si-en.html' },
	{ label: 'Trafimet — MIG welding wire liners: каналы для проволоки из нержавеющей стали', href: 'https://www.trafimet.com/images/DOWNLOADS/Documents-manuals/Maintenance-manuals/MIG-LINERS_Features-Chart_0424.pdf' },
	{ label: 'Kobelco — межпроходная температура при сварке нержавеющей стали', href: 'https://www.kobelco-welding.jp/education-center/abc/ABC_2001-01.html' },
	{ label: 'ASSDA — Pickling and Passivation of Stainless Steel', href: 'https://www.assda.asn.au/blog/304-pickling-and-passivation-of-stainless-steel' },
];

const related = [
	{ label: 'Как варить нержавейку: электроды, проволока и режимы сварки', href: '/blog/kak-varit-nerzhaveyku/' },
	{ label: 'Как почистить нержавейку и убрать цвета побежалости', href: '/blog/kak-pochistit-nerzhaveyku/' },
	{ label: 'Межкристаллитная коррозия: зачем титан и марки L', href: '/blog/mezhkristallitnaya-korroziya/' },
	{ label: 'Травление и пассивация нержавейки после сварки', href: '/uslugi/travlenie-i-passivaciya/' },
	{ label: 'Проволока нержавеющая', href: '/provoloka-nerzhaveyushchaya/' },
];
---

<BlogArticle
	slug="svarka-nerzhaveyki-poluavtomatom"
	title="Сварка нержавейки полуавтоматом: газ и проволока"
	description="Сварка нержавейки полуавтоматом: какой газ нужен вместо углекислоты, проволока ER308LSi, ER316LSi, ER347Si под марку стали, режимы по толщине и техника."
	h1="Сварка нержавейки полуавтоматом: газ, проволока, режимы и техника"
	eyebrow="Справочник"
	datePublished="2026-09-29"
	dateModified="2026-09-29"
	readingMin={10}
	answer="<strong>Сварка нержавейки полуавтоматом возможна и оправдана на металле от 1 мм и на длинных швах: варят нержавеющей проволокой с индексом Si под марку стали — ER308LSi, ER347Si или ER316LSi — в смеси аргона с 2–3 % CO<sub>2</sub> или 1–2 % кислорода, постоянным током обратной полярности.</strong> Чистая углекислота для сплошной проволоки не подходит: она окисляет хром и науглероживает шов. Для листа тоньше 1 мм, корня ответственных стыков и видимых пищевых швов лучше аргонодуговая сварка (TIG)."
	keyFacts={[
		'Газ — Ar + 2–3 % CO<sub>2</sub> (M12) или Ar + 1–2 % O<sub>2</sub> (M13) по ISO 14175; для короткой дуги — He 90 % + Ar 7,5 % + CO<sub>2</sub> 2,5 %',
		'Проволока: AISI 304 — ER308LSi, 12Х18Н10Т (321) — ER347Si, 316L — ER316LSi, нержавейка с чёрной сталью — ER309LSi',
		'Лист 1–2 мм, проволока 0,9 мм: 55–110 А, 19–21 В, подача 3–7 м/мин, короткая дуга (Lincoln Electric)',
		'Ток постоянный, плюс на горелке; вылет 10–13 мм, горелка углом вперёд на 5–20°',
		'Межпроходная температура — не выше 150 °C; побежалость после сварки снимают травлением и пассивацией',
	]}
	coverAlt="Сварка нержавейки полуавтоматом: защитный газ, проволока и режимы"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Сварка нержавеющей стали', 'Полуавтоматическая сварка MIG/MAG', 'Защитные газы для сварки', 'Сварочная проволока']}
	cta={{ title: 'Нужен металл под сварку и обработка швов?', text: 'Поставляем лист, трубу и круг AISI 304, 321, 316L с сертификатом завода. Сварные швы травим и пассивируем в своём цехе — пришлите фото или чертёж изделия.' }}
>
	<section id="mozhno-li">
		<h2>Можно ли варить нержавейку полуавтоматом</h2>
		<p>
			Да. Полуавтоматическая сварка плавящейся проволокой в защитном газе (GMAW, в цехах — MIG/MAG) — штатный
			способ для аустенитных сталей AISI 304, 321, 316L и их российских аналогов. По ISO 4063 сварка сплошной
			проволокой в инертном газе — процесс 131 (MIG), в активной смеси — 135 (MAG). Смеси для нержавейки
			содержат 1–3 % кислорода или CO<sub>2</sub>, поэтому формально это MAG, но на практике оба названия
			употребляют как синонимы.
		</p>
		<p>
			Главный довод в пользу полуавтомата — скорость: по оценке Nickel Institute, GMAW примерно вчетверо
			производительнее аргонодуговой сварки неплавящимся электродом (TIG). Проволока подаётся непрерывно,
			сварщик не прерывается на смену электрода или подачу присадки. Ток — постоянный, обратной полярности
			(плюс на горелке): так, по данным Nickel Institute, выполняют более 95 % полуавтоматической сварки
			нержавейки.
		</p>
		<div class="ba-table">
			<table>
				<caption>Полуавтомат или TIG</caption>
				<thead>
					<tr><th>Задача</th><th>Полуавтомат (MIG/MAG)</th><th>Аргонодуговая (TIG)</th></tr>
				</thead>
				<tbody>
					<tr><td>Толщина</td><td>От 1 мм; тоньше — риск прожога</td><td>От десятых долей миллиметра</td></tr>
					<tr><td>Длинные швы, серия</td><td>Да: высокая производительность</td><td>Медленнее</td></tr>
					<tr><td>Корень ответственных стыков труб</td><td>Возможен короткой или импульсной дугой</td><td>Обычный выбор</td></tr>
					<tr><td>Видимые и пищевые швы</td><td>Брызги и налёт, нужна зачистка</td><td>Самый чистый шов</td></tr>
					<tr><td>Положение шва</td><td>Короткая и импульсная дуга — любое; струйный перенос — нижнее и горизонтальное</td><td>Любое</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Ручная дуговая сварка электродами и TIG разобраны в статье
			«<a href="/blog/kak-varit-nerzhaveyku/">Как варить нержавейку: электроды, проволока и режимы сварки</a>».
			Здесь — только полуавтомат.
		</p>
	</section>

	<section id="gaz">
		<h2>Защитный газ: почему не углекислота</h2>
		<p>
			Для полуавтомата по чёрной стали обычно берут чистый CO<sub>2</sub> или смесь аргона с 10–25 % CO<sub>2</sub>.
			Для нержавейки это не годится. В дуге углекислый газ распадается, свободный кислород соединяется с хромом,
			кремнием и марганцем, и они уходят в шлак, а углерод из газа переходит в шов. Lincoln Electric отмечает,
			что CO<sub>2</sub> в защитном газе снижает коррозионную стойкость многопроходных швов именно из-за
			науглероживания. К тому же в чистом CO<sub>2</sub> невозможен струйный перенос: металл переходит крупными
			каплями, с брызгами и обильным шлаком на поверхности шва.
		</p>
		<p>
			Малая добавка активного газа, наоборот, нужна: она стабилизирует дугу и помогает валику растечься. По данным
			ASSDA, при 2–5 % CO<sub>2</sub> науглероживание настолько мало, что шов L-марок остаётся в пределах
			0,03 % углерода. Кислород в смесях для нержавейки ограничивают 2 %, чтобы не выжигать легирующие элементы.
		</p>
		<div class="ba-table">
			<table>
				<caption>Защитные газы для полуавтоматической сварки нержавейки</caption>
				<thead>
					<tr><th>Смесь</th><th>Группа по ISO 14175</th><th>Перенос металла</th><th>Особенности</th></tr>
				</thead>
				<tbody>
					<tr><td>Ar + 2 % CO<sub>2</sub></td><td>M12</td><td>Короткая дуга, струйный, импульсный</td><td>Универсальная смесь; для импульсной сварки нержавейки CO<sub>2</sub> держат не выше 4 %</td></tr>
					<tr><td>Ar + 1–2 % O<sub>2</sub></td><td>M13</td><td>Струйный, импульсный, короткая дуга</td><td>Мелкокапельный перенос при меньшем токе; шов матово-серый</td></tr>
					<tr><td>He 90 % + Ar 7,5 % + CO<sub>2</sub> 2,5 %</td><td>M12</td><td>Короткая дуга</td><td>Самая популярная смесь для короткой дуги: плоский валик, хорошее сплавление, меньше брызг</td></tr>
					<tr><td>He 55 % + Ar 42,5 % + CO<sub>2</sub> 2,5 %</td><td>M12</td><td>Короткая дуга, импульсный, струйный</td><td>Меньше гелия — дуга холоднее, годится и для струйного переноса</td></tr>
					<tr><td>100 % CO<sub>2</sub></td><td>C1</td><td>Крупнокапельный, короткая дуга</td><td>Для сплошной нержавеющей проволоки не применяют</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Группа M12 по ISO 14175 — аргон с 0,5–5 % CO<sub>2</sub>, M13 — аргон с 0,5–3 % кислорода. Аргон в этих
			группах может быть частично или полностью заменён гелием, поэтому трёхкомпонентные гелиевые смеси тоже
			относятся к M12. В России классификация действует как ГОСТ Р ИСО 14175-2010. Производители проволоки
			ER308LSi и ER347Si указывают в паспортах именно M12 и M13.
		</p>
		<p>
			<strong>Расход газа.</strong> В руководстве Lincoln Electric для короткой дуги на тонком листе проволокой
			0,8 мм — 7–9,4 л/мин, для угловых швов проволокой 0,9–1,1 мм — 14 л/мин, для струйного и импульсного
			переноса — 12–19 л/мин. На сквозняке и при длинном вылете расход увеличивают, но избыточный поток
			подсасывает воздух и тоже даёт поры.
		</p>
	</section>

	<section id="provoloka">
		<h2>Проволока для сварки нержавейки полуавтоматом</h2>
		<p>
			Проволоку подбирают так, чтобы шов по составу соответствовал основному металлу или был чуть более
			легированным. Для полуавтомата выпускают варианты с повышенным кремнием — индекс Si в классе по
			AWS A5.9. В ER308LSi кремния 0,65–1,00 %, в обычной ER308L — 0,30–0,65 %, остальной состав одинаков.
			Кремний улучшает смачивание: по данным Nickel Institute и Lincoln Electric, такая проволока лучше
			растекается на короткой дуге, которая сама по себе даёт «холодный» выпуклый валик.
		</p>
		<div class="ba-table">
			<table>
				<caption>Проволока под марку стали: AWS A5.9, ISO 14343 и ГОСТ 2246-70</caption>
				<thead>
					<tr><th>Основной металл</th><th>AWS A5.9</th><th>ISO 14343-A</th><th>Ближайший аналог по ГОСТ 2246-70</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 304, 304L, 08Х18Н10</td><td>ER308LSi</td><td>G 19 9 L Si</td><td>Св-01Х19Н9, Св-04Х19Н9</td></tr>
					<tr><td>AISI 321, 12Х18Н10Т, 08Х18Н10Т</td><td>ER347Si</td><td>G 19 9 Nb Si</td><td>Св-07Х19Н10Б</td></tr>
					<tr><td>AISI 316, 316L, 10Х17Н13М2Т</td><td>ER316LSi</td><td>G 19 12 3 L Si</td><td>Св-04Х19Н11М3</td></tr>
					<tr><td>Нержавейка с углеродистой сталью, AISI 309S</td><td>ER309LSi</td><td>G 23 12 L Si</td><td>Св-07Х25Н13</td></tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>12Х18Н10Т и AISI 321</strong> варят проволокой с ниобием ER347Si, а не с титаном: титан частично выгорает в дуге, особенно в смесях с кислородом. Шов со стабилизирующим ниобием стоек к <a href="/blog/mezhkristallitnaya-korroziya/">межкристаллитной коррозии</a>. Паспорта ER347Si допускают и нестабилизированные 304 и 304L.</li>
			<li><strong>Российские марки</strong> по ГОСТ 2246-70 близки к зарубежным по хрому, никелю и молибдену, но индекса Si не имеют; в стандарте есть и отдельные марки с повышенным кремнием, например Св-04Х19Н9С2. Сравнение составов лучше делать по сертификату на конкретную проволоку.</li>
			<li><strong>Диаметр.</strong> Для листа 1–3 мм на короткой дуге — 0,8–0,9 мм, для 3–6 мм и струйного переноса — 1,0–1,2 мм, 1,6 мм — для толстого металла в нижнем положении.</li>
		</ul>
		<h3>Порошковая проволока и сварка «без газа»</h3>
		<p>
			Порошковая проволока для нержавейки классифицируется по AWS A5.22: например, E308LT1-1 рассчитана на
			чистый CO<sub>2</sub>, E308LT1-4 — на смесь аргона с 20–25 % CO<sub>2</sub>. Флюс в сердечнике защищает
			металл, поэтому для неё углекислота допустима. Такая проволока выгодна на толстом металле и при сварке
			в положениях, но оставляет шлак, который удаляют после каждого прохода.
		</p>
		<p>
			Самозащитная нержавеющая проволока, которой варят без газа, тоже существует — класс E308LT0-3. Она
			предназначена для нижнего и горизонтального положений и встречается в продаже редко. Обычная «безгазовая»
			проволока для чёрной стали нержавеющий шов не даст: наплавленный металл будет углеродистым и заржавеет.
		</p>
		<p>
			Сварочную проволоку из нержавейки можно подобрать в разделе
			<a href="/provoloka-nerzhaveyushchaya/">«Проволока нержавеющая»</a>.
		</p>
	</section>

	<section id="rezhimy">
		<h2>Режимы сварки нержавейки полуавтоматом</h2>
		<p>
			Режим определяется в первую очередь типом переноса металла. При короткой дуге проволока касается
			ванны и переносит металл при каждом замыкании, тепловложение минимально. При струйном переносе металл
			летит мелкими каплями без замыканий, ванна горячая и жидкая. Импульсная дуга даёт струйный перенос
			при меньшем среднем токе.
		</p>
		<div class="ba-table">
			<table>
				<caption>Типы переноса металла при сварке нержавейки</caption>
				<thead>
					<tr><th>Перенос</th><th>Ток и напряжение</th><th>Где применяют</th></tr>
				</thead>
				<tbody>
					<tr><td>Короткая дуга</td><td>50–225 А, 17–24 В, проволока 0,8–1,2 мм</td><td>Тонкий металл, любые положения, корень, большие зазоры</td></tr>
					<tr><td>Крупнокапельный</td><td>Между короткой дугой и струйным</td><td>Избегают: брызги, неровный шов</td></tr>
					<tr><td>Струйный</td><td>Выше тока перехода: для проволоки 0,9 мм — 140–150 А, 1,1–1,2 мм — 185–195 А, 1,6 мм — 250–260 А (Ar + 2 % O<sub>2</sub>); 22–30 В</td><td>Металл от 3 мм, нижнее и горизонтальное положение</td></tr>
					<tr><td>Импульсный</td><td>Средний ток ниже струйного, проволока 0,9–1,2 мм</td><td>Тонкий и средний металл, любые положения, меньше брызг</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Диапазоны короткой дуги — по Nickel Institute, токи перехода к струйному переносу — по Lincoln Electric.
			Минимальную толщину для струйного переноса Nickel Institute указывает около 3 мм, а Lincoln Electric
			применяет его в основном на металле от 6 мм.
		</p>
		<div class="ba-table">
			<table>
				<caption>Ориентировочные режимы: угловые швы, короткая дуга, He 90 % + Ar 7,5 % + CO<sub>2</sub> 2,5 %, вылет 13 мм</caption>
				<thead>
					<tr><th class="num">Толщина, мм</th><th class="num">Проволока, мм</th><th class="num">Ток, А</th><th class="num">Напряжение, В</th><th class="num">Подача, м/мин</th><th class="num">Газ, л/мин</th></tr>
