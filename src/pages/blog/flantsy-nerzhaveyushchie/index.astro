	{ label: 'Детали трубопровода и ограждения: прайс', href: '/detali-truboprovoda/' },
	{ label: 'Стальные детали трубопровода: фланцы, отводы, тройники (по запросу)', href: '/truboprovodnye-detali/' },
	{ label: 'Калькулятор веса фланца', href: '/kalkulyator-flantsa/' },
	{ label: 'ГОСТ 33259-2015: справочная карточка', href: '/gost/33259-2015/' },
