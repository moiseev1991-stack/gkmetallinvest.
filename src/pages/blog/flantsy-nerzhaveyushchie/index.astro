---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'tipy', anchor: 'Типы и стандарты', summary: 'Тип 01 и 11, ГОСТ 33259-2015 вместо 12820 и 12821, что действует' },
	{ id: 'davlenie', anchor: 'Давление и температура', summary: 'PN и DN, пределы плоских фланцев, когда нужен воротниковый' },
	{ id: 'uplotnenie', anchor: 'Уплотнение и крепёж', summary: 'Исполнения A–M, прежние номера 1–9, прокладки, болты и шпильки' },
	{ id: 'marka', anchor: 'Марка стали', summary: '12Х18Н10Т, 08Х18Н10, 316L: что названо в стандарте и как писать в заказе' },
