---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../../data/site';

const title = 'Плотность нержавеющей стали — таблица по маркам и расчёт веса';
const description = 'Плотность нержавеющей стали 7,7–8,0 г/см³: аустенит (304, 316L, 12Х18Н10Т) — 7,9–8,0, феррит и мартенсит (430, 20Х13, 40Х13) — 7,7. Таблица по маркам и формула расчёта веса проката.';

const cover = '/img/blog/plotnost-nerzhaveyushchey-stali.svg';
const datePublished = '2026-07-17';
const dateModified = '2026-07-17';
const url = `${siteUrl.replace(/\/$/, '')}/blog/plotnost-nerzhaveyushchey-stali/`;

const sections = [
	{
		id: 'znachenie',
		anchor: 'Сколько г/см³',
		title: 'Плотность нержавейки: базовое значение',
		summary: '7,9 г/см³ — для расчётов по умолчанию.',
	},
	{
		id: 'tablica',
		anchor: 'Таблица по маркам',
		title: 'Плотность по маркам и классам',
		summary: 'Аустенит, феррит, мартенсит, дуплекс.',
	},
	{
		id: 'raschet',
		anchor: 'Расчёт веса',
		title: 'Как посчитать вес проката',
		summary: 'Формула «объём × плотность» с примерами.',
	},
	{
		id: 'pochemu',
		anchor: 'Почему различается',
		title: 'Почему плотность зависит от марки',
		summary: 'Никель, молибден и тип решётки.',
	},
];

const rows = [
	{ mark: '08Х18Н10 (AISI 304)', klass: 'Аустенит', rho: '7,90', note: 'Базовая марка для расчётов' },
	{ mark: '12Х18Н10Т (AISI 321)', klass: 'Аустенит', rho: '7,90', note: 'Стабилизирована титаном' },
	{ mark: '10Х17Н13М2 (AISI 316)', klass: 'Аустенит', rho: '8,00', note: 'С молибденом, чуть тяжелее' },
	{ mark: '03Х17Н14М2 (AISI 316L)', klass: 'Аустенит', rho: '8,00', note: 'Низкоуглеродистая, с Mo' },
	{ mark: '12Х15Г9НД (AISI 201)', klass: 'Аустенит', rho: '7,80', note: 'Марганцевая, экономичная' },
	{ mark: '12Х17 (AISI 430)', klass: 'Феррит', rho: '7,70', note: 'Без никеля, легче аустенита' },
	{ mark: '20Х13 (AISI 420)', klass: 'Мартенсит', rho: '7,76', note: 'Ножевая, закаливаемая' },
	{ mark: '30Х13', klass: 'Мартенсит', rho: '7,70', note: 'Больше углерода' },
	{ mark: '40Х13', klass: 'Мартенсит', rho: '7,68', note: 'Максимальная твёрдость' },
	{ mark: '03Х22Н5АМ2 (2205)', klass: 'Дуплекс', rho: '7,80', note: 'Аустенитно-ферритная' },
];

const faq = [
	{
		q: 'Какая плотность у нержавеющей стали?',
		a: 'Плотность нержавеющей стали находится в диапазоне 7,7–8,0 г/см³ (7700–8000 кг/м³) в зависимости от марки. Для аустенитных сталей (304, 316L, 12Х18Н10Т) берут 7,9–8,0 г/см³, для ферритных и мартенситных (430, 20Х13, 40Х13) — около 7,7 г/см³. Если марка неизвестна, для инженерных расчётов веса проката используют усреднённое значение 7,9 г/см³.',
	},
	{
		q: 'Какая плотность у стали 12Х18Н10Т?',
		a: 'Плотность стали 12Х18Н10Т (AISI 321) составляет 7,90 г/см³, то есть 7900 кг/м³. Это стандартное значение для аустенитных хромоникелевых сталей 18/10. Его подставляют в формулу расчёта веса листа, круга и трубы из этой марки. У близкой 08Х18Н10 (AISI 304) плотность такая же — 7,90 г/см³.',
	},
	{
		q: 'Почему у 316 плотность выше, чем у 304?',
		a: 'Сталь AISI 316 (10Х17Н13М2) содержит 2–3 % молибдена и больше никеля, чем 304. Молибден и никель — более тяжёлые элементы, поэтому плотность растёт с 7,90 до примерно 8,00 г/см³. Разница небольшая (около 1 %), но при расчёте веса крупных партий её учитывают: тонна листа 316L займёт чуть меньший объём, чем тонна 304.',
	},
	{
		q: 'Как рассчитать вес нержавеющего листа?',
		a: 'Вес листа = длина × ширина × толщина × плотность. Например, лист 1000 × 2000 мм толщиной 2 мм из стали 304: объём = 1,0 × 2,0 × 0,002 = 0,004 м³, вес = 0,004 × 7900 = 31,6 кг. Для круга площадь сечения π·r², для трубы — разница площадей наружного и внутреннего кругов. Быстрее считать в онлайн-калькуляторе веса металлопроката.',
	},
	{
		q: 'Плотность нержавейки больше или меньше, чем у обычной стали?',
		a: 'Плотность аустенитной нержавейки (7,9–8,0 г/см³) немного выше, чем у обычной углеродистой стали (7,85 г/см³), из-за легирования никелем и хромом. Ферритные и мартенситные нержавеющие стали (7,7 г/см³), наоборот, чуть легче углеродистой. Разница в пределах 1–2 %, поэтому на глаз изделия неотличимы по весу.',
	},
];

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: `${siteUrl.replace(/\/$/, '')}${cover}`,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	datePublished,
	dateModified,
	author: { '@type': 'Organization', name: siteName, url: siteUrl },
	publisher: {
		'@type': 'Organization',
		name: siteName,
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl.replace(/\/$/, '')}/favicon.svg` },
	},
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
	})),
};
---

<BaseLayout title={title} description={description} image={cover} type="article" jsonLd={[articleJsonLd, faqJsonLd]}>
	<div class="container post">
		<Breadcrumbs items={[
			{ label: 'Главная', href: '/' },
			{ label: 'Блог', href: '/blog/' },
			{ label: 'Плотность нержавеющей стали' },
		]} />

		<header class="post__hero">
			<span class="post__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M4 2v6a4 4 0 0 0 8 0V2M4 2h2v3H4M10 2h2v3h-2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
				</svg>
				Статья · справочные данные
			</span>
			<h1 class="post__h1">Плотность нержавеющей стали: таблица по маркам и расчёт веса</h1>
			<div class="post__meta">
				<time datetime={datePublished}>17 июля 2026</time>
				<span>·</span>
				<span>чтение 5 минут</span>
			</div>
			<p class="post__lead">
				<strong>Прямой ответ:</strong> плотность нержавеющей стали — 7,7–8,0 г/см³.
				Для аустенитных марок (304, 316L, 12Х18Н10Т) берут 7,9–8,0 г/см³, для ферритных
				и мартенситных (430, 20Х13, 40Х13) — около 7,7 г/см³. Если марка неизвестна,
				для расчёта веса проката используют 7,9 г/см³ (7900 кг/м³).
			</p>
		</header>

		<figure class="post__cover">
			<img
				src={cover}
				alt="Плотность нержавеющей стали — 7,9 г/см³, таблица по маркам и расчёт веса"
				width="1200"
				height="630"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<nav class="post__toc" aria-label="Содержание">
			<div class="post__toc-title">На странице</div>
			<ul>
				{sections.map((s) => (
					<li>
						<a href={`#${s.id}`}>
							<strong>{s.anchor}</strong>
							<span>{s.summary}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<article class="post__body">
			<section class="post__section" id="znachenie">
				<h2>Плотность нержавейки: базовое значение</h2>
				<p>
					Плотность (ρ) показывает массу единицы объёма материала. Для нержавеющей стали
					она составляет <strong>7,7–8,0 г/см³</strong>, или 7700–8000 кг/м³. Разброс
					небольшой, но он важен при расчёте веса больших партий проката и при заказе
					по массе.
				</p>
				<p>
					Когда марка точно не известна, в инженерных расчётах по умолчанию принимают
					<strong> 7,9 г/см³</strong> — это среднее для самых ходовых аустенитных сталей
					типа AISI 304 и 12Х18Н10Т. Ошибка при этом не превышает 1–2 % даже для крайних
					марок, что для складского учёта и предварительных смет вполне достаточно.
				</p>
			</section>

			<section class="post__section" id="tablica">
				<h2>Плотность по маркам и классам</h2>
				<p>
					Плотность зависит от класса стали и легирующих элементов. Аустенитные марки
					с никелем и молибденом — самые тяжёлые, ферритные и мартенситные без никеля —
					легче. В таблице собраны ходовые марки нержавеющего проката.
				</p>
				<div class="post__table-wrap">
					<table class="post__table">
						<thead>
							<tr>
								<th scope="col">Марка</th>
								<th scope="col">Класс</th>
								<th scope="col">ρ, г/см³</th>
								<th scope="col">Комментарий</th>
							</tr>
						</thead>
						<tbody>
							{rows.map((r) => (
								<tr>
									<th scope="row">{r.mark}</th>
									<td>{r.klass}</td>
									<td>{r.rho}</td>
									<td>{r.note}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p>
					Значения соответствуют справочным данным ГОСТ 5632-2014 и марочникам сталей.
					Карточки марок с сортаментом и прайсом: <a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a>,
					<a href="/list-nerzhaveyushchiy/aisi-316l/"> AISI 316L</a>, <a href="/list-nerzhaveyushchiy/aisi-321/">AISI 321</a>,
					<a href="/list-nerzhaveyushchiy/aisi-430/"> AISI 430</a>.
				</p>
			</section>

			<section class="post__section" id="raschet">
				<h2>Как посчитать вес проката</h2>
				<p>
					Вес любого изделия считается по формуле <strong>масса = объём × плотность</strong>.
					Плотность берут из таблицы выше, объём — по геометрии проката. Все размеры
					переводят в метры, плотность — в кг/м³ (для 304 это 7900).
				</p>
				<ul>
					<li>
						<strong>Лист:</strong> длина × ширина × толщина × ρ. Лист 1000 × 2000 мм,
						толщина 2 мм, сталь 304: 1,0 × 2,0 × 0,002 × 7900 = <strong>31,6 кг</strong>.
					</li>
					<li>
						<strong>Круг:</strong> π × r² × длина × ρ. Круг Ø20 мм (r = 0,01 м), длина 6 м,
						сталь 304: 3,14159 × 0,0001 × 6 × 7900 ≈ <strong>14,9 кг</strong>.
					</li>
					<li>
						<strong>Труба:</strong> π × (R² − r²) × длина × ρ, где R и r — наружный
						и внутренний радиусы. Разница площадей даёт площадь стенки.
					</li>
				</ul>
				<p>
					Чтобы не считать вручную, воспользуйтесь
					<a href="/kalkulyator-vesa/"> калькулятором веса металлопроката</a> — он учитывает
					марку, тип проката и размеры и сразу выдаёт массу. Есть и профильные калькуляторы:
					<a href="/kalkulyator-rulona/"> рулона</a>,
					<a href="/kalkulyator-riflenogo-lista/"> рифлёного листа</a>,
					<a href="/kalkulyator-ovalnoy-truby/"> овальной трубы</a>.
				</p>
			</section>

			<section class="post__section" id="pochemu">
				<h2>Почему плотность зависит от марки</h2>
				<p>
					Разница в плотности объясняется составом и типом кристаллической решётки:
				</p>
				<ul>
					<li>
						<strong>Никель и молибден утяжеляют.</strong> Аустенитные стали содержат
						8–14 % никеля, а марки 316/316L — ещё и 2–3 % молибдена. Эти элементы плотнее
						железа, поэтому 316L (8,0 г/см³) тяжелее 304 (7,9 г/см³).
					</li>
					<li>
						<strong>Тип решётки.</strong> Аустенит имеет гранецентрированную кубическую
						решётку с более плотной упаковкой атомов, феррит и мартенсит —
						объёмноцентрированную. Поэтому ферритные 430 и мартенситные 40Х13 легче
						(≈ 7,7 г/см³) при почти том же содержании железа.
					</li>
					<li>
						<strong>Углерод и хром.</strong> Влияют слабо: хром близок к железу по массе,
						а углерода в нержавейке доли процента. Основной вклад дают именно никель
						и молибден.
					</li>
				</ul>
				<p>
					Классы сталей и их отличия подробно разобраны в статье
					<a href="/blog/vidy-nerzhaveyushchey-stali/"> виды нержавеющей стали</a>, а выбор
					между ходовыми марками — в сравнении
					<a href="/blog/aisi-304-vs-316l-vs-321/"> AISI 304, 316L и 321</a>.
				</p>
			</section>

			<section class="post__faq">
				<h2>Частые вопросы</h2>
				<div class="post__faq-list">
					{faq.map((f) => (
						<details class="post__faq-item">
							<summary class="post__faq-q">
								<span>{f.q}</span>
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
									<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</summary>
							<p set:html={f.a} />
						</details>
					))}
				</div>
			</section>

			<aside class="post__related">
				<h2>Смежные страницы</h2>
				<ul>
					<li><a href="/kalkulyator-vesa/">Калькулятор веса металлопроката</a></li>
					<li><a href="/blog/temperatura-plavleniya-nerzhaveyki/">Температура плавления нержавейки</a></li>
					<li><a href="/blog/analogi-marok-nerzhaveyki/">Аналоги марок: AISI, ГОСТ, EN</a></li>
					<li><a href="/blog/vidy-nerzhaveyushchey-stali/">Виды нержавеющей стали</a></li>
					<li><a href="/list-nerzhaveyushchiy/aisi-304/">Лист AISI 304 (08Х18Н10)</a></li>
					<li><a href="/gost/">Справочник ГОСТов на нержавеющий металлопрокат</a></li>
				</ul>
			</aside>
		</article>
	</div>

	<CtaSection
		title="Нужен расчёт веса под конкретную партию?"
		text="Пришлите марку, тип проката и размеры — менеджер посчитает вес и массу партии, проверит наличие на складе и пришлёт КП с ценой за тонну."
	/>
</BaseLayout>

<style>
	.post { padding-block: var(--space-8); min-width: 0; }

	.post__hero { margin-bottom: var(--space-6); max-width: 75ch; }
	.post__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		margin-bottom: var(--space-3);
	}
	.post__h1 {
		font-size: clamp(1.7rem, 3.5vw, 2.4rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-2);
	}
	.post__meta {
		display: flex;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		margin-bottom: var(--space-4);
	}
	.post__lead {
		font-size: 1.08rem;
		line-height: 1.6;
		max-width: 70ch;
		color: var(--color-text);
		margin: 0;
	}
	.post__lead strong { color: var(--color-primary); }

	.post__cover {
		margin: 0 0 var(--space-8);
		max-width: 80ch;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
	}
	.post__cover img {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 1200 / 630;
	}

	.post__toc {
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-4) var(--space-5);
		margin-bottom: var(--space-8);
		max-width: 80ch;
	}
	.post__toc-title {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		margin-bottom: var(--space-3);
	}
	.post__toc ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-2);
	}
	.post__toc a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.7rem 0.9rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: var(--color-text);
		transition: all var(--dur-fast) var(--ease-out);
	}
	.post__toc a:hover {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		text-decoration: none;
		transform: translateY(-1px);
	}
	.post__toc a strong {
		font-size: 0.9rem;
		color: var(--color-primary-600);
		font-weight: 600;
	}
	.post__toc a span {
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.35;
	}

	.post__body {
		max-width: 75ch;
		display: grid;
		gap: var(--space-7);
	}
	.post__section {
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}
	.post__section h2 {
		font-size: 1.35rem;
		line-height: 1.3;
		margin: 0 0 var(--space-3);
		letter-spacing: -0.01em;
	}
	.post__section p,
	.post__section ul,
	.post__section ol {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-text);
		margin: 0 0 var(--space-3);
	}
	.post__section ul,
	.post__section ol {
		padding-left: 1.3rem;
	}
	.post__section li {
		margin-bottom: 0.4rem;
