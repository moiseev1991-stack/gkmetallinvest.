const faq = [
	{
		q: 'Какой ГОСТ на нержавеющий круг?',
		a: 'Технические требования и марки — ГОСТ 5949-2018 (действует с 1 февраля 2019 года вместо ГОСТ 5949-75), состав — ГОСТ 5632-2014. Размеры и допуски берут из сортаментов: горячекатаный круг — ГОСТ 2590-2006 (Ø 5–270 мм), калиброванный — ГОСТ 7417-75 (Ø 3–100 мм, квалитеты h9–h12), кованый — ГОСТ 1133-71 (40–200 мм), со специальной отделкой поверхности — ГОСТ 14955-77 (Ø 0,2–50 мм). ГОСТ 2590-88 заменён ГОСТ 2590-2006.',
