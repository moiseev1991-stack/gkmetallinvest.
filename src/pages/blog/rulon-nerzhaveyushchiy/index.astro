---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'chto-takoe', anchor: 'Что такое рулон', summary: 'Чем отличается от листа и ленты, зачем его берут' },
	{ id: 'standarty', anchor: 'ГОСТ на рулон', summary: '19904-90, 19903, 5582-75, 7350-77: что охватывают, допуски' },
	{ id: 'razmery', anchor: 'Ширины и толщины', summary: 'Диаметр, масса рулона по ГОСТ; что в каталоге' },
	{ id: 'ves', anchor: 'Вес рулона и метра', summary: 'Масса 1 пог. м, длина в тонне, расчёт по диаметру' },
	{ id: 'marki', anchor: 'Марки и поверхности', summary: 'AISI 304, 430, 201, 316L, 321; 2B, BA, 4N, No1' },
	{ id: 'rezka', anchor: 'Резка и переработка', summary: 'Продольная, поперечная, лазер, гидроабразив' },
	{ id: 'zakaz', anchor: 'Как заказать и проверить', summary: 'Заявка, сертификат 3.1, приёмка, хранение' },
];

const faq = [
	{
		q: 'Чем рулон нержавейки отличается от листа?',
		a: 'Формой поставки и длиной. Лист — плоский прокат фиксированной длины (например, 1250×2500 мм), рулон — длинная полоса, смотанная на шпулю. Ширина у обоих одна и та же, например 1000, 1250 или 1500 мм. В рулоне нет ограничения длины листа, а масса рулона по ГОСТ 19904-90 — от 1,5 до 20 т. Рулон берут, когда заготовки режут в большом количестве, штампуют или режут на ленты. Лист удобнее, когда нужны единицы штук стандартного формата. Подробнее о листе — в статье о листе нержавеющем 1, 2 и 3 мм.',
	},
	{
		q: 'Какая ширина у рулона нержавеющей стали?',
		a: 'ГОСТ 19904-90 даёт ряд ширин от 500 до 2350 мм (500, 550, 600 … 1000, 1100, 1200, 1250, 1400, 1450, 1500 … 2350 мм). В каталоге рулонной нержавейки основные ширины — 1000, 1250 и 1500 мм; отдельные позиции шириной 1219 и 1240 мм, есть и узкая позиция шириной 90 мм. Узкие полосы до 410 мм по ГОСТ 4986-79 — это уже лента. Другую ширину режем из рулона продольной резкой.',
	},
	{
		q: 'Сколько весит рулон нержавейки?',
		a: 'Зависит от толщины, ширины и намотанной длины. Масса 1 погонного метра рулона AISI 304 — ширина в метрах × толщина в миллиметрах × 7,9 кг. Для рулона 1250 мм × 0,8 мм это 7,9 кг на метр, то есть в 1 т около 127 м. Массу рулона по размерам намотки считают по формуле m = π·(D² − d²)·B·ρ / 4: для рулона наружным диаметром 1000 мм на шпуле 508 мм и шириной 1250 мм получается около 5,75 т. Точную массу берите из сертификата или по весам.',
	},
	{
		q: 'Какой ГОСТ на нержавеющий рулон?',
		a: 'Размеры холоднокатаного рулона — ГОСТ 19904-90: ширина от 500 мм, толщина 0,35–3,50 мм, внутренний диаметр рулона 500–1000 мм, масса 1,5–20 т. Размеры горячекатаного рулона — ГОСТ 19903: рулоны от 1,2 мм. Марка и химический состав — по ГОСТ 5632-2014. ГОСТ 5582-75 и ГОСТ 7350-77 по тексту распространяются на прокат в листах: рулоны в их области применения не названы. Поэтому в заказе на рулон указывайте сортамент (19904-90 или 19903), марку и стандарт, по которому она заявлена в сертификате.',
	},
	{
		q: 'Можно ли купить рулон и нарезать на ленты?',
		a: 'Да, это наша услуга. По данным страницы услуги, продольная резка работает с толщиной до 4 мм, ширину полос задают с шагом 5 мм, минимальная партия — 500 кг по массе рулона. Режем и рулон заказчика (давальческий материал). На партию выдаём сертификат завода на исходный рулон с номером плавки. Для рулона толще 4 мм услуги нет. Если в проекте стоит ГОСТ 4986-79, уточните, допускает ли заказчик полосу, нарезанную из рулона, или нужна заводская лента.',
	},
	{
		q: 'Какая поверхность у рулона — 2B или BA?',
		a: 'Бывают обе. 2B — матовая холоднокатаная поверхность, самая массовая: в каталоге рулонной нержавейки это 36 из 77 позиций. BA — блестящая после отжига в защитной атмосфере, 10 позиций; чаще идёт с плёнкой. Есть также 4N (шлифованная, 20 позиций), No1 у горячекатаного (6 позиций) и декоративные DECO. Для скрытых деталей и штамповки берут 2B, для видимых изделий — BA или 4N. Подробнее — в статье о поверхностях нержавеющего листа.',
	},
	{
		q: 'Что такое нержавеющая сетка в рулоне?',
		a: 'Это другой товар: сетка из нержавеющей проволоки, которую продают рулонами по длине и ширине полотна, а не по толщине листа. В нашем каталоге рулонной нержавейки её нет. Массу сетки считают в калькуляторе сетки.',
	},
];

const sources = [
	{ label: 'ГОСТ 19904-90 «Прокат листовой холоднокатаный. Сортамент» — область применения (листы 0,35–5,00 мм, рулоны 0,35–3,50 мм, ширина от 500 мм), табл. 1 и 2, пп. 6, 13, 15, 16, 18', href: 'https://files.stroyinf.ru/Data1/4/4045/index.htm' },
	{ label: 'ГОСТ 19903-74 «Прокат листовой горячекатаный. Сортамент» — область применения: листы 0,40–160 мм, рулоны 1,2–12 мм', href: 'https://meganorm.ru/Data2/1/4294852/4294852655.htm' },
	{ label: 'ГОСТ 19903-2015 «Прокат листовой горячекатаный. Сортамент» (заменил ГОСТ 19903-74): рулоны 1,2–25 мм', href: 'http://docs.cntd.ru/document/1200133726' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, жаростойкий и жаропрочный: область применения («в листах»), п. 2.1, замечание о рулонной кривизне', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная: область применения («в листах»), п. 2.1', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'ГОСТ 4986-79 «Лента холоднокатаная из коррозионно-стойкой и жаростойкой стали. Технические условия»', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846401.htm' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки»', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 7566-2018 «Металлопродукция. Правила приемки, маркировка, упаковка, транспортирование и хранение» — приложение Б (документы о качестве 2.2, 3.1, 3.2)', href: 'https://meganorm.ru/Data2/1/4293735/4293735060.pdf' },
	{ label: 'BS EN 10088-2:2014 — технические условия поставки горячекатаного и холоднокатаного листа, плиты и ленты из нержавеющих сталей общего назначения (описание стандарта)', href: 'https://webstore.ansi.org/standards/bsi/bsen100882014-1523002' },
	{ label: 'ISSF — Surface finishes (учебный модуль): отделки 2B, BA, шлифованные и полированные поверхности', href: 'https://www.imoa.info/download_files/stainless-steel/issf/educational/Module_08_Surface_Finishes_en.pdf' },
	{ label: 'BSSA — Specifying finishes for stainless steel flat products', href: 'https://bssa.org.uk/bssa_articles/specifying-finishes-for-stainless-steel-flat-products-sheet-and-plate/' },
	{ label: 'EN 10204 — виды документов о контроле продукции (2.1, 2.2, 3.1, 3.2)' },
	{ label: 'SSINA — Care and use in shop: хранение и обращение с нержавеющей сталью, разделение с углеродистой сталью' },
];

const related = [
	{ label: 'Лист нержавеющий 1, 2 и 3 мм: размеры, вес, марки', href: '/blog/list-nerzhaveyushchiy-1-2-3-mm/' },
	{ label: 'Лента нержавеющая: марки и ГОСТ 4986-79', href: '/blog/lenta-nerzhaveyushchaya-marki-i-gost-4986-79/' },
	{ label: 'Поверхности нержавеющего листа: 2B, BA, 4N, 8K', href: '/blog/poverhnosti-nerzhaveyushchego-lista/' },
	{ label: 'AISI 304, 316L и 321: чем отличаются и что выбрать', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'Продольная и поперечная резка рулонов', href: '/uslugi/rezka-rulonov/' },
	{ label: 'Калькулятор веса рулона нержавейки', href: '/kalkulyator-rulona/' },
	{ label: 'Рулон нержавеющий: каталог и цены', href: '/rulon-nerzhaveyushchiy/' },
];
---

<BlogArticle
	slug="rulon-nerzhaveyushchiy"
	title="Рулон нержавеющий: размеры, ГОСТ, вес и резка"
	description="Рулон нержавеющий: ширина 1000–1500 мм, толщина 0,4–6 мм, ГОСТ 19904-90, масса 1 пог. м и рулона, марки 304 и 430, поверхности 2B, BA, 4N, резка на ленты."
	h1="Рулон нержавеющий: ширины, толщины, ГОСТ, вес и резка"
	eyebrow="Справочник"
	datePublished="2026-10-06"
	dateModified="2026-10-06"
	readingMin={9}
	answer="<strong>Рулон нержавеющий — холоднокатаный или горячекатаный прокат шириной от 500 мм, смотанный на шпулю; чаще всего это ширины 1000, 1250 и 1500 мм.</strong> По ГОСТ 19904-90 холоднокатаный рулон имеет толщину 0,35–3,50 мм, внутренний диаметр 500–1000 мм и массу 1,5–20 т. Масса 1 погонного метра рулона AISI 304 — ширина в метрах × толщина в миллиметрах × 7,9 кг: для 1250×0,8 мм это 7,9 кг. Рулон берут для штамповки, массового раскроя и продольной резки на ленты; ГОСТ 5582-75 и 7350-77 по тексту охватывают только прокат в листах."
	keyFacts={[
		'ГОСТ 19904-90: холоднокатаный прокат шириной от 500 мм; рулоны толщиной 0,35–3,50 мм, внутренний диаметр рулона 500–1000 мм, масса 1,5–20 т',
		'Горячекатаные рулоны — ГОСТ 19903: толщина от 1,2 мм (до 12 мм в ГОСТ 19903-74 и до 25 мм в ГОСТ 19903-2015)',
		'ГОСТ 5582-75 и ГОСТ 7350-77 по тексту распространяются на прокат в листах: рулоны в области применения не названы',
		'Масса 1 пог. м рулона AISI 304 = ширина (м) × толщина (мм) × 7,9 кг: 1250×0,8 мм — 7,9 кг, в 1 т ≈ 127 м',
		'Каталог: 77 позиций, толщина 0,4–6 мм, ширины 1000, 1250 и 1500 мм; цена в рублях за тонну',
		'Резка рулона у нас: продольная до 4 мм с шагом ширины 5 мм, поперечная 0,4–4 мм, партия от 500 кг',
	]}
	coverAlt="Рулон нержавеющий: ширины, толщины, ГОСТ, вес и резка"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Рулон нержавеющий', 'Нержавеющая сталь в рулонах', 'Вес рулона нержавейки', 'ГОСТ 19904-90', 'Продольная резка рулонов']}
	cta={{ title: 'Нужен рулон нержавеющий или резка на ленты?', text: 'Поставляем нержавеющий рулон и режем продольно на ленты. Пришлите марку, толщину, ширину и объём — посчитаем.' }}
>
	<section id="chto-takoe">
		<h2>Что такое рулон нержавеющей стали и чем он отличается от листа и ленты</h2>
		<p>
			Рулон — это прокат, смотанный на шпулю. Нержавеющий рулон бывает холоднокатаным (толщина от десятых долей
			миллиметра, чистая поверхность 2B, BA, 4N) и горячекатаным (от 1,2 мм, поверхность No1). Запросы
			«лист нержавеющий рулон» и «рулон нержавеющей стали» описывают один и тот же товар: широкий прокат,
			из которого потом получают листы, ленты и детали. Рулон характеризуют шириной, толщиной, внутренним
			диаметром, массой и упаковкой.
		</p>
		<div class="ba-table">
			<table>
				<caption>Рулон, лист и лента: границы</caption>
				<thead>
					<tr><th>Параметр</th><th>Рулон</th><th>Лист</th><th>Лента</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>Форма</td>
						<td>Длинная полоса на шпуле</td>
						<td>Плоский прокат, длина задана</td>
						<td>Узкая полоса в рулонах</td>
					</tr>
					<tr>
						<td>Ширина</td>
						<td>От 500 мм (ГОСТ 19904-90)</td>
						<td>От 500 мм (ГОСТ 19904-90)</td>
						<td>6–410 мм (ГОСТ 4986-79)</td>
					</tr>
					<tr>
						<td>Толщина холоднокатаного проката</td>
						<td>0,35–3,50 мм (ГОСТ 19904-90)</td>
						<td>0,35–5,00 мм (ГОСТ 19904-90)</td>
						<td>0,05–2,0 мм (ГОСТ 4986-79)</td>
					</tr>
					<tr>
						<td>Где смотреть</td>
						<td>Эта статья</td>
						<td><a href="/blog/list-nerzhaveyushchiy-1-2-3-mm/">Лист 1, 2, 3 мм</a></td>
						<td><a href="/blog/lenta-nerzhaveyushchaya-marki-i-gost-4986-79/">Лента и ГОСТ 4986-79</a></td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Между 410 и 500 мм ни один из двух стандартов ширину не задаёт: такие полосы режут из рулона на заказ.
		</p>
		<h3>Зачем берут рулон</h3>
		<ul>
			<li><strong>Раскрой в большом количестве.</strong> Одна и та же заготовка штампуется из рулона без остановок на смену листа.</li>
			<li><strong>Нестандартная длина.</strong> Лист режут в любую длину, а не только в стандартные 2000, 2500 и 3000 мм.</li>
			<li><strong>Продольная резка.</strong> Из широкого рулона получают ленты и полосы нужной ширины.</li>
			<li><strong>Покупка на тонны.</strong> В каталоге цена указана в рублях за тонну; на больших партиях это удобнее, чем считать листы.</li>
		</ul>
		<p>
			Если нужно несколько листов стандартного формата, проще взять готовый лист:
			<a href="/list-nerzhaveyushchiy/">лист нержавеющий</a>.
		</p>
	</section>

	<section id="standarty">
		<h2>ГОСТ на нержавеющий рулон: что охватывает каждый стандарт</h2>
		<p>
			Запрос «рулон нержавеющий ГОСТ» чаще всего ведёт к ГОСТ 5582-75 и 19904-90. Они делят задачи так:
			сортамент задаёт один стандарт, технические требования и марки — другие. Для рулона это важно:
			не каждый стандарт на нержавеющий прокат охватывает рулоны.
		</p>
		<div class="ba-table">
			<table>
				<caption>Стандарты на нержавеющий прокат и рулоны</caption>
				<thead>
					<tr><th>Стандарт</th><th>Что задаёт</th><th>Рулоны</th></tr>
				</thead>
				<tbody>
					<tr>
						<td><a href="/gost/19904-90/">ГОСТ 19904-90</a></td>
						<td>Сортамент холоднокатаного проката шириной от 500 мм: размеры, допуски</td>
						<td>Да: толщина 0,35–3,50 мм; внутренний диаметр 500–1000 мм; масса 1,5–20 т</td>
					</tr>
					<tr>
						<td><a href="/gost/19903-2015/">ГОСТ 19903-2015</a> (ранее <a href="/gost/19903-74/">19903-74</a>)</td>
						<td>Сортамент горячекатаного проката шириной от 500 мм</td>
						<td>Да: толщина от 1,2 мм (до 12 мм по 19903-74, до 25 мм по 19903-2015)</td>
					</tr>
					<tr>
						<td><a href="/gost/5582-75/">ГОСТ 5582-75</a></td>
						<td>Технические условия на тонколистовой прокат: х/к 0,5–3,9 мм, г/к 1,5–3,9 мм</td>
						<td>В области применения — «в листах»; о рулонах есть только замечание о рулонной кривизне</td>
					</tr>
					<tr>
						<td><a href="/gost/7350-77/">ГОСТ 7350-77</a></td>
						<td>Технические условия на толстолистовой прокат: г/к 4–50 мм, х/к 4–5 мм</td>
						<td>В области применения — «в листах»; слова «рулон» в стандарте нет</td>
					</tr>
					<tr>
						<td><a href="/gost/4986-79/">ГОСТ 4986-79</a></td>
						<td>Холоднокатаная лента: 0,05–2,0 мм, ширина 6–410 мм</td>
						<td>Да, лента в рулонах, но узкая</td>
					</tr>
					<tr>
						<td><a href="/gost/5632-2014/">ГОСТ 5632-2014</a></td>
						<td>Марки и химический состав нержавеющих сталей</td>
						<td>Не зависит от формы проката</td>
					</tr>
					<tr>
						<td>EN 10088-2</td>
						<td>Технические условия на горячекатаный и холоднокатаный лист, плиту и ленту общего назначения</td>
						<td>Европейский стандарт для импортного проката</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Практический вывод: в заказе на холоднокатаный рулон указывайте сортамент по ГОСТ 19904-90, марку
			по ГОСТ 5632-2014 (или зарубежный аналог) и стандарт, по которому сталь заявлена в сертификате.
			Подробнее о листовых стандартах — на страницах
			<a href="/gost/5582-75/">ГОСТ 5582-75</a> и <a href="/gost/19904-90/">ГОСТ 19904-90</a>.
			Лист нержавеющий 4–10 мм поставляют по ГОСТ 7350-77.
		</p>
		<h3>Допуски по толщине</h3>
		<p>
			ГОСТ 19904-90 делит прокат по точности толщины на три класса: ВТ — высокая, АТ — повышенная, БТ —
			нормальная. Класс указывают в заказе. Допуск растёт с толщиной и шириной. В таблице — значения из табл. 2
			стандарта для толщин, которые чаще всего берут в рулоне.
		</p>
		<div class="ba-table">
			<table>
				<caption>Предельные отклонения по толщине, мм (ГОСТ 19904-90, табл. 2)</caption>
				<thead>
					<tr><th>Толщина (интервал стандарта)</th><th>Ширина</th><th class="num">ВТ</th><th class="num">АТ</th><th class="num">БТ</th></tr>
				</thead>
				<tbody>
					<tr><td>0,6 мм (св. 0,50 до 0,65)</td><td>до 1000</td><td class="num">±0,04</td><td class="num">±0,05</td><td class="num">±0,06</td></tr>
					<tr><td>0,6 мм (св. 0,50 до 0,65)</td><td>св. 1000 до 1500</td><td class="num">±0,05</td><td class="num">±0,06</td><td class="num">±0,07</td></tr>
					<tr><td>1,0 мм (св. 0,90 до 1,20)</td><td>до 1000</td><td class="num">±0,05</td><td class="num">±0,08</td><td class="num">±0,10</td></tr>
					<tr><td>1,0 мм (св. 0,90 до 1,20)</td><td>св. 1000 до 1500</td><td class="num">±0,06</td><td class="num">±0,09</td><td class="num">±0,11</td></tr>
					<tr><td>2,0 мм (св. 1,80 до 2,00)</td><td>до 1000</td><td class="num">±0,08</td><td class="num">±0,12</td><td class="num">±0,15</td></tr>
					<tr><td>2,0 мм (св. 1,80 до 2,00)</td><td>св. 1000 до 1500</td><td class="num">±0,09</td><td class="num">±0,13</td><td class="num">±0,16</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			<strong>Что это значит для массы.</strong> Рулон продают на тонны, поэтому допуск влияет на длину в тонне.
			Отклонение ±0,05 мм на прокате 0,6 мм — это ±8 % массы метра; на толщине 1,0 мм допуск ±0,05–0,10 мм даёт
			±5–10 %. Чем тоньше прокат, тем сильнее разброс, поэтому для тонкого проката класс точности стоит указывать.
		</p>
		<h3>Другие параметры рулона по ГОСТ 19904-90</h3>
		<ul>
			<li><strong>Внутренний диаметр рулона</strong> — от 500 до 1000 мм (п. 15).</li>
			<li><strong>Масса рулона</strong> — от 1,5 до 20 т (п. 16).</li>
			<li><strong>Ширина необрезного рулона</strong> — отклонение не более +20 мм (п. 6); для обрезной кромки допуски жёстче (п. 7, табл. 4).</li>
			<li><strong>Телескопичность</strong> — смещение витков по торцу ограничено таблицей 8 стандарта (п. 13): 30–60 мм в зависимости от толщины и ширины.</li>
			<li><strong>Замер ширины</strong> — на расстоянии не менее 2 м от конца рулона (п. 18).</li>
		</ul>
		<p>
			Лист, нарезанный из рулона, имеет рулонную кривизну. ГОСТ 5582-75 не считает её браковочным
			признаком для нагартованного и полунагартованного проката, нарезанного из рулонов. Если для детали
			важна плоскостность, указывайте её в заказе по ГОСТ 19904-90 (табл. 7, виды ПО, ПВ, ПУ, ПН): подробнее —
			в статье о <a href="/blog/list-nerzhaveyushchiy-1-2-3-mm/#dopuski">допусках листа</a>.
		</p>
	</section>

	<section id="razmery">
