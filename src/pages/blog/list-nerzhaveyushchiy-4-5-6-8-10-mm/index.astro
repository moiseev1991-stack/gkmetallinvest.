---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'standarty', anchor: 'Стандарты и размеры', summary: 'ГОСТ 7350-77, 19903-2015, 19904-90; форматы в каталоге' },
