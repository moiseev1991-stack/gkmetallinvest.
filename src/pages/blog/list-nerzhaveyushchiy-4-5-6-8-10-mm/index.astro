					<tr><td>5</td><td class="num">39,5</td><td class="num">79,0</td><td class="num">123,4</td><td class="num">177,8</td><td class="num">355,5</td><td class="num">≈ 8,1</td></tr>
					<tr><td>6</td><td class="num">47,4</td><td class="num">94,8</td><td class="num">148,1</td><td class="num">213,3</td><td class="num">426,6</td><td class="num">≈ 6,8</td></tr>
					<tr><td>8</td><td class="num">63,2</td><td class="num">126,4</td><td class="num">197,5</td><td class="num">284,4</td><td class="num">568,8</td><td class="num">≈ 5,1</td></tr>
					<tr><td>10</td><td class="num">79,0</td><td class="num">158,0</td><td class="num">246,9</td><td class="num">355,5</td><td class="num">711,0</td><td class="num">≈ 4,0</td></tr>
				</tbody>
			</table>
