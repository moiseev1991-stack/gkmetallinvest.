---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sostav', anchor: 'Класс и химический состав', summary: 'ГОСТ 5632-2014: C 0,90–1,00 %, Cr 17–19 %' },
	{ id: 'analogi', anchor: 'Аналоги AISI 440B, 440C, 1.4125', summary: 'Что ближе по составу и почему не точный' },
	{ id: 'svoystva', anchor: 'Твёрдость и свойства', summary: 'HB в поставке, HRC после закалки, плотность' },
	{ id: 'termoobrabotka', anchor: 'Термообработка', summary: 'Отжиг, закалка, холод, отпуск' },
	{ id: 'korroziya', anchor: 'Коррозионная стойкость', summary: 'Сравнение с 304 и 40Х13' },
	{ id: 'nozhi', anchor: '95Х18 для ножей', summary: 'Плюсы, минусы, 40Х13 и 440C' },
	{ id: 'primenenie', anchor: 'Применение и обработка', summary: 'Подшипники, втулки, резание, сварка' },
	{ id: 'sortament', anchor: 'Сортамент и стандарты', summary: 'Круг Ø 12–150 мм в каталоге' },
];

const faq = [
	{
		q: 'Что за сталь 95Х18?',
		a: 'Высокоуглеродистая хромистая нержавеющая сталь мартенситного класса по ГОСТ 5632-2014, порядковый номер марки 1-20. В ней 0,90–1,00 % углерода и 17–19 % хрома, никелем и молибденом она не легирована. Прежнее обозначение — 9Х18, код ЭИ229. Стандарт рекомендует её для высокотвёрдых шарикоподшипников нефтяного оборудования, ножей высшего качества, втулок и других деталей, работающих на износ. Сталь применяют после закалки и низкого отпуска.',
	},
	{
		q: 'Какой аналог у стали 95Х18?',
		a: 'Точного аналога нет, ближайшие — американские AISI 440B и 440C (ASTM A276). По углероду 95Х18 лежит на их границе: 0,75–0,95 % у 440B и 0,95–1,20 % у 440C, у 95Х18 — 0,90–1,00 %. Хрома у 95Х18 17–19 %, у обеих 440-х 16–18 %. Марочник сталей и сплавов называет аналогами также EN 1.4125 (X105CrMo17, с 0,40–0,80 % молибдена) и японскую SUS440C. Молибдена в 95Х18 нет, поэтому при замене в заказе указывают углерод и хром, а соответствие проверяют по сертификату плавки.',
	},
	{
		q: 'Какая твёрдость у 95Х18 после закалки?',
		a: 'Круг в поставке по ГОСТ 5949-2018 — не более 269 HB. После закалки с 1000–1050 °C в масле и отпуска при 200–300 °C стандарт требует не менее 55 HRC. Справочные данные марочника для закалки с 1050 °C: 59–64 HRC при отпуске 150 °C, 58–62 HRC при 200 °C, 55–59 HRC при 300 °C. С обработкой холодом при −70…−80 °C и отпуском 150–160 °C марочник даёт до 63 HRC.',
	},
	{
		q: 'Подходит ли 95Х18 для ножей?',
		a: 'Да, «ножи высшего качества» прямо названы в приложении А к ГОСТ 5632-2014. Сталь берут за твёрдость от 55 HRC и износостойкость, которую даёт высокий углерод. Цена этого — малая вязкость, как у всей мартенситной группы, умеренная коррозионная стойкость и требовательность к термообработке: ошибка в режиме снижает твёрдость или стойкость к коррозии. Клинок нужно мыть и вытирать насухо.',
	},
	{
		q: 'Ржавеет ли 95Х18?',
		a: 'Да, при плохом уходе. Это нержавеющая сталь с умеренной стойкостью: в пресной воде и слабоагрессивных средах она держится, особенно после закалки, низкого отпуска и полировки. Хлориды и морскую воду она не выдерживает: для близкой AISI 440C CarTech оценивает стойкость в солевом тумане как ограниченную, в серной, фосфорной и уксусной кислотах — тоже. Отпуск выше 400–430 °C стойкость снижает. Аустенитные 304 и 316 по коррозионной стойкости лучше: у мартенситных сталей, по данным IMOA, она, как правило, ниже, чем у 304.',
	},
	{
		q: 'Чем 95Х18 отличается от 40Х13?',
		a: 'Углеродом и хромом. В 95Х18 по ГОСТ 5632-2014 углерода 0,90–1,00 % против 0,36–0,45 % у 40Х13, хрома 17–19 % против 12–14 %. Поэтому после закалки 95Х18 твёрже: ГОСТ 5949-2018 требует не менее 55 HRC против 50 HRC у 40Х13. Обе стали магнитятся, закаливаются на мартенсит и не применяются для сварных конструкций. Прямого сравнения коррозионной стойкости в стандартах нет, а источники не показывают заметного преимущества 95Х18: часть хрома в ней связана углеродом в карбиды.',
	},
];

const sources = [
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1 (марки 1-19 и 1-20), пп. 6.4–6.6, приложение А', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5949-2018 — металлопродукция из сталей нержавеющих и сплавов на железоникелевой основе: п. 7.1.5, п. 7.1.6, табл. 1 и 2, п. 7.1.7', href: 'https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/1/gost_5949-2018_mezhgosudarstvennyy_standart.html' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, жаростойкий и жаропрочный, п. 3.1 (перечень марок)', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'Марочник сталей и сплавов — 95Х18: состав по ГОСТ 5632-72, зарубежные аналоги, физические свойства, критические точки, отжиг, виды поставки', href: 'http://www.splav-kharkov.com/mat_start.php?name_id=320' },
	{ label: 'Марочник сталей и сплавов — 95Х18: твёрдость в зависимости от температуры отпуска, обработка холодом, свариваемость, обрабатываемость (таблицы воспроизведены на artwood.ru)', href: 'https://www.artwood.ru/state/view/54.html' },
	{ label: 'Справочная сводка по 95Х18: влияние температуры закалки и времени отпуска, коррозионная стойкость, шероховатость поверхности (enginiger.ru, ссылается на марочник и справочники)', href: 'https://enginiger.ru/materials/podshipnikovaya-stal/stal-95-konstruktsionnaya-podshipnikovaya/' },
	{ label: 'ASTM A276 — Type 440B и 440C: состав, твёрдость в отожжённом состоянии, проверка закаливаемости (сводка Boltport)', href: 'https://boltport.com/specifications/astm-a276/' },
	{ label: 'Carpenter Technology — CarTech 440C Stainless (UNS S44004): состав, термообработка, коррозия, шлифовка, обработка, сварка', href: 'https://www.carpentertechnology.com/hubfs/7407324/Material%20Saftey%20Data%20Sheets/440C.pdf' },
	{ label: 'Carpenter Technology — CarTech 420 Stainless: оценка стойкости в средах', href: 'https://www.carpentertechnology.com/hubfs/7407324/Material%20Saftey%20Data%20Sheets/420.pdf' },
	{ label: 'SteelNumber — X105CrMo17 (1.4125) по EN 10088-3', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=258' },
	{ label: 'SteelNumber — X90CrMoV18 (1.4112) по EN 10088-3', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=259' },
	{ label: 'IMOA — Practical Guidelines for the Fabrication of Duplex Stainless Steels, 3-е издание: раздел о мартенситных сталях', href: 'https://www.imoa.info/download_files/stainless-steel/Duplex_Stainless_Steel_3rd_Edition.pdf' },
	{ label: 'ASTM E140 — таблицы перевода твёрдости HB ↔ HRC' },
];

const related = [
	{ label: 'Сталь 40Х13: характеристики, аналог и твёрдость', href: '/blog/stal-40h13/' },
	{ label: 'Сталь 20Х13, 30Х13, 40Х13: мартенситная нержавейка', href: '/blog/martensitnaya-stal-20h13-40h13/' },
	{ label: 'Твёрдость нержавеющей стали: HB и HRC по маркам', href: '/blog/tverdost-nerzhaveyushchey-stali/' },
	{ label: 'Магнитится ли нержавейка', href: '/blog/magnitit-li-nerzhaveika/' },
	{ label: 'Круг нержавеющий — каталог, раздел «Хромистый круг»', href: '/krug-nerzhaveyushchiy/' },
	{ label: 'Круг AISI 420 (20Х13, 30Х13, 40Х13)', href: '/krug-nerzhaveyushchiy/aisi-420/' },
];
---

<BlogArticle
	slug="stal-95h18"
	title="Сталь 95Х18: характеристики, аналог и твёрдость"
	description="Сталь 95Х18 по ГОСТ 5632-2014: состав, аналоги AISI 440B и 440C, твёрдость от 55 HRC после закалки, отпуск, коррозия, ножи и сортамент круга."
	h1="Сталь 95Х18: характеристики, аналоги, твёрдость и применение"
	eyebrow="Справочник"
	datePublished="2026-10-05"
	dateModified="2026-10-05"
	readingMin={13}
	answer="<strong>Сталь 95Х18 — высокоуглеродистая хромистая нержавеющая сталь мартенситного класса: по ГОСТ 5632-2014 в ней 0,90–1,00 % углерода и 17–19 % хрома, никелем и молибденом она не легирована.</strong> Из трёх марок с нормой по HRC в ГОСТ 5949-2018 она самая твёрдая: после закалки с 1000–1050 °C в масле и отпуска при 200–300 °C стандарт требует не менее 55 HRC. Ближайшие аналоги — AISI 440B и 440C, но полного совпадения по составу нет. Сталь магнитится, вязкость у неё низкая, для сварных конструкций она не применяется, а коррозионная стойкость умеренная — ниже, чем у аустенитной 304."
	keyFacts={[
		'Состав по ГОСТ 5632-2014: C 0,90–1,00 %, Cr 17–19 %, Si и Mn ≤ 0,80 %, S ≤ 0,025 %, P ≤ 0,030 %; порядковый номер марки 1-20',
		'Круг, ГОСТ 5949-2018: не более 269 HB в поставке; после закалки 1000–1050 °C в масле и отпуска 200–300 °C — не менее 55 HRC',
		'Справочно (марочник): 58–62 HRC после закалки 1050 °C и отпуска 200 °C; отпуск при 450–600 °C не применяют',
		'Плотность 7,75 г/см³, магнитится, сварка не применяется; сталь применяют после закалки и низкого отпуска',
		'Аналоги: AISI 440B и 440C (хрома 16–18 %, у 95Х18 — 17–19 %), EN 1.4125 с молибденом',
		'В каталоге — круг 95Х18 диаметром от 12 до 150 мм, 22 позиции',
	]}
	coverAlt="Сталь 95Х18: химический состав по ГОСТ 5632-2014, твёрдость после закалки и аналоги AISI 440B и 440C"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['95Х18', 'AISI 440C', 'Мартенситная нержавеющая сталь', 'ГОСТ 5632-2014', 'ГОСТ 5949-2018']}
	cta={{ title: 'Нужен круг 95Х18, 40Х13 или 20Х13?', text: 'Поставляем круг из хромистых марок — 95Х18, 40Х13, 20Х13 — со склада. Пришлите диаметр и длину, остальное рассчитаем. Отгружаем с сертификатом завода-изготовителя.' }}
>
	<section id="sostav">
		<h2>Класс и химический состав 95Х18</h2>
		<p>
			Марка читается так: 95 — около 0,95 % углерода (по стандарту 0,90–1,00 %), Х18 — около 18 % хрома.
			Прежнее обозначение — 9Х18, условный код ЭИ229. ГОСТ 5632-2014 относит 95Х18 к мартенситному классу,
			порядковый номер марки 1-20. По назначению это только коррозионно-стойкая сталь: в графах «жаростойкая»
			и «жаропрочная» таблицы 1 у неё прочерк.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав 95Х18 по ГОСТ 5632-2014, %</caption>
				<thead>
					<tr><th>Элемент</th><th>Массовая доля</th><th>Пункт стандарта</th></tr>
				</thead>
				<tbody>
					<tr><td>Углерод C</td><td>0,90–1,00</td><td>табл. 1</td></tr>
					<tr><td>Хром Cr</td><td>17,00–19,00</td><td>табл. 1</td></tr>
					<tr><td>Кремний Si</td><td>не более 0,80</td><td>табл. 1</td></tr>
					<tr><td>Марганец Mn</td><td>не более 0,80</td><td>табл. 1</td></tr>
					<tr><td>Сера S</td><td>не более 0,025</td><td>табл. 1</td></tr>
					<tr><td>Фосфор P</td><td>не более 0,030</td><td>табл. 1</td></tr>
					<tr><td>Никель Ni, остаточный</td><td>не более 0,60</td><td>п. 6.5</td></tr>
					<tr><td>Медь Cu, остаточная</td><td>не более 0,30</td><td>п. 6.4</td></tr>
					<tr><td>Вольфрам W и ванадий V, остаточные</td><td>не более 0,20 каждого</td><td>п. 6.6</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Марочник сталей и сплавов до сих пор приводит состав по ГОСТ 5632-72: по углероду, хрому, кремнию,
			марганцу, сере и фосфору пределы те же, дополнительно ограничены никель (до 0,6 %), медь (до 0,3 %) и
			титан (до 0,2 %). Если сертификат ссылается на старую редакцию, сверяйте, по какому стандарту указан
			анализ плавки.
		</p>
		<p>
			Приложение А к ГОСТ 5632-2014 рекомендует 95Х18 для шарикоподшипников высокой твёрдости нефтяного
			оборудования, ножей высшего качества, втулок и других деталей, подвергающихся сильному износу, и
			оговаривает: сталь применяют после закалки с низким отпуском. Что общего у мартенситных сталей и чем
			отличаются 20Х13, 30Х13 и 40Х13 — в статье о
			<a href="/blog/martensitnaya-stal-20h13-40h13/">сталях 20Х13, 30Х13 и 40Х13</a>.
		</p>
	</section>

	<section id="analogi">
		<h2>Аналоги: AISI 440B, 440C, 1.4125 и 1.4112</h2>
		<p>
			Марочник сталей и сплавов называет для 95Х18 зарубежные аналоги, но оговаривает, что среди них есть
			и точные, и ближайшие. Сравнение составов показывает: полного совпадения нет ни с одной маркой.
		</p>
		<div class="ba-table">
			<table>
				<caption>95Х18 и зарубежные марки: состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка, стандарт</th><th>C</th><th>Cr</th><th>Mo</th><th>Прочее</th></tr>
				</thead>
				<tbody>
					<tr><td>95Х18 — ГОСТ 5632-2014</td><td>0,90–1,00</td><td>17,0–19,0</td><td>не нормируется</td><td>Si 0,80, Mn 0,80, S 0,025, P 0,030</td></tr>
					<tr><td>AISI 440B — ASTM A276</td><td>0,75–0,95</td><td>16,0–18,0</td><td>0,75</td><td>Si 1,00, Mn 1,00, S 0,030, P 0,040</td></tr>
					<tr><td>AISI 440C — ASTM A276</td><td>0,95–1,20</td><td>16,0–18,0</td><td>0,75</td><td>Si 1,00, Mn 1,00, S 0,030, P 0,040</td></tr>
					<tr><td>1.4125 (X105CrMo17) — EN 10088-3</td><td>0,95–1,20</td><td>16,0–18,0</td><td>0,40–0,80</td><td>Si 1,00, Mn 1,00, S 0,030, P 0,040</td></tr>
					<tr><td>1.4112 (X90CrMoV18) — EN 10088-3</td><td>0,85–0,95</td><td>17,0–19,0</td><td>0,90–1,30</td><td>V 0,07–0,12, Si 1,00, Mn 1,00, S 0,030, P 0,040</td></tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>AISI 440B и 440C.</strong> По углероду 95Х18 лежит на границе двух марок: до 0,95 % она укладывается в 440B, от 0,95 % — в 440C. По хрому 95Х18 на один пункт выше: 17–19 % против 16–18 %, общий интервал — 17–18 %. Молибден в 440-х допускается до 0,75 %, но не требуется, поэтому плавка без молибдена подходит под обе марки.</li>
			<li><strong>1.4125 (X105CrMo17).</strong> Углерод как у 440C, хром 16–18 %, но молибден обязателен — 0,40–0,80 %. Марочник называет её аналогом 95Х18, однако молибдена в 95Х18 нет.</li>
			<li><strong>1.4112 (X90CrMoV18).</strong> Среди аналогов марочника её нет. Хром тот же — 17–19 %, углерода меньше — 0,85–0,95 %, зато 0,90–1,30 % молибдена и ванадий. Это другая композиция: сопоставлять её с 95Х18 можно только условно.</li>
			<li><strong>Другие обозначения.</strong> Марочник перечисляет ещё японскую SUS440C, французскую Z100CD17 и польскую H18.</li>
		</ul>
		<p>
			Плавка 95Х18 с 0,97 % углерода и 17,5 % хрома подходит и под 440C. Плавка с 18,6 % хрома — уже не под 440,
			а только под 95Х18 и по хрому под 1.4112. Плавка 440C с 1,10 % углерода и 16,5 % хрома не отвечает 95Х18
			ни по тому, ни по другому. Поэтому при замене марки в заказе указывают диапазоны углерода и хрома, а
			соответствие проверяют по сертификату с анализом плавки. Сводная таблица соответствия марок — в статье об
			<a href="/blog/analogi-marok-nerzhaveyki/">аналогах нержавейки</a>.
		</p>
	</section>

	<section id="svoystva">
		<h2>Твёрдость, механические и физические свойства</h2>
		<p>
			ГОСТ 5949-2018 требует поставлять сортовой прокат мартенситных сталей термически обработанным —
			отожжённым или отпущенным (п. 7.1.5). Механические свойства 95Х18 стандарт не контролирует (п. 7.1.7).
			Вместо них он нормирует твёрдость HB в поставке и твёрдость HRC на образцах после закалки и отпуска.
		</p>
		<div class="ba-table">
			<table>
				<caption>Твёрдость 95Х18 и аналогов по состояниям</caption>
				<thead>
					<tr><th>Состояние</th><th>Источник</th><th>Твёрдость</th></tr>
				</thead>
				<tbody>
					<tr><td>Поставка: отжиг или отпуск</td><td>ГОСТ 5949-2018, табл. 1</td><td>не более 269 HB</td></tr>
					<tr><td>Закалка 1000–1050 °C, масло; отпуск 200–300 °C</td><td>ГОСТ 5949-2018, табл. 2</td><td>не менее 55 HRC</td></tr>
					<tr><td>Закалка 1050 °C, масло; отпуск 150 / 200 / 300 °C</td><td>Марочник сталей и сплавов</td><td>59–64 / 58–62 / 55–59 HRC</td></tr>
					<tr><td>Закалка, обработка холодом −70…−80 °C, отпуск 150–160 °C</td><td>Марочник сталей и сплавов</td><td>до 63 HRC</td></tr>
					<tr><td>AISI 440B / 440C, отжиг, пруток горячекатаный</td><td>ASTM A276</td><td>не более 269 HB</td></tr>
					<tr><td>AISI 440B, проверка закаливаемости: 1020 °C, масло</td><td>ASTM A276</td><td>не менее 56 HRC</td></tr>
					<tr><td>AISI 440C, проверка закаливаемости: 1020 °C, воздух</td><td>ASTM A276</td><td>не менее 58 HRC</td></tr>
					<tr><td>AISI 440C, закалка 1010–1066 °C; отпуск 149–177 °C</td><td>CarTech 440C</td><td>≈ 60 HRC</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Для режима ГОСТ — закалка 1000–1050 °C в масле, отпуск 200–300 °C — марочник приводит «свыше 56 HRC»;
			действующая норма ГОСТ 5949-2018 — не менее 55. Перевод в HB ориентировочный, по таблицам ASTM E140:
			55 HRC — это примерно 560 HB. Как твёрдость распределяется по другим маркам нержавейки — в статье
			о <a href="/blog/tverdost-nerzhaveyushchey-stali/">твёрдости нержавеющей стали</a>.
		</p>
		<p>
			Прочность отожжённого прутка марочник даёт для полного отжига при 885–920 °C: σв — 770 МПа,
			σ0,2 — 420 МПа, δ5 — 15 %, ψ — 30 %. Для готовой детали после закалки эти цифры не показательны:
			прочность определяется твёрдостью, а ударная вязкость мартенситных сталей низкая.
		</p>

		<h3>Плотность и физические свойства</h3>
		<p>
			Плотность 95Х18 по марочнику сталей и сплавов — 7750 кг/м³ при 20 °C и 7730 кг/м³ при 100 °C.
			Для близкой 440C CarTech указывает 7,62 г/см³, для 1.4125 и 1.4112 европейские данные — 7,7 г/см³.
		</p>
		<div class="ba-table">
			<table>
				<caption>Физические свойства 95Х18 (марочник сталей и сплавов)</caption>
				<thead>
					<tr><th>Свойство</th><th>Значение</th></tr>
				</thead>
				<tbody>
					<tr><td>Плотность при 20 °C</td><td>7750 кг/м³ (7,75 г/см³)</td></tr>
					<tr><td>Модуль упругости при 20 °C</td><td>204 ГПа</td></tr>
					<tr><td>Теплопроводность при 20 °C</td><td>24 Вт/(м·К)</td></tr>
					<tr><td>Коэффициент теплового расширения, 20–100 / 20–300 / 20–500 °C</td><td>11,8 / 12,7 / 13,4 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Удельная теплоёмкость, 20–100 °C</td><td>483 Дж/(кг·К)</td></tr>
					<tr><td>Критические точки</td><td>Ac1 = 830 °C, Ac3 (Acm) = 1100 °C, Ar3 (Arcm) = 810 °C</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Пример расчёта при 7,75 г/см³: круг Ø 20 мм весит 2,43 кг на метр, Ø 50 мм — 15,2 кг на метр.
			В <a href="/kalkulyator-vesa/">калькуляторе веса металлопроката</a> для 95Х18 заложено то же значение —
			7,75 г/см³.
		</p>
		<p>
			<strong>Магнитность.</strong> 95Х18 магнитится: мартенситные стали ферромагнитны, как углеродистая сталь
			(IMOA). Магнитом её не отличить от 40Х13 или AISI 430 — марку подтверждает сертификат или спектральный
			анализ. Почему одни нержавейки магнитятся, а другие нет, — в статье
			<a href="/blog/magnitit-li-nerzhaveika/">магнитится ли нержавейка</a>.
		</p>
		<p>
			<strong>Хрупкость.</strong> Низкая вязкость — свойство всей мартенситной группы: IMOA описывает её как
			сочетание высокой прочности и износостойкости с низкой вязкостью. У 95Х18 к этому добавляется склонность
			к отпускной хрупкости — о ней в следующем разделе.
		</p>
	</section>

	<section id="termoobrabotka">
		<h2>Термообработка: отжиг, закалка, холод, отпуск</h2>
		<p>
			Свойства 95Х18 определяет термообработка. ГОСТ 5632-2014 прямо указывает, что сталь применяют после
			закалки и низкого отпуска. Ориентир для режимов — критические точки: по марочнику Ac1 = 830 °C,
			Ac3 (Acm) = 1100 °C.
		</p>
		<ul>
			<li><strong>Отжиг.</strong> Полный отжиг — 885–920 °C, выдержка 1–2 часа (марочник); после него сталь мягкая, по справочным данным около 215–240 HB, а в поставке по ГОСТ — не более 269 HB. Неполный отжиг для улучшения обрабатываемости — 730–790 °C, 2–6 часов. Для AISI 440C CarTech даёт полный отжиг при 843–871 °C с медленным охлаждением в печи (около 223 HB) и промежуточный при 732–760 °C с охлаждением на воздухе (около 255 HB).</li>
			<li><strong>Закалка.</strong> ГОСТ 5949-2018 — нагрев до 1000–1050 °C и охлаждение в масле. Марочник даёт режим с предварительным подогревом 850–860 °C и закалкой с 1000–1070 °C в масле или на воздухе. CarTech для 440C — 1010–1066 °C, тёплое масло или воздух, и предупреждает: при перегреве полной твёрдости получить нельзя. По справочным данным выше 1050 °C растёт доля остаточного аустенита (17 % при 1050 °C, 32 % при 1100 °C), и твёрдость падает: 58 HRC при 1050 °C, 55 при 1100 °C, 40 при 1150 °C.</li>
			<li><strong>Обработка холодом.</strong> Режим марочника включает охлаждение до −70…−80 °C сразу после закалки и отпуск при 150–160 °C на воздухе. Твёрдость при этом — до 63 HRC.</li>
			<li><strong>Низкий отпуск.</strong> 200–300 °C с охлаждением на воздухе или в масле по ГОСТ 5949-2018. Твёрдость зависит и от выдержки: по справочным данным при 200 °C после закалки с 1040–1060 °C она снижается с 57,5 HRC без отпуска до 55,5 HRC за 1 час и 53 HRC за 3 часа.</li>
			<li><strong>Опасный интервал.</strong> Марочник относит 95Х18 к склонным к отпускной хрупкости; справочные данные называют опасным отпуск при 450–600 °C: падает ударная вязкость. При 480–500 °C резко снижается и коррозионная стойкость. CarTech для 440C рекомендует отпускать ниже 427 °C.</li>
		</ul>

		<h3>Как твёрдость зависит от температуры отпуска</h3>
		<div class="ba-table">
			<table>
				<caption>Твёрдость 95Х18 после закалки в масле и отпуска (марочник сталей и сплавов), HRC</caption>
				<thead>
					<tr><th>Температура отпуска, °C</th><th class="num">Закалка 1050 °C</th><th class="num">Закалка 1040 °C</th></tr>
				</thead>
				<tbody>
					<tr><td>150</td><td class="num">59–64</td><td class="num">—</td></tr>
					<tr><td>200</td><td class="num">58–62</td><td class="num">59</td></tr>
					<tr><td>300</td><td class="num">55–59</td><td class="num">53</td></tr>
					<tr><td>400</td><td class="num">56–59</td><td class="num">56</td></tr>
					<tr><td>500</td><td class="num">51–54</td><td class="num">56</td></tr>
					<tr><td>600</td><td class="num">41–44</td><td class="num">—</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Твёрдость падает неравномерно. После закалки с 1040 °C при отпуске 300 °C она 53 HRC, а при 400 и 500 °C —
			по 56: это небольшой подъём, который называют вторичной твёрдостью. У закалки с 1050 °C отдельного подъёма
			нет, значения при 300 и 400 °C перекрываются. Пользоваться им не стоит: 400–500 °C — зона снижения вязкости
			и коррозионной стойкости. Значение 53 HRC при 300 °C ниже нормы ГОСТ 5949-2018 — не менее 55 HRC, поэтому
			отпуск ближе к 200 °C даёт запас. Таблица — справочные данные, а не гарантия: твёрдость зависит от сечения,
			нагрева и выдержки.
		</p>
	</section>

	<section id="korroziya">
		<h2>Коррозионная стойкость</h2>
		<p>
			Хрома в 95Х18 17–19 %, но углерода 0,90–1,00 %: часть хрома после закалки связана в карбиды. По справочным
			данным в твёрдом растворе остаётся порядка 11 % хрома после закалки с 1050 °C — близко к 12–14 % в сталях
			13-й группы. Поэтому стойкость умеренная и зависит от состояния: наибольшая — после закалки с низким
			отпуском и полировки. Марочник предназначает сталь для деталей, подвергающихся действию умеренно
			агрессивных сред.
		</p>
		<div class="ba-table">
			<table>
				<caption>Стойкость AISI 420 (группа 40Х13) и AISI 440C (аналог 95Х18) в средах, оценка CarTech</caption>
				<thead>
					<tr><th>Среда</th><th>AISI 420</th><th>AISI 440C</th></tr>
				</thead>
				<tbody>
					<tr><td>Влажный воздух</td><td>хорошая</td><td>хорошая</td></tr>
					<tr><td>Азотная кислота</td><td>умеренная</td><td>умеренная</td></tr>
					<tr><td>Едкий натр</td><td>умеренная</td><td>умеренная</td></tr>
					<tr><td>Солевой туман (NaCl)</td><td>умеренная</td><td>ограниченная</td></tr>
					<tr><td>Серная кислота</td><td>ограниченная</td><td>ограниченная</td></tr>
					<tr><td>Фосфорная кислота</td><td>ограниченная</td><td>ограниченная</td></tr>
					<tr><td>Уксусная кислота</td><td>ограниченная</td><td>ограниченная</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Шкала CarTech сравнительная и не заменяет испытаний. Оценки даны для 440C, а не для 95Х18: это ближайший
			аналог по составу, но не та же сталь.
		</p>
		<ul>
			<li><strong>Сравнение с 304.</strong> IMOA отмечает: у мартенситных сталей коррозионная стойкость, как правило, ниже, чем у стандартных аустенитных 304 и 304L, потому что часть хрома у них выделена в карбиды. 95Х18 здесь не исключение.</li>
			<li><strong>Сравнение с 40Х13.</strong> По номинальному хрому 95Х18 выше — 17–19 % против 12–14 %, но прямого сравнения в стандартах нет. Оценки CarTech не показывают преимущества 440C над 420: в солевом тумане она оценена ниже. Корректно говорить так: обе стали рассчитаны на атмосферу и слабоагрессивные среды, обе не подходят для хлоридов, а преимущество 95Х18 — в твёрдости, а не в коррозии.</li>
			<li><strong>Влияние отпуска.</strong> Низкий отпуск до 400 °C стойкость сохраняет; справочные данные называют резкое снижение при 480–500 °C.</li>
			<li><strong>Поверхность.</strong> Марочник отмечает удовлетворительную стойкость полированной поверхности и рекомендует чистоту не ниже ∇8 (по прежней шкале около Ra 0,63–0,32 мкм). Поверхность должна быть без окалины, смазки и посторонних частиц; после изготовления деталей CarTech рекомендует очистку или пассивацию.</li>
		</ul>
		<p>
			Для морской воды и хлоридов 95Х18 не подходит — какие марки туда берут, разобрано в статье о
			<a href="/blog/nerzhaveyka-dlya-morskoy-vody/">нержавейке для морской воды</a>.
		</p>
	</section>

	<section id="nozhi">
		<h2>95Х18 для ножей</h2>
		<p>
			«Ножи высшего качества» прямо названы в приложении А к ГОСТ 5632-2014. Основания для выбора — твёрдость
			от 55 HRC и износостойкость: IMOA называет износостойкость свойством мартенситных сталей, а CarTech —
			440C сталью с самой высокой твёрдостью среди нержавеющих, около 60 HRC.
		</p>
		<div class="ba-table">
			<table>
				<caption>40Х13, 95Х18 и AISI 440C: сравнение для клинков</caption>
				<thead>
					<tr><th>Показатель</th><th>40Х13</th><th>95Х18</th><th>AISI 440C</th></tr>
				</thead>
				<tbody>
					<tr><td>Углерод, %</td><td>0,36–0,45</td><td>0,90–1,00</td><td>0,95–1,20</td></tr>
					<tr><td>Хром, %</td><td>12–14</td><td>17–19</td><td>16–18</td></tr>
					<tr><td>Закалка / отпуск</td><td>1000–1050 °C, масло / 200–300 °C</td><td>1000–1050 °C, масло / 200–300 °C</td><td>1010–1066 °C, масло или воздух / 149–177 °C для максимума</td></tr>
					<tr><td>Твёрдость по нормам, HRC, не менее</td><td>50 (ГОСТ 5949-2018)</td><td>55 (ГОСТ 5949-2018)</td><td>58 (ASTM A276, проверка закаливаемости)</td></tr>
					<tr><td>Справочная твёрдость после низкого отпуска, HRC</td><td>до 52–55</td><td>58–62 при 200 °C</td><td>около 60</td></tr>
					<tr><td>Круг в поставке, HB</td><td>143–229</td><td>не более 269</td><td>не более 269 (отжиг)</td></tr>
					<tr><td>Солевой туман, оценка CarTech</td><td>умеренная (AISI 420)</td><td>оценки нет; у 440C ограниченная</td><td>ограниченная</td></tr>
					<tr><td>Магнитность</td><td>магнитится</td><td>магнитится</td><td>магнитится</td></tr>
				</tbody>
			</table>
		</div>
		<h3>Плюсы</h3>
		<ul>
			<li>Твёрдость от 55 HRC по ГОСТ, по справочным данным — до 58–62 HRC после низкого отпуска. У 40Х13 норма — 50 HRC.</li>
			<li>Высокий углерод и хром: назначение марки для ножей закреплено в ГОСТ 5632-2014.</li>
			<li>Шлифуется и полируется: для 440C CarTech отмечает, что она хорошо шлифуется и полируется; для 95Х18 справочные данные рекомендуют чистоту поверхности не ниже ∇8.</li>
		</ul>
		<h3>Минусы</h3>
		<ul>
			<li>Низкая вязкость, как у всей мартенситной группы: тонкая кромка хуже переносит удары. Это следствие твёрдости, а не брак.</li>
			<li>Умеренная коррозионная стойкость: клинок нужно мыть и вытирать, особенно после соли и кислых продуктов.</li>
			<li>Требовательность к термообработке: перегрев при закалке снижает твёрдость, отпуск при 450–600 °C — вязкость и стойкость. При шлифовке CarTech предупреждает о перегреве, который снижает и твёрдость, и коррозионную стойкость.</li>
			<li>Не сваривается: для сварных конструкций сталь не применяется.</li>
		</ul>
		<p>
			<strong>Чем отличается от 40Х13 и 65Х13.</strong> От 40Х13 — вдвое большим содержанием углерода и более высокой
			нормой твёрдости: 55 HRC против 50. Подробнее о 40Х13 — в статье
			<a href="/blog/stal-40h13/">сталь 40Х13</a>. Марка 65Х13 есть в ГОСТ 5632-2014 (порядковый номер 1-19):
			углерод 0,60–0,70 %, хром 12–14 %, никель до 0,50 %. В таблицах твёрдости ГОСТ 5949-2018 для неё нет
			строки, норма HRC в этом стандарте не задана, поэтому сравнивать её с 95Х18 по нормативной твёрдости нельзя.
		</p>
	</section>

	<section id="primenenie">
		<h2>Применение и обработка</h2>
		<p>
			Назначение складывается из ГОСТ 5632-2014, марочника и справочных данных по близкой 440C.
		</p>
		<ul>
			<li><strong>Подшипники</strong> — шарики и обоймы шарикоподшипников высокой твёрдости, в том числе для нефтяного оборудования (ГОСТ 5632-2014, марочник; CarTech для 440C: шарики и кольца подшипников).</li>
			<li><strong>Ножи и режущие кромки</strong> — ножи высшего качества (ГОСТ 5632-2014), столовые приборы (CarTech для 440C).</li>
			<li><strong>Пары трения</strong> — втулки, оси, стержни и другие детали, подвергающиеся сильному износу; по марочнику — при температуре до 500 °C или в умеренно агрессивных средах.</li>
			<li><strong>Детали насосов и арматуры</strong> — игольчатые и шариковые обратные клапаны, седла клапанов, детали насосов (CarTech для 440C).</li>
		</ul>
		<p>
			<strong>Обработка резанием.</strong> Режут и сверлят 95Х18 в отожжённом состоянии. Марочник оценивает
			обрабатываемость отожжённой стали (212–217 HB) как удовлетворительную. По данным CarTech, 440C режется как
			быстрорежущая сталь: стружка вязкая и длинная, нужны стружколомы. Как выбрать сверло и режимы — в статье о
			<a href="/blog/chem-sverlit-nerzhaveyku/">сверлении нержавейки</a>.
		</p>
		<p>
			<strong>Сварка.</strong> Марочник указывает, что для сварных конструкций сталь не применяется. Если сварка
			неизбежна, CarTech для 440C рекомендует подогрев до 260 °C с выдержкой этой температуры, большое
			тепловложение, присадку того же состава или 309 и сразу после сварки отжиг при 732–760 °C в течение
			6–8 часов, не давая детали остыть ниже 260 °C.
		</p>
	</section>

	<section id="sortament">
		<h2>Сортамент и стандарты</h2>
		<p>
			Технические условия на сортовой прокат из 95Х18 — ГОСТ 5949-2018 (введён с 1 февраля 2019 года вместо
			ГОСТ 5949-75), химический состав — по ГОСТ 5632-2014. Размеры задают стандарты на сортамент.
		</p>
		<div class="ba-table">
			<table>
				<caption>Прокат из 95Х18: стандарты (ГОСТ 5949-2018, марочник сталей и сплавов)</caption>
				<thead>
					<tr><th>Вид проката</th><th>Технические условия</th><th>Сортамент</th></tr>
