				</thead>
				<tbody>
					<tr><td class="num">15</td><td class="num">1/2</td><td class="num">21,3</td><td class="num">—</td><td class="num">21,3</td><td class="num">21,34</td></tr>
					<tr><td class="num">20</td><td class="num">3/4</td><td class="num">26,9</td><td class="num">—</td><td class="num">26,8</td><td class="num">26,67</td></tr>
					<tr><td class="num">25</td><td class="num">1</td><td class="num">33,7</td><td class="num">32</td><td class="num">33,5</td><td class="num">33,40</td></tr>
					<tr><td class="num">32</td><td class="num">1¼</td><td class="num">42,4</td><td class="num">38</td><td class="num">42,3</td><td class="num">42,16</td></tr>
					<tr><td class="num">40</td><td class="num">1½</td><td class="num">48,3</td><td class="num">45</td><td class="num">48,0</td><td class="num">48,26</td></tr>
					<tr><td class="num">50</td><td class="num">2</td><td class="num">60,3</td><td class="num">57</td><td class="num">60,0</td><td class="num">60,33</td></tr>
					<tr><td class="num">65</td><td class="num">2½</td><td class="num">76,1</td><td class="num">76</td><td class="num">75,5</td><td class="num">73,03</td></tr>
					<tr><td class="num">80</td><td class="num">3</td><td class="num">88,9</td><td class="num">89</td><td class="num">88,5</td><td class="num">88,90</td></tr>
					<tr><td class="num">100</td><td class="num">4</td><td class="num">114,3</td><td class="num">108 или 114</td><td class="num">114,0</td><td class="num">114,30</td></tr>
