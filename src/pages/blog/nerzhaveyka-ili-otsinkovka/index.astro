---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'zashchita', anchor: 'Как защищают сталь', summary: 'Пассивная плёнка и жертвенный цинк' },
	{ id: 'srok', anchor: 'Срок службы оцинковки', summary: 'Скорость коррозии цинка по ISO 9223' },
	{ id: 'sravnenie', anchor: 'Сравнение', summary: 'Сварка, пища, вид, контакт металлов' },
	{ id: 'kontakt', anchor: 'Нержавейка и оцинковка вместе', summary: 'Когда нужна изоляция' },
	{ id: 'vybor', anchor: 'Что где выбрать', summary: 'Кровля, ограждения, пищевка, крепёж' },
];

const faq = [
	{
		q: 'Что служит дольше на улице — нержавейка или оцинковка?',
		a: 'Нержавейка, при правильно выбранной марке: её защитная плёнка восстанавливается сама и не расходуется. Цинковое покрытие постепенно растворяется: в городской атмосфере (категория C3 по ISO 9223) — примерно на 0,4–2,1 мкм в год, поэтому срок службы оцинковки ограничен толщиной слоя.',
	},
	{
		q: 'Сколько лет прослужит оцинковка?',
		a: 'Зависит от толщины покрытия и атмосферы. Горячее цинкование толщиной около 85 мкм в атмосфере C3 служит 77 лет и больше, в C4 — 38–77 лет, у моря и в промышленной зоне (C5) — 19–38 лет. Оцинкованный рулон Z275 несёт всего около 20 мкм цинка на сторону и служит в разы меньше.',
	},
	{
		q: 'Можно ли варить оцинковку?',
		a: 'Можно, но цинк кипит при 907 °C и испаряется задолго до плавления стали. Пары оксида цинка вызывают литейную лихорадку, поэтому нужна вытяжка и средства защиты. После сварки защитный слой у шва разрушен — его восстанавливают цинкосодержащими составами.',
	},
	{
		q: 'Можно ли использовать оцинковку для пищевых продуктов?',
		a: 'Для кислых продуктов — нет: цинк растворяется в кислой среде. Пищевой кодекс FDA (Food Code 4-101.15) запрещает оцинкованный металл для контакта с кислыми продуктами. Для пищевого оборудования применяют нержавейку AISI 304 и 316L.',
	},
	{
		q: 'Можно ли крепить нержавейку к оцинковке?',
		a: 'На воздухе — как правило, да: британская ассоциация BSSA и американская AGA оценивают риск как небольшой. Крепёж из нержавейки в оцинкованном листе допустим, а наоборот — цинковый крепёж в нержавеющем листе быстро разрушается. Во влажной, погружённой или морской среде металлы разделяют изолирующими прокладками.',
	},
	{
		q: 'Во сколько раз нержавейка дороже оцинковки?',
		a: 'Соотношение меняется вместе с ценами на никель и зависит от марки: ферритная AISI 430 заметно дешевле хромоникелевой 304. Актуальную цену нержавеющего проката смотрите в каталоге или запросите КП — рассчитаем под ваш объём.',
	},
];

const sources = [
	{ label: 'ISO 9223 / ISO 9224 — категории коррозионной агрессивности атмосферы и скорость коррозии цинка' },
	{ label: 'ГОСТ 9.307-2021 (ISO 1461) — горячее цинкование, толщина покрытия', href: 'https://base.garant.ru/403362239/' },
	{ label: 'American Galvanizers Association — срок службы цинкового покрытия', href: 'https://galvanizeit.org/' },
	{ label: 'Galvanizers Association — ISO 1461', href: 'https://www.galvanizing.org.uk/galvanizing-standards/iso-1461/' },
	{ label: 'BSSA — контакт нержавеющей стали с другими металлами', href: 'https://bssa.org.uk/' },
	{ label: 'IMOA — какую нержавеющую сталь выбрать для улицы и противогололёдных реагентов', href: 'https://www.imoa.info/' },
	{ label: 'FDA Food Code 4-101.15 — ограничение оцинкованного металла для пищевых продуктов' },
];

const related = [
	{ label: 'Лист нержавеющий — каталог и цены', href: '/list-nerzhaveyushchiy/' },
	{ label: 'Лист AISI 430 — экономичная нержавейка', href: '/list-nerzhaveyushchiy/aisi-430/' },
	{ label: 'Лист AISI 316L — для улицы у моря и реагентов', href: '/list-nerzhaveyushchiy/aisi-316l/' },
	{ label: 'Почему ржавеет нержавейка', href: '/blog/pochemu-rzhaveet-nerzhaveyka/' },
	{ label: 'Пищевая нержавейка', href: '/blog/pishchevaya-nerzhaveyka/' },
	{ label: 'Плотность нержавеющей стали и расчёт веса', href: '/blog/plotnost-nerzhaveyushchey-stali/' },
];
---

<BlogArticle
	slug="nerzhaveyka-ili-otsinkovka"
	title="Нержавейка или оцинковка: что выбрать"
	description="Нержавейка или оцинковка: как защищают сталь, сколько служит цинк по ISO 9223, сварка, пищевой контакт, крепёж и где что выбрать."
	h1="Нержавейка или оцинковка: что выбрать и что служит дольше"
	eyebrow="Разбор"
	datePublished="2026-09-19"
	dateModified="2026-09-19"
	readingMin={6}
	answer="<strong>Оцинковка защищает сталь цинком, который постепенно растворяется вместо неё, поэтому срок службы примерно пропорционален толщине слоя. Нержавейку защищает пассивная плёнка оксида хрома, которая восстанавливается сама и не расходуется.</strong> Оцинковка дешевле, но не годится для кислых продуктов и теряет защиту при сварке. Нержавейку выбирают для пищевого оборудования, для улицы у моря и мест с реагентами, а также там, где важен внешний вид."
	keyFacts={[
		'Цинк в городской атмосфере (C3) теряет 0,4–2,1 мкм в год',
		'Горячее цинкование по ГОСТ 9.307: 45–85 мкм в зависимости от толщины металла',
		'Оцинкованный рулон Z275 — около 20 мкм цинка на сторону',
		'Оцинковку нельзя для кислых продуктов (FDA Food Code)',
		'У моря и с реагентами — нержавейка AISI 316; 304 даёт пятна',
	]}
	coverAlt="Нержавейка или оцинковка: сравнение и выбор"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Нержавеющая сталь', 'Оцинкованная сталь', 'Коррозия цинка']}
>
	<section id="zashchita">
		<h2>Как защищают сталь нержавейка и оцинковка</h2>
		<ul>
			<li><strong>Оцинковка</strong> — обычная углеродистая сталь со слоем цинка. Цинк активнее железа и корродирует первым, «жертвуя» собой. Пока цинк есть, сталь под ним не ржавеет, даже в местах мелких царапин. Когда слой израсходован, начинается ржавление.</li>
			<li><strong>Нержавейка</strong> — сталь с хромом от 10,5 %, защищённая по всей толщине. Хром образует на поверхности тонкую пассивную плёнку, которая при повреждении восстанавливается сама. Расходуемого слоя нет, поэтому царапины и срезы не снижают защиту.</li>
		</ul>
	</section>

	<section id="srok">
		<h2>Сколько служит оцинковка</h2>
		<div class="ba-table">
			<table>
				<caption>Скорость коррозии цинка, мкм в год</caption>
				<thead>
					<tr><th>Категория атмосферы</th><th>Где</th><th class="num">Первый год (ISO 9223)</th><th class="num">Долговременная (ISO 9224)</th></tr>
				</thead>
				<tbody>
					<tr><td>C2</td><td>Сельская местность, сухой климат</td><td class="num">0,1–0,7</td><td class="num">0,05–0,4</td></tr>
					<tr><td>C3</td><td>Город, умеренное загрязнение</td><td class="num">0,7–2,1</td><td class="num">0,4–1,1</td></tr>
					<tr><td>C4</td><td>Промышленные районы, прибрежная зона</td><td class="num">2,1–4,2</td><td class="num">1,1–2,2</td></tr>
					<tr><td>C5</td><td>Агрессивная промышленная и морская атмосфера</td><td class="num">4,2–8,4</td><td class="num">2,2–4,4</td></tr>
				</tbody>
			</table>
		</div>
		<div class="ba-table">
			<table>
				<caption>Толщина горячего цинкования по ГОСТ 9.307-2021 (ISO 1461)</caption>
				<thead>
					<tr><th>Толщина металла</th><th class="num">Минимум в точке, мкм</th><th class="num">Среднее, мкм</th></tr>
				</thead>
				<tbody>
					<tr><td>до 1,5 мм</td><td class="num">35</td><td class="num">45</td></tr>
					<tr><td>1,5–3 мм</td><td class="num">45</td><td class="num">55</td></tr>
					<tr><td>3–6 мм</td><td class="num">55</td><td class="num">70</td></tr>
					<tr><td>свыше 6 мм</td><td class="num">70</td><td class="num">85</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Покрытие около 85 мкм в атмосфере C3 служит 77 лет и больше, в C4 — 38–77 лет, в C5 — 19–38 лет.
			Оцинкованный рулон и профнастил несут гораздо меньше цинка: покрытие Z275 — 275 г/м² на обе
			стороны, около 20 мкм на сторону, Z100 — около 7 мкм. Поэтому рулонная оцинковка служит в разы
			меньше, чем горячеоцинкованные изделия.
		</p>
	</section>

	<section id="sravnenie">
		<h2>Сравнение по практическим параметрам</h2>
		<div class="ba-table">
			<table>
				<caption>Нержавейка и оцинковка</caption>
				<thead>
					<tr><th>Параметр</th><th>Оцинковка</th><th>Нержавейка</th></tr>
				</thead>
				<tbody>
					<tr><td>Защита</td><td>Расходуемый слой цинка</td><td>Самовосстанавливающаяся плёнка, защищена вся толщина</td></tr>
					<tr><td>Срез, отверстие, царапина</td><td>Цинк защищает мелкие повреждения, но слой тоньше</td><td>Защита не снижается</td></tr>
					<tr><td>Сварка</td><td>Цинк испаряется (кипит при 907 °C), нужна вытяжка и восстановление покрытия</td><td>Варится без потери защиты при правильной технологии</td></tr>
					<tr><td>Контакт с пищей</td><td>Нельзя с кислыми продуктами</td><td>AISI 304, 316L — для пищевого оборудования</td></tr>
					<tr><td>Внешний вид</td><td>Со временем тускнеет, белый налёт</td><td>Сохраняет вид; поверхности от матовой до зеркальной</td></tr>
					<tr><td>Вес при одинаковой толщине</td><td>Плотность 7,85 г/см³</td><td>7,7–8,0 г/см³ — практически так же</td></tr>
					<tr><td>Цена</td><td>Ниже</td><td>Выше, зависит от марки (430 дешевле 304)</td></tr>
				</tbody>
			</table>
		</div>
	</section>

	<section id="kontakt">
		<h2>Нержавейка и оцинковка в одной конструкции</h2>
		<p>
			На воздухе контакт нержавейки и оцинковки обычно допустим: британская ассоциация BSSA и американская
			AGA оценивают риск гальванической коррозии как небольшой, если металлы остаются сухими. Важно
			соотношение площадей: крепёж из нержавейки в оцинкованном листе допустим, а цинковый или
			оцинкованный крепёж в нержавеющем листе быстро разрушается.
		</p>
		<p>
			Во влажных условиях, при погружении в воду и у моря металлы разделяют изолирующими прокладками или
			шайбами — например, из неопрена или нейлона.
		</p>
	</section>

	<section id="vybor">
		<h2>Что где выбрать</h2>
		<div class="ba-table">
			<table>
				<caption>Выбор по задаче</caption>
				<thead>
					<tr><th>Задача</th><th>Выбор</th></tr>
				</thead>
				<tbody>
					<tr><td>Каркасы, металлоконструкции в сельской и городской атмосфере</td><td>Горячая оцинковка — дешевле при достаточном сроке службы</td></tr>
					<tr><td>Кровля, водостоки, отливы</td><td>Оцинковка — бюджетный вариант; нержавейка — дольше и без покраски</td></tr>
					<tr><td>Пищевое оборудование, кухни, ёмкости для продуктов</td><td>Только нержавейка: AISI 304, для солей и кислот — 316L</td></tr>
					<tr><td>Ограждения, поручни, фасады, где важен вид</td><td>Нержавейка: в городе — 304, у моря и дорог с реагентами — 316</td></tr>
					<tr><td>Побережье, бассейны, химически агрессивная среда</td><td>Нержавейка с молибденом: 316L и выше</td></tr>
					<tr><td>Крепёж для нержавеющих конструкций</td><td>Только нержавеющий</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Для улицы в местах, где зимой применяют противогололёдные реагенты, IMOA рекомендует AISI 316: на
			304 от солей появляются пятна. Чем глаже поверхность, тем меньше на ней задерживаются соли.
		</p>
	</section>
</BlogArticle>
