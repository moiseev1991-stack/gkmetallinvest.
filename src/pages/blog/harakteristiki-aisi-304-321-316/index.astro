---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sostav', anchor: 'Химический состав', summary: 'ASTM A240 и ГОСТ 5632-2014' },
	{ id: 'mehanika', anchor: 'Механические свойства', summary: 'Прочность, текучесть, удлинение' },
	{ id: 'fizika', anchor: 'Физические свойства', summary: 'Плотность, модуль, теплопроводность' },
	{ id: 'otlichiya', anchor: 'Чем отличаются', summary: 'Титан, молибден, углерод' },
	{ id: 'analogi', anchor: 'Аналоги ГОСТ и EN', summary: 'Почему не тождественны' },
	{ id: 'temperatury', anchor: 'Температуры и сварка', summary: 'Окалиностойкость, магнитность' },
];

const faq = [
	{
		q: '12Х18Н10Т и AISI 321 — одно и то же?',
		a: 'Это функциональные аналоги, но не одна и та же марка. У 12Х18Н10Т по ГОСТ 5632-2014 допускается до 0,12 % углерода, у AISI 321 по ASTM A240 — до 0,08 %. Никеля в 12Х18Н10Т 9–11 %, в 321 — 9–12 %. Обе стабилизированы титаном и стойки к межкристаллитной коррозии.',
	},
	{
		q: 'Чем AISI 316L отличается от 316?',
		a: 'Содержанием углерода: в 316L не больше 0,030 %, в 316 — до 0,08 %. Низкий углерод делает 316L стойкой к межкристаллитной коррозии после сварки без стабилизации титаном. Прочность 316L по ASTM A240 чуть ниже: σв от 485 МПа против 515 МПа у 316.',
	},
	{
		q: 'Какой российский аналог AISI 316L?',
		a: 'По ГОСТ 5632-2014 ближайший аналог — 03Х17Н14М3: углерод до 0,030 %, хром 16,8–18,3 %, никель 13,5–15 %, молибден 2,2–2,8 %. В торговле часто встречается обозначение 03Х17Н14М2, но в ГОСТ 5632-2014 такой марки нет. Европейский аналог — 1.4404.',
	},
	{
		q: 'Магнитится ли AISI 304?',
		a: 'В отожжённом состоянии — нет: 304, 321 и 316 — аустенитные стали. После холодной деформации (гибка, штамповка, прокатка) 304 и 321 могут слабо притягивать магнит, 316 — почти нет.',
	},
	{
		q: 'Почему прочность 12Х18Н10Т по ГОСТ и AISI 321 по ASTM отличается?',
		a: 'Стандарты задают разные минимумы и для разного проката. Например, у 12Х18Н10Т предел текучести не меньше 205 МПа для тонкого листа по ГОСТ 5582 и не меньше 235 МПа для толстого по ГОСТ 7350, а у AISI 321 по ASTM A240 — не меньше 205 МПа.',
	},
	{
		q: 'Какая из трёх марок лучше в морской среде?',
		a: 'AISI 316 и 316L — благодаря 2–3 % молибдена они заметно лучше держат хлориды, чем 304 и 321. Для морской атмосферы и брызг 316L подходит, но для постоянного погружения в морскую воду со щелями нужны ещё более легированные стали.',
	},
];

const sources = [
	{ label: 'ASTM A240 — химический состав и механические свойства листа (по сводным таблицам Atlas Steels)', href: 'https://www.atlassteels.com.au/documents/Atlas%20Grade%20datasheet%20-%20all%20datasheets%20rev%20Aug%202013.pdf' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки»', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'EN 10088-1 — физические свойства нержавеющих сталей', href: 'https://tubingchina.com/en-10088-1-ambient-temperature-physical-properties-of-stainless-steel.htm' },
	{ label: 'AZoM — Stainless steel grade 304, 316, 321 datasheets', href: 'https://www.azom.com/article.aspx?ArticleID=2867' },
];

const related = [
	{ label: 'Лист AISI 304 (08Х18Н10)', href: '/list-nerzhaveyushchiy/aisi-304/' },
	{ label: 'Лист AISI 321 (12Х18Н10Т)', href: '/list-nerzhaveyushchiy/aisi-321/' },
	{ label: 'Лист AISI 316L', href: '/list-nerzhaveyushchiy/aisi-316l/' },
	{ label: 'AISI 304, 316L или 321 — какую марку выбрать', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'Аналоги марок нержавейки: AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
	{ label: 'Межкристаллитная коррозия: титан и марки L', href: '/blog/mezhkristallitnaya-korroziya/' },
];
---

<BlogArticle
	slug="harakteristiki-aisi-304-321-316"
	title="AISI 304, 321, 316: характеристики, состав, аналоги"
	description="Характеристики AISI 304, 321 и 316L: состав по ASTM A240 и ГОСТ 5632-2014, прочность листа, плотность, теплопроводность, аналоги 08Х18Н10, 12Х18Н10Т."
	h1="Характеристики AISI 304, 321 и 316L: состав, свойства и аналоги ГОСТ"
	eyebrow="Справочник"
	datePublished="2026-09-19"
	dateModified="2026-09-19"
	readingMin={7}
	answer="<strong>AISI 304 (08Х18Н10, 1.4301), 321 (12Х18Н10Т, 1.4541) и 316L (1.4404) — аустенитные хромоникелевые стали, немагнитные в отожжённом состоянии.</strong> По прочности листа они почти одинаковы: временное сопротивление от 485–530 МПа, предел текучести от 170–235 МПа. 321 отличается титаном, который защищает от межкристаллитной коррозии после нагрева, а 316/316L — 2–3 % молибдена, который даёт стойкость к хлоридам. Российские аналоги не тождественны: у 12Х18Н10Т допускается до 0,12 % углерода против 0,08 % у 321."
	keyFacts={[
		'AISI 304: Cr 17,5–19,5 %, Ni 8,0–10,5 %, C ≤ 0,07 % (ASTM A240)',
		'AISI 321: то же плюс титан от 5 × (C + N) до 0,70 %',
		'AISI 316L: Cr 16–18 %, Ni 10–14 %, Mo 2–3 %, C ≤ 0,030 %',
		'Лист по ASTM A240: σв ≥ 515 МПа (316L ≥ 485), δ ≥ 40 %',
		'Плотность 7,9 г/см³ (304, 321) и 8,0 г/см³ (316), теплопроводность ≈ 15 Вт/(м·К)',
	]}
	coverAlt="Характеристики AISI 304, 321 и 316L: состав, свойства и аналоги"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['AISI 304', 'AISI 321', 'AISI 316L', '12Х18Н10Т']}
	cta={{ title: 'Нужен прокат AISI 304, 321 или 316L?', text: 'Лист, труба, круг и лента в наличии и под заказ — с сертификатом завода-изготовителя.' }}
>
	<section id="sostav">
		<h2>Химический состав</h2>
		<div class="ba-table">
			<table>
				<caption>Химический состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка</th><th>C</th><th>Cr</th><th>Ni</th><th>Mo</th><th>Ti</th><th>Mn</th><th>Si</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 304 (ASTM A240)</td><td>0,07</td><td>17,5–19,5</td><td>8,0–10,5</td><td>—</td><td>—</td><td>2,0</td><td>0,75</td></tr>
					<tr><td>08Х18Н10 (ГОСТ 5632)</td><td>0,08</td><td>17–19</td><td>9–11</td><td>—</td><td>—</td><td>2,0</td><td>0,80</td></tr>
					<tr><td>AISI 321 (ASTM A240)</td><td>0,08</td><td>17–19</td><td>9–12</td><td>—</td><td>5(C+N)–0,70</td><td>2,0</td><td>0,75</td></tr>
					<tr><td>12Х18Н10Т (ГОСТ 5632)</td><td>0,12</td><td>17–19</td><td>9–11</td><td>—</td><td>5C–0,80</td><td>2,0</td><td>0,80</td></tr>
					<tr><td>AISI 316 (ASTM A240)</td><td>0,08</td><td>16–18</td><td>10–14</td><td>2–3</td><td>—</td><td>2,0</td><td>0,75</td></tr>
					<tr><td>AISI 316L (ASTM A240)</td><td>0,030</td><td>16–18</td><td>10–14</td><td>2–3</td><td>—</td><td>2,0</td><td>0,75</td></tr>
					<tr><td>03Х17Н14М3 (ГОСТ 5632)</td><td>0,030</td><td>16,8–18,3</td><td>13,5–15</td><td>2,2–2,8</td><td>—</td><td>1–2</td><td>0,40</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Фосфор по ASTM A240 — до 0,045 %, сера — до 0,030 %, азот — до 0,10 %. В ГОСТ 5632-2014 фосфор
			ограничен 0,035–0,040 %, сера — 0,020 %. В старых редакциях AISI и в стандартах на трубы и пруток
			для 304 встречаются пределы C ≤ 0,08 % и Cr 18–20 % — это не ошибка, а разные документы.
		</p>
	</section>

	<section id="mehanika">
		<h2>Механические свойства листа</h2>
		<div class="ba-table">
			<table>
				<caption>Минимальные значения, отожжённое (закалённое) состояние</caption>
				<thead>
					<tr><th>Марка, стандарт</th><th class="num">σв, МПа</th><th class="num">σ0,2, МПа</th><th class="num">δ, %</th><th class="num">Твёрдость, не более</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 304 — ASTM A240</td><td class="num">515</td><td class="num">205</td><td class="num">40</td><td class="num">201 HB / 92 HRB</td></tr>
					<tr><td>AISI 321 — ASTM A240</td><td class="num">515</td><td class="num">205</td><td class="num">40</td><td class="num">217 HB / 95 HRB</td></tr>
					<tr><td>AISI 316 — ASTM A240</td><td class="num">515</td><td class="num">205</td><td class="num">40</td><td class="num">217 HB / 95 HRB</td></tr>
					<tr><td>AISI 316L — ASTM A240</td><td class="num">485</td><td class="num">170</td><td class="num">40</td><td class="num">217 HB / 95 HRB</td></tr>
					<tr><td>08Х18Н10 — ГОСТ 5582 / 7350</td><td class="num">510</td><td class="num">185 / 205</td><td class="num">45 / 43</td><td class="num">не нормируется</td></tr>
					<tr><td>12Х18Н10Т — ГОСТ 5582 / 7350</td><td class="num">530</td><td class="num">205 / 235</td><td class="num">40 / 38</td><td class="num">не нормируется</td></tr>
					<tr><td>10Х17Н13М2Т — ГОСТ 5582 / 7350</td><td class="num">530</td><td class="num">225 / 235</td><td class="num">38 / 37</td><td class="num">не нормируется</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			ГОСТ 5582-75 относится к тонколистовому прокату (до 3,9 мм), ГОСТ 7350-77 — к толстолистовому.
		</p>
	</section>

	<section id="fizika">
		<h2>Физические свойства при 20 °C</h2>
		<div class="ba-table">
			<table>
				<caption>Физические свойства</caption>
				<thead>
					<tr><th>Свойство</th><th>AISI 304 / 321</th><th>AISI 316 / 316L</th></tr>
				</thead>
				<tbody>
					<tr><td>Плотность</td><td>7,9 г/см³</td><td>8,0 г/см³</td></tr>
					<tr><td>Модуль упругости</td><td>193–200 ГПа</td><td>193–200 ГПа</td></tr>
					<tr><td>Теплопроводность при 20 / 100 °C</td><td>15 / 16,1–16,3 Вт/(м·К)</td><td>15 / 16,3 Вт/(м·К)</td></tr>
					<tr><td>Коэффициент теплового расширения, 20–100 °C</td><td>16,0 × 10⁻⁶ 1/К</td><td>16,0 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Удельное электросопротивление</td><td>0,72–0,73 мкОм·м</td><td>0,74–0,75 мкОм·м</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Подробнее о теплофизических свойствах — в статье <a href="/blog/teplovye-svoystva-nerzhaveyki/">теплопроводность
			и тепловое расширение нержавейки</a>, о плотности — в статье <a href="/blog/plotnost-nerzhaveyushchey-stali/">плотность
			нержавеющей стали</a>.
		</p>
	</section>

	<section id="otlichiya">
		<h2>Чем отличаются марки и где их применяют</h2>
		<div class="ba-table">
			<table>
				<caption>Ключевые отличия</caption>
				<thead>
					<tr><th>Марка</th><th>Главная особенность</th><th>Типичное применение</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 304</td><td>Базовая хромоникелевая нержавейка</td><td>Пищевое оборудование, кухни, ёмкости, архитектура, бытовые изделия</td></tr>
					<tr><td>AISI 321 / 12Х18Н10Т</td><td>Титан связывает углерод — стойкость к межкристаллитной коррозии после нагрева</td><td>Сварные конструкции, выхлопные системы, оборудование для повышенных температур</td></tr>
					<tr><td>AISI 316 / 316L</td><td>2–3 % молибдена — стойкость к хлоридам и ряду кислот; у 316L — низкий углерод</td><td>Химическое и фармацевтическое оборудование, рассолы, морская атмосфера</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Как выбирать между ними под конкретную задачу, разобрано в статье
			<a href="/blog/aisi-304-vs-316l-vs-321/">AISI 304, 316L или 321 — какую марку выбрать</a>.
		</p>
	</section>

	<section id="analogi">
		<h2>Аналоги по ГОСТ и EN</h2>
		<div class="ba-table">
			<table>
				<caption>Соответствие марок</caption>
				<thead>
					<tr><th>AISI</th><th>ГОСТ 5632-2014</th><th>EN</th></tr>
				</thead>
				<tbody>
					<tr><td>304</td><td>08Х18Н10</td><td>1.4301</td></tr>
					<tr><td>321</td><td>12Х18Н10Т, 08Х18Н10Т</td><td>1.4541</td></tr>
					<tr><td>316</td><td>точного аналога нет</td><td>1.4401</td></tr>
					<tr><td>316L</td><td>03Х17Н14М3</td><td>1.4404</td></tr>
					<tr><td>316Ti</td><td>10Х17Н13М2Т, 08Х17Н13М2Т</td><td>1.4571</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Аналоги близки по назначению, но составы не совпадают полностью: у 12Х18Н10Т выше допустимый
			углерод, чем у 321, а у 03Х17Н14М3 больше никеля и уже диапазон молибдена, чем у 316L. Если
			проект требует конкретного стандарта, в заказе указывают именно его, а марку подтверждают
			сертификатом с химическим анализом плавки.
		</p>
	</section>

	<section id="temperatury">
		<h2>Магнитность, сварка и рабочие температуры</h2>
		<ul>
			<li><strong>Магнитность.</strong> В отожжённом состоянии все три марки немагнитны. После холодной деформации 304 и 321 могут слабо магнититься, 316 — почти нет.</li>
			<li><strong>Свариваемость.</strong> Хорошая у всех трёх. Для 304 и 316 в ответственных сварных узлах выбирают низкоуглеродистые версии L, для 321 присадку обычно берут типа 347 — титан плохо переходит через дугу.</li>
			<li><strong>Холод.</strong> Вязкость сохраняется до −196 °C — аустенит применяют в криогенной технике.</li>
			<li><strong>Нагрев на воздухе.</strong> По данным Atlas Steels стойкость к окислению: 304 и 316 — до 870 °C при периодическом и до 925 °C при постоянном нагреве, 321 — до 900 и 925 °C. Если после нагрева нужна коррозионная стойкость, 304 и 316 не рекомендуют длительно держать в интервале 425–860 °C.</li>
		</ul>
	</section>
</BlogArticle>
