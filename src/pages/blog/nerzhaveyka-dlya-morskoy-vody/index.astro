---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'more', anchor: 'Почему море опасно', summary: 'Хлориды, щели, температура' },
	{ id: 'vybor', anchor: 'Марка по условиям', summary: 'Атмосфера, брызги, погружение' },
	{ id: 'dupleks', anchor: 'Дуплекс 2205 и 2507', summary: 'Состав и отличия' },
	{ id: 'basseyny', anchor: 'Крытые бассейны', summary: 'Коррозионное растрескивание' },
	{ id: 'pyatna', anchor: 'Коричневый налёт', summary: 'Чайные пятна и поверхность' },
];

const faq = [
	{
		q: 'Какая нержавейка подходит для морской воды?',
		a: 'Для морской атмосферы и брызг — минимум AISI 316L. Для деталей, постоянно погружённых в морскую воду, особенно со щелями и застойными зонами, нужны стали с индексом PREN больше 40: супердуплекс 2507 или аустенит с 6 % молибдена (254 SMO).',
	},
	{
		q: 'Подойдёт ли AISI 316L для яхты или пирса?',
		a: 'Для надводных деталей — поручней, леерных стоек, фурнитуры — да, при регулярной мойке пресной водой. Для деталей, постоянно находящихся в морской воде, 316L ненадёжна: в щелях и под обрастанием возможна щелевая и питтинговая коррозия.',
	},
	{
		q: 'Почему нержавейка у моря покрывается коричневым налётом?',
		a: 'Это так называемые чайные пятна (tea staining) — поверхностная коррозия от морских солей. Чаще всего они появляются на AISI 304 и 430. Против них помогают марка 316 и выше в прибрежной зоне, гладкая поверхность с шероховатостью Ra меньше 0,5 мкм, вертикальное направление рисок и регулярная мойка.',
	},
	{
		q: 'Какую сталь брать для крытого бассейна?',
		a: 'Для элементов, которые регулярно моют (поручни, лестницы), подходят 1.4401, 1.4404 (316L), 1.4571, 1.4462 (2205). Для несущих и подвесных элементов, которые не очищаются, — только высоколегированные 1.4565, 1.4529, 1.4547 (класс CRC V по EN 1993-1-4): атмосфера над бассейном вызывает коррозионное растрескивание обычных марок.',
	},
	{
		q: 'Чем дуплекс 2205 отличается от 2507?',
		a: 'Супердуплекс 2507 содержит больше хрома (24–26 % против 22–23 %), молибдена (3–5 % против 3–3,5 %) и азота, поэтому его PREN около 43 против 35 у 2205. 2205 хорошо работает во многих хлоридных средах, но для ответственных узлов в морской воде со щелями его стойкости может не хватить.',
	},
	{
		q: 'Можно ли AISI 304 для поручней бассейна?',
		a: 'Для регулярно очищаемых поручней в зоне бассейна обычно применяют марки с молибденом (316L и выше). AISI 304 не применяют в нагруженных и подвесных элементах: именно коррозионное растрескивание подвесов из 1.4301 (304) привело к обрушению потолка бассейна в Устере в 1985 году.',
	},
];

const sources = [
	{ label: 'IMOA / Euro Inox — безопасное применение нержавеющей стали в крытых бассейнах', href: 'https://www.imoa.info/download_files/stainless-steel/euroinox/Safe_use_swimmingpools_EN.pdf' },
	{ label: 'BSSA — Stainless steel in indoor swimming pool buildings', href: 'https://bssa.org.uk/bssa_articles/stainless-steel-in-indoor-swimming-pool-buildings/' },
	{ label: 'IMOA — Practical Guidelines for the Fabrication of Duplex Stainless Steels', href: 'https://www.imoa.info/download_files/stainless-steel/Duplex_Stainless_Steel_3rd_Edition.pdf' },
	{ label: 'SCI — EN 1993-1-4, классы коррозионной стойкости CRC', href: 'https://www.steel-sci.com/assets/uk-tech1801.pdf' },
	{ label: 'ASSDA — Preventing coastal corrosion (tea staining)', href: 'https://www.assda.asn.au/publications/technical-faqs/preventing-coastal-corrosion-tea-staining' },
	{ label: 'ASTM A240 — состав дуплексных и супераустенитных сталей' },
];

const related = [
	{ label: 'Питтинговая коррозия и индекс PREN', href: '/blog/pittingovaya-korroziya/' },
	{ label: 'Лист AISI 316L', href: '/list-nerzhaveyushchiy/aisi-316l/' },
	{ label: 'Дуплекс 2205 (03Х22Н5АМ3)', href: '/list-nerzhaveyushchiy/duplex-2205/' },
	{ label: 'Лист AISI 904L', href: '/list-nerzhaveyushchiy/aisi-904l/' },
	{ label: 'Почему ржавеет нержавейка', href: '/blog/pochemu-rzhaveet-nerzhaveyka/' },
	{ label: 'Поверхности листа 2B, BA, 4N, 8K', href: '/blog/poverhnosti-nerzhaveyushchego-lista/' },
];
---

<BlogArticle
	slug="nerzhaveyka-dlya-morskoy-vody"
	title="Нержавейка для морской воды и бассейнов"
	description="Нержавейка для морской воды и бассейнов: 316L для морской атмосферы, PREN больше 40 для погружения, дуплекс 2205 и 2507, риски в крытых бассейнах."
	h1="Нержавейка для морской воды и бассейнов: 316L, дуплекс 2205 и выше"
	eyebrow="Разбор"
	datePublished="2026-09-19"
	dateModified="2026-09-19"
	readingMin={6}
	answer="<strong>AISI 316L подходит для морской атмосферы и брызг, но для деталей, постоянно погружённых в морскую воду, особенно со щелями, нужны стали с PREN больше 40 — супердуплекс 2507 или аустенит с 6 % молибдена.</strong> В крытых бассейнах главная опасность — коррозионное растрескивание под напряжением в атмосфере над водой: несущие элементы, которые не моют регулярно, делают только из высоколегированных марок 1.4529, 1.4547, 1.4565."
	keyFacts={[
		'Морская атмосфера и брызги — минимум AISI 316 / 316L',
		'Погружение в морскую воду со щелями — PREN &gt; 40: 2507, 254 SMO',
		'Крытые бассейны, неочищаемые несущие элементы — 1.4529, 1.4547, 1.4565 (CRC V)',
		'Регулярно очищаемые элементы бассейна — 1.4401, 1.4404, 1.4571, 1.4462',
		'Против «чайных пятен» у моря — 316 и выше, Ra &lt; 0,5 мкм, регулярная мойка',
	]}
	coverAlt="Нержавейка для морской воды и бассейнов: 316L, дуплекс 2205 и 2507"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Нержавеющая сталь для морской воды', 'Дуплексная сталь', 'Бассейн']}
	cta={{ title: 'Нужен 316L, 904L или дуплекс 2205?', text: 'Подберём марку под морскую среду или бассейн и пришлём КП с сертификатом завода.' }}
>
	<section id="more">
		<h2>Почему морская среда опасна для нержавейки</h2>
		<p>
			В морской воде около 3,5 % солей, основная их часть — хлориды. Хлорид-ионы локально разрушают
			пассивную плёнку и вызывают питтинг, а в щелях, под прокладками и обрастанием — щелевую коррозию.
			Тёплая вода и застой ускоряют процесс. Поэтому марку выбирают не только по среде, но и по
			конструкции: открытая, чистая поверхность служит дольше, чем узел со щелями.
		</p>
	</section>

	<section id="vybor">
		<h2>Какую марку выбрать по условиям</h2>
		<div class="ba-table">
			<table>
				<caption>Нержавейка для морских условий</caption>
				<thead>
					<tr><th>Условия</th><th>Марка</th><th class="num">PREN</th></tr>
				</thead>
				<tbody>
					<tr><td>Прибрежная зона, морская атмосфера</td><td>AISI 316 / 316L; 304 — только при регулярной мойке и вдали от моря</td><td class="num">24</td></tr>
					<tr><td>Брызги, надводные детали судов и пирсов</td><td>AISI 316L; для ответственных узлов — дуплекс 2205</td><td class="num">24–35</td></tr>
					<tr><td>Погружение, узлы со щелями, теплообменники на морской воде</td><td>Супердуплекс 2507, 254 SMO (6Mo)</td><td class="num">≥ 40</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Порог PREN &gt; 40 для постоянного контакта с морской водой закреплён в отраслевых требованиях
			(NORSOK). Стали с PREN около 32 стойки к питтингу, но не к щелевой коррозии в морской воде. Подробнее
			о показателе — в статье о <a href="/blog/pittingovaya-korroziya/">питтинговой коррозии</a>.
		</p>
	</section>

	<section id="dupleks">
		<h2>Дуплекс 2205, супердуплекс 2507 и супераустениты</h2>
		<div class="ba-table">
			<table>
				<caption>Состав по ASTM A240, %</caption>
				<thead>
					<tr><th>Марка</th><th>Cr</th><th>Ni</th><th>Mo</th><th>N</th><th class="num">PREN</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 316L</td><td>16–18</td><td>10–14</td><td>2–3</td><td>до 0,10</td><td class="num">24</td></tr>
					<tr><td>Duplex 2205 (S32205)</td><td>22–23</td><td>4,5–6,5</td><td>3,0–3,5</td><td>0,14–0,20</td><td class="num">35</td></tr>
					<tr><td>AISI 904L</td><td>19–23</td><td>23–28</td><td>4–5</td><td>—</td><td class="num">34–35</td></tr>
					<tr><td>Super duplex 2507 (S32750)</td><td>24–26</td><td>6–8</td><td>3–5</td><td>0,24–0,32</td><td class="num">43</td></tr>
					<tr><td>254 SMO (S31254)</td><td>19,5–20,5</td><td>17,5–18,5</td><td>6,0–6,5</td><td>0,18–0,25</td><td class="num">43</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Предел текучести дуплекса 2205 по ASTM A240 — не меньше 450 МПа против 170 МПа у 316L, и к хлоридам он заметно стойче. Но, по
			оценке IMOA, для ответственных узлов в морской воде с отложениями и щелями его стойкости может не
			хватить — там применяют 2507. Супердуплекс в хлорированной морской воде обычно ограничивают
			температурой около 40 °C.
		</p>
	</section>

	<section id="basseyny">
		<h2>Крытые бассейны: коррозионное растрескивание</h2>
		<p>
			В атмосфере над хлорированной водой на металле оседают хлориды, которые не смываются. На
			нагруженных элементах из обычной нержавейки это вызывает коррозионное растрескивание под
			напряжением — трещины без видимой ржавчины. В 1985 году в Устере (Швейцария) обрушился подвесной
			потолок бассейна, погибли 12 человек; причиной стало растрескивание подвесов из 1.4301 (AISI 304).
		</p>
		<div class="ba-table">
			<table>
				<caption>Нержавейка в крытых бассейнах (IMOA / Euro Inox, EN 1993-1-4)</caption>
				<thead>
					<tr><th>Элементы</th><th>Марки</th></tr>
				</thead>
				<tbody>
					<tr><td>Регулярно очищаемые: поручни, лестницы, облицовка</td><td>1.4401, 1.4404 (316L), 1.4571 (316Ti), 1.4439, 1.4462 (2205)</td></tr>
					<tr><td>Несущие и подвесные, которые не очищаются регулярно</td><td>только 1.4565, 1.4529, 1.4547 — класс коррозионной стойкости CRC V</td></tr>
					<tr><td>То же при содержании хлоридов в воде меньше 250 мг/л</td><td>допускается 1.4539 (904L)</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Позиции по дуплексным сталям для несущих элементов бассейнов расходятся: IMOA и Euro Inox их не
			рекомендуют, британская ассоциация BSSA допускает супердуплекс 1.4507. В проекте ориентируются на
			действующие нормы и требования экспертизы.
		</p>
	</section>

	<section id="pyatna">
		<h2>Коричневый налёт у моря — «чайные пятна»</h2>
		<p>
			У моря AISI 304 и 430 со временем покрываются коричневым налётом — так называемыми чайными пятнами.
			Это поверхностная коррозия от морских солей: на прочность не влияет, но портит вид. Австралийская
			ассоциация ASSDA рекомендует в пределах примерно 5 км от линии прибоя применять как минимум 316.
		</p>
		<ul>
			<li><strong>Гладкая поверхность.</strong> При шероховатости Ra больше 1,0 мкм налёт сильный, при Ra меньше 0,5 мкм — слабый.</li>
			<li><strong>Вертикальные риски шлифовки</strong> — вода и соли быстрее стекают.</li>
			<li><strong>Регулярная мойка</strong> пресной водой, особенно в местах, куда не попадает дождь.</li>
		</ul>
	</section>
</BlogArticle>
