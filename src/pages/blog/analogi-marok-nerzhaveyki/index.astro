---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../../data/site';

const title = 'Аналоги марок нержавейки — таблица AISI, ГОСТ, EN (DIN)';
const description = 'Таблица соответствия марок нержавеющей стали: AISI 304 = 08Х18Н10 = 1.4301, 316L = 03Х17Н14М2 = 1.4404, 321 = 12Х18Н10Т = 1.4541, 430 = 12Х17, 20Х13/40Х13. Как читать обозначения и подбирать аналог.';

const cover = '/img/blog/analogi-marok-nerzhaveyki.svg';
const datePublished = '2026-07-17';
const dateModified = '2026-07-17';
const url = `${siteUrl.replace(/\/$/, '')}/blog/analogi-marok-nerzhaveyki/`;

const sections = [
	{
		id: 'tablica',
		anchor: 'Таблица аналогов',
		title: 'Таблица соответствия AISI ↔ ГОСТ ↔ EN',
		summary: 'Основные марки в трёх системах обозначений.',
	},
	{
		id: 'kak-chitat',
		anchor: 'Как читать обозначения',
		title: 'Как читать ГОСТ, AISI и EN',
		summary: 'Что означают цифры и буквы в марке.',
	},
	{
		id: 'nyuansy',
		anchor: 'Нюансы замены',
		title: 'Когда «аналог» — не полная замена',
		summary: 'L, Ti, допуски по углероду и молибдену.',
	},
	{
		id: 'martensit',
		anchor: 'Мартенситные и жаропрочные',
		title: 'Мартенситные и жаропрочные марки',
		summary: '20Х13, 40Х13, 310S, 904L и их шифры.',
	},
];

const rows = [
	{ aisi: '304', gost: '08Х18Н10', en: '1.4301', note: 'Универсал, пищёвка, архитектура' },
	{ aisi: '304L', gost: '03Х18Н11', en: '1.4307', note: 'Низкоуглеродистый, под сварку' },
	{ aisi: '321', gost: '12Х18Н10Т', en: '1.4541', note: 'Стабилизирован титаном, горячие узлы' },
	{ aisi: '316', gost: '10Х17Н13М2', en: '1.4401', note: 'С молибденом, хлориды' },
	{ aisi: '316L', gost: '03Х17Н14М2', en: '1.4404', note: 'Низкоуглеродистый, фарма, море' },
	{ aisi: '316Ti', gost: '10Х17Н13М2Т', en: '1.4571', note: 'Молибден + титан, горячая химия' },
	{ aisi: '430', gost: '12Х17', en: '1.4016', note: 'Ферритная, без никеля, дешевле' },
	{ aisi: '201', gost: '12Х15Г9НД', en: '1.4372', note: 'Марганцевая, экономичный аустенит' },
	{ aisi: '410', gost: '12Х13', en: '1.4006', note: 'Мартенситная, лопатки, крепёж' },
	{ aisi: '420', gost: '20Х13 / 30Х13 / 40Х13', en: '1.4021 / 1.4028', note: 'Мартенситная, ножи, инструмент' },
	{ aisi: '310S', gost: '20Х23Н18', en: '1.4845', note: 'Жаропрочная, до +1000 °C' },
	{ aisi: '904L', gost: '06ХН28МДТ', en: '1.4539', note: 'Супераустенит, кислоты' },
	{ aisi: '2205', gost: '03Х22Н5АМ2', en: '1.4462', note: 'Дуплекс, прочность + хлориды' },
];

const faq = [
	{
		q: 'Какой ГОСТ-аналог у AISI 304?',
		a: 'AISI 304 соответствует российской марке 08Х18Н10 по ГОСТ 5632-2014, европейский эквивалент — 1.4301 по EN 10088. Это одна и та же аустенитная сталь 18/8 (18 % хрома, 8–10 % никеля) под тремя системами обозначений. В сертификатах на импортный и отечественный прокат часто указывают оба шифра через дробь.',
	},
	{
		q: 'Чем отличается 12Х18Н10Т от AISI 321?',
		a: 'Ничем — это одна марка. 12Х18Н10Т — обозначение по ГОСТ 5632, AISI 321 — по американскому стандарту ASTM/AISI, 1.4541 — по европейскому EN 10088. Сталь аустенитная, стабилизированная титаном (буква Т в конце ГОСТ-шифра), для сварных узлов, работающих при 450–850 °C. Запрос «12х18н10т аналог aisi» как раз и означает поиск этого соответствия.',
	},
	{
		q: 'AISI 316 и 316L — это разные марки?',
		a: 'Да. Буква L (low carbon) означает пониженный углерод: у 316L он ≤ 0,03 %, у обычного 316 — до 0,08 %. Низкий углерод предотвращает выпадение карбидов хрома по границам зёрен при сварке и защищает от межкристаллитной коррозии. ГОСТ-аналоги: 316 → 10Х17Н13М2, 316L → 03Х17Н14М2. Для сварных ответственных конструкций берут именно L-версию.',
	},
	{
		q: 'Можно ли заменить одну марку на аналог напрямую?',
		a: 'В пределах одной системы обозначений (AISI 304 = 08Х18Н10 = 1.4301) — да, это буквально один материал. Но «похожие» марки заменять напрямую нельзя без проверки: 304 не заменит 316L в хлоридах, 316 не заменит 316L в сварке, обычный 08Х18Н10 не заменит 12Х18Н10Т в горячем узле. Всегда сверяйте химсостав и условия эксплуатации, а не только близость номеров.',
	},
	{
		q: 'Что означают цифры в марке 08Х18Н10?',
		a: 'В российской системе ГОСТ 5632: первые цифры — сотые доли процента углерода (08 = 0,08 % C), затем буква легирующего элемента и его процент — Х18 = 18 % хрома (Chrom), Н10 = 10 % никеля (Nickel). Т в конце = титан, М = молибден, Г = марганец. То есть 08Х18Н10 читается как «0,08 % углерода, 18 % хрома, 10 % никеля» — это и есть AISI 304.',
	},
];

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: `${siteUrl.replace(/\/$/, '')}${cover}`,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	datePublished,
	dateModified,
	author: { '@type': 'Organization', name: siteName, url: siteUrl },
	publisher: {
		'@type': 'Organization',
		name: siteName,
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl.replace(/\/$/, '')}/favicon.svg` },
	},
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
	})),
};
---

<BaseLayout title={title} description={description} image={cover} type="article" jsonLd={[articleJsonLd, faqJsonLd]}>
	<div class="container post">
		<Breadcrumbs items={[
			{ label: 'Главная', href: '/' },
			{ label: 'Блог', href: '/blog/' },
			{ label: 'Аналоги марок нержавейки' },
		]} />

		<header class="post__hero">
			<span class="post__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M4 2v6a4 4 0 0 0 8 0V2M4 2h2v3H4M10 2h2v3h-2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
				</svg>
				Статья · таблица соответствия
			</span>
			<h1 class="post__h1">Аналоги марок нержавейки: таблица AISI, ГОСТ и EN</h1>
			<div class="post__meta">
				<time datetime={datePublished}>17 июля 2026</time>
				<span>·</span>
				<span>чтение 5 минут</span>
			</div>
			<p class="post__lead">
				<strong>Прямой ответ:</strong> одна и та же нержавеющая сталь обозначается по-разному
				в трёх системах. AISI 304 = ГОСТ 08Х18Н10 = EN 1.4301; 316L = 03Х17Н14М2 = 1.4404;
				321 = 12Х18Н10Т = 1.4541; 430 = 12Х17 = 1.4016. Ниже — полная таблица и как читать
				обозначения, чтобы не спутать «аналог» с полной заменой.
			</p>
		</header>

		<figure class="post__cover">
			<img
				src={cover}
				alt="Аналоги марок нержавейки — таблица соответствия AISI, ГОСТ и EN"
				width="1200"
				height="630"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<nav class="post__toc" aria-label="Содержание">
			<div class="post__toc-title">На странице</div>
			<ul>
				{sections.map((s) => (
					<li>
						<a href={`#${s.id}`}>
							<strong>{s.anchor}</strong>
							<span>{s.summary}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<article class="post__body">
			<section class="post__section" id="tablica">
				<h2>Таблица соответствия AISI ↔ ГОСТ ↔ EN</h2>
				<p>
					Три системы обозначений описывают одни и те же стали: американская AISI/ASTM,
					российская ГОСТ 5632-2014 (буквенно-цифровой шифр) и европейская EN 10088
					(номер вида 1.4xxx). В таблице — самые ходовые марки нержавеющего проката.
				</p>
				<div class="post__table-wrap">
					<table class="post__table">
						<thead>
							<tr>
								<th scope="col">AISI</th>
								<th scope="col">ГОСТ</th>
								<th scope="col">EN (DIN)</th>
								<th scope="col">Где применяют</th>
							</tr>
						</thead>
						<tbody>
							{rows.map((r) => (
								<tr>
									<th scope="row">{r.aisi}</th>
									<td>{r.gost}</td>
									<td>{r.en}</td>
									<td>{r.note}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p>
					Карточки самых ходовых марок с прайсом и сортаментом: <a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a>,
					<a href="/list-nerzhaveyushchiy/aisi-316l/"> AISI 316L</a>, <a href="/list-nerzhaveyushchiy/aisi-321/">AISI 321</a>,
					<a href="/list-nerzhaveyushchiy/aisi-430/"> AISI 430</a>, <a href="/list-nerzhaveyushchiy/aisi-201/">AISI 201</a>.
				</p>
			</section>

			<section class="post__section" id="kak-chitat">
				<h2>Как читать ГОСТ, AISI и EN</h2>
				<p>
					<strong>ГОСТ 5632.</strong> Шифр расшифровывается по составу: первые цифры — сотые
					доли процента углерода, буквы — легирующие элементы, цифры после букв — их процент.
					Пример: <strong>12Х18Н10Т</strong> = 0,12 % углерода (C), 18 % хрома (Х), 10 %
					никеля (Н), стабилизация титаном (Т). Буквы: Х — хром, Н — никель, М — молибден,
					Т — титан, Г — марганец, С — кремний, Д — медь.
				</p>
				<p>
					<strong>AISI.</strong> Трёхзначный номер: серия 3xx — аустенитные хромоникелевые
					(304, 316, 321), 2xx — хромомарганцевые аустенитные (201), 4xx — ферритные и
					мартенситные (430, 410, 420). Буква L — низкий углерод, Ti — стабилизация титаном,
					H — повышенный углерод для жаропрочности.
				</p>
				<p>
					<strong>EN 10088.</strong> Номер вида <strong>1.4301</strong>: «1» — сталь, «4» —
					группа нержавеющих/жаростойких, последние три цифры — порядковый номер марки.
					Параллельно существует буквенное имя (X5CrNi18-10 — то же 304).
				</p>
			</section>

			<section class="post__section" id="nyuansy">
				<h2>Когда «аналог» — не полная замена</h2>
				<p>
					Соответствие внутри одной марки (304 = 08Х18Н10 = 1.4301) — это буквально один и
					тот же металл. Но близкие по номеру марки — не взаимозаменяемы:
				</p>
				<ul>
					<li>
						<strong>304 vs 304L.</strong> Разница — в углероде (0,08 % против 0,03 %). Для
						толстых сварных швов берут L-версию, иначе возможна межкристаллитная коррозия.
					</li>
					<li>
						<strong>316 vs 316L.</strong> То же самое: L — под сварку. ГОСТ-аналоги
						10Х17Н13М2 и 03Х17Н14М2 соответственно.
					</li>
					<li>
						<strong>304 vs 321.</strong> 321 (12Х18Н10Т) стабилизирована титаном для горячих
						узлов — 08Х18Н10 её не заменит там, где идёт нагрев 450–850 °C.
					</li>
					<li>
						<strong>304 vs 316L.</strong> Разница в молибдене: в хлоридах и морской воде
						304 даёт питтинг, нужен 316L. Подробнее —
						<a href="/blog/aisi-304-vs-316l-vs-321/"> сравнение 304, 316L и 321</a>.
					</li>
				</ul>
				<p>
					Вывод: подбирая аналог, сверяйте не номер, а химсостав и условия эксплуатации.
					Таблица даёт точку старта, финальное решение — по сертификату плавки.
				</p>
			</section>

			<section class="post__section" id="martensit">
				<h2>Мартенситные и жаропрочные марки</h2>
				<p>
					Отдельный частый запрос — аналоги мартенситных «ножевых» и жаропрочных сталей:
				</p>
				<ul>
					<li>
						<strong>20Х13 / 30Х13 / 40Х13</strong> — мартенситные хромистые, семейство
						AISI 420 (EN 1.4021/1.4028). Различаются углеродом и твёрдостью после закалки.
						Разбор — в статье
						<a href="/blog/martensitnaya-stal-20h13-40h13/"> 20Х13, 30Х13, 40Х13</a>.
					</li>
					<li><strong>12Х13</strong> — AISI 410, EN 1.4006. Менее твёрдая, крепёж и лопатки.</li>
					<li><strong>20Х23Н18</strong> — AISI 310S, EN 1.4845. Жаропрочная аустенитная до +1000 °C.</li>
					<li><strong>06ХН28МДТ</strong> — AISI 904L, EN 1.4539. Супераустенит для кислот.</li>
				</ul>
				<p>
					Мартенситные марки берём под ножи и инструмент (<a href="/krug-nerzhaveyushchiy/aisi-420/">круг AISI 420</a>),
					жаропрочные — под печную оснастку и обжиг. Полный сортамент — в каталогах
					<a href="/list-nerzhaveyushchiy/">листа</a>, <a href="/krug-nerzhaveyushchiy/">круга</a> и <a href="/truba-nerzhaveyushchaya/">трубы</a>,
					стандарты — в <a href="/gost/">справочнике ГОСТов</a>.
				</p>
			</section>

			<section class="post__faq">
				<h2>Частые вопросы</h2>
				<div class="post__faq-list">
					{faq.map((f) => (
						<details class="post__faq-item">
							<summary class="post__faq-q">
								<span>{f.q}</span>
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
									<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</summary>
							<p set:html={f.a} />
						</details>
					))}
				</div>
			</section>

			<aside class="post__related">
				<h2>Смежные страницы</h2>
				<ul>
					<li><a href="/blog/aisi-304-vs-316l-vs-321/">AISI 304 vs 316L vs 321 — какую марку выбрать</a></li>
					<li><a href="/blog/vidy-nerzhaveyushchey-stali/">Виды нержавеющей стали</a></li>
					<li><a href="/blog/martensitnaya-stal-20h13-40h13/">20Х13, 30Х13, 40Х13 — мартенситные стали</a></li>
					<li><a href="/list-nerzhaveyushchiy/aisi-304/">Лист AISI 304 (08Х18Н10)</a></li>
					<li><a href="/list-nerzhaveyushchiy/aisi-316l/">Лист AISI 316L (03Х17Н14М2)</a></li>
					<li><a href="/gost/">Справочник ГОСТов на нержавеющий металлопрокат</a></li>
				</ul>
			</aside>
		</article>
	</div>

	<CtaSection
		title="Нужен конкретный аналог под спецификацию?"
		text="Менеджер сверит марку по AISI, ГОСТ или EN, подберёт прокат из наличия и пришлёт КП с сертификатом плавки в течение 30 минут."
	/>
</BaseLayout>

<style>
	.post { padding-block: var(--space-8); min-width: 0; }

	.post__hero { margin-bottom: var(--space-6); max-width: 75ch; }
	.post__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		margin-bottom: var(--space-3);
	}
	.post__h1 {
		font-size: clamp(1.7rem, 3.5vw, 2.4rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-2);
	}
	.post__meta {
		display: flex;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		margin-bottom: var(--space-4);
	}
	.post__lead {
		font-size: 1.08rem;
		line-height: 1.6;
		max-width: 70ch;
		color: var(--color-text);
		margin: 0;
	}
	.post__lead strong { color: var(--color-primary); }

	.post__cover {
		margin: 0 0 var(--space-8);
		max-width: 80ch;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
	}
	.post__cover img {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 1200 / 630;
	}

	.post__toc {
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-4) var(--space-5);
		margin-bottom: var(--space-8);
		max-width: 80ch;
	}
	.post__toc-title {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		margin-bottom: var(--space-3);
	}
	.post__toc ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-2);
	}
	.post__toc a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.7rem 0.9rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: var(--color-text);
		transition: all var(--dur-fast) var(--ease-out);
	}
	.post__toc a:hover {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		text-decoration: none;
		transform: translateY(-1px);
	}
	.post__toc a strong {
		font-size: 0.9rem;
		color: var(--color-primary-600);
		font-weight: 600;
	}
	.post__toc a span {
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.35;
	}

	.post__body {
		max-width: 75ch;
