---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../../data/site';

const title = 'Аналоги AISI по ГОСТ: таблица марок нержавейки';
const description = 'Аналог AISI 304 по ГОСТ — 08Х18Н10, 316L — 03Х17Н14М3, 321 — 12Х18Н10Т, 430 — 12Х17. Таблица соответствия ГОСТ, AISI, EN, UNS и JIS для 13 марок нержавейки.';

const cover = '/img/blog/analogi-marok-nerzhaveyki.svg?v=2';
const datePublished = '2026-07-17';
const dateModified = '2026-10-06';
const url = `${siteUrl.replace(/\/$/, '')}/blog/analogi-marok-nerzhaveyki/`;

const sections = [
	{
		id: 'tablica',
		anchor: 'Таблица аналогов',
		title: 'Таблица соответствия ГОСТ, AISI, EN, UNS и JIS',
		summary: '13 марок в четырёх системах обозначений.',
	},
	{
		id: 'chto-brat',
		anchor: 'Что брать по ГОСТ',
		title: 'Аналог AISI 304, 316L, 321, 430 и 201 по ГОСТ',
		summary: 'Прямые ответы и чем состав расходится.',
	},
	{
		id: 'kak-chitat',
		anchor: 'Как читать обозначения',
		title: 'Как читать ГОСТ, AISI, UNS, EN и JIS',
		summary: 'Что означают цифры и буквы в марке.',
	},
	{
		id: 'nyuansy',
		anchor: 'Нюансы замены',
		title: 'Когда «аналог» — не полная замена',
		summary: 'L, Ti, допуски по углероду и молибдену.',
	},
	{
		id: 'martensit',
		anchor: 'Мартенситные и жаропрочные',
		title: 'Мартенситные и жаропрочные марки',
		summary: '20Х13, 40Х13, 310S, 904L и их шифры.',
	},
];

const rows = [
	{ aisi: '304', uns: 'S30400', gost: '08Х18Н10', en: '1.4301', jis: 'SUS304', note: 'Универсал, пищёвка, архитектура' },
	{ aisi: '304L', uns: 'S30403', gost: '03Х18Н11', en: '1.4307, 1.4306', jis: 'SUS304L', note: 'Низкоуглеродистый, под сварку' },
	{ aisi: '321', uns: 'S32100', gost: '08Х18Н10Т, 12Х18Н10Т', en: '1.4541', jis: 'SUS321', note: 'Стабилизирован титаном, горячие узлы' },
	{ aisi: '316', uns: 'S31600', gost: 'нет точного (ближе 03Х17Н14М3, но с пониженным углеродом, или 08Х17Н13М2Т, но с титаном)', en: '1.4401', jis: 'SUS316', note: 'С молибденом, хлориды' },
	{ aisi: '316L', uns: 'S31603', gost: '03Х17Н14М3', en: '1.4404 (по составу ГОСТ ближе к 1.4435)', jis: 'SUS316L', note: 'Низкоуглеродистый, фарма, морская атмосфера' },
	{ aisi: '316Ti', uns: 'S31635', gost: '08Х17Н13М2Т, 10Х17Н13М2Т', en: '1.4571', jis: 'SUS316Ti', note: 'Молибден + титан, горячая химия' },
	{ aisi: '430', uns: 'S43000', gost: '12Х17', en: '1.4016', jis: 'SUS430', note: 'Ферритная, без никеля, дешевле' },
	{ aisi: '201', uns: 'S20100', gost: 'нет точного: 12Х15Г9НД (по ТУ, не ГОСТ), из ГОСТ ближе 12Х17Г9АН4', en: '1.4372', jis: 'SUS201', note: 'Марганцевая, экономичный аустенит' },
	{ aisi: '410', uns: 'S41000', gost: '12Х13', en: '1.4006', jis: 'SUS410', note: 'Мартенситная, лопатки, крепёж' },
	{ aisi: '420', uns: 'S42000', gost: '20Х13 / 30Х13 / 40Х13', en: '1.4021 / 1.4028 / 1.4031, 1.4034', jis: 'SUS420J1 (20Х13), SUS420J2 (30Х13)', note: 'Мартенситная, ножи, инструмент' },
	{ aisi: '310S', uns: 'S31008', gost: '10Х23Н18 (в прайсах — 20Х23Н18)', en: '1.4845', jis: 'SUS310S', note: 'Жаропрочная, до +1000 °C' },
	{ aisi: '904L', uns: 'N08904', gost: '06ХН28МДТ (близкий, не идентичный)', en: '1.4539', jis: 'SUS890L', note: 'Супераустенит, кислоты' },
	{ aisi: '2205', uns: 'S32205 (S31803)', gost: '03Х22Н5АМ3', en: '1.4462', jis: 'SUS329J3L', note: 'Дуплекс, прочность + хлориды' },
];

const faq = [
	{
		q: 'Какой аналог AISI 304 по ГОСТ?',
		a: 'Аналог AISI 304 по ГОСТ 5632-2014 — сталь 08Х18Н10, европейский — 1.4301 (X5CrNi18-10), американский номер — UNS S30400, японский — SUS304. Это ближайшие, но не тождественные марки: у 08Х18Н10 углерода до 0,08 %, хрома 17–19 %, никеля 9–11 %, у 304 по ASTM A240 — до 0,07 %, 17,5–19,5 % и 8,0–10,5 %. 12Х18Н10Т аналогом 304 не является: в ней есть титан, и она соответствует AISI 321. Это аустенитная сталь 18/8 (18 % хрома, 8–10 % никеля; что значат <a href="/blog/nerzhaveyushchaya-stal-18-10/">18/8, 18/10 и 18/0</a>). В сертификатах на импортный и отечественный прокат часто указывают оба шифра через дробь.',
	},
	{
		q: 'Чем отличается 12Х18Н10Т от AISI 321?',
		a: 'Это аналоги, но не одна марка. 12Х18Н10Т — обозначение по ГОСТ 5632-2014, AISI 321 — по ASTM A240 (UNS S32100), 1.4541 — по EN 10088. Хрома в них поровну (17–19 %), никеля 9–11 % против 9–12 %, обе стабилизированы титаном и подходят для сварных узлов. Главное отличие — углерод: в 12Х18Н10Т допускается до 0,12 %, в AISI 321 — до 0,08 %. По углероду к 321 ближе 08Х18Н10Т — до 0,08 %. В сертификатах на прокат часто пишут оба обозначения через дробь.',
	},
	{
		q: 'AISI 316 и 316L — это разные марки?',
		a: 'Да. Буква L (low carbon) означает пониженный углерод: у 316L он ≤ 0,03 %, у обычного 316 — до 0,08 %. Низкий углерод предотвращает выпадение карбидов хрома по границам зёрен при сварке и защищает от межкристаллитной коррозии. ГОСТ-аналог 316L — 03Х17Н14М3; точного аналога обычной 316 в ГОСТ 5632-2014 нет: по составу ближе 03Х17Н14М3 (но с пониженным углеродом) и марки с титаном 08Х17Н13М2Т и 10Х17Н13М2Т. Для сварных ответственных конструкций берут именно L-версию.',
	},
	{
		q: 'Можно ли заменить одну марку на аналог напрямую?',
		a: 'Внутри одной пары (AISI 304 — 08Х18Н10 — 1.4301) — да, если плавка укладывается в пределы обоих стандартов: у 304 никеля 8,0–10,5 %, у 08Х18Н10 — 9–11 %, поэтому плавка с никелем 8,0–8,9 % под ГОСТ не подходит. «Похожие» марки заменять напрямую нельзя без проверки: 304 не заменит 316L в хлоридах, 316 не заменит 316L в сварке, обычный 08Х18Н10 не заменит 12Х18Н10Т в горячем узле. Всегда сверяйте химсостав и условия эксплуатации, а не только близость номеров.',
	},
	{
		q: 'Что означают цифры в марке 08Х18Н10?',
		a: 'В российской системе ГОСТ 5632-2014 (п. 4.1) цифры перед буквами — углерод в сотых долях процента, среднее или максимальное содержание: 08 — до 0,08 % C. Затем идёт буква легирующего элемента и его процент: Х18 — около 18 % хрома, Н10 — около 10 % никеля. Т в конце — титан, М — молибден, Г — марганец. То есть 08Х18Н10 читается как «до 0,08 % углерода, около 18 % хрома, около 10 % никеля» — это ближайший аналог AISI 304.',
	},
	{
		q: 'Какой EN и какой ГОСТ у AISI 316L?',
		a: 'У AISI 316L (UNS S31603, JIS SUS316L) в EN 10088 несколько номеров: 1.4404 (X2CrNiMo17-12-2, молибдена 2,0–2,5 %), 1.4432 (X2CrNiMo17-12-3) и 1.4435 (X2CrNiMo18-14-3) — у двух последних молибдена 2,5–3,0 %. Основная пара — 1.4404. Российский аналог — 03Х17Н14М3: никеля 13,5–15,0 % против 10–14 % у 316L по ASTM A240, поэтому по составу она ближе к 1.4435 (никеля 12,5–15 %). Марки 08Х17Н13М2Т и 10Х17Н13М2Т — не 316L, а 316Ti: они стабилизированы титаном.',
	},
	{
		q: 'Какой аналог AISI 430 по ГОСТ?',
		a: 'Сталь 12Х17 по ГОСТ 5632-2014: углерода до 0,12 %, хрома 16–18 %, никель не нормируется (остаточный — до 0,60 %). Это AISI 430 (UNS S43000; по ASTM A240 углерода до 0,12 %, хрома 16–18 %, никеля до 0,75 %), 1.4016 (X6Cr17) по EN 10088 и SUS430 по JIS; европейская 1.4016 строже по углероду — до 0,08 %. Обозначения 08Х17 в ГОСТ 5632-2014 нет, а 08Х17Т — другая марка, стабилизированная титаном.',
	},
	{
		q: 'Какой аналог AISI 201 по ГОСТ?',
		a: 'Точного аналога в ГОСТ 5632-2014 нет. Из марок стандарта по системе хром–марганец–никель с азотом ближе других 12Х17Г9АН4: хрома 16–18 %, никеля 3,5–4,5 %, марганца 8,0–10,5 %, азота 0,15–0,25 %; у AISI 201 по ASTM A240 никеля 3,5–5,5 %, марганца 5,5–7,5 %, то есть марганца в российской марке заметно больше. В торговле 201 обозначают 12Х15Г9НД, но этой марки в ГОСТ 5632-2014 нет — её выпускают по ТУ. Европейский аналог — 1.4372, японский — SUS201, номер UNS — S20100.',
	},
	{
		q: 'Что значат SUS304 и S30400 в таблице аналогов?',
		a: 'S30400 — номер UNS, единой американской системы нумерации: его указывает ASTM A240 рядом с типом стали (Type 304). SUS304 — обозначение по японскому стандарту JIS: марки SUS входят в JIS G 4304 (горячекатаный лист), JIS G 4305 (холоднокатаный лист) и JIS G 4303 (прутки). Оба обозначения относятся к стали, которую в других системах называют AISI 304, 08Х18Н10 и 1.4301, в пределах приблизительного соответствия.',
	},
];

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: `${siteUrl.replace(/\/$/, '')}${cover}`,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	datePublished,
	dateModified,
	author: { '@type': 'Organization', name: siteName, url: siteUrl },
	publisher: {
		'@type': 'Organization',
		name: siteName,
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl.replace(/\/$/, '')}/favicon.svg` },
	},
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
	})),
};
---

<BaseLayout title={title} description={description} image={cover} type="article" jsonLd={[articleJsonLd, faqJsonLd]}>
	<div class="container post">
		<Breadcrumbs items={[
			{ label: 'Главная', href: '/' },
			{ label: 'Блог', href: '/blog/' },
			{ label: 'Аналоги марок нержавейки' },
		]} />

		<header class="post__hero">
			<span class="post__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M4 2v6a4 4 0 0 0 8 0V2M4 2h2v3H4M10 2h2v3h-2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
				</svg>
				Статья · таблица соответствия
			</span>
			<h1 class="post__h1">Аналоги марок нержавейки: таблица AISI, ГОСТ, EN, UNS и JIS</h1>
			<div class="post__meta">
				<time datetime={datePublished}>17 июля 2026</time>
				<span>·</span>
				<span>обновлено <time datetime={dateModified}>6 октября 2026</time></span>
				<span>·</span>
				<span>чтение 11 минут</span>
			</div>
			<p class="post__lead">
				<strong>Прямой ответ:</strong> аналог AISI 304 по ГОСТ 5632-2014 — сталь 08Х18Н10 (EN 1.4301,
				UNS S30400, JIS SUS304). Остальные пары: 316L — 03Х17Н14М3 (EN 1.4404), 321 — 08Х18Н10Т и
				12Х18Н10Т (EN 1.4541), 430 — 12Х17 (EN 1.4016); у 201 в ГОСТ точного аналога нет (EN 1.4372).
				Это аналоги по назначению, а не копии: пределы по углероду, никелю и молибдену расходятся,
				поэтому марку подтверждает сертификат плавки. Ниже — таблица для 13 марок и разбор по каждой.
			</p>
		</header>

		<figure class="post__cover">
			<img
				src={cover}
				alt="Аналоги марок нержавейки — таблица соответствия AISI, ГОСТ и EN"
				width="1200"
				height="630"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<nav class="post__toc" aria-label="Содержание">
			<div class="post__toc-title">На странице</div>
			<ul>
				{sections.map((s) => (
					<li>
						<a href={`#${s.id}`}>
							<strong>{s.anchor}</strong>
							<span>{s.summary}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<article class="post__body">
			<section class="post__section" id="tablica">
				<h2>Таблица соответствия: ГОСТ, AISI, EN, UNS и JIS</h2>
				<p>
					Четыре системы обозначений описывают сходные стали: российская ГОСТ 5632-2014
					(буквенно-цифровой шифр), американская AISI/ASTM с номером UNS, европейская EN 10088
					(номер вида 1.4xxx) и японская JIS (SUS…). В таблице — 13 самых ходовых марок
					нержавеющего проката. Зарубежных обозначений в самом ГОСТ 5632-2014 нет, поэтому пары
					составлены по химическому составу и справочным таблицам производителей Outokumpu и Atlas Steels.
				</p>
				<div class="post__table-wrap">
					<table class="post__table">
						<thead>
							<tr>
								<th scope="col">AISI</th>
								<th scope="col">UNS</th>
								<th scope="col">ГОСТ 5632-2014</th>
								<th scope="col">EN 10088</th>
								<th scope="col">JIS</th>
								<th scope="col">Где применяют</th>
							</tr>
						</thead>
						<tbody>
							{rows.map((r) => (
								<tr>
									<th scope="row">{r.aisi}</th>
									<td>{r.uns}</td>
									<td>{r.gost}</td>
									<td>{r.en}</td>
									<td>{r.jis}</td>
									<td>{r.note}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="post__note">
					Номера UNS — по ASTM A240 и справочникам Outokumpu и Atlas Steels; номера EN 10088 — по справочникам
					Outokumpu, Atlas Steels и ISSF; JIS — по таблицам Outokumpu и Atlas Steels, для 410, 420 и 430 — ещё по
					ISSF (JIS G 4305), для 904L (SUS890L) — по IMOA. Atlas Steels прямо оговаривает, что такие сопоставления приблизительны: у одних пар
					составы почти совпадают, у других заметно расходятся. Точный эквивалент ищут по пределам состава
					в самих стандартах.
				</p>
				<p>
					Карточки самых ходовых марок с прайсом и сортаментом: <a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a>,
					<a href="/list-nerzhaveyushchiy/aisi-316l/"> AISI 316L</a>, <a href="/list-nerzhaveyushchiy/aisi-321/">AISI 321</a>,
					<a href="/list-nerzhaveyushchiy/aisi-430/"> AISI 430</a>, <a href="/list-nerzhaveyushchiy/aisi-201/">AISI 201</a>.
				</p>
			</section>

			<section class="post__section" id="chto-brat">
				<h2>Аналог AISI 304, 316L, 321, 430 и 201 по ГОСТ: что брать</h2>
				<p>
					ГОСТ 5632-2014 и ASTM A240 задают свои пределы состава, поэтому пары совпадают не
					полностью. Ниже для каждой AISI — ближайшая марка ГОСТ и то, чем они расходятся.
				</p>

				<h3>Аналог AISI 304 по ГОСТ — 08Х18Н10</h3>
				<p>
					<strong>AISI 304 соответствует 08Х18Н10</strong> (EN 1.4301, UNS S30400, JIS SUS304). У 08Х18Н10 углерода
					до 0,08 %, хрома 17–19 %, никеля 9–11 %; у 304 по ASTM A240 — до 0,07 %, 17,5–19,5 % и 8,0–10,5 %.
					Плавка 304 с никелем 8,0–8,9 % под 08Х18Н10 не подходит. <strong>12Х18Н10Т — не аналог 304:</strong> в ней
					есть титан (от 5·C до 0,80 %), а углерода допускается до 0,12 %; это ближайший российский аналог AISI 321.
					В справочном листе Outokumpu на 1.4301 встречается ещё 12Х18Н9 (углерод до 0,12 %, никель 8–10 %), но
					она допускает больше углерода, чем 304. Низкоуглеродистой 304L (UNS S30403) соответствует 03Х18Н11:
					углерода до 0,030 %, хрома 17–19 %, никеля 10,5–12,5 %.
				</p>

				<h3>Аналог AISI 316L по ГОСТ — 03Х17Н14М3</h3>
				<p>
					<strong>AISI 316L соответствует 03Х17Н14М3</strong> (UNS S31603, JIS SUS316L). Углерода у обеих до 0,030 %, но в
					российской марке никеля 13,5–15,0 % и молибдена 2,2–2,8 %, а у 316L по ASTM A240 — никеля 10–14 % и
					молибдена 2–3 %. Плавка 316L с никелем ниже 13,5 % под 03Х17Н14М3 не подходит. В EN 10088 у 316L три
					номера: 1.4404 (молибдена 2,0–2,5 %), 1.4432 и 1.4435 (2,5–3,0 %); по никелю 03Х17Н14М3 ближе к 1.4435
					(12,5–15 %). 08Х17Н13М2Т и 10Х17Н13М2Т — не 316L, а 316Ti: они стабилизированы титаном. Подробнее —
					в статье <a href="/blog/aisi-316-i-316l/">AISI 316 и 316L</a>.
				</p>

				<h3>Аналог AISI 321 по ГОСТ — 08Х18Н10Т и 12Х18Н10Т</h3>
				<p>
					<strong>AISI 321 соответствует 08Х18Н10Т и 12Х18Н10Т</strong> (EN 1.4541, UNS S32100, JIS SUS321): обе российские
					марки, как и 321, стабилизированы титаном. По углероду ближе 08Х18Н10Т — до 0,08 %, как у 321; у
					12Х18Н10Т допускается до 0,12 % и больше титана (до 0,80 % против 0,70 %). Никеля в ГОСТ 9–11 %, в
					ASTM A240 — 9–12 %. Outokumpu в таблице национальных обозначений называет для 1.4541 именно 08Х18Н10Т,
					а на российском рынке чаще встречается 12Х18Н10Т. Подробнее — в статьях
					<a href="/blog/stal-12h18n10t/">про 12Х18Н10Т</a> и <a href="/blog/stal-08h18n10/">про 08Х18Н10</a>.
				</p>

				<h3>Аналог AISI 430 по ГОСТ — 12Х17</h3>
				<p>
					<strong>AISI 430 соответствует 12Х17</strong> (EN 1.4016, UNS S43000, JIS SUS430). Углерода до 0,12 % и хрома
					16–18 % у обеих; никель в 12Х17 не нормируется (остаточный до 0,60 %), в 430 — до 0,75 %. Европейская 1.4016
					строже по углероду — до 0,08 %. Обозначения 08Х17 из прайсов в ГОСТ 5632-2014 нет, а 08Х17Т — другая сталь,
					стабилизированная титаном. Подробнее — в статье <a href="/blog/aisi-430-harakteristiki/">AISI 430</a>.
				</p>

				<h3>Аналог AISI 201 по ГОСТ — точного нет</h3>
				<p>
					<strong>У AISI 201 в ГОСТ 5632-2014 точного аналога нет</strong> (EN 1.4372, UNS S20100, JIS SUS201). Из марок стандарта по системе хром–марганец–никель с азотом ближе других
					12Х17Г9АН4: хрома 16–18 %, никеля 3,5–4,5 %, марганца 8,0–10,5 %, азота 0,15–0,25 %; у 201 по ASTM A240
					никеля 3,5–5,5 % и марганца 5,5–7,5 %, то есть марганца в российской марке заметно больше. В торговле 201
					обозначают 12Х15Г9НД, но этой марки в ГОСТ 5632-2014 нет: её выпускают по ТУ. Подробнее — в статье
					<a href="/blog/aisi-201-harakteristiki/">AISI 201</a>.
				</p>
			</section>

			<section class="post__section" id="kak-chitat">
				<h2>Как читать ГОСТ, AISI, UNS, EN и JIS</h2>
				<p>
					<strong>ГОСТ 5632.</strong> Шифр расшифровывается по составу (ГОСТ 5632-2014, п. 4.1): цифры перед
					буквами — углерод в сотых долях процента, среднее или максимальное содержание; буквы — легирующие
					элементы; цифры после букв — их содержание в целых процентах. Пример: <strong>12Х18Н10Т</strong> — до 0,12 %
					углерода (C), около 18 % хрома (Х), около 10 % никеля (Н), титан (Т). Буквы: Х — хром, Н — никель,
					М — молибден, Т — титан, Г — марганец, С — кремний, Д — медь, Б — ниобий, А внутри марки — азот.
				</p>
				<p>
					<strong>AISI и UNS.</strong> Трёхзначный номер AISI: серия 3xx — аустенитные хромоникелевые
					(304, 316, 321), 2xx — хромомарганцевые аустенитные (201), 4xx — ферритные и
					мартенситные (430, 410, 420). Буква L — низкий углерод, Ti — стабилизация титаном,
					H — повышенный углерод для жаропрочности. В ASTM A240 рядом с типом стали (Type 304) указан номер
					UNS — буква и пять цифр (S30400, N08904).
				</p>
				<p>
					<strong>EN 10088.</strong> Номер вида <strong>1.4301</strong> по EN 10027-2: «1» — сталь, «43» — группа
					(для 1.43xx — нержавеющие стали с никелем не менее 2,5 % без молибдена, ниобия и титана), «01» — порядковый номер
					марки. Параллельно существует буквенное имя (X5CrNi18-10 — то же 304).
				</p>
				<p>
					<strong>JIS.</strong> Японские нержавеющие марки обозначают SUS и номером: SUS304, SUS316L, SUS430. Их
					описывают JIS G 4304 (горячекатаный лист), JIS G 4305 (холоднокатаный лист) и JIS G 4303 (прутки).
				</p>
			</section>

			<section class="post__section" id="nyuansy">
				<h2>Когда «аналог» — не полная замена</h2>
				<p>
					Пара внутри одной марки (304 — 08Х18Н10 — 1.4301) — это один класс стали, но пределы состава
					у стандартов не совпадают: у 304 никеля 8,0–10,5 %, у 08Х18Н10 — 9–11 %. А близкие по номеру
					марки не взаимозаменяемы совсем:
				</p>
				<ul>
					<li>
						<strong>304 vs 304L.</strong> Разница — в углероде: по ASTM A240 до 0,07 % у 304 (в 08Х18Н10 по ГОСТ —
						до 0,08 %) и до 0,030 % у 304L (03Х18Н11). Для сварных сечений толще примерно 5 мм берут L-версию
						(Atlas Steels), иначе возможна межкристаллитная коррозия.
					</li>
					<li>
						<strong>316 vs 316L.</strong> То же самое: L — под сварку. Аналог 316L по ГОСТ 5632-2014 —
						03Х17Н14М3; у обычной 316 точного аналога нет (близкие — 03Х17Н14М3 с пониженным углеродом и 08Х17Н13М2Т, 10Х17Н13М2Т с титаном).
					</li>
					<li>
						<strong>304 vs 321.</strong> 321 (12Х18Н10Т) стабилизирована титаном для горячих
						узлов — 08Х18Н10 её не заменит там, где идёт нагрев 450–850 °C.
					</li>
					<li>
						<strong>304 vs 316L.</strong> Разница в молибдене: в хлоридах и морской воде
						304 даёт питтинг, нужен 316L. Подробнее —
						<a href="/blog/aisi-304-vs-316l-vs-321/"> сравнение 304, 316L и 321</a>.
					</li>
				</ul>
				<p>
					<strong>Обозначения из прайсов, которых нет в ГОСТ 5632-2014.</strong> Марки 08Х17, 03Х17Н14М2,
					03Х17Н13М2, 03Х18Н10 и 12Х15Г9НД в таблице стандарта не встречаются: это торговые обозначения или
					марки по ТУ. В заказе указывайте пару «AISI + ГОСТ»: например, AISI 430 (12Х17) или AISI 316L (03Х17Н14М3).
				</p>
				<p>
					Вывод: подбирая аналог, сверяйте не номер, а химсостав и условия эксплуатации.
					Таблица даёт точку старта, финальное решение — по сертификату плавки. Аналог под вашу
					спецификацию или чертёж подбирают в услуге <a href="/uslugi/podbor-metalla/">подбор металла</a>.
				</p>
			</section>

			<section class="post__section" id="martensit">
				<h2>Мартенситные и жаропрочные марки</h2>
				<p>
					Отдельный частый запрос — аналоги мартенситных «ножевых» и жаропрочных сталей:
				</p>
				<ul>
					<li>
						<strong>20Х13 / 30Х13 / 40Х13</strong> — мартенситные хромистые, семейство
						AISI 420. Пары идут по углероду: 20Х13 (0,16–0,25 %) — EN 1.4021 и JIS SUS420J1; 30Х13 (0,26–0,35 %) —
						EN 1.4028 и JIS SUS420J2; 40Х13 (0,36–0,45 %) — EN 1.4031 и 1.4034. Различаются углеродом и твёрдостью
						после закалки. Разбор — в статье
						<a href="/blog/martensitnaya-stal-20h13-40h13/"> 20Х13, 30Х13, 40Х13</a>.
					</li>
					<li><strong>12Х13</strong> — AISI 410, EN 1.4006, JIS SUS410. Менее твёрдая (углерода 0,09–0,15 %), крепёж и лопатки.</li>
					<li>
						<strong>10Х23Н18 и 20Х23Н18</strong> — ближайшие марки ГОСТ к AISI 310S (EN 1.4845). Это разные стали: углерода до 0,10 %
						и до 0,20 % против 0,08 % у 310S. Outokumpu указывает для 1.4845 именно 10Х23Н18, в прайсах чаще
						встречается 20Х23Н18. Жаропрочные аустенитные: ГОСТ 5632-2014 рекомендует их до +1000 °C при длительной работе.
					</li>
					<li><strong>06ХН28МДТ</strong> — ближайший аналог AISI 904L (EN 1.4539), но не идентичный: молибдена меньше (2,5–3 % против 4–5 %), меди больше. Супераустенит для кислот. JIS — SUS890L (UNS N08904, EN 1.4539).</li>
				</ul>
				<p>
					Мартенситные марки берём под ножи и инструмент (<a href="/krug-nerzhaveyushchiy/aisi-420/">круг AISI 420</a>),
					жаропрочные — под печную оснастку и обжиг. Полный сортамент — в каталогах
					<a href="/list-nerzhaveyushchiy/">листа</a>, <a href="/krug-nerzhaveyushchiy/">круга</a> и <a href="/truba-nerzhaveyushchaya/">трубы</a>,
					стандарты — в <a href="/gost/">справочнике ГОСТов</a>.
				</p>
			</section>

