---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'vidy', anchor: 'Какие бывают заглушки', summary: 'Торец трубы, трубопровод, отверстие: тип, крепление, стандарт' },
	{ id: 'torec', anchor: 'Заглушки для торца трубы', summary: 'Внешние, внутренние, сварные; что есть в каталоге' },
	{ id: 'razmer', anchor: 'Как подобрать по размеру', summary: 'Ø внутр = D − 2s, допуски ГОСТ 11068-81, дюймы' },
	{ id: 'truboprovod', anchor: 'Заглушки трубопроводов', summary: 'Эллиптические ГОСТ 17379-2001, фланцевые, ASTM A403' },
	{ id: 'marka', anchor: 'Марка и поверхность', summary: '304, 316L, 201; одна марка с трубой; санитарные линии' },
	{ id: 'montazh', anchor: 'Как закрепить', summary: 'Посадка, клей, сварка, шов, щели и коррозия' },
	{ id: 'katalog', anchor: 'Что есть у нас', summary: '39 позиций заглушек из AISI 304, Ø12–50,8 и 40 × 40' },
];

const faq = [
	{
		q: 'Какие бывают заглушки из нержавейки?',
		a: 'Три группы. Для торца трубы поручня, стойки и мебели: внешние (надеваются), внутренние (вставляются, штампованные и литые), плоские и сферические сварные. Для трубопроводов: приварные эллиптические по ГОСТ 17379-2001, плоские и фланцевые (глухие фланцы по ГОСТ 33259-2015, заглушки по АТК 24.200.02-90). Для отверстий в листе и профиле: пробки и колпачки по чертежу. Запрос «заглушка нержавеющая» может означать любую из групп, поэтому начинайте с того, что закрываете: торец трубы, конец трассы или отверстие.',
	},
	{
		q: 'Как подобрать заглушку на трубу?',
		a: 'Определите, внутренняя она или внешняя. У внешней важен наружный диаметр трубы: 12, 16, 25,4, 38,1, 42,4 или 50,8 мм. У внутренней — внутренний диаметр: D − 2 × s. Для трубы 38 × 1,5 это 35 мм, для 50,8 × 1,5 — 47,8 мм. Дальше проверьте допуски: у электросварной трубы по ГОСТ 11068-81 внутренний диаметр «гуляет» на 1,5–1,8 мм, а внутренний грат шва допускается до 0,7 мм. Дюймовые 38,1 и 50,8 мм и метрические 38 и 42,4 мм заглушками друг друга не заменяют.',
	},
	{
		q: 'Чем отличается внешняя заглушка от внутренней?',
		a: 'Внешняя надевается на торец и закрывает его снаружи: срез трубы не виден, диаметр заглушки чуть больше трубы. Внутренняя вставляется внутрь трубы и держится на ребристой посадке или клее: наружу выходит только «шляпка», поэтому узел выглядит аккуратнее, но размер зависит от стенки трубы. Внешняя не боится разной стенки, внутренняя подбирается по внутреннему диаметру. Есть и вариант «внешняя с винтом»: она дополнительно фиксируется винтом.',
	},
	{
		q: 'Какой ГОСТ на приварные заглушки?',
		a: 'ГОСТ 17379-2001: бесшовные приварные эллиптические заглушки. Название стандарта — «из углеродистой и низколегированной стали», требования к деталям даёт ГОСТ 17380. Для нержавеющей стали отдельного ГОСТ на такие заглушки мы не нашли: их делают с размерами по ГОСТ 17379 по ТУ изготовителя либо по ASTM A403 и ASME B16.9. Фланцевые заглушки: глухие фланцы по ГОСТ 33259-2015, заглушки по АТК 24.200.02-90. Марку, Ду, стенку и стандарт всегда указывают в заказе.',
	},
	{
		q: 'Из какой нержавейки лучше заглушка?',
		a: 'Из той же марки, что и труба. Для помещений и улицы без хлоридов — AISI 304 (08Х18Н10). На побережье, у дорог с реагентами и на пищевых линиях с хлоридами — 316L (03Х17Н14М3). AISI 201 годится для сухих помещений. Гальванической пары между разными нержавеющими сталями нет: потенциалы у них одинаковые (Euro Inox). Но деталь из слабой марки заржавеет первой и испортит вид узла.',
	},
	{
		q: 'Как закрепить заглушку на трубе поручня?',
		a: 'Внутреннюю с ребристой посадкой забивают в торец резиновым молотком до упора, при необходимости фиксируют клеем. Внешнюю надевают и фиксируют клеем или винтом. Сварную плоскую или сферическую приваривают по контуру (TIG), шов шлифуют и полируют, затем снимают побежалость. Торец трубы до установки зачищают от заусенцев: ГОСТ 11068-81 (п. 2.5) требует, чтобы концы труб были обрезаны под прямым углом и зачищены. Щель между заглушкой и трубой не оставляют открытой: в ней задерживается влага.',
	},
];

const sources = [
	{ label: 'ГОСТ 17379-2001 (ИСО 3419-81) «Детали трубопроводов бесшовные приварные из углеродистой и низколегированной стали. Заглушки эллиптические. Конструкция»: введён 01.01.2003 взамен ГОСТ 17379-83; табл. 1 (исполнение 1, ИСО) и табл. 2 (исполнение 2); технические требования — по ГОСТ 17380', href: 'https://meganorm.ru/Index2/1/4294846/4294846096.htm' },
	{ label: 'ГОСТ 33259-2015 «Фланцы арматуры, соединительных частей и трубопроводов на номинальное давление до PN 250. Конструкция, размеры и общие технические требования» (с 01.04.2016, взамен ГОСТ 12815-80 – 12822-80, в том числе ГОСТ 12820-80)', href: 'https://files.stroyinf.ru/Data2/1/4293762/4293762130.pdf' },
	{ label: 'ГОСТ 12820-80 «Фланцы стальные плоские приварные на Ру от 0,1 до 2,5 МПа» — плоские приварные фланцы, не заглушки; справочная карточка и PDF', href: '/gost/12820-80/' },
	{ label: 'АТК 24.200.02-90 «Заглушки фланцевые» — стандарт на заглушки между фланцами: цельный диск без центрального отверстия, несколько исполнений (по каталогам изготовителей)', href: 'https://onyxspb.ru/catalog/zaglushki/' },
	{ label: 'ГОСТ 11068-81 «Трубы электросварные из коррозионно-стойкой стали»: п. 1.4 и табл. 2 (допуски по наружному диаметру и стенке), п. 2.4 (внутренний грат до 0,7 мм, по требованию до 0,3 мм), п. 2.5 (концы труб без заусенцев)', href: 'http://docs.cntd.ru/document/1200008436' },
	{ label: 'ГОСТ 25772-2025 «Ограждения металлические лестниц, балконов, крыш, лестничных маршей и площадок. Общие технические условия»: п. 5.2.14 (швы по ГОСТ 23118), п. 5.2.15 (нет заусенцев, окалины и ржавчины); требований к заглушкам в стандарте нет', href: 'https://meganorm.ru/mega_doc/norm_update_01122025/gost_gosudarstvennyj-standart/0/gost_25772-2025_mezhgosudarstvennyy_standart_ograzhdeniya.html' },
	{ label: 'ASTM A403/A403M — Wrought Austenitic Stainless Steel Piping Fittings: фитинги для напорных трубопроводов, марки WP304, WP316L и другие; размеры по ASME B16.9', href: 'https://store.astm.org/a0403_a0403m-22b.html' },
	{ label: 'ASTM A815/A815M — Wrought Ferritic, Ferritic/Austenitic, and Martensitic Stainless Steel Piping Fittings: фитинги из ферритных, дуплексных и мартенситных сталей', href: 'https://store.astm.org/a0815_a0815m-24.html' },
	{ label: 'ASME B16.9 — Factory-Made Wrought Buttwelding Fittings: размеры приварных фитингов, в том числе заглушек (caps)' },
	{ label: 'Euro Inox — Stainless Steel in Contact with Other Metallic Materials (Materials and Applications Series, Vol. 10): три условия гальванической коррозии, одинаковый потенциал разных нержавеющих сталей, постоянно влажные щели', href: 'https://worldstainless.org/wp-content/uploads/2025/02/Contact_with_Other_EN.pdf' },
	{ label: 'IMOA — Which Stainless Steel Should Be Specified for Exterior Applications?: выбор 304 и 316 по среде, шероховатость поверхности', href: 'https://www.imoa.info/download_files/stainless-steel/folder_which_stainless_steel_EN.pdf' },
	{ label: 'Euro Inox — Cleaning Architectural Stainless Steel (Building Series, Vol. 15): Ra не более 0,5 мкм для труб поручней, побежалость после сварки', href: 'https://www.imoa.info/download_files/stainless-steel/euroinox/Cleaning.pdf' },
	{ label: 'ISSF — New 200-series steels: An opportunity or a threat to the image of stainless steel?, 2005: серия 200 в помещениях и на улице', href: 'https://www.centroinox.it/sites/default/files/monografia_pdf/200_series_stainless_steels.pdf' },
	{ label: 'Highco Metal — Stainless Steel Tube Cap Self Grip: заглушка Ø50,8 мм с ребристым воротником, посадка резиновым молотком без клея и сварки; AISI 304, 316, сатин и зеркало', href: 'https://www.highcorailing.com/handrail-fittings/stainless-steel-tube-cap/' },
	{ label: 'DIN 11851 — Blank Caps (Glacier Tanks): заглушки молочных соединений, соединение по DIN 11851 к трубам по DIN 11850; 304 и 316', href: 'https://www.glaciertanks.com/fittings/din-11851-fittings/blank-caps.html' },
	{ label: 'Прайс-лист ГК Металлинвест: раздел «Детали трубопровода и ограждения», подгруппа «Заглушки» — типы, диаметры, марка, поверхность', href: 'https://gkmetallinvest.ru/detali-truboprovoda/' },
];

const related = [
	{ label: 'Перила и ограждения из нержавеющей стали', href: '/blog/perila-i-ograzhdeniya-iz-nerzhaveyki/' },
	{ label: 'Нержавеющая труба: бесшовная, сварная, профильная', href: '/blog/kak-vybrat-nerzhaveyushchuyu-trubu/' },
	{ label: 'Питтинговая коррозия нержавеющей стали', href: '/blog/pittingovaya-korroziya/' },
	{ label: 'AISI 304, 316L и 321: чем отличаются', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'Детали трубопровода и ограждения: прайс', href: '/detali-truboprovoda/' },
	{ label: 'Труба нержавеющая: прайс', href: '/truba-nerzhaveyushchaya/' },
	{ label: 'Фланцы из нержавейки: типы, ГОСТ 33259, вес', href: '/blog/flantsy-nerzhaveyushchie/' },
	{ label: 'Отводы, тройники и переходы из нержавейки', href: '/blog/otvody-troyniki-perehody-nerzhaveyushchie/' },
];
---

<BlogArticle
	slug="zaglushki-iz-nerzhaveyushchey-stali"
	title="Заглушка из нержавеющей стали: типы, размеры, выбор"
	description="Заглушка из нержавеющей стали: типы для торца трубы, поручней и трубопроводов, подбор по диаметру и стенке, марка 304 или 316L, ГОСТ 17379 и 33259."
	h1="Заглушка из нержавеющей стали: какие бывают, как подобрать по размеру и закрепить"
	eyebrow="Справочник"
	datePublished="2026-10-06"
	dateModified="2026-10-06"
	readingMin={9}
	answer="<strong>Заглушка из нержавеющей стали закрывает торец трубы или конец трубопровода. Запрос неоднозначный: чаще всего ищут декоративные заглушки для поручней, стоек и мебельных труб (внешние, внутренние, сварные), но есть и заглушки трубопроводов — приварные эллиптические и фланцевые.</strong> Внешнюю заглушку подбирают по наружному диаметру трубы, внутреннюю — по внутреннему: D − 2 × s. Для приварных эллиптических заглушек действует ГОСТ 17379-2001, но он написан для углеродистой и низколегированной стали. Марку берут ту же, что у трубы: AISI 304 для помещений и улицы без хлоридов, 316L для побережья и реагентов."
	keyFacts={[
		'Три группы: торцевые заглушки для труб поручней и мебели; заглушки трубопроводов (эллиптические, фланцевые); пробки отверстий',
		'Внутренний диаметр трубы: D − 2 × s. Труба 38 × 1,5 — 35 мм; 50,8 × 1,5 — 47,8 мм; по допускам ГОСТ 11068-81 разброс 1,5–1,8 мм',
		'ГОСТ 17379-2001 — эллиптические заглушки из углеродистой и низколегированной стали (исполнение 1 по ИСО 3419, Dн 21,3–323,9 мм до Ду 300); для нержавейки — ТУ или ASTM A403 / ASME B16.9',
		'ГОСТ 33259-2015 заменил ГОСТ 12820-80; плоские приварные фланцы — не заглушки, для заглушек берут глухие фланцы или АТК 24.200.02-90',
		'В нашем прайсе 39 позиций заглушек из AISI 304 Ø12–50,8 мм и 40 × 40 мм; приварных эллиптических в прайсе нет',
	]}
	coverAlt="Заглушка из нержавеющей стали: внешние, внутренние и сварные заглушки для труб поручней, эллиптические заглушки трубопроводов"
