---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sostav', anchor: 'Класс и химический состав', summary: 'ГОСТ 5632-2014: C 0,36–0,45 %, Cr 12–14 %' },
	{ id: 'analogi', anchor: 'Аналоги AISI 420, 1.4031, 1.4034', summary: 'Почему аналог приблизительный' },
	{ id: 'svoystva', anchor: 'Твёрдость и механика', summary: 'HB в поставке, HRC после закалки' },
	{ id: 'termoobrabotka', anchor: 'Термообработка', summary: 'Отжиг, закалка, низкий отпуск' },
	{ id: 'korroziya', anchor: 'Коррозионная стойкость', summary: 'Какие среды держит и какие нет' },
	{ id: 'primenenie', anchor: 'Применение и ножи', summary: 'Инструмент, пружины, валы, ножи' },
	{ id: 'obrabotka', anchor: 'Сварка и обработка', summary: 'Подогрев, отжиг, резание' },
	{ id: 'sortament', anchor: 'Сортамент и стандарты', summary: 'Круг, лист, проволока по ГОСТ' },
];

const faq = [
	{
		q: 'Что за сталь 40Х13?',
		a: 'Хромистая нержавеющая сталь мартенситного класса по ГОСТ 5632-2014, порядковый номер марки 1-18. В ней 0,36–0,45 % углерода и 12–14 % хрома, никелем она не легирована. По назначению стандарт относит её только к коррозионно-стойким сталям. Применяют 40Х13 после закалки и низкого отпуска — для режущего, мерительного и хирургического инструмента, пружин, клапанных пластин компрессоров.',
	},
	{
		q: 'Какой аналог у стали 40Х13?',
		a: 'Точного аналога нет, есть близкие марки. В EN 10088 это 1.4031 (X39Cr13, C 0,36–0,42 %) и 1.4034 (X46Cr13, C 0,43–0,50 %), хрома в обеих 12,5–14,5 %. В США — AISI 420, но ASTM A276 задаёт для неё только нижний предел углерода 0,15 %, поэтому под 40Х13 подходит лишь высокоуглеродистый вариант, который производители называют 420HC. Японская SUS420J2 (C 0,26–0,40 %) по углероду ближе к 30Х13. Если нужен именно уровень 40Х13, углерод указывают в заказе.',
	},
	{
		q: 'Какая твёрдость у стали 40Х13?',
		a: 'Круг в состоянии поставки (отжиг или отпуск) по ГОСТ 5949-2018 — 143–229 HB. После закалки с 1000–1050 °C в масле и отпуска при 200–300 °C стандарт требует не менее 50 HRC. Марочник сталей и сплавов даёт после закалки и отпуска 460–550 HB, это примерно 48–55 HRC по таблицам ASTM E140.',
	},
	{
		q: 'Подходит ли 40Х13 для ножей?',
		a: 'Да, режущий инструмент — основное назначение марки по ГОСТ 5632-2014. После закалки и низкого отпуска клинок набирает от 50 HRC. Коррозионная стойкость умеренная: она максимальна на закалённой и полированной поверхности, а остатки пищи на клинке могут вызвать точечную коррозию. Если нужна твёрдость от 55 HRC и больше хрома, берут 95Х18: по ГОСТ в ней 0,90–1,00 % углерода и 17–19 % хрома.',
	},
	{
		q: 'Магнитится ли сталь 40Х13?',
		a: 'Да, и в отожжённом, и в закалённом состоянии: структура стали ферромагнитна. Поэтому магнитом 40Х13 не отличить от 20Х13, 12Х13 или AISI 430. Марку подтверждают сертификатом с анализом плавки или спектральным анализом.',
	},
	{
		q: 'Можно ли сваривать 40Х13?',
		a: 'Марочник сталей и сплавов указывает, что для сварных конструкций 40Х13 не применяется. Сталь закаливается на воздухе, и зона сварки становится хрупкой. Если сварка всё же нужна, американские данные для AISI 420 рекомендуют подогрев 150–320 °C и отжиг или высокий отпуск после сварки, присадку 420 для прочного шва или 309 для пластичного.',
	},
	{
		q: 'Какая плотность у стали 40Х13?',
		a: 'По марочнику сталей и сплавов — 7650 кг/м³ (7,65 г/см³) при 20 °C. Европейские данные для 1.4031 и 1.4034 дают 7,7 г/см³. При 7,65 г/см³ лист толщиной 1 мм весит 7,65 кг на квадратный метр, круг диаметром 20 мм — 2,40 кг на метр.',
	},
];

const sources = [
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1 (марка 1-18), пп. 6.4–6.6, приложение А, табл. А.1', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5949-2018 — металлопродукция из сталей нержавеющих и сплавов на железоникелевой основе: разд. 6, п. 7.1.5, табл. 1 и 2, п. 7.1.7', href: 'https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/1/gost_5949-2018_mezhgosudarstvennyy_standart.html' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, жаростойкий и жаропрочный, п. 2.1, п. 3.1, табл. 1', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная, п. 3.1 (перечень марок)', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'Марочник сталей и сплавов — 40Х13: физические свойства, критические точки, твёрдость, свариваемость, применение', href: 'http://www.splav-kharkov.com/mat_start.php?name_id=56' },
	{ label: 'SteelNumber — X39Cr13 (1.4031) по EN 10088-2 и EN 10088-3', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=83' },
	{ label: 'SteelNumber — X46Cr13 (1.4034) по EN 10088-2 и EN 10088-3', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=84' },
	{ label: 'SteelJIS — SUS420J2 по JIS G4303: состав и механические свойства', href: 'http://steeljis.com/jis_steel_datasheet.php?name_id=114' },
	{ label: 'ASTM A276 — Type 420: состав, твёрдость в отожжённом состоянии, проверка закаливаемости (сводка Boltport)', href: 'https://boltport.com/specifications/astm-a276/' },
	{ label: 'Carpenter Technology — CarTech 420 Stainless: термообработка, коррозия, сварка, обрабатываемость', href: 'https://www.carpentertechnology.com/hubfs/7407324/Material%20Saftey%20Data%20Sheets/420.pdf' },
	{ label: 'Ulbrich — 420 High Carbon Stainless Steel (420HC), UNS S42000: состав и твёрдость ленты', href: 'https://d2ykdomew87jzd.cloudfront.net/data-sheets/420HC-Stainless-Steel_Ulbrich-Wire-Revision-09.01.2018.pdf' },
	{ label: 'AZoM — Stainless Steel Grade 420 (UNS S42000): коррозия, термообработка, сварка', href: 'https://www.azom.com/article.aspx?ArticleID=972' },
	{ label: 'Continental Steel — Stainless Steel Alloy 420: применение', href: 'https://continentalsteel.com/stainless-steel/grades/alloy-420/' },
	{ label: 'ASTM E140 — таблицы перевода твёрдости HB ↔ HRC' },
];

const related = [
	{ label: 'Сталь 20Х13, 30Х13, 40Х13: мартенситная нержавейка', href: '/blog/martensitnaya-stal-20h13-40h13/' },
	{ label: 'Сталь 12Х13: состав, свойства, аналог AISI 410', href: '/blog/stal-12h13/' },
	{ label: 'Твёрдость нержавеющей стали: HB и HRC по маркам', href: '/blog/tverdost-nerzhaveyushchey-stali/' },
	{ label: 'Магнитится ли нержавейка', href: '/blog/magnitit-li-nerzhaveika/' },
	{ label: 'Круг AISI 420 (20Х13, 30Х13, 40Х13)', href: '/krug-nerzhaveyushchiy/aisi-420/' },
	{ label: 'Аналоги марок нержавейки: AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
];
---

<BlogArticle
	slug="stal-40h13"
	title="Сталь 40Х13: характеристики, аналог и твёрдость"
	description="Сталь 40Х13 по ГОСТ 5632-2014: состав, аналоги AISI 420 и 1.4031, твёрдость от 50 HRC после закалки, термообработка, коррозия, ножи и сортамент."
	h1="Сталь 40Х13: характеристики, аналоги, твёрдость и применение"
	eyebrow="Справочник"
	datePublished="2026-09-29"
	dateModified="2026-09-29"
	readingMin={12}
	answer="<strong>Сталь 40Х13 — хромистая нержавеющая сталь мартенситного класса: по ГОСТ 5632-2014 в ней 0,36–0,45 % углерода и 12–14 % хрома, никелем она не легирована.</strong> Это самая углеродистая марка группы 20Х13–40Х13: после закалки с 1000–1050 °C в масле и отпуска при 200–300 °C ГОСТ 5949-2018 требует не менее 50 HRC. Ближайшие аналоги — AISI 420 с повышенным углеродом (420HC), 1.4031 и 1.4034 по EN 10088, но полного совпадения по составу нет. Сталь магнитится, для сварных конструкций не применяется, а наибольшую коррозионную стойкость имеет в закалённом и полированном виде."
	keyFacts={[
		'Состав по ГОСТ 5632-2014: C 0,36–0,45 %, Cr 12–14 %, Si и Mn ≤ 0,80 %, S ≤ 0,025 %, P ≤ 0,030 %',
		'Круг, ГОСТ 5949-2018: 143–229 HB в поставке; после закалки 1000–1050 °C в масле и отпуска 200–300 °C — не менее 50 HRC',
		'Тонкий лист, ГОСТ 5582-75: σв ≥ 550 МПа, δ5 ≥ 15 % после отжига или отпуска 740–800 °C',
		'Плотность 7,65 г/см³, магнитится в любом состоянии, для сварных конструкций не применяется',
		'Назначение по ГОСТ: режущий, мерительный и хирургический инструмент, пружины, клапанные пластины компрессоров',
	]}
	coverAlt="Сталь 40Х13: химический состав по ГОСТ 5632-2014, твёрдость после закалки и аналог AISI 420"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['40Х13', 'AISI 420', 'Мартенситная нержавеющая сталь', 'ГОСТ 5632-2014', 'ГОСТ 5949-2018']}
	cta={{ title: 'Нужен круг 40Х13?', text: 'Поставляем круг 40Х13 — пришлите диаметр, длину, состояние поставки и объём для расчёта. Отгружаем с сертификатом завода-изготовителя.' }}
>
	<section id="sostav">
		<h2>Класс и химический состав 40Х13</h2>
		<p>
			Марка читается так: 40 — около 0,40 % углерода (по стандарту 0,36–0,45 %), Х13 — около 13 % хрома.
			Прежнее обозначение — 4Х13. ГОСТ 5632-2014 относит 40Х13 к мартенситному классу, порядковый номер
			марки 1-18. По назначению это только коррозионно-стойкая сталь: в графах «жаростойкая» и «жаропрочная»
			таблицы 1 у неё прочерк. У 12Х13 и 20Х13 стандарт допускает и применение как жаропрочных.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав 40Х13 по ГОСТ 5632-2014, %</caption>
				<thead>
					<tr><th>Элемент</th><th>Массовая доля</th><th>Пункт стандарта</th></tr>
				</thead>
				<tbody>
					<tr><td>Углерод C</td><td>0,36–0,45</td><td>табл. 1</td></tr>
					<tr><td>Хром Cr</td><td>12,00–14,00</td><td>табл. 1</td></tr>
					<tr><td>Кремний Si</td><td>не более 0,80</td><td>табл. 1</td></tr>
					<tr><td>Марганец Mn</td><td>не более 0,80</td><td>табл. 1</td></tr>
					<tr><td>Сера S</td><td>не более 0,025</td><td>табл. 1</td></tr>
					<tr><td>Фосфор P</td><td>не более 0,030</td><td>табл. 1</td></tr>
					<tr><td>Никель Ni, остаточный</td><td>не более 0,60</td><td>п. 6.5</td></tr>
					<tr><td>Медь Cu, остаточная</td><td>не более 0,30</td><td>п. 6.4</td></tr>
					<tr><td>Вольфрам W и ванадий V, остаточные</td><td>не более 0,20 каждого</td><td>п. 6.6</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Марочник сталей и сплавов до сих пор приводит состав по ГОСТ 5632-72: углерод 0,35–0,44 %, кремний и
			марганец — до 0,60 %. Если сертификат ссылается на старую редакцию, пределы по этим элементам в нём
			другие — сверяйте, по какому стандарту указан анализ плавки. Чем 40Х13 отличается от 20Х13 и 30Х13 и что общего у мартенситных сталей —
			в статье о <a href="/blog/martensitnaya-stal-20h13-40h13/">сталях 20Х13, 30Х13 и 40Х13</a>.
		</p>
	</section>

	<section id="analogi">
		<h2>Аналоги: AISI 420, 1.4031, 1.4034 и SUS420J2</h2>
		<p>
			Марочник сталей и сплавов называет для 40Х13 зарубежные аналоги, но оговаривает, что среди них есть и
			точные, и ближайшие. Сравнение по стандартам показывает: полного совпадения нет ни с одной маркой.
		</p>
		<div class="ba-table">
			<table>
				<caption>40Х13 и зарубежные аналоги: состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка, стандарт</th><th>C</th><th>Cr</th><th>Si / Mn</th><th>S</th><th>P</th></tr>
				</thead>
				<tbody>
					<tr><td>40Х13 — ГОСТ 5632-2014</td><td>0,36–0,45</td><td>12,0–14,0</td><td>0,80 / 0,80</td><td>0,025</td><td>0,030</td></tr>
					<tr><td>1.4031 (X39Cr13) — EN 10088-2</td><td>0,36–0,42</td><td>12,5–14,5</td><td>1,00 / 1,00</td><td>0,015</td><td>0,040</td></tr>
					<tr><td>1.4034 (X46Cr13) — EN 10088-2</td><td>0,43–0,50</td><td>12,5–14,5</td><td>1,00 / 1,00</td><td>0,015</td><td>0,040</td></tr>
					<tr><td>AISI 420 — ASTM A276</td><td>не менее 0,15</td><td>12,0–14,0</td><td>1,00 / 1,00</td><td>0,030</td><td>0,040</td></tr>
					<tr><td>420HC — данные Ulbrich, типичный</td><td>0,40–0,45</td><td>12,5–13,5</td><td>0,25–0,75 / 1,0</td><td>0,015</td><td>0,04</td></tr>
					<tr><td>SUS420J2 — JIS G4303</td><td>0,26–0,40</td><td>12,0–14,0</td><td>1,00 / 1,00</td><td>0,030</td><td>0,040</td></tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>AISI 420.</strong> ASTM A276 задаёт только нижний предел углерода — 0,15 %. Под это обозначение попадает и металл с 0,2 % углерода, то есть уровня 20Х13. Высокоуглеродистый вариант производители выпускают под названием 420HC: у Ulbrich это та же UNS S42000 с типичным составом 0,40–0,45 % углерода. Отдельной марки 420HC в ASTM нет.</li>
			<li><strong>1.4031 и 1.4034.</strong> Диапазон углерода 40Х13 делят две европейские марки: 1.4031 покрывает 0,36–0,42 %, 1.4034 — 0,43–0,50 %. Хрома в обеих 12,5–14,5 %, против 12–14 % по ГОСТ, серы — не более 0,015 %.</li>
			<li><strong>SUS420J2.</strong> Углерод 0,26–0,40 %: с 40Х13 японская марка пересекается только в интервале 0,36–0,40 %, а по середине диапазона ближе к 30Х13.</li>
		</ul>
		<p>
			Плавка с 0,38 % углерода, 13,0 % хрома и серой не выше 0,015 % отвечает и 40Х13, и 1.4031, и AISI 420,
			и SUS420J2. Плавка с 0,44 % углерода — уже 40Х13 и 1.4034, но не 1.4031 и не SUS420J2. Поэтому при
			замене марки в заказе указывают диапазон углерода, а соответствие проверяют по сертификату с анализом
			плавки. Сводная таблица соответствия марок — в статье об <a href="/blog/analogi-marok-nerzhaveyki/">аналогах
			нержавейки</a>.
		</p>
	</section>

	<section id="svoystva">
		<h2>Твёрдость, механические и физические свойства</h2>
		<p>
			ГОСТ 5949-2018 требует поставлять сортовой прокат мартенситных сталей термически обработанным —
			отожжённым или отпущенным. Прочность, текучесть и ударную вязкость 40Х13 стандарт не контролирует
			(п. 7.1.7). Вместо них он нормирует две характеристики: твёрдость HB в поставке и твёрдость HRC на
			образцах после закалки и отпуска.
		</p>
		<div class="ba-table">
			<table>
				<caption>Твёрдость 40Х13 и AISI 420 по состояниям</caption>
				<thead>
					<tr><th>Состояние</th><th>Источник</th><th>Твёрдость</th></tr>
				</thead>
				<tbody>
					<tr><td>Поставка: отжиг или отпуск</td><td>ГОСТ 5949-2018, табл. 1</td><td>143–229 HB</td></tr>
					<tr><td>Закалка 1000–1050 °C, масло; отпуск 200–300 °C</td><td>ГОСТ 5949-2018, табл. 2</td><td>не менее 50 HRC</td></tr>
					<tr><td>После закалки и отпуска</td><td>Марочник сталей и сплавов</td><td>460–550 HB (≈ 48–55 HRC)</td></tr>
					<tr><td>AISI 420, отжиг, пруток горячекатаный / холоднотянутый</td><td>ASTM A276</td><td>не более 241 / 255 HB</td></tr>
					<tr><td>AISI 420, проверка закаливаемости: 995 °C, воздух</td><td>ASTM A276</td><td>не менее 50 HRC</td></tr>
					<tr><td>AISI 420, закалка 1010–1066 °C, масло; отпуск 149–204 °C</td><td>CarTech 420</td><td>≈ 52 HRC</td></tr>
					<tr><td>420HC, лента после отпуска</td><td>Ulbrich</td><td>40–52 HRC</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Перевод HB в HRC ориентировочный, по таблицам ASTM E140: 481 HB соответствует примерно 50 HRC, 560 HB —
			примерно 55 HRC. Как твёрдость распределяется по другим маркам нержавейки — в статье
			о <a href="/blog/tverdost-nerzhaveyushchey-stali/">твёрдости нержавеющей стали</a>.
		</p>
		<div class="ba-table">
			<table>
				<caption>Прочность 40Х13 и аналогов при 20 °C</caption>
				<thead>
					<tr><th>Прокат, стандарт</th><th>Состояние</th><th class="num">σв, МПа</th><th class="num">σ0,2, МПа</th><th class="num">δ, %</th></tr>
				</thead>
				<tbody>
					<tr><td>Лист тонкий — ГОСТ 5582-75</td><td>отжиг или отпуск 740–800 °C</td><td class="num">не менее 550</td><td class="num">—</td><td class="num">не менее 15</td></tr>
					<tr><td>Пруток заданной прочности — ГОСТ 18907-73 (по марочнику)</td><td>по стандарту</td><td class="num">590–810</td><td class="num">—</td><td class="num">не менее 10</td></tr>
					<tr><td>Проволока — ГОСТ 18143-72 (по марочнику)</td><td>по стандарту</td><td class="num">640–880</td><td class="num">—</td><td class="num">10–14</td></tr>
					<tr><td>1.4031 — EN 10088-3</td><td>закалка и отпуск +QT800</td><td class="num">800–1000</td><td class="num">не менее 650</td><td class="num">—</td></tr>
					<tr><td>1.4034 — EN 10088-3</td><td>закалка и отпуск +QT800</td><td class="num">850–1000</td><td class="num">не менее 650</td><td class="num">—</td></tr>
					<tr><td>SUS420J2, пруток — JIS G4303</td><td>закалка и отпуск</td><td class="num">не менее 740</td><td class="num">не менее 540</td><td class="num">не менее 12</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Горячекатаный тонкий лист из 40Х13 ГОСТ 5582-75 разрешает не термообрабатывать, если он выдерживает
			нормы таблицы.
		</p>

		<h3>Плотность и физические свойства</h3>
		<p>
			Плотность 40Х13 по марочнику сталей и сплавов — 7650 кг/м³ при 20 °C; при 500 °C она снижается до
			7510 кг/м³. Для 1.4031 и 1.4034 европейские данные дают 7,7 г/см³. Аустенитная 12Х18Н10Т с плотностью
			7,9 г/см³ тяжелее примерно на 3 %.
		</p>
		<div class="ba-table">
			<table>
				<caption>Физические свойства 40Х13 (марочник сталей и сплавов)</caption>
				<thead>
					<tr><th>Свойство</th><th>Значение</th></tr>
				</thead>
				<tbody>
					<tr><td>Плотность при 20 °C</td><td>7650 кг/м³ (7,65 г/см³)</td></tr>
					<tr><td>Модуль упругости при 20 °C</td><td>218 ГПа</td></tr>
					<tr><td>Теплопроводность при 20 / 100 °C</td><td>25 / 26 Вт/(м·К)</td></tr>
					<tr><td>Коэффициент теплового расширения, 20–100 °C</td><td>10,8 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Удельная теплоёмкость, 20–100 °C</td><td>482 Дж/(кг·К)</td></tr>
					<tr><td>Удельное электросопротивление при 20 °C</td><td>0,59 мкОм·м</td></tr>
