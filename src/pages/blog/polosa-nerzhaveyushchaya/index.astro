const faq = [
	{
		q: 'Чем полоса отличается от ленты из нержавейки?',
		a: 'Сечением, поставкой и стандартом. Полоса — сортовой прокат в прутках: по ГОСТ 103-2006 толщина 4–80 мм, ширина 10–200 мм. Лента — холоднокатаный прокат в рулонах: по ГОСТ 4986-79 толщина 0,05–2,0 мм, ширина 6–410 мм. Между 2 и 4 мм стандартного сортамента нет: такой прокат режут из листа или рулона по заказу. Слова «штрипс» в ГОСТ 4986-79 нет: так на рынке называют узкую ленту или полосу из рулона.',
	},
	{
		q: 'Какой ГОСТ на нержавеющую полосу?',
		a: 'Технические требования — ГОСТ 5949-2018 «Металлопродукция из сталей нержавеющих и сплавов на железоникелевой основе»: он действует с 1 февраля 2019 года взамен ГОСТ 5949-75 и называет полосу отдельной формой сечения. Размеры горячекатаной полосы берут из ГОСТ 103-2006 или ГОСТ 4405-75, кованой — из ГОСТ 4405-75, калиброванной — по документам, согласованным при заказе. Марки — ГОСТ 5632-2014, приёмка и маркировка — ГОСТ 7566-2018. Отдельного сортамента именно для нержавеющей полосы нет, у нарезной полосы единого ГОСТ тоже нет.',
	},
	{
		q: 'Сколько весит нержавеющая полоса 40×4?',
		a: 'Метр полосы 40×4 из AISI 304 (ρ = 7,9 г/см³) весит 40 × 4 × 7,9 / 1000 = 1,26 кг. Хлыст 6 м — около 7,6 кг, в тонне около 791 м. Для ферритной AISI 430 и 30Х13 (ρ = 7,7 г/см³) получается 1,23 кг на метр. Таблица веса ГОСТ 103-2006 рассчитана при плотности 7,85 г/см³: для 40×4 разница с 304 — около 0,6 %.',
	},
	{
		q: 'Какая марка полосы лучше — 304 или 430?',
		a: 'Зависит от среды. AISI 304 (08Х18Н10) — аустенитная, пластичная (по ГОСТ 5949-2018 в термообработанном состоянии σв не менее 470 Н/мм², δ не менее 40 %), подходит для влажных помещений, улицы и пищевого оборудования без хлоридов. AISI 430 (12Х17) — ферритная, без никеля, магнитная: σв не менее 390 Н/мм², δ не менее 20 %. ISSF относит 430 к маркам для помещений. Для сухих интерьерных деталей 430 экономичнее, во всех остальных случаях берут 304. Полосы 430 в нашем каталоге нет — только по запросу.',
	},
	{
		q: 'Что такое декоративная и золотая полоса?',
		a: 'Это другой товар: нержавейка с декоративной отделкой лицевой стороны — зеркало, сатин, цветное покрытие. «Золото» — как правило, золотистое покрытие, нанесённое вакуумным методом (PVD). Такие «полосы» нарезают из декоративного листа или ленты как накладки и обрамление; сортовой полосой по ГОСТ 103 они не являются. Декоративные листы, в том числе золотое зеркало, собраны в разделе «Декоративные листы». Полоса из каталога — обычная, без покрытия.',
	},
	{
		q: 'Из чего делают нарезную полосу?',
		a: 'Из холоднокатаного листа или рулона. Рулон режут продольно на дисковых ножах, лист — гильотиной или лазером. Поверхность у полосы такая же, как у исходного проката, а ширина и допуски зависят от способа реза: их согласуют в заказе, единого стандарта на нарезную полосу нет.',
	},
	{
		q: 'Магнитится ли нержавеющая полоса?',
		a: 'AISI 304 в отожжённом состоянии практически не магнитится. После холодной деформации — гибки, резки на гильотине — и у кромок она может слабо притягивать магнит: это наклёп, а не признак подделки. AISI 430 и 30Х13 (AISI 420) магнитятся всегда: ферритная и мартенситная структуры магнитны. По магниту марку не определить, её подтверждает сертификат с плавкой.',
	},
];

