---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sostav', anchor: 'Состав и аналоги', summary: 'ASTM A240, 12Х17, 1.4016' },
	{ id: 'svoystva', anchor: 'Прочность и физика', summary: 'Механика листа, плотность 7,7 г/см³' },
	{ id: 'korroziya', anchor: 'Коррозионная стойкость', summary: 'Где хватает и где нет' },
	{ id: 'svarka', anchor: 'Сварка и обработка', summary: 'Рост зерна, отжиг шва, гибка' },
	{ id: 'poverhnosti', anchor: 'Поверхности', summary: '2B, BA, 4N, зеркало' },
	{ id: 'primenenie', anchor: 'Где применяют', summary: 'Техника, кухни, отделка, декор' },
	{ id: 'sravnenie', anchor: 'AISI 430 или 304', summary: 'Таблица и проверка магнитом' },
];

const faq = [
	{
		q: 'Какой российский аналог AISI 430?',
		a: 'Сталь 12Х17 по ГОСТ 5632-2014: углерод до 0,12 %, хром 16–18 %, никель только как примесь — до 0,60 %. Европейский аналог — 1.4016 (X6Cr17) по EN 10088-2, японский — SUS 430. Обозначение 08Х17 из прайсов — торговое, в ГОСТ 5632-2014 такой марки нет. 08Х17Т — другая марка, стабилизированная титаном.',
	},
	{
		q: 'Магнитится ли AISI 430?',
		a: 'Да. AISI 430 — ферритная сталь и притягивает магнит в любом состоянии, как углеродистая. Магнит отличит её от отожжённой AISI 304, но не от углеродистой стали и других ферритных марок — для этого нужен сертификат с анализом плавки или спектральный анализ.',
	},
	{
		q: 'Можно ли использовать AISI 430 на улице?',
		a: 'Только в мягкой атмосфере без солей. Outokumpu допускает 430 в слабоагрессивной наружной среде, Atlas Steels для наружного применения её обычно не рекомендует. У моря, у дорог с противогололёдными реагентами и в бассейнах стойкости к хлоридам не хватает — там берут AISI 304 или 316L.',
	},
	{
		q: 'Можно ли варить AISI 430?',
		a: 'Можно, но с ограничениями. ГОСТ 5632-2014 не рекомендует 12Х17 для сварных конструкций: в зоне шва растёт зерно, появляется мартенсит и падает стойкость к межкристаллитной коррозии. Outokumpu рекомендует после сварки отжиг при 750–800 °C в течение 1–2 часов. Для сварных изделий лучше подходят стабилизированные титаном 08Х17Т, AISI 439 или аустенитная 304.',
	},
	{
		q: 'Подходит ли AISI 430 для пищевого оборудования?',
		a: 'Для части задач — да: ГОСТ 5632-2014 называет 12Х17 сталью для кухонной утвари и оборудования пищевой промышленности, разбавленные органические кислоты и моющие средства она выдерживает. Но рассолы, маринады и солёные кислые продукты, особенно горячие, содержат хлориды и вызывают питтинг. Для рабочих поверхностей с таким контактом выбирают AISI 304 или 316L.',
	},
	{
		q: 'Что лучше — AISI 430 или AISI 304?',
		a: 'Зависит от среды. AISI 304 с 8–10,5 % никеля лучше держит хлориды, хорошо сваривается и сохраняет пластичность на холоде. AISI 430 дешевле за счёт отсутствия никеля, меньше расширяется при нагреве и не склонна к хлоридному коррозионному растрескиванию. Для сухих помещений и бытовой техники хватает 430, для улицы, сварных конструкций и пищевых линий нужна 304.',
	},
];

const sources = [
	{ label: 'ASTM A240 — состав и механические свойства листа 430 и 304 (листы марок Atlas Steels в сборнике worldstainless)', href: 'https://worldstainless.org/wp-content/uploads/2025/02/stainless-steel-grade-sheets.pdf' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1, п. 6.5, приложение А', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'Outokumpu Moda range datasheet — 1.4016: EN 10088-2, EN 10088-1, коррозия, сварка', href: 'https://www.outokumpu.com/-/media/files/products/moda/outokumpu-moda-range-datasheet.pdf' },
	{ label: 'Outokumpu Core range datasheet — физические свойства 1.4301', href: 'https://www.outokumpu.com/-/media/files/products/core/outokumpu-core-range-datasheet.pdf' },
	{ label: 'ASTM A480 — обозначения отделок поверхности листа (No.4, No.8)' },
];

const related = [
	{ label: 'Лист AISI 430 (12Х17)', href: '/list-nerzhaveyushchiy/aisi-430/' },
	{ label: 'Декоративные листы: зеркало, шлифовка, DECO', href: '/dekorativnye-listy/' },
	{ label: 'Виды нержавеющей стали: аустенит, феррит, мартенсит', href: '/blog/vidy-nerzhaveyushchey-stali/' },
	{ label: 'Характеристики AISI 304, 321 и 316L', href: '/blog/harakteristiki-aisi-304-321-316/' },
	{ label: 'AISI 201: характеристики и отличия от AISI 304', href: '/blog/aisi-201-harakteristiki/' },
	{ label: 'Аналоги марок нержавейки: AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
];
---

<BlogArticle
	slug="aisi-430-harakteristiki"
	title="AISI 430: характеристики, аналог 12Х17, применение"
	description="Сталь AISI 430 (12Х17, 1.4016): состав по ASTM A240 и ГОСТ 5632, прочность, плотность, магнитность, сварка, поверхности и сравнение с AISI 304."
	h1="AISI 430: характеристики стали, аналог 12Х17 и где её применяют"
	eyebrow="Справочник"
	datePublished="2026-09-26"
	dateModified="2026-09-26"
	readingMin={9}
	answer="<strong>AISI 430 — ферритная хромистая нержавеющая сталь без никеля: по ASTM A240 в ней 16–18 % хрома, до 0,12 % углерода и не более 0,75 % никеля.</strong> Российский аналог — 12Х17 по ГОСТ 5632-2014, европейский — 1.4016 (X6Cr17) по EN 10088-2. Сталь магнитится, плотность — 7,7 г/см³, прочность листа по ASTM A240 — от 450 МПа; её применяют в бытовой технике, кухонном оборудовании и отделке помещений, а на улице, в хлоридах и в сварных конструкциях она уступает AISI 304."
	keyFacts={[
		'Состав по ASTM A240: Cr 16,0–18,0 %, C ≤ 0,12 %, Ni ≤ 0,75 %, Mn и Si ≤ 1,00 %',
		'Аналоги: 12Х17 (ГОСТ 5632-2014), 1.4016 / X6Cr17 (EN 10088-2), SUS 430; «08Х17» в ГОСТ нет',
		'Лист по ASTM A240: σв ≥ 450 МПа, σ0,2 ≥ 205 МПа, δ ≥ 22 %, не более 183 HB',
		'Плотность 7,7 г/см³, теплопроводность 25 Вт/(м·К), ферромагнитна',
		'PREN около 16 против 18–20 у AISI 304: хуже держит хлориды, зато не склонна к коррозионному растрескиванию',
	]}
	coverAlt="AISI 430 (12Х17): характеристики, состав и аналоги ферритной нержавейки"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['AISI 430', '12Х17', 'Ферритная нержавеющая сталь']}
	cta={{ title: 'Нужна сталь AISI 430 или 304?', text: 'Подберём марку нержавеющего проката под среду, сварку и поверхность.' }}
>
	<section id="sostav">
		<h2>Что такое AISI 430: состав и аналоги</h2>
		<p>
			AISI 430 (UNS S43000) — нержавеющая сталь ферритного класса. Коррозионную стойкость ей даёт хром,
			16–18 %; никель в неё не вводят, и ASTM A240 допускает его только как примесь — до 0,75 %.
			Термообработкой сталь не упрочняется и поставляется в отожжённом состоянии. Outokumpu называет её
			классической ферритной нержавейкой для слабоагрессивных сред.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка, стандарт</th><th>C</th><th>Cr</th><th>Ni</th><th>Ti</th><th>Mn</th><th>Si</th><th>P</th><th>S</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 430 (ASTM A240)</td><td>0,12</td><td>16,0–18,0</td><td>0,75</td><td>—</td><td>1,00</td><td>1,00</td><td>0,040</td><td>0,030</td></tr>
					<tr><td>12Х17 (ГОСТ 5632-2014)</td><td>0,12</td><td>16,0–18,0</td><td>0,60*</td><td>—</td><td>0,80</td><td>0,80</td><td>0,035</td><td>0,025</td></tr>
					<tr><td>1.4016 / X6Cr17 (EN 10088-2)</td><td>0,08</td><td>16,0–18,0</td><td>—</td><td>—</td><td>1,00</td><td>1,00</td><td>0,040</td><td>0,015</td></tr>
					<tr><td>08Х17Т (ГОСТ 5632-2014)</td><td>0,08</td><td>16,0–18,0</td><td>0,60*</td><td>5·C–0,80</td><td>0,80</td><td>0,80</td><td>0,035</td><td>0,025</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			* Остаточный никель: ГОСТ 5632-2014 (п. 6.5) допускает до 0,60 % в хромистых сталях с хромом до 20 %,
			не легированных никелем.
		</p>
		<p>
			По составу 12Х17 и AISI 430 практически совпадают, поэтому их считают аналогами. Европейская 1.4016
			строже по углероду (до 0,08 %) и сере (до 0,015 %), японский аналог — SUS 430. В прайсах часто
			встречается обозначение 08Х17 — в ГОСТ 5632-2014 такой марки нет. Марка 08Х17Т — не синоним 430:
			титан в ней связывает углерод, и ГОСТ разрешает её для сварных конструкций, а 12Х17 для них не
			рекомендует.
		</p>
	</section>

	<section id="svoystva">
		<h2>Механические и физические свойства</h2>
		<div class="ba-table">
			<table>
				<caption>Механические свойства листа, отожжённое состояние</caption>
				<thead>
					<tr><th>Марка, стандарт, прокат</th><th class="num">σв, МПа</th><th class="num">σ0,2, МПа</th><th class="num">δ, %</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 430 — ASTM A240, лист и рулон</td><td class="num">≥ 450</td><td class="num">≥ 205</td><td class="num">≥ 22</td></tr>
					<tr><td>1.4016 — EN 10088-2, холоднокатаный</td><td class="num">430–600</td><td class="num">≥ 280</td><td class="num">≥ 20</td></tr>
					<tr><td>1.4016 — EN 10088-2, горячекатаный</td><td class="num">430–600</td><td class="num">≥ 260</td><td class="num">≥ 18</td></tr>
					<tr><td>12Х17 — ГОСТ 5582-75, тонкий лист</td><td class="num">≥ 490</td><td class="num">не нормируется</td><td class="num">≥ 20</td></tr>
					<tr><td>12Х17 — ГОСТ 7350-77, толстый лист</td><td class="num">≥ 440</td><td class="num">не нормируется</td><td class="num">≥ 18</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Твёрдость по ASTM A240 — не более 183 HB (89 HRB). ГОСТ 5582-75 распространяется на лист толщиной
			до 3,9 мм, ГОСТ 7350-77 — на толстолистовую сталь от 4 мм. Удлинение стандарты измеряют на разной
			базе (A50 в ASTM, A80 для холоднокатаного листа в EN, δ5 в ГОСТ), поэтому цифры сравнивают внутри
			одного стандарта. Значения EN 10088-2 приведены по техническому листу Outokumpu.
		</p>
		<div class="ba-table">
			<table>
				<caption>Физические свойства при 20 °C</caption>
				<thead>
					<tr><th>Свойство</th><th>AISI 430 / 1.4016</th><th>AISI 304 / 1.4301</th></tr>
				</thead>
				<tbody>
					<tr><td>Плотность</td><td>7,7 г/см³</td><td>7,9 г/см³</td></tr>
					<tr><td>Модуль упругости</td><td>200–220 ГПа</td><td>193–200 ГПа</td></tr>
					<tr><td>Теплопроводность</td><td>25 Вт/(м·К)</td><td>15 Вт/(м·К)</td></tr>
					<tr><td>Коэффициент теплового расширения, 20–100 °C</td><td>10,0–10,4 × 10⁻⁶ 1/К</td><td>16,0–17,2 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Удельная теплоёмкость</td><td>460 Дж/(кг·К)</td><td>500 Дж/(кг·К)</td></tr>
					<tr><td>Удельное электросопротивление</td><td>0,60 мкОм·м</td><td>0,72–0,73 мкОм·м</td></tr>
					<tr><td>Магнитные свойства</td><td>Ферромагнитна</td><td>Немагнитна в отожжённом состоянии</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Где указан диапазон, одна граница — по EN 10088-1 (данные Outokumpu), другая — по справочнику
			Atlas Steels: источники берут разные интервалы температур. Плотность 430 примерно на 2,5 % ниже,
			чем у 304, поэтому лист тех же размеров весит меньше. Теплопроводность выше, а расширение при
			нагреве в 1,6 раза меньше — это снижает коробление при сварке и нагреве.
		</p>
	</section>

	<section id="korroziya">
		<h2>Коррозионная стойкость: где хватает и где нет</h2>
		<p>
			Индекс стойкости к питтингу PREN у AISI 430 — около 16 против 18–20 у AISI 304: молибдена в стали
			нет, и PREN почти целиком определяет хром. Outokumpu относит 430 к сталям для слабоагрессивных сред.
		</p>
		<h3>Где 430 работает</h3>
		<ul>
			<li><strong>Помещения</strong> — бытовая техника, кухни, мебель, внутренняя отделка, лифты.</li>
			<li><strong>Азотная кислота и ряд органических кислот</strong> — стойкость к азотной кислоте позволяет применять 430 в отдельных химических аппаратах (Atlas Steels).</li>
			<li><strong>Бытовая химия и мягкие растворы</strong> — моющие средства и мыло при последующем ополаскивании, многие щелочные растворы, разбавленные органические кислоты, водные растворы без хлоридов и других галогенидов (Outokumpu).</li>
			<li><strong>Хлоридное коррозионное растрескивание</strong> — ферритные стали без никеля к нему практически не склонны. У 304 этот риск появляется в горячих хлоридных растворах, обычно выше 60 °C.</li>
		</ul>
		<h3>Где стойкости не хватает</h3>
		<ul>
			<li><strong>Хлориды</strong> — морской воздух, противогололёдные реагенты, солёная вода, хлорсодержащие чистящие средства. Стойкость к питтингу и щелевой коррозии у 430 ниже, чем у 304.</li>
			<li><strong>Улица</strong> — Atlas Steels для наружного применения 430 обычно не рекомендует, Outokumpu допускает её в слабоагрессивной атмосфере. Для фасадов у дорог с реагентами и у моря берут 304 или 316L.</li>
			<li><strong>Пищевые кислоты с солью — осторожно</strong> — разбавленные органические кислоты 430 держит, но рассолы, маринады и солёные кислые продукты, особенно горячие, содержат хлориды. Для рабочих поверхностей с таким контактом нужна 304 или 316L.</li>
			<li><strong>Сварные швы без отжига</strong> — в околошовной зоне сталь теряет стойкость к межкристаллитной коррозии (подробнее — в разделе о сварке).</li>
		</ul>
		<p>
			Как хлориды пробивают пассивную плёнку и как считают PREN, разобрано в статье
			<a href="/blog/pittingovaya-korroziya/">питтинговая коррозия нержавейки</a>.
		</p>
		<p>
			<strong>Нагрев.</strong> На воздухе 430 стойка к окислению до 870 °C при периодическом и до 815 °C
			при постоянном нагреве (Atlas Steels); ГОСТ 5632-2014 указывает для 12Х17 температуру начала
			интенсивного окалинообразования 900 °C. Долгая выдержка при 400–600 °C делает сталь хрупкой при
			комнатной температуре (хрупкость 475 °C) — её снимает отжиг.
		</p>
	</section>

	<section id="svarka">
		<h2>Сварка, гибка и обработка</h2>
		<p>
			Свариваемость у AISI 430 ограниченная. ГОСТ 5632-2014 прямо указывает, что 12Х17 для сварных
			конструкций не рекомендуется и применяется в отожжённом состоянии. Причина — в зоне шва: при нагреве
			растёт зерно, по его границам образуется мартенсит, а выпадение карбидов хрома снижает стойкость
			к межкристаллитной коррозии. Шов и околошовная зона становятся хрупкими.
		</p>
		<ul>
			<li><strong>Подогрев</strong> — 150–200 °C перед сваркой (Atlas Steels).</li>
			<li><strong>Отжиг после сварки</strong> — 750–800 °C, обычно 1–2 часа (Outokumpu): он отпускает мартенсит и возвращает стойкость к межкристаллитной коррозии. Крупное зерно отжиг не измельчает (Atlas Steels).</li>
			<li><strong>Присадка</strong> — обычно аустенитная (308L, 309, 310), она даёт вязкий шов; ферритную присадку применяют только для однопроходных швов.</li>
			<li><strong>Защитный газ</strong> — на основе аргона; азот и водород не добавляют: азот насыщает шов, водород вызывает холодные трещины.</li>
		</ul>
		<p>
			Если изделие сварное, проще сразу взять стабилизированную ферритную марку — 08Х17Т по ГОСТ, AISI 439
			(1.4510) или 1.4520: титан связывает углерод, и шов меньше теряет свойства. Для ответственных сварных
			узлов берут аустенитную 304.
		</p>
		<p>
			<strong>Гибка и вытяжка.</strong> Упрочняется при деформации 430 слабее, чем 304, поэтому гнуть её
			проще, но пластичность ниже, и для самых тяжёлых операций формовки её не берут. Минимальный радиус гиба равен
			толщине листа, для листа тоньше 1 мм — половине толщины (Outokumpu); ответственные гибы располагают
			поперёк направления прокатки. При вытяжке на поверхности может проявиться риджинг — волнистость вдоль
			прокатки; у стабилизированной 439 он слабее.
		</p>
		<p>
			<strong>Холод и резание.</strong> Пластичность ферритной стали падает при температуре ниже комнатной,
			поэтому сложную штамповку ведут с металлом при комнатной температуре. Для близкой марки 08Х17Т
			ГОСТ 5632-2014 допускает эксплуатацию конструкций при температуре не ниже минус 20 °C. Резанием 430
			обрабатывается легче, чем 304 (Atlas Steels).
		</p>
	</section>

	<section id="poverhnosti">
		<h2>Поверхности листа AISI 430</h2>
		<p>
			Холоднокатаный лист и рулон 430 чаще всего поставляют с поверхностями 2B и BA, а также со шлифовкой
			No.4 (Atlas Steels). Обозначения те же, что у других марок нержавейки.
		</p>
		<div class="ba-table">
			<table>
				<caption>Основные поверхности</caption>
				<thead>
					<tr><th>Обозначение</th><th>Как получают, как выглядит</th><th>Где встречается</th></tr>
				</thead>
				<tbody>
					<tr><td>2B</td><td>Холодная прокатка, отжиг, травление, дрессировка; светлая матовая</td><td>Детали, где внешний вид вторичен; заготовка под шлифовку и полировку</td></tr>
					<tr><td>BA (по EN — 2R)</td><td>Светлый отжиг в защитной атмосфере; блестящая, хорошо отражает</td><td>Панели бытовой техники, отделка, молдинги</td></tr>
					<tr><td>4N (No.4)</td><td>Шлифовка абразивной лентой, направленный штрих</td><td>Облицовка кухонного оборудования, лифты, интерьерные панели</td></tr>
					<tr><td>Зеркало (No.8, 8K)</td><td>Полировка до зеркального блеска</td><td>Декор, отделка интерьеров</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Отделка влияет и на коррозию: чем глаже поверхность, тем меньше на ней задерживаются грязь и соли.
			Atlas Steels отмечает, что наибольшую коррозионную стойкость 430 показывает в полированном состоянии.
			Обозначения и шероховатость подробно разобраны в статье
			<a href="/blog/poverhnosti-nerzhaveyushchego-lista/">поверхности нержавеющего листа</a>.
		</p>
	</section>

	<section id="primenenie">
		<h2>Где применяют AISI 430</h2>
		<p>
			ГОСТ 5632-2014 называет область 12Х17 прямо: предметы домашнего обихода и кухонная утварь,
			оборудование пищевой и лёгкой промышленности, а как жаростойкую сталь — теплообменники,
			оборудование кухонь и трубы. Справочники производителей добавляют бытовую технику и отделку.
		</p>
		<ul>
			<li><strong>Бытовая техника</strong> — облицовка посудомоечных машин, панели холодильников и другой техники, декоративные кольца конфорок (Atlas Steels).</li>
			<li><strong>Кухонное оборудование</strong> — мойки, утварь, корпуса и облицовка оборудования. Ферромагнитность используют в посуде для индукционных плит: слой 430 ставят снаружи или в дно.</li>
			<li><strong>Отделка и декор</strong> — интерьерные панели, лифтовые кабины, автомобильные молдинги, декоративные листы со шлифовкой и зеркалом.</li>
			<li><strong>Нагрев без агрессивной среды</strong> — вкладыши дымоходов, держатели нагревательных элементов, теплообменники (Atlas Steels, ГОСТ 5632-2014).</li>
			<li><strong>Прочее</strong> — крепёж, увязочная проволока, фланцы и арматура для слабоагрессивных сред.</li>
		</ul>
		<p>
			Не стоит брать 430 для уличных конструкций у моря и дорог с реагентами, для бассейнов, рабочих
			поверхностей с рассолами, сварных несущих конструкций и деталей с ударной нагрузкой на морозе.
			Сортамент листа этой марки — в каталоге: <a href="/list-nerzhaveyushchiy/aisi-430/">лист AISI 430 (12Х17)</a>.
		</p>
	</section>

	<section id="sravnenie">
		<h2>AISI 430 или AISI 304: сравнение и как отличить</h2>
		<div class="ba-table">
			<table>
				<caption>AISI 430 и AISI 304 (состав и механика — ASTM A240)</caption>
				<thead>
					<tr><th>Параметр</th><th>AISI 430</th><th>AISI 304</th></tr>
				</thead>
				<tbody>
					<tr><td>Класс</td><td>Ферритный</td><td>Аустенитный</td></tr>
					<tr><td>Хром / никель, %</td><td>16,0–18,0 / ≤ 0,75</td><td>17,5–19,5 / 8,0–10,5</td></tr>
					<tr><td>Углерод, не более</td><td>0,12 %</td><td>0,07 %</td></tr>
					<tr><td>Аналог ГОСТ / EN</td><td>12Х17 / 1.4016</td><td>08Х18Н10 / 1.4301</td></tr>
					<tr><td>σв / σ0,2 / δ, не менее</td><td>450 / 205 МПа / 22 %</td><td>515 / 205 МПа / 40 %</td></tr>
					<tr><td>Твёрдость, не более</td><td>183 HB</td><td>201 HB</td></tr>
					<tr><td>Плотность</td><td>7,7 г/см³</td><td>7,9 г/см³</td></tr>
					<tr><td>Магнит</td><td>Притягивается</td><td>Нет (в отожжённом состоянии)</td></tr>
					<tr><td>PREN</td><td>≈ 16</td><td>18–20</td></tr>
					<tr><td>Хлоридное коррозионное растрескивание</td><td>Практически не склонна</td><td>Склонна в горячих хлоридах</td></tr>
					<tr><td>Сварка</td><td>Ограниченная, нужен отжиг шва</td><td>Хорошая</td></tr>
					<tr><td>Холод</td><td>Пластичность падает ниже комнатной температуры</td><td>Вязкость сохраняется до −196 °C</td></tr>
					<tr><td>Тепловое расширение, 20–100 °C</td><td>10 × 10⁻⁶ 1/К</td><td>16 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Стоимость</td><td>Ниже — нет никеля</td><td>Выше</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			AISI 304 выигрывает по стойкости к хлоридам, свариваемости, пластичности и работе на холоде. AISI 430 —
			по цене, меньшему тепловому расширению и стойкости к хлоридному коррозионному растрескиванию.
		</p>
		<h3>Как отличить 430 от 304 магнитом</h3>
		<ul>
			<li><strong>Магнит уверенно притягивается по всей площади листа</strong> — это ферритная (430) или мартенситная сталь либо углеродистая. Отожжённая 304 так себя не ведёт.</li>
			<li><strong>Слабое притяжение только на гибах, кромках, в штампованных углах</strong> — скорее всего, 304 после холодной деформации: в ней образуется мартенсит деформации.</li>
			<li><strong>Магнит не притягивается</strong> — аустенит: 304, 316, 321 или низконикелевая 201. Различить их магнит не поможет.</li>
		</ul>
		<p>
			Магнит показывает структуру, а не марку: он не отличит 430 от 409, 439 или углеродистой стали. Марку
			подтверждают сертификатом с химическим анализом плавки, на месте — портативным спектрометром, который
			покажет содержание никеля. Подробнее — в статье
			<a href="/blog/magnitit-li-nerzhaveika/">магнитится ли нержавейка</a>.
		</p>
	</section>
