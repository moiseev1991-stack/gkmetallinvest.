---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../../data/site';

const title = 'Пищевая нержавейка: марки стали и как выбрать';
const description = 'Пищевая нержавеющая сталь: марки 304, 304L, 316L и 430 по средам — молоко, соль, уксус, мойка. Поверхность 2B/BA, ГОСТ 5632-2014, что указать в заявке.';

const cover = '/img/blog/pishchevaya-nerzhaveyka.svg';
const datePublished = '2026-07-17';
const dateModified = '2026-10-06';
const url = `${siteUrl.replace(/\/$/, '')}/blog/pishchevaya-nerzhaveyka/`;

/* Структура поста — массив H2-секций. Используется для TOC. */
const sections = [
	{
		id: 'kakie-marki',
		anchor: 'Какие марки пищевые',
		title: 'Какая нержавейка считается пищевой',
		summary: 'Не марка, а назначение: 304, 304L, 316L и их границы.',
	},
	{
		id: 'po-srede',
		anchor: 'Марка по среде',
		title: 'Какую марку брать: оборудование и среда',
		summary: 'Молоко, соль, уксус, мойка, бассейн, ножи.',
	},
	{
		id: '304-vs-316l',
		anchor: '304 или 316L',
		title: 'AISI 304 или 316L — когда что',
