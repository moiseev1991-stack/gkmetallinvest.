	},
	{
		id: 'chego-izbegat',
		anchor: 'Чего избегать',
		title: 'Чего избегать в пищевом контакте',
		summary: '430, 201, 420 и сталь без сертификата.',
	},
	{
		id: 'katalog',
		anchor: 'Что есть в каталоге',
		title: 'Пищевые марки в нашем каталоге',
		summary: 'Лист, труба, круг по прайсу на 25 июля 2026 года.',
	},
	{
		id: 'zayavka',
		anchor: 'Что указать в заявке',
		title: 'Что указать в заявке',
		summary: 'Марка, среда, размеры, поверхность, документы.',
	},
];

const envRows = [
	{
		env: 'Молоко, молочные продукты, пиво, вино — среды без соли и без хлорной мойки',
		mark: 'AISI 304 (08Х18Н10); сварные узлы — 304L (03Х18Н11)',
		why: 'Atlas Steels называет 304 типичной сталью для пивоварения, переработки молока и виноделия. Общий ориентир EHEDG для 304 — pH 6,5–8, хлориды до 50 мг/л, температура до 25 °C; 304L легче сваривается.',
	},
	{
		env: 'Сварные трубопроводы и ёмкости',
		mark: '304L или 316L (03Х17Н14М3)',
		why: 'EHEDG рекомендует 316L для труб и сосудов из-за лучшей свариваемости. По Atlas Steels, L-версии не требуют отжига после сварки толстых сечений — примерно от 5 мм.',
