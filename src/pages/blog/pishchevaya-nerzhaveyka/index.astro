];

const compareRows = [
	{
		param: 'ГОСТ-обозначение',
		v304: '08Х18Н10',
		v316l: '03Х17Н14М3',
	},
	{
		param: 'Молибден (ASTM A240)',
		v304: 'нет',
		v316l: '2,0–3,0 %',
	},
	{
		param: 'PRE, типичное значение (Outokumpu)',
		v304: '18',
		v316l: '24',
	},
	{
		param: 'Хлориды в питьевой воде, до (Atlas Steels)',
		v304: 'около 200 мг/л, при 60 °C — около 150',
		v316l: 'около 1000 мг/л, при 60 °C — 300–500',
	},
	{
		param: 'Нейтральные продукты (молоко, пиво, вода, мука)',
		v304: 'да',
		v316l: 'да',
	},
	{
		param: 'Продукты с солью, рассолы, солёные маринады и соусы',
		v304: 'нежелательно',
		v316l: 'да, при умеренных хлоридах',
	},
	{
		param: 'Хлорсодержащие моющие и дезинфицирующие средства',
		v304: 'риск питтинга',
		v316l: 'стойче, но хлорные отбеливатели не рекомендуют (Euro Inox); промывать водой',
	},
	{
		param: 'Сварные ёмкости и трубы',
		v304: '304L с углеродом до 0,030 % (03Х18Н11)',
		v316l: '316L уже низкоуглеродистая (до 0,030 %)',
	},
	{
		param: 'Типичное применение',
		v304: 'молочное и пивоваренное оборудование, виноделие, кухонное оборудование',
		v316l: 'пищевое оборудование в хлоридных средах, трубы и сосуды, фарма',
	},
];

const catalogRows = [
	{ mark: 'AISI 304 (08Х18Н10)', list: '195', rulon: '18', truba: '380', krug: '102', polosa: '38', ugolok: '22', provoloka: '25' },
	{ mark: 'AISI 304L (03Х18Н11)', list: '7', rulon: '2', truba: '—', krug: '—', polosa: '—', ugolok: '—', provoloka: '1' },
	{ mark: 'AISI 316L (03Х17Н14М3)', list: '40', rulon: '2', truba: '10', krug: '31', polosa: '—', ugolok: '1', provoloka: '2' },
	{ mark: 'AISI 316Ti (10Х17Н13М2Т)', list: '18', rulon: '—', truba: '20', krug: '37', polosa: '—', ugolok: '—', provoloka: '5' },
	{ mark: 'AISI 321 (12Х18Н10Т)', list: '149', rulon: '4', truba: '498', krug: '133', polosa: '—', ugolok: '1', provoloka: '28' },
	{ mark: 'AISI 430 (12Х17)', list: '143', rulon: '26', truba: '22', krug: '—', polosa: '—', ugolok: '—', provoloka: '5' },
];

const faq = [
	{
		q: 'Какая нержавейка считается пищевой?',
		a: 'Пищевой называют аустенитную хромоникелевую нержавейку, подобранную под продукт и мойку, — прежде всего AISI 304 (08Х18Н10) и AISI 316L (03Х17Н14М3), для сварных узлов — 304L (03Х18Н11). «Пищевая» — не отдельная марка и не класс в ГОСТ 5632-2014, а требование к составу, чистоте поверхности и документам. По EHEDG, 304 — типичный выбор при pH 6,5–8, хлоридах до 50 мг/л и температуре до 25 °C; с хлоридами выше берут молибденсодержащую 316L. Ключевой признак — аустенитная структура с 16–19,5 % хрома и 8–14 % никеля по ASTM A240.',
	},
	{
		q: 'В чём разница между пищевой и технической нержавейкой?',
		a: 'Разница не в «сорте металла»: в ГОСТ 5632-2014 деления на «пищевую» и «техническую» сталь нет, это торговые названия. Пищевой называют аустенитную 304 или 316L с гладкой поверхностью (2B, BA или шлиф) и сертификатом, подтверждающим состав. «Технической» часто называют ферритную 430, хромомарганцевую 201 или сталь без сертификата: у них меньше никеля или нет его вовсе, и в солях и кислотах они хуже сопротивляются питтингу. Для оборудования, контактирующего с рассолами и кислыми продуктами, берут сертифицированный аустенит.',
	},
	{
		q: 'Можно ли использовать AISI 430 для пищевого оборудования?',
		a: 'Для части задач — да. ГОСТ 5632-2014 называет 12Х17 сталью для кухонной утвари и оборудования заводов пищевой промышленности, Outokumpu — для кухонного оборудования, бытовой техники и моек, а ISSF показывает из 430 торговое пищевое оборудование: печи, тостеры, кофемашины, холодильники. Но 430 слабее держит хлориды (PRE 16 против 18 у 304 по Outokumpu), а ГОСТ не рекомендует её для сварных конструкций. Для ёмкостей и труб с рассолами, кислыми продуктами и хлорсодержащей мойкой берут 304 или 316L.',
	},
	{
		q: 'Что означают поверхности 2B и BA?',
		a: '2B — холоднокатаная поверхность после отжига, травления и дрессировки: матово-гладкая, самая массовая для пищевого оборудования. BA (bright annealed) — светлый отжиг в защитной атмосфере, зеркально-гладкая поверхность. Чем глаже поверхность (ниже шероховатость Ra), тем меньше микровпадин, где задерживаются продукт и бактерии. EHEDG для крупных площадей контакта с продуктом называет Ra не более 0,8 мкм и отмечает, что холоднокатаный лист (Ra 0,2–0,5 мкм) обычно полировки не требует, если на поверхности нет раковин, складок и щелей.',
	},
	{
		q: 'Магнитится ли пищевая нержавейка?',
		a: 'В отожжённом состоянии пищевые 304 и 316L не магнитятся — они аустенитные. Но после гибки, штамповки или вытяжки (например, у моек и корпусов) в деформированном слое появляется мартенсит деформации, и магнит начинает слабо притягиваться. Это не признак «неправильной» или «технической» стали. Ферритная 430 магнитится всегда, но на пригодность для пищевого оборудования это не влияет: коррозионная стойкость зависит от состава, а не от магнитности (ISSF). Проверять марку магнитом нельзя, нужен сертификат на плавку. Подробнее — в статье <a href="/blog/magnitit-li-nerzhaveika/">магнитится ли нержавейка</a>.',
	},
	{
		q: 'Какая сталь пищевая — 201 или 304?',
		a: '304. У AISI 304 по ASTM A240 никеля 8,0–10,5 %, у 201 — 3,5–5,5 %, а у 12Х15Г9НД из прайсов — 1,0–1,5 % (по данным поставщиков). ISSF для «стандартных» хромомарганцевых сталей серии 200 в пищевой и напиточной отраслях называет опыт положительным при 4 % никеля, с ограничениями и обслуживанием — при 1 %, и советует избегать pH ниже 3. В испытаниях KTH по методике Совета Европы 201 выделяла металлов меньше предельных значений, как и 304: решает не выделение металла, а стойкость к среде и мойке. Для рассолов, кислых продуктов и мойки берут 304 или 316L.',
	},
	{
		q: 'Какая нержавейка нужна для соли, рассолов и уксуса?',
		a: 'AISI 316L (03Х17Н14М3). По Atlas Steels, 304 стойка в питьевой воде при хлоридах до 200 мг/л (около 150 мг/л при 60 °C), 316 — до 1000 мг/л (при 60 °C — 300–500 мг/л в разных изданиях Atlas); для пищевого оборудования в хлоридных средах Atlas называет типичной 316. Для постоянного контакта с крепким рассолом этого может не хватить: IMOA отмечает, что дуплекс 2205 справляется со многими солоноватыми водами и деаэрированными рассолами. Для горячих уксусных сред ГОСТ 5632-2014 называет марки с молибденом, например 10Х17Н13М2Т.',
	},
	{
		q: 'По какому ГОСТу поставляют пищевую нержавейку?',
		a: '«Пищевая» — это назначение, а не вид проката, поэтому металл поставляют по обычным стандартам: марки и состав — ГОСТ 5632-2014, тонкий лист — ГОСТ 5582-75, толстый — ГОСТ 7350-77, круг и сортовой прокат — ГОСТ 5949-2018, бесшовные трубы — ГОСТ 9941-2022 (заменил ГОСТ 9941-81; в названиях позиций прайса остаётся «ГОСТ 9941») и ГОСТ 9940-81, электросварные — ГОСТ 11068-81. Требования к материалам оборудования, контактирующего с продуктами, — статья 15 ТР ТС 021/2011; марки стали в ней не перечислены.',
	},
];

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: `${siteUrl.replace(/\/$/, '')}${cover}`,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	datePublished,
	dateModified,
	author: { '@type': 'Organization', name: siteName, url: siteUrl },
	publisher: {
		'@type': 'Organization',
		name: siteName,
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl.replace(/\/$/, '')}/favicon.svg` },
	},
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
	})),
};
---

<BaseLayout title={title} description={description} image={cover} type="article" jsonLd={[articleJsonLd, faqJsonLd]}>
	<div class="container post">
		<Breadcrumbs items={[
			{ label: 'Главная', href: '/' },
			{ label: 'Блог', href: '/blog/' },
			{ label: 'Пищевая нержавейка' },
		]} />

		<header class="post__hero">
			<span class="post__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M4 2v6a4 4 0 0 0 8 0V2M4 2h2v3H4M10 2h2v3h-2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
				</svg>
				Статья · пищевой контакт
			</span>
			<h1 class="post__h1">Пищевая нержавейка: какие марки применяют и как выбрать</h1>
			<div class="post__meta">
				<time datetime={datePublished}>17 июля 2026</time>
				<span>·</span>
				<span>обновлено <time datetime={dateModified}>6 октября 2026</time></span>
				<span>·</span>
				<span>чтение 17 минут</span>
			</div>
			<p class="post__lead">
				<strong>Пищевая нержавейка — не отдельная марка, а сталь, подобранная под продукт и мойку.</strong>
				Для нейтральных сред — молока, пива, вина, воды, муки — применяют аустенитную AISI 304 (08Х18Н10), для сварных
				узлов — её низкоуглеродистую 304L (03Х18Н11); для солей, рассолов и мойки хлорсодержащими средствами —
				AISI 316L (03Х17Н14М3); хлорные отбеливатели Euro Inox не рекомендует для любой нержавейки. По EHEDG, 304 — типичный выбор при pH 6,5–8, хлоридах до 50 мг/л и температуре до 25 °C.
				Ферритная AISI 430 (12Х17) подходит для кухонной утвари и сухих зон, но не для ёмкостей с солью. Марки и состав
				задаёт ГОСТ 5632-2014, а пригодность подтверждают гладкая поверхность (2B, BA) и сертификат на плавку.
			</p>
		</header>

		<figure class="post__cover">
			<img
				src={cover}
				alt="Пищевая нержавейка — марки AISI 304 и 316L для пищевой промышленности"
				width="1200"
				height="630"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<nav class="post__toc" aria-label="Содержание">
			<div class="post__toc-title">На странице</div>
			<ul>
				{sections.map((s) => (
					<li>
						<a href={`#${s.id}`}>
							<strong>{s.anchor}</strong>
							<span>{s.summary}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<article class="post__body">
			<section class="post__section" id="kakie-marki">
				<h2>Какая нержавейка считается пищевой: марки и стандарты</h2>
				<p>
					«Пищевая нержавейка» — это не отдельная марка и не класс стали: ГОСТ 5632-2014 такого деления не делает.
					Так называют сталь, которая подходит под продукт, мойку и санитарные требования: не ржавеет от влаги
					и продуктов, не копит остатки в микровпадинах и отмывается. В приложении А к стандарту пищевая
					промышленность названа среди назначений ферритных 12Х17 и 08Х18Тч и аустенито-ферритных 08Х18Г8Н2Т (КО-3)
					и 08Х22Н6Т (ЭП53); 12Х18Н10Т и 08Х18Н10Т стандарт называет марками для свариваемой
					аппаратуры. Базовый выбор для оборудования, которое касается продуктов, —
					<strong>аустенитные хромоникелевые стали</strong>:
				</p>
				<ul>
					<li>
						<strong><a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a> (08Х18Н10)</strong> — базовая марка
						пищевого оборудования: 17,5–19,5 % хрома и 8,0–10,5 % никеля по ASTM A240. Atlas Steels называет
						типичным применением оборудование для пивоварения, переработки молока и виноделия, а также кухонные
						столы и мойки.
					</li>
					<li>
						<strong>AISI 304L (03Х18Н11)</strong> — то же с углеродом до 0,030 %: для сварных узлов. EHEDG
						отмечает, что 304L легче сваривается.
					</li>
					<li>
						<strong><a href="/list-nerzhaveyushchiy/aisi-316l/">AISI 316L</a> (03Х17Н14М3)</strong> — то же, плюс
						молибден 2–3 %. Нужен там, где есть соли, кислоты, рассолы или хлорная мойка. Atlas Steels называет
						316 типичной сталью для пищевого оборудования в хлоридных средах, EHEDG — для труб и сосудов.
					</li>
				</ul>
				<p>
					Все три — аустенитные, не магнитятся в отожжённом состоянии, хорошо свариваются и полируются. Почему
					именно аустенит, а не феррит или мартенсит, — в статье
					<a href="/blog/vidy-nerzhaveyushchey-stali/"> виды нержавеющей стали</a>. Сталь 321 (12Х18Н10Т)
					стабилизирована титаном и стойка к межкристаллитной коррозии после нагрева, но Atlas Steels отмечает,
					что она плохо полируется и не рекомендуется для декоративных изделий.
				</p>
			</section>

