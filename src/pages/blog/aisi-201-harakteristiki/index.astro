---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sostav', anchor: 'Состав и аналоги', summary: 'ASTM A240, EN 1.4372, ГОСТ и ТУ' },
	{ id: 'svoystva', anchor: 'Прочность и физика', summary: 'Предел текучести, плотность' },
	{ id: 'magnitnost', anchor: 'Магнитность', summary: 'Почему магнитится после гибки' },
	{ id: 'korroziya', anchor: 'Коррозионная стойкость', summary: 'Почему ниже, чем у 304' },
	{ id: 'primenenie', anchor: 'Где применять', summary: 'Интерьер — да, побережье — нет' },
	{ id: 'sravnenie', anchor: '201, 304 и 430', summary: 'Сравнительная таблица' },
	{ id: 'otlichit', anchor: 'Как отличить от 304', summary: 'Магнит, анализатор, сертификат' },
];

const faq = [
	{
		q: 'AISI 201 — это нержавейка?',
		a: 'Да, это коррозионно-стойкая аустенитная сталь: по ASTM A240 в ней 16–18 % хрома. Но её стойкость ниже, чем у AISI 304, — меньше хрома и никеля. В сухих помещениях и в неагрессивной городской атмосфере 201 работает хорошо, а у моря и у дорог с реагентами на ней появляется ржавый налёт.',
	},
	{
		q: 'Какой российский аналог AISI 201?',
		a: 'Точного аналога в ГОСТ 5632-2014 нет. В торговле 201 обозначают как 12Х15Г9НД, но это марка по ТУ, и по данным поставщиков в ней меньше хрома (14–16,5 %) и никеля (1–1,5 %), чем в 201 по ASTM. Ближайшая по составу марка из ГОСТ 5632-2014 — 12Х17Г9АН4: Cr 16–18 %, Ni 3,5–4,5 %, Mn 8–10,5 %. Европейский аналог — 1.4372.',
	},
	{
		q: 'Магнитится ли AISI 201?',
		a: 'После отжига — нет, после холодной деформации — да. Никеля в 201 мало, аустенит нестабилен, и при гибке, штамповке или вытяжке часть его превращается в магнитный мартенсит деформации. Поэтому гнутые детали и трубы из 201 могут заметно притягивать магнит, а отличить 201 от 304 магнитом нельзя.',
	},
	{
		q: 'Что прочнее — AISI 201 или 304?',
		a: 'AISI 201. По ASTM A240 предел текучести листа 201 — от 260 МПа (у варианта 201-2 — от 310 МПа), у 304 — от 205 МПа. По EN 10088-2 разница больше: от 350 МПа у 1.4372 против 230 МПа у 1.4301. Обратная сторона — 201 труднее гнуть и вытягивать.',
	},
	{
		q: 'Можно ли AISI 201 использовать на улице?',
		a: 'Вдали от моря и дорог с реагентами — для неответственных изделий можно: ISSF отмечает положительный опыт. В промышленной атмосфере — с ограничениями и регулярной мойкой. На побережье и у дорог, которые посыпают солью, ISSF стали серии 200 не рекомендует — там берут 316L.',
	},
	{
		q: 'Подходит ли AISI 201 для посуды и пищевых изделий?',
		a: 'Для посуды и столовых приборов у марок типа 201 положительный опыт, но с оговорками. ISSF советует избегать сред с pH ниже 3 — например, уксуса и лимонного сока — и сомневается, что посуда из таких сталей хорошо переносит посудомоечную машину. Для пищевого оборудования, которое работает с кислотами и рассолами, берут 304 или 316L.',
	},
];

const sources = [
	{ label: 'ASTM A240/A240M — химический состав (Table 1) и механические свойства листа (Table 2), варианты 201-1 и 201-2', href: 'https://blog.thepipingmart.com/wp-content/uploads/2021/02/ASTM-A240-A240M.pdf' },
	{ label: 'EN 10088-2 — механические свойства 1.4372 и 1.4301 (сводная таблица Guanyu Tube)', href: 'https://tubingchina.com/EN-10088-2-Ambient-Temperature-Mechanical-Properties-of-Austenitic-Stainless-Steel.htm' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — марка 12Х17Г9АН4', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ISSF — «New 200-series steels: An opportunity or a threat to the image of stainless steel?», 2005', href: 'https://www.centroinox.it/sites/default/files/monografia_pdf/200_series_stainless_steels.pdf' },
	{ label: 'ASSDA — Technical Bulletin «200 Series Stainless Steel: CrMn Grades»', href: 'https://www.assda.asn.au/images/2016/200series.pdf' },
	{ label: 'NKS — Type 201 Stainless Steel: физические свойства, нагартованные состояния по ASTM A666', href: 'https://nks.com/wp-content/uploads/201-Stainless-Steel.pdf' },
	{ label: 'Atlas Steels и EN 10088-1 — физические свойства и стойкость к окислению AISI 304', href: 'https://www.atlassteels.com.au/documents/Atlas%20Grade%20datasheet%20-%20all%20datasheets%20rev%20Aug%202013.pdf' },
	{ label: 'Состав 12Х15Г9НД — справочные данные поставщиков металлопроката (номер ТУ в них не указан)' },
];

const related = [
	{ label: 'Лист AISI 201 (12Х15Г9НД)', href: '/list-nerzhaveyushchiy/aisi-201/' },
	{ label: 'Труба AISI 201 (12Х15Г9НД)', href: '/truba-nerzhaveyushchaya/aisi-201/' },
	{ label: 'Круг AISI 201 (12Х15Г9НД)', href: '/krug-nerzhaveyushchiy/aisi-201/' },
	{ label: 'Характеристики AISI 304, 321 и 316L', href: '/blog/harakteristiki-aisi-304-321-316/' },
	{ label: 'AISI 430: характеристики ферритной нержавейки', href: '/blog/aisi-430-harakteristiki/' },
	{ label: 'Почему ржавеет нержавейка', href: '/blog/pochemu-rzhaveet-nerzhaveyka/' },
];
---

<BlogArticle
	slug="aisi-201-harakteristiki"
	title="AISI 201: характеристики и отличия от AISI 304"
	description="Сталь AISI 201: состав по ASTM A240, аналоги 1.4372 и 12Х15Г9НД, прочность, плотность, магнитность и коррозия. Чем 201 отличается от 304 и 430."
	h1="AISI 201: характеристики и чем отличается от AISI 304"
	eyebrow="Справочник"
	datePublished="2026-09-26"
	dateModified="2026-09-26"
	readingMin={8}
	answer="<strong>AISI 201 — аустенитная хромомарганцевая нержавейка, в которой часть никеля заменена марганцем и азотом: по ASTM A240 в ней 16–18 % хрома, 3,5–5,5 % никеля и 5,5–7,5 % марганца, а в AISI 304 — 17,5–19,5 % хрома и 8–10,5 % никеля.</strong> Она прочнее 304 — предел текучести листа от 260 МПа против 205 МПа, — но хуже сопротивляется хлоридам и кислотам. Её берут для интерьера и сухих помещений, а для побережья, дорог с реагентами и химических сред ISSF её не рекомендует."
	keyFacts={[
		'Состав по ASTM A240: Cr 16–18 %, Ni 3,5–5,5 %, Mn 5,5–7,5 %, N ≤ 0,25 %, C ≤ 0,15 %',
		'Предел текучести листа: от 260 МПа по ASTM A240 (у 304 — от 205), от 350 МПа по EN 10088-2 (у 1.4301 — от 230)',
		'Плотность ≈ 7,8 г/см³; немагнитна после отжига, магнитится после холодной деформации',
		'Аналоги: EN 1.4372; 12Х15Г9НД — марка по ТУ, в ГОСТ 5632-2014 её нет',
		'ISSF: в помещениях — положительный опыт, на побережье и у дорог с реагентами — не рекомендуется',
	]}
	coverAlt="Характеристики стали AISI 201: состав, прочность и отличия от AISI 304 и 430"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['AISI 201', 'AISI 304', 'Хромомарганцевая нержавеющая сталь', '12Х15Г9НД']}
	cta={{ title: 'Нужен прокат AISI 201 или 304?', text: 'Лист, труба и круг из нержавеющей стали — пришлём КП под вашу задачу.' }}
>
	<section id="sostav">
		<h2>Что такое AISI 201 и её химический состав</h2>
		<p>
			AISI 201 (UNS S20100) — аустенитная нержавеющая сталь серии 200. Аустенит в ней держится не только
			за счёт никеля, как в 304, но и за счёт марганца и азота. Хромомарганцевые стали известны с 1930-х
			годов, а широко применять их начали в США в 1950-х, когда не хватало никеля.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка, документ</th><th>C</th><th>Cr</th><th>Ni</th><th>Mn</th><th>N</th><th>Cu</th><th>Si</th><th>P</th><th>S</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 201 — ASTM A240</td><td>0,15</td><td>16,0–18,0</td><td>3,5–5,5</td><td>5,5–7,5</td><td>0,25</td><td>—</td><td>1,00</td><td>0,060</td><td>0,030</td></tr>
					<tr><td>1.4372 — EN 10088</td><td>0,15</td><td>16,0–18,0</td><td>3,5–5,5</td><td>5,5–7,5</td><td>0,05–0,25</td><td>—</td><td>1,00</td><td>0,045</td><td>0,015</td></tr>
					<tr><td>12Х17Г9АН4 — ГОСТ 5632-2014</td><td>0,12</td><td>16,0–18,0</td><td>3,5–4,5</td><td>8,0–10,5</td><td>0,15–0,25</td><td>—</td><td>0,80</td><td>0,035</td><td>0,020</td></tr>
					<tr><td>12Х15Г9НД — ТУ, данные поставщиков</td><td>0,12</td><td>14,0–16,5</td><td>1,0–1,5</td><td>8,5–10,5</td><td>0,20</td><td>2,0</td><td>0,75</td><td>0,060</td><td>0,030</td></tr>
					<tr><td>AISI 304 — ASTM A240, для сравнения</td><td>0,07</td><td>17,5–19,5</td><td>8,0–10,5</td><td>2,0</td><td>0,10</td><td>—</td><td>0,75</td><td>0,045</td><td>0,030</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			ASTM A240 выделяет два варианта 201 в пределах одного состава: 201-1 с более стабильным аустенитом и
			201-2 — с менее стабильным и более прочным. Вариант выбирают под требуемые свойства, прочность у них
			разная (см. таблицу ниже).
		</p>
		<p>
			<strong>Российский аналог.</strong> Марки 12Х15Г9НД в ГОСТ 5632-2014 нет — её выпускают по техническим
			условиям. В справочниках поставщиков её состав немного расходится (марганец 8,5–10 или 8,5–10,5 %), но
			в любом варианте он беднее, чем у 201 по ASTM: хрома 14–16,5 % вместо 16–18 %, никеля 1–1,5 % вместо 3,5–5,5 %,
			плюс до 2 % меди. По этим цифрам 12Х15Г9НД ближе к фирменной марке J4 (Cr 15–16 %, Ni 0,8–1,2 %,
			Cu 1,5–2 % по данным ASSDA), чем к 201.
		</p>
		<p>
			Из ГОСТ 5632-2014 ближе всего к 201 марка 12Х17Г9АН4: хром тот же, никель в более узких пределах,
			марганца больше. ГОСТ рекомендует её для изделий, работающих в атмосферных условиях, как заменитель 12Х18Н9 и
			12Х18Н10Т. Европейский аналог 201 — 1.4372 (X12CrMnNiN17-7-5). Если важен состав, в заказе указывают
			стандарт, а марку подтверждают сертификатом с химическим анализом плавки.
		</p>
	</section>

	<section id="svoystva">
		<h2>Механические и физические свойства</h2>
		<div class="ba-table">
			<table>
				<caption>Лист, минимальные значения в отожжённом состоянии</caption>
				<thead>
					<tr><th>Марка, стандарт</th><th class="num">σв, МПа</th><th class="num">σ0,2, МПа</th><th class="num">δ, %</th><th class="num">Твёрдость, не более</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 201-1 — ASTM A240</td><td class="num">515</td><td class="num">260</td><td class="num">40</td><td class="num">217 HB / 95 HRB</td></tr>
					<tr><td>AISI 201-2 — ASTM A240</td><td class="num">655</td><td class="num">310</td><td class="num">40</td><td class="num">241 HB / 100 HRB</td></tr>
					<tr><td>AISI 304 — ASTM A240</td><td class="num">515</td><td class="num">205</td><td class="num">40</td><td class="num">201 HB / 92 HRB</td></tr>
					<tr><td>1.4372 — EN 10088-2, холоднокатаная полоса до 8 мм</td><td class="num">750–950</td><td class="num">350</td><td class="num">45</td><td class="num">не нормируется</td></tr>
					<tr><td>1.4301 — EN 10088-2, холоднокатаная полоса до 8 мм</td><td class="num">540–750</td><td class="num">230</td><td class="num">45</td><td class="num">не нормируется</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			По ASTM A240 временное сопротивление 201-1 такое же, как у 304, а предел текучести выше на 27 %.
			По EN 10088-2 разница больше: 350 МПа у 1.4372 против 230 МПа у 1.4301. ISSF и ASSDA оценивают
			выигрыш по пределу текучести примерно в 30 %: азот упрочняет сталь. За прочность платят
			формуемостью — гнуть и вытягивать 201 труднее, чем 304.
		</p>
		<p>
			При холодной деформации 201 быстро упрочняется. По ASTM A666 ленту 201 выпускают в нагартованных
			состояниях от 1/4 hard (σв от 860 МПа) до full hard (σв от 1275 МПа). ISSF предупреждает, что у
			хромомарганцевых сталей с пониженным никелем после глубокой вытяжки возможно замедленное
			растрескивание.
		</p>
		<div class="ba-table">
			<table>
				<caption>Физические свойства</caption>
				<thead>
					<tr><th>Свойство</th><th>AISI 201</th><th>AISI 304</th></tr>
				</thead>
				<tbody>
					<tr><td>Плотность</td><td>≈ 7,8 г/см³</td><td>7,9 г/см³</td></tr>
					<tr><td>Модуль упругости</td><td>197 ГПа</td><td>193–200 ГПа</td></tr>
					<tr><td>Теплопроводность при 100 °C</td><td>16,3 Вт/(м·К)</td><td>16,1–16,3 Вт/(м·К)</td></tr>
					<tr><td>Коэффициент теплового расширения до 100 °C</td><td>15,7–16,6 × 10⁻⁶ 1/К</td><td>16,0–17,2 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Удельная теплоёмкость</td><td>≈ 500 Дж/(кг·К)</td><td>500 Дж/(кг·К)</td></tr>
					<tr><td>Удельное электросопротивление</td><td>0,69 мкОм·м</td><td>0,72–0,73 мкОм·м</td></tr>
					<tr><td>Интервал плавления</td><td>1400–1455 °C</td><td>1400–1450 °C</td></tr>
					<tr><td>Окисление на воздухе: периодически / постоянно</td><td>до 815 / 840 °C</td><td>до 870 / 925 °C</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Данные по 201 — из технических листов поставщиков (NKS, Tempered &amp; Specialty Metals), пересчитаны
			из дюймовых единиц; по 304 — Atlas Steels и EN 10088-1. Для расчёта массы листа и трубы из 201 берут
			плотность 7,8 г/см³ — металл на 1–2 % легче, чем 304.
		</p>
	</section>

	<section id="magnitnost">
		<h2>Магнитится ли AISI 201</h2>
		<p>
			В отожжённом состоянии AISI 201 немагнитна: как и 304, это аустенит. После холодной деформации —
			гибки, штамповки, вытяжки, прокатки — она начинает притягивать магнит. Причина в том, что никеля мало
			и аустенит нестабилен: при деформации часть структуры превращается в мартенсит деформации, а он
			ферромагнитен. ISSF отмечает, что склонность к такому превращению растёт по мере снижения никеля.
		</p>
		<p>
			У 304 аустенит стабильнее, поэтому после той же обработки она магнитится слабее. Практический вывод:
			магнитом 201 от 304 не отличить — после отжига не магнитятся обе, на гибах и в трубах магнитятся обе,
			только в разной степени. О коррозионной стойкости магнитность тоже ничего не говорит. Подробнее — в
			статье <a href="/blog/magnitit-li-nerzhaveika/">магнитится ли нержавейка</a>.
		</p>
	</section>

	<section id="korroziya">
		<h2>Коррозионная стойкость: почему ниже, чем у 304</h2>
		<ul>
			<li><strong>Меньше хрома.</strong> Нижняя граница у 201 — 16 %, у 304 — 17,5 %. Хром образует пассивную плёнку, и чем его меньше, тем ниже стойкость к питтингу во влажной среде с хлоридами.</li>
			<li><strong>Меньше никеля.</strong> Никель важен в кислой среде и в щелях. По данным ISSF, при низком pH стойкость к щелевой коррозии растёт с содержанием никеля, а у марок с 1 % никеля скорость растворения металла в щели в 10 раз выше, чем у 304.</li>
			<li><strong>Больше углерода.</strong> До 0,15 % против 0,07 % у 304. После сварки в зоне термовлияния возможна межкристаллитная коррозия. Для сварных узлов в ASTM A240 есть низкоуглеродистые версии с C ≤ 0,03 % — UNS S20103 и 201LN (S20153).</li>
			<li><strong>Примеси.</strong> ISSF и ASSDA описывают партии сталей серии 200 от мелких производителей с повышенной серой и углеродом. Сера снижает стойкость к питтингу.</li>
		</ul>
		<p>
			В испытании ISSF в солевом тумане (575 часов) образцы хромомарганцевых сталей с 4 % и 1 % никеля
			заметно прокорродировали, и ISSF называет такие марки непригодными для морской среды. В помещениях, а
			для неответственных изделий и на улице вдали от моря, 201 работает нормально.
		</p>
		<p>
			Отдельный риск — «новые» марки серии 200 с 15 % хрома и около 1 % никеля. ISSF и ASSDA подчёркивают,
			что это фирменные составы вне международных стандартов, их стойкость ниже, чем у 201 по ASTM, а
			продают их иногда под видом 304.
		</p>
	</section>

	<section id="primenenie">
		<h2>Где AISI 201 уместна, а где нельзя</h2>
		<p>
			ISSF обобщил опыт применения «стандартных» марок серии 200 — с 4 % никеля и не меньше 16 % хрома,
			как у 201 по ASTM. Для марок с 1 % никеля ограничения жёстче.
		</p>
		<div class="ba-table">
			<table>
				<caption>Опыт применения по данным ISSF</caption>
				<thead>
					<tr><th>Условия</th><th>Опыт с 201 (4 % Ni)</th><th>Если 201 не подходит</th></tr>
				</thead>
				<tbody>
					<tr><td>Интерьер, сухие помещения</td><td>Положительный</td><td>—</td></tr>
					<tr><td>Столовые приборы, посуда</td><td>Положительный; для посуды — хрома не меньше 16 %</td><td>—</td></tr>
					<tr><td>Улица вдали от моря, неответственные изделия</td><td>Положительный</td><td>304</td></tr>
					<tr><td>Промышленная атмосфера</td><td>С ограничениями и обслуживанием; хрома не меньше 17,5 %</td><td>304</td></tr>
					<tr><td>Пищевые среды</td><td>Положительный; избегать pH ниже 3</td><td>304, для кислот и рассолов — 316L</td></tr>
					<tr><td>Посудомоечные машины</td><td>Очень ограниченный, риск щелевой коррозии</td><td>304</td></tr>
					<tr><td>Побережье, дороги с реагентами</td><td>Не рекомендуется</td><td>316L</td></tr>
					<tr><td>Кислоты и химические среды, химические цистерны</td><td>Не рекомендуется</td><td>316L и выше</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Отсюда типичные задачи для 201: облицовка и декоративные панели внутри зданий, ограждения, перила и
			поручни в помещениях, мебель и торговое оборудование, декоративные конструкции из трубы. Если изделие
			стоит на побережье или у дороги с реагентами, контактирует с кислыми продуктами или химией, 201
			заменяют на 304 или 316L. Сортамент — на странице
			<a href="/list-nerzhaveyushchiy/aisi-201/">листа AISI 201</a>.
		</p>
	</section>

	<section id="sravnenie">
		<h2>Сравнение AISI 201, 304 и 430</h2>
		<div class="ba-table">
			<table>
				<caption>Лист по ASTM A240; плотность — справочная</caption>
				<thead>
					<tr><th>Показатель</th><th>AISI 201</th><th>AISI 304</th><th>AISI 430</th></tr>
				</thead>
				<tbody>
					<tr><td>Структура</td><td>Аустенит</td><td>Аустенит</td><td>Феррит</td></tr>
					<tr><td>Хром, %</td><td>16,0–18,0</td><td>17,5–19,5</td><td>16,0–18,0</td></tr>
					<tr><td>Никель, %</td><td>3,5–5,5</td><td>8,0–10,5</td><td>≤ 0,75</td></tr>
					<tr><td>Марганец, %</td><td>5,5–7,5</td><td>≤ 2,0</td><td>≤ 1,0</td></tr>
					<tr><td>Углерод, %</td><td>≤ 0,15</td><td>≤ 0,07</td><td>≤ 0,12</td></tr>
					<tr><td>σв, МПа, не менее</td><td>515 (201-1) / 655 (201-2)</td><td>515</td><td>450</td></tr>
					<tr><td>σ0,2, МПа, не менее</td><td>260 / 310</td><td>205</td><td>205</td></tr>
					<tr><td>δ, %, не менее</td><td>40</td><td>40</td><td>22</td></tr>
					<tr><td>Плотность, г/см³</td><td>≈ 7,8</td><td>7,9</td><td>7,7</td></tr>
					<tr><td>Магнитность</td><td>Нет после отжига, магнитится после деформации</td><td>Нет после отжига, слабо после деформации</td><td>Магнитна всегда</td></tr>
					<tr><td>Стойкость к хлоридам</td><td>Ниже, чем у 304</td><td>Базовая для аустенита</td><td>Ниже, чем у 304</td></tr>
					<tr><td>Аналоги</td><td>1.4372; 12Х15Г9НД (ТУ)</td><td>1.4301; 08Х18Н10</td><td>1.4016; 12Х17</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Против 304 у 201 два плюса — выше предел текучести и меньше никеля в составе — и два минуса: ниже
			коррозионная стойкость и хуже формуемость. Против 430 у 201 преимущества аустенитной структуры: по
			данным ASSDA аустенит лучше гнётся и сваривается, чем феррит, и сохраняет вязкость на морозе. У 430
			свои плюсы: в ней нет никеля, она не склонна к хлоридному коррозионному растрескиванию под
			напряжением и меньше расширяется при нагреве.
			Подробные свойства 304 — в статье <a href="/blog/harakteristiki-aisi-304-321-316/">характеристики AISI
			304, 321 и 316L</a>.
		</p>
	</section>

	<section id="otlichit">
		<h2>Как отличить AISI 201 от AISI 304</h2>
		<div class="ba-table">
			<table>
				<caption>Способы проверки</caption>
				<thead>
					<tr><th>Способ</th><th>Отличает 201 от 304?</th><th>Комментарий</th></tr>
				</thead>
				<tbody>
					<tr><td>Магнит</td><td>Нет</td><td>После отжига не магнитятся обе, после деформации магнитятся обе — 201 сильнее</td></tr>
					<tr><td>Внешний вид, масса</td><td>Нет</td><td>Поверхности одинаковые, плотность отличается на 1–2 %</td></tr>
					<tr><td>Капельный тест на никель</td><td>Подсказка</td><td>Реактив с диметилглиоксимом окрашивается на 304 ярче; результат зависит от навыка</td></tr>
					<tr><td>Портативный XRF-анализатор</td><td>Да</td><td>Показывает никель и марганец за несколько секунд; углерод не определяет</td></tr>
					<tr><td>Спектральный анализ в лаборатории</td><td>Да</td><td>Полный состав, включая углерод</td></tr>
					<tr><td>Сертификат с химическим анализом плавки</td><td>Да</td><td>Если сертификат относится именно к этой партии</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Самый быстрый способ — портативный анализатор. По ASTM A240 в 304 никеля не меньше 8 % и марганца не
			больше 2 %. Если прибор показывает марганец выше 5 % и никель ниже 6 %, это не 304 — скорее всего,
			сталь серии 200.
			Как отличить нержавейку от обычной стали и откуда берётся ржавчина на 201 — в статье
			<a href="/blog/pochemu-rzhaveet-nerzhaveyka/">почему ржавеет нержавейка</a>.
		</p>
	</section>
