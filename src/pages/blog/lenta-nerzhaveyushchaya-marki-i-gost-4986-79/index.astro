const faq = [
	{
		q: 'Что такое лента 12Х18Н10Т?',
		a: 'Холоднокатаная лента из аустенитной хромоникелевой стали, стабилизированной титаном. По ГОСТ 5632-2014 в стали до 0,12 % углерода, 17–19 % хрома, 9–11 % никеля и титан от 5×C до 0,80 %. Размеры и состояния поставки ленты задаёт ГОСТ 4986-79: толщина 0,05–2,0 мм, ширина 6–410 мм, состояния М, ПН, Н и ВН. Ближайший зарубежный аналог стали — AISI 321 (1.4541). Титан сохраняет стойкость к межкристаллитной коррозии после сварки и нагрева до 450–850 °C.',
	},
