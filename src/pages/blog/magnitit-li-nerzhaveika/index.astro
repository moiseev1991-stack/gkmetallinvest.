		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		text-decoration: none;
		transform: translateY(-1px);
	}
	.post__toc a strong {
		font-size: 0.9rem;
		color: var(--color-primary-600);
		font-weight: 600;
	}
	.post__toc a span {
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.35;
	}

	/* Body */
	.post__body {
		max-width: 75ch;
		display: grid;
		gap: var(--space-7);
	}
	.post__section {
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}
	.post__section h2 {
		font-size: 1.35rem;
		line-height: 1.3;
		margin: 0 0 var(--space-3);
		letter-spacing: -0.01em;
	}
	.post__section p,
	.post__section ul,
	.post__section ol {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-text);
		margin: 0 0 var(--space-3);
	}
	.post__section ul,
	.post__section ol {
