---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../../data/site';

const title = 'Магнитится ли нержавейка: какие марки магнитные';
const description = 'Магнитится ли нержавейка: AISI 304, 316L, 321 — нет в отожжённом виде; 430, 410, 420 и дуплекс 2205 — да. Наклёп, сварной шов и почему магнит не определяет марку.';

const datePublished = '2026-05-22';
const dateModified = '2026-10-06';
const url = `${siteUrl.replace(/\/$/, '')}/blog/magnitit-li-nerzhaveika/`;
const cover = '/img/blog/magnitit-li-nerzhaveika.svg';

/* Структура поста — массив H2-секций. Удобно итерировать и рендерить TOC. */
const sections = [
	{
		id: 'austenit',
		anchor: 'Аустенит',
		title: 'Аустенитные марки — НЕ магнитятся',
		summary: 'AISI 304, 316L, 321 — гранецентрированная решётка γ-Fe.',
	},
	{
		id: 'ferrit-martensit',
		anchor: 'Феррит, мартенсит, дуплекс',
		title: 'Ферритные, мартенситные и дуплексные — магнитятся',
		summary: 'AISI 430, 20Х13, 40Х13, 2205 — какие марки магнитные.',
	},
	{
		id: 'tablica',
		anchor: 'Таблица по маркам',
		title: 'Какие марки нержавейки магнитятся: таблица',
		summary: '304, 316L, 321, 201, 430, 420, 2205 — до и после деформации.',
	},
	{
		id: 'naklep',
		anchor: 'Наклёп и сварной шов',
		title: 'Почему AISI 304 может слабо притягивать магнит',
		summary: 'Мартенсит деформации α′-Fe после гибки, феррит в сварном шве.',
	},
	{
		id: 'proverit',
		anchor: 'Проверка магнитом',
		title: 'Как проверить магнитом и почему он не определяет марку',
		summary: 'Точки замера, интерпретация результата, что делать дальше.',
	},
];

const magnetRows = [
	{ mark: '304 (08Х18Н10)', cls: 'Аустенитная', annealed: 'Не магнитится: проницаемость около 1,02', worked: 'Край реза, сгиб, отверстие могут притягивать магнит, после сильного наклёпа — заметно; шов — слабо' },
	{ mark: '321 (12Х18Н10Т)', cls: 'Аустенитная, с титаном', annealed: 'Не магнитится (EN 10088-1, данные Outokumpu)', worked: 'Возможно слабое притяжение у шва и зон наклёпа' },
	{ mark: '316L (03Х17Н14М3)', cls: 'Аустенитная, с молибденом', annealed: 'Не магнитится', worked: 'После наклёпа в большинстве случаев почти не реагирует; шов — слабо' },
	{ mark: '201 (12Х15Г9НД, по ТУ)', cls: 'Аустенитная хромомарганцевая', annealed: 'Не магнитится (Outokumpu, Core 201)', worked: 'Магнитный отклик после деформации возможен: хромомарганцевые стали чувствительны к мартенситному превращению, особенно при пониженном никеле (ISSF)' },
	{ mark: '430 (12Х17)', cls: 'Ферритная', annealed: 'Магнитится, как углеродистая сталь', worked: 'Магнитна и после деформации' },
	{ mark: '410, 420 (12Х13, 20Х13, 30Х13, 40Х13)', cls: 'Мартенситная', annealed: 'Магнитятся, как углеродистая сталь', worked: 'Магнитны и после деформации' },
	{ mark: '2205 (03Х22Н5АМ3)', cls: 'Дуплексная', annealed: 'Магнитится: феррита обычно 40–50 %', worked: 'Магнитна и после деформации' },
];

const faq = [
	{
		q: 'Магнитится ли AISI 304?',
		a: 'В отожжённом состоянии — нет: у аустенитных сталей 300-й серии магнитная проницаемость около 1,02, магнит почти не реагирует. AISI 304 (08Х18Н10) — аустенитная сталь. После холодной деформации — гибки, штамповки, сверления — края реза и сгибы могут притягивать магнит, а после сильного наклёпа — заметно (Atlas Steels); Outokumpu отмечает, что холодная формовка может оставить 304 слегка магнитной. Слабо магнитится и сварной шов. Это не означает брак: подробнее — в разделе про <a href="#naklep">наклёп и сварной шов</a>.',
	},
	{
		q: 'Магнитится ли AISI 316L?',
		a: 'Нет. AISI 316L (03Х17Н14М3) — аустенитная сталь с 10–14 % никеля и 2–3 % молибдена по ASTM A240. Отношение никеля к хрому у неё выше, чем у 304, аустенит устойчивее: после сильного наклёпа 316 в большинстве случаев почти не реагирует на магнит, тогда как 304 может притягивать заметно (Atlas Steels). Слабое притяжение возможно у сварного шва из-за феррита. Если немагнитность важна по проекту, её нужно оговорить при заказе.',
	},
	{
		q: 'Магнитится ли AISI 321 / 12Х18Н10Т?',
		a: 'В отожжённом состоянии — нет. AISI 321 (12Х18Н10Т) — аустенит, стабилизированный титаном; по EN 10088-1 (данные Outokumpu) он не намагничивается. После холодной деформации и у сварного шва возможно слабое притяжение, как у других аустенитных сталей: Atlas Steels отмечает, что после наклёпа картина менее однозначна. Магнитом марка не определяется.',
	},
	{
		q: 'Как отличить пищевую нержавейку от обычной стали магнитом?',
		a: 'Магнит даёт ограниченный сигнал. Обычная углеродистая сталь притягивает его сильно, отожжённый аустенит (304, 316L) — нет, поэтому эти два случая магнит разделяет. Но ферритная AISI 430 и мартенситные 12Х13–40Х13 тоже магнитятся, хотя это нержавеющие стали, а деформированная 304 притягивает слабо. Отличить ферритную 430 от углеродистой стали, а также 304 от 316L или от хромомарганцевой 201 магнит не может: нужен реактив, XRF-анализ или сертификат плавки.',
	},
	{
		q: 'Если нержавейка магнитится — это брак?',
		a: 'Нет, если в сертификате указана ферритная, мартенситная или дуплексная марка (AISI 430, 20Х13, 30Х13, 40Х13, 2205) — они магнитятся штатно. Если в сертификате стоит AISI 304, 316L или 321 и магнитится только зона у реза, сгиба или шва, это мартенсит деформации или феррит шва — тоже штатное явление. Если же аустенитная по документам сталь притягивает магнит по всему листу без следов деформации, сверьте сертификат и маркировку: возможно, пришла другая марка или металл сильно нагартован, при сомнении — XRF-анализ.',
	},
	{
		q: 'Какая нержавейка магнитная: какие марки магнитятся?',
		a: 'Магнитятся ферритные марки — AISI 430 (12Х17), 409, 439, мартенситные — 410 (12Х13) и 420 (20Х13, 30Х13, 40Х13) и дуплексные, например 2205 (03Х22Н5АМ3). Atlas Steels отмечает, что все нержавеющие стали, кроме аустенитных, сильно притягиваются магнитом; IMOA называет ферритные и мартенситные стали ферромагнитными, как углеродистая, а дуплексные — ферромагнитными из-за феррита. Для соленоидов и электромагнитных клапанов есть магнитомягкие ферритные нержавеющие стали с гарантированными свойствами — их заказывают отдельно.',
	},
	{
		q: 'Магнитится ли сварной шов на нержавейке?',
		a: 'Слабо. В швах аустенитных сталей специально оставляют примерно 5–12 % феррита: он снижает риск горячих трещин и реагирует на магнит, по этому отклику феррит измеряют специальными приборами (Atlas Steels). Стандартные аустенитные стали содержат 1–5 % δ-феррита и в основном металле, поэтому слегка ферромагнитны (IMOA). Слабое притяжение шва на 304 или 316L — не признак другой марки.',
	},
	{
		q: 'Можно ли определить марку нержавейки магнитом?',
		a: 'Нет. Магнит показывает структуру: аустенитная сталь (304, 316L, 321, 201) не притягивает, ферритная, мартенситная и дуплексная — притягивает. 304 от 316L он не отличит, от хромомарганцевой 201 — тем более: ISSF описывает случаи, когда сталь серии 200 продавали как 304, и предупреждает, что «немагнитная» не значит «хромоникелевая». Марку подтверждают сертификатом плавки, реактивом на молибден или XRF-анализом — подробнее в статье <a href="/blog/kak-proverit-nerzhaveyku/">как проверить нержавейку</a>.',
	},
	{
		q: 'Как убрать магнитность нержавейки после гибки?',
		a: 'Нагревом. По данным Atlas Steels, снятие напряжений при 700–800 °C возвращает аустенитную сталь в немагнитное состояние, но у нестабилизированных марок такой нагрев может вызвать выпадение карбидов. Полная закалка на твёрдый раствор при 1000–1150 °C убирает магнитный отклик без потери коррозионной стойкости.',
	},
];

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: 'Магнитится ли нержавейка: какие марки магнитные',
	description,
	image: `${siteUrl.replace(/\/$/, '')}${cover}`,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	datePublished,
	dateModified,
	author: { '@type': 'Organization', name: siteName, url: siteUrl },
	publisher: {
		'@type': 'Organization',
		name: siteName,
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl.replace(/\/$/, '')}/favicon.svg` },
	},
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
	})),
};
---

<BaseLayout title={title} description={description} image={cover} type="article" jsonLd={[articleJsonLd, faqJsonLd]}>
	<div class="container post">
		<Breadcrumbs items={[
			{ label: 'Главная', href: '/' },
			{ label: 'Блог', href: '/blog/' },
			{ label: 'Магнитится ли нержавейка' },
		]} />

		<header class="post__hero">
			<span class="post__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M4 2v6a4 4 0 0 0 8 0V2M4 2h2v3H4M10 2h2v3h-2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
				</svg>
				Статья · разбор
			</span>
			<h1 class="post__h1">Магнитится ли нержавейка: какие марки магнитные</h1>
			<div class="post__meta">
				<time datetime={datePublished}>22 мая 2026</time>
				<span>·</span>
				<span>обновлено <time datetime={dateModified}>6 октября 2026</time></span>
				<span>·</span>
				<span>чтение 10 минут</span>
			</div>
			<p class="post__lead">
				<strong>Короткий ответ: зависит от структуры стали, а не от марки в названии.</strong>
				Аустенитные AISI 304, 316L и 321 в отожжённом виде не магнитятся (магнитная проницаемость около 1,02 по Atlas Steels).
				Магнитная нержавеющая сталь — это ферритные (AISI 430, 12Х17), мартенситные (410 и 420:
				12Х13, 20Х13–40Х13) и дуплексные (2205) марки. Аустенит может слабо притягивать магнит после холодной
				деформации и у сварного шва — это не брак. Магнит показывает структуру, а не марку: 304 он не
				отличит от 316L и от хромомарганцевой 201 (<a href="/blog/kak-proverit-nerzhaveyku/">как проверить нержавейку</a>).
			</p>
		</header>

		<figure class="post__cover">
			<img
				src={cover}
				alt="Магнитится ли нержавейка — аустенит не магнитится, феррит и мартенсит магнитятся"
				width="1200"
				height="630"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<nav class="post__toc" aria-label="Содержание">
			<div class="post__toc-title">На странице</div>
			<ul>
				{sections.map((s) => (
					<li>
						<a href={`#${s.id}`}>
							<strong>{s.anchor}</strong>
							<span>{s.summary}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<article class="post__body">
			<section class="post__section" id="austenit">
				<h2>Аустенитные марки — НЕ магнитятся</h2>
				<p>
					Аустенитные нержавеющие стали — это всё ходовое «пищевое» и «промышленное»
					семейство: AISI 304 (08Х18Н10), AISI 316L (03Х17Н14М3), AISI 321 (12Х18Н10Т),
					экономичная AISI 201, жаропрочная AISI 310S. Их объединяет одно — аустенитная структура,
					которую удерживают никель (8,0–10,5 % у 304, 10–14 % у 316L по ASTM A240), а в 201 —
					марганец и азот при 3,5–5,5 % никеля.
				</p>
				<p>
					γ-Fe (гамма-железо) кристаллизуется в гранецентрированной кубической решётке
					(ГЦК). Эта решётка <strong>парамагнитна</strong> — постоянное магнитное поле
					в ней не выстраивается: у аустенитных сталей 300-й серии в отожжённом состоянии магнитная
					проницаемость около 1,02 (Atlas Steels). Поэтому если приложить магнит к листу AISI 304 толщиной
					2 мм или к трубе AISI 316L — реакции не будет. Эту проверку часто называют «тест
					магнитом», но она показывает только структуру, а не марку: магнит не отличит
					304 от 316L или от хромомарганцевой 201, все три аустенитные.
				</p>
				<p>
					Строго говоря, в стандартных аустенитных сталях есть 1–5 % δ-феррита, и по данным IMOA они
					слегка ферромагнитны. На бытовом магните это не видно, но заметно в швах — об этом ниже.
				</p>
			</section>

			<section class="post__section" id="ferrit-martensit">
				<h2>Ферритные, мартенситные и дуплексные — магнитятся</h2>
				<p>
					<strong>Ферритные марки</strong> — AISI 430 (12Х17), AISI 409, AISI 439. Это хромистые стали
					без никеля: по ASTM A240 в 430 его не больше 0,75 %, по ГОСТ 5632-2014 в 12Х17 — остаточный
					никель до 0,60 %. Кристаллическая решётка — α-Fe (альфа-железо), объёмно-центрированная
					кубическая (ОЦК). Она <strong>ферромагнитна</strong> — магнит к ней прилипает плотно, как
					к углеродистой стали (IMOA).
				</p>
				<p>
					<strong>Мартенситные и мартенсито-ферритные марки</strong> — 12Х13 (AISI 410), 20Х13,
					30Х13, 40Х13 (AISI 420), AISI 440. Углерода в них больше, чем в ферритных: от 0,09–0,15 %
					у 12Х13 до 0,36–0,45 % у 40Х13 (ГОСТ 5632-2014), поэтому они закаливаются на твёрдость. Мартенсит — это
					пересыщенный твёрдый раствор углерода в α-Fe, той же ОЦК-решётке, что и феррит,
					только с искажениями. Магнитные свойства те же — притяжение есть.
				</p>
				<p>
					<strong>Дуплексные марки</strong> — AISI 2205 (03Х22Н5АМ3) и другие — сочетают аустенит и феррит,
					у 2205 феррита обычно 40–50 %. IMOA называет дуплексные стали ферромагнитными, поэтому магнит
					их притягивает.
				</p>
				<p>
					Поэтому если у вас в руках лист AISI 430 (ходовая ферритная сталь для бытовой техники и
					кухонного оборудования), мойка раковины из «нержавейки эконом-класса» или вал из 20Х13 — магнит
					притянется уверенно. Это не подделка: ферритные и мартенситные стали действительно
					нержавеющие, просто другого класса по структуре. ISSF прямо называет заблуждением мнение, что
					магнитные ферритные стали «ржавеют как углеродистая»: коррозионная стойкость определяется составом,
					прежде всего хромом, а магнитность к ней отношения не имеет. См. <a href="/list-nerzhaveyushchiy/aisi-430/">AISI 430</a>
					и <a href="/krug-nerzhaveyushchiy/">сортовой прокат 20Х13–40Х13</a>.
				</p>
			</section>

			<section class="post__section" id="tablica">
				<h2>Какие марки нержавейки магнитятся: таблица</h2>
				<p>
					Магнитную нержавеющую сталь определяет структура, а не название марки. В таблице — самые
					ходовые марки проката: что с магнитом в отожжённом состоянии и после деформации.
				</p>
				<div class="post__table-wrap">
					<table class="post__table">
						<thead>
							<tr>
								<th scope="col">Марка (AISI / ГОСТ)</th>
								<th scope="col">Класс</th>
								<th scope="col">Отожжённая, без деформации</th>
								<th scope="col">После холодной деформации, у сварного шва</th>
							</tr>
						</thead>
						<tbody>
							{magnetRows.map((r) => (
								<tr>
									<th scope="row">{r.mark}</th>
									<td>{r.cls}</td>
									<td>{r.annealed}</td>
									<td>{r.worked}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p class="post__note">
					Данные: Atlas Steels (Technical Handbook, раздел Magnetic Properties), таблицы физических свойств по
					EN 10088-1 в справочниках Outokumpu, руководства IMOA по аустенитным и дуплексным сталям, ISSF.
					Реакция зависит и от конкретной плавки: даже в пределах одного стандарта скорость появления
					магнитного отклика при наклёпе может заметно различаться (Atlas Steels).
				</p>
			</section>

			<section class="post__section" id="naklep">
				<h2>Почему AISI 304 может слабо притягивать магнит: наклёп и сварной шов</h2>
				<p>
					Самая частая ситуация в цеху: пришёл лист AISI 304 с сертификатом, на ровном
					участке магнит не липнет — но по краю реза, по сгибу или вокруг просверленного
					отверстия магнит начинает чувствоваться. Покупатель решает, что подсунули
					фальсификат. На самом деле это штатное физическое явление — <strong>мартенситное
					превращение при деформации</strong>.
				</p>
				<p>
					Холодная пластическая деформация (прокатка, гибка, штамповка, сверление, резка)
					искажает кристаллическую решётку, и часть аустенита (γ-Fe) в этих зонах превращается в α′-Fe
					(α-штрих) — мартенсит деформации. Он ферромагнитен, отсюда и слабое прилипание магнита по краям
					и сгибам. Чем выше отношение никеля к хрому, тем стабильнее аустенит и тем слабее магнитный отклик
					после наклёпа (Atlas Steels): после сильной деформации 304 может притягивать магнит ощутимо, а 316 и 310
					в большинстве случаев остаются почти немагнитными. Outokumpu в справочном листе на 304
					предупреждает, что холодная формовка может оставить металл слегка магнитным.
				</p>
				<p>
					<strong>Сварной шов.</strong> В швах аустенитных сталей специально оставляют около 5–12 % феррита —
					он помогает избежать горячих трещин и слабо реагирует на магнит; по этому отклику феррит и
					измеряют специальными приборами (Atlas Steels). Поэтому шов на немагнитной 304 или 316L может слегка
					притягивать магнит, а основной металл рядом — нет.
				</p>
				<p>
					Вернуть немагнитное состояние можно нагревом. По данным Atlas Steels, снятие напряжений при
					700–800 °C убирает магнитный отклик, но у нестабилизированных марок такой нагрев рискует вызвать
					выпадение карбидов; полная закалка на твёрдый раствор при 1000–1150 °C убирает его без потери
					коррозионной стойкости.
				</p>
			</section>

			<section class="post__section" id="proverit">
				<h2>Как проверить марку магнитом дома — и почему он не определяет марку</h2>
				<p>
					Бытовой ферритовый магнит со старой колонки или холодильника слабоват — он может
					ложно «не показать» наклёпанный аустенит и наоборот не отличить сильное
					притяжение от слабого. Возьмите <strong>неодимовый магнит</strong> — это
					рабочий инструмент.
				</p>
				<ol>
					<li>
						<strong>Приложите к ровному участку.</strong> Середина листа, гладкая часть
						трубы, тело круга — туда, где металл не пилили и не гнули.
					</li>
					<li>
						<strong>Приложите к краю после реза.</strong> Резка даёт максимум наклёпа
						на кромке.
					</li>
					<li>
						<strong>Приложите к сгибу или зоне сверления.</strong> Это вторая горячая точка
						деформационного мартенсита.
					</li>
				</ol>
				<p>Интерпретация:</p>
				<ul>
					<li>
						<strong>Прилип везде уверенно</strong> — ферритная, мартенситная или дуплексная сталь
						(AISI 430, 20Х13, 40Х13, 2205). Всё ещё нержавейка, но другого класса.
					</li>
					<li>
						<strong>Прилип только по краям и сгибам, в середине отпускает</strong> —
						аустенит после холодной деформации (AISI 304 / 316L / 321 с наклёпом).
					</li>
					<li>
						<strong>Не прилипает нигде</strong> — отожжённый аустенит (304, 316L, 321) или хромомарганцевая
						201, которая в отожжённом виде тоже немагнитна.
					</li>
				</ul>
				<p>
					Магнит не отличит AISI 304 от AISI 316L, а отожжённую 304 — от 201: ISSF описывает случаи, когда сталь
					серии 200 продавали как 304, и предупреждает, что «немагнитная» не значит «хромоникелевая». Для марки
					нужны реактив на молибден, XRF-анализатор или спектрометр и сертификат плавки: способы и их точность
					разобраны в статье «<a href="/blog/kak-proverit-nerzhaveyku/">Как проверить нержавейку</a>». Если по проекту
					важна немагнитность (или, наоборот, магнитные свойства), укажите это в заявке: Atlas Steels советует
					оговаривать магнитную проницаемость при покупке. Заказывайте прокат с сертификатом завода-изготовителя по
					<a href="/gost/5632-2014/"> ГОСТ 5632-2014</a>.
				</p>
			</section>

