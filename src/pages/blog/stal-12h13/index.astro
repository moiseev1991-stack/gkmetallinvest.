const faq = [
	{
		q: 'К какому классу относится сталь 12Х13?',
		a: 'По ГОСТ 5632-2014 — к мартенсито-ферритному, порядковый номер марки 2-3. В этот класс стандарт включает стали, в структуре которых кроме мартенсита не менее 10 % феррита. В EN 10088 и ASTM такого класса нет: аналоги 1.4006 и AISI 410 там числятся мартенситными. Основное назначение 12Х13 по ГОСТ — коррозионно-стойкая сталь, допускается применение как жаростойкой и жаропрочной.',
	},
	{
		q: '12Х13 и AISI 410 — одно и то же?',
		a: 'Нет, это аналоги. По ГОСТ 5632-2014 в 12Х13 0,09–0,15 % углерода и 12–14 % хрома, кремний и марганец — до 0,80 %. По ASTM A240 в AISI 410 0,08–0,15 % углерода и 11,5–13,5 % хрома, кремний и марганец — до 1,00 %. Плавка, уложенная в более узкие пределы по каждому элементу, отвечает обоим стандартам. Если проект требует конкретного стандарта, его указывают в заказе и проверяют по сертификату с анализом плавки.',
	},
	{
		q: 'Магнитится ли сталь 12Х13?',
		a: 'Да, в любом состоянии: отожжённом, закалённом и отпущенном. Структура стали — мартенсит и феррит, обе фазы ферромагнитны. Поэтому по магниту 12Х13 не отличить от 20Х13, 08Х13 или AISI 430: марку подтверждают сертификатом или спектральным анализом.',
	},
	{
		q: 'Какая плотность у стали 12Х13?',
		a: 'По марочнику сталей и сплавов — 7720 кг/м³ (7,72 г/см³) при 20 °C. Европейские данные для аналога 1.4006 дают 7,7 г/см³, американские для AISI 410 — 7,8 г/см³. При 7,72 г/см³ лист толщиной 1 мм весит 7,72 кг на квадратный метр, круг диаметром 20 мм — 2,43 кг на метр.',
	},
	{
		q: 'Можно ли сваривать 12Х13?',
		a: 'Можно, но с ограничениями: марочник относит её к ограниченно свариваемым сталям. Околошовная зона закаливается на воздухе, образуется хрупкий мартенсит, и без подогрева возможны холодные трещины. Для ограниченно свариваемых сталей марочник указывает подогрев 100–120 °C, американские данные для AISI 410 — 150–260 °C. После сварки проводят отпуск или отжиг. Однородный шов дают электроды типа Э-12Х13 по ГОСТ 10052-75 и проволока Св-12Х13 по ГОСТ 2246-70.',
	},
	{
		q: 'Чем 12Х13 отличается от 20Х13?',
		a: 'Углеродом и классом. В 12Х13 0,09–0,15 % углерода, это мартенсито-ферритная сталь; в 20Х13 — 0,16–0,25 %, она мартенситная. После закалки и отпуска круг 20Х13 по ГОСТ 5949-2018 прочнее: σв от 650 или 830 МПа в зависимости от режима против 590 МПа у 12Х13. Зато у 12Х13 выше ударная вязкость — от 88 Дж/см² против 78 и 59 — и выше рекомендуемая температура как жаропрочной: 550 °C против 500 °C по ГОСТ 5632-2014.',
	},
];

const sources = [
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — раздел 5, табл. 1, пп. 6.4–6.7, приложение А', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5949-2018 — металлопродукция из сталей нержавеющих и сплавов на железоникелевой основе, п. 7.1.5, табл. 1–3', href: 'https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/1/gost_5949-2018_mezhgosudarstvennyy_standart.html' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, жаростойкий и жаропрочный, табл. 1', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная, табл. 2', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'ASTM A240 Type 410 — состав и механические свойства листа (сводка Boltport)', href: 'https://boltport.com/datasheets/astm-a240-type-410.pdf' },
	{ label: 'ASTM A276 — Type 410: состав, свойства прутка в условиях T и H, проверка закаливаемости (сводка Boltport)', href: 'https://boltport.com/specifications/astm-a276/' },
	{ label: 'SteelNumber — X12Cr13 (1.4006) по EN 10088-2', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=79' },
	{ label: 'AZoM — Stainless Steel Grade 410 (UNS S41000): термообработка, сварка, коррозия', href: 'https://www.azom.com/article.aspx?ArticleID=970' },
	{ label: 'Марочник сталей и сплавов — 12Х13: физические свойства, критические точки, свариваемость', href: 'http://www.splav-kharkov.com/mat_start.php?name_id=57' },
	{ label: 'ГОСТ 10052-75 — электроды для сварки высоколегированных сталей (тип Э-12Х13); ГОСТ 2246-70 — сварочная проволока (Св-12Х13)' },
];

const related = [
	{ label: 'Сталь 20Х13, 30Х13, 40Х13: мартенситная нержавейка', href: '/blog/martensitnaya-stal-20h13-40h13/' },
	{ label: 'Ферритная нержавеющая сталь', href: '/blog/ferritnaya-stal/' },
	{ label: 'Круг нержавеющий', href: '/krug-nerzhaveyushchiy/' },
	{ label: 'Круг AISI 420 (20Х13, 40Х13)', href: '/krug-nerzhaveyushchiy/aisi-420/' },
	{ label: 'Аналоги марок нержавейки: AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
	{ label: 'Жаропрочная нержавейка и рабочие температуры', href: '/blog/zharoprochnaya-nerzhaveyka/' },
];
---

<BlogArticle
	slug="stal-12h13"
	title="Сталь 12Х13: состав, свойства, аналог AISI 410"
	description="Сталь 12Х13 по ГОСТ 5632-2014: состав и класс, механика круга и листа, термообработка, сварка, работа до 550 °C, аналоги AISI 410 и EN 1.4006."
	h1="Сталь 12Х13: состав, свойства, аналог AISI 410 и применение"
	eyebrow="Справочник"
	datePublished="2026-09-26"
	dateModified="2026-09-26"
	readingMin={10}
	answer="<strong>12Х13 — хромистая нержавеющая сталь мартенсито-ферритного класса: по ГОСТ 5632-2014 в ней 0,09–0,15 % углерода и 12–14 % хрома, никелем она не легирована.</strong> Ближайшие аналоги — AISI 410 (ASTM A240, A276) и 1.4006 / X12Cr13 (EN 10088), но хрома в них 11,5–13,5 %. Круг по ГОСТ 5949-2018 поставляют термообработанным с твёрдостью 121–187 HB, после закалки и высокого отпуска он даёт σв от 590 МПа, а как жаропрочную сталь её применяют до 550 °C."
	keyFacts={[
		'Состав по ГОСТ 5632-2014: C 0,09–0,15 %, Cr 12–14 %, Si и Mn ≤ 0,80 %, остаточный Ni ≤ 0,60 %',
		'Круг, ГОСТ 5949-2018: 121–187 HB в поставке; после закалки и отпуска σв ≥ 590 МПа, σ0,2 ≥ 410 МПа, KCU ≥ 88 Дж/см²',
		'Лист: σв ≥ 440 МПа после отжига (ГОСТ 5582-75), ≥ 490 МПа после закалки и отпуска (ГОСТ 7350-77)',
		'Плотность 7,72 г/см³, магнитится в любом состоянии, ограниченно свариваемая',
		'Жаропрочная до 550 °C на весьма длительный срок, интенсивная окалина на воздухе — с 700 °C',
	]}
	coverAlt="Сталь 12Х13: химический состав по ГОСТ 5632-2014, свойства и аналог AISI 410"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['12Х13', 'AISI 410', 'Мартенситная нержавеющая сталь', 'ГОСТ 5632-2014']}
	cta={{ title: 'Нужен прокат из 12Х13?', text: 'Поставляем нержавеющий металлопрокат — пришлите марку, вид проката, размеры и объём для расчёта.' }}
>
	<section id="sostav">
		<h2>Класс и химический состав 12Х13</h2>
		<p>
			Марка читается так: 12 — около 0,12 % углерода (по стандарту 0,09–0,15 %), Х13 — около 13 % хрома.
			Никель, молибден и титан в сталь не вводят. ГОСТ 5632-2014 относит 12Х13 к мартенсито-ферритному
			классу, порядковый номер марки 2-3. Это стали, в структуре которых после нагрева выше 900 °C и
			охлаждения на воздухе кроме мартенсита остаётся не менее 10 % феррита.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав 12Х13 по ГОСТ 5632-2014, %</caption>
				<thead>
					<tr><th>Элемент</th><th>Массовая доля</th><th>Пункт стандарта</th></tr>
				</thead>
				<tbody>
					<tr><td>Углерод C</td><td>0,09–0,15</td><td>табл. 1</td></tr>
					<tr><td>Хром Cr</td><td>12,0–14,0</td><td>табл. 1</td></tr>
					<tr><td>Кремний Si</td><td>не более 0,80</td><td>табл. 1</td></tr>
					<tr><td>Марганец Mn</td><td>не более 0,80</td><td>табл. 1</td></tr>
					<tr><td>Сера S</td><td>не более 0,025</td><td>табл. 1</td></tr>
					<tr><td>Фосфор P</td><td>не более 0,030</td><td>табл. 1</td></tr>
					<tr><td>Никель Ni, остаточный</td><td>не более 0,60</td><td>п. 6.5</td></tr>
					<tr><td>Медь Cu, остаточная</td><td>не более 0,30</td><td>п. 6.4</td></tr>
					<tr><td>Молибден Mo, остаточный</td><td>не более 0,30</td><td>п. 6.7</td></tr>
					<tr><td>Вольфрам W и ванадий V, остаточные</td><td>не более 0,20 каждого</td><td>п. 6.6</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Основное назначение по ГОСТ 5632-2014 — коррозионно-стойкая сталь, но стандарт допускает её применение
			и как жаростойкой, и как жаропрочной. Металл электрошлакового переплава обозначают 12Х13-Ш: буква через
			дефис указывает способ переплава, марочный состав остаётся тем же.
		</p>
	</section>

	<section id="analogi">
		<h2>Аналоги: AISI 410, 1.4006 и насколько они совпадают</h2>
		<div class="ba-table">
			<table>
				<caption>12Х13 и зарубежные аналоги: состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Показатель</th><th>12Х13 (ГОСТ 5632-2014)</th><th>AISI 410 (ASTM A240)</th><th>1.4006 (EN 10088-2)</th></tr>
				</thead>
				<tbody>
					<tr><td>Углерод</td><td>0,09–0,15</td><td>0,08–0,15</td><td>0,08–0,15</td></tr>
					<tr><td>Хром</td><td>12,0–14,0</td><td>11,5–13,5</td><td>11,5–13,5</td></tr>
					<tr><td>Кремний</td><td>0,80</td><td>1,00</td><td>1,00</td></tr>
					<tr><td>Марганец</td><td>0,80</td><td>1,00</td><td>1,50</td></tr>
					<tr><td>Никель</td><td>0,60 (остаточный)</td><td>0,75</td><td>0,75</td></tr>
					<tr><td>Сера</td><td>0,025</td><td>0,030</td><td>0,015</td></tr>
					<tr><td>Фосфор</td><td>0,030</td><td>0,040</td><td>0,040</td></tr>
					<tr><td>Класс</td><td>мартенсито-ферритный</td><td>мартенситный</td><td>мартенситный</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Составы пересекаются, но не совпадают. Хрома ГОСТ допускает до 14,0 %, ASTM и EN — до 13,5 %; нижний
			предел углерода в ГОСТ — 0,09 %, в зарубежных стандартах — 0,08 %. Кремний и марганец в 12Х13 ограничены
			0,80 %, в AISI 410 — 1,00 %, а марганца в 1.4006 допускается до 1,50 %. Плавка с 0,09–0,15 % углерода и
			12,0–13,5 % хрома, у которой остальные элементы уложены в пределы ГОСТ, отвечает и ГОСТ, и ASTM A240; для
			1.4006 нужна ещё сера не выше 0,015 %. Плавка 12Х13 с 13,8 % хрома в AISI 410 уже не попадает.
		</p>
		<p>
			Отличается и классификация: мартенсито-ферритного класса в EN 10088 и ASTM нет, 1.4006 и AISI 410 там
			числятся мартенситными. Для пруткового AISI 410 действует ASTM A276 — углерод и хром те же, никель не
			нормирован. Японский аналог — SUS410. Низкоуглеродистая версия AISI 410S (C ≤ 0,08 %) по углероду ближе
			к 08Х13. Если в проекте указан конкретный стандарт, его вписывают в заказ, а соответствие проверяют по
			сертификату с анализом плавки.
		</p>
	</section>

	<section id="svoystva">
		<h2>Механические свойства, плотность и магнитность</h2>
		<p>
			Сортовой прокат из 12Х13 поставляют термически обработанным: ГОСТ 5949-2018 требует для сталей
			мартенситного и мартенсито-ферритного классов состояние ТО — отжиг или отпуск. Твёрдость такого круга —
			121–187 HB. Прочность, текучесть и ударную вязкость стандарт проверяет на образцах после закалки и
			отпуска по рекомендуемому режиму, поэтому цифры таблицы относятся к металлу после этого режима.
		</p>
		<div class="ba-table">
			<table>
				<caption>Механические свойства 12Х13 и AISI 410 при 20 °C, не менее</caption>
				<thead>
					<tr><th>Прокат, стандарт</th><th>Термообработка</th><th class="num">σв, МПа</th><th class="num">σ0,2 (σт), МПа</th><th class="num">δ5, %</th></tr>
				</thead>
				<tbody>
					<tr><td>Круг и сортовой прокат — ГОСТ 5949-2018</td><td>закалка 1000–1050 °C, воздух или масло; отпуск 700–790 °C</td><td class="num">590</td><td class="num">410</td><td class="num">20</td></tr>
					<tr><td>Лист тонкий — ГОСТ 5582-75</td><td>отжиг или отпуск 740–780 °C</td><td class="num">440</td><td class="num">—</td><td class="num">21</td></tr>
					<tr><td>Лист толстый 4–50 мм — ГОСТ 7350-77</td><td>закалка 960–1020 °C, воздух; отпуск 680–780 °C</td><td class="num">490</td><td class="num">345</td><td class="num">21</td></tr>
					<tr><td>Лист толстый — ГОСТ 7350-77</td><td>отжиг по режиму изготовителя</td><td class="num">не более 650*</td><td class="num">250</td><td class="num">15</td></tr>
					<tr><td>AISI 410, лист — ASTM A240</td><td>отжиг</td><td class="num">450</td><td class="num">205</td><td class="num">20</td></tr>
					<tr><td>AISI 410, пруток горячекатаный — ASTM A276, условие T</td><td>закалка и отпуск</td><td class="num">690</td><td class="num">550</td><td class="num">15</td></tr>
					<tr><td>AISI 410, пруток горячекатаный — ASTM A276, условие H</td><td>закалка и отпуск</td><td class="num">830</td><td class="num">620</td><td class="num">12</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			* Для отожжённого толстого листа ГОСТ 7350-77 ограничивает временное сопротивление сверху, а отжиг
			проводят по требованию потребителя. Для круга ГОСТ 5949-2018 дополнительно нормирует относительное
			сужение — от 60 % и ударную вязкость KCU — от 88 Дж/см². Эти нормы относятся к прокату диаметром до 60 мм;
			для 60–100 мм допускается снижение удлинения на 1 абс. %, сужения на 5 абс. % и KCU на 9,8 Дж/см².
			Горячекатаный тонкий лист по ГОСТ 5582-75 разрешено не термообрабатывать, если он выдерживает нормы
			таблицы. Твёрдость листа AISI 410 по ASTM A240 — не более 217 HB (96 HRB).
		</p>

		<h3>Плотность и физические свойства</h3>
		<p>
			Плотность 12Х13 по марочнику сталей и сплавов — 7720 кг/м³ при 20 °C, при нагреве до 500 °C она
			снижается до 7580 кг/м³. Для аналога 1.4006 европейские данные дают 7,7 г/см³, американские для
			AISI 410 — 7,8 г/см³. Аустенитная 12Х18Н10Т с плотностью 7,9 г/см³ тяжелее примерно на 2 %.
		</p>
		<div class="ba-table">
			<table>
				<caption>Физические свойства 12Х13 (марочник сталей и сплавов)</caption>
				<thead>
					<tr><th>Свойство</th><th>Значение</th></tr>
				</thead>
				<tbody>
					<tr><td>Плотность при 20 °C</td><td>7720 кг/м³ (7,72 г/см³)</td></tr>
					<tr><td>Модуль упругости при 20 °C</td><td>217 ГПа</td></tr>
					<tr><td>Теплопроводность при 100 °C</td><td>28 Вт/(м·К)</td></tr>
					<tr><td>Коэффициент теплового расширения, 20–100 °C</td><td>10,2 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Удельная теплоёмкость, 20–100 °C</td><td>473 Дж/(кг·К)</td></tr>
					<tr><td>Удельное электросопротивление при 20 °C</td><td>0,506 мкОм·м</td></tr>
					<tr><td>Критические точки</td><td>Ac1 = 730 °C, Ac3 = 850 °C</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Пример расчёта при 7,72 г/см³: лист толщиной 1 мм весит 7,72 кг на квадратный метр, круг Ø 20 мм —
			2,43 кг на метр. Другие размеры удобно считать в <a href="/kalkulyator-vesa/">калькуляторе веса
			металлопроката</a>, где для 12Х13 заложено 7,7 г/см³.
		</p>
		<p>
			<strong>Магнитность.</strong> 12Х13 магнитится в отожжённом, закалённом и отпущенном состоянии: и мартенсит,
			и феррит ферромагнитны. Магнитом её не отличить от 20Х13, 08Х13 или AISI 430 — марку подтверждает
			сертификат или спектральный анализ.
		</p>
	</section>

	<section id="termoobrabotka">
		<h2>Термообработка: отжиг, закалка, отпуск</h2>
		<p>
			Режимы в стандартах немного расходятся: каждый описывает свой вид проката. Ориентиры задают критические
			точки стали — по марочнику Ac1 = 730 °C, Ac3 = 850 °C.
		</p>
		<ul>
			<li><strong>Отжиг.</strong> Для тонкого листа ГОСТ 5582-75 рекомендует отжиг или отпуск при 740–780 °C. Толстый лист по ГОСТ 7350-77 отжигают по режиму изготовителя и только по требованию потребителя. Отожжённый металл мягкий, круг — 121–187 HB: его точат, гнут и штампуют.</li>
			<li><strong>Закалка.</strong> Нагрев до 1000–1050 °C с охлаждением на воздухе или в масле (ГОСТ 5949-2018), для толстого листа — 960–1020 °C с охлаждением на воздухе (ГОСТ 7350-77). Сталь закаливается и на воздухе. ASTM A276 для проверки закаливаемости AISI 410 требует после нагрева до 955 °C и охлаждения на воздухе не менее 35 HRC.</li>
			<li><strong>Высокий отпуск.</strong> 700–790 °C по ГОСТ 5949-2018 или 680–780 °C по ГОСТ 7350-77. После него круг даёт σв от 590 МПа при ударной вязкости от 88 Дж/см² — это основное рабочее состояние 12Х13.</li>
			<li><strong>Отпускная хрупкость.</strong> Марочник отмечает склонность 12Х13 к отпускной хрупкости. Американские справочные данные для AISI 410 не рекомендуют отпуск при 400–580 °C: ударная вязкость в этом интервале падает.</li>
		</ul>
		<p>
			Высокой твёрдости, как у ножевых марок, 12Х13 не набирает — углерода мало. ГОСТ 5949-2018 нормирует HRC
			после закалки только для 30Х13 (от 48), 40Х13 (от 50) и 95Х18 (от 55). 12Х13 закаливают ради прочности с
			запасом вязкости, поэтому закалку сочетают с высоким отпуском. С закалкой, отпуском и полировкой ГОСТ
			5632-2014 связывает и наибольшую коррозионную стойкость стали.
		</p>
	</section>

	<section id="svarka">
		<h2>Сварка и коррозионная стойкость</h2>
		<p>
			Марочник сталей и сплавов относит 12Х13 к ограниченно свариваемым сталям: сварка возможна с подогревом и
			последующей термообработкой. Причина — околошовная зона закаливается на воздухе. Образуется хрупкий
			мартенсит, и вместе со сварочными напряжениями и водородом он даёт холодные трещины.
		</p>
		<ul>
			<li><strong>Подогрев.</strong> Для ограниченно свариваемых сталей марочник указывает 100–120 °C, американские справочные данные для AISI 410 — 150–260 °C. Температуру выбирают по толщине и жёсткости узла.</li>
			<li><strong>После сварки</strong> — отпуск или отжиг: он снимает напряжения и восстанавливает вязкость зоны термического влияния.</li>
			<li><strong>Присадка.</strong> Однородный по составу шов дают электроды типа Э-12Х13 по ГОСТ 10052-75 и проволока Св-12Х13 по ГОСТ 2246-70.</li>
		</ul>
		<p>
			Коррозионная стойкость у 12Х13 умеренная. ГОСТ 5632-2014 рассчитывает сталь на слабоагрессивные среды:
			атмосферные осадки, водные растворы солей органических кислот при комнатной температуре. Американские
			данные для AISI 410 добавляют пар, горячие газы, пресную воду, пищевые продукты, слабые кислоты и щёлочи.
			Молибдена и азота в стали нет, поэтому индекс питтингостойкости PREN равен содержанию хрома — 12–14.
			Это ниже, чем у AISI 430 и 304, и для хлоридов, морской воды и сильных кислот 12Х13 не подходит.
		</p>
	</section>

	<section id="primenenie">
		<h2>Рабочие температуры и применение</h2>
		<p>
			ГОСТ 5632-2014 в приложении А приводит для 12Х13 три назначения. Температуры стандарт даёт
			ориентировочно.
		</p>
		<div class="ba-table">
			<table>
				<caption>Назначение 12Х13 по ГОСТ 5632-2014, приложение А</caption>
				<thead>
					<tr><th>Назначение</th><th>Изделия</th><th>Температура</th></tr>
				</thead>
				<tbody>
					<tr><td>Коррозионно-стойкая (основное)</td><td>Детали с повышенной пластичностью под ударной нагрузкой: клапаны гидравлических прессов, предметы домашнего обихода; изделия для слабоагрессивных сред</td><td>комнатная</td></tr>
					<tr><td>Жаростойкая</td><td>Детали турбин, трубы, детали котлов</td><td>интенсивная окалина на воздухе — с 700 °C</td></tr>
					<tr><td>Жаропрочная</td><td>Лопатки паровых турбин, клапаны, болты и трубы</td><td>до 550 °C, весьма длительный срок службы</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Весьма длительным ГОСТ считает срок значительно больше 10 000 часов, обычно 50 000–100 000 часов.
			Марочник указывает для деталей из 12Х13 рабочие температуры 450–500 °C, а прутки и полосы для лопаток
			паровых турбин из неё поставляют и по ГОСТ 18968-73. Какие марки берут для нагрева выше 600 °C — в статье
			о <a href="/blog/zharoprochnaya-nerzhaveyka/">жаропрочной нержавейке</a>.
		</p>
		<ul>
			<li><strong>Энергетическое оборудование</strong> — лопатки паровых турбин, детали турбин и котлов, трубы.</li>
			<li><strong>Арматура</strong> — клапаны, в том числе гидравлических прессов.</li>
			<li><strong>Крепёж</strong> — болты, в том числе для работы при нагреве.</li>
			<li><strong>Бытовые изделия</strong> — предметы домашнего обихода.</li>
		</ul>
	</section>

	<section id="otlichiya">
		<h2>Чем 12Х13 отличается от 08Х13 и 20Х13</h2>
		<p>
			Три марки с 12–14 % хрома различаются углеродом, а от него зависят класс, прочность после улучшения
			и вязкость.
		</p>
		<div class="ba-table">
			<table>
				<caption>08Х13, 12Х13 и 20Х13 по ГОСТ</caption>
				<thead>
					<tr><th>Показатель</th><th>08Х13</th><th>12Х13</th><th>20Х13</th></tr>
				</thead>
				<tbody>
					<tr><td>Углерод, %</td><td>не более 0,08</td><td>0,09–0,15</td><td>0,16–0,25</td></tr>
					<tr><td>Класс по ГОСТ 5632-2014</td><td>ферритный</td><td>мартенсито-ферритный</td><td>мартенситный</td></tr>
					<tr><td>Круг в поставке, HB (ГОСТ 5949-2018)</td><td>116–179</td><td>121–187</td><td>126–197</td></tr>
					<tr><td>Круг после закалки и отпуска: σв / σ0,2, МПа</td><td>590 / 410</td><td>590 / 410</td><td>650 / 440 или 830 / 635</td></tr>
					<tr><td>Ударная вязкость KCU, Дж/см²</td><td>98</td><td>88</td><td>78 или 59</td></tr>
					<tr><td>Толстый лист после закалки и отпуска: σв / σт, МПа (ГОСТ 7350-77)</td><td>420 / 295</td><td>490 / 345</td><td>510 / 375</td></tr>
					<tr><td>Жаропрочная (ГОСТ 5632-2014)</td><td>до 650 °C, ограниченный срок</td><td>до 550 °C, весьма длительный срок</td><td>до 500 °C, весьма длительный срок</td></tr>
					<tr><td>Ближайший аналог</td><td>AISI 410S</td><td>AISI 410, 1.4006</td><td>AISI 420, 1.4021</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			По минимальной прочности круга после улучшения 12Х13 совпадает с 08Х13, но вязкость у неё ниже.
			20Х13 при том же хроме прочнее и менее вязкая, а как жаропрочную ГОСТ рекомендует её до 500 °C против
			550 °C у 12Х13. Для 20Х13 ГОСТ 5949-2018 даёт два режима отпуска, отсюда две пары цифр. Подробно 20Х13,
			30Х13 и 40Х13 разобраны в статье о <a href="/blog/martensitnaya-stal-20h13-40h13/">мартенситных сталях
			20Х13–40Х13</a>.
		</p>
		<p>
			08Х13 ГОСТ относит к ферритному классу и разрешает применять её не только после закалки с отпуском, но и
			после отжига. Ограниченный срок службы как жаропрочной — от 100 до 1000 часов. Про стали этого класса —
			в статье о <a href="/blog/ferritnaya-stal/">ферритной нержавейке</a>.
		</p>
	</section>
