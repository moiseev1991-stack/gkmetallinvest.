];

const related = [
	{ label: 'Лист AISI 304 (08Х18Н10)', href: '/list-nerzhaveyushchiy/aisi-304/' },
	{ label: 'Труба AISI 304 (08Х18Н10)', href: '/truba-nerzhaveyushchaya/aisi-304/' },
	{ label: 'Круг AISI 304 (08Х18Н10)', href: '/krug-nerzhaveyushchiy/aisi-304/' },
