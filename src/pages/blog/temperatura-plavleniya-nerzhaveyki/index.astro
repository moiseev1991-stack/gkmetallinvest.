---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../../data/site';

const title = 'Температура плавления нержавейки — таблица и рабочие температуры';
const description = 'Температура плавления нержавеющей стали 1400–1450 °C. Таблица по маркам (304, 316L, 321, 430, 310S), рабочие температуры длительной эксплуатации, жаростойкость и жаропрочность.';

const cover = '/img/blog/temperatura-plavleniya-nerzhaveyki.svg';
const datePublished = '2026-07-17';
const dateModified = '2026-07-17';
const url = `${siteUrl.replace(/\/$/, '')}/blog/temperatura-plavleniya-nerzhaveyki/`;

const sections = [
	{
		id: 'skolko',
		anchor: 'Сколько градусов',
		title: 'Температура плавления нержавейки',
		summary: '1400–1450 °C — интервал плавления.',
	},
	{
		id: 'tablica',
		anchor: 'Таблица по маркам',
		title: 'Плавление и рабочие температуры по маркам',
		summary: 'От 304 до жаропрочной 310S.',
	},
	{
		id: 'rabochie',
		anchor: 'Рабочие температуры',
		title: 'Рабочая температура ≠ температура плавления',
		summary: 'Длительно, кратковременно, окалиностойкость.',
	},
	{
		id: 'zharoprochnye',
		anchor: 'Жаропрочные марки',
		title: 'Что брать для высоких температур',
		summary: '321, 310S и жаростойкие стали.',
	},
];

const rows = [
	{ mark: '08Х18Н10 (AISI 304)', melt: '1400–1450', work: 'до +800', note: 'Универсал, окисление выше +870' },
	{ mark: '12Х18Н10Т (AISI 321)', melt: '1400–1425', work: 'до +850', note: 'Титан держит горячие узлы' },
	{ mark: '03Х17Н14М2 (AISI 316L)', melt: '1370–1400', work: 'до +800', note: 'Молибден, агрессивные среды' },
	{ mark: '12Х17 (AISI 430)', melt: '1425–1510', work: 'до +815', note: 'Феррит, жаростойкость на воздухе' },
	{ mark: '20Х23Н18 (AISI 310S)', melt: '1400–1450', work: 'до +1000', note: 'Жаропрочная, печная оснастка' },
	{ mark: '20Х13 (AISI 420)', melt: '1450–1510', work: 'до +450', note: 'Мартенсит, теряет твёрдость в нагреве' },
	{ mark: '40Х13', melt: '1450–1500', work: 'до +450', note: 'Ножи, инструмент' },
];

const faq = [
	{
		q: 'При какой температуре плавится нержавеющая сталь?',
		a: 'Нержавеющая сталь плавится при 1400–1450 °C. Точное значение зависит от марки: аустенитные стали типа 304 и 321 плавятся около 1400–1450 °C, ферритные и мартенситные (430, 20Х13) — до 1500–1510 °C. У сталей нет одной точки плавления — есть интервал между солидусом (начало плавления) и ликвидусом (полное расплавление), потому что это сплав, а не чистый металл.',
	},
	{
		q: 'Какая рабочая температура у нержавейки 304?',
		a: 'Сталь AISI 304 (08Х18Н10) длительно работает до +800 °C, кратковременно выдерживает до +870 °C. Выше начинается интенсивное окалинообразование. Для постоянной работы в диапазоне 800–1000 °C берут жаропрочные марки — 321 (стабилизирована титаном) или 310S (до +1000 °C). Рабочая температура намного ниже температуры плавления, потому что задолго до расплавления сталь теряет прочность и окисляется.',
	},
	{
		q: 'Чем температура плавления отличается от рабочей температуры?',
		a: 'Температура плавления (1400–1450 °C) — это когда металл переходит в жидкое состояние. Рабочая температура (для 304 — до +800 °C) — предел, при котором сталь сохраняет прочность и не покрывается окалиной при длительной эксплуатации. Разница огромна: конструкция теряет несущую способность и жаростойкость задолго до плавления, поэтому в расчётах ориентируются именно на рабочую температуру.',
	},
	{
		q: 'Какая нержавейка выдерживает самую высокую температуру?',
		a: 'Из ходовых марок самая жаропрочная — AISI 310S (20Х23Н18): длительно работает до +1000 °C, кратковременно до +1100 °C за счёт высокого содержания хрома (25 %) и никеля (20 %). Для узлов при 450–850 °C подходит 321 (12Х18Н10Т), стабилизированная титаном. Универсальная 304 ограничена +800 °C. Для печной оснастки и обжига выбирают именно 310S.',
	},
	{
		q: 'Почему у стали интервал плавления, а не одна точка?',
		a: 'Нержавейка — это сплав железа с хромом, никелем, молибденом и другими элементами. У сплавов плавление идёт в интервале между температурой солидуса (начинают плавиться легкоплавкие составляющие) и ликвидуса (расплав становится полностью жидким). У чистого железа точка одна — 1538 °C, а у легированной стали появляется «вилка» 1400–1450 °C, ширина которой зависит от состава.',
	},
];

const articleJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: title,
	description,
	image: `${siteUrl.replace(/\/$/, '')}${cover}`,
	mainEntityOfPage: { '@type': 'WebPage', '@id': url },
	datePublished,
	dateModified,
	author: { '@type': 'Organization', name: siteName, url: siteUrl },
	publisher: {
		'@type': 'Organization',
		name: siteName,
		url: siteUrl,
		logo: { '@type': 'ImageObject', url: `${siteUrl.replace(/\/$/, '')}/favicon.svg` },
	},
};

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') },
	})),
};
---

<BaseLayout title={title} description={description} image={cover} type="article" jsonLd={[articleJsonLd, faqJsonLd]}>
	<div class="container post">
		<Breadcrumbs items={[
			{ label: 'Главная', href: '/' },
			{ label: 'Блог', href: '/blog/' },
			{ label: 'Температура плавления нержавейки' },
		]} />

		<header class="post__hero">
			<span class="post__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M4 2v6a4 4 0 0 0 8 0V2M4 2h2v3H4M10 2h2v3h-2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
				</svg>
				Статья · справочные данные
			</span>
			<h1 class="post__h1">Температура плавления нержавейки: таблица и рабочие температуры</h1>
			<div class="post__meta">
				<time datetime={datePublished}>17 июля 2026</time>
				<span>·</span>
				<span>чтение 5 минут</span>
			</div>
			<p class="post__lead">
				<strong>Прямой ответ:</strong> нержавеющая сталь плавится при 1400–1450 °C.
				Но эксплуатировать её можно только до +800 °C (304, 316L) или +850–1000 °C
				для жаропрочных марок (321, 310S) — задолго до плавления сталь теряет прочность
				и покрывается окалиной. Ниже — таблица по маркам и разница между плавлением
				и рабочей температурой.
			</p>
		</header>

		<figure class="post__cover">
			<img
				src={cover}
				alt="Температура плавления нержавейки — 1400–1450 °C, рабочие температуры по маркам"
				width="1200"
				height="630"
				loading="eager"
				fetchpriority="high"
			/>
		</figure>

		<nav class="post__toc" aria-label="Содержание">
			<div class="post__toc-title">На странице</div>
			<ul>
				{sections.map((s) => (
					<li>
						<a href={`#${s.id}`}>
							<strong>{s.anchor}</strong>
							<span>{s.summary}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<article class="post__body">
			<section class="post__section" id="skolko">
				<h2>Температура плавления нержавейки</h2>
				<p>
					Температура плавления нержавеющей стали — <strong>1400–1450 °C</strong>. Это не
					одна точка, а интервал: сталь — сплав железа с хромом, никелем и другими
					элементами, поэтому плавление идёт между температурой <strong>солидуса</strong>
					(начало) и <strong>ликвидуса</strong> (полное расплавление). Для сравнения, чистое
					железо плавится при 1538 °C.
				</p>
				<p>
					На практике температура плавления нужна редко — при сварке, литье и термообработке.
					Гораздо важнее <strong>рабочая температура</strong>: предел, при котором прокат
					сохраняет прочность и жаростойкость. Она в 1,5–2 раза ниже температуры плавления.
				</p>
			</section>

			<section class="post__section" id="tablica">
				<h2>Плавление и рабочие температуры по маркам</h2>
				<p>
					Интервал плавления у большинства нержавеющих сталей близок, а вот предельные
					рабочие температуры различаются сильно — от +450 °C у мартенситных до +1000 °C
					у жаропрочных. В таблице — ходовые марки.
				</p>
				<div class="post__table-wrap">
					<table class="post__table">
						<thead>
							<tr>
								<th scope="col">Марка</th>
								<th scope="col">Плавление, °C</th>
								<th scope="col">Рабочая, °C</th>
								<th scope="col">Особенность</th>
							</tr>
						</thead>
						<tbody>
							{rows.map((r) => (
								<tr>
									<th scope="row">{r.mark}</th>
									<td>{r.melt}</td>
									<td>{r.work}</td>
									<td>{r.note}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
				<p>
					Значения — справочные, по марочникам сталей и ГОСТ 5632-2014. Карточки марок
					с сортаментом: <a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a>,
					<a href="/list-nerzhaveyushchiy/aisi-321/"> AISI 321</a>,
					<a href="/list-nerzhaveyushchiy/aisi-316l/"> AISI 316L</a>,
					<a href="/list-nerzhaveyushchiy/aisi-430/"> AISI 430</a>.
				</p>
			</section>

			<section class="post__section" id="rabochie">
				<h2>Рабочая температура ≠ температура плавления</h2>
				<p>
					Почему сталь, плавящаяся при 1450 °C, нельзя нагревать выше 800 °C? Задолго до
					плавления происходят три процесса:
				</p>
				<ul>
					<li>
						<strong>Потеря прочности.</strong> При нагреве предел текучести падает —
						конструкция «плывёт» под нагрузкой, хотя металл ещё твёрдый.
					</li>
					<li>
						<strong>Окалинообразование.</strong> Выше +850–870 °C защитная плёнка не
						успевает восстанавливаться, сталь окисляется и теряет металл с поверхности
						(это и есть предел <em>жаростойкости</em>, окалиностойкости).
					</li>
					<li>
						<strong>Межкристаллитная коррозия.</strong> В диапазоне 450–850 °C у
						нестабилизированных марок (304) выпадают карбиды хрома — сталь становится
						хрупкой по границам зёрен. Против этого и нужны 321 (титан) или L-марки.
					</li>
				</ul>
				<p>
					Поэтому в проекте отопительного, печного или выхлопного узла закладывают марку
					по <strong>рабочей</strong> температуре, а не по плавлению.
				</p>
			</section>

			<section class="post__section" id="zharoprochnye">
				<h2>Что брать для высоких температур</h2>
				<ul>
					<li>
						<strong>До +450 °C</strong> — подойдёт почти любая нержавейка, включая
						мартенситные 20Х13/40Х13 (но они теряют твёрдость в нагреве).
					</li>
					<li>
						<strong>До +800 °C</strong> — универсальная <a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a>
						(08Х18Н10), самый частый выбор для дымоходов и кожухов.
					</li>
					<li>
						<strong>450–850 °C с циклами нагрева</strong> — <a href="/list-nerzhaveyushchiy/aisi-321/">AISI 321</a>
						(12Х18Н10Т): титан связывает углерод и защищает от межкристаллитной коррозии.
					</li>
					<li>
						<strong>До +1000 °C</strong> — жаропрочная 310S (20Х23Н18) для печной оснастки,
						муфелей, обжига.
					</li>
				</ul>
				<p>
					Как марки различаются по составу и структуре — в статье
					<a href="/blog/vidy-nerzhaveyushchey-stali/"> виды нержавеющей стали</a>. Выбор
					между ходовыми аустенитами разобран в
					<a href="/blog/aisi-304-vs-316l-vs-321/"> сравнении 304, 316L и 321</a>,
					а соответствие обозначений — в
					<a href="/blog/analogi-marok-nerzhaveyki/"> таблице аналогов AISI, ГОСТ, EN</a>.
				</p>
			</section>

			<section class="post__faq">
				<h2>Частые вопросы</h2>
				<div class="post__faq-list">
					{faq.map((f) => (
						<details class="post__faq-item">
							<summary class="post__faq-q">
								<span>{f.q}</span>
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
									<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</summary>
							<p set:html={f.a} />
						</details>
					))}
				</div>
			</section>

			<aside class="post__related">
				<h2>Смежные страницы</h2>
				<ul>
					<li><a href="/blog/plotnost-nerzhaveyushchey-stali/">Плотность нержавеющей стали</a></li>
					<li><a href="/blog/aisi-304-vs-316l-vs-321/">AISI 304 vs 316L vs 321 — какую марку выбрать</a></li>
					<li><a href="/blog/analogi-marok-nerzhaveyki/">Аналоги марок: AISI, ГОСТ, EN</a></li>
					<li><a href="/blog/vidy-nerzhaveyushchey-stali/">Виды нержавеющей стали</a></li>
					<li><a href="/list-nerzhaveyushchiy/aisi-321/">Лист AISI 321 (12Х18Н10Т)</a></li>
					<li><a href="/gost/">Справочник ГОСТов на нержавеющий металлопрокат</a></li>
				</ul>
			</aside>
		</article>
	</div>

	<CtaSection
		title="Нужна марка под конкретную температуру?"
		text="Опишите рабочие условия узла — менеджер подберёт жаростойкую или жаропрочную марку из наличия и пришлёт КП с сертификатом плавки."
	/>
</BaseLayout>

<style>
	.post { padding-block: var(--space-8); min-width: 0; }

	.post__hero { margin-bottom: var(--space-6); max-width: 75ch; }
	.post__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		margin-bottom: var(--space-3);
	}
	.post__h1 {
		font-size: clamp(1.7rem, 3.5vw, 2.4rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-2);
	}
	.post__meta {
		display: flex;
		gap: 0.5rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		margin-bottom: var(--space-4);
	}
	.post__lead {
		font-size: 1.08rem;
		line-height: 1.6;
		max-width: 70ch;
		color: var(--color-text);
		margin: 0;
	}
	.post__lead strong { color: var(--color-primary); }

	.post__cover {
		margin: 0 0 var(--space-8);
		max-width: 80ch;
		border-radius: var(--radius-lg);
		overflow: hidden;
		border: 1px solid var(--color-border);
	}
	.post__cover img {
		width: 100%;
		height: auto;
		display: block;
		aspect-ratio: 1200 / 630;
	}

	.post__toc {
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-4) var(--space-5);
		margin-bottom: var(--space-8);
		max-width: 80ch;
	}
	.post__toc-title {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		margin-bottom: var(--space-3);
	}
	.post__toc ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-2);
	}
	.post__toc a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.7rem 0.9rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: var(--color-text);
		transition: all var(--dur-fast) var(--ease-out);
	}
	.post__toc a:hover {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		text-decoration: none;
		transform: translateY(-1px);
	}
	.post__toc a strong {
		font-size: 0.9rem;
		color: var(--color-primary-600);
		font-weight: 600;
	}
	.post__toc a span {
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.35;
	}

	.post__body {
		max-width: 75ch;
		display: grid;
		gap: var(--space-7);
	}
	.post__section {
		scroll-margin-top: calc(var(--header-h) + 1rem);
	}
	.post__section h2 {
		font-size: 1.35rem;
		line-height: 1.3;
		margin: 0 0 var(--space-3);
		letter-spacing: -0.01em;
	}
	.post__section p,
	.post__section ul,
	.post__section ol {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--color-text);
		margin: 0 0 var(--space-3);
	}
	.post__section ul,
	.post__section ol {
		padding-left: 1.3rem;
	}
	.post__section li {
		margin-bottom: 0.4rem;
		line-height: 1.6;
	}
	.post__section li:last-child { margin-bottom: 0; }
	.post__section a {
		color: var(--color-primary-600);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.post__section a:hover { color: var(--color-primary); }

	.post__table-wrap {
		overflow-x: auto;
		margin: 0 0 var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.post__table {
		width: 100%;
