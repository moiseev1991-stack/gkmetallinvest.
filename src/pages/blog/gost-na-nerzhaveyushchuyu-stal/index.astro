---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sistema', anchor: 'Как устроена система', summary: 'Марка, технические условия, сортамент, приёмка' },
	{ id: 'tablica', anchor: 'Таблица: продукция → ГОСТ', summary: 'Лист, лента, круг, труба, детали, фланцы и статус' },
	{ id: 'zameny', anchor: 'Заменённые стандарты', summary: '9941-81, 5949-75, 19903-74, 12820-80, 7350-77, 8240-97' },
	{ id: 'zarubezhnye', anchor: 'ASTM и EN', summary: 'A240, A312, A276, A403, A182, EN 10088: что покрывают' },
	{ id: 'zapis', anchor: 'Как записать в заказе', summary: 'Примеры по правилам самих стандартов' },
	{ id: 'priemka', anchor: 'Что просить при приёмке', summary: 'ГОСТ 7566-2018: маркировка и документ 3.1' },
	{ id: 'assortiment', anchor: 'Что есть в каталоге', summary: 'По какому ГОСТ названы позиции прайса' },
	{ id: 'zayavka', anchor: 'Что указать в заявке', summary: 'Стандарт с годом, марка, документ' },
];

const faq = [
	{
		q: 'Какой ГОСТ на нержавеющую сталь основной?',
		a: 'Единого ГОСТ на нержавеющую сталь нет. Марки и химический состав задаёт ГОСТ 5632-2014: 111 сталей и 54 сплава, он действует с 1 января 2015 года вместо ГОСТ 5632-72. Требования к металлу — стандарт на вид проката: лист — ГОСТ 7350-77 и 5582-75, лента — 4986-79, круг, квадрат, шестигранник и полоса — 5949-2018, трубы — 9940-81, 9941-2022 и 11068-81. Размеры задают отдельные сортаменты, приёмку и документ о качестве — ГОСТ 7566-2018.',
	},
	{
		q: 'Какой ГОСТ на нержавеющий лист?',
		a: 'Требования к металлу — ГОСТ 7350-77 для толстого листа (горячекатаный 4–50 мм, холоднокатаный 4–5 мм) и ГОСТ 5582-75 для тонкого (горячекатаный 1,5–3,9 мм, холоднокатаный 0,5–3,9 мм). Размеры и допуски — ГОСТ 19903-2015 для горячекатаного листа (0,4–160,0 мм) и ГОСТ 19904-90 для холоднокатаного (0,35–5,00 мм). Состав — по ГОСТ 5632-2014. С 1 января 2027 года вместо ГОСТ 7350-77 вводится ГОСТ 7350-2026. В заказе называют оба стандарта: на размеры и на металл.',
	},
	{
		q: 'Что такое ГОСТ 19903-2015?',
		a: 'Межгосударственный стандарт «Прокат листовой горячекатаный. Сортамент». Он задаёт размеры, а не сталь: толщина листа 0,4–160,0 мм, рулона 1,2–25,0 мм, ширина от 500 мм, точность по толщине А и Б, плоскостность ПО, ПВ, ПУ, ПН, кромка О и НО. В России введён с 1 сентября 2016 года приказом Росстандарта от 7 апреля 2016 года № 246-ст вместо ГОСТ 19903-74. Для нержавеющего листа его применяют вместе с ГОСТ 7350-77 или 5582-75, которые задают марку и свойства.',
	},
	{
		q: 'Что такое ГОСТ 5632-2014 и чем он отличается от ГОСТ 5632-72?',
		a: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» содержит названия марок, химический состав (таблица 1) и рекомендации по применению (приложение А). Размеров и механических свойств в нём нет. В России он введён с 1 января 2015 года вместо ГОСТ 5632-72, по карточке Росстандарта действует; есть Изменение № 1 (ИУС 1-2019). В ГОСТ 5632-72 у марок была графа «Старое обозначение»: 12Х18Н10Т там записана как Х18Н10Т.',
	},
	{
		q: 'Какой ГОСТ на нержавеющие трубы и что заменило ГОСТ 9941-81?',
		a: 'Бесшовные горячедеформированные — ГОСТ 9940-81 (Ø 57–325 мм, стенка 3,5–32 мм). Бесшовные холоднодеформированные — ГОСТ 9941-2022 (Ø 5–426 мм, стенка 0,2–40 мм): он действует с 1 августа 2023 года и заменил ГОСТ 9941-81. Электросварные — ГОСТ 11068-81 (Ø 8–102 мм, стенка 0,8–4,0 мм). Технических требований к профильным нержавеющим трубам в ГОСТ мы не нашли: в прайсе их поставляют по ASTM A554 и EN 10219-2.',
	},
	{
		q: 'Что значит AISI в ГОСТ и как AISI связан с ГОСТ?',
		a: 'AISI — не ГОСТ и не стандарт на прокат, а номер марки, например 304. Российский аналог AISI 304 — 08Х18Н10, 316L — 03Х17Н14М3, 321 — 12Х18Н10Т и 08Х18Н10Т, 430 — 12Х17. Это близкие по составу марки, а не тождественные: у 304 никеля 8,0–10,5 %, у 08Х18Н10 — 9–11 %. Зарубежные стандарты на прокат — ASTM A240 для листа, A312 для труб, A276 для прутков, EN 10088 — не заменяют ГОСТ: у них свои размеры, допуски и нормы по составу.',
	},
	{
		q: 'Какой стандарт на фланцы и отводы из нержавейки?',
		a: 'Фланцы — ГОСТ 33259-2015 (PN до 250, действует с 1 апреля 2016 года). Он заменил ГОСТ 12820-80 и 12821-80: в карточках Росстандарта у них статус «Заменён». Отводы, тройники, переходы и заглушки — ГОСТ 17375, 17376, 17378 и 17379-2001. По названию это стандарты на детали из углеродистой и низколегированной стали: для нержавейки они дают размеры, а материал и требования согласуют отдельно — по ТУ изготовителя или ASTM A403.',
	},
	{
		q: 'Как записать ГОСТ в заказе и что просить при приёмке?',
		a: 'Называйте два стандарта — на металл и на размеры — с годом. Лист: «Лист АТ-АШ-АД-ПН-О-2×1000×2000 ГОСТ 19904-90, 12Х18Н10Т-Н1 ГОСТ 5582-75». Труба: «Труба 25 x 2 - 12Х18Н10Т - ГОСТ 9941-2022». При приёмке просите документ о качестве вида 3.1 по ГОСТ 7566-2018: номер плавки и партии, химический состав, результаты испытаний. Номер плавки должен совпадать с маркировкой на металле.',
	},
];

const sources = [
	{ label: 'Росстандарт — ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки»: статус «Действует», введён 01.01.2015 взамен ГОСТ 5632-72; Изменение № 1 (ИУС 1-2019). Содержание: разд. 1–6, прил. А', href: 'https://protect.gost.ru/gost/details/d6ac3954-d07e-4a10-a038-f3ab9b1d5b7b' },
	{ label: 'Росстандарт — ГОСТ 5949-2018: статус «Действует», введён 01.02.2019 взамен ГОСТ 5949-75; текст — п. 1, 4.2, 5.1, разд. 6, прил. В (приказ № 624-ст)', href: 'https://protect.gost.ru/gost/details/37fec143-e96c-4b3e-b589-36502eb83bbf' },
	{ label: 'ГОСТ 7350-77 «Сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная» — п. 1.1, 2.1–2.2, 3.1, 3.8, табл. 4', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'Росстандарт — ГОСТ 5582-75: статус «Действует», введён 01.01.1977 взамен ГОСТ 5582-61; текст — п. 1.1, 2.1, 2.2, 3.1, 3.2 и примеры обозначений', href: 'https://protect.gost.ru/gost/details/909b9401-2dce-4e02-93a0-74853c64cf9c' },
	{ label: 'ГОСТ 19903-2015 «Прокат листовой горячекатаный. Сортамент» — п. 1, 2.1, табл. 1–2; предисловие: приказ № 246-ст от 07.04.2016, введён с 01.09.2016 взамен ГОСТ 19903-74', href: 'https://meganorm.ru/Data2/1/4293755/4293755668.htm' },
	{ label: 'Росстандарт — ГОСТ 9941-2022 (введён 01.08.2023 взамен ГОСТ 9941-81; карточка ГОСТ 9941-81: «Заменен»); текст — п. 1, 5.1–5.5, табл. 1', href: 'https://protect.gost.ru/gost/details/69d6d5b0-077a-4a2b-b61e-be4497d33880' },
	{ label: 'Росстандарт — ГОСТ 11068-81 «Трубы электросварные из коррозионно-стойкой стали»: статус «Действует», введён 01.01.1983; текст — п. 1.1–1.2, табл. 1', href: 'https://protect.gost.ru/gost/details/0a88e531-f7f6-493e-b6f1-75228748bf47' },
	{ label: 'Росстандарт — ГОСТ 33259-2015: статус «Действует», введён 01.04.2016, заменяет ГОСТ 12815-80 – 12822-80; текст — разд. 1, п. 7.18 (данные для заказа и примеры обозначений), таблица материалов', href: 'https://protect.gost.ru/gost/details/66ebf93e-1d81-4202-b092-e10a05ad5c1d' },
	{ label: 'ГОСТ 7566-2018 «Металлопродукция. Правила приемки, маркировка, упаковка, транспортирование и хранение» — п. 4.1.2, 4.3.1, 5.2.4, приложение Б (введён 01.02.2019 взамен ГОСТ 7566-94)', href: 'https://meganorm.ru/Data2/1/4293735/4293735060.pdf' },
	{ label: 'Росстандарт — карточка ГОСТ 7350-2026 «Прокат толстолистовой из нержавеющих сталей и сплавов на железоникелевой основе…»: статус «Принят», приказ № 826-ст от 21.07.2026, введён с 01.01.2027 с правом досрочного применения, заменяет ГОСТ 7350-77. Статусы остальных стандартов таблицы сверены по карточкам Росстандарта (protect.gost.ru), включая ГОСТ 8509-2026 и 8240-2026', href: 'https://protect.gost.ru/gost/details/a1695263-ff72-4b5e-9280-183b286f187f' },
	{ label: 'ASTM A240/A240M, A480/A480M (п. 3.2, 4.1, 25.1.1), A276/A276M, A312/A312M, A403/A403M, A554 и A182/A182M — названия и области применения (тексты A240 и A480; описания остальных — astm.org, webstore.ansi.org, справочники производителей)' },
	{ label: 'EN 10088-1…5 — перечень стандартов серии и их названия; EN 10270-3:2011 — п. 3 и пример заказа; EN 10217-7:2021 — область применения', href: 'https://www.en-standard.eu/set-en-10088-part-1-5-stainless-steels-technical-delivery-conditions/' },
];

const related = [
	{ label: 'Справочник ГОСТ на металлопрокат', href: '/gost/' },
	{ label: 'Аналоги марок нержавейки: таблица AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
	{ label: 'Лист нержавеющий 4–10 мм: ГОСТ 7350-77 и 19903', href: '/blog/list-nerzhaveyushchiy-4-5-6-8-10-mm/' },
	{ label: 'Нержавеющая труба: бесшовная, электросварная, профильная', href: '/blog/kak-vybrat-nerzhaveyushchuyu-trubu/' },
	{ label: 'Лента нержавеющая: марки и ГОСТ 4986-79', href: '/blog/lenta-nerzhaveyushchaya-marki-i-gost-4986-79/' },
	{ label: 'Уголок и швеллер нержавеющий: размеры и ГОСТ', href: '/blog/ugolok-i-shveller-nerzhaveyushchiy/' },
