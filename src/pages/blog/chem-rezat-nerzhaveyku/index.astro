---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sravnenie', anchor: 'Сравнение способов', summary: 'Толщины, кромка, нагрев' },
	{ id: 'lazer', anchor: 'Лазер', summary: 'Волоконный лазер и азот' },
	{ id: 'plazma', anchor: 'Плазма', summary: 'Толстый металл и скорость' },
	{ id: 'gidroabraziv', anchor: 'Гидроабразив', summary: 'Холодная резка без нагрева' },
	{ id: 'gilotina', anchor: 'Гильотина и болгарка', summary: 'Прямой рез и ручной инструмент' },
	{ id: 'vybor', anchor: 'Как выбрать', summary: 'Способ под задачу' },
];

const faq = [
	{
		q: 'Какой толщины нержавейку режет лазер?',
		a: 'Зависит от мощности. По данным TRUMPF для станков TruLaser fiber: 4 кВт — до 20 мм нержавейки, 6 кВт — до 25 мм, 9–12 кВт — до 40 мм. Станки на 3 кВт в производстве обычно режут нержавейку до 8–12 мм. Чем толще металл, тем ниже скорость и качество кромки.',
	},
	{
		q: 'Чем лазерная резка нержавейки лучше плазменной?',
		a: 'Лазер даёт более узкий рез, точные отверстия и мелкие детали, а при резке с азотом — светлую кромку без окислов, которую можно сразу варить. Плазма быстрее и дешевле на толстом металле, но кромка и точность хуже.',
	},
	{
		q: 'Можно ли резать нержавейку обычным кругом по металлу?',
		a: 'Не стоит. Круги для чёрного металла могут содержать железо, серу и хлор. Частицы остаются на поверхности нержавейки и через время дают ржавые пятна. Для нержавейки выпускают круги с маркировкой INOX, где железа, серы и хлора меньше 0,1 %.',
	},
	{
		q: 'Почему после болгарки на нержавейке появилась ржавчина?',
		a: 'Скорее всего, на поверхность попали частицы железа — от круга для чёрного металла, от искр при резке углеродистой стали рядом или от общего инструмента. Ржавеют именно эти частицы. Пятна снимают средствами на фосфорной или щавелевой кислоте, а поверхность затем пассивируют.',
	},
	{
		q: 'Греет ли металл гидроабразивная резка?',
		a: 'Нет. Гидроабразивная резка — холодный процесс: струя воды с абразивом режет без нагрева, зоны термического влияния нет. Поэтому её выбирают для толстого металла и деталей, где недопустимо изменение структуры или деформация.',
	},
	{
		q: 'Какой толщины нержавейку режет гильотина?',
		a: 'Меньше, чем углеродистую сталь. Паспортную толщину гильотины, указанную для чёрной стали, для нержавейки снижают на 40–50 %: машина на 10 мм углеродистой стали режет AISI 304 толщиной 5–6 мм, AISI 430 — 7–8 мм.',
	},
];

const sources = [
	{ label: 'TRUMPF — TruLaser 3030/3040/3060/3080 fiber, максимальные толщины', href: 'https://www.trumpf.com/en_US/products/machines-systems/2d-laser-cutting-machines/trulaser-3030-fiber-3040-fiber-3060-fiber-3080-fiber/' },
	{ label: 'Bodor — параметры лазерной резки 6–12 кВт', href: 'https://www.bodor.com/en/blogs/laser-cutting-parameters-6kw-12kw-sheet-metal.html' },
	{ label: 'Hypertherm — системы плазменной резки XPR', href: 'https://www.hypertherm.com/solutions/about-our-products/xpr-plasma-cutting-systems/' },
	{ label: 'OMAX — Waterjet FAQ', href: 'https://www.omax.com/en/omax-waterjet-faqs/' },
	{ label: 'Weiler Abrasives, PFERD — абразивы для нержавеющей стали (INOX)', href: 'https://us.pferd.com/en/knowledge/materials/stainless-steel-general/' },
	{ label: 'Outokumpu — обработка нержавеющей стали после изготовления', href: 'https://www.outokumpu.com/en/expertise/stainless-basics/post-fabrication-treatment' },
];

const related = [
	{ label: 'Перфорация листов из нержавейки', href: '/uslugi/perforaciya-listov/' },
	{ label: 'Продольная и поперечная резка рулонов', href: '/uslugi/rezka-rulonov/' },
	{ label: 'Лист нержавеющий — каталог', href: '/list-nerzhaveyushchiy/' },
	{ label: 'Как варить нержавейку', href: '/blog/kak-varit-nerzhaveyku/' },
	{ label: 'Почему ржавеет нержавейка', href: '/blog/pochemu-rzhaveet-nerzhaveyka/' },
];
---

<BlogArticle
	slug="chem-rezat-nerzhaveyku"
	title="Чем резать нержавейку: лазер, плазма, гидроабразив"
	description="Чем резать нержавейку: лазер с азотом до 20–40 мм, плазма, гидроабразив без нагрева, гильотина и болгарка с кругами INOX. Сравнение толщин, кромки и точности."
	h1="Чем резать нержавейку: лазер, плазма, гидроабразив, болгарка"
	eyebrow="Разбор"
	datePublished="2026-09-19"
	dateModified="2026-09-19"
	readingMin={6}
	answer="<strong>Листы до 20–25 мм точнее и чище всего режет волоконный лазер с азотом: кромка без окислов, сразу под сварку.</strong> Толстый металл режут плазмой или гидроабразивом, причём гидроабразив режет вообще без нагрева. Болгаркой нержавейку режут только кругами с маркировкой INOX — иначе частицы железа дадут ржавчину."
	keyFacts={[
		'Волоконный лазер (TRUMPF): 4 кВт — до 20 мм, 6 кВт — до 25 мм, 12 кВт — до 40 мм нержавейки',
		'Резка лазером с азотом — светлая кромка без окислов',
		'Плазма (Hypertherm XPR300): пробивка до 38 мм, лучшее качество — до 12 мм',
		'Гидроабразив: без нагрева, на практике до ~230 мм, точность около ±0,1 мм',
		'Гильотина: для нержавейки паспортную толщину по чёрной стали снижают на 40–50 %',
	]}
	coverAlt="Чем резать нержавейку: лазер, плазма, гидроабразив и болгарка"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Резка нержавеющей стали', 'Лазерная резка', 'Гидроабразивная резка']}
	cta={{ title: 'Нужен нержавеющий лист в размер?', text: 'Подберём лист и формат под вашу резку, отгрузим с сертификатом завода.' }}
>
	<section id="sravnenie">
		<h2>Сравнение способов резки</h2>
		<div class="ba-table">
			<table>
				<caption>Способы резки нержавеющей стали</caption>
				<thead>
					<tr><th>Способ</th><th>Толщина</th><th>Кромка и нагрев</th><th>Когда выбирать</th></tr>
				</thead>
				<tbody>
					<tr><td>Волоконный лазер</td><td>до 20–40 мм в зависимости от мощности</td><td>Узкий рез; с азотом — без окислов</td><td>Детали по чертежу, отверстия, серии</td></tr>
					<tr><td>Плазма</td><td>толстый металл, пробивка до 38 мм (XPR300)</td><td>Шире рез, хуже точность</td><td>Толстый лист, заготовки, скорость и цена</td></tr>
					<tr><td>Гидроабразив</td><td>до ~230 мм на практике</td><td>Без нагрева, без зоны термовлияния</td><td>Толстый металл, детали без деформации</td></tr>
					<tr><td>Гильотина</td><td>на 40–50 % меньше паспорта по чёрной стали</td><td>Механический рез без нагрева</td><td>Прямой рез листа в размер</td></tr>
					<tr><td>Болгарка (УШМ)</td><td>тонкий металл, трубы, профиль</td><td>Нагрев и заусенец, риск загрязнения</td><td>Монтаж, единичные резы</td></tr>
				</tbody>
			</table>
		</div>
	</section>

	<section id="lazer">
		<h2>Лазерная резка</h2>
		<p>
			Волоконный (оптоволоконный) лазер — основной способ резать нержавеющий лист по чертежу. Предельная
			толщина зависит от мощности источника. По данным TRUMPF для станков TruLaser fiber: 4 кВт — до
			20 мм нержавейки, 6 кВт — до 25 мм, 9 и 12 кВт — до 40 мм. Станки на 3 кВт в производственном
			режиме обычно режут до 8–12 мм.
		</p>
		<p>
			Нержавейку режут с азотом в качестве режущего газа. Азот не даёт кромке окисляться: она остаётся
			светлой, и деталь можно сразу варить или полировать. При резке с кислородом кромка темнеет и
			требует зачистки.
		</p>
	</section>

	<section id="plazma">
		<h2>Плазменная резка</h2>
		<p>
			Плазма быстрее и дешевле лазера на толстом металле. Например, система Hypertherm XPR300 пробивает
			нержавейку толщиной до 38 мм, а наилучшее качество отверстий даёт на металле до 12 мм. Для
			нержавейки используют азот или специальные газовые смеси — они дают более светлую кромку.
		</p>
		<p>
			Минусы плазмы: рез шире, кромка менее ровная, точность ниже, чем у лазера. Для деталей с
			допусками кромку часто дорабатывают.
		</p>
	</section>

	<section id="gidroabraziv">
		<h2>Гидроабразивная резка</h2>
		<p>
			Струя воды под высоким давлением с абразивом режет металл без нагрева. Зоны термического влияния
			нет, структура и свойства стали у кромки не меняются, деталь не коробится. На практике
			гидроабразивом режут нержавейку толщиной до ~230 мм с типовой точностью около ±0,1 мм.
		</p>
		<p>
			Скорость ниже, чем у лазера и плазмы, поэтому способ выбирают там, где важны толщина и отсутствие
			нагрева.
		</p>
	</section>

	<section id="gilotina">
		<h2>Гильотина, болгарка и ручной инструмент</h2>
		<p>
			<strong>Гильотинные ножницы</strong> режут лист прямо и без нагрева. Нержавейка прочнее и сильнее
			упрочняется при деформации, поэтому паспортную толщину, указанную для углеродистой стали, снижают на
			40–50 %: машина на 10 мм чёрной стали режет AISI 304 толщиной 5–6 мм, AISI 430 — 7–8 мм. Ножи должны
			быть острыми.
		</p>
		<p>
			<strong>Болгарка (УШМ)</strong> подходит для монтажа и единичных резов. Круги берут только с
			маркировкой INOX: в их связке железа, серы и хлора меньше 0,1 %. Обычный круг для чёрного металла
			оставляет на поверхности частицы железа, и через время на нержавейке появляются ржавые пятна. По той
			же причине не используют общий с чёрным металлом инструмент.
		</p>
	</section>

	<section id="vybor">
		<h2>Как выбрать способ</h2>
		<ul>
			<li><strong>Детали по чертежу из листа до 20 мм, отверстия, серии</strong> — лазер с азотом.</li>
			<li><strong>Толстый металл, где важны цена и скорость</strong> — плазма.</li>
			<li><strong>Толстый металл без нагрева и деформации</strong> — гидроабразив.</li>
			<li><strong>Прямой рез листа в размер</strong> — гильотина.</li>
			<li><strong>Монтаж на месте</strong> — болгарка с кругами INOX, затем зачистка.</li>
		</ul>
		<p>
			После любой резки кромку очищают от заусенцев и следов окалины, а при загрязнении частицами железа
			поверхность пассивируют.
		</p>
	</section>
</BlogArticle>
