];

const faq = [
	{
		q: 'Какой ГОСТ на трубу 12Х18Н10Т?',
		a: 'Бесшовные горячедеформированные трубы — ГОСТ 9940-81 (Ø 57–325 мм, стенка 3,5–32 мм), бесшовные холоднодеформированные — ГОСТ 9941-2022 (Ø 5–426 мм, стенка 0,2–40 мм), электросварные — ГОСТ 11068-81 (Ø 8–102 мм, стенка 0,8–4,0 мм). Марку и химический состав задаёт ГОСТ 5632-2014 (в ГОСТ 9940-81 и ГОСТ 11068-81 стоит ссылка на заменённый им ГОСТ 5632-72). Профильных труб из 12Х18Н10Т в нашем прайсе нет: их поставка по запросу, размеры и допуски согласуют в заказе.',
	},
	{
		q: 'Чем ГОСТ 9941-2022 отличается от ГОСТ 9941-81?',
		a: 'ГОСТ 9941-2022 введён с 1 августа 2023 года вместо ГОСТ 9941-81. Из названия исключено слово «теплодеформированные», сортамент расширен до Ø 426 мм и стенки 40 мм, добавлены марки 03Х17Н14М3, 03Х18Н11, 05Х18Н10Т и 08Х21Н6М2Т, разрешена немерная длина от 0,6 м, документ о приёмке оформляют по ГОСТ 31458. Для 12Х18Н10Т норма прочности прежняя: σв не менее 549 Н/мм², δ5 не менее 35 %.',
	},
	{
		q: 'Какая прочность у трубы из 12Х18Н10Т?',
		a: 'По ГОСТ 9940-81 временное сопротивление не менее 529 Н/мм² при удлинении δ5 не менее 40 %. По ГОСТ 9941-2022 — 549 Н/мм² и 35 %, по ГОСТ 11068-81 (электросварные) — 550 Н/мм² и 35 %. Предел текучести — 216 Н/мм² у бесшовных и 226 Н/мм² у электросварных труб — определяют по требованию заказчика. Нормы ГОСТ 9941-2022 и ГОСТ 11068-81 относятся к термообработанным трубам.',
	},
	{
		q: 'Сколько весит метр трубы 12Х18Н10Т 57×3?',
		a: 'Масса 1 м = π × ρ × s × (D − s) / 1000 = 3,14159 × 7,9 × 3 × 54 / 1000 ≈ 4,02 кг. Труба длиной 6 м весит около 24,1 кг, в тонне — около 249 м. Плотность 7,9 г/см³ указана в ГОСТ 9940-81, ГОСТ 11068-81 и в приложении А к ГОСТ 9941-2022; ГОСТ 9941-81 приводил для этой марки 7,95 г/см³, разница около 0,6 %.',
	},
	{
		q: 'Труба 12Х18Н10Т — это то же самое, что AISI 321?',
		a: 'Нет, это аналоги. В 12Х18Н10Т по ГОСТ 5632-2014 допускается до 0,12 % углерода и 9–11 % никеля, у AISI 321 — до 0,08 % углерода и 9–12 % никеля. Обе стали стабилизированы титаном и применяются в одних и тех же сварных узлах. Если проект требует именно AISI 321 или EN 1.4541, в заказе указывают стандарт ASTM A312 или EN 10216-5, а состав плавки проверяют по сертификату.',
	},
	{
		q: 'Чем труба 12Х18Н10Т лучше трубы 08Х18Н10 (AISI 304)?',
		a: 'Титаном: он связывает углерод, поэтому сварной шов и участки, нагретые до 450–850 °C, сохраняют стойкость к межкристаллитной коррозии. В 08Х18Н10 титана нет, и ГОСТ 5632-2014 отмечает склонность её сварных соединений, кроме точечной сварки, к такой коррозии. Прочность по ГОСТ 9941-2022 у 12Х18Н10Т выше (549 против 529 Н/мм²), пластичность ниже (35 против 37 %). Для холодных линий без сварки на месте часто достаточно 08Х18Н10.',
	},
	{
		q: 'До какой температуры работает труба из 12Х18Н10Т?',
		a: 'По ГОСТ 5632-2014 (прил. А, значения ориентировочные) как жаростойкая сталь — до 800 °C при длительной работе (до 10 000 ч), интенсивное окалинообразование на воздухе начинается с 850 °C. Как жаропрочную, под нагрузкой, её рекомендуют до 600 °C на весьма длительный срок. В серосодержащих средах марка неустойчива. Для паропроводов высокого давления прил. А называет другие марки, поэтому температуру и давление для напорных линий определяет проект.',
	},
	{
		q: 'Какой сертификат нужен на нержавеющую трубу?',
		a: 'ГОСТ 9941-2022 требует документ о приёмочном контроле 3.1 или 3.2 по ГОСТ 31458; для труб по ГОСТ 9940-81 и ГОСТ 11068-81 партию сопровождает документ о качестве по ГОСТ 10692. ГОСТ 7566-2018 на трубы не распространяется. В документе проверьте марку, стандарт с годом, номер плавки, состав (у ЭСВ — состав исходного рулона), результаты растяжения и заказанных испытаний.',
	},
];

const sources = [
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1 (12Х18Н10Т, 08Х18Н10), приложение А, табл. А.1–А.3', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 9940-81 «Трубы бесшовные горячедеформированные из коррозионно-стойкой стали» — табл. 1–3, п. 1.2–1.7, 2.1–2.9, 3.1–3.3, 4.5, 4.9–4.11, примеры обозначений', href: 'https://files.stroyinf.ru/Data2/1/4294848/4294848734.htm' },
