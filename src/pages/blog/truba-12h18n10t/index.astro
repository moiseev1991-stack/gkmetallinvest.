	{ label: 'ГОСТ 9941-81 «Трубы бесшовные холодно- и теплодеформированные из коррозионно-стойкой стали» — табл. 1 и 3, п. 1.2, 2.3–2.4 (прежняя редакция)', href: 'https://meganorm.ru/Data2/1/4294850/4294850480.htm' },
	{ label: 'ГОСТ 11068-81 «Трубы электросварные из коррозионно-стойкой стали» — табл. 1–4, п. 1.2–1.6, 2.1–2.10, 3.1–3.5, 4.4', href: 'https://files.stroyinf.ru/Data2/1/4294852/4294852683.htm' },
	{ label: 'Росстандарт — карточка ГОСТ 9941-2022: статус «Действует», введён 1 августа 2023 года взамен ГОСТ 9941-81 (карточка ГОСТ 9941-81 в реестре — «Заменён»)', href: 'https://protect.gost.ru/gost/details/69d6d5b0-077a-4a2b-b61e-be4497d33880' },
	{ label: 'ГОСТ 10692-2015 «Трубы стальные, чугунные и соединительные детали к ним. Приёмка, маркировка, упаковка, транспортирование и хранение» — п. 5.2.1–5.2.5 (маркировка стальных труб)', href: 'https://auremo.org/gosts/gost-10692-2015.html' },
	{ label: 'ГОСТ 7566-2018 «Металлопродукция. Правила приёмки, маркировка, упаковка, транспортирование и хранение» — п. 1: стандарт не распространяется на трубные изделия', href: 'https://meganorm.ru/Data2/1/4293735/4293735060.pdf' },
	{ label: 'Atlas Steels — Technical Handbook of Stainless Steels: сенсибилизация при 425–850 °C, стабилизированные марки 321 и 347', href: 'https://atlassteels.com.au/wp-content/uploads/2021/08/Atlas-Steels-Technical-Handbook-of-Stainless-Steels-12-08-21.pdf' },
	{ label: 'SteelNumber — X6CrNiTi18-10 (1.4541) по EN 10088-2: состав, перечень стандартов EN 10216-5, 10217-7, 10296-2, 10297-2', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=102' },
	{ label: 'IMOA — Practical Guidelines for the Fabrication of Austenitic Stainless Steels, 2-е изд., 2020: состав и минимальные свойства стали 321 (1.4541)', href: 'https://www.imoa.info/download_files/stainless-steel/Austenitics_fabrication.pdf' },
	{ label: 'ASTM A312 — сводка требований к бесшовным и сварным аустенитным трубам: состав и растяжение TP321 (Octal Steel)', href: 'https://www.octalsteel.com/resources/astm-a312-tp304-tp316-ss-pipe' },
];

const related = [
	{ label: 'Нержавеющая труба: как выбрать бесшовную, электросварную или профильную', href: '/blog/kak-vybrat-nerzhaveyushchuyu-trubu/' },
