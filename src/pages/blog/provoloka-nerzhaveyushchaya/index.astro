---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'vidy', anchor: 'Виды проволоки', summary: 'Холоднотянутая, мягкая, пружинная, сварочная, мартенситная' },
	{ id: 'gost', anchor: 'ГОСТ 18143-72 и другие стандарты', summary: 'Диаметры, виды Х, Т, ТС, обозначение, 2246-70, EN 10270-3, ASTM' },
	{ id: 'marki', anchor: 'Марки проволоки', summary: 'Состав по ГОСТ 5632-2014, аналоги, когда какую брать' },
	{ id: 'sostoyaniya', anchor: 'Состояние и прочность', summary: 'Мягкая и холоднотянутая, σв по ГОСТ 18143 и EN 10270-3' },
	{ id: 'svarochnaya', anchor: 'Сварочная проволока', summary: 'Марки Св- по ГОСТ 2246-70 и классы ER' },
	{ id: 'vybor', anchor: 'Как выбрать', summary: 'Диаметр, состояние, поверхность, упаковка, магнитность' },
	{ id: 'assortiment', anchor: 'Наш ассортимент', summary: 'Марки, диаметры и стандарты в каталоге' },
];

const faq = [
	{
		q: 'Какая проволока нержавеющая бывает?',
		a: 'По назначению — четыре основных вида. Проволока общего назначения: холоднотянутая или мягкая (термообработанная) по ГОСТ 18143-72, марки 12Х18Н10Т, 08Х18Н10, 12Х18Н9. Пружинная — холоднотянутая высокопрочная, по EN 10270-3 (1.4310, 1.4401, 1.4301), ASTM A313 или ГОСТ 18143-72 (вид Х). Сварочная — по ГОСТ 2246-70 (Св-04Х19Н9, Св-07Х19Н10Б, Св-04Х19Н11М3) и по AWS A5.9 (ER308L, ER316L, ER347). Отдельно идёт проволока из мартенситных сталей 12Х13, 20Х13, 30Х13, 40Х13: она тоже входит в ГОСТ 18143-72, но магнитится.',
	},
	{
		q: 'Какой ГОСТ на нержавеющую проволоку?',
		a: 'ГОСТ 18143-72 «Проволока из высоколегированной коррозионностойкой и жаростойкой стали. Технические условия»: диаметр 0,20–7,50 мм, 11 марок, холоднотянутая (Х), термообработанная оксидированная (Т) и светлая (ТС), два класса пластичности. Сварочную проволоку нормирует ГОСТ 2246-70 (диаметры 0,3–12 мм), марки сталей — ГОСТ 5632-2014. Из зарубежных стандартов чаще всего встречаются EN 10270-3 и ASTM A313 для пружинной проволоки, ASTM A580 для проволоки общего назначения и AWS A5.9 для присадочной. Отменяющего документа на ГОСТ 18143-72 мы не нашли.',
	},
	{
		q: 'Чем сварочная проволока отличается от обычной?',
		a: 'Назначением и тем, что нормируется. Сварочная проволока — по ГОСТ 2246-70: стандарт задаёт химический состав присадки, а для ряда марок и содержание ферритной фазы (2–6 % у Св-08Х18Н8Г2Б, 3–8 % у Св-04Х19Н11М3). Состав подбирают под металл шва: у Св-04Х19Н9 углерода не более 0,06 %, хрома 18–20 %, никеля 8–10 %. Проволока общего назначения по ГОСТ 18143-72 нормируется по прочности, пластичности и диаметру, про сварку этот стандарт не говорит. Омеднения у нержавеющей сварочной проволоки нет: ГОСТ 2246-70 предусматривает его только для низкоуглеродистой и легированной стали.',
	},
	{
		q: 'Какая проволока для пружин из нержавейки?',
		a: 'Типовая — холоднотянутая аустенитная проволока 1.4310 (X10CrNi18-8) по EN 10270-3: при диаметре 1 мм у неё σв 1900–2190 МПа (уровень NS) или 2050–2360 МПа (уровень HS). Для коррозионной среды с хлоридами в том же стандарте есть 1.4401 (AISI 316), но она слабее: 1575–1820 МПа при 1 мм. По ГОСТ 18143-72 пружинной проволокой становится вид Х из 12Х18Н9, 17Х18Н9 или 12Х18Н10Т с σв до 1470 Н/мм². Слова «пружинная» в этом стандарте нет, поэтому в заказе указывают вид и класс, а не только назначение.',
	},
	{
		q: 'Магнитится ли нержавеющая проволока?',
		a: 'Мягкая аустенитная проволока (08Х18Н10, 12Х18Н10Т, AISI 304, 316) практически не магнитится. Холоднотянутая — слабо притягивает магнит: при волочении часть аустенита превращается в мартенсит, и чем больше обжатие, тем сильнее эффект. Проволока из 12Х13, 20Х13, 30Х13, 40Х13 и из ферритной AISI 430 магнитится в любом состоянии. Магнит не определяет марку: её подтверждает сертификат с номером плавки.',
	},
	{
		q: 'Как выбрать диаметр и состояние проволоки?',
		a: 'Диаметр берут по нагрузке и по способу изготовления: для пружин — по расчёту, для вязки и плетения — по гибкости, для сварки — по процессу и толщине металла. Состояние выбирают по задаче. Мягкая (Т, ТС) гнётся и вытягивается: σв 590–880 Н/мм² у 08Х18Н10 и 12Х18Н10Т. Холоднотянутая (Х) упруга: 1130–1470 Н/мм², но менее пластична. В заказе записывают диаметр, вид обработки, класс, точность и марку, например «Проволока 2,5-П-Х-12Х18Н10Т ГОСТ 18143-72». Тоньше 0,20 мм и толще 7,50 мм ГОСТ 18143-72 диаметры не нормирует, их требования согласуют с поставщиком.',
	},
];

const sources = [
	{ label: 'ГОСТ 18143-72 «Проволока из высоколегированной коррозионностойкой и жаростойкой стали. Технические условия» — разд. 1, п. 2.1–2.14, табл. 1–3, примеры обозначений (переиздание 1991 г. с изм. 2–6)', href: 'https://files.stroyinf.ru/Data1/21/21765/index.htm' },
	{ label: 'ГОСТ 2246-70 «Проволока стальная сварочная. Технические условия» — п. 1.1–1.4, табл. 1, табл. 2 (составы Св-04Х19Н9, Св-07Х19Н10Б, Св-04Х19Н11М3), п. 3.14–3.15, примеры обозначений', href: 'https://meganorm.ru/Data2/1/4294852/4294852796.htm' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1 (составы), приложение А (применение марок)', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'EN 10270-3:2011 «Steel wire for mechanical springs — Part 3: Stainless spring steel wire» — п. 1, 4.4, 4.5, табл. 1 и 2 (текст предпросмотра SIST EN 10270-3:2012)', href: 'https://cdn.standards.iteh.ai/samples/30610/fa0cca4f41ba4e95956d0de6c0b9a63f/SIST-EN-10270-3-2012.pdf' },
	{ label: 'ASTM A313/A313M — Stainless Steel Spring Wire: аустенитная, аустенитно-ферритная и дисперсионно-твердеющая пружинная проволока круглого сечения', href: 'https://store.astm.org/a0313_a0313m-18.html' },
	{ label: 'ASTM A580/A580M — Stainless Steel Wire: проволока в бухтах из аустенитных, ферритных, мартенситных сталей, кроме автоматных', href: 'https://store.astm.org/a0580_a0580m-18.html' },
	{ label: 'Gibbs Interwire — 302/304 Stainless Steel Wire Data Sheet: состояние отожжённое и пружинное, магнитность после волочения, ASTM A313', href: 'https://www.gibbswire.com/302-304-stainless-steel-wire-data-sheet/' },
	{ label: 'AWS A5.9/A5.9M — присадочные проволоки и прутки из нержавеющих и жаростойких сталей: классы ER308L, ER316L, ER347' },
	{ label: 'EN 10088-3 — нержавеющие стали: технические условия поставки полуфабрикатов, прутков, катанки и проволоки общего назначения' },
];

const related = [
	{ label: 'Сварка нержавейки полуавтоматом: газ и проволока', href: '/blog/svarka-nerzhaveyki-poluavtomatom/' },
	{ label: 'Как варить нержавейку: электроды, проволока, режимы', href: '/blog/kak-varit-nerzhaveyku/' },
	{ label: 'AISI 304, 316L и 321: какую марку выбрать', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'Магнитится ли нержавейка', href: '/blog/magnitit-li-nerzhaveika/' },
	{ label: 'Сталь 12Х18Н10Т: состав, ГОСТ и аналог AISI 321', href: '/blog/stal-12h18n10t/' },
	{ label: 'Сталь 08Х18Н10: состав, ГОСТ и аналог AISI 304', href: '/blog/stal-08h18n10/' },
