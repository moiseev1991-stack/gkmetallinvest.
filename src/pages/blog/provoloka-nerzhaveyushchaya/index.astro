					<tr><td>12Х13</td><td>1,00–6,00</td><td class="num">490–740</td><td class="num">20 / 16</td><td class="num">не нормируется</td></tr>
					<tr><td>20Х13</td><td>1,00–6,00</td><td class="num">540–780</td><td class="num">20 / 14</td><td class="num">980–1320</td></tr>
					<tr><td>30Х13</td><td>1,00–6,00</td><td class="num">590–830</td><td class="num">16 / 12</td><td class="num">не поставляется</td></tr>
					<tr><td>40Х13</td><td>1,00–6,00</td><td class="num">640–880</td><td class="num">14 / 10</td><td class="num">не поставляется</td></tr>
					<tr><td>08Х18Н10</td><td>0,20–6,00</td><td class="num">590–880</td><td class="num">25 / 20</td><td class="num">1130–1470</td></tr>
					<tr><td>12Х18Н9Т, 12Х18Н10Т</td><td>0,20–7,50</td><td class="num">590–880</td><td class="num">25 / 20</td><td class="num">1130–1470</td></tr>
					<tr><td>10Х17Н13М2Т, 10Х17Н13М3Т</td><td>1,00–6,00</td><td class="num">540–830</td><td class="num">25 / 20</td><td class="num">1080–1420</td></tr>
				</tbody>
