---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'pochemu', anchor: 'Почему краска не держится', summary: 'Пассивная плёнка, гладкость, когда красить нужно' },
	{ id: 'podgotovka', anchor: 'Подготовка поверхности', summary: 'Обезжиривание, шероховатость, грунт сразу' },
	{ id: 'kraski', anchor: 'Краски и грунты', summary: 'Что подходит — таблица по задачам' },
	{ id: 'poroshok', anchor: 'Порошковая окраска', summary: 'Подготовка и полимеризация — справка' },
	{ id: 'poshagovo', anchor: 'Как красить пошагово', summary: 'Условия, слои, толщина, сушка' },
	{ id: 'alternativy', anchor: 'Цвет без краски', summary: 'PVD, электрохимия, чернение, побежалость' },
	{ id: 'oshibki', anchor: 'Типичные ошибки', summary: 'Из-за чего слезает краска' },
];

const faq = [
	{
		q: 'Как покрасить нержавейку?',
		a: 'Обезжирьте поверхность, придайте ей шероховатость абразивом без железа, удалите пыль и сразу нанесите грунт, который по техническому описанию подходит для нержавейки. После сушки грунта по инструкции нанесите эмаль. Для улицы основа — двухкомпонентный эпоксидный или полиуретановый грунт 30–50 мкм и полиуретановая эмаль, как в руководстве BSSA. Без шероховатости и грунта краска держится плохо.',
	},
	{
		q: 'Чем покрасить нержавейку?',
		a: 'ASSDA называет основой инертный двухкомпонентный эпоксидный грунт, BSSA — эпоксидный или полиуретановый грунт, подходящий для нержавеющей стали, и полиуретановую эмаль сверху. Для декоративных работ в помещении есть водные грунты для цветных металлов: в описании Hammerite Special Metals Primer нержавеющая сталь указана прямо. Состав выбирают по техническому описанию: нержавейка должна быть в списке допустимых оснований.',
	},
	{
		q: 'Нужен ли грунт для нержавейки?',
		a: 'Да. Краска не связывается с нержавейкой химически, а на гладкой холоднокатаной поверхности 2B или BA без грунта сцепление плохое (Austral Wright). Есть грунты, которые заявляют адгезию без пескоструя и травления, но и для них поверхность обезжиривают. Грунты с металлическим цинком не годятся: ASSDA и BSSA их исключают.',
	},
	{
		q: 'Можно ли красить нержавейку порошковой краской?',
		a: 'Можно. Порошковую краску наносят электростатически и запекают в печи: для эпокси-полиэфирной краски типовой режим — 15–20 минут при 180 °C или 5–7 минут при 200 °C. Это заводская технология: нужны камера напыления и печь. Перед окраской нержавейку обезжиривают и активируют поверхность, например пескоструем неметаллическим абразивом или травлением. Режим и подготовку подтверждают по описанию конкретного порошка.',
	},
	{
		q: 'Почему краска слезает с нержавейки?',
		a: 'Чаще всего из-за подготовки: на гладкой поверхности с пассивной плёнкой нет шероховатости для сцепления, на ней остались жир или влага. Другие причины: грунт не для нержавейки, краска нанесена на побежалость после сварки, слишком толстый слой, нарушены интервалы между слоями, в абразиве было железо. Euro Inox называет потерю адгезии из-за плохой подготовки главной причиной отслоения.',
	},
	{
		q: 'Можно ли не красить, а получить цвет другим способом?',
		a: 'Да. Цвет даёт электрохимическое окрашивание (прозрачная оксидная плёнка 0,02–0,36 мкм, на аустенитных сталях), PVD-покрытие толщиной около 0,3 мкм, чернение в расплаве солей или заводская окраска рулона. Проще всего взять готовый цветной лист: цвет нанесён до резки и гибки. Анодирование относится к алюминию; у нержавейки близкий результат даёт электрохимическое окрашивание.',
	},
];

const sources = [
	{ label: 'ASSDA — Guidelines for painting stainless steel (Australian Stainless Magazine 80, 2024): профиль 30–50 мкм Ra, инертный эпоксидный грунт, цинковые грунты, побежалость, кромки', href: 'https://www.assda.asn.au/blog/365-guidelines-for-painting-stainless-steel' },
	{ label: 'BSSA — Paint Coating Stainless Steels (OGCP CP 4.4, SSAS5.80): шероховатость, шлифовка 320–400, толщины систем по ISO 12944', href: 'https://bssa.org.uk/bssa_articles/paint-coating-stainless-steels-ogcp-ref-cp-4-4/' },
	{ label: 'Euro Inox — Colouring Stainless Steel, Materials and Applications Series, т. 16 (2011): электрохимическое окрашивание, PVD, чернение, окраска рулона, покраска', href: 'https://bssa.org.uk/wp-content/uploads/2021/11/ColouringStainlessSteel_EN_euro_inox.pdf' },
	{ label: 'Austral Wright Metals — Painting Stainless Steel: очистка, обезжиривание, типы красок, шов нержавейки с углеродистой сталью', href: 'https://www.australwright.com.au/technical-data/advice/stainless-steel/painting-stainless-steel/' },
	{ label: 'Jotun — Penguard HB II, Technical Data Sheet и Application Guide: подготовка нержавеющей стали, профиль 25–55 мкм (ISO 8503-2)', href: 'https://www.jotun.com/api/v1/datasheets/download/merged?selectedFiles=9794%2C9761' },
	{ label: 'Tikkurila — Temacoat GPL-S Primer, Product Data Sheet (2006): двухкомпонентный эпоксидный грунт, 50–100 мкм, интервалы перекрытия', href: 'https://lakiery.info/pdf/ang/temacoatgplsprimer.pdf' },
	{ label: 'Sika — SikaCor EG-1 VHS, Product Data Sheet (март 2022): эпоксидный грунт для нержавеющей стали, система с полиуретановой эмалью', href: 'https://mng.sika.com/dam/dms/mn01/6/sikacor_eg-1_vhs.pdf' },
	{ label: 'Hammerite — Special Metals Primer, Technical Data Sheet (v. 6, 2025): водный грунт для цветных металлов и нержавеющей стали', href: 'https://msp.images.akzonobel.com/prd/dh/ezadlx/documents/37/aa/1e/07/7_hammerite_2.2_prep_specialmetalsprimer_2018_rev2.pdf' },
	{ label: 'AkzoNobel — Interpon 700, Technical Datasheet (2024): эпокси-полиэфирная порошковая краска, режимы полимеризации', href: 'https://powdercoatings.brand.akzonobel.com/m/5c7bcde2665e5465/original/EU-TDS-Interpon-700.pdf' },
	{ label: 'BSSA — Heat tint (temper) colours on stainless steel surface heated in air: цвет зависит от температуры, времени, кислорода и состава', href: 'https://bssa.org.uk/bssa_articles/heat-tint-temper-colours-on-stainless-steel-surface-heated-in-air/' },
	{ label: 'ГОСТ 9.402-2004 «ЕСЗКС. Покрытия лакокрасочные. Подготовка металлических поверхностей к окрашиванию» — разд. 5, пп. 5.11, 5.12.7', href: 'https://meganorm.ru/Data2/1/4293853/4293853323.htm' },
	{ label: 'ГОСТ 35094-2024 «Покрытия лакокрасочные. Группы, технические требования и обозначения» (взамен ГОСТ 9.032-74)', href: 'https://base.garant.ru/410494032/' },
	{ label: 'ГОСТ 9.410-88 «ЕСЗКС. Покрытия порошковые полимерные. Типовые технологические процессы»' },
];

const related = [
	{ label: 'Как почистить нержавейку и убрать побежалость', href: '/blog/kak-pochistit-nerzhaveyku/' },
	{ label: 'Почему ржавеет нержавейка', href: '/blog/pochemu-rzhaveet-nerzhaveyka/' },
	{ label: 'Поверхности нержавеющего листа: 2B, BA, 4N, 8K', href: '/blog/poverhnosti-nerzhaveyushchego-lista/' },
	{ label: 'Как варить нержавейку', href: '/blog/kak-varit-nerzhaveyku/' },
	{ label: 'Декоративные листы из нержавеющей стали', href: '/dekorativnye-listy/' },
	{ label: 'Травление и пассивация нержавейки', href: '/uslugi/travlenie-i-passivaciya/' },
	{ label: 'Полировка нержавейки', href: '/uslugi/polirovka/' },
];
---

<BlogArticle
	slug="kak-pokrasit-nerzhaveyku"
	title="Как покрасить нержавейку: подготовка, краска, грунт"
	description="Как покрасить нержавейку, чтобы краска не слезла: обезжиривание, шероховатость, эпоксидный грунт, эмаль, порошковая окраска и способы получить цвет без краски."
	h1="Как покрасить нержавейку: подготовка, грунт, краска и альтернативы"
	eyebrow="Справочник"
	datePublished="2026-10-05"
	dateModified="2026-10-05"
	readingMin={9}
	answer="<strong>Как покрасить нержавейку: обезжирить поверхность, придать ей шероховатость абразивом без железа, сразу нанести грунт, который по техническому описанию подходит для нержавейки, и затем эмаль.</strong> Пассивная плёнка не даёт краске связаться с металлом химически, поэтому покрытие держится за шероховатость. Без неё и без грунта краска отслаивается. Грунты с металлическим цинком не применяют. Если нужен только цвет, проще взять цветную нержавейку."
	keyFacts={[
		'Краска не образует с нержавейкой химической связи и держится механически — на шероховатой чистой поверхности (ASSDA)',
		'Профиль после струйной обработки: 30–50 мкм Ra (ASSDA) или 25–55 мкм по ISO 8503-2 (Jotun); для тонкого листа — ручная абразивная обработка',
		'Типовая система для улицы: двухкомпонентный эпоксидный или полиуретановый грунт 30–50 мкм и полиуретановая эмаль 100 мкм (BSSA)',
		'Не применять: грунты с металлическим цинком, хлорсодержащие растворители и стальную вату',
		'Порошковая окраска: эпокси-полиэфирный порошок запекают 15–20 минут при 180 °C или 5–7 минут при 200 °C (Interpon 700)',
		'Нужен только цвет — электрохимическое окрашивание, PVD (около 0,3 мкм) или готовый цветной лист',
	]}
	coverAlt="Как покрасить нержавейку: обезжиривание, шероховатость, эпоксидный грунт, эмаль и альтернативы покраске"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Нержавеющая сталь', 'Окраска нержавеющей стали', 'Подготовка поверхности под окраску', 'Порошковая окраска', 'Цветная нержавеющая сталь']}
	cta={{ title: 'Нужна нержавейка с нужной поверхностью?', text: 'Поставляем нержавеющий лист, трубу и круг, а в своём цехе выполняем лазерную резку, шлифовку, полировку, травление и пассивацию. Пришлите марку, размеры и объём — рассчитаем.' }}
>
	<section id="pochemu">
		<h2>Почему краска плохо держится на нержавейке</h2>
		<p>
			Нержавейку защищает пассивная плёнка из оксида хрома. Она тонкая, плотная и сама восстанавливается на
			воздухе. Для коррозии это плюс, для краски — минус. По данным ASSDA, краска не образует с поверхностью
			нержавейки химической связи, как с углеродистой или оцинкованной сталью, и держится за шероховатость.
			Euro Inox добавляет: плёнка может мешать сцеплению, поэтому её снимают незадолго до окраски.
		</p>
		<p>
			Вторая причина — гладкость. Холоднокатаная нержавейка твёрдая и ровная, особенно с гладкой отделкой
			(Euro Inox), а BSSA отмечает, что она ровнее и глаже углеродистой стали. ASSDA сравнивает цифры: для
			неокрашенной нержавейки ориентир — Ra 0,5 мкм, для окраски нужен профиль 30–50 мкм. Про заводские
			поверхности 2B, BA и 4N — в статье «<a href="/blog/poverhnosti-nerzhaveyushchego-lista/">Поверхности нержавеющего листа</a>».
		</p>
		<h3>Когда красить нужно, а когда нет</h3>
		<ul>
			<li><strong>Цвет и дизайн.</strong> Корпоративные цвета, логотип, вписать конструкцию в окружение — так BSSA описывает основные причины.</li>
			<li><strong>Маркировка и опознавание.</strong> Трубы, оборудование, участки, которые нужно выделить (Austral Wright).</li>
			<li><strong>Защита чёрной стали рядом.</strong> Если нержавейка приварена к углеродистой стали, краску ведут по шву и примерно на 25 мм по нержавейке (Austral Wright).</li>
			<li><strong>Защита самой нержавейки — как правило, нет.</strong> Euro Inox: нержавейку красят по эстетическим причинам, а не ради защиты. BSSA предупреждает, что локальное разрушение покрытия может дать более сильную коррозию, чем на неокрашенном металле. ASSDA описывает нитевидную (филиформную) коррозию, которая идёт от острых кромок под тонким лаком.</li>
		</ul>
		<p>
			Если нержавейка ржавеет, причина обычно в марке, среде или загрязнении, а не в отсутствии краски. Разбор —
			в статье «<a href="/blog/pochemu-rzhaveet-nerzhaveyka/">Почему ржавеет нержавейка</a>». Euro Inox советует заранее решить,
			что делать, когда краска износится: перекрашивать или снимать до металла. Нержавеющая основа служит
			дольше самой краски.
		</p>
	</section>

	<section id="podgotovka">
		<h2>Подготовка поверхности: от неё зависит результат</h2>
		<p>
			Euro Inox называет главной причиной отслоения потерю адгезии из-за плохой очистки и подготовки. Порядок
			такой.
		</p>
		<ol>
			<li><strong>Уберите дефекты и следы сварки.</strong> Брызги, окалину и цвета побежалости после сварки или термической резки снимают до окраски — травлением или абразивом (ASSDA). Как это делают, описано в статье «<a href="/blog/kak-pochistit-nerzhaveyku/">Как почистить нержавейку и убрать побежалость</a>». Травление и пассивацию швов выполняет наш цех: <a href="/uslugi/travlenie-i-passivaciya/">травление и пассивация нержавейки</a>.</li>
			<li><strong>Обезжирьте.</strong> Масло, СОЖ и отпечатки пальцев смывают щелочным составом, водорастворимым обезжиривателем или растворителем, например ацетоном, и сушат (BSSA, Austral Wright). Растворители и моющие средства с хлором нельзя (Jotun). Чистоту проверяют по воде: на чистой поверхности она растекается сплошной плёнкой, без разрывов (Austral Wright).</li>
			<li><strong>Придайте шероховатость</strong> одним из способов из таблицы ниже.</li>
			<li><strong>Удалите пыль и обезжирьте ещё раз.</strong> Обдув — сжатым воздухом без компрессорного масла (BSSA). По ГОСТ 9.402-2004 (п. 5.12.7.8) изделия из коррозионно-стойких сталей после обработки шлифовальным материалом травят для удаления металлической пыли; при неметаллических абразивах травление не применяют.</li>
			<li><strong>Грунтуйте сразу.</strong> Euro Inox: грунт и краску наносят как можно скорее после придания шероховатости, пока пассивная плёнка не восстановилась. Подготовленную поверхность не трогают голыми руками (Jotun).</li>
		</ol>
		<div class="ba-table">
			<table>
				<caption>Как придать нержавейке шероховатость под краску</caption>
				<thead>
					<tr><th>Способ</th><th>Что получается</th><th>Ограничения</th></tr>
				</thead>
				<tbody>
					<tr><td>Струйная обработка неметаллическим абразивом (оксид алюминия, карбид кремния)</td><td>Профиль 30–50 мкм Ra (ASSDA); 25–55 мкм по ISO 8503-2 (Jotun); поверхность матовая, без блестящих участков</td><td>Абразив без железа, воздух без масла; гранат ASSDA не рекомендует; тонкий лист может повести (BSSA); по ГОСТ 9.402-2004 — от 3 мм, для тонкостенных — если не нарушается форма</td></tr>
					<tr><td>Абразивные ленты, диски, нетканые круги</td><td>Сетка рисок, снят блеск (Jotun)</td><td>Только расходники для нержавейки, без высокооборотных шлифмашин (Jotun); ленты зернистостью около 80 для малых объёмов (ASSDA); 320–400 для тонких сечений (BSSA)</td></tr>
					<tr><td>Травление кислотами</td><td>Снимает пассивную плёнку и окалину (Euro Inox)</td><td>ASSDA: кислотное травление на объекте небезопасно; мягкий протрав даёт щавелевая кислота; после кислот — тщательная промывка</td></tr>
					<tr><td>Травящий (etch) грунт</td><td>Euro Inox: убирает пассивную плёнку на поверхности, уже достаточно шероховатой</td><td>Подходящий грунт подбирают по описанию производителя для нержавеющей стали</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Не используйте стальную вату и щётки из углеродистой стали. Частицы железа в абразиве дают ржавые точки
			под краской (BSSA, Austral Wright). Кромки скругляют: жидкое покрытие стягивается с острых углов
			(ASSDA).
		</p>
		<p class="ba-note">
			<strong>Пассивация перед окраской.</strong> Пассивация восстанавливает ту самую плёнку, которая мешает
			сцеплению. Как шаг подготовки под краску её не применяют; она нужна на участках, которые останутся без
			покрытия. Требования к конкретной краске — в её техническом описании.
		</p>
	</section>

	<section id="kraski">
		<h2>Какие краски и грунты подходят</h2>
		<p>
			Основа — двухкомпонентные системы. ASSDA советует инертный двухкомпонентный эпоксидный грунт и УФ-стойкую
			эмаль сверху для улицы. BSSA: грунт на эпоксидной или полиуретановой основе, подходящий для нержавеющей
			стали, и полиуретановая эмаль. Нержавеющая сталь указана в технических описаниях двухкомпонентных
			эпоксидных материалов Jotun Penguard, Tikkurila Temacoat GPL-S и SikaCor EG-1 VHS. Austral Wright называет
			эпоксидную краску предпочтительной для нержавейки, но напоминает: подходят не все грунты, совместимость
			проверяют по описанию.
		</p>
		<div class="ba-table">
			<table>
				<caption>Задача, система покрытия и на что обратить внимание</caption>
				<thead>
					<tr><th>Задача</th><th>Система покрытия</th><th>На что обратить внимание</th></tr>
				</thead>
				<tbody>
					<tr><td>Цвет в помещении, малые изделия, без нагрузок</td><td>Водный адгезионный грунт для цветных металлов и эмаль по металлу того же производителя</td><td>Hammerite Special Metals Primer: один слой, не меньше 30 мкм сухого слоя; эмаль Hammerite Direct To Rust — не раньше чем через 6 часов; рабочая температура до 80 °C; не для питьевой воды и пищи, не для постоянного погружения</td></tr>
					<tr><td>Улица, сельская и городская среда с малым загрязнением</td><td>Двухкомпонентный эпоксидный или полиуретановый грунт 30–50 мкм; полиуретановая эмаль с высоким сухим остатком 100 мкм</td><td>Система BSSA; нужны чистота и сухая поверхность, выдержка по описанию</td></tr>
					<tr><td>Промышленный район с умеренным SO<sub>2</sub> или побережье с невысокой солёностью</td><td>Грунт 30–50 мкм, эпоксидный слой с железной слюдкой (MIO) 100 мкм, полиуретановая эмаль 60 мкм</td><td>Система BSSA по ISO 12944; чем агрессивнее среда, тем толще система</td></tr>
					<tr><td>Влажный промышленный район или побережье с высокой солёностью</td><td>Грунт 30–50 мкм, эпоксидный слой MIO 200 мкм (один-два слоя), полиуретановая эмаль 60 мкм</td><td>Система BSSA; для таких сред нужна и подходящая марка нержавейки: краска её не заменяет</td></tr>
					<tr><td>Стык нержавейки с углеродистой сталью, которую красят</td><td>Система краски для углеродистой стали</td><td>Краску ведут по шву и примерно на 25 мм по нержавейке (Austral Wright)</td></tr>
					<tr><td>Серийное изделие после изготовления</td><td>Порошковая окраска</td><td>Заводская технология — раздел ниже</td></tr>
				</tbody>
			</table>
		</div>
		<h3>Что не применять</h3>
		<ul>
			<li><strong>Грунты с металлическим цинком.</strong> ASSDA: цинковые системы реагируют с нержавейкой и портят покрытие. BSSA: при сильном пожаре возможно охрупчивание нержавеющей стали.</li>
			<li><strong>Материалы с хлоридами.</strong> ASSDA требует меньше 50 ppm доступного хлорида; хлорсодержащие растворители и моющие средства запрещает Jotun.</li>
			<li><strong>Хлорированный каучук и виниловые эмали</strong> при рабочей температуре выше 70 °C, а алкидные эмали — в щелочной и агрессивной среде (Austral Wright).</li>
		</ul>
		<p>
			Серебристые эмали «под нержавейку» нужны, чтобы имитировать нержавейку на обычной стали. Для самой нержавейки
			они не нужны: цвет у металла уже есть. Если надо вернуть вид, нержавейку чистят — см. статью про чистку.
		</p>
	</section>

	<section id="poroshok">
		<h2>Порошковая окраска нержавейки: справка</h2>
		<p>
			Порошковую краску наносят электростатически, а затем запекают. Это заводская технология: нужны камера
			напыления и печь, поэтому её применяют для готовых деталей и серий, а не для ремонта на месте. ГОСТ
			9.402-2004 прямо охватывает подготовку поверхности под порошковые покрытия, типовые процессы — в ГОСТ
			9.410-88.
		</p>
		<ol>
			<li><strong>Изготовление.</strong> Резка, гибка и сварка идут до окраски. Следы сварки и побежалость убирают заранее.</li>
			<li><strong>Подготовка.</strong> Обезжиривание и активация поверхности, например пескоструем неметаллическим абразивом или травлением. По ГОСТ 9.402-2004 последнюю промывку перед порошковым покрытием проводят деминерализованной или дистиллированной водой.</li>
			<li><strong>Нанесение.</strong> Электростатический распылитель, ручной или автоматический (Interpon 700).</li>
			<li><strong>Полимеризация.</strong> Для эпокси-полиэфирного порошка Interpon 700 в описании: 15–20 минут при 180 °C, 8–12 минут при 190 °C, 5–7 минут при 200 °C. Рекомендуемая толщина плёнки — 60–90 мкм.</li>
		</ol>
		<p>
			Эти режимы взяты из описания порошка, в подготовке для которого названы сталь, алюминий и Zintec. Для
			нержавейки подготовку и режим уточняют по описанию конкретной краски. Нагрев до 180–200 °C ниже
			температур, при которых на AISI 304 появляется побежалость: у BSSA бледно-жёлтый цвет возникает около
			290 °C, но это ориентир, зависящий от времени нагрева и атмосферы.
		</p>
	</section>

	<section id="poshagovo">
		<h2>Как красить нержавейку вручную: пошагово</h2>
		<p>
			Примеры ниже — из технических описаний производителей. У другой краски значения другие, поэтому
			ориентируйтесь на её описание.
		</p>
		<ol>
			<li><strong>Условия.</strong> Сухо, чисто, без пыли (Euro Inox). Температура поверхности — минимум на 3 °C выше точки росы: так сказано в описаниях Tikkurila и Sika. Диапазоны разные: у Hammerite Special Metals Primer — 8–30 °C при влажности 10–85 %, у Tikkurila Temacoat GPL-S — не ниже +5 °C и до 80 % влажности, у SikaCor EG-1 VHS — не ниже +5 °C.</li>
			<li><strong>Смешивание.</strong> Двухкомпонентный материал смешивают строго по соотношению из описания и вырабатывают за время жизни смеси. Пример: Tikkurila Temacoat GPL-S — 4 части основы и 1 часть отвердителя по объёму, жизнеспособность около 6 часов при +23 °C с обычным отвердителем.</li>
			<li><strong>Инструмент.</strong> Кисть, валик или распыление. Tikkurila допускает безвоздушное распыление и кисть, Hammerite Special Metals Primer — кисть и пневматическое распыление без разбавления. Euro Inox советует тонкие слои с долгой сушкой между ними.</li>
			<li><strong>Грунт.</strong> Толщина — в пределах описания: BSSA — 30–50 мкм, Tikkurila Temacoat GPL-S — 50–100 мкм сухого слоя, Hammerite — не меньше 30 мкм. ASSDA рекомендует толщину не меньше трёх профилей, то есть при профиле 30–50 мкм — 90–150 мкм.</li>
			<li><strong>Сушка и интервалы.</strong> Время зависит от температуры. У Tikkurila Temacoat GPL-S при +23 °C грунт перекрывают эпоксидом через 2 часа, полиуретаном через 6 часов, а при +5 °C — через 20 и 32 часа. Hammerite Special Metals Primer при +23 °C высыхает до отлипа за 30–60 минут и перекрывается через 2 часа.</li>
			<li><strong>Эмаль.</strong> Слой или два по описанию. BSSA для уличных систем называет полиуретановую эмаль 60–100 мкм. У светлых цветов может понадобиться второй слой для укрывистости (Sika). Грунт и эмаль можно брать контрастных цветов — так видны пропуски (BSSA).</li>
			<li><strong>Отверждение и контроль.</strong> Полное отверждение двухкомпонентных систем занимает дни — срок в описании; до этого изделие не нагружают. Для систем по ISO 12944-9 адгезию проверяют отрывом по ISO 4624 (BSSA).</li>
		</ol>
	</section>

	<section id="alternativy">
		<h2>Альтернативы покраске: цвет без краски</h2>
		<p>
			Если нужен цвет, а не защитное покрытие, краска — не единственный вариант. ASSDA советует для гладкого
			листа, прежде чем красить, рассмотреть готовую цветную нержавейку: её крепят механически, без окраски
			на месте.
		</p>
		<div class="ba-table">
			<table>
				<caption>Способы получить цвет на нержавейке</caption>
				<thead>
					<tr><th>Способ</th><th>Как получают цвет</th><th>Что важно знать</th></tr>
				</thead>
				<tbody>
					<tr><td>Электрохимическое окрашивание (процесс INCO)</td><td>Прозрачная оксидная плёнка толщиной 0,02–0,36 мкм даёт бронзовый, золотой, красный, пурпурный, синий и зелёный цвета за счёт интерференции света</td><td>Подходит аустенитным сталям; феррит даёт только тёмно-серый; не выцветает; цвет зависит от угла зрения; нельзя сваривать; стирается абразивом и не ремонтируется (Euro Inox)</td></tr>
					<tr><td>PVD-покрытие</td><td>Керамический слой, который наносят в вакууме; типовая толщина около 0,3 мкм; золото, розовое золото, бронза, синий, чёрный, винно-красный</td><td>Стойкое к царапинам, цвет не зависит от угла; повреждение не ремонтируется; сварку делают до нанесения; при гибке нужна проверка на отслоение (Euro Inox)</td></tr>
					<tr><td>Окраска рулона на линии (coil coating)</td><td>Грунт и эмаль наносят валиками на рулон и запекают в печи; доступны прозрачные лаки против отпечатков</td><td>В целом не сваривается: лазерная и плазменная сварка — без особых мер, при точечной сварке краску с зоны снимают; хорошо работает склейка (Euro Inox)</td></tr>
					<tr><td>Чернение в расплаве солей</td><td>Погружение в расплав бихромата натрия при температуре около 400 °C на 5–30 минут; тонкая матовая чёрная плёнка</td><td>Подходит любой нержавеющей стали; промышленный процесс: бихромат — токсичное соединение шестивалентного хрома (Euro Inox)</td></tr>
					<tr><td>Термическое окрашивание (цвета побежалости)</td><td>Оксидная плёнка нарастает при нагреве на воздухе: соломенный, коричневый, синий</td><td>Оттенок зависит от температуры, времени, кислорода и состава стали (BSSA), поэтому повторить его на другой детали трудно; на сварных швах побежалость считают дефектом</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			<strong>Готовые цветные листы.</strong> Цвет нанесён на заводе до резки и гибки. В разделе
			«<a href="/dekorativnye-listy/">Декоративные листы</a>» у нас есть чёрное и золотое зеркало, шлифовка №4 и узорные листы. Раздел
			наполняется, цены и наличие — по запросу.
		</p>
		<p>
			<strong>Воронение и нержавейка.</strong> Воронение в горячем щелочном растворе — это оксидирование
			углеродистой стали. Нержавейку чернят иначе: высоколегированные стали оксидируют по другой технологии,
			а чёрный цвет на них получают, например, в расплаве солей (см. таблицу).
		</p>
		<p>
			<strong>Анодирование.</strong> Это процесс для алюминия и его сплавов. У нержавейки близкий по смыслу
			результат даёт электрохимическое окрашивание из таблицы.
		</p>
		<p>
			<strong>Если цвет не нужен.</strong> Блеск и фактуру дают шлифовка и полировка:
			<a href="/uslugi/polirovka/">полировка нержавейки</a> — от сатина до зеркала.
		</p>
	</section>

	<section id="oshibki">
		<h2>Типичные ошибки при покраске нержавейки</h2>
		<ul>
			<li><strong>Краска без грунта или с грунтом не для нержавейки.</strong> Совместимость подтверждают по описанию производителя.</li>
			<li><strong>Только мытьё вместо шероховатости.</strong> Гладкая нержавейка с пассивной плёнкой удерживает краску плохо.</li>
			<li><strong>Жир на поверхности.</strong> Отпечатки пальцев, масло и СОЖ дают отслоение; нужны обезжиривание и проверка по воде.</li>
			<li><strong>Влага и конденсат.</strong> Поверхность сухая и минимум на 3 °C выше точки росы.</li>
			<li><strong>Побежалость и окалина на швах.</strong> Краска поверх цветов побежалости ляжет плохо: ASSDA требует снять их до профилирования.</li>
			<li><strong>Железо в абразиве.</strong> Стальная вата, дробь и абразив, которым раньше обрабатывали углеродистую сталь, дают ржавые точки под покрытием (BSSA).</li>
			<li><strong>Грунт с металлическим цинком.</strong> Его исключают ASSDA и BSSA.</li>
			<li><strong>Слишком толстый слой и нарушенные интервалы.</strong> Euro Inox советует тонкие слои с долгой сушкой; Jotun — избегать лишней толщины.</li>
			<li><strong>Острые кромки.</strong> Краска стягивается с них, а под тонким лаком идёт нитевидная коррозия (ASSDA).</li>
			<li><strong>Хлор в очистителях и растворителях.</strong> Хлорсодержащие средства для нержавейки запрещает Jotun.</li>
		</ul>
	</section>
