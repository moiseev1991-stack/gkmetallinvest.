---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'chto-eto', anchor: 'Что это и где применяют', summary: 'Определение, способы получения, сита, фасады, акустика' },
	{ id: 'vidy', anchor: 'Виды и обозначения', summary: 'Круглые, квадратные, щелевые; ISO 7806 и DIN 24041, Rv 5-8' },
	{ id: 'shag', anchor: 'Шаг, перемычка, живое сечение', summary: 'Формулы для 60° и 90°, вывод, таблица, поля без перфорации' },
	{ id: 'pravila', anchor: 'Диаметр, толщина, прочность', summary: 'Правила пробивки, ограничения цеха, плоскостность, жёсткость' },
	{ id: 'marka', anchor: 'Марка, поверхность, кромка', summary: '304, 430, 316L; заусенец после пробивки и лазера' },
	{ id: 'massa', anchor: 'Масса листа', summary: 'Коэффициент живого сечения и пример расчёта' },
	{ id: 'assortiment', anchor: 'Что есть в каталоге', summary: 'Лист 0,5–6 мм под перфорацию, ПВЛ, перфорированная труба' },
	{ id: 'zayavka', anchor: 'Как заказать, что указать', summary: 'Чертёж DXF, DWG, AI, пробная партия, параметры заявки' },
];

const faq = [
	{
		q: 'Что означает обозначение Rv 5-8?',
		a: 'Это запись по DIN 24041: R — круглые отверстия, v — смещённые ряды в шахматном порядке под 60°, 5 — диаметр отверстия 5 мм, 8 — шаг, то есть расстояние между центрами, 8 мм. Перемычка между отверстиями — 3 мм, живое сечение — 35,4 %. В ISO 7806 тот же рисунок записывают как R5 T8.',
	},
	{
		q: 'Как рассчитать живое сечение перфорированного листа?',
		a: 'Для круглых отверстий в шахматном порядке под 60° живое сечение равно 90,69 × (d/p)² процентов, где d — диаметр отверстия, p — шаг; для прямых рядов под 90° — 78,54 × (d/p)². Для Rv 5-8: 90,69 × (5/8)² = 35,4 %, для Rg 5-8: 78,54 × (5/8)² = 30,7 %. Доля зависит только от отношения d/p: Rv 5-8 и Rv 2,5-4 дают одинаковые 35,4 %.',
	},
	{
		q: 'Какую толщину листа и какой диаметр отверстий можно перфорировать?',
		a: 'Наш цех перфорирует лист толщиной от 0,5 до 6 мм и размером до 1500×3000 мм: отверстия от 1 мм на лазере и от 3 мм на координатно-пробивном прессе, расстояние между отверстиями от 1,5 диаметра (на странице услуги не уточнено, считают его между центрами или между краями отверстий, поэтому плотный рисунок согласуют по чертежу), точность позиционирования ±0,1 мм. Для лазера действует правило: диаметр не меньше толщины. Справочник IMOA для пробивки нержавейки рекомендует диаметр больше толщины минимум на один калибр толщины (gage size).',
	},
	{
		q: 'Можно ли перфорировать нержавеющий лист толще 6 мм?',
		a: 'Лазером и на координатно-пробивном прессе — нет: максимальная толщина листа 6 мм. Для толстого листа на странице услуги указан гидроабразив, и такие задачи считают индивидуально. Пришлите чертёж, марку и толщину — подскажем способ.',
	},
	{
		q: 'Сколько весит перфорированный лист?',
		a: 'Массу сплошного листа умножают на (1 − доля отверстий). Лист 1,5 мм из AISI 304 с рисунком Rv 5-8: сплошной весит 11,85 кг/м², перфорированный 11,85 × (1 − 0,354) = 7,65 кг/м²; лист 1250×2500 мм — около 23,9 кг. Неперфорированные поля по краям добавляют массу: при поле 20 мм по периметру — 24,5 кг.',
	},
	{
		q: 'Влияет ли перфорация на прочность и ровность листа?',
		a: 'Да. Жёсткость падает быстрее массы: при живом сечении 20 % и схеме 60° масса снижается на 20 %, а эффективный модуль упругости при изгибе — на 43 % (Jeong, Ahn, Lee, 2001). Пробивка плотного рисунка может коробить лист, и по справочнику IMOA после неё иногда нужна правка. Допустимый прогиб и способ перфорации согласуют по чертежу.',
	},
	{
		q: 'Какую марку нержавейки выбрать для перфорированного листа?',
		a: 'На странице услуги названы AISI 304, 316L, 321 и 430. Выбор определяет среда: в агрессивной среде берут марку с более высоким содержанием хрома и молибдена, например 316L вместо 304. У перфорированного листа много кромок отверстий, поэтому важны чистая кромка без заусенца и гладкая поверхность. Сравнение марок — в статье о 304, 316L и 321.',
	},
	{
		q: 'Как заказать перфорацию по чертежу?',
		a: 'Пришлите чертёж в DXF, DWG или AI либо эскиз с шагом и диаметром отверстий, а также марку, толщину, размер листа и количество. Перед серийной партией делают пробную из 1–3 листов, чтобы утвердить рисунок и кромку. Можно перфорировать лист из каталога или давальческий материал; на партию выдают сертификат завода на исходный лист и паспорт качества.',
	},
];

const sources = [
	{ label: 'ISO 7806:1983 «Industrial plate screens — Codification for designating perforations» — разд. 0 (введение), 1, 4 (примечания), 5.1–5.5, рис. 1–20 (коды формы R, C, CD, H, LR, LC; схемы U, Z, M, T; ориентация)', href: 'https://cdn.standards.iteh.ai/samples/14703/2044930c3e79496cb2b7eb8d1612071d/ISO-7806-1983.pdf' },
	{ label: 'DIN 24041:2022-06 «Lochbleche — Maße» (Perforated plates — Dimensions): область применения, редакция, статус', href: 'https://www.baunormenlexikon.de/norm/din-24041/295cd899-b571-4550-bdd1-d7477fe6b49b' },
	{ label: 'SCHÄFER Lochbleche — Was beschreibt die Norm DIN 24041?: состав стандарта, нормируемые заусенец после пробивки и после резки, плоскостность', href: 'https://www.schaefer-lochbleche.com/en/glossary/din-24041/' },
	{ label: 'SCHÄFER Lochbleche — каталог Rv DIN 24041 (Rundlochung versetzt): w, t, перемычка c, живое сечение A₀ %, например Rv 5-8 — 35,40 %', href: 'https://www.schaefer-lochbleche.de/fileadmin/Redakteur/LB/PDFs_Mediathek/lochblech-rv-din-24041.pdf' },
	{ label: 'SCHÄFER Lochbleche — каталог Rg DIN 24041 (Rundlochung gerade): w, t, живое сечение A₀ %, например Rg 5-8 — 30,7 %', href: 'https://www.schaefer-lochbleche.de/fileadmin/Redakteur/LB/PDFs_Mediathek/lochblech-rg-din-24041.pdf' },
	{ label: 'Rotec — Lochblech Glossar (DIN 24041): обозначения Rv, Rg, Qg, Qv, Lg, Lv, шаг, перемычка, неперфорированный край', href: 'https://www.rotec-blog.de/en/2025/10/11/lochblech-glossar/' },
	{ label: 'Wikipedia — Lochplatte (Halbzeug): определение, способы изготовления, DIN 24041 (редакция 2002 года заменила DIN 24041, 24042 и 24043), применение', href: 'https://de.wikipedia.org/wiki/Lochplatte_(Halbzeug)' },
	{ label: 'Wikipedia — Perforated metal: способы изготовления и применение (архитектура, фильтры, акустические панели, вентиляция)', href: 'https://en.wikipedia.org/wiki/Perforated_metal' },
	{ label: 'IMOA — Practical Guidelines for the Fabrication of Austenitic Stainless Steels, 2nd ed. 2020: разд. 9.3.2–9.3.3.1 (с. 42–44, срез, пробивка, перфорация), 9.4, 9.6', href: 'https://www.imoa.info/download_files/stainless-steel/Austenitics.pdf' },
	{ label: 'Jeong K.-H., Ahn B.-K., Lee S.-C. Modal analysis of perforated rectangular plates in contact with water, Structural Engineering and Mechanics, 12(2), 2001 — табл. 1 (эффективные константы пластин с треугольной сеткой отверстий)', href: 'http://www.techno-press.org/download.php?journal=sem&volume=12&num=2&ordernum=5' },
	{ label: "O'Donnell W.J., Langer B.F. Design of perforated plates, Journal of Engineering for Industry, 84, 1962 — метод расчёта перфорированных плит с треугольной сеткой отверстий", href: 'https://www.osti.gov/biblio/4805181' },
	{ label: 'ISSF — The Ferritic Solution, раздел об атмосферной коррозии (rules of thumb): марка с большим содержанием Cr и Mo, гладкая поверхность, отсутствие щелевых геометрий', href: 'https://worldstainless.org/wp-content/uploads/2025/02/ISSF_The_Ferritic_Solution_English.pdf' },
];

const related = [
	{ label: 'Перфорация листов: лазер и координатно-пробивной пресс', href: '/uslugi/perforaciya-listov/' },
	{ label: 'Лазерная резка нержавейки', href: '/uslugi/lazernaya-rezka/' },
	{ label: 'Гидроабразивная резка металла', href: '/uslugi/gidroabrazivnaya-rezka/' },
	{ label: 'AISI 304, 316L или 321: какую марку выбрать', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'Поверхности нержавеющего листа: 2B, BA, 4N, 8K', href: '/blog/poverhnosti-nerzhaveyushchego-lista/' },
	{ label: 'Чем резать нержавейку: лазер, плазма, гидроабразив', href: '/blog/chem-rezat-nerzhaveyku/' },
	{ label: 'Лист нержавеющий — каталог', href: '/list-nerzhaveyushchiy/' },
	{ label: 'Перила и ограждения из нержавейки', href: '/blog/perila-i-ograzhdeniya-iz-nerzhaveyki/' },
	{ label: 'Калькулятор веса металлопроката', href: '/kalkulyator-vesa/' },
	{ label: 'Калькулятор веса ПВЛ', href: '/kalkulyator-pvl/' },
	{ label: 'Вес листа нержавейки: таблица по толщине и формату', href: '/blog/ves-nerzhaveyushchego-lista-tablica/' },
	{ label: 'ГОСТ на нержавеющую сталь: таблица по видам проката', href: '/blog/gost-na-nerzhaveyushchuyu-stal/' },
