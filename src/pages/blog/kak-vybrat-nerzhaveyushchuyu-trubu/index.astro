---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'tipy', anchor: 'Типы труб и стандарты', summary: 'Бесшовная, ЭСВ, профильная, плоскоовальная, перфорированная' },
	{ id: 'besshovnaya-ili-esv', anchor: 'Бесшовная или электросварная', summary: 'Давление, шов, термообработка, длина' },
	{ id: 'marki', anchor: 'Марки для труб', summary: '304, 321, 316L, 316Ti, 430 и где какая' },
	{ id: 'razmery', anchor: 'Размеры, вес и цена', summary: '57×3, допуски, Ду и дюймы, ₽/м и ₽/т' },
	{ id: 'primenenie', anchor: 'Применение', summary: 'Пищевая, химия, вода, дымоходы, перила, мебель' },
	{ id: 'pokupka', anchor: 'Что проверить при покупке', summary: 'Сертификат, маркировка, геометрия, шов, торцы' },
	{ id: 'assortiment', anchor: 'Наш ассортимент', summary: 'Типы, марки и диапазоны размеров в каталоге' },
];

const faq = [
	{
		q: 'Какая труба лучше — бесшовная или электросварная?',
		a: 'Зависит от задачи. Бесшовная нужна для давления, горячих и агрессивных сред, толстой стенки, а также малых диаметров с жёсткими допусками: ГОСТ 9941-2022 даёт Ø от 5 мм и стенку от 0,2 мм. Электросварная дешевле и достаточна для перил, каркасов, пищевых линий и трубопроводов среднего давления. По ГОСТ 11068-81 каждая ЭСВ-труба проходит испытание 6 МПа или контроль шва, а прочность 08Х18Н10Т по норме не ниже, чем у горячедеформированной бесшовной: 530 против 510 МПа. В расчётах на давление для сварных труб вводят коэффициент шва.',
	},
	{
		q: 'Какой ГОСТ на нержавеющие трубы?',
		a: 'Бесшовные: ГОСТ 9940-81 (горячедеформированные, Ø 57–325 мм) и ГОСТ 9941-2022 (холоднодеформированные, Ø 5–426 мм; с 1 августа 2023 года вместо ГОСТ 9941-81). Электросварные круглые: ГОСТ 11068-81, Ø 8–102 мм. Марки — ГОСТ 5632-2014, приёмка и маркировка — ГОСТ 7566-2018. Отдельного ГОСТ на технические требования к профильным нержавеющим трубам мы не нашли: ГОСТ 13663-86 по перечню марок относится к углеродистым сталям. Профильные поставляют по ASTM A554 и ТУ изготовителя.',
	},
	{
		q: 'Какая марка нержавейки для труб лучше?',
		a: 'Марку выбирают по среде. AISI 304 (08Х18Н10) — пищевые продукты без хлоридов, вода, общие задачи. AISI 316L (03Х17Н14М3) — хлориды, рассолы, маринады, CIP-мойки, фармацевтика. AISI 321 (08Х18Н10Т, 12Х18Н10Т) — нагрев, пар, сварные узлы: титан защищает шов от межкристаллитной коррозии. Ферритная AISI 430 и AISI 201 — только сухие помещения и интерьер.',
	},
	{
		q: 'Чем профильная труба отличается от круглой?',
		a: 'Сечением и назначением. Круглую берут для трубопроводов, перил и стоек, профильную — квадратную или прямоугольную — для каркасов, мебели и конструкций: плоские грани удобны для крепления и сварки. Профильные трубы поставляют по ASTM A554 — это механические трубы для декоративных, конструкционных и выхлопных применений, а не напорные. Для жидкостей под давлением берут круглую трубу по ГОСТ 11068, 9940 или 9941.',
	},
	{
		q: 'Как считать вес нержавеющей трубы?',
		a: 'Масса 1 м круглой трубы, кг: M = π × ρ × s × (D − s) / 1000, где D — наружный диаметр, s — стенка (мм), ρ — плотность (г/см³). Для 08Х18Н10 и 12Х18Н10Т ρ = 7,9. Труба 57×3: 3,14159 × 7,9 × 3 × 54 / 1000 ≈ 4,02 кг на метр. Для профильной формулы другие. Считает калькулятор веса, для плоскоовальной — отдельный калькулятор.',
	},
	{
		q: 'Какую трубу выбрать для пищевого оборудования?',
		a: 'Для нейтральных продуктов — AISI 304, для солений, маринадов, соусов, фармацевтики и CIP-моек — AISI 316L. Смотрите на внутреннюю поверхность: у ЭСВ по ГОСТ 11068-81 внутренний грат допускается до 0,7 мм, по требованию при внутреннем диаметре свыше 20 мм — до 0,3 мм. Шероховатость контактных поверхностей, часто Ra ≤ 0,8 мкм, задают в заказе отдельно.',
	},
	{
		q: 'Нужен ли сертификат на трубу?',
		a: 'Да. По ГОСТ 11068-81 партия сопровождается документом о качестве, а состав ЭСВ принимают по документу на исходный рулон. По ГОСТ 7566-2018 результаты испытаний и состав плавки есть в документах 3.1 и 3.2, в документе 2.1 их нет. Номер плавки в сертификате должен совпадать с маркировкой на трубе. От посредника принимают оригинал или заверенную копию сертификата завода.',
	},
];

const sources = [
	{ label: 'ГОСТ 9940-81 «Трубы бесшовные горячедеформированные из коррозионно-стойкой стали» — п. 1.1–1.7, табл. 1–3, п. 2.1–2.6', href: 'https://files.stroyinf.ru/Data2/1/4294848/4294848734.htm' },
	{ label: 'ГОСТ 9941-2022 «Трубы бесшовные холоднодеформированные из коррозионно-стойких высоколегированных сталей» — введение, разд. 5, п. 6.1, 6.4, 6.6–6.9, п. 8.1, табл. 3–4, прил. А (текст, PDF)', href: 'https://files.stroyinf.ru/Data/798/79814.pdf' },
	{ label: 'Росстандарт — ГОСТ 9941-2022: статус «Действует», введён 1 августа 2023 года взамен ГОСТ 9941-81', href: 'https://protect.gost.ru/gost/details/69d6d5b0-077a-4a2b-b61e-be4497d33880' },
	{ label: 'ГОСТ 11068-81 «Трубы электросварные из коррозионно-стойкой стали» — табл. 1–4, п. 1.2–1.6, 2.1–2.10, 3.1–3.2, 5.1', href: 'https://files.stroyinf.ru/Data2/1/4294852/4294852683.htm' },
	{ label: 'Росстандарт — ГОСТ 11068-81: статус «Действует», введён 1 января 1983 года', href: 'https://protect.gost.ru/gost/details/0a88e531-f7f6-493e-b6f1-75228748bf47' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки»', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 7566-2018 «Металлопродукция. Правила приемки, маркировка, упаковка, транспортирование и хранение» — п. 5.2 и приложение Б', href: 'https://meganorm.ru/Data2/1/4293735/4293735060.pdf' },
	{ label: 'ГОСТ 13663-86 «Трубы стальные профильные. Технические требования»: область применения и перечень марок', href: 'http://docs.cntd.ru/document/1200004411' },
	{ label: 'ГОСТ 8639-82 «Трубы стальные квадратные. Сортамент»', href: 'http://docs.cntd.ru/document/1200004717' },
	{ label: 'ASTM A554 — Welded Stainless Steel Mechanical Tubing: круглые, квадратные, прямоугольные трубы до 16 дюймов (406,4 мм), стенка от 0,020 дюйма', href: 'https://store.astm.org/a0554-21.html' },
	{ label: 'ASTM A312 — Seamless, Welded, and Heavily Cold Worked Austenitic Stainless Steel Pipes: высокотемпературная и коррозионная служба, размеры по ASME B36.19', href: 'https://store.astm.org/a0312_a0312m-22.html' },
	{ label: 'ASTM A269 — Seamless and Welded Austenitic Stainless Steel Tubing for General Service', href: 'https://store.astm.org/a0269_a0269m-15ar19.html' },
	{ label: 'ASTM A249 — Welded Austenitic Steel Boiler, Superheater, Heat-Exchanger, and Condenser Tubes', href: 'https://store.astm.org/a0249_a0249m-24ae01.html' },
	{ label: 'ASTM A270 — Seamless and Welded Austenitic and Ferritic/Austenitic Stainless Steel Sanitary Tubing: молочная и пищевая промышленность, специальные поверхности', href: 'https://store.astm.org/a0270_a0270m-24.html' },
	{ label: 'EN 10216-5 — бесшовные трубы из нержавеющей стали для работы под давлением', href: 'https://www.en-standard.eu/bs-en-10216-5-2021-seamless-steel-tubes-for-pressure-purposes-technical-delivery-conditions-stainless-steel-tubes/' },
	{ label: 'EN 10217-7 — сварные трубы из нержавеющей стали для работы под давлением', href: 'https://www.en-standard.eu/bs-en-10217-7-2021-welded-steel-tubes-for-pressure-purposes-technical-delivery-conditions-stainless-steel-tubes/' },
	{ label: 'EN 10296-2 — сварные круглые трубы из нержавеющей стали для машиностроения и общих целей', href: 'https://www.en-standard.eu/bs-en-10296-2-2005-welded-circular-steel-tubes-for-mechanical-and-general-engineering-purposes-technical-delivery-conditions-stainless-steel/' },
	{ label: 'EN 10312 — сварные трубы из нержавеющей стали для воды, в том числе питьевой, Ø 6–159 мм', href: 'https://webstore.ansi.org/standards/bsi/bsen103122002' },
	{ label: 'Wikipedia — Nominal Pipe Size: соответствие NPS, DN и наружного диаметра, различие трубы (pipe) и трубки (tube)', href: 'https://en.wikipedia.org/wiki/Nominal_Pipe_Size' },
	{ label: 'ASME B31.3 — коэффициенты качества продольного шва для электросварных труб (сводка Littlepeng)', href: 'https://www.littlepeng.com/single-post/2017/07/12/ASME-B313-Quality-Factors?_amp_=' },
	{ label: 'ISSF — Protection of water: стали 304 и 316 в трубах для воды', href: 'https://worldstainless.org/applications/applications-for-the-protection-of-the-environment-and-human-health/protection-of-water/' },
	{ label: 'ГОСТ 10692 «Трубы стальные, чугунные и соединительные детали к ним. Приемка, маркировка, упаковка, транспортирование и хранение»' },
	{ label: 'ГОСТ 3845 «Трубы металлические. Метод испытания внутренним гидростатическим давлением»' },
];

const related = [
	{ label: 'AISI 304, 316L или 321: сравнение марок', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'AISI 316 и 316L: аналог по ГОСТ, состав, свойства', href: '/blog/aisi-316-i-316l/' },
	{ label: 'Пищевая нержавейка: какую марку и поверхность выбрать', href: '/blog/pishchevaya-nerzhaveyka/' },
	{ label: 'Как проверить нержавейку: магнит, анализатор, сертификат', href: '/blog/kak-proverit-nerzhaveyku/' },
	{ label: 'Сварка нержавейки полуавтоматом: газ и проволока', href: '/blog/svarka-nerzhaveyki-poluavtomatom/' },
	{ label: 'Перила и ограждения из нержавейки', href: '/blog/perila-i-ograzhdeniya-iz-nerzhaveyki/' },
	{ label: 'Труба нержавеющая — каталог', href: '/truba-nerzhaveyushchaya/' },
	{ label: 'Калькулятор веса плоскоовальной трубы', href: '/kalkulyator-ovalnoy-truby/' },
];
---

<BlogArticle
	slug="kak-vybrat-nerzhaveyushchuyu-trubu"
	title="Нержавеющая труба: бесшовная, сварная, профильная"
	description="Нержавеющая труба: чем бесшовная отличается от электросварной и профильной, какой ГОСТ и марку выбрать, как читать размер 57×3 и что проверить при покупке."
	h1="Нержавеющая труба: как выбрать бесшовную, электросварную или профильную"
	eyebrow="Справочник"
	datePublished="2026-10-05"
	dateModified="2026-10-05"
	readingMin={11}
	answer="<strong>Нержавеющую трубу выбирают по способу изготовления, марке и размеру: бесшовную (ГОСТ 9940-81, ГОСТ 9941-2022) — для давления и ответственных сред, электросварную (ГОСТ 11068-81, ASTM A554, EN 10217-7) — для трубопроводов, каркасов и перил, профильную (квадрат, прямоугольник) — для конструкций и мебели.</strong> Марку берут по среде: AISI 304 (08Х18Н10) — пищевые и общие задачи, 316L (03Х17Н14М3) — хлориды и кислоты, 321 (08Х18Н10Т, 12Х18Н10Т) — нагрев и сварные узлы. Размер читается как наружный диаметр × стенка: труба 57×3 из 12Х18Н10Т весит около 4,0 кг на метр."
	keyFacts={[
		'ГОСТ 9940-81: горячедеформированные Ø 57–325 мм, стенка 3,5–32 мм; ГОСТ 9941-2022 (с 1 августа 2023 года вместо 9941-81): холоднодеформированные Ø 5–426 мм, стенка 0,2–40 мм',
		'ГОСТ 11068-81: электросварные Ø 8–102 мм, стенка 0,8–4,0 мм, длина 5–9 м; испытание 6 МПа или контроль шва неразрушающими методами',
		'ASTM A554 (круглые, квадратные, прямоугольные) — до 406,4 мм: в нашем прайсе так поставляют профильные трубы и ЭСВ крупнее 102 мм',
		'Масса 1 м: M = π × ρ × s × (D − s) / 1000; ρ = 7,9 г/см³ для 08Х18Н10 и 12Х18Н10Т, 8,0 — для 10Х17Н13М2Т',
		'Сертификат — вид 3.1 по ГОСТ 7566-2018: номер плавки и состав должны совпадать с маркировкой трубы',
	]}
	coverAlt="Нержавеющая труба: бесшовная, электросварная и профильная — стандарты, марки и размеры"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Нержавеющая труба', 'Бесшовные трубы', 'Электросварные трубы', 'Профильная труба', 'ГОСТ 9940', 'ГОСТ 9941', 'ГОСТ 11068']}
	cta={{ title: 'Нужна нержавеющая труба?', text: 'Поставляем бесшовные, электросварные и профильные трубы из AISI 304, 316L и 12Х18Н10Т (AISI 321) с сертификатом завода — пришлите марку, диаметр, стенку и длину для расчёта.' }}
>
	<section id="tipy">
		<h2>Типы нержавеющих труб и стандарты на них</h2>
		<p>
			Нержавеющую трубу (труба нержавейка, труба из нержавеющей стали) описывают тремя признаками: способом
			изготовления, сечением и состоянием поставки. Бесшовную прошивают и деформируют из заготовки.
			Электросварную сворачивают из ленты и сваривают продольным швом. Сечение — круглое или профильное.
			Состояние — термообработанная труба или поставка без термообработки.
		</p>
		<div class="ba-table">
			<table>
				<caption>Типы нержавеющих труб: стандарт, размеры, когда выбирать</caption>
				<thead>
					<tr><th>Тип</th><th>Стандарт</th><th>Размеры</th><th>Когда выбирать</th><th>Ограничения</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>Бесшовная горячедеформированная</td>
						<td>ГОСТ 9940-81</td>
						<td>Ø 57–325 мм, стенка 3,5–32 мм</td>
						<td>Толстая стенка, большие диаметры, пар, давление</td>
						<td>Допуск по диаметру ±1,5 %; допускаются риски и единичные плены без зачистки</td>
					</tr>
					<tr>
						<td>Бесшовная холоднодеформированная</td>
						<td>ГОСТ 9941-2022 (раньше 9941-81)</td>
						<td>Ø 5–426 мм, стенка 0,2–40 мм</td>
						<td>Малые диаметры, тонкая стенка, жёсткие допуски, чистая поверхность</td>
						<td>Как правило дороже ЭСВ; испытания на давление заказывают отдельно</td>
					</tr>
					<tr>
						<td>Электросварная круглая (ЭСВ)</td>
						<td>ГОСТ 11068-81; ASTM A554, A269, A249; EN 10217-7</td>
						<td>ГОСТ 11068: Ø 8–102 мм, стенка 0,8–4,0 мм. ASTM A554: до 406,4 мм, стенка от 0,51 мм</td>
						<td>Трубопроводы среднего давления, пищевые линии, перила, каркасы, дымоходы</td>
						<td>Продольный шов; внутренний грат до 0,7 мм; в расчётах на давление коэффициент шва</td>
					</tr>
					<tr>
						<td>Профильная: квадрат, прямоугольник</td>
						<td>ASTM A554; размеры стальных труб — ГОСТ 8639-82, ГОСТ 8645-68</td>
						<td>В каталоге: 10×10…200×200 и 20×10…200×100 мм, стенка 1–5 мм</td>
						<td>Каркасы, мебель, архитектура, ограждения</td>
						<td>Не напорная: A554 — механические трубы. ГОСТ 13663-86 по перечню марок — углеродистые стали</td>
					</tr>
					<tr>
						<td>Плоскоовальная</td>
						<td>Единого ГОСТ не нашли; размеры задаёт изготовитель</td>
						<td>Типовые 30×15, 40×20, 50×25 мм, стенка 1,0–2,0 мм</td>
						<td>Поручни перил, мебельные каркасы</td>
						<td>В прайсе нет; вес — в <a href="/kalkulyator-ovalnoy-truby/">отдельном калькуляторе</a></td>
					</tr>
					<tr>
						<td>Перфорированная</td>
						<td>Технические условия изготовителя</td>
						<td>В прайсе: 25×1, отверстия «под трубу» 12 и 16 мм, 6 м</td>
						<td>Стойки ограждений с перекладинами</td>
						<td>Отверстия снижают прочность; 4 позиции</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			<strong>Тонкостенная труба</strong> — не отдельный стандарт, а область размеров: у ЭСВ по ГОСТ 11068-81
			стенка от 0,8 мм, у ASTM A554 — от 0,51 мм, у бесшовной по ГОСТ 9941-2022 — от 0,2 мм. Чем тоньше
			стенка, тем важнее допуск: у ЭСВ при стенке 0,8–2 мм он ±0,20 мм при обычной точности.
		</p>
		<p>
			<strong>«Холоднодеформированная»</strong> — по введению ГОСТ 9941-2022 труба, деформированная ниже температуры
			рекристаллизации. Размеры точнее, чем у горячедеформированной. <strong>«ЭСВ по ГОСТ 11068»</strong> —
			электросварная круглая труба из коррозионно-стойкой стали Ø 8–102 мм. Более крупные ЭСВ поставляют по
			зарубежным стандартам, в нашем прайсе — по ASTM A554 и EN 10217-7.
		</p>
		<p>
			<strong>ASTM и EN кратко.</strong> A312 — бесшовные и сварные аустенитные трубы для высокотемпературной и
			коррозионной службы. A269 — трубы общего назначения. A249 — сварные трубы для котлов и теплообменников.
			A270 — санитарные трубы для пищевой промышленности. EN 10216-5 и EN 10217-7 — бесшовные и сварные
			напорные трубы. EN 10296-2 — сварные круглые для машиностроения. EN 10312 — сварные трубы для воды, в том
			числе питьевой, Ø 6–159 мм.
		</p>
		<p>
			Статус: ГОСТ 9941-2022 введён 1 августа 2023 года взамен ГОСТ 9941-81, ГОСТ 11068-81 действует, ГОСТ
			9940-81 в российских справочных базах числится действующим. В прайсах часто остаётся «ГОСТ 9941» без
			года — уточняйте редакцию. В нашем справочнике:
			<a href="/gost/9940-81/">ГОСТ 9940-81</a>, <a href="/gost/9941-81/">ГОСТ 9941-81</a> (прежняя редакция),
			<a href="/gost/11068-81/">ГОСТ 11068-81</a>.
		</p>
	</section>

	<section id="besshovnaya-ili-esv">
		<h2>Бесшовная или электросварная труба</h2>
		<p>
			Главное отличие — продольный шов у ЭСВ. Остальное следует из него: давление, внутренняя поверхность,
			цена и сортамент.
		</p>
		<div class="ba-table">
			<table>
				<caption>Бесшовная и электросварная труба по стандартам</caption>
				<thead>
					<tr><th>Критерий</th><th>Бесшовная</th><th>Электросварная (ЭСВ)</th></tr>
				</thead>
				<tbody>
					<tr><td>Размеры</td><td>Ø 5–426 мм, стенка до 40 мм (ГОСТ 9941-2022)</td><td>ГОСТ 11068: Ø 8–102 мм, стенка 0,8–4,0 мм</td></tr>
					<tr><td>Испытание давлением</td><td>По требованию заказчика (ГОСТ 9940, п. 2.6; ГОСТ 9941-2022, п. 6.8)</td><td>Каждая труба: 6 МПа или контроль шва; до 20 МПа по требованию (ГОСТ 11068, п. 2.10)</td></tr>
					<tr><td>Внутренняя поверхность</td><td>Без шва и грата</td><td>Грат до 0,7 мм, по требованию при Ø свыше 20 мм — до 0,3 мм</td></tr>
					<tr><td>08Х18Н10Т, σв не менее</td><td>510 МПа, δ 40 % (ГОСТ 9940-81)</td><td>530 МПа, δ5 37 % (ГОСТ 11068-81, термообработанная)</td></tr>
					<tr><td>Длина</td><td>Немерная 1,5–10 м (9940), 0,6–12,5 м (9941)</td><td>Мерная 5–9 м, немерная 1,5–9 м</td></tr>
					<tr><td>Цена</td><td>Как правило выше</td><td>Как правило ниже</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			<strong>Давление и ответственные среды.</strong> Для напорных линий берут бесшовную. Причина — расчёт: в
			нормах на трубопроводы, например в ASME B31.3, для сварных труб вводят коэффициент качества шва. По
			сводке это 0,85 у ERW и 0,80–1,00 у EFW в зависимости от контроля шва. При этом ГОСТ 9940 и ГОСТ
			9941-2022 вводят гидроиспытание и неразрушающий контроль только «по требованию заказчика»: если они
			нужны, пишите их в заказ. Испытательное давление считают по ГОСТ 3845 при напряжении 40 % от временного
			сопротивления.
		</p>
		<p>
			<strong>Качество шва.</strong> ГОСТ 11068-81 запрещает непровары, поры, трещины, плены, рванины, окалину и
			следы перетрава; допускает риски и цвета побежалости. Внутренний грат нормирован. Для пищевых и
			фармацевтических линий, где в канале не должно быть выступов, его высоту указывают в заказе либо берут
			бесшовную трубу.
		</p>
		<p>
			<strong>Термообработка.</strong> ГОСТ 11068-81 требует поставлять термообработанными ЭСВ из 08Х18Н10Т,
			08Х18Т1, 10Х18Н10Т, 12Х18Н10Т и 04Х17Т; другие марки — по требованию потребителя без термообработки. В
			обозначении термообработанной трубы после слова «Труба» ставят «Т». ГОСТ 9941-2022 тоже требует
			термообработки, вид и режим выбирает изготовитель; поставка без неё — по требованию. Он же требует
			травления, кроме труб, обработанных в защитной атмосфере или вакууме; матовая серая поверхность после
			травления допустима. Для химической промышленности ГОСТ 11068-81 (п. 2.6) требует испытания
			термообработанных труб на <a href="/blog/mezhkristallitnaya-korroziya/">межкристаллитную коррозию</a>.
		</p>
		<p>
			<strong>Длина.</strong> «Мерная» — одна заданная длина, например 6000 мм, допуск +15 мм. «Кратная мерной» —
			кратна заданной, на каждый рез добавляют 5 мм. «Немерная» — любая в диапазоне стандарта. В нашем прайсе
			у большинства труб длина 6 м.
		</p>
	</section>

	<section id="marki">
		<h2>Марки нержавейки для труб</h2>
		<p>Марку выбирают по среде и температуре, а не по типу трубы.</p>
		<div class="ba-table">
			<table>
				<caption>Марки для труб: аналоги и область применения</caption>
				<thead>
					<tr><th>Марка по ГОСТ 5632-2014</th><th>Аналог</th><th>Где применять</th><th>В каталоге труб</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>08Х18Н10</td>
						<td><a href="/truba-nerzhaveyushchaya/aisi-304/">AISI 304</a></td>
						<td>Пищевые продукты без хлоридов, вода, перила, каркасы</td>
						<td>ЭСВ, профильные</td>
					</tr>
					<tr>
						<td>08Х18Н10Т, 12Х18Н10Т</td>
						<td><a href="/truba-nerzhaveyushchaya/aisi-321/">AISI 321</a></td>
						<td>Нагрев, пар, дымоходы, сварные узлы: титан связывает углерод и защищает шов</td>
						<td>Бесшовные, основа прайса</td>
					</tr>
					<tr>
						<td>03Х17Н14М3</td>
						<td><a href="/truba-nerzhaveyushchaya/aisi-316l/">AISI 316L</a></td>
						<td>Хлориды, рассолы, маринады, CIP, фармацевтика, химия</td>
						<td>ЭСВ; бесшовные — 03Х17Н13М2</td>
					</tr>
					<tr>
						<td>08Х17Н13М2Т, 10Х17Н13М2Т</td>
						<td><a href="/truba-nerzhaveyushchaya/aisi-316ti/">AISI 316Ti</a></td>
						<td>Горячие кислотные среды, сварные узлы</td>
						<td>Бесшовные</td>
					</tr>
					<tr>
						<td>12Х17</td>
						<td><a href="/truba-nerzhaveyushchaya/aisi-430/">AISI 430</a></td>
						<td>Ферритная, магнитная: сухие помещения, интерьер, мебель</td>
						<td>Профильные</td>
					</tr>
					<tr>
						<td>12Х15Г9НД</td>
						<td><a href="/truba-nerzhaveyushchaya/aisi-201/">AISI 201</a></td>
						<td>Только сухие помещения без хлоридов</td>
						<td>ЭСВ круглые и профильные</td>
					</tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>Хлориды и кислоты.</strong> 304 даёт питтинг в рассолах и хлорных растворах — берут 316L. Для морской воды и бассейнов — <a href="/blog/nerzhaveyka-dlya-morskoy-vody/">отдельная статья</a>: 316L там не всегда достаточно.</li>
			<li><strong>Нагрев и сварка.</strong> Нестабилизированная 304 в интервале 450–850 °C склонна к межкристаллитной коррозии. Для горячих узлов и сварки без термообработки — 321 или L-марки. См. <a href="/blog/zharoprochnaya-nerzhaveyka/">жаропрочную нержавейку</a> и <a href="/blog/svarka-nerzhaveyki-poluavtomatom/">сварку полуавтоматом</a>.</li>
			<li><strong>Пищевая промышленность.</strong> Нейтральные продукты — 304, соленья, соусы, фарма, CIP — 316L. См. <a href="/blog/pishchevaya-nerzhaveyka/">пищевую нержавейку</a>.</li>
			<li><strong>Агрессивные среды.</strong> В бесшовных трубах есть 904L, дуплекс 2205, 309S и 310S — по 2–5 позиций.</li>
		</ul>
		<p>
			В ГОСТ 9940 и ГОСТ 9941 есть и хромистые 08Х13, 12Х13, 12Х17, но в нашем прайсе их нет, как и ЭСВ из 321.
			Сравнение 304, 316L и 321 — в статье <a href="/blog/aisi-304-vs-316l-vs-321/">AISI 304, 316L или 321</a>,
			про молибден — <a href="/blog/aisi-316-i-316l/">AISI 316 и 316L</a>.
		</p>
	</section>

	<section id="razmery">
		<h2>Размеры, вес и единицы цены</h2>

		<h3>Как читать «57×3»</h3>
		<p>
			Первое число — наружный диаметр, мм, второе — стенка. Труба 57×3 — Ø 57 мм со стенкой 3 мм, внутренний
			диаметр 51 мм. Профильную записывают тремя числами: 40×20×1,5 — стороны 40 и 20 мм, стенка 1,5 мм.
			В обозначении по ГОСТ указывают марку, длину и точность: «Труба 76×5 — 08Х18Н10Т ГОСТ 9940-81» или
			«Труба 25×2×6000 — 08Х18Н10Т ГОСТ 11068-81». Буква «п» после размера — повышенная точность, «в» —
			высокая, «кр» — кратная длина.
		</p>

		<h3>Допуски</h3>
		<div class="ba-table">
			<table>
				<caption>Допуски при обычной точности</caption>
				<thead>
					<tr><th>Стандарт</th><th>Наружный диаметр</th><th>Стенка</th></tr>
				</thead>
				<tbody>
					<tr><td>ГОСТ 11068-81 (ЭСВ)</td><td>до 20 мм ±0,30 мм; 20–35 мм ±0,35 мм; свыше 35 мм ±1,0 %</td><td>0,8–2 мм ±0,20 мм; 2–3 мм ±0,25 мм; свыше 3 мм ±10 %</td></tr>
					<tr><td>ГОСТ 9940-81</td><td>±1,5 %</td><td>до 8 мм +20 / −15 %</td></tr>
					<tr><td>ГОСТ 9941-2022</td><td>до 10 мм ±0,30 мм; 10–30 мм ±0,40 мм; 30–95 мм ±1,2 %</td><td>1–3 мм: +12,5 / −15 %; 3–7 мм: ±12,5 % (при D/s менее 40)</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Повышенная и высокая точность сужают допуски: у ЭСВ по диаметру свыше 35 мм — до ±0,75 %. Давление
			определяет стенка, а не диаметр; толщину рассчитывает проектировщик, а допуск «в минус» уменьшает запас —
			проверяйте минимальную стенку.
		</p>

		<h3>Вес метра</h3>
		<p>
			ГОСТ 9941-2022 и ГОСТ 11068-81 дают одну формулу массы 1 м круглой трубы, кг:
			<strong>M = π × ρ × s × (D − s) / 1000</strong>, где D — наружный диаметр, s — стенка (мм), ρ — плотность
			(г/см³). Для 12Х18Н10Т, ρ = 7,9: труба 57×3 весит 3,14159 × 7,9 × 3 × 54 / 1000 ≈ 4,02 кг на метр, в
			тонне около 249 м. Труба 25×2 — 1,14 кг на метр, 76×5 — 8,81 кг.
		</p>
		<p>
			Плотность зависит от марки. По ГОСТ 11068-81: 7,9 для 08Х18Н10, 08Х18Н10Т, 12Х18Н10Т; 8,0 для
			10Х17Н13М2Т и 03Х17Н14М3. Приложение А к ГОСТ 9941-2022 даёт для 03Х17Н14М3 7,75: расхождение около 3 %,
			поэтому в договоре на крупную партию фиксируйте плотность, по которой считают массу. См.
			<a href="/blog/plotnost-nerzhaveyushchey-stali/">плотность нержавеющей стали</a>.
		</p>
		<p>
			Профильные: квадратная — (4A − 4s) × s × ρ / 1000, прямоугольная — (2(A + B) − 4s) × s × ρ / 1000, без
			скруглённых углов. Квадрат 40×40×2 при ρ = 7,9 весит 2,40 кг на метр, прямоугольник 60×40×1,5 — 2,30 кг.
			Любой размер считает <a href="/kalkulyator-vesa/">калькулятор веса металлопроката</a>.
		</p>

		<h3>Ду, DN и дюймовые размеры</h3>
		<p>
			Условный проход Ду (DN) — обозначение, а не размер. Для труб NPS до 12 дюймов наружный диаметр больше
			номинала: NPS 2 (Ду 50) — это Ø 60,3 мм. Начиная с NPS 14 он равен номиналу в дюймах. У тонкостенных
			труб (tube по ASTM A269, A554) размер — фактический диаметр: 2 дюйма — 50,8 мм.
		</p>
		<p>
			Размеры «в Ду» из нашего каталога: Ду 15 — Ø 21,3 мм; Ду 20 — 26,9; Ду 25 — 33,7; Ду 32 — 42,4; Ду 40 — 48,3;
			Ду 50 — 60,3; Ду 80 — 88,9; Ду 100 — 114,3; Ду 150 — 168,3; Ду 200 — 219,1. ASME даёт чуть другие значения:
			33,40 мм для NPS 1 и 60,33 мм для NPS 2. Для Ду 65 встречаются Ø 73 (ASME: 73,03) и 76,1 мм. В заказе
			указывайте наружный диаметр, а не только Ду.
		</p>

		<h3>Цена за метр или за тонну</h3>
		<p>
			Бесшовные трубы продают за тонну. У электросварных и профильных цену часто называют за метр: размеры
			мелкие, масса метра небольшая. В нашем каталоге цены труб приведены к рублям за тонну по расчётной
			массе при ρ = 7,9. Чтобы сравнить предложения, переведите их в одну единицу: цена за тонну = цена за
			метр ÷ масса метра в килограммах × 1000.
		</p>
	</section>

	<section id="primenenie">
		<h2>Применение: какую трубу куда</h2>
		<ul>
			<li><strong>Пищевая и фармацевтическая промышленность.</strong> Технологические трубопроводы, молочные и пивоваренные линии, CIP; марки 304 и 316L. Для санитарных линий ASTM A270 допускает специальные отделки, включая электрополировку. Шероховатость (часто Ra ≤ 0,8 мкм) и высоту внутреннего грата задают в заказе.</li>
			<li><strong>Химическое оборудование.</strong> Бесшовные трубы по ГОСТ 9940 и 9941, марки 316L, 316Ti, 321; в кислотах и горячих растворах — 904L и дуплекс. Для химического машиностроения ГОСТ 11068-81 требует испытания на МКК термообработанных труб из ряда марок.</li>
			<li><strong>Водоснабжение и отопление.</strong> ISSF отмечает, что 304 и 316 успешно применяют в воде без припуска на общую коррозию. EN 10312 описывает сварные трубы для воды Ø 6–159 мм. Выбор между 304 и 316L определяют хлориды в воде — пределы в статье об <a href="/blog/aisi-316-i-316l/">AISI 316L</a>.</li>
			<li><strong>Дымоходы.</strong> Для газового котла берут 316L: кислотный конденсат важнее предельной температуры; для горячих газов — 321, 309S или 310S по температуре. Пределы — в статье о <a href="/blog/zharoprochnaya-nerzhaveyka/">жаропрочной нержавейке</a>.</li>
			<li><strong>Перила и ограждения.</strong> ЭСВ круглая Ø 25–50 мм, шлифованная или зеркальная. На улице — 304, у моря и бассейнов — 316L, в сухих помещениях подойдут 430 и 201. См. <a href="/blog/perila-i-ograzhdeniya-iz-nerzhaveyki/">перила и ограждения</a>.</li>
			<li><strong>Мебель и архитектура.</strong> Профильные и тонкостенные ЭСВ-трубы. В прайсе три поверхности: матовая, шлифованная, зеркальная.</li>
					</ul>
	</section>

	<section id="pokupka">
		<h2>Что проверить при покупке</h2>
		<ol>
			<li><strong>Сертификат.</strong> По ГОСТ 7566-2018 состав плавки и результаты испытаний указаны в документах 3.1 и 3.2; в документе 2.1 результатов нет. Нужен вид 3.1 или 3.2. Состав ЭСВ принимают по документу на рулон, поэтому в сертификате должна быть плавка исходной ленты.</li>
			<li><strong>Маркировка.</strong> Марка, стандарт, номер плавки и размер на трубе или ярлыке. У труб по ASTM A312 указывают способ изготовления: SML — бесшовная, WLD — сварная. Без маркировки сертификат не привязан к металлу. Маркировка и упаковка — по ГОСТ 10692.</li>
			<li><strong>Геометрия.</strong> Диаметр измеряют скобой или штангенциркулем, стенку — микрометром или стенкомером. Кривизна по ГОСТ 11068-81 и ГОСТ 9940 — не более 1,5 мм на 1 м (у 9940 при стенке до 10 мм).</li>
			<li><strong>Шов и поверхность.</strong> У ЭСВ осмотрите наружный и внутренний шов: непровары, поры, трещины и окалина недопустимы, цвета побежалости допускаются. Проверьте, что поверхность соответствует заказу: травлёная, шлифованная или полированная.</li>
			<li><strong>Термообработка.</strong> У ЭСВ по ГОСТ 11068-81 в обозначении есть «Т». По ГОСТ 9941-2022 без термообработки трубу поставляют только по требованию заказчика.</li>
			<li><strong>Магнитный тест.</strong> Магнит отличает аустенитную сталь от ферритной и мартенситной, но не 304 от 316L. После холодной деформации и у шва аустенитная труба может слабо притягивать магнит — это не признак подделки. Подробно — в статьях <a href="/blog/kak-proverit-nerzhaveyku/">как проверить нержавейку</a> и <a href="/blog/magnitit-li-nerzhaveika/">магнитится ли нержавейка</a>.</li>
			<li><strong>Торцы.</strong> Концы обрезаны под прямым углом и зачищены от заусенцев. Фаску под сварку делают по требованию: у ГОСТ 9940 — при стенке более 5 мм, у ГОСТ 9941-2022 — при стенке 5–22 мм (ГОСТ 34094, тип ФП2).</li>
		</ol>
		<p>Если трубу продаёт посредник, он передаёт оригинал сертификата завода или заверенную копию без изменений.</p>
	</section>

	<section id="assortiment">
