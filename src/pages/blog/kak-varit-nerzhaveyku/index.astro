---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sposoby', anchor: 'Способы сварки', summary: 'MMA, TIG, MIG — когда какой' },
	{ id: 'elektrody', anchor: 'Электроды', summary: 'ОЗЛ-8, ЦЛ-11, ОЗЛ-6 и аналоги' },
	{ id: 'tok', anchor: 'Сварочный ток', summary: 'Режимы по паспортам электродов' },
	{ id: 'provoloka', anchor: 'Проволока и газ', summary: 'ER308L, ER316L, Св-… и аргон' },
	{ id: 'pravila', anchor: 'Главные правила', summary: 'Без перегрева, межпроходная температура' },
	{ id: 'posle', anchor: 'После сварки', summary: 'Побежалость, травление, пассивация' },
];

const faq = [
	{
		q: 'Какими электродами варить нержавейку AISI 304?',
		a: 'Для AISI 304 (08Х18Н10) обычно берут ОЗЛ-8 (тип Э-07Х20Н9 по ГОСТ 10052) или ОЗЛ-36 (Э-04Х20Н9). Зарубежный аналог — электроды классов E308 и E308L. Если шов должен быть стойким к межкристаллитной коррозии, выбирают низкоуглеродистые или стабилизированные ниобием электроды.',
	},
	{
		q: 'Чем отличаются ОЗЛ-8 и ЦЛ-11?',
		a: 'ЦЛ-11 (тип Э-08Х20Н9Г2Б) содержит ниобий, который связывает углерод, поэтому шов стоек к межкристаллитной коррозии. Его применяют для 12Х18Н10Т (AISI 321) и других сталей, где это требование важно; зарубежный аналог — E347. ОЗЛ-8 без ниобия — для 08Х18Н10 и аналогичных сталей в менее ответственных узлах.',
	},
	{
		q: 'Можно ли варить нержавейку с чёрным металлом?',
		a: 'Да, но нужны электроды или проволока с повышенным запасом хрома и никеля — типа Э-10Х25Н13Г2 (ОЗЛ-6, ЗИО-8), зарубежное семейство E309 и проволока ER309L или Св-07Х25Н13. Обычный электрод для нержавейки при разбавлении углеродистой сталью даёт хрупкий шов.',
	},
	{
		q: 'Какую полярность ставить при сварке нержавейки?',
		a: 'Для ручной дуговой сварки штучными электродами — постоянный ток обратной полярности (электрод на плюсе), так указано в паспортах ОЗЛ-8 и ЦЛ-11. Для аргонодуговой сварки неплавящимся вольфрамовым электродом (TIG) — постоянный ток прямой полярности (вольфрам на минусе).',
	},
	{
		q: 'Нужно ли прокаливать электроды для нержавейки?',
		a: 'Да, если электроды отсырели или так требует паспорт. Режим прокалки у заводов разный: например, Спецэлектрод указывает 190–210 °C в течение часа, Сычёвский электродный завод для ОЗЛ-8 — 380 °C в течение часа. Всегда ориентируйтесь на паспорт конкретной партии.',
	},
	{
		q: 'Почему сварной шов на нержавейке ржавеет?',
		a: 'Чаще всего из-за цветов побежалости: под оксидной плёнкой остаётся слой, обеднённый хромом. Другие причины — частицы железа от общего инструмента, перегрев с выпадением карбидов хрома (межкристаллитная коррозия) и неподходящие сварочные материалы. Помогают травление и пассивация шва.',
	},
];

const sources = [
	{ label: 'ГОСТ 10052 «Электроды покрытые металлические для ручной дуговой сварки высоколегированных сталей»' },
	{ label: 'ГОСТ 2246 «Проволока стальная сварочная»; AWS A5.9 — проволока для сварки нержавеющих сталей' },
	{ label: 'Паспорта электродов ОЗЛ-8, ОЗЛ-36, ЦЛ-11 — Спецэлектрод', href: 'https://www.spetselectrode.ru/electrod/ozl8.htm' },
	{ label: 'Таблица соответствия электродов ESAB и российских марок', href: 'https://tkber.ru/sites/default/files/esab_analog_0.pdf' },
	{ label: 'Kobelco — межпроходная температура при сварке нержавеющей стали', href: 'https://www.kobelco-welding.jp/education-center/abc/ABC_2001-01.html' },
	{ label: 'Lincoln Electric — MIG welding stainless steel', href: 'https://www.lincolnelectric.com/en/welding-and-cutting-resource-center/process-and-theory/mig-welding-stainless-steel' },
	{ label: 'ASSDA — тепловое расширение и деформации при изготовлении конструкций', href: 'https://www.assda.asn.au/blog/293-thermal-expansion-and-design-of-stainless-steel-fabrications' },
];

const related = [
	{ label: 'Межкристаллитная коррозия: зачем титан и марки L', href: '/blog/mezhkristallitnaya-korroziya/' },
	{ label: 'Как убрать цвета побежалости после сварки', href: '/blog/kak-pochistit-nerzhaveyku/' },
	{ label: 'Лист AISI 304 (08Х18Н10)', href: '/list-nerzhaveyushchiy/aisi-304/' },
	{ label: 'Лист AISI 321 (12Х18Н10Т)', href: '/list-nerzhaveyushchiy/aisi-321/' },
	{ label: 'Проволока нержавеющая', href: '/provoloka-nerzhaveyushchaya/' },
	{ label: 'Труба нержавеющая', href: '/truba-nerzhaveyushchaya/' },
];
---

<BlogArticle
	slug="kak-varit-nerzhaveyku"
	title="Как варить нержавейку: электроды, проволока, режимы"
	description="Как варить нержавейку: электроды ОЗЛ-8, ЦЛ-11, ОЗЛ-6 для AISI 304, 321, 316L, проволока ER308L и ER316L, токи по паспортам и полярность."
	h1="Как варить нержавейку: электроды, проволока и режимы сварки"
	eyebrow="Инструкция"
	datePublished="2026-09-19"
	dateModified="2026-09-19"
	readingMin={7}
	answer="<strong>Для AISI 304 и 12Х18Н10Т при ручной дуговой сварке обычно берут электроды ОЗЛ-8 (тип Э-07Х20Н9) или ЦЛ-11 (Э-08Х20Н9Г2Б, аналог E347), если шов должен быть стойким к межкристаллитной коррозии.</strong> Варят постоянным током обратной полярности, короткой дугой и без перегрева: межпроходная температура — не выше 150 °C. Для аргонодуговой сварки (TIG) применяют проволоку ER308L или ER316L, аргон и прямую полярность."
	keyFacts={[
		'AISI 304 (08Х18Н10) — ОЗЛ-8, ОЗЛ-36; проволока ER308L',
		'12Х18Н10Т (AISI 321) — ЦЛ-11 с ниобием; проволока ER347',
		'AISI 316L, 10Х17Н13М2Т — ЭА-400/10У, НЖ-13; проволока ER316L',
		'Нержавейка с чёрной сталью — ОЗЛ-6 (Э-10Х25Н13Г2), проволока ER309L',
		'Межпроходная температура — до 150 °C (AWS D1.6 допускает до 175 °C)',
	]}
	coverAlt="Как варить нержавейку: электроды, проволока и режимы сварки"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Сварка нержавеющей стали', 'Электроды для нержавейки', 'Сварочная проволока']}
	cta={{ title: 'Нужен металл под сварные конструкции?', text: 'Лист, труба и круг AISI 304, 321, 316L с сертификатом — подберём марку под ваш шов и среду.' }}
>
	<section id="sposoby">
		<h2>Какой способ сварки выбрать</h2>
		<div class="ba-table">
			<table>
				<caption>Способы сварки нержавеющей стали</caption>
				<thead>
					<tr><th>Способ</th><th>Чем варят</th><th>Где удобен</th></tr>
				</thead>
				<tbody>
					<tr><td>Ручная дуговая (РДС, MMA)</td><td>Штучные электроды, постоянный ток обратной полярности</td><td>Монтаж, ремонт, работа на улице и в труднодоступных местах</td></tr>
					<tr><td>Аргонодуговая (TIG)</td><td>Вольфрамовый электрод, присадочная проволока, аргон</td><td>Тонкий металл, корневые проходы, трубопроводы, пищевое оборудование — самый аккуратный шов</td></tr>
					<tr><td>Полуавтомат (MIG)</td><td>Проволока в защитном газе</td><td>Серийное производство, длинные швы, высокая производительность</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Для ответственных швов в пищевых и фармацевтических трубопроводах обычно выбирают TIG с продувкой
			корня аргоном: шов получается чистым, с минимальной побежалостью изнутри.
		</p>
	</section>

	<section id="elektrody">
		<h2>Электроды для нержавейки</h2>
		<p>
			Тип электрода по ГОСТ 10052 показывает химический состав наплавленного металла: например,
			Э-07Х20Н9 — около 0,07 % углерода, 20 % хрома и 9 % никеля. Электрод подбирают так, чтобы шов по
			составу соответствовал основному металлу или был чуть более легированным.
		</p>
		<div class="ba-table">
			<table>
				<caption>Популярные марки электродов</caption>
				<thead>
					<tr><th>Марка</th><th>Тип по ГОСТ 10052</th><th>Зарубежный аналог</th><th>Для каких сталей</th></tr>
				</thead>
				<tbody>
					<tr><td>ОЗЛ-8</td><td>Э-07Х20Н9</td><td>E308 / E308L</td><td>08Х18Н10, 12Х18Н9, 08Х18Н10Т (AISI 304)</td></tr>
					<tr><td>ОЗЛ-36</td><td>Э-04Х20Н9</td><td>E308L (ESAB OK 61.30)</td><td>08Х18Н10, 06Х18Н11, 08Х18Н10Т</td></tr>
					<tr><td>ЦЛ-11</td><td>Э-08Х20Н9Г2Б</td><td>E347 (ESAB OK 61.85)</td><td>12Х18Н10Т (AISI 321), 08Х18Н12Б — когда нужна стойкость шва к МКК</td></tr>
					<tr><td>ЦТ-15</td><td>Э-08Х19Н10Г2Б</td><td>ESAB OK 61.85</td><td>То же, что ЦЛ-11</td></tr>
					<tr><td>ЭА-400/10У</td><td>Э-07Х19Н11М3Г2Ф</td><td>семейство E316L (ESAB OK 63.35)</td><td>10Х17Н13М2Т, 08Х18Н10Т, агрессивные среды</td></tr>
					<tr><td>НЖ-13</td><td>Э-09Х19Н10Г2М2Б</td><td>ESAB OK 63.85</td><td>Молибденовые стали (AISI 316, 316Ti)</td></tr>
					<tr><td>ОЗЛ-6, ЗИО-8</td><td>Э-10Х25Н13Г2</td><td>семейство E309</td><td>20Х23Н13, 20Х23Н18 (310S), нержавейка + углеродистая сталь</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Частая ошибка — путать типы ОЗЛ-8 и ОЗЛ-36: у ОЗЛ-8 тип Э-07Х20Н9, а Э-04Х20Н9 с пониженным
			углеродом — это ОЗЛ-36.
		</p>
	</section>

	<section id="tok">
		<h2>Сварочный ток по паспортам</h2>
		<p>
			Режимы приводятся в паспорте на каждую марку электродов. Ниже — значения для постоянного тока
			обратной полярности в нижнем положении.
		</p>
		<div class="ba-table">
			<table>
				<caption>Сварочный ток, А</caption>
				<thead>
					<tr><th>Диаметр, мм</th><th class="num">ОЗЛ-8</th><th class="num">ЦЛ-11</th><th class="num">ОЗЛ-36</th></tr>
				</thead>
				<tbody>
					<tr><td>2,5</td><td class="num">—</td><td class="num">40–65</td><td class="num">—</td></tr>
					<tr><td>3,0</td><td class="num">50–70</td><td class="num">50–90</td><td class="num">70–110</td></tr>
					<tr><td>4,0</td><td class="num">110–130</td><td class="num">110–150</td><td class="num">110–170</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Данные — из паспортов Сычёвского электродного завода (ОЗЛ-8) и Спецэлектрода (ЦЛ-11, ОЗЛ-36); у
			других производителей диапазоны немного отличаются. На практике сварщики держат ток ближе к нижней
			границе диапазона: нержавейка хуже отводит тепло, чем углеродистая сталь, и легко перегревается.
		</p>
	</section>

	<section id="provoloka">
		<h2>Проволока и защитный газ для TIG и MIG</h2>
		<div class="ba-table">
			<table>
				<caption>Сварочная проволока: AWS A5.9 и ГОСТ 2246</caption>
				<thead>
					<tr><th>AWS</th><th>Ближайший аналог по ГОСТ 2246</th><th>Для каких сталей</th></tr>
				</thead>
				<tbody>
					<tr><td>ER308</td><td>Св-04Х19Н9</td><td>AISI 304</td></tr>
					<tr><td>ER308L</td><td>Св-01Х19Н9</td><td>AISI 304, 304L — низкоуглеродистый шов</td></tr>
					<tr><td>ER321</td><td>Св-06Х19Н9Т</td><td>12Х18Н10Т, AISI 321</td></tr>
					<tr><td>ER347</td><td>Св-07Х19Н10Б</td><td>12Х18Н10Т, AISI 321, 347 — шов, стойкий к МКК</td></tr>
					<tr><td>ER316L</td><td>Св-04Х19Н11М3</td><td>AISI 316, 316L, 10Х17Н13М2Т</td></tr>
					<tr><td>ER309L</td><td>Св-07Х25Н13</td><td>Нержавейка с углеродистой сталью, 309S</td></tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>TIG:</strong> чистый аргон, постоянный ток прямой полярности. Для трубопроводов корень шва продувают аргоном: содержание кислорода — меньше 100 ppm, для пищевых и фармацевтических линий — меньше 50 ppm.</li>
			<li><strong>MIG:</strong> Lincoln Electric рекомендует для короткой дуги смеси 98 % аргона + 2 % CO<sub>2</sub> или 98 % аргона + 2 % кислорода, а также трёхкомпонентную смесь гелия, аргона и CO<sub>2</sub>. Чистый CO<sub>2</sub> для нержавейки не подходит.</li>
		</ul>
	</section>

	<section id="pravila">
		<h2>Главные правила: не перегревать</h2>
		<p>
			Нержавейка проводит тепло примерно втрое хуже углеродистой стали (около 15–16 против 45 Вт/(м·К))
			и расширяется при нагреве почти в полтора раза сильнее (около 17 против 12 мкм на метр на градус).
			Поэтому она сильнее коробится, а тепло задерживается в зоне шва.
		</p>
		<ol>
			<li><strong>Короткая дуга и минимально достаточный ток</strong> — меньше тепла, меньше коробления.</li>
			<li><strong>Межпроходная температура — не выше 150 °C</strong> (стандарт AWS D1.6 допускает до 175 °C). Следующий проход начинают, когда металл остыл.</li>
			<li><strong>Не задерживаться в одной точке.</strong> При 450–850 °C по границам зёрен выпадают карбиды хрома, и шов становится склонным к <a href="/blog/mezhkristallitnaya-korroziya/">межкристаллитной коррозии</a>.</li>
			<li><strong>Чистые кромки</strong> — без масла, краски и частиц чёрного металла. Инструмент — отдельный, только для нержавейки.</li>
			<li><strong>Феррит в металле шва — 3–10 %.</strong> Он защищает шов от горячих трещин; правильные электроды дают его автоматически (по паспортам ОЗЛ-8 — 2–8 %, ЦЛ-11 — 2,5–10 %).</li>
		</ol>
	</section>

	<section id="posle">
		<h2>Что делать после сварки</h2>
		<p>
			Вокруг шва остаются цвета побежалости — от соломенного до синего. Под ними слой металла обеднён
			хромом, и шов может заржаветь. Для полной стойкости побежалость снимают травильной пастой или
			электрохимической очисткой, а затем поверхность пассивируют. Щётка снимает цвет, но не
			обеднённый слой.
		</p>
		<p>
			Подробнее — в статье <a href="/blog/kak-pochistit-nerzhaveyku/">как почистить нержавейку и убрать
			побежалость</a>.
		</p>
	</section>
</BlogArticle>
