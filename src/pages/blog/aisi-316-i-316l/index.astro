	},
	{
		q: 'Что лучше: 316Ti или 316L?',
		a: 'Для сварки в обычных условиях они равноценны: одна защищена от межкристаллитной коррозии низким углеродом, другая титаном. 316Ti выбирают для работы при 600–900 °C (Atlas Steels) и для толстых сварных сечений: по данным Outokumpu, 1.4571 сваривается без ограничений по толщине. 316L предпочтительнее у швов в агрессивных средах: по ГОСТ 5632-2014 03Х17Н14М3 стойче к межкристаллитной и ножевой коррозии, чем 10Х17Н13М2Т.',
	},
	{
		q: 'Магнитится ли AISI 316?',
		a: 'В закалённом состоянии нет: EN 10088-1 относит 1.4401, 1.4404 и 1.4571 к ненамагничивающимся сталям. Никеля в 316 больше, чем в 304, аустенит устойчивее, и после холодной гибки или вытяжки она притягивает магнит слабее, чем 304. Слабая реакция возможна у сварных швов и сильно нагартованных участков. Марку магнитом не определяют — только по сертификату или спектральному анализу.',
	},
	{
		q: 'Подходит ли AISI 316 для морской воды?',
		a: 'Для морской атмосферы и зоны брызг — да, для тёплой морской воды — нет: по данным Atlas Steels, 316 к ней не стойка, а на шероховатой поверхности и в щелях у моря появляется коричневый налёт. Для деталей, постоянно погружённых в морскую воду, особенно со щелями, нужны стали с PREN больше 40 — супердуплекс 2507 или аустенит с 6 % молибдена. У 316 и 316L PREN около 24.',
	},
];

const sources = [
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — таблица 1, п. 6.3, приложение А', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, таблица 1', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая, таблица механических свойств', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'ГОСТ 5949-2018 — металлопродукция из нержавеющих сталей, таблица 3', href: 'https://meganorm.ru/Data2/1/4293734/4293734404.htm' },
	{ label: 'ГОСТ 9941-81 и ГОСТ 9940-81 — трубы бесшовные из коррозионно-стойкой стали, таблица 3 (механика и плотность)', href: 'https://meganorm.ru/Data2/1/4294850/4294850480.htm' },
	{ label: 'ГОСТ 11068-81 — трубы электросварные из коррозионно-стойкой стали, п. 1.1 и 2.1', href: 'https://files.stroyinf.ru/Data2/1/4294852/4294852683.htm' },
	{ label: 'ASTM A240/A240M — лист, полоса и рулон из хромоникелевых нержавеющих сталей', href: 'https://store.astm.org/a0240_a0240m-23.html' },
	{ label: 'Atlas Steels — Stainless Steel Grade 316 (UNS S31600): состав, механика, коррозия, применение (публикация AZoM)', href: 'https://www.azom.com/article.aspx?ArticleID=863' },
	{ label: 'Atlas Steels — Stainless Steel Grade 304 (UNS S30400): хлориды в питьевой воде, растрескивание (публикация AZoM)', href: 'https://www.azom.com/article.aspx?ArticleID=965' },
	{ label: 'Outokumpu — Supra range datasheet (1561EN, 2022): 1.4401, 1.4404, 1.4432, 1.4435, 1.4571 — PRE, EN 10088-1 и 10088-2', href: 'https://www.outokumpu.com/-/media/files/products/supra/outokumpu-supra-range-datasheet.pdf' },
	{ label: 'SteelNumber — X2CrNiMo17-12-2 (1.4404) по EN 10088-2', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=104' },
	{ label: 'SteelNumber — X5CrNiMo17-12-2 (1.4401) по EN 10088-2', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=106' },
	{ label: 'SteelNumber — X6CrNiMoTi17-12-2 (1.4571) по EN 10088-2', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=107' },
	{ label: 'SteelNumber — X2CrNiMo18-14-3 (1.4435) по EN 10088-2', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=109' },
	{ label: 'Fine Tubes — Alloy 316Ti (UNS S31635, 1.4571): состав', href: 'https://www.finetubes.co.uk/products/materials/stainless-steel-tubes/alloy-316ti-uns-s31635-wnr-1-4571' },
	{ label: 'Rolled Alloys — 317/317L datasheet: состав по ASTM A240 и PREN', href: 'https://www.rolledalloys.com/wp-content/uploads/317-317L_Datasheet_rolled-alloys_USA.pdf' },
	{ label: 'BSSA — SSAS Information Sheet 2.31: крепёж по EN ISO 3506, группы A2 и A4', href: 'https://bssa.org.uk/wp-content/uploads/2022/08/Microsoft-Word-SSAS2.31-Fastener-Grades-A1A2_A3_-A4_A5_-to-BS-EN-ISO-3506-1.pdf' },
];

const related = [
	{ label: 'Лист AISI 316L (03Х17Н14М3)', href: '/list-nerzhaveyushchiy/aisi-316l/' },
	{ label: 'Труба AISI 316L (03Х17Н14М3)', href: '/truba-nerzhaveyushchaya/aisi-316l/' },
	{ label: 'Круг AISI 316L (03Х17Н14М3)', href: '/krug-nerzhaveyushchiy/aisi-316l/' },
	{ label: 'Лист AISI 316Ti (10Х17Н13М2Т)', href: '/list-nerzhaveyushchiy/aisi-316ti/' },
