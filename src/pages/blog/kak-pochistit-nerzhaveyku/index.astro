---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'uhod', anchor: 'Обычный уход', summary: 'Вода, мягкое средство, вдоль рисок' },
	{ id: 'zagryazneniya', anchor: 'Сложные загрязнения', summary: 'Налёт, отпечатки, ржавые пятна' },
	{ id: 'nelzya', anchor: 'Чего нельзя', summary: 'Хлорка, соляная кислота, стальная вата' },
	{ id: 'pobezhalost', anchor: 'Цвета побежалости', summary: 'Цвет и температура нагрева' },
	{ id: 'udalenie', anchor: 'Как убрать побежалость', summary: 'Травление, электрохимия, пассивация' },
];

const faq = [
	{
		q: 'Можно ли чистить нержавейку хлоркой или «Белизной»?',
		a: 'Нет. Хлорсодержащие средства разрушают пассивную плёнку, и на нержавейке появляется точечная (питтинговая) коррозия. Если хлорка случайно попала на поверхность, её сразу смывают большим количеством воды.',
	},
	{
		q: 'Чем убрать отпечатки пальцев с нержавейки?',
		a: 'Свежие отпечатки снимают тёплой водой с мягким моющим средством или стеклоочистителем без хлора, затем поверхность вытирают насухо мягкой тканью. Шлифованную поверхность протирают вдоль рисок.',
	},
	{
		q: 'Можно ли тереть нержавейку металлической губкой?',
		a: 'Губкой из обычной стали — нельзя: она оставляет частицы железа, которые ржавеют. Допустимы губки и щётки из нержавеющей стали или нейлона. Абразивные пасты и губки царапают полированную поверхность, поэтому их используют осторожно и только вдоль рисок.',
	},
	{
		q: 'Чем убрать побежалость в домашних условиях?',
		a: 'Цвет можно снять шлифовкой или щёткой из нержавеющей стали, но под ним остаётся слой, обеднённый хромом, и стойкость к коррозии не восстанавливается полностью. Для этого нужно травление пастой или электрохимическая очистка с последующей пассивацией. Травильная паста содержит плавиковую кислоту и требует серьёзной защиты.',
	},
	{
		q: 'Нужна ли пассивация после шлифовки?',
		a: 'Если поверхность могла загрязниться частицами железа — да. Пассивация по ASTM A967 и A380 удаляет свободное железо и помогает восстановить защитную оксидную плёнку. На чистой поверхности плёнка восстанавливается и сама на воздухе, но пассивация делает этот процесс надёжнее.',
	},
	{
		q: 'Опасна ли травильная паста?',
		a: 'Да. Типовая паста содержит азотную (12,5–25 %) и плавиковую (2,5–5 %) кислоты. Плавиковая кислота смертельно опасна при попадании на кожу. Работать с пастой можно только в защитной одежде, перчатках и маске, по инструкции производителя, с последующей нейтрализацией и промывкой.',
	},
];

const sources = [
	{ label: 'BSSA — Care and Maintenance of Stainless Steel', href: 'https://bssa.org.uk/wp-content/uploads/2020/11/SSAS7.20-Care-and-Maintenance-of-Stainless-Steel.pdf' },
	{ label: 'BSSA — цвета побежалости нержавеющей стали при нагреве на воздухе', href: 'https://bssa.org.uk/bssa_articles/heat-tint-temper-colours-on-stainless-steel-surface-heated-in-air/' },
	{ label: 'Outokumpu — обработка нержавеющей стали после изготовления', href: 'https://www.outokumpu.com/en/expertise/stainless-basics/post-fabrication-treatment' },
	{ label: 'ASTM A380 — очистка, удаление окалины и пассивация нержавеющей стали', href: 'https://astropak.com/astm-a380-standards-for-cleaning-and-passivation-of-stainless-steel/' },
	{ label: 'ASTM A967 — химическая пассивация нержавеющей стали', href: 'https://astropak.com/astm-a967/' },
	{ label: 'Nickel Institute — Cleaning and descaling stainless steel (9001)', href: 'https://nickelinstitute.org/en/resources/technical-guides/cleaning-and-descaling-stainless-steel-9001/' },
];

const related = [
	{ label: 'Как варить нержавейку', href: '/blog/kak-varit-nerzhaveyku/' },
	{ label: 'Почему ржавеет нержавейка', href: '/blog/pochemu-rzhaveet-nerzhaveyka/' },
	{ label: 'Питтинговая коррозия', href: '/blog/pittingovaya-korroziya/' },
	{ label: 'Полировка нержавеющей стали', href: '/uslugi/polirovka/' },
	{ label: 'Поверхности листа 2B, BA, 4N, 8K', href: '/blog/poverhnosti-nerzhaveyushchego-lista/' },
];
---

<BlogArticle
	slug="kak-pochistit-nerzhaveyku"
	title="Как почистить нержавейку и убрать побежалость"
	description="Как почистить нержавейку: чем мыть, как снять налёт и отпечатки, почему нельзя хлорку и стальную вату. Таблица цветов побежалости и как убрать их после сварки."
	h1="Как почистить нержавейку и убрать цвета побежалости после сварки"
	eyebrow="Инструкция"
	datePublished="2026-09-19"
	dateModified="2026-09-19"
	readingMin={6}
	answer="<strong>Для обычной чистки нержавейки хватает тёплой воды с мягким моющим средством; налёт снимают уксусом, тереть нужно вдоль рисок шлифовки.</strong> Нельзя использовать хлорку, соляную кислоту и стальную вату. Цвета побежалости после сварки снижают коррозионную стойкость: полностью её восстанавливают травлением пастой или электрохимической очисткой с последующей пассивацией."
	keyFacts={[
		'Ежедневно — вода, мягкое средство, протереть насухо',
		'Известковый налёт — уксус; ржавые пятна от железа — средства на фосфорной или щавелевой кислоте',
		'Нельзя — хлорка, соляная кислота, стальная вата и щётки из обычной стали',
		'Побежалость на AISI 304: соломенный цвет — около 340 °C, синий — около 540 °C',
		'Стандарты очистки и пассивации — ASTM A380 и ASTM A967',
	]}
	coverAlt="Как почистить нержавейку и убрать цвета побежалости после сварки"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Уход за нержавеющей сталью', 'Цвета побежалости', 'Пассивация']}
>
	<section id="uhod">
		<h2>Обычный уход</h2>
		<ol>
			<li>Промойте поверхность тёплой водой с мягким моющим средством — например, для посуды.</li>
			<li>Шлифованную поверхность протирайте вдоль рисок, а не поперёк и не кругами.</li>
			<li>Промойте чистой водой и вытрите насухо мягкой тканью — так не останется разводов.</li>
		</ol>
		<p>
			Отпечатки пальцев лучше снимать сразу, пока они свежие. Для зеркальной и шлифованной поверхности
			подходят стеклоочистители без хлора.
		</p>
	</section>

	<section id="zagryazneniya">
		<h2>Сложные загрязнения</h2>
		<div class="ba-table">
			<table>
				<caption>Чем снимать загрязнения</caption>
				<thead>
					<tr><th>Загрязнение</th><th>Чем снимать</th></tr>
				</thead>
				<tbody>
					<tr><td>Известковый налёт, разводы от воды</td><td>Уксус (для сильного налёта — горячая 25 % уксусная или тёплая 10 % фосфорная кислота), затем промыть водой</td></tr>
					<tr><td>Засохший строительный раствор</td><td>Уксусная или фосфорная кислота. Средства для очистки кирпича с соляной кислотой — нельзя</td></tr>
					<tr><td>Жир, масло</td><td>Моющее средство или растворитель без хлора</td></tr>
					<tr><td>Ржавые пятна от частиц железа</td><td>Средства на фосфорной или щавелевой кислоте, затем промывка; при сильном загрязнении — пассивация</td></tr>
				</tbody>
			</table>
		</div>
	</section>

	<section id="nelzya">
		<h2>Чего нельзя делать</h2>
		<ul>
			<li><strong>Хлорка и хлорсодержащие средства</strong> — разрушают пассивную плёнку и вызывают <a href="/blog/pittingovaya-korroziya/">питтинговую коррозию</a>.</li>
			<li><strong>Соляная кислота</strong>, в том числе в средствах для очистки кирпича и плитки.</li>
			<li><strong>Стальная вата и щётки из обычной стали</strong> — оставляют частицы железа, которые ржавеют. Допустимы только щётки из нержавейки или нейлона.</li>
			<li><strong>Грубые абразивы на полированной поверхности</strong> — оставляют царапины.</li>
		</ul>
	</section>

	<section id="pobezhalost">
		<h2>Цвета побежалости: что это и при какой температуре</h2>
		<p>
			Цвета побежалости — тонкая оксидная плёнка, которая появляется при нагреве нержавейки на воздухе:
			у сварного шва, после резки или горячей эксплуатации. Цвет зависит от температуры.
		</p>
		<div class="ba-table">
			<table>
				<caption>Цвета побежалости AISI 304 при нагреве на воздухе (BSSA)</caption>
				<thead>
					<tr><th>Цвет</th><th class="num">Температура, °C</th></tr>
				</thead>
				<tbody>
					<tr><td>Бледно-жёлтый</td><td class="num">290</td></tr>
					<tr><td>Соломенный</td><td class="num">340</td></tr>
					<tr><td>Тёмно-жёлтый</td><td class="num">370</td></tr>
					<tr><td>Коричневый</td><td class="num">390</td></tr>
					<tr><td>Пурпурно-коричневый</td><td class="num">420</td></tr>
					<tr><td>Тёмно-пурпурный</td><td class="num">450</td></tr>
					<tr><td>Синий</td><td class="num">540</td></tr>
					<tr><td>Тёмно-синий</td><td class="num">600</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Таблица ориентировочная: BSSA оговаривает, что цвет зависит также от времени нагрева, атмосферы,
			состава стали и шероховатости поверхности. В других источниках температуры для тех же цветов ниже.
		</p>
		<p>
			<strong>Почему побежалость опасна.</strong> Хром уходит в оксидную плёнку, и под ней остаётся слой,
			обеднённый хромом. Такой участок хуже сопротивляется коррозии: сварной шов может заржаветь, хотя
			основной металл остаётся чистым.
		</p>
	</section>

	<section id="udalenie">
		<h2>Как убрать побежалость</h2>
		<div class="ba-table">
			<table>
				<caption>Способы удаления побежалости</caption>
				<thead>
					<tr><th>Способ</th><th>Как работает</th><th>Результат</th></tr>
				</thead>
				<tbody>
					<tr><td>Механически: щётка из нержавейки, шлифовка</td><td>Снимает окрашенную плёнку</td><td>Цвет уходит, но обеднённый хромом слой может остаться</td></tr>
					<tr><td>Травление пастой или раствором</td><td>Смесь азотной и плавиковой кислот растворяет окалину и обеднённый слой</td><td>Наиболее стойкая поверхность</td></tr>
					<tr><td>Электрохимическая очистка</td><td>Токопроводящая щётка, мягкий электролит и ток</td><td>Очищает и одновременно пассивирует, без агрессивных кислот</td></tr>
					<tr><td>Пассивация</td><td>Азотная или лимонная кислота удаляет свободное железо</td><td>Восстанавливает защитную плёнку; не заменяет удаление окалины</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Требования к очистке и пассивации нержавеющей стали описаны в стандартах ASTM A380 и ASTM A967. Для
			травления применяют только смеси без хлоридов: соляная кислота для нержавейки недопустима.
		</p>
		<p class="ba-note">
			<strong>Безопасность.</strong> Травильные пасты содержат плавиковую кислоту, опасную при попадании
			на кожу. Работайте в защитной одежде, перчатках и маске, строго по инструкции производителя, с
			нейтрализацией и промывкой после обработки.
		</p>
	</section>
</BlogArticle>
