---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'formula', anchor: 'Формула и плотность', summary: 'M = S × ρ, плотность по маркам и источники значений' },
	{ id: 'tablica', anchor: 'Вес 1 м² по толщинам', summary: 'Все 40 толщин каталога, 0,4–90 мм, для 304, 316L, 430, 201, 2205' },
	{ id: 'formaty', anchor: 'Вес листа по форматам', summary: '1000×2000, 1250×2500, 1500×3000, 1500×6000; листов в тонне' },
	{ id: 'dopuski', anchor: 'Теоретический и фактический вес', summary: 'Допуски ГОСТ 19904-90 и 19903-2015 в процентах массы' },
	{ id: 'oshibki', anchor: 'Ошибки при расчёте', summary: '7,85 вместо 7,9, не та марка, разные плотности в калькуляторах' },
	{ id: 'rulon', anchor: 'Рулон и другой прокат', summary: 'Погонный метр, метры в тонне, труба, круг, рифлёный лист, ПВЛ' },
	{ id: 'assortiment', anchor: 'Что есть в каталоге', summary: '745 позиций гладкого листа, толщины, форматы, марки' },
	{ id: 'zayavka', anchor: 'Что указать в заявке', summary: 'Марка, толщина, допуск, формат, способ определения массы' },
];

const faq = [
	{
		q: 'Сколько весит 1 м² нержавеющего листа?',
		a: 'Лист из AISI 304 (плотность 7,9 г/см³) весит 7,9 кг на каждый миллиметр толщины: 1 мм — 7,9 кг/м², 2 мм — 15,8, 3 мм — 23,7, 4 мм — 31,6, 5 мм — 39,5, 10 мм — 79,0. Для AISI 316L берут 8,0 (на 1,3 % больше), для AISI 430 — 7,7 (на 2,5 % меньше). Формула: масса 1 м² = толщина в миллиметрах × плотность в г/см³.',
	},
	{
		q: 'Сколько весит лист нержавейки 2 мм и 3 мм стандартных форматов?',
		a: 'Лист AISI 304 толщиной 2 мм: 1000×2000 мм — 31,6 кг, 1250×2500 мм — 49,4 кг, 1500×3000 мм — 71,1 кг. Толщиной 3 мм: 47,4, 74,1 и 106,7 кг. Расчёт: толщина × 7,9 × площадь листа в квадратных метрах (2,0, 3,125 и 4,5 м²). Для 316L прибавьте 1,3 %, для 430 отнимите 2,5 %.',
	},
	{
		q: 'Какую плотность нержавейки брать для расчёта веса?',
		a: 'AISI 304 (08Х18Н10) и AISI 321 (12Х18Н10Т) — 7,9 г/см³, AISI 316L (03Х17Н14М3) — 8,0, AISI 201 и дуплекс 2205 — 7,8, AISI 430 (12Х17), 410S (08Х13) и другие ферритные — 7,7. Для российских марок эти значения заданы в таблице 3 ГОСТ 9940-81 и в примечании 2 к таблице 1 ГОСТ 11068-81, для 201 и 2205 — в каталогах Outokumpu. Некоторые справочники округляют плотность 304 до 8,0 (8000 кг/м³), это на 1,3 % больше.',
	},
	{
		q: 'Чем вес листа нержавейки отличается от веса листа из чёрной стали?',
		a: 'Таблицы масс чёрного проката считают при плотности 7,85 г/см³ (ГОСТ 103-2006). Относительно углеродистой стали той же толщины AISI 304 и 321 тяжелее на 0,6 %, AISI 316L — на 1,9 %, а AISI 430 легче на 1,9 %, AISI 201 и дуплекс 2205 легче на 0,6 %. Эта разница меньше допуска по толщине листа, поэтому для заказа важнее класс точности и способ определения массы.',
	},
	{
		q: 'Почему фактический вес листа не совпадает с расчётным?',
		a: 'Расчёт идёт по номинальной толщине, а реальная толщина лежит в поле допуска. У холоднокатаного листа 1 мм шириной св. 1000 до 1500 мм по ГОСТ 19904-90 допуск ±0,06–0,11 мм, то есть ±6–11 % массы. У горячекатаного листа 4–10 мм той же ширины по ГОСТ 19903-2015 допуск несимметричный: минус от −0,5 мм при 4–5 мм до −0,8 мм при 8–10 мм, а при 4 мм это −12,5 % массы. Лист можно заказать с допуском только в плюс или только в минус.',
	},
	{
		q: 'Сколько листов нержавейки в тонне?',
		a: 'Тысячу килограммов делят на массу листа. Для AISI 304 формата 1250×2500 мм толщиной 2 мм (49,4 кг) — около 20,3 листа, 3 мм (74,1 кг) — 13,5, 5 мм (123,4 кг) — 8,1, 10 мм (246,9 кг) — 4,1. Площадь листа в тонне — 1000 ÷ (толщина × 7,9): для 2 мм это 63,3 м². Из-за допуска по толщине фактическое число листов в тонне может быть другим.',
	},
	{
		q: 'Сколько метров в тонне рулона нержавейки?',
		a: 'Метров в тонне = 1000 ÷ (ширина в метрах × толщина в миллиметрах × 7,9). Для рулона AISI 304 шириной 1250 мм и толщиной 0,8 мм масса погонного метра 7,9 кг, в тонне 126,6 м; для 1000×0,5 мм — 3,95 кг на метр и 253 м. ГОСТ 19904-90 не нормирует длину рулона, а массу рулона задаёт от 1,5 до 20 т, поэтому рулон считают по массе.',
	},
	{
		q: 'Как посчитать вес рифлёного листа, ПВЛ или перфорированного листа?',
		a: 'Формула «толщина × плотность» годится для гладкого листа. У рифлёного листа и ПВЛ масса 1 м² зависит от рисунка и берётся из таблиц стандартов: её считают калькуляторы рифлёного листа и ПВЛ. У перфорированного листа массу сплошного листа умножают на (1 − доля отверстий): при доле 35,4 % (рисунок Rv 5-8) лист 1,5 мм из AISI 304 весит 7,65 кг/м² вместо 11,85.',
	},
];

const sources = [
	{ label: 'ГОСТ 19904-90 «Прокат листовой холоднокатаный. Сортамент» — область применения (листы 0,35–5,00 мм), табл. 1 (ряды толщин, ширин, длин), п. 5, табл. 2 и примечание (допуски по толщине), п. 16 (масса рулона), п. 17 (где измеряют толщину)', href: 'https://files.stroyinf.ru/Data1/4/4045/index.htm' },
	{ label: 'ГОСТ 19903-2015 «Прокат листовой горячекатаный. Сортамент» — разд. 1 (листы 0,4–160 мм), табл. 1 (ряды размеров), п. 2.3 и табл. 3–4 (допуски по толщине), п. 2.17', href: 'https://meganorm.ru/Data2/1/4293755/4293755668.htm' },
	{ label: 'ГОСТ 7350-77 «Сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная» — п. 2.1 (горячекатаная 4–50 мм, холоднокатаная 4–5 мм), п. 2.2', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, жаростойкий и жаропрочный: п. 2.1 (холоднокатаный 0,5–3,9 мм, горячекатаный 1,5–3,9 мм)', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7566-2018 «Металлопродукция. Правила приемки, маркировка, упаковка, транспортирование и хранение» — приложение А, формулы А.1 и А.2 (масса участка рулона с дефектами поверхности: 10⁻⁶ ρ B S L, размеры в мм, ρ в г/см³); п. 6.5.1.2 (масса упаковки)', href: 'https://meganorm.ru/Data2/1/4293735/4293735060.pdf' },
	{ label: 'ГОСТ 9940-81 «Трубы бесшовные горячедеформированные из коррозионно-стойкой стали» — табл. 3: плотность по маркам (08Х18Н10 и 12Х18Н10Т — 7,90; 12Х17 и 08Х13 — 7,70; 10Х17Н13М2Т — 8,00; 08Х22Н6Т — 7,60)', href: 'https://files.stroyinf.ru/Data2/1/4294848/4294848734.htm' },
	{ label: 'ГОСТ 11068-81 «Трубы электросварные из коррозионно-стойкой стали» — примечание 2 к табл. 1: плотность по маркам (08Х18Н10 и 12Х18Н10Т — 7,9; 03Х17Н14М3 — 8,0; 08Х21Н6М2Т — 7,85)', href: 'https://files.stroyinf.ru/Data2/1/4294852/4294852683.htm' },
	{ label: 'ГОСТ 103-2006 «Прокат сортовой стальной горячекатаный полосовой. Сортамент» — примечание к таблице массы: плотность стали принята равной 7,85 г/см³', href: 'https://files.stroyinf.ru/Data2/1/4293831/4293831161.htm' },
	{ label: 'Outokumpu Core range datasheet — табл. 7, физические свойства по EN 10088-1: 304/4301, 321/4541 — 7,9; 201/4372 — 7,8 г/см³', href: 'https://www.outokumpu.com/-/media/files/products/core/outokumpu-core-range-datasheet.pdf' },
	{ label: 'Outokumpu Moda range datasheet — табл. 6: 430/4016, 410L/4003, 409/4512, 439/4510 — 7,7 г/см³', href: 'https://www.outokumpu.com/-/media/files/products/moda/outokumpu-moda-range-datasheet.pdf' },
	{ label: 'Outokumpu Forta range datasheet — физические свойства: Forta DX 2205 — 7,8 г/см³', href: 'https://www.notzgroup.com/media/wysiwyg/PDF/NME/14_Outokumpu_Forta_range_Datasheet_May_2015.pdf' },
	{ label: 'Atlas Steels (AZoM) — Stainless Steel Grade 304 (UNS S30400), табл. 3: плотность 304/L/H — 8000 кг/м³', href: 'https://www.azom.com/article.aspx?ArticleID=965' },
];

const related = [
	{ label: 'Лист нержавеющий 1, 2 и 3 мм: размеры, вес, марки', href: '/blog/list-nerzhaveyushchiy-1-2-3-mm/' },
	{ label: 'Лист нержавеющий 4–10 мм: размеры, вес, ГОСТ, резка', href: '/blog/list-nerzhaveyushchiy-4-5-6-8-10-mm/' },
	{ label: 'Плотность нержавеющей стали по маркам', href: '/blog/plotnost-nerzhaveyushchey-stali/' },
	{ label: 'Рулон нержавеющий: ширины, толщины, вес и резка', href: '/blog/rulon-nerzhaveyushchiy/' },
	{ label: 'Калькулятор веса металлопроката', href: '/kalkulyator-vesa/' },
	{ label: 'Калькулятор веса рулона', href: '/kalkulyator-rulona/' },
	{ label: 'Калькулятор рифлёного листа', href: '/kalkulyator-riflenogo-lista/' },
	{ label: 'Калькулятор ПВЛ', href: '/kalkulyator-pvl/' },
	{ label: 'Лист нержавеющий — каталог', href: '/list-nerzhaveyushchiy/' },
	{ label: 'ГОСТ 19904-90: холоднокатаный лист, сортамент', href: '/gost/19904-90/' },
	{ label: 'Перфорированный лист из нержавейки: виды, шаг, заказ', href: '/blog/perforirovannyy-list-nerzhaveyushchiy/' },
	{ label: 'ГОСТ на нержавеющую сталь: таблица по видам проката', href: '/blog/gost-na-nerzhaveyushchuyu-stal/' },
];
---

<BlogArticle
	slug="ves-nerzhaveyushchego-lista-tablica"
	title="Вес листа нержавейки: таблица по толщине и формату"
	description="Вес листа нержавейки: 1 м² из AISI 304 весит 7,9 кг на каждый мм толщины. Таблица кг/м² для 0,4–90 мм, масса листов 1250×2500, 1000×2000, 1500×3000 и допуски."
	h1="Вес листа нержавейки: таблица по толщинам и форматам"
	eyebrow="Справочник"
	datePublished="2026-10-06"
	dateModified="2026-10-06"
	readingMin={16}
	answer="<strong>Вес 1 м² нержавеющего листа из AISI 304 равен 7,9 кг на каждый миллиметр толщины: 1 мм — 7,9 кг/м², 2 мм — 15,8, 3 мм — 23,7, 10 мм — 79,0.</strong> Лист 2 мм весит 31,6 кг при формате 1000×2000, 49,4 кг при 1250×2500 и 71,1 кг при 1500×3000 мм. Для AISI 316L плотность 8,0 г/см³ (на 1,3 % больше), для AISI 430 и 410S — 7,7 (на 2,5 % меньше). Это теоретическая масса: у холоднокатаного листа 1–2 мм шириной св. 1000 до 1500 мм реальная отличается на ±4,5–11 % из-за допуска по толщине (ГОСТ 19904-90)."
	keyFacts={[
		'Масса 1 м² = толщина (мм) × плотность (г/см³); масса листа = 10<sup>−6</sup> × ρ × B × S × L, кг, размеры в мм (такая запись массы участка рулона — в приложении А ГОСТ 7566-2018)',
		'Плотность, г/см³: 304 и 321 — 7,9; 316L — 8,0; 201 и дуплекс 2205 — 7,8; 430, 410S и другие ферритные — 7,7 (ГОСТ 9940-81, ГОСТ 11068-81, каталоги Outokumpu); углеродистая сталь — 7,85',
		'Лист 1250×2500 мм из AISI 304: 24,7 кг (1 мм), 49,4 (2 мм), 74,1 (3 мм), 123,4 (5 мм), 246,9 кг (10 мм); в тонне 2 мм — около 20,3 листа',
		'Допуски при ширине св. 1000 до 1500 мм: ГОСТ 19904-90 — холоднокатаный симметричный (лист 1 мм — ±6–11 % массы); ГОСТ 19903-2015 — горячекатаный с минусом −0,5 мм при 4–5 мм и −0,8 мм при 8–10 мм (до −12,5 % массы)',
		'Относительно углеродистой стали (7,85) AISI 304 тяжелее на 0,6 %, 316L — на 1,9 %, 430 легче на 1,9 %',
		'В каталоге 745 позиций гладкого листа, 40 значений толщины от 0,4 до 90 мм (по прайсу на 25 июля 2026 года)',
	]}
	coverAlt="Вес листа нержавейки: таблица кг/м² по толщинам и масса листов 1000×2000, 1250×2500, 1500×3000"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Вес листа нержавейки', 'Вес нержавеющего листа', 'Вес 1 м² нержавейки', 'Плотность нержавеющей стали', 'Теоретическая масса листа', 'ГОСТ 19904-90', 'ГОСТ 19903-2015', 'AISI 304', 'AISI 316L', 'AISI 430']}
	cta={{ title: 'Нужен лист нержавейки с расчётом массы?', text: 'Поставляем нержавеющий лист 0,4–90 мм из каталога: AISI 304, 321, 316L, 430, 201 и другие марки. Пришлите марку, толщину, формат, поверхность и объём в листах или тоннах — посчитаем массу партии и подготовим КП с сертификатом завода-изготовителя.' }}
>
	<section id="formula">
		<h2>Формула веса листа и плотность нержавеющей стали по маркам</h2>
		<p>
			Масса 1 м² листа в килограммах равна толщине в миллиметрах, умноженной на плотность в г/см³:
			<strong>M₁ = S × ρ</strong>. Квадратный метр листа толщиной 1 мм — это 1 дм³ металла, а 1 дм³ нержавейки
			AISI 304 (08Х18Н10) весит 7,9 кг. Масса листа — это масса 1 м², умноженная на ширину и длину в метрах.
		</p>
		<p>
			Если размеры листа даны в миллиметрах, формула такая: <strong>M = 10<sup>−6</sup> × ρ × B × S × L</strong>, кг,
			где B — ширина, S — толщина, L — длина (мм), ρ — плотность (г/см³). Ту же запись использует ГОСТ 7566-2018
			в приложении А (формулы А.1 и А.2) для массы участка рулона с дефектами поверхности. Пример: лист 2×1250×2500 мм из AISI 304 весит
			10<sup>−6</sup> × 7,9 × 1250 × 2 × 2500 = 49,4 кг.
		</p>
		<h3>Плотность по маркам и откуда она взята</h3>
		<p>
			На сайте для расчётов принято одно значение на группу марок. Для российских марок оно совпадает с таблицей 3
			ГОСТ 9940-81 и примечанием 2 к таблице 1 ГОСТ 11068-81: в них плотность задана по маркам стали. Для марок,
			которых в этих стандартах нет (AISI 201, дуплекс 2205), значения взяты из каталогов Outokumpu. Почему плотность
			зависит от марки, объясняет статья про <a href="/blog/plotnost-nerzhaveyushchey-stali/">плотность нержавеющей стали</a>.
		</p>
		<div class="ba-table">
			<table>
			<caption>Плотность нержавеющих сталей, принятая в расчётах, и источник</caption>
			<thead>
			<tr><th>Марка</th><th class="num">ρ, г/см³</th><th class="num">Масса 1 м² на 1 мм толщины, кг</th><th>Источник</th></tr>
			</thead>
			<tbody>
			<tr><td>AISI 304 (08Х18Н10), 304L</td><td class="num">7,9</td><td class="num">7,9</td><td>ГОСТ 9940-81, табл. 3 (08Х18Н10 — 7,90); ГОСТ 11068-81, прим. 2 к табл. 1 (7,9); Outokumpu Core 304/4301 — 7,9</td></tr>
			<tr><td>AISI 321 (12Х18Н10Т)</td><td class="num">7,9</td><td class="num">7,9</td><td>ГОСТ 9940-81, табл. 3 (12Х18Н10Т — 7,90); Outokumpu Core 321/4541 — 7,9</td></tr>
			<tr><td>AISI 316L (03Х17Н14М3), 316Ti (10Х17Н13М2Т)</td><td class="num">8,0</td><td class="num">8,0</td><td>ГОСТ 11068-81, прим. 2 к табл. 1 (03Х17Н14М3 — 8,0); ГОСТ 9940-81, табл. 3 (10Х17Н13М2Т — 8,00)</td></tr>
			<tr><td>Дуплекс 2205 (03Х22Н5АМ3)</td><td class="num">7,8</td><td class="num">7,8</td><td>Outokumpu Forta DX 2205 — 7,8</td></tr>
			<tr><td>AISI 201</td><td class="num">7,8</td><td class="num">7,8</td><td>Outokumpu Core 201/4372 — 7,8</td></tr>
			<tr><td>AISI 430 (12Х17)</td><td class="num">7,7</td><td class="num">7,7</td><td>ГОСТ 9940-81, табл. 3 (12Х17 — 7,70); Outokumpu Moda 430/4016 — 7,7</td></tr>
			<tr><td>AISI 410S (08Х13), 409L, 439</td><td class="num">7,7</td><td class="num">7,7</td><td>ГОСТ 9940-81, табл. 3 (08Х13 — 7,70); Outokumpu Moda 410L/4003, 409/4512, 439/4510 — 7,7</td></tr>
			<tr><td>Углеродистая сталь (для сравнения)</td><td class="num">7,85</td><td class="num">7,85</td><td>ГОСТ 103-2006, примечание к таблице массы: 7,85</td></tr>
			</tbody>
			</table>
			</div>
		<p class="ba-note">
			Справочники расходятся в пределах 1,3 %: Atlas Steels в описании марки 304 указывает плотность 8000 кг/м³, а ГОСТ 9940-81
			и EN 10088-1 (в каталогах Outokumpu) дают 7,9. У дуплексных сталей значение зависит от марки: в ГОСТ 9940-81 и 11068-81
			для 08Х22Н6Т указано 7,6, а для 08Х21Н6М2Т — 7,85. Для марок вне таблицы — 310S, 904L, супердуплекс 2507 — плотность
			берут из сертификата или справочника производителя.
		</p>
	</section>

	<section id="tablica">
		<h2>Вес 1 м² нержавеющего листа: таблица по толщинам из каталога</h2>
		<p>
			В прайсе 40 значений толщины гладкого листа — от 0,4 до 90 мм (745 позиций). Таблица охватывает все. До 3,9 мм
			лист относится к тонколистовому прокату: <a href="/gost/5582-75/">ГОСТ 5582-75</a> охватывает холоднокатаный
			0,5–3,9 мм и горячекатаный 1,5–3,9 мм. От 4 мм это толстолистовая сталь по
			<a href="/gost/7350-77/">ГОСТ 7350-77</a>: горячекатаная 4–50 мм, холоднокатаная 4–5 мм. Размеры и допуски
			задают сортаментные стандарты: <a href="/gost/19904-90/">ГОСТ 19904-90</a> для холоднокатаного листа
