			<tr><td>8 мм (св. 7,50 до 10,00)</td><td class="num">+0,20 / −0,80</td><td class="num">+2,5 / −10,0</td><td class="num">+0,30 / −0,80</td><td class="num">+3,8 / −10,0</td></tr>
