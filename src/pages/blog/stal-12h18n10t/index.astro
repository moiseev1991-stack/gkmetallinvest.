---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'sostav', anchor: 'Химический состав', summary: 'ГОСТ 5632-2014, ASTM A240, EN 10088' },
	{ id: 'mehanika', anchor: 'Механические свойства', summary: 'Лист, круг и труба по ГОСТ и ASTM' },
	{ id: 'plotnost', anchor: 'Плотность и физика', summary: '7,9 г/см³, модуль, теплопроводность' },
	{ id: 'gost', anchor: 'ГОСТы на прокат', summary: 'Лист, круг, труба, лента, проволока' },
	{ id: 'analogi', anchor: 'Аналоги AISI 321 и EN', summary: '1.4541, X6CrNiTi18-10, SUS321' },
	{ id: 'otlichiya', anchor: 'Отличия от 08Х18Н10 и 304', summary: 'Титан, углерод, МКК' },
	{ id: 'primenenie', anchor: 'Сварка и применение', summary: 'Магнитность, температуры, среды' },
];

const faq = [
	{
		q: '12Х18Н10Т и AISI 321 — одно и то же?',
		a: 'Нет, это аналоги, а не одна марка. У 12Х18Н10Т по ГОСТ 5632-2014 допускается до 0,12 % углерода и 9–11 % никеля, у AISI 321 по ASTM A240 — до 0,08 % углерода и 9–12 % никеля. Обе стали стабилизированы титаном и применяются в одних и тех же сварных конструкциях. Если проект требует именно AISI 321 или 1.4541, стандарт указывают в заказе, а состав подтверждают сертификатом с анализом плавки.',
	},
	{
		q: 'Какая плотность у стали 12Х18Н10Т?',
		a: '7,9 г/см³, или 7900 кг/м³. Это значение дают EN 10088-1 для аналога 1.4541 и ГОСТ 11068-81 для расчёта массы труб. ГОСТ 9941-81 для холоднодеформированных труб берёт 7,95 г/см³, марочник сталей и сплавов — 7,92 г/см³. Разница между 7,90 и 7,95 — около 0,6 %.',
	},
	{
		q: 'По какому ГОСТу поставляют 12Х18Н10Т?',
		a: 'Марку и химический состав задаёт ГОСТ 5632-2014. Тонкий лист толщиной до 3,9 мм выпускают по ГОСТ 5582-75, толстый 4–50 мм — по ГОСТ 7350-77, круг и другой сортовой прокат — по ГОСТ 5949-2018. Бесшовные трубы — по ГОСТ 9940-81 и ГОСТ 9941-81, электросварные — по ГОСТ 11068-81, ленту — по ГОСТ 4986-79.',
	},
	{
		q: 'Магнитится ли 12Х18Н10Т?',
		a: 'После закалки практически нет: это аустенитная сталь. Слабое притяжение возможно у сварных швов и плавок с ферритной фазой, а также после холодной деформации — гибки, вытяжки, нагартовки. Для проверки марки магнит не подходит: состав подтверждают сертификатом или спектральным анализом.',
	},
	{
		q: 'Чем 12Х18Н10Т отличается от 08Х18Н10 (AISI 304)?',
		a: 'Титаном. Он связывает углерод, поэтому после сварки и нагрева до 450–850 °C 12Х18Н10Т сохраняет стойкость к межкристаллитной коррозии. В 08Х18Н10 титана нет, углерода до 0,08 %, и в толстых сварных узлах для агрессивных сред она уступает. Прочность тонкого листа по ГОСТ 5582-75 у 12Х18Н10Т немного выше: σв от 530 МПа против 510 МПа.',
	},
	{
		q: 'До какой температуры работает 12Х18Н10Т?',
		a: 'По ГОСТ 5632-2014 как жаростойкая сталь — до 800 °C длительно (до 10 000 часов), интенсивная окалина на воздухе начинается с 850 °C. Под нагрузкой, как жаропрочную, её рекомендуют до 600 °C. В серосодержащих газах ГОСТ считает марку неустойчивой. Нижняя граница применения — −196 °C.',
	},
];

const sources = [
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки» — табл. 1 и приложение А', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, жаростойкий и жаропрочный', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'ГОСТ 5949-2018 — металлопродукция из нержавеющих сталей, табл. 3', href: 'https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/1/gost_5949-2018_mezhgosudarstvennyy_standart.html' },
	{ label: 'ГОСТ 9940-81 и ГОСТ 9941-81 — трубы бесшовные из коррозионно-стойкой стали, табл. 3' },
	{ label: 'ГОСТ 11068-81 — трубы электросварные из коррозионно-стойкой стали, табл. 4', href: 'https://files.stroyinf.ru/Data2/1/4294852/4294852683.htm' },
	{ label: 'AZoM — Stainless Steel Grade 321 (UNS S32100): состав и свойства по ASTM A240', href: 'https://www.azom.com/article.aspx?ArticleID=967' },
	{ label: 'ASTM A276 — Type 321: состав и механические свойства прутка (сводка Boltport)', href: 'https://boltport.com/specifications/astm-a276/' },
	{ label: 'SteelNumber — X6CrNiTi18-10 (1.4541) по EN 10088-2', href: 'http://www.steelnumber.com/en/steel_composition_eu.php?name_id=102' },
	{ label: 'Марочник сталей и сплавов — 12Х18Н10Т: физические свойства, применение', href: 'http://www.splav-kharkov.com/mat_start.php?name_id=329' },
];

const related = [
	{ label: 'Лист AISI 321 (12Х18Н10Т)', href: '/list-nerzhaveyushchiy/aisi-321/' },
	{ label: 'Круг AISI 321 (12Х18Н10Т)', href: '/krug-nerzhaveyushchiy/aisi-321/' },
	{ label: 'Труба AISI 321 (12Х18Н10Т)', href: '/truba-nerzhaveyushchaya/aisi-321/' },
	{ label: 'Сталь 08Х18Н10: состав, свойства, аналог AISI 304', href: '/blog/stal-08h18n10/' },
	{ label: 'Характеристики AISI 304, 321 и 316L', href: '/blog/harakteristiki-aisi-304-321-316/' },
	{ label: 'Аналоги марок нержавейки: AISI, ГОСТ, EN', href: '/blog/analogi-marok-nerzhaveyki/' },
];
---

<BlogArticle
	slug="stal-12h18n10t"
	title="Сталь 12Х18Н10Т: состав, ГОСТ, аналог AISI 321"
	description="Сталь 12Х18Н10Т: состав по ГОСТ 5632-2014, механические свойства листа, круга и трубы, плотность 7,9 г/см³, ГОСТы на прокат, аналоги AISI 321 и 1.4541."
	h1="Сталь 12Х18Н10Т: состав, характеристики, ГОСТ и аналог AISI 321"
	eyebrow="Справочник"
	datePublished="2026-09-26"
	dateModified="2026-09-26"
	readingMin={8}
	answer="<strong>12Х18Н10Т — аустенитная хромоникелевая сталь, стабилизированная титаном: по ГОСТ 5632-2014 в ней до 0,12 % углерода, 17–19 % хрома, 9–11 % никеля и титан от 5×C до 0,80 %.</strong> Зарубежные аналоги — AISI 321 (ASTM A240) и 1.4541 / X6CrNiTi18-10 (EN 10088), но углерода в них не больше 0,08 %. Плотность стали — 7,9 г/см³, у листа по ГОСТ 5582 и ГОСТ 7350 временное сопротивление от 530 МПа, предел текучести от 205–235 МПа."
	keyFacts={[
		'Состав по ГОСТ 5632-2014: C ≤ 0,12 %, Cr 17–19 %, Ni 9–11 %, Ti 5·C–0,80 %',
		'Лист: σв ≥ 530 МПа, σ0,2 ≥ 205 МПа (ГОСТ 5582) и ≥ 235 МПа (ГОСТ 7350)',
		'Круг по ГОСТ 5949-2018: σв ≥ 510 МПа, σ0,2 ≥ 196 МПа, δ5 ≥ 40 %',
		'Плотность 7,9 г/см³ (7900 кг/м³); ГОСТ 9941 для расчёта массы труб берёт 7,95',
		'Аналоги: AISI 321, 1.4541 (X6CrNiTi18-10), SUS321; по углероду к 321 ближе 08Х18Н10Т',
	]}
	coverAlt="Сталь 12Х18Н10Т: химический состав, свойства, ГОСТ и аналог AISI 321"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['12Х18Н10Т', 'AISI 321', 'Нержавеющая сталь', 'ГОСТ 5632-2014']}
	cta={{ title: 'Нужен прокат из 12Х18Н10Т?', text: 'Поставляем лист, круг, трубу и ленту AISI 321 — пришлите размеры и объём для расчёта.' }}
>
	<section id="sostav">
		<h2>Химический состав 12Х18Н10Т</h2>
		<p>
			Марка читается так: 12 — до 0,12 % углерода, Х18 — около 18 % хрома, Н10 — около 10 % никеля,
			Т — титан. По ГОСТ 5632-2014 сталь относится к аустенитному классу. Основное назначение —
			коррозионно-стойкая, но стандарт допускает её применение и как жаростойкой, и как жаропрочной.
		</p>
		<div class="ba-table">
			<table>
				<caption>Химический состав, % (максимум, если не указан диапазон)</caption>
				<thead>
					<tr><th>Марка, стандарт</th><th>C</th><th>Si</th><th>Mn</th><th>Cr</th><th>Ni</th><th>Ti</th><th>S</th><th>P</th></tr>
				</thead>
				<tbody>
					<tr><td>12Х18Н10Т (ГОСТ 5632-2014)</td><td>0,12</td><td>0,80</td><td>2,00</td><td>17,0–19,0</td><td>9,0–11,0</td><td>5·C–0,80</td><td>0,020</td><td>0,040</td></tr>
					<tr><td>08Х18Н10Т (ГОСТ 5632-2014)</td><td>0,08</td><td>0,80</td><td>2,00</td><td>17,0–19,0</td><td>9,0–11,0</td><td>5·C–0,70</td><td>0,020</td><td>0,040</td></tr>
					<tr><td>AISI 321 (ASTM A240)</td><td>0,08</td><td>0,75</td><td>2,00</td><td>17,0–19,0</td><td>9,0–12,0</td><td>5·(C+N)–0,70</td><td>0,030</td><td>0,045</td></tr>
					<tr><td>1.4541 (EN 10088-2)</td><td>0,08</td><td>1,00</td><td>2,00</td><td>17,0–19,0</td><td>9,0–12,0</td><td>5·C–0,70</td><td>0,015</td><td>0,045</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Титана в 12Х18Н10Т должно быть не меньше пятикратной доли углерода: при 0,10 % углерода — от 0,50 %.
			Остаточный молибден ГОСТ 5632-2014 ограничивает 0,50 %, для авиационной промышленности — 0,30 %.
			В ASTM A240 для AISI 321 дополнительно нормирован азот — до 0,10 %, а ASTM A276 на пруток допускает
			кремний до 1,00 %.
		</p>
	</section>

	<section id="mehanika">
		<h2>Механические свойства по ГОСТ и ASTM</h2>
		<p>
			Прокат из 12Х18Н10Т поставляют после закалки: по ГОСТ 7350-77 — нагрев до 1000–1080 °C, по
			ГОСТ 5949-2018 — до 1020–1100 °C, охлаждение в воде или на воздухе. Для аустенитной стали это не
			упрочнение, а растворение карбидов: после закалки металл самый мягкий и пластичный.
		</p>
		<div class="ba-table">
			<table>
				<caption>Минимальные значения при 20 °C, закалённое состояние</caption>
				<thead>
					<tr><th>Прокат, стандарт</th><th class="num">σв, МПа</th><th class="num">σ0,2, МПа</th><th class="num">δ5, %</th></tr>
				</thead>
				<tbody>
					<tr><td>Лист 0,5–3,9 мм — ГОСТ 5582-75</td><td class="num">530</td><td class="num">205</td><td class="num">40</td></tr>
					<tr><td>Лист 4–50 мм — ГОСТ 7350-77</td><td class="num">530</td><td class="num">235</td><td class="num">38</td></tr>
					<tr><td>Круг и сортовой прокат — ГОСТ 5949-2018</td><td class="num">510</td><td class="num">196</td><td class="num">40</td></tr>
					<tr><td>Труба бесшовная горячедеформированная — ГОСТ 9940-81</td><td class="num">529</td><td class="num">216*</td><td class="num">40</td></tr>
					<tr><td>Труба бесшовная холоднодеформированная — ГОСТ 9941-81</td><td class="num">549</td><td class="num">216*</td><td class="num">35</td></tr>
					<tr><td>Труба электросварная — ГОСТ 11068-81</td><td class="num">550</td><td class="num">226</td><td class="num">35</td></tr>
					<tr><td>AISI 321, лист — ASTM A240</td><td class="num">515</td><td class="num">205</td><td class="num">40</td></tr>
					<tr><td>AISI 321, пруток горячекатаный — ASTM A276</td><td class="num">515</td><td class="num">205</td><td class="num">40</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			* По ГОСТ 9940-81 и ГОСТ 9941-81 предел текучести труб проверяют по требованию потребителя.
			Для круга ГОСТ 5949-2018 дополнительно нормирует относительное сужение — не менее 55 %, ASTM A276 для
			прутка — не менее 50 %. Твёрдость AISI 321 по ASTM A240 — не более 217 HB (95 HRB).
		</p>
		<p>
			Закалкой 12Х18Н10Т не упрочняется, прочность поднимают только холодной деформацией. Нагартованный
			тонкий лист по ГОСТ 5582-75 имеет σв 880–1080 МПа при удлинении не менее 10 %, полунагартованный —
			σв от 740 МПа при удлинении от 25 %.
		</p>
	</section>

	<section id="plotnost">
		<h2>Плотность и физические свойства</h2>
		<p>
			Плотность 12Х18Н10Т — 7,9 г/см³, или 7900 кг/м³. Это значение приводят EN 10088-1 для аналога 1.4541
			и ГОСТ 11068-81 для расчёта массы труб. В других документах встречаются 7,92 и 7,95 г/см³: разница
			меньше 1 %, на массу партии она влияет слабо.
		</p>
		<div class="ba-table">
			<table>
				<caption>Плотность 12Х18Н10Т и аналогов по источникам</caption>
				<thead>
					<tr><th>Источник</th><th class="num">г/см³</th><th class="num">кг/м³</th></tr>
				</thead>
				<tbody>
					<tr><td>EN 10088-1 (1.4541); ГОСТ 9940-81 и ГОСТ 11068-81 — расчёт массы труб</td><td class="num">7,90</td><td class="num">7900</td></tr>
					<tr><td>Марочник сталей и сплавов</td><td class="num">7,92</td><td class="num">7920</td></tr>
					<tr><td>ГОСТ 9941-81 — расчёт массы холоднодеформированных труб</td><td class="num">7,95</td><td class="num">7950</td></tr>
					<tr><td>AZoM, AISI 321 (американские справочные данные)</td><td class="num">8,03</td><td class="num">8027</td></tr>
				</tbody>
			</table>
		</div>
		<div class="ba-table">
			<table>
				<caption>Физические свойства при 20 °C</caption>
				<thead>
					<tr><th>Свойство</th><th>Значение</th></tr>
				</thead>
				<tbody>
					<tr><td>Модуль упругости</td><td>193–200 ГПа (марочник — 198 ГПа)</td></tr>
					<tr><td>Теплопроводность при 20 / 500 °C</td><td>15 / 22–23 Вт/(м·К)</td></tr>
					<tr><td>Коэффициент теплового расширения, 20–100 °C</td><td>16,6 × 10⁻⁶ 1/К</td></tr>
					<tr><td>Удельная теплоёмкость, 20–100 °C</td><td>460–500 Дж/(кг·К)</td></tr>
					<tr><td>Удельное электросопротивление</td><td>0,72–0,73 мкОм·м</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Пример расчёта при 7,9 г/см³: лист толщиной 1 мм весит 7,9 кг на квадратный метр, круг Ø 20 мм —
			2,48 кг на метр. Массу других размеров удобно считать в <a href="/kalkulyator-vesa/">калькуляторе веса
			металлопроката</a>.
		</p>
	</section>

	<section id="gost">
		<h2>ГОСТы на прокат из 12Х18Н10Т</h2>
		<p>
			Марку и химический состав задаёт ГОСТ 5632-2014 — он общий для всех видов проката. Механические
			свойства, допуски и методы испытаний описаны в технических условиях на конкретный вид продукции,
			форма и размеры — в стандартах на сортамент.
		</p>
		<div class="ba-table">
			<table>
				<caption>Стандарты на прокат из 12Х18Н10Т</caption>
				<thead>
					<tr><th>Вид проката</th><th>Технические условия</th><th>Сортамент</th></tr>
				</thead>
				<tbody>
					<tr><td>Лист тонкий: горячекатаный 1,5–3,9 мм, холоднокатаный 0,5–3,9 мм</td><td>ГОСТ 5582-75</td><td>ГОСТ 19903, ГОСТ 19904</td></tr>
					<tr><td>Лист толстый: горячекатаный 4–50 мм, холоднокатаный 4–5 мм</td><td>ГОСТ 7350-77</td><td>ГОСТ 19903, ГОСТ 19904</td></tr>
					<tr><td>Лента холоднокатаная</td><td>ГОСТ 4986-79</td><td>в том же стандарте</td></tr>
					<tr><td>Круг, квадрат, шестигранник, полоса</td><td>ГОСТ 5949-2018</td><td>ГОСТ 2590, 2591, 2879, 103; калиброванный — ГОСТ 7417; со спецотделкой — ГОСТ 14955</td></tr>
					<tr><td>Труба бесшовная горячедеформированная</td><td>ГОСТ 9940-81</td><td>в том же стандарте</td></tr>
					<tr><td>Труба бесшовная холодно- и теплодеформированная</td><td>ГОСТ 9941-81</td><td>в том же стандарте</td></tr>
					<tr><td>Труба электросварная</td><td>ГОСТ 11068-81</td><td>в том же стандарте</td></tr>
					<tr><td>Проволока</td><td>ГОСТ 18143-72</td><td>в том же стандарте</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			ГОСТ 5582-75, ГОСТ 7350-77, ГОСТ 9940-81, ГОСТ 9941-81 и ГОСТ 5949-2018 требуют, чтобы прокат из
			12Х18Н10Т не был склонен к межкристаллитной коррозии. Проверяют это по ГОСТ 6032. Тексты стандартов
			собраны в <a href="/gost/">справочнике ГОСТов</a>.
		</p>
	</section>

	<section id="analogi">
		<h2>Аналоги: AISI 321, 1.4541 и другие</h2>
		<div class="ba-table">
			<table>
				<caption>Зарубежные и российские аналоги 12Х18Н10Т</caption>
				<thead>
					<tr><th>Стандарт</th><th>Марка</th><th>Отличие от 12Х18Н10Т</th></tr>
				</thead>
				<tbody>
					<tr><td>ASTM A240, A276 (США)</td><td>AISI 321, UNS S32100</td><td>C ≤ 0,08 %, Ni 9–12 %, Ti от 5·(C+N)</td></tr>
					<tr><td>ASTM A240 (США)</td><td>AISI 321H, UNS S32109</td><td>C 0,04–0,10 % — версия для работы под нагрузкой при нагреве</td></tr>
					<tr><td>EN 10088 (Европа), DIN</td><td>1.4541, X6CrNiTi18-10</td><td>C ≤ 0,08 %, S ≤ 0,015 %, Ni 9–12 %</td></tr>
					<tr><td>EN 10095 (Европа)</td><td>1.4878, X8CrNiTi18-10</td><td>Жаростойкая версия: C ≤ 0,10 %, Ti до 0,80 %</td></tr>
					<tr><td>JIS (Япония)</td><td>SUS321</td><td>Близка к AISI 321</td></tr>
					<tr><td>ГОСТ 5632-2014</td><td>08Х18Н10Т</td><td>C ≤ 0,08 %, Ti 5·C–0,70 % — ближе всех к AISI 321</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Все эти марки — аустенит 18/10, стабилизированный титаном, и в большинстве задач они взаимозаменяемы.
			Тождественными их считать нельзя: в 12Х18Н10Т допускается в полтора раза больше углерода, чем в
			AISI 321 и 1.4541, а никель ограничен 11 % вместо 12 %. По углероду к AISI 321 ближе 08Х18Н10Т —
			ГОСТ 5632-2014 рекомендует её для сред более высокой агрессивности, чем 12Х18Н10Т.
		</p>
		<p>
			Если проект требует конкретного стандарта, его указывают в заказе, а соответствие подтверждают
			сертификатом с химическим анализом плавки. Плавка 12Х18Н10Т с 0,09–0,12 % углерода в AISI 321 уже не
			попадает. Обратное тоже не гарантировано: по углероду AISI 321 всегда укладывается в ГОСТ, но никеля,
			серы и фосфора ASTM A240 допускает больше.
		</p>
	</section>

	<section id="otlichiya">
		<h2>Чем 12Х18Н10Т отличается от 08Х18Н10 и AISI 304</h2>
		<div class="ba-table">
			<table>
				<caption>12Х18Н10Т, 08Х18Н10 и AISI 304</caption>
				<thead>
					<tr><th>Показатель</th><th>12Х18Н10Т</th><th>08Х18Н10</th><th>AISI 304</th></tr>
				</thead>
				<tbody>
					<tr><td>Углерод, не более</td><td>0,12 %</td><td>0,08 %</td><td>0,07 %</td></tr>
					<tr><td>Хром</td><td>17–19 %</td><td>17–19 %</td><td>17,5–19,5 %</td></tr>
					<tr><td>Никель</td><td>9–11 %</td><td>9–11 %</td><td>8,0–10,5 %</td></tr>
					<tr><td>Титан</td><td>5·C–0,80 %</td><td>не легирована</td><td>не легирована</td></tr>
					<tr><td>Тонкий лист: σв / σ0,2, МПа</td><td>530 / 205 (ГОСТ 5582)</td><td>510 / 185 (ГОСТ 5582)</td><td>515 / 205 (ASTM A240)</td></tr>
					<tr><td>МКК после сварки и нагрева</td><td>стойкая за счёт титана</td><td>возможна в толстых сварных узлах</td><td>возможна; для сварки берут 304L</td></tr>
					<tr><td>Аналоги</td><td>AISI 321, 1.4541</td><td>AISI 304, 1.4301</td><td>08Х18Н10, 1.4301</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Главное отличие — титан. При нагреве до 450–850 °C, например в околошовной зоне, углерод в стали без
			стабилизатора соединяется с хромом в карбиды по границам зёрен. Соседние участки обедняются хромом и в
			агрессивной среде разрушаются — это межкристаллитная коррозия. В 12Х18Н10Т титан заранее связывает
			углерод в карбиды TiC, и хром остаётся в твёрдом растворе. Механизм и методы проверки разобраны в
			статье <a href="/blog/mezhkristallitnaya-korroziya/">межкристаллитная коррозия</a>.
		</p>
		<p>
			В остальном стали близки: тот же хром, никель, структура и плотность. В хлоридах 12Х18Н10Т держится
			не лучше 304 — молибдена в ней нет. Для морской атмосферы и рассолов берут молибденовые стали типа 316L,
			а для кипящей фосфорной и 10 %-ной уксусной кислоты ГОСТ 5632-2014 рекомендует 10Х17Н13М2Т.
		</p>
	</section>

	<section id="primenenie">
		<h2>Сварка, магнитность, температуры и применение</h2>
		<ul>
			<li><strong>Свариваемость.</strong> Без ограничений: сталь варят без подогрева и без термообработки после сварки. Титан плохо переходит через дугу, поэтому присадку чаще берут с ниобием — электроды ЦЛ-11, проволоку Св-07Х19Н10Б или ER347. Подробнее — в статье <a href="/blog/kak-varit-nerzhaveyku/">как варить нержавейку</a>.</li>
			<li><strong>Магнитность.</strong> После закалки 12Х18Н10Т практически не магнитится. ГОСТ 5632-2014 отмечает, что ферритной фазы в ней больше, чем в 12Х18Н12Т, поэтому швы и отдельные плавки могут слабо реагировать на магнит. После гибки, вытяжки и нагартовки магнитность растёт.</li>
			<li><strong>Нагрев.</strong> По ГОСТ 5632-2014 как жаростойкая сталь — до 800 °C длительно (до 10 000 часов), интенсивная окалина на воздухе начинается с 850 °C. Как жаропрочную, под нагрузкой, её рекомендуют до 600 °C на срок больше 10 000 часов. В серосодержащих газах ГОСТ считает марку неустойчивой.</li>
			<li><strong>Холод.</strong> Марочник сталей и сплавов относит 12Х18Н10Т к криогенным сталям: детали под давлением работают от −196 °C.</li>
		</ul>
		<p>
			Назначение по ГОСТ 5632-2014: сварная аппаратура в разных отраслях, трубы, теплообменники, муфели,
			реторты, детали печной арматуры, патрубки и коллекторы выхлопных систем. По данным марочника, из
			12Х18Н10Т делают сварные аппараты и сосуды для разбавленных растворов азотной, уксусной и фосфорной
			кислот, щелочей и солей. Для деталей под давлением марочник ограничивает рабочую температуру 600 °C,
			а в агрессивных средах — 350 °C.
		</p>
	</section>
