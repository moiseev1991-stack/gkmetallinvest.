---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'vidy', anchor: 'Что это и какие стандарты', summary: 'Приварные, резьбовые и зажимные фитинги; ГОСТ 17375–17380, исполнения 1 и 2' },
	{ id: 'otvody', anchor: 'Отводы', summary: 'Углы 45°–180°, радиус 3D и 2D, размеры и масса по ГОСТ 17375' },
	{ id: 'troyniki', anchor: 'Тройники и переходы', summary: 'ГОСТ 17376 и 17378, габариты, обозначения, заглушки' },
	{ id: 'podbor', anchor: 'Подбор по трубе', summary: 'Dн × s, ряды ГОСТ и ИСО, ASME B16.9, почему детали не стыкуются' },
	{ id: 'marka', anchor: 'Марка стали', summary: '12Х18Н10Т, 08Х18Н10, 316L: что выбрать и как записать' },
	{ id: 'priemka', anchor: 'Приварка и приёмка', summary: 'Кромки, допуски, маркировка, паспорт партии' },
