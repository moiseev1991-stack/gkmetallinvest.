const faq = [
	{
		q: 'Чем отвод 3D отличается от отвода 2D и по какому ГОСТ они делаются?',
		a: 'Радиусом изгиба. У отвода 3D R ≈ 1,5 DN, его размеры задаёт ГОСТ 17375-2001. У отвода 2D R ≈ DN, это ГОСТ 30753-2001. Для DN 100 (Dн 114,3 мм) R = 152 мм у 3D и 102 мм у 2D; стальной отвод 90° 114,3 × 6,3 мм весит 4,0 кг у 3D и 2,6 кг у 2D. В обоих стандартах углы 45°, 60°, 90° и 180°, а слово «исполнение» означает ряд диаметров, а не радиус.',
	},
	{
		q: 'Какой ГОСТ на отводы, тройники и переходы из нержавейки?',
		a: 'Размеры задают ГОСТ 17375-2001 (отводы 3D), ГОСТ 30753-2001 (отводы 2D), ГОСТ 17376-2001 (тройники), ГОСТ 17378-2001 (переходы) и ГОСТ 17379-2001 (заглушки); общие требования — ГОСТ 17380-2001. Они написаны для углеродистой и низколегированной стали, а для других марок, в том числе нержавеющих, п. 4.1.3.1 ГОСТ 17380 требует согласования изготовителя с заказчиком. В заказе указывают стандарт, Dн × s и марку, например «Отвод 90-57×5-12Х18Н10Т ГОСТ 17375-2001».',
	},
	{
		q: 'Что такое исполнение 1 и 2 у отвода, тройника и перехода?',
		a: 'Исполнение 1 полностью соответствует ИСО 3419-81: наружные диаметры 21,3; 26,9; 33,7; 42,4; 48,3; 60,3; 76,1; 88,9; 114,3; 139,7; 168,3; 219,1 мм и далее, как у труб ASME. Исполнение 2 — детали по национальным нормам: 32; 38; 45; 57; 76; 89; 108; 133; 159; 219 мм. Для DN 65, 80, 200 и 250 диаметры почти совпадают, а для DN 50 (60,3 и 57 мм), DN 125 (139,7 и 133 мм) и DN 350 (355,6 и 377 мм) расходятся. Поэтому деталь стыкуют с трубой по Dн × s, а не по DN.',
	},
	{
		q: 'Сколько весит отвод 90° из нержавейки?',
		a: 'Массу считают по формуле m = π·(D − s)·s · π·R·θ/180 · ρ, где R — радиус по таблице стандарта (около 1,5 DN), ρ = 7,9 г/см³ у AISI 304 и 321 и 8,0 г/см³ у 316L. Отвод 90° 108 × 4 мм (DN 100, R = 150 мм) из AISI 321 весит около 2,43 кг, 108 × 6 мм — 3,58 кг, 57 × 3,5 мм — 0,55 кг, 219 × 8 мм — 19,7 кг. В таблице 2 ГОСТ 17375-2001 для стали те же отводы указаны как 2,5; 3,6; 0,6 и 20 кг (округление до 0,1 кг). Отвод 45° вдвое легче отвода 90°, отвод 180° вдвое тяжелее.',
	},
	{
		q: 'Какую марку выбрать для отвода: 12Х18Н10Т, 08Х18Н10 или 316L?',
		a: 'Для нейтральных сред и сварных узлов — 12Х18Н10Т (AISI 321) или 08Х18Н10 (AISI 304), для нагрева и длительной работы сварных узлов — 12Х18Н10Т, для хлоридов и рассолов — 03Х17Н14М3 (AISI 316L), для серной, фосфорной и уксусной кислот — 10Х17Н13М2Т, а при серной кислоте до 80 °C — 06ХН28МДТ. Марка в ГОСТ 17375–17380 не названа, её указывают в заказе. В нашем прайсе 34 из 37 отводов с ценой — из 12Х18Н10Т, 2 из AISI 316L и 1 из AISI 304.',
	},
	{
		q: 'Можно ли соединить отвод по ASME B16.9 с трубой по ГОСТ?',
		a: 'Можно, если совпали наружный диаметр и стенка. Размеры ASME B16.9 (NPS 2 = 60,3 мм, NPS 4 = 114,3 мм) совпадают с исполнением 1 ГОСТ 17375 (ИСО 3419), а труба Ø57 или Ø108 мм им не подходит: разница 3,3 и 6,3 мм. Допуск на наружный диаметр торца детали исполнения 1 до 60,3 мм — от −0,8 до +1,6 мм (таблица 3 ГОСТ 17380), так что нужна труба того же ряда (60,3; 114,3 мм) или переходная деталь. Радиусы совпадают: DN 100 — R = 152 мм (1,5D) и у ГОСТ 17375, и у ASME B16.9.',
	},
	{
		q: 'Какие углы бывают у нержавеющих отводов?',
		a: 'По таблице 1 ГОСТ 17380: отводы 3D — 90° и 180° в обоих исполнениях, 45° в обоих, 60° только в исполнении 2; отводы 2D — 90° и 180° в обоих исполнениях, 60° и 45° только в исполнении 2. Для исполнения 2 по согласованию возможны другие углы и размеры (п. 4.2 ГОСТ 17375). В нашем прайсе только отводы 90° (41 позиция); 45°, 60° и 180° в прайсе нет, поставка по запросу.',
	},
	{
		q: 'Что указать при заказе отвода, тройника или перехода?',
		a: 'Вид детали (для тройника — равнопроходный или переходный, для перехода — концентрический или эксцентрический), угол и тип радиуса отвода (3D или 2D), размеры Dн × s (для тройника и перехода оба конца), исполнение 1 или 2, стандарт, марку стали, признак подконтрольного надзору трубопровода (буква П в обозначении), документы и количество. Пример по схеме ГОСТ 17375: «Отвод 90-57×5-12Х18Н10Т ГОСТ 17375-2001, 20 шт., паспорт и сертификат на металл».',
	},
];

const sources = [
	{ label: 'ГОСТ 17375-2001 (ИСО 3419-81) «Отводы крутоизогнутые типа 3D (R ≈ 1,5 DN). Конструкция» (полный текст): предисловие п. 3–5; п. 1, 4.1–4.3, таблицы 1 и 2, примеры условных обозначений', href: 'https://meganorm.ru/Data1/10/10600/index.htm' },
