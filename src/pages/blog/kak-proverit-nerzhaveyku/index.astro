	{ label: 'ASTM A380 — очистка, удаление окалины и пассивация нержавеющей стали', href: 'https://store.astm.org/standards/a380' },
	{ label: 'IspatGuru — Spark testing of steels: искровая проба и её ограничения', href: 'https://www.ispatguru.com/spark-testing-of-steels/' },
	{ label: 'Molybdenum-Thiocyanate Complex — Nature, т. 158: окраска роданидного комплекса молибдена с хлоридом олова', href: 'https://www.nature.com/articles/158516a0' },
	{ label: 'Jellesen M. S. и др. Electrochemical Screening Spot Test Method for Detection of Nickel and Cobalt Ion Release — Dermatitis, 2018: реакция никеля с диметилглиоксимом', href: 'https://journals.sagepub.com/doi/full/10.1097/DER.0000000000000389' },
	{ label: 'ГОСТ 7566-2018 «Металлопродукция. Правила приемки, маркировка, упаковка, транспортирование и хранение» — п. 5.2 и приложение Б', href: 'https://meganorm.ru/Data2/1/4293735/4293735060.pdf' },
	{ label: 'ГОСТ 28033-89 «Сталь. Метод рентгенофлюоресцентного анализа»', href: 'https://vsegost.com/Catalog/38/38667.shtml' },
	{ label: 'ГОСТ 18895-97 «Сталь. Метод фотоэлектрического спектрального анализа»', href: 'https://vsegost.com/Catalog/27/27687.shtml' },
	{ label: 'ГОСТ 7565-81 «Чугун, сталь и сплавы. Метод отбора проб для определения химического состава»', href: 'https://vsegost.com/Catalog/22/22747.shtml' },
	{ label: 'ГОСТ Р 54153-2010 «Сталь. Метод атомно-эмиссионного спектрального анализа»' },
	{ label: 'ГОСТ 5632-2014 — хром в 12Х13, 20Х13, 40Х13', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ASTM A240 — химический состав AISI 201, 304, 304L, 316, 316L, 430', href: 'https://blog.thepipingmart.com/wp-content/uploads/2021/02/ASTM-A240-A240M.pdf' },
	{ label: 'ASTM A480 — общие требования к листу и ленте, раздел 25 «Маркировка»', href: 'https://store.astm.org/a0480_a0480m-22a.html' },
	{ label: 'ASTM A312 — маркировка труб: номер плавки, размер, SML/WLD' },
	{ label: 'Positive material identification — Wikipedia', href: 'https://en.wikipedia.org/wiki/Positive_material_identification' },
];

const related = [
	{ label: 'Почему ржавеет нержавейка и как отличить её от обычной стали', href: '/blog/pochemu-rzhaveet-nerzhaveyka/' },
	{ label: 'Магнитится ли нержавейка', href: '/blog/magnitit-li-nerzhaveika/' },
	{ label: 'AISI 201: характеристики и отличия от AISI 304', href: '/blog/aisi-201-harakteristiki/' },
	{ label: 'AISI 430: характеристики и аналог 12Х17', href: '/blog/aisi-430-harakteristiki/' },
	{ label: 'Лист AISI 304 (08Х18Н10)', href: '/list-nerzhaveyushchiy/aisi-304/' },
	{ label: 'Лист AISI 316L (03Х17Н14М3)', href: '/list-nerzhaveyushchiy/aisi-316l/' },
