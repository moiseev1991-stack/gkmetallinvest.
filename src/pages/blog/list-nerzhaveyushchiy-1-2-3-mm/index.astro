---
import BlogArticle from '../../../components/BlogArticle.astro';

const sections = [
	{ id: 'razmery', anchor: 'Размеры и форматы', summary: '1000×2000, 1250×2500, 1500×3000; ГОСТ 5582-75 и 19904-90' },
	{ id: 'ves', anchor: 'Вес листа', summary: 'Масса 1 м² и листа 1, 2, 3 мм; разница по маркам' },
	{ id: 'dopuski', anchor: 'Допуски по толщине', summary: 'Таблица ГОСТ 19904-90, плоскостность, влияние на массу' },
	{ id: 'marki', anchor: 'Марки листа', summary: 'AISI 304, 321, 316L, 430, 201: когда какую' },
	{ id: 'poverhnost', anchor: 'Поверхность и плёнка', summary: '2B, BA, 4N, No1; плёнка PE и лазерная' },
	{ id: 'primenenie', anchor: 'Что делают из листа', summary: 'Применение, гибка, сварка, резка по толщинам' },
	{ id: 'cena', anchor: 'Из чего складывается цена', summary: '₽/т, пересчёт на лист, что влияет' },
	{ id: 'zakaz', anchor: 'Как заказать и проверить', summary: 'Что указать в заявке и что проверить при приёмке' },
];

const faq = [
	{
		q: 'Сколько весит лист нержавейки 2 мм?',
		a: 'Лист AISI 304 толщиной 2 мм весит 15,8 кг на квадратный метр. Формат 1000×2000 мм — 31,6 кг, 1250×2500 мм — 49,4 кг, 1500×3000 мм — 71,1 кг. Расчёт: толщина в миллиметрах × плотность 7,9 г/см³ × площадь листа в квадратных метрах. Для AISI 316L (8,0 г/см³) масса больше на 1,3 %, для AISI 430 (7,7 г/см³) меньше на 2,5 %. Фактическая масса отличается от расчётной на допуск по толщине: у листа 2 мм при ширине до 1000 мм он составляет от ±4 до ±7,5 % массы.',
	},
	{
		q: 'Какие размеры листа нержавейки бывают?',
		a: 'Основные форматы для толщины 1, 2 и 3 мм — 1000×2000, 1250×2500 и 1500×3000 мм. Для некоторых марок есть 1240×2500, 1219×2500 и 1500×2500 мм; лист 3 мм бывает длиной 4000 и 6000 мм (например, 1500×6000). ГОСТ 19904-90 задаёт для холоднокатаного листа ряд ширин от 500 до 2350 мм и длин от 1000 до 6000 мм, а другие размеры допускает по требованию потребителя.',
	},
	{
		q: 'Какой лист нержавейки лучше для кухни и для фасада?',
		a: 'Для кухни и пищевого оборудования берут AISI 304 (08Х18Н10) толщиной 1–2 мм с поверхностью 2B, BA или 4N: сталь пищевая и легко моется. AISI 430 подходит для кухонной отделки в сухом помещении. Для фасада внутри здания — 304 или 430, для уличного фасада в городе — 304, у побережья и дорог с реагентами — 316L. AISI 201 на улице, у моря и в агрессивной среде не рекомендуют. Для фасада выбирайте гладкую поверхность: на ней меньше задерживаются грязь и соли.',
	},
	{
		q: 'Чем лист 1 мм отличается от 2 и 3 мм?',
		a: 'Массой, жёсткостью и поведением при обработке. Масса растёт пропорционально толщине: 7,9, 15,8 и 23,7 кг на квадратный метр. Жёсткость пластины при изгибе растёт как куб толщины: лист 2 мм при тех же размерах жёстче листа 1 мм в 8 раз, лист 3 мм — в 27. Лист 1 мм легко гнётся, но при сварке коробится и прожигается; 2 и 3 мм устойчивее к нагреву и держат нагрузку без рёбер жёсткости. Горячекатаный тонкий лист по ГОСТ 5582-75 начинается с 1,5 мм, поэтому лист 1 мм всегда холоднокатаный, а 2 и 3 мм бывают и горячекатаными.',
	},
	{
		q: 'Какие допуски по толщине у нержавеющего листа?',
		a: 'Для холоднокатаного листа — по ГОСТ 19904-90, таблица 2. При ширине до 1000 мм допуск составляет: для 1 мм ±0,05 (высокая точность), ±0,08 (повышенная) и ±0,10 мм (нормальная); для 2 мм ±0,08, ±0,12 и ±0,15 мм; для 3 мм ±0,12, ±0,16 и ±0,18 мм. С ростом ширины допуск увеличивается. Класс точности указывают в заказе: ВТ, АТ или БТ.',
	},
	{
		q: 'Из чего складывается цена листа?',
		a: 'Из цены за тонну и массы листа. В нашем каталоге цена указана в рублях за тонну с НДС отдельно для каждой позиции: марка, поверхность, толщина и формат. Стоимость листа — масса листа в килограммах, умноженная на цену за килограмм (цена за тонну, делённая на 1000). На цену влияют марка, поверхность и плёнка, толщина, формат, производитель, объём партии (в каталоге есть цена от 1 т и розница до 1 т) и доставка. Резка по чертежу считается отдельно.',
	},
	{
		q: 'Какую поверхность выбрать?',
		a: 'Для скрытых деталей, ёмкостей и под покраску — 2B (матовая). Для видимых изделий, посуды и мойки — BA (блестящая) или 4N (шлифованная, скрывает мелкие царапины). Для технических деталей без требований к виду подходит горячекатаный лист с поверхностью No1. Если важна шероховатость, указывайте Ra в заказе: само обозначение отделки её не гарантирует. Подробнее — в статье о поверхностях нержавеющего листа.',
	},
];

const sources = [
	{ label: 'ГОСТ 19904-90 «Прокат листовой холоднокатаный. Сортамент» — п. 1 и табл. 1 (ряд размеров), п. 2 (классы точности), табл. 2 (допуски по толщине), табл. 4 и 6 (ширина и длина), табл. 7 (плоскостность), п. 11 (серповидность)', href: 'https://files.stroyinf.ru/Data1/4/4045/index.htm' },
	{ label: 'ГОСТ 19903-74 «Прокат листовой горячекатаный. Сортамент» — область применения: толщина 0,40–160 мм', href: 'https://meganorm.ru/Data2/1/4294852/4294852655.htm' },
	{ label: 'ГОСТ 5582-75 — прокат тонколистовой коррозионно-стойкий, жаростойкий и жаропрочный: пп. 1.1, 2.1–2.3, 3.1 (марки), табл. 1, примеры условных обозначений', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846405.htm' },
	{ label: 'ГОСТ 7350-77 — сталь толстолистовая коррозионно-стойкая, жаростойкая и жаропрочная: п. 2.1 (толщина от 4 мм)', href: 'https://files.stroyinf.ru/Data2/1/4294846/4294846403.htm' },
	{ label: 'ГОСТ 5632-2014 «Нержавеющие стали и сплавы коррозионно-стойкие, жаростойкие и жаропрочные. Марки»', href: 'https://files.stroyinf.ru/Data2/1/4293768/4293768317.htm' },
	{ label: 'ГОСТ 7566-2018 «Металлопродукция. Правила приемки, маркировка, упаковка, транспортирование и хранение» — п. 5.2 и приложение Б (документы о качестве)', href: 'https://meganorm.ru/Data2/1/4293735/4293735060.pdf' },
	{ label: 'BS EN 10088-2:2014 — технические условия поставки листа, плиты и ленты из нержавеющих сталей общего назначения (описание стандарта)', href: 'https://webstore.ansi.org/standards/bsi/bsen100882014-1523002' },
	{ label: 'ISSF — Surface finishes (учебный модуль): отделки 2B, BA, шлифованные и полированные поверхности', href: 'https://www.imoa.info/download_files/stainless-steel/issf/educational/Module_08_Surface_Finishes_en.pdf' },
	{ label: 'BSSA — Specifying finishes for stainless steel flat products', href: 'https://bssa.org.uk/bssa_articles/specifying-finishes-for-stainless-steel-flat-products-sheet-and-plate/' },
	{ label: 'EN 10204 — виды документов о контроле продукции (2.1, 2.2, 3.1, 3.2)' },
];

const related = [
	{ label: 'Поверхности нержавеющего листа: 2B, BA, 4N, 8K', href: '/blog/poverhnosti-nerzhaveyushchego-lista/' },
	{ label: 'Плотность нержавеющей стали по маркам', href: '/blog/plotnost-nerzhaveyushchey-stali/' },
	{ label: 'AISI 304, 316L и 321: чем отличаются и что выбрать', href: '/blog/aisi-304-vs-316l-vs-321/' },
	{ label: 'Чем резать нержавейку: лазер, плазма, гидроабразив', href: '/blog/chem-rezat-nerzhaveyku/' },
	{ label: 'Калькулятор веса металлопроката', href: '/kalkulyator-vesa/' },
	{ label: 'Лист нержавеющий: каталог и цены', href: '/list-nerzhaveyushchiy/' },
	{ label: 'Вес листа нержавейки: таблица по толщине и формату', href: '/blog/ves-nerzhaveyushchego-lista-tablica/' },
	{ label: 'Перфорированный лист из нержавейки: виды, шаг, заказ', href: '/blog/perforirovannyy-list-nerzhaveyushchiy/' },
];
---

<BlogArticle
	slug="list-nerzhaveyushchiy-1-2-3-mm"
	title="Лист нержавеющий 1, 2, 3 мм: размеры, вес, марки"
	description="Лист нержавеющий 1, 2 и 3 мм: форматы 1000×2000, 1250×2500, 1500×3000, вес 1 м² и листа, допуски по ГОСТ 19904, марки, поверхность и расчёт стоимости."
	h1="Лист нержавеющий 1, 2 и 3 мм: размеры, вес, марки и поверхность"
	eyebrow="Справочник"
	datePublished="2026-10-05"
	dateModified="2026-10-05"
	readingMin={10}
	answer="<strong>Лист нержавеющий толщиной 1, 2 и 3 мм чаще всего поставляют холоднокатаным, форматами 1000×2000, 1250×2500 и 1500×3000 мм; масса 1 м² из AISI 304 — 7,9, 15,8 и 23,7 кг.</strong> Лист 2 мм формата 1250×2500 весит 49,4 кг. По ГОСТ 19904-90 допуск по толщине при ширине до 1000 мм — ±0,05–0,10 мм для листа 1 мм, ±0,08–0,15 мм для 2 мм и ±0,12–0,18 мм для 3 мм в зависимости от класса точности. Цена листа складывается из цены за тонну и массы: на цену влияют марка, поверхность, толщина, формат, объём партии и доставка."
	keyFacts={[
		'Масса 1 м² из AISI 304 (7,9 г/см³): 7,9 кг при 1 мм, 15,8 кг при 2 мм, 23,7 кг при 3 мм; у 316L на 1,3 % больше, у 430 на 2,5 % меньше',
		'Лист 1250×2500 мм: 24,7 кг (1 мм), 49,4 кг (2 мм), 74,1 кг (3 мм); лист 1000×2000 мм: 15,8, 31,6 и 47,4 кг',
		'ГОСТ 5582-75: тонколистовой прокат 0,5–3,9 мм холоднокатаный и 1,5–3,9 мм горячекатаный; от 4 мм — толстолистовой по ГОСТ 7350-77',
		'ГОСТ 19904-90, ширина до 1000 мм: допуск по толщине ±0,05–0,10 мм (1 мм), ±0,08–0,15 мм (2 мм), ±0,12–0,18 мм (3 мм)',
		'В каталоге лист продаётся на тонны: цена в рублях за тонну с НДС, для листа есть пересчёт на штуки',
	]}
	coverAlt="Лист нержавеющий 1, 2 и 3 мм: размеры, вес, марки и поверхность"
	sections={sections}
	faq={faq}
	sources={sources}
	related={related}
	about={['Лист нержавеющий', 'Листовая нержавеющая сталь', 'Вес нержавеющего листа', 'ГОСТ 19904-90', 'ГОСТ 5582-75']}
	cta={{ title: 'Нужен лист нержавеющий 1, 2 или 3 мм?', text: 'Поставляем лист 1, 2, 3 мм AISI 304 и другие толщины, режем лазером по чертежу. Пришлите марку, формат, поверхность и объём — посчитаем.' }}
>
	<section id="razmery">
		<h2>Размеры листа 1, 2 и 3 мм: форматы и стандарты</h2>
		<p>
			ГОСТ 5582-75 распространяется на тонколистовой коррозионно-стойкий прокат: холоднокатаный толщиной от 0,5
			до 3,9 мм, горячекатаный — от 1,5 до 3,9 мм (п. 2.1). Листы 1, 2 и 3 мм входят в этот диапазон.
			Толстолистовая сталь по ГОСТ 7350-77 начинается с 4 мм. Размеры и допуски ГОСТ 5582-75 не задаёт, а отсылает
			к сортаментным стандартам: ГОСТ 19904-90 — для холоднокатаного листа, ГОСТ 19903-2015 (ранее ГОСТ 19903-74) — для горячекатаного.
			Подробнее о стандартах — на страницах <a href="/gost/5582-75/">ГОСТ 5582-75</a> и
			<a href="/gost/19904-90/">ГОСТ 19904-90</a>.
		</p>
		<p>
			В ряду размеров ГОСТ 19904-90 (табл. 1) есть толщины 1,00, 2,00 и 3,00 мм, ширины 1000, 1250 и 1500 мм и
			длины 2000, 2500 и 3000 мм, так что форматы 1000×2000, 1250×2500 и 1500×3000 мм стандартные; п. 1 стандарта
			разрешает по требованию потребителя и другие размеры. В каталоге формат 1250×2500 мм самый частый.
		</p>
		<div class="ba-table">
			<table>
				<caption>Листы 1, 2 и 3 мм в каталоге: форматы, поверхности, марки</caption>
				<thead>
					<tr><th>Толщина</th><th>Форматы, мм</th><th>Поверхности</th><th>Марки</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>1 мм (только холоднокатаный)</td>
						<td>1000×2000, 1250×2500, 1500×3000; реже 1240×2500 и 1219×2500</td>
						<td>2B, BA, 4N; декоративные DECO</td>
						<td>AISI 304, 321, 316L, 430, 201, 310S</td>
					</tr>
					<tr>
						<td>2 мм</td>
						<td>1000×2000, 1250×2500, 1500×3000; реже 1240×2500 и 1500×2500; горячекатаный 1500×6000</td>
						<td>2B, BA, 4N; No1 у горячекатаного</td>
						<td>AISI 304, 321, 316L, 316Ti, 430, 201, 310S</td>
					</tr>
					<tr>
						<td>3 мм (холоднокатаный и горячекатаный)</td>
						<td>1000×2000, 1250×2500, 1500×3000, 1500×6000; реже 1240×2500, 1250×2000 и 1000×4000</td>
						<td>2B, 4N, BA; No1 у горячекатаного; рифлёный лист (Tear plate)</td>
						<td>AISI 304, 321, 316L, 316Ti, 430, 201, 410S, 310S, 309S, 904L, дуплекс 2205</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Больше всего позиций в каталоге — AISI 304 и 430 с поверхностью 2B. Нестандартный размер режут из листа
			или рулона. Лист шириной 1219 и 1240 мм есть только у отдельных марок, в основном 201 и 430: при раскрое
			учитывайте точную ширину. Для больших партий одинаковых заготовок посмотрите
			<a href="/rulon-nerzhaveyushchiy/">рулон нержавеющий</a> и услугу
			<a href="/uslugi/rezka-rulonov/">резки рулонов</a>.
		</p>
	</section>

	<section id="ves">
		<h2>Вес листа нержавейки 1, 2 и 3 мм</h2>
		<p>
			Масса 1 м² в килограммах равна толщине в миллиметрах, умноженной на плотность в граммах на кубический
			сантиметр. Для AISI 304 (08Х18Н10) плотность 7,9 г/см³: каждый миллиметр толщины даёт 7,9 кг на квадратный
			метр. Масса листа — масса 1 м², умноженная на площадь. Пример: лист 2 мм 1250×2500 мм —
			1,25 × 2,5 × 15,8 = 49,4 кг. Цифры в таблице совпадают с
			<a href="/kalkulyator-vesa/">калькулятором веса</a>.
		</p>
		<div class="ba-table">
			<table>
				<caption>Масса листа AISI 304 / 08Х18Н10, плотность 7,9 г/см³</caption>
				<thead>
					<tr>
						<th>Толщина, мм</th>
						<th class="num">1 м², кг</th>
						<th class="num">Лист 1000×2000, кг</th>
						<th class="num">Лист 1250×2500, кг</th>
						<th class="num">Лист 1500×3000, кг</th>
						<th class="num">Листов 1250×2500 в 1 т</th>
					</tr>
				</thead>
				<tbody>
					<tr><td>1</td><td class="num">7,9</td><td class="num">15,8</td><td class="num">24,7</td><td class="num">35,6</td><td class="num">≈ 40,5</td></tr>
					<tr><td>2</td><td class="num">15,8</td><td class="num">31,6</td><td class="num">49,4</td><td class="num">71,1</td><td class="num">≈ 20,3</td></tr>
					<tr><td>3</td><td class="num">23,7</td><td class="num">47,4</td><td class="num">74,1</td><td class="num">106,7</td><td class="num">≈ 13,5</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Плотность зависит от класса стали: у марок с молибденом она выше, у ферритных ниже. Значения — как в
			калькуляторе веса; таблица по маркам — в статье о
			<a href="/blog/plotnost-nerzhaveyushchey-stali/">плотности нержавеющей стали</a>.
		</p>
		<div class="ba-table">
			<table>
				<caption>Масса 1 м² листа по маркам, кг</caption>
				<thead>
					<tr><th>Марка</th><th class="num">Плотность, г/см³</th><th class="num">1 мм</th><th class="num">2 мм</th><th class="num">3 мм</th></tr>
				</thead>
				<tbody>
					<tr><td>AISI 304, 321 (08Х18Н10, 12Х18Н10Т)</td><td class="num">7,9</td><td class="num">7,9</td><td class="num">15,8</td><td class="num">23,7</td></tr>
					<tr><td>AISI 316L, 316Ti</td><td class="num">8,0</td><td class="num">8,0</td><td class="num">16,0</td><td class="num">24,0</td></tr>
					<tr><td>AISI 201</td><td class="num">7,8</td><td class="num">7,8</td><td class="num">15,6</td><td class="num">23,4</td></tr>
					<tr><td>AISI 430 (12Х17)</td><td class="num">7,7</td><td class="num">7,7</td><td class="num">15,4</td><td class="num">23,1</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			Это теоретическая масса по номинальной толщине. Реальный лист легче или тяжелее на величину допуска —
			об этом следующий раздел.
		</p>
	</section>

	<section id="dopuski">
		<h2>Допуски по толщине и плоскостность по ГОСТ 19904-90</h2>
		<p>
			ГОСТ 19904-90 делит холоднокатаный прокат по точности толщины на три класса: ВТ — высокая, АТ — повышенная,
			БТ — нормальная. Допуск растёт с толщиной и шириной листа. В таблице — значения из табл. 2 стандарта для
			толщин 1, 2 и 3 мм. Строки стандарта охватывают интервалы: для 1 мм — св. 0,90 до 1,20 мм, для 2 мм —
			св. 1,80 до 2,00 мм, для 3 мм — св. 2,50 до 3,00 мм.
		</p>
		<div class="ba-table">
			<table>
				<caption>Предельные отклонения по толщине, мм (ГОСТ 19904-90, табл. 2)</caption>
				<thead>
					<tr><th>Толщина</th><th>Ширина листа</th><th class="num">ВТ</th><th class="num">АТ</th><th class="num">БТ</th></tr>
				</thead>
				<tbody>
					<tr><td>1 мм</td><td>до 1000</td><td class="num">±0,05</td><td class="num">±0,08</td><td class="num">±0,10</td></tr>
					<tr><td>1 мм</td><td>св. 1000 до 1500</td><td class="num">±0,06</td><td class="num">±0,09</td><td class="num">±0,11</td></tr>
					<tr><td>1 мм</td><td>св. 1500 до 2000</td><td class="num">±0,07</td><td class="num">±0,10</td><td class="num">±0,13</td></tr>
					<tr><td>2 мм</td><td>до 1000</td><td class="num">±0,08</td><td class="num">±0,12</td><td class="num">±0,15</td></tr>
					<tr><td>2 мм</td><td>св. 1000 до 1500</td><td class="num">±0,09</td><td class="num">±0,13</td><td class="num">±0,16</td></tr>
					<tr><td>2 мм</td><td>св. 1500 до 2000</td><td class="num">±0,10</td><td class="num">±0,15</td><td class="num">±0,18</td></tr>
					<tr><td>3 мм</td><td>до 1000</td><td class="num">±0,12</td><td class="num">±0,16</td><td class="num">±0,18</td></tr>
					<tr><td>3 мм</td><td>св. 1000 до 1500</td><td class="num">±0,13</td><td class="num">±0,16</td><td class="num">±0,19</td></tr>
					<tr><td>3 мм</td><td>св. 1500 до 2000</td><td class="num">±0,14</td><td class="num">±0,19</td><td class="num">±0,22</td></tr>
				</tbody>
			</table>
		</div>
		<p>
			<strong>Что это значит для массы.</strong> Отклонение в 0,10 мм на листе 1 мм — это 10 % массы. У листа
			1 мм нормальной точности (БТ) масса может отличаться от теоретической на ±10 %, высокой (ВТ) — на ±5 %.
			У листа 2 мм — от ±4 % (ВТ) до ±7,5 % (БТ), у листа 3 мм — от ±4 % до ±6 % (расчёт по табл. 2 для ширины
			до 1000 мм). При продаже на тонны это важно: если лист у нижней границы допуска, в тонне будет больше
			листов, а если у верхней — меньше.
		</p>
		<h3>Плоскостность, серповидность, ширина и длина</h3>
		<p>
			Отклонение от плоскостности ГОСТ 19904-90 задаёт на 1 м длины листа (табл. 7). Виды плоскостности:
			ПО — особо высокая, ПВ — высокая, ПУ — улучшенная, ПН — нормальная.
		</p>
		<div class="ba-table">
			<table>
				<caption>Отклонение от плоскостности на 1 м длины, мм (ГОСТ 19904-90, табл. 7)</caption>
				<thead>
					<tr><th>Вид плоскостности</th><th class="num">Ширина до 1000</th><th class="num">Св. 1000 до 1500</th><th class="num">Св. 1500</th></tr>
				</thead>
				<tbody>
					<tr><td>ПО — особо высокая</td><td class="num">4</td><td class="num">5</td><td class="num">6</td></tr>
					<tr><td>ПВ — высокая</td><td class="num">8</td><td class="num">8</td><td class="num">10</td></tr>
					<tr><td>ПУ — улучшенная</td><td class="num">10</td><td class="num">12</td><td class="num">15</td></tr>
					<tr><td>ПН — нормальная</td><td class="num">12</td><td class="num">15</td><td class="num">18</td></tr>
				</tbody>
			</table>
		</div>
		<ul>
			<li><strong>Область действия.</strong> Нормы табл. 7 относятся к листам с временным сопротивлением не выше 690 Н/мм². Для листа с σв свыше 70 до 85 кгс/мм² ГОСТ 5582-75 допускает не более 25 мм на 1 м (п. 2.3).</li>
			<li><strong>Серповидность.</strong> Не более 3 мм на 1 м длины; для листа с обрезной кромкой по требованию потребителя — 2 мм на 1 м (п. 11).</li>
			<li><strong>Ширина и длина.</strong> Отклонения односторонние, в сторону увеличения. Для листа с обрезной кромкой шириной до 1000 мм они равны +2 мм при высокой и повышенной точности и +5 мм при нормальной (табл. 4). Для длины листа св. 1500 до 3000 мм — +3, +10 и +20 мм соответственно (табл. 6).</li>
			<li><strong>Горячекатаный лист</strong> 3 мм поставляют по ГОСТ 19903-74: допуски по толщине и плоскостность у него свои, их задают в заказе по этому стандарту.</li>
		</ul>
		<p>
			ГОСТ 5582-75 приводит пример записи заказа: «Лист АТ-АШ-АД-ПН-О-2×1000×2000 ГОСТ 19904-90, 12Х18Н10Т-Н1
			ГОСТ 5582-75». Здесь АТ, АШ, АД — повышенная точность по толщине, ширине и длине, ПН — нормальная
			плоскостность, О — обрезная кромка, Н1 — нагартованное состояние.
		</p>
	</section>

	<section id="marki">
		<h2>Какие марки используют для листа 1, 2 и 3 мм</h2>
		<p>
			ГОСТ 5582-75 допускает в тонком листе десятки марок (п. 3.1), химический состав берут по ГОСТ 5632-2014. В
			каталоге основные — аустенитные 304, 321, 316L и ферритная 430. Страницы марок:
			<a href="/list-nerzhaveyushchiy/aisi-304/">AISI 304</a>, <a href="/list-nerzhaveyushchiy/aisi-321/">AISI 321</a>,
			<a href="/list-nerzhaveyushchiy/aisi-316l/">AISI 316L</a>, <a href="/list-nerzhaveyushchiy/aisi-430/">AISI 430</a>,
			<a href="/list-nerzhaveyushchiy/aisi-201/">AISI 201</a>.
		</p>
		<div class="ba-table">
			<table>
				<caption>Марки листа: когда какую брать</caption>
				<thead>
					<tr><th>Марка</th><th>Аналог по ГОСТ</th><th>Когда брать</th><th>Ограничения</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>AISI 304</td>
						<td>08Х18Н10</td>
						<td>Базовая марка: пищевое и торговое оборудование, мойки, корпуса, интерьер, фасады в городе</td>
						<td>Хлориды (море, рассолы, реагенты) и кислоты; по ГОСТ 5582-75 в термообработанном листе σв не менее 510 МПа, δ5 не менее 45 %</td>
					</tr>
					<tr>
						<td>AISI 321</td>
						<td>12Х18Н10Т</td>
						<td>Сварные узлы и детали с нагревом: дымоходы, кожухи, печное оборудование</td>
						<td>Титан защищает от межкристаллитной коррозии после нагрева; для хлоридов берут 316L</td>
					</tr>
					<tr>
						<td>AISI 316L</td>
						<td>03Х17Н14М3</td>
						<td>Хлориды, химия, фарма, берег и дороги с реагентами; сварные конструкции</td>
						<td>Содержит 2–3 % молибдена; по прайсу дороже 304; плотность 8,0 г/см³</td>
					</tr>
					<tr>
						<td>AISI 430</td>
						<td>12Х17</td>
						<td>Бытовая техника, кухонная отделка, вытяжки и интерьеры в сухом помещении</td>
						<td>Магнитится; хуже держит хлориды, чем 304; в сварных конструкциях уступает 304</td>
					</tr>
					<tr>
						<td>AISI 201</td>
						<td>12Х15Г9НД — по ТУ, в ГОСТ 5632-2014 нет</td>
						<td>Недорогой лист для декоративных изделий и сухих помещений</td>
						<td>Осторожно: хуже 304 в хлоридах и кислотах, на улице и у моря не рекомендуют</td>
					</tr>
				</tbody>
			</table>
		</div>
		<p>
			Как отличаются 304, 316L и 321, разобрано в статье
			<a href="/blog/aisi-304-vs-316l-vs-321/">AISI 304, 316L и 321</a>. Про 430 и 201 —
			<a href="/blog/aisi-430-harakteristiki/">AISI 430</a> и
			<a href="/blog/aisi-201-harakteristiki/">AISI 201</a>. Для пищевого контакта подходят аустенитные 304 и
			316L — см. статью о <a href="/blog/pishchevaya-nerzhaveyka/">пищевой нержавейке</a>. Как работает защита
			стабилизированных марок от межкристаллитной коррозии, объясняет статья
			<a href="/blog/mezhkristallitnaya-korroziya/">о МКК</a>.
		</p>
		<p>
			В ГОСТ 5582-75 нет марки 12Х15Г9НД, поэтому лист AISI 201 поставляют по ТУ производителя или зарубежным
			стандартам. Сертификат на такой лист должен ссылаться на стандарт, по которому заявлена марка.
		</p>
	</section>

	<section id="poverhnost">
		<h2>Поверхность и защитная плёнка</h2>
		<p>
			В каталоге листов 1–3 мм встречаются отделки 2B, BA, 4N и No1; позиции с DECO в названии — декоративные.
			Зеркало 8K и шлифовка HL для этих толщин в каталоге не значатся — наличие уточняйте. Подробное описание
			отделок, шероховатость Ra и сравнение по EN 10088-2 и ASTM A480 — в статье
			<a href="/blog/poverhnosti-nerzhaveyushchego-lista/">«Поверхности нержавеющего листа»</a>. Здесь —
			коротко, что нужно для выбора.
		</p>
		<ul>
			<li><strong>2B</strong> — матовая холоднокатаная поверхность: основной вариант для технических деталей, ёмкостей, корпусов и деталей под покраску.</li>
			<li><strong>BA</strong> — блестящая, после отжига в защитной атмосфере: для видимых изделий и посуды; чаще всего с плёнкой.</li>
			<li><strong>4N</strong> — шлифованная с направленным штрихом: для видимых панелей и фасадов, скрывает мелкие царапины. Направление штриха при раскрое важно: детали одного изделия режут вдоль одного направления.</li>
			<li><strong>No1</strong> — горячекатаный лист после отжига и травления: матовая шероховатая поверхность для технических задач (чаще у толщины 3 мм).</li>
			<li><strong>Рифлёный лист</strong> (Tear plate) — для ступеней и площадок; в каталоге у толщины 3 мм.</li>
		</ul>
		<p>
			Плёнка защищает поверхность от царапин при транспортировке, резке и монтаже. В названиях позиций
			каталога «+PE» означает полиэтиленовую плёнку, «+LASER PE» — плёнку для лазерной резки. Если лист пойдёт
			на лазерный станок, плёнку указывайте в заявке. Плёнку можно нанести на лист и отдельно — услуга
			<a href="/uslugi/nanesenie-plenki/">нанесение защитной плёнки</a>. Полировка и доводка — услуга
			<a href="/uslugi/polirovka/">полировка нержавейки</a>.
		</p>
	</section>

	<section id="primenenie">
		<h2>Что делают из листа 1, 2 и 3 мм и как толщина влияет на обработку</h2>
		<div class="ba-table">
			<table>
				<caption>Типичное применение по толщине</caption>
				<thead>
					<tr><th>Толщина</th><th>Типичное применение</th><th>Особенности</th></tr>
				</thead>
				<tbody>
					<tr>
						<td>1 мм</td>
						<td>Кожухи и корпуса, облицовка и панели, декоративная отделка, вытяжки, мелкие детали после лазерной резки и гибки</td>
						<td>Лёгкий и гибкий; без рёбер жёсткости не держит нагрузку; сварка требует аккуратности</td>
					</tr>
					<tr>
						<td>2 мм</td>
						<td>Корпуса и каркасы оборудования, кухонное и пищевое оборудование, столы и мойки, ёмкости, дымоходы, ограждения</td>
						<td>Универсальная толщина: достаточно жёсткая, хорошо гнётся и режется</td>
					</tr>
					<tr>
						<td>3 мм</td>
						<td>Рамы и основания, фланцы и пластины, ёмкости, детали под нагрузку, ступени и площадки (рифлёный лист)</td>
						<td>Жёсткий; для гибки нужно больше усилия; устойчивее к прожогу при сварке, чем 1–2 мм</td>
					</tr>
				</tbody>
			</table>
		</div>
		<h3>Жёсткость</h3>
		<p>
			Жёсткость пластины при изгибе растёт как куб толщины. Лист 2 мм при тех же размерах жёстче листа 1 мм в
			8 раз, лист 3 мм — в 27, а масса растёт только в 2 и 3 раза. Поэтому для большой плоской панели лист 2 мм
			часто выгоднее, чем лист 1 мм с рёбрами.
		</p>
		<h3>Гибка</h3>
		<p>
			Нержавейка пружинит сильнее углеродистой стали и упрочняется при деформации. Чем толще лист, тем больше
			усилие и радиус гибки. Угол и радиус уточняют пробной гибкой, особенно для 316L и 3 мм. Если нужна
			точная деталь, лучше заказать гибку вместе с лазерной резкой.
		</p>
		<h3>Сварка</h3>
		<p>
			У аустенитной нержавейки теплопроводность около 15 Вт/(м·К), у углеродистой стали — около 52, а
			тепловое расширение больше: 16–17 против 11–12 × 10<sup>−6</sup> 1/К (данные — в статье о
			<a href="/blog/teplovye-svoystva-nerzhaveyki/">тепловых свойствах</a>). Тепло остаётся в зоне шва, поэтому
			лист 1 мм коробится и легко прожигается: греют минимум, прихватки ставят чаще, применяют
			теплоотводящие подкладки. На полуавтомате сварку ведут от 1 мм, тоньше — риск прожога
			(<a href="/blog/svarka-nerzhaveyki-poluavtomatom/">сварка полуавтоматом</a>). Электроды, проволока и
			режимы — в статье <a href="/blog/kak-varit-nerzhaveyku/">как варить нержавейку</a>. После сварки
			зачищают побежалость: <a href="/uslugi/travlenie-i-passivaciya/">травление и пассивация</a>.
		</p>
		<h3>Резка</h3>
		<p>
			Листы 1–3 мм режут лазером, гидроабразивом, на гильотине и плазмой. Лазер даёт точный контур и чистую
			кромку; гидроабразив режет без нагрева и деформации, что важно для тонкого листа. Гильотину для
			нержавейки выбирают с запасом: паспортную толщину, указанную для чёрной стали, снижают на 40–50 %.
			Сравнение методов — в статье <a href="/blog/chem-rezat-nerzhaveyku/">чем резать нержавейку</a>. Наши
			услуги: <a href="/uslugi/lazernaya-rezka/">лазерная резка</a> и
			<a href="/uslugi/gidroabrazivnaya-rezka/">гидроабразивная резка</a>.
		</p>
	</section>

	<section id="cena">
		<h2>Из чего складывается цена листа</h2>
		<p>
			В прайсе лист продают на тонны: цена указана в рублях за тонну с НДС. В карточке позиции есть цена от 1 т и
			розничная цена до 1 т, а для листа — вес 1 м² и пересчёт на штуки. Цену листа определяют:
		</p>
		<ul>
			<li><strong>Марка.</strong> По прайсу 316L и 321 дороже 304, а 430 дешевле: разница идёт от никеля и молибдена.</li>
			<li><strong>Поверхность и плёнка.</strong> BA, 4N и позиции с плёнкой оцениваются отдельно от 2B без плёнки.</li>
			<li><strong>Толщина.</strong> Для каждой толщины цена за тонну своя; сравнивайте позиции с одинаковыми маркой, поверхностью и форматом.</li>
			<li><strong>Формат.</strong> 1000×2000, 1250×2500 и 1500×3000 мм — разные позиции. Формат выбирают под раскрой: меньше отход.</li>
			<li><strong>Производитель.</strong> Среди позиций есть прокат разных заводов и стран — в названии указано, например, «ЧМК», «Тайвань», «ЮАР».</li>
			<li><strong>Объём партии.</strong> Цена от 1 т и розница до 1 т различаются.</li>
			<li><strong>Доставка и обработка.</strong> Доставка, лазерная и гидроабразивная резка, гибка и полировка считаются отдельно.</li>
		</ul>
		<p>
			<strong>Как перевести цену за тонну в цену листа.</strong> Стоимость листа = масса листа (кг) × цена за 1 кг,
			а цена за 1 кг — это цена за тонну, делённая на 1000. Массу берите из таблицы выше или посчитайте в
			<a href="/kalkulyator-vesa/">калькуляторе веса</a>. Помните о допуске по толщине: при продаже на тонны вы
			платите за фактическую массу. Цены на странице
			<a href="/list-nerzhaveyushchiy/">листа нержавеющего</a> актуальнее любой цифры в статье, поэтому здесь
			мы их не называем.
		</p>
	</section>

	<section id="zakaz">
		<h2>Как заказать лист и что проверить при приёмке</h2>
		<p><strong>В заявке укажите:</strong></p>
		<ul>
			<li>марку (AISI 304 или 08Х18Н10) и стандарт, по которому она заявлена;</li>
			<li>толщину, ширину и длину листа; если размер нестандартный — допустимые отклонения;</li>
			<li>поверхность (2B, BA, 4N, No1) и наличие плёнки, в том числе лазерной;</li>
			<li>класс точности по ГОСТ 19904-90, если он важен: толщина (ВТ, АТ, БТ), плоскостность (ПО, ПВ, ПУ, ПН);</li>
			<li>объём в тоннах или листах и город доставки.</li>
		</ul>
		<p><strong>При приёмке проверьте:</strong></p>
		<ul>
			<li><strong>Документ о качестве.</strong> По ГОСТ 7566-2018 состав плавки и результаты испытаний приводят в документах 3.1 и 3.2 — те же обозначения, что в EN 10204. Номер плавки в сертификате должен совпадать с маркировкой на листе или ярлыке. Как проверять — в статье <a href="/blog/kak-proverit-nerzhaveyku/">как проверить нержавейку</a>.</li>
			<li><strong>Плёнку.</strong> Она должна быть целой, без пузырей и следов клея, особенно на BA и 4N.</li>
			<li><strong>Толщину.</strong> Замерьте микрометром в нескольких точках и сравните с допуском из таблицы выше.</li>
			<li><strong>Плоскостность и серповидность.</strong> Положите лист на ровную плиту и измерьте зазор на 1 м длины; сравните с классом плоскостности из заказа.</li>
			<li><strong>Размеры и кромку.</strong> Ширина и длина в допуске, кромка без заусенцев, углы прямые.</li>
			<li><strong>Марку.</strong> Магнит марку не определяет: аустенитная 304 может слабо магнититься после гибки, а 430 магнитится всегда. Надёжнее сертификат и спектральный анализ.</li>
		</ul>
