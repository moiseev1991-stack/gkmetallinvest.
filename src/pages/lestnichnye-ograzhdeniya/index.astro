---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubRequest from '../../components/HubRequest.astro';

const types = [
	{ title: 'Стойки', desc: 'Пристенные, для стекла, для поручней. Шлифованные / зеркальные. AISI 304, 316L.' },
	{ title: 'Поручни', desc: 'Круглая труба Ø 38, 42, 50 мм. Шлифовка 4N или зеркало BA.' },
	{ title: 'Держатели ригеля', desc: 'Под трубу Ø 12–16 мм. Сверху, сбоку, под угол. Различные дизайны.' },
	{ title: 'Наконечники поручня', desc: 'Полукруг, конус, заглушка. Литые или штампованные.' },
	{ title: 'Стеклодержатели', desc: 'Для зашивки лестничных пролётов стеклом 8–12 мм. Точечные и зажимные.' },
	{ title: 'Декоративные элементы', desc: 'Низ стойки, повороты 45°/90°, соединители, T-образные узлы.' },
	{ title: 'Заглушки и фланцы', desc: 'Настенные крепления и заглушки под EN 1090 для сборки ограждений.' },
	{ title: 'Угловые соединители', desc: 'Кручёные и литые соединители под индивидуальные углы.' },
];
---

<CatalogHubTemplate
	title="Комплектующие для лестничных ограждений из нержавеющей стали"
	description="Нержавеющие стойки, поручни, держатели ригеля, стеклодержатели и фурнитура для лестничных и пандусных ограждений. AISI 304, 316L. Подбор по чертежу."
	h1="Комплектующие для лестничных ограждений"
	intro="Полный ассортимент нержавеющих комплектующих для лестничных и пандусных ограждений: стойки, поручни, держатели ригеля, стеклодержатели, наконечники, декоративные элементы. Сталь AISI 304 (универсальная) и AISI 316L (для влажной и наружной среды). Под архитектурные и торговые проекты — по чертежу или образцу."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Комплектующие для лестничных ограждений' }]}
	noindex
>
	<HubRequest what="Комплектующие для лестничных ограждений — стойки, поручни, стеклодержатели" />

	<section class="block">
		<h2>Что есть в ассортименте</h2>
		<div class="types-grid">
			{types.map((t) => (
				<article class="type-card">
					<h3>{t.title}</h3>
					<p>{t.desc}</p>
				</article>
			))}
		</div>
	</section>

	<section class="block">
		<h2>Под какие проекты подходит</h2>
		<ul class="list-plain">
			<li>Лестничные ограждения в ТЦ, бизнес-центрах, отелях</li>
			<li>Балконные и террасные ограждения в жилых комплексах</li>
			<li>Пандусные ограждения по требованиям доступной среды</li>
			<li>Палубные и судовые ограждения (AISI 316L)</li>
			<li>Промышленные защитные ограждения в коррозионной среде</li>
		</ul>
	</section>

	<section class="block">
		<h2>Услуги под проект</h2>
		<ul class="list-plain">
			<li>Подбор комплектующих по чертежу — 3D-сборка перед заказом</li>
			<li>Полировка до зеркала или сатина 4N — см. <a href="/uslugi/polirovka/">услугу полировки</a></li>
			<li>Резка трубы поручня в размер — точность ±1 мм</li>
			<li>Подбор подрядчика на монтаж в Нижнем Новгороде и Москве</li>
		</ul>
	</section>

	<section class="block">
		<h2>Связанные категории</h2>
		<ul class="list-plain">
			<li><a href="/truba/">Труба нержавеющая</a> для поручня — круглая Ø 38, 42, 50 мм</li>
			<li><a href="/detali-truboprovoda/">Детали трубопровода</a> — фланцы, отводы (часть фурнитуры пересекается)</li>
			<li><a href="/list/">Лист нержавеющий</a> для стеновых панелей лестничного пролёта</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 65ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain a { color: var(--color-primary-600); }
	.types-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--space-3);
	}
	.type-card {
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.type-card h3 { margin: 0 0 var(--space-2); font-size: 1rem; color: var(--color-text); }
	.type-card p { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.5; }
</style>
