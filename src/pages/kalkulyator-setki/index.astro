---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';

const title = 'Калькулятор веса сетки — тканая ГОСТ 3826-82 и сварная';
const description =
	'Расчёт веса проволочной тканой и сварной сетки по диаметру проволоки и размеру ячейки. ' +
	'ГОСТ 3826-82 и ГОСТ 23279-2012. Сталь Ст3 и нержавейка AISI 304 / 316L.';

const materials = [
	{ value: 'st3', label: 'Сталь Ст3 / низкоуглеродистая', rho: 7850, applic: 'базовое исполнение по ГОСТ 3826/23279' },
	{ value: 'aisi304', label: 'Нержавейка AISI 304', rho: 7930, applic: 'фильтры, пищевые производства' },
	{ value: 'aisi316l', label: 'Нержавейка AISI 316L', rho: 8000, applic: 'хлориды, морская среда' },
];

const faq = [
	{
		q: 'Чем тканая сетка отличается от сварной?',
		a: 'Тканая сетка собирается переплетением проволоки (как ткань) — гибкая, относительно дешёвая, применяется для фильтрации, просеивания, лёгких ограждений. Регламентируется ГОСТ 3826-82. Сварная сетка — это прутки в двух перпендикулярных направлениях, соединённые точечной сваркой в каждом узле — жёсткая, не «гуляет», используется для армирования бетона, тяжёлых ограждений, клеток. Регламентируется ГОСТ 23279-2012 (арматурные сетки) и ГОСТ 2715-75 (классификация).',
	},
	{
		q: 'По какой формуле считается вес сетки?',
		a: 'Базовая формула: m₁ = (π·d²·ρ) / (2·(a + d)) × 10⁻³ × k_тип, где d — диаметр проволоки в мм, a — размер ячейки в свету в мм, ρ — плотность в кг/м³. Коэффициент k_тип учитывает переплетение: для тканой ≈ 1,10 (проволока «волнится»), для сварной ≈ 1,00 (прутки прямые). Для нержавейки дополнительно ×1,01 (ГОСТ 3826-82). Результат — масса 1 м² в кг.',
	},
	{
		q: 'Какой ГОСТ на проволочную сетку?',
		a: 'Тканая с квадратными ячейками — ГОСТ 3826-82. Сварная для армирования железобетона — ГОСТ 23279-2012, также ГОСТ Р 57997-2017. Общая классификация сеток — ГОСТ 2715-75. Сетка-рабица плетёная — ГОСТ 5336-80. Для просеивания (мукосейка) — отдельные сортаменты ГОСТ 3187-76. Сетка с шестигранной ячейкой — ГОСТ 13603-89.',
	},
	{
		q: 'Сколько весит 1 м² сварной сетки 50 × 50 × 3 мм?',
		a: 'Для сварной сетки с ячейкой 50 × 50 мм и проволокой Ø 3 мм из Ст3: m₁ = π·9·7850 / (2·53) × 10⁻³ × 1,0 ≈ 2,1 кг/м². Для рулона 1,5 × 10 м — около 31 кг. В тех же параметрах из нержавейки AISI 304 — 2,11 кг/м² (поправка +1 %). Точная масса зависит от допуска проволоки и метода производства; стандартное расхождение с расчётом — до 5–7 %.',
	},
	{
		q: 'Что такое «живое сечение» сетки?',
		a: 'Это отношение площади ячеек (просвета) к общей площади сетки, выражается в процентах. Чем выше — тем лучше сетка пропускает свет, воздух, жидкость. Для тканой сетки ГОСТ 3826-82 живое сечение указывается в таблицах от 45 до 85 % в зависимости от ячейки и диаметра проволоки. Например, ячейка 1,0 × 1,0 мм с d=0,25 мм даёт 64 % просвета; та же ячейка с d=0,4 мм — только 51 %.',
	},
	{
		q: 'Можно ли по этому калькулятору считать сетку-рабицу?',
		a: 'Не совсем. Сетка-рабица плетётся не переплетением, а скручиванием проволок в спиральные «жгуты» по диагонали. Точный расчёт массы рабицы делается через длину проволоки в одной спирали + количество спиралей. Наш калькулятор даст оценку «сверху» (для прямых прутков) с погрешностью 10–15 %. Для точного расчёта рабицы используйте таблицы поставщиков по ГОСТ 5336-80.',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const howToJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'Как рассчитать вес проволочной сетки',
	step: [
		{ '@type': 'HowToStep', name: 'Выбрать тип', text: 'Тканая (с переплетением) или сварная (с точечной сваркой в узлах).' },
		{ '@type': 'HowToStep', name: 'Ввести размер ячейки', text: 'Сторона квадрата в свету, мм.' },
		{ '@type': 'HowToStep', name: 'Ввести диаметр проволоки', text: 'Номинальный диаметр проволоки, мм.' },
		{ '@type': 'HowToStep', name: 'Указать размеры рулона/карты', text: 'Ширина и длина в метрах.' },
		{ '@type': 'HowToStep', name: 'Получить результат', text: 'Масса 1 м² и общий вес.' },
	],
};
---

<BaseLayout title={title} description={description} jsonLd={[faqJsonLd, howToJsonLd]}>
	<div class="container set">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Калькулятор веса сетки' }]} />

		<header class="set__hero">
			<span class="set__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M2 4h12M2 8h12M2 12h12M4 2v12M8 2v12M12 2v12" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
				</svg>
				ГОСТ 3826-82 / 23279-2012
			</span>
			<h1 class="set__h1">Калькулятор веса <span class="set__h1-accent">проволочной сетки</span></h1>
			<p class="set__lead">
				Расчёт веса тканой и сварной сетки по диаметру проволоки и размеру ячейки.
				Формула m₁ = π·d²·ρ / (2·(a+d)) × 10⁻³ × k_тип. Для тканой k = 1,10
				(учитывает переплетение), для сварной k = 1,00.
				Поддерживается Ст3 и нержавейка AISI 304 / 316L.
			</p>
		</header>

		<section class="set__widget" data-set-root>
			<div class="set__widget-inner">
				<div class="set__form">
					<div class="set__field">
						<label class="set__label">Тип сетки</label>
						<div class="set__radio-group">
							<label class="set__radio">
								<input type="radio" name="set-type" value="weld" checked data-set-type />
								<span>Сварная</span>
							</label>
							<label class="set__radio">
								<input type="radio" name="set-type" value="weave" data-set-type />
								<span>Тканая</span>
							</label>
						</div>
						<p class="set__hint" data-set-type-hint>Сварная — точечная сварка в узлах, ГОСТ 23279-2012</p>
					</div>

					<div class="set__field">
						<label class="set__label" for="set-mat">Материал</label>
						<select class="set__input" id="set-mat" data-set-material>
							{materials.map((m) => (
								<option value={m.value} data-rho={m.rho}>
									{m.label} — ρ {(m.rho / 1000).toLocaleString('ru-RU', { minimumFractionDigits: 2 })} г/см³
								</option>
							))}
						</select>
						<p class="set__hint" data-set-mat-hint>{materials[0].applic}</p>
					</div>

					<div class="set__row-2">
						<div class="set__field">
							<label class="set__label" for="set-a">Размер ячейки a, мм</label>
							<input class="set__input" id="set-a" type="number" inputmode="decimal" step="any" min="0.1" value="50" data-set-a />
							<p class="set__hint">сторона квадрата в свету</p>
						</div>
						<div class="set__field">
							<label class="set__label" for="set-d">Диаметр проволоки d, мм</label>
							<input class="set__input" id="set-d" type="number" inputmode="decimal" step="any" min="0.05" value="3" data-set-d />
							<p class="set__hint">типовые 0,5–6 мм</p>
						</div>
					</div>

					<div class="set__row-2">
						<div class="set__field">
							<label class="set__label" for="set-B">Ширина B, м</label>
							<input class="set__input" id="set-B" type="number" inputmode="decimal" step="any" min="0.01" value="1.5" data-set-B />
							<p class="set__hint">типовые 1,0 / 1,5 / 2,0 м</p>
						</div>
						<div class="set__field">
							<label class="set__label" for="set-L">Длина L, м</label>
							<input class="set__input" id="set-L" type="number" inputmode="decimal" step="any" min="0.01" value="10" data-set-L />
							<p class="set__hint">рулон или карта</p>
						</div>
					</div>

					<div class="set__field">
						<label class="set__label" for="set-qty">Количество рулонов / карт</label>
						<input class="set__input" id="set-qty" type="number" inputmode="numeric" step="1" min="1" value="1" data-set-qty />
					</div>
				</div>

				<aside class="set__result">
					<div class="set__result-card">
						<div class="set__result-eyebrow">Формульный расчёт</div>

						<div class="set__result-row">
							<span>Вес 1 м²</span>
							<strong data-set-m1>—</strong>
						</div>
						<div class="set__result-row">
							<span>Вес 1 рулона</span>
							<strong data-set-one>—</strong>
						</div>

						<div class="set__result-total">
							<span class="set__result-total-label">Общий вес партии</span>
							<div class="set__result-total-value" data-set-total>—</div>
							<div class="set__result-total-sub" data-set-total-sub></div>
						</div>

						<dl class="set__result-meta">
							<div><dt>Площадь 1 рулона</dt><dd data-set-area>—</dd></div>
							<div><dt>Живое сечение</dt><dd data-set-living>—</dd></div>
						</dl>

						<a class="set__cta" href="/zapros-kp/?material=setka#lead-form">
							<span>Запросить КП на сетку</span>
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>

						<p class="set__result-foot">
							Расчёт по формуле. Допуск ±5–10 % за счёт реального коэффициента переплетения и допуска проволоки.
						</p>
					</div>
				</aside>
			</div>
		</section>

		<section class="set__block">
			<h2 class="set__h2">Геометрия сетки</h2>
			<div class="set__infographic">
				<svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Схема сетки: квадратные ячейки и обозначения a (сторона) и d (диаметр)">
					<defs>
						<pattern id="setHatch" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
							<line x1="0" y1="0" x2="0" y2="8" stroke="var(--color-primary)" stroke-width="0.6" opacity="0.2" />
						</pattern>
					</defs>

					<rect x="30" y="20" width="180" height="160" fill="#fff" stroke="var(--color-primary)" stroke-width="1.2" opacity="0.7" />

					<g stroke="var(--color-primary)" stroke-width="3" opacity="0.85" stroke-linecap="round">
						<line x1="30" y1="50" x2="210" y2="50" />
						<line x1="30" y1="80" x2="210" y2="80" />
						<line x1="30" y1="110" x2="210" y2="110" />
						<line x1="30" y1="140" x2="210" y2="140" />
						<line x1="30" y1="170" x2="210" y2="170" />

						<line x1="60" y1="20" x2="60" y2="180" />
						<line x1="90" y1="20" x2="90" y2="180" />
						<line x1="120" y1="20" x2="120" y2="180" />
						<line x1="150" y1="20" x2="150" y2="180" />
						<line x1="180" y1="20" x2="180" y2="180" />
					</g>

					<g fill="var(--color-accent)" opacity="0.9">
						<circle cx="60" cy="50" r="3" />
						<circle cx="90" cy="50" r="3" />
						<circle cx="120" cy="50" r="3" />
						<circle cx="150" cy="50" r="3" />
						<circle cx="180" cy="50" r="3" />
						<circle cx="60" cy="80" r="3" />
						<circle cx="90" cy="80" r="3" />
						<circle cx="120" cy="80" r="3" />
						<circle cx="150" cy="80" r="3" />
						<circle cx="180" cy="80" r="3" />
						<circle cx="60" cy="110" r="3" />
						<circle cx="90" cy="110" r="3" />
						<circle cx="120" cy="110" r="3" />
						<circle cx="150" cy="110" r="3" />
						<circle cx="180" cy="110" r="3" />
					</g>

					<g stroke="var(--color-accent)" stroke-width="1.2" fill="none" stroke-linecap="round">
						<line x1="60" y1="200" x2="90" y2="200" />
					</g>
					<polygon points="60,200 65,196 65,204" fill="var(--color-accent)" />
					<polygon points="90,200 85,196 85,204" fill="var(--color-accent)" />
					<text x="75" y="215" text-anchor="middle" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="var(--color-accent)">a</text>

					<line x1="180" y1="50" x2="240" y2="35" stroke="var(--color-accent)" stroke-width="0.8" />
					<text x="248" y="38" font-family="Inter, sans-serif" font-size="12" font-weight="600" fill="var(--color-accent)">d</text>

					<text x="312" y="14" text-anchor="end" font-family="Inter, sans-serif" font-size="10" fill="var(--color-muted)" font-style="italic">сварная — точки сварки в узлах</text>
				</svg>

				<div class="set__infographic-legend">
					<h3>Обозначения</h3>
					<ul>
						<li><strong>a</strong> — размер ячейки в свету (расстояние между проволоками)</li>
						<li><strong>d</strong> — диаметр проволоки</li>
						<li><strong>k_тк = 1,10</strong> — поправка на удлинение для тканой</li>
						<li><strong>k_св = 1,00</strong> — для сварной (прутки прямые)</li>
					</ul>
					<p class="set__infographic-note">
						<strong>Формула:</strong><br />
						m₁ = π·d²·ρ / (2·(a+d)) × 10⁻³ × k_тип<br />
						кг/м², d и a в мм, ρ в кг/м³.
					</p>
				</div>
			</div>
		</section>

		<section class="set__block">
			<h2 class="set__h2">Типовые типоразмеры сеток</h2>
			<p class="set__block-lead">
				Выборка из сортамента ГОСТ 3826-82 (тканая) и ГОСТ 23279-2012 (сварная).
				Масса 1 м² указана для стали Ст3.
			</p>
			<div class="set__table-wrap">
				<table class="set__table">
					<thead>
						<tr>
							<th>Тип</th>
							<th>Ячейка a, мм</th>
							<th>Диаметр d, мм</th>
							<th>Живое сечение, %</th>
							<th>Масса 1 м², кг</th>
							<th>Применение</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>Тканая</td><td>1,0</td><td>0,25</td><td>64</td><td>0,64</td><td>фильтры, грохоты</td></tr>
						<tr><td>Тканая</td><td>1,0</td><td>0,40</td><td>51</td><td>1,48</td><td>тяжёлые фильтры</td></tr>
						<tr><td>Тканая</td><td>2,0</td><td>0,50</td><td>64</td><td>1,29</td><td>просеивание</td></tr>
						<tr><td>Тканая</td><td>5,0</td><td>1,20</td><td>65</td><td>3,00</td><td>теплоизоляция</td></tr>
						<tr><td>Тканая</td><td>10,0</td><td>1,00</td><td>83</td><td>1,15</td><td>вольеры, ограждения</td></tr>
						<tr><td>Сварная</td><td>25</td><td>1,4</td><td>89</td><td>0,40</td><td>армирование штукатурки</td></tr>
						<tr><td>Сварная</td><td>50</td><td>3,0</td><td>89</td><td>2,10</td><td>стяжки, кладочные сетки</td></tr>
						<tr><td>Сварная</td><td>100</td><td>4,0</td><td>92</td><td>1,90</td><td>армирование фундаментов</td></tr>
						<tr><td>Сварная</td><td>150</td><td>5,0</td><td>94</td><td>2,00</td><td>тяжёлые ЖБИ</td></tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="set__block">
			<h2 class="set__h2">Связанное</h2>
			<ul class="set__related">
				<li>
					<a href="/provoloka-nerzhaveyushchaya/">
						<strong>Проволока нержавеющая</strong>
						<small>Ø 0,1–6 мм, AISI 304/321/316L</small>
					</a>
				</li>
				<li>
					<a href="/kalkulyator-pvl/">
						<strong>Калькулятор ПВЛ</strong>
						<small>ГОСТ 8706-78 — просечно-вытяжной лист</small>
					</a>
				</li>
				<li>
					<a href="/kalkulyator-vesa/">
						<strong>Универсальный калькулятор веса</strong>
						<small>9 видов проката</small>
					</a>
				</li>
			</ul>
		</section>

		<section class="set__faq">
			<h2 class="set__h2">Частые вопросы</h2>
			<div class="set__faq-list">
				{faq.map((f) => (
					<details class="set__faq-item">
						<summary class="set__faq-q">
							<span>{f.q}</span>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</section>
	</div>

	<CtaSection
		title="Нужна проволочная сетка?"
		text="Сварные и тканые сетки из Ст3 и нержавейки AISI 304 — со склада и под заявку. Ячейки от 1 × 1 до 200 × 200 мм, диаметр проволоки 0,5–6 мм. Возможна резка карт в размер и навивка рулонов."
	/>
</BaseLayout>

<script>
	const root = document.querySelector('[data-set-root]');
	if (root) {
		const typeInputs = root.querySelectorAll('[data-set-type]');
		const typeHint = root.querySelector('[data-set-type-hint]') as HTMLElement;
		const matSel = root.querySelector('[data-set-material]') as HTMLSelectElement;
		const matHint = root.querySelector('[data-set-mat-hint]') as HTMLElement;
		const aInp = root.querySelector('[data-set-a]') as HTMLInputElement;
		const dInp = root.querySelector('[data-set-d]') as HTMLInputElement;
		const BInp = root.querySelector('[data-set-B]') as HTMLInputElement;
		const LInp = root.querySelector('[data-set-L]') as HTMLInputElement;
		const qtyInp = root.querySelector('[data-set-qty]') as HTMLInputElement;

		const m1El = root.querySelector('[data-set-m1]') as HTMLElement;
		const oneEl = root.querySelector('[data-set-one]') as HTMLElement;
		const totalEl = root.querySelector('[data-set-total]') as HTMLElement;
		const totalSubEl = root.querySelector('[data-set-total-sub]') as HTMLElement;
		const areaEl = root.querySelector('[data-set-area]') as HTMLElement;
		const livingEl = root.querySelector('[data-set-living]') as HTMLElement;

		const TYPE_HINTS: Record<string, string> = {
			weld: 'Сварная — точечная сварка в узлах, ГОСТ 23279-2012',
			weave: 'Тканая — переплетение проволоки, ГОСТ 3826-82',
		};
		const MAT_HINTS: Record<string, string> = {
			st3: 'базовое исполнение по ГОСТ 3826/23279',
			aisi304: 'фильтры, пищевые производства',
			aisi316l: 'хлориды, морская среда',
		};

		const fmt = new Intl.NumberFormat('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 3 });
		const fmt1 = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 });
		const fmt2 = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 2 });

		function getType(): 'weld' | 'weave' {
			const checked = root.querySelector('[data-set-type]:checked') as HTMLInputElement | null;
			return (checked?.value as 'weld' | 'weave') || 'weld';
		}

		function recalc() {
			const type = getType();
			const a = parseFloat(aInp.value) || 0;
			const d = parseFloat(dInp.value) || 0;
			const B = parseFloat(BInp.value) || 0;
			const L = parseFloat(LInp.value) || 0;
			const qty = parseFloat(qtyInp.value) || 0;
			const matOpt = matSel.selectedOptions[0];
			const rho = parseFloat(matOpt?.dataset.rho || '7850') || 7850;

			const kType = type === 'weave' ? 1.10 : 1.00;
			const kMat = matSel.value === 'st3' ? 1.0 : 1.01;

			let m1 = 0;
			if (a > 0 && d > 0) {
				m1 = (Math.PI * d * d * rho) / (2 * (a + d)) * 1e-3 * kType * kMat;
			}

			const area = B * L;
			const oneWeight = m1 * area;
			const total = oneWeight * qty;

			// Живое сечение для квадратной сетки: (a / (a + d))²
			const living = a > 0 && d > 0 ? (a / (a + d)) * (a / (a + d)) * 100 : 0;

			m1El.textContent = m1 > 0 ? `${fmt.format(m1)} кг/м²` : '—';
			oneEl.textContent = oneWeight > 0 ? `${fmt.format(oneWeight)} кг` : '—';

			if (total > 0) {
				if (total >= 1000) {
					totalEl.textContent = `${fmt.format(total / 1000)} т`;
					totalSubEl.textContent = `${fmt.format(total)} кг`;
				} else {
					totalEl.textContent = `${fmt.format(total)} кг`;
					totalSubEl.textContent = '';
				}
			} else {
				totalEl.textContent = '—';
				totalSubEl.textContent = '';
			}

			areaEl.textContent = area > 0 ? `${fmt1.format(area)} м²` : '—';
			livingEl.textContent = living > 0 ? `${fmt1.format(living)} %` : '—';
		}

		typeInputs.forEach((el) => el.addEventListener('change', () => {
			typeHint.textContent = TYPE_HINTS[getType()] || '';
			recalc();
		}));
		matSel.addEventListener('change', () => {
			matHint.textContent = MAT_HINTS[matSel.value] || '';
			recalc();
		});
		[aInp, dInp, BInp, LInp, qtyInp].forEach((el) => el.addEventListener('input', recalc));

		recalc();
	}
</script>

