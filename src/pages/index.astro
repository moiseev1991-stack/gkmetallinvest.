<script>
	// Shipments video modal
	const shipModal = document.querySelector('[data-ship-modal]') as HTMLElement | null;
	const shipModalVideo = shipModal?.querySelector('[data-ship-video]') as HTMLVideoElement | null;
	const shipModalTitle = shipModal?.querySelector('[data-ship-modal-title]') as HTMLElement | null;
	let shipModalOpen = false;
	const closeShipModal = () => {
		if (!shipModal || !shipModalVideo) return;
		shipModalVideo.pause();
		shipModalVideo.removeAttribute('src');
		shipModalVideo.load();
		shipModal.setAttribute('hidden', '');
		document.body.style.overflow = '';
		shipModalOpen = false;
	};
	document.querySelectorAll<HTMLButtonElement>('[data-ship-open]').forEach((btn) => {
		btn.addEventListener('click', () => {
			if (!shipModal || !shipModalVideo) return;
			const src = btn.getAttribute('data-ship-open') || '';
			const title = btn.getAttribute('data-ship-title') || '';
			shipModalVideo.src = src;
			if (shipModalTitle) shipModalTitle.textContent = title;
			shipModal.removeAttribute('hidden');
			document.body.style.overflow = 'hidden';
			shipModalOpen = true;
			shipModalVideo.play().catch(() => {});
		});
	});
	shipModal?.querySelectorAll('[data-ship-close]').forEach((el) => el.addEventListener('click', closeShipModal));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && shipModal && !shipModal.hasAttribute('hidden')) closeShipModal();
	});

	// Shipments slider — infinite auto-rotating carousel.
	// Track is rendered with shipments duplicated 2x; we silently teleport scroll
	// position back by half whenever it crosses the midpoint (and forward when it goes negative).
	const slider = document.querySelector('[data-ship-slider]') as HTMLElement | null;
	if (slider) {
		const track = slider.querySelector('[data-ship-track]') as HTMLElement | null;
		const prev = slider.querySelector('[data-ship-prev]') as HTMLElement | null;
		const next = slider.querySelector('[data-ship-next]') as HTMLElement | null;

		if (track) {
			const cardStep = () => {
				const first = track.querySelector('.ship-card') as HTMLElement | null;
				if (!first) return track.clientWidth * 0.5;
				const styles = getComputedStyle(track);
				const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
				return first.getBoundingClientRect().width + gap;
			};

			let isTeleporting = false;
			const half = () => track.scrollWidth / 2;
			const normalize = () => {
				if (isTeleporting) return;
				const h = half();
				if (h <= 0) return;
				if (track.scrollLeft >= h) {
					isTeleporting = true;
					const prevBehavior = track.style.scrollBehavior;
					track.style.scrollBehavior = 'auto';
					track.scrollLeft -= h;
					track.style.scrollBehavior = prevBehavior;
					requestAnimationFrame(() => { isTeleporting = false; });
				} else if (track.scrollLeft <= 0) {
					isTeleporting = true;
					const prevBehavior = track.style.scrollBehavior;
					track.style.scrollBehavior = 'auto';
					track.scrollLeft += h;
					track.style.scrollBehavior = prevBehavior;
					requestAnimationFrame(() => { isTeleporting = false; });
				}
			};

			let scrollDebounce: number | undefined;
			track.addEventListener('scroll', () => {
				window.clearTimeout(scrollDebounce);
				scrollDebounce = window.setTimeout(normalize, 60);
			});

			// Start somewhere in the middle so prev/next both have room
			const initOffset = () => {
				const h = half();
				if (h > 0 && track.scrollLeft === 0) {
					track.style.scrollBehavior = 'auto';
					track.scrollLeft = 0;
					track.style.scrollBehavior = '';
				}
			};
			window.addEventListener('load', initOffset);
			initOffset();

			prev?.addEventListener('click', () => {
				normalize();
				track.scrollBy({ left: -cardStep(), behavior: 'smooth' });
			});
			next?.addEventListener('click', () => {
				normalize();
				track.scrollBy({ left: cardStep(), behavior: 'smooth' });
			});

			// Hover/click-to-play: inline videos stay paused on load; play on mouseenter
			// (or tap on touch), pause + rewind on mouseleave. Click on the video opens
			// the same modal that the "Смотреть видео" button does.
			const videos = Array.from(track.querySelectorAll<HTMLVideoElement>('.ship-card__video'));
			videos.forEach((v) => {
				v.muted = true;
				v.loop = true;
				v.setAttribute('playsinline', '');
				const card = v.closest('.ship-card') as HTMLElement | null;
				const target = card ?? v;
				target.addEventListener('mouseenter', () => {
					v.play().catch(() => {});
				});
				target.addEventListener('mouseleave', () => {
					v.pause();
					try { v.currentTime = 0.5; } catch {}
				});
				v.style.cursor = 'pointer';
				v.addEventListener('click', () => {
					const btn = card?.querySelector<HTMLButtonElement>('[data-ship-open]');
					btn?.click();
				});
			});
		}
	}
</script>

