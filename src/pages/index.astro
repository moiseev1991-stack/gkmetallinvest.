		font-size: 1.1rem;
		color: var(--color-accent);
		letter-spacing: 0.1em;
	}
	.ship-rating__text {
		font-size: 0.82rem;
		color: var(--color-muted);
	}
	.ship-slider {
		position: relative;
		padding: var(--space-4) 0 var(--space-6);
	}
	.ship-slider__btn {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 2;
		width: 48px;
		height: 48px;
		border-radius: 50%;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		box-shadow: var(--shadow-md);
		color: var(--color-primary-500);
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.ship-slider__btn:hover {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		transform: translateY(-50%) scale(1.05);
	}
	.ship-slider__btn--prev { left: -8px; }
	.ship-slider__btn--next { right: -8px; }
	@media (min-width: 1280px) {
		.ship-slider__btn--prev { left: -28px; }
		.ship-slider__btn--next { right: -28px; }
	}
	@media (max-width: 600px) {
		.ship-slider__btn { display: none; }
	}
	.ship-slider__track {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 62%;
		gap: var(--space-4);
		overflow-x: auto;
		overflow-y: hidden;
		scroll-padding: var(--space-4);
		padding: var(--space-2) var(--space-1) var(--space-4);
		scroll-behavior: smooth;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.ship-slider__track::-webkit-scrollbar {
		display: none;
	}
	@media (min-width: 600px) {
		.ship-slider__track { grid-auto-columns: 38%; }
	}
	@media (min-width: 900px) {
		.ship-slider__track { grid-auto-columns: 26%; }
	}
	@media (min-width: 1200px) {
		.ship-slider__track { grid-auto-columns: calc((100% - var(--space-4) * 4) / 5); }
	}
	.ship-card {
		scroll-snap-align: center;
		position: relative;
		display: block;
		aspect-ratio: 9 / 16;
		border-radius: 28px;
		overflow: hidden;
		background: #0a1f3d;
		box-shadow: 0 12px 28px -10px rgba(10, 31, 61, 0.3), 0 4px 10px -4px rgba(10, 31, 61, 0.2);
		transition: transform var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
	}
	.ship-card:hover {
		box-shadow: 0 20px 40px -12px rgba(10, 31, 61, 0.4), 0 8px 16px -6px rgba(10, 31, 61, 0.25);
		transform: translateY(-4px);
	}
	.ship-card__media {
		position: relative;
		width: 100%;
		height: 100%;
	}
	.ship-card__video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		background: #0a1f3d;
	}
	.ship-card__media::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(10, 31, 61, 0) 55%, rgba(10, 31, 61, 0.55) 100%);
		pointer-events: none;
	}
	.ship-card__tag {
		position: absolute;
		top: var(--space-3);
		left: var(--space-3);
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #fff;
		background: rgba(10, 31, 61, 0.65);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		z-index: 2;
	}
	.ship-card__btn {
		position: absolute;
		left: 50%;
		bottom: var(--space-4);
		transform: translateX(-50%);
		z-index: 3;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.65rem 1.2rem;
		border: 0;
		border-radius: var(--radius-pill);
		background: rgba(255, 255, 255, 0.92);
		color: var(--color-primary-600);
		font: inherit;
		font-weight: 600;
		font-size: 0.88rem;
		cursor: pointer;
		box-shadow: 0 6px 18px -4px rgba(10, 31, 61, 0.4);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		transition: all var(--dur-fast) var(--ease-out);
		white-space: nowrap;
	}
	.ship-card__btn:hover {
		background: #fff;
		transform: translateX(-50%) scale(1.04);
		color: var(--color-primary-500);
	}
	.ship-card__btn svg {
		flex-shrink: 0;
		margin-left: -2px;
	}
	.ship-card__caption {
		position: absolute;
		left: var(--space-3);
		right: var(--space-3);
		bottom: calc(var(--space-4) + 48px);
		margin: 0;
		color: #fff;
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.25;
		text-align: center;
		text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
		z-index: 2;
		pointer-events: none;
	}

	/* Video modal */
	.ship-modal {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: var(--space-4);
		animation: shipFadeIn 200ms var(--ease-out);
	}
	.ship-modal[hidden] { display: none; }
	.ship-modal__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(10, 31, 61, 0.85);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		cursor: pointer;
	}
	.ship-modal__inner {
		position: relative;
		width: min(440px, 100%);
		max-height: 92vh;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.ship-modal__video {
		width: 100%;
		max-height: 80vh;
		aspect-ratio: 9 / 16;
		object-fit: contain;
		background: #000;
		border-radius: 20px;
		box-shadow: 0 20px 60px -10px rgba(0, 0, 0, 0.6);
	}
	.ship-modal__title {
		margin: 0;
		text-align: center;
		color: #fff;
		font-size: 0.95rem;
		font-weight: 500;
	}
	.ship-modal__close {
		position: absolute;
		top: -44px;
		right: 0;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		border: 0;
		background: rgba(255, 255, 255, 0.15);
		color: #fff;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: background var(--dur-fast) var(--ease-out);
	}
	.ship-modal__close:hover {
		background: rgba(255, 255, 255, 0.28);
	}
	@keyframes shipFadeIn {
		from { opacity: 0; }
		to { opacity: 1; }
	}

	/* Solutions */
	.sol-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-3);
	}
	.sol-card {
		padding: var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		transition: all var(--dur-base) var(--ease-out);
	}
	.sol-card:hover {
		border-color: var(--color-primary-100);
		box-shadow: var(--shadow-md);
		transform: translateY(-2px);
	}
	.sol-card__icon {
		width: 68px;
		height: 68px;
		border-radius: 16px;
		background: var(--grad-cta);
		color: #fff;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10px 22px -8px rgba(196, 101, 27, 0.45), var(--shadow-sm);
		margin-bottom: var(--space-4);
	}
	.sol-card__icon svg {
		display: block;
	}
	.sol-card__num {
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: 700;
	}
	.sol-card__title {
		margin: 0;
		font-size: 1rem;
	}
	.sol-card__text {
		margin: 0;
		flex: 1;
		font-size: 0.85rem;
		color: var(--color-muted);
		line-height: 1.5;
	}
	.sol-card__cta {
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--color-accent);
		text-decoration: none;
	}
	.sol-card__cta:hover {
		color: var(--color-accent-600);
		text-decoration: underline;
	}

	/* Advantages with icons */
	.adv-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--space-3);
	}
	.adv-card {
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.adv-card {
		position: relative;
	}
	.adv-card__icon {
		width: 56px;
		height: 56px;
		border-radius: 14px;
		background: var(--color-accent-100);
		color: var(--color-accent);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin-bottom: var(--space-3);
	}
	.adv-card__num {
		position: absolute;
		top: var(--space-4);
		right: var(--space-4);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--color-accent);
		letter-spacing: 0.06em;
		opacity: 0.55;
	}
	.adv-card__title {
		margin: 0;
		font-size: 0.95rem;
	}
	.adv-card__text {
		margin: 0;
		font-size: 0.85rem;
		color: var(--color-muted);
		max-width: none;
		line-height: 1.5;
	}

	/* Catalog grid */
	.grid-cards {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: var(--space-3);
	}

	/* Popular */
	.pop-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--space-3);
	}
	.pop-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-4) var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		color: var(--color-text);
		font-weight: 600;
		font-size: 0.92rem;
		transition: all var(--dur-base) var(--ease-out);
	}
	.pop-card:hover {
		border-color: var(--color-primary-500);
		color: var(--color-primary-500);
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		transform: translateY(-1px);
	}
	.pop-card__arrow {
		color: var(--color-subtle);
		transition: transform var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out);
	}
	.pop-card:hover .pop-card__arrow {
		color: var(--color-primary-500);
		transform: translateX(3px);
	}

	/* Not found */
	.notfound {
		padding: var(--space-8) 0;
		background: linear-gradient(135deg, var(--color-primary-50) 0%, var(--color-accent-100) 100%);
		border-block: 1px solid var(--color-border);
	}
	.notfound__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		align-items: center;
	}
	@media (min-width: 768px) {
		.notfound__inner {
			grid-template-columns: 1.5fr 1fr;
		}
	}
	.notfound__h {
		margin: 0 0 var(--space-1);
		font-size: clamp(1.25rem, 2.4vw, 1.55rem);
		letter-spacing: -0.02em;
	}
	.notfound__text {
		margin: 0 0 var(--space-4);
		max-width: 48ch;
		color: var(--color-muted);
		font-size: 0.92rem;
	}
	.notfound__cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
	.notfound__visual img {
		width: 100%;
		max-width: 240px;
		height: auto;
		margin-left: auto;
		display: block;
	}

	/* Services */
	.svc-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: var(--space-3);
	}
	.svc-card {
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		display: flex;
		flex-direction: column;
		gap: 2px;
		transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
	}
	.svc-card:hover {
		border-color: var(--color-primary-100);
		box-shadow: var(--shadow-sm);
	}
	.svc-card__icon {
		width: 36px;
		height: 36px;
		border-radius: var(--radius-sm);
		background: var(--color-primary-50);
		color: var(--color-primary-500);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		margin-bottom: var(--space-2);
	}
	.svc-card__title {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.3;
	}
	.svc-card__title a {
		color: var(--color-text);
		text-decoration: none;
	}
	.svc-card__title a:hover {
		color: var(--color-primary-500);
	}
	.svc-card__text {
		margin: 0;
		flex: 1;
		font-size: 0.85rem;
		color: var(--color-muted);
		max-width: none;
		line-height: 1.5;
	}
	.svc-card__more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--color-primary-500);
		text-decoration: none;
	}
	.svc-card__more svg {
		transition: transform var(--dur-base) var(--ease-out);
	}
	.svc-card__more:hover svg {
		transform: translateX(3px);
	}

	/* Additional products */
	.addp-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
	}
	@media (min-width: 768px) {
		.addp-grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	.addp-card {
		display: grid;
		grid-template-columns: 1fr;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-xs);
		transition: all var(--dur-base) var(--ease-out);
	}
	.addp-card:hover {
		text-decoration: none;
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
		border-color: var(--color-primary-100);
	}
	.addp-card__media {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	.addp-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.4s var(--ease-out);
	}
	.addp-card:hover .addp-card__media img {
		transform: scale(1.04);
	}
	.addp-card__body {
		padding: var(--space-4);
	}
	.addp-card__title {
		margin: 0 0 var(--space-1);
		font-size: 1.05rem;
		color: var(--color-text);
	}
	.addp-card__sub {
		margin: 0 0 var(--space-2);
		color: var(--color-muted);
		font-size: 0.85rem;
	}
	.addp-card__bullets {
		margin: 0 0 var(--space-3);
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
		font-size: 0.82rem;
		color: var(--color-text);
	}
	.addp-card__bullets li::before {
		content: '— ';
		color: var(--color-accent);
		font-weight: 700;
	}
	.addp-card__more {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-primary-500);
	}

	/* Main CTA banner */
	.cta-banner {
		padding: var(--space-8) 0;
		background: linear-gradient(135deg, #11304f 0%, #0a1f3d 100%);
		color: var(--color-on-dark);
		position: relative;
		overflow: hidden;
	}
	.cta-banner__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		align-items: center;
	}
	@media (min-width: 768px) {
		.cta-banner__inner {
			grid-template-columns: 0.9fr 1.1fr;
		}
	}
	.cta-banner__media {
		aspect-ratio: 16 / 9;
		border-radius: var(--radius-md);
		overflow: hidden;
		border: 1px solid rgba(255, 255, 255, 0.1);
		box-shadow: var(--shadow-md);
	}
	.cta-banner__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.cta-banner__h {
		color: #fff;
		font-size: clamp(1.2rem, 2vw, 1.5rem);
		margin: 0 0 var(--space-2);
	}
	.cta-banner__text {
		color: var(--color-on-dark-muted);
		max-width: 52ch;
		margin: 0 0 var(--space-4);
		font-size: 0.9rem;
	}

	/* Trust dark */
	.trust {
		position: relative;
		padding: var(--space-10) 0;
		background: linear-gradient(180deg, #0a1f3d 0%, #11304f 100%);
		color: var(--color-on-dark);
		overflow: hidden;
	}
	.trust::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
		background-size: 28px 28px;
		mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
		-webkit-mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
	}
	.trust > .container {
		position: relative;
	}
	.trust__h {
		color: #fff;
		margin-bottom: var(--space-5);
	}
	.trust-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: var(--space-4);
	}
	.trust-card__stat {
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		background: linear-gradient(135deg, #f4a261 0%, #e76f51 100%);
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
		margin-bottom: var(--space-1);
	}
	.trust-card__text {
		margin: 0;
		font-size: 0.85rem;
		color: var(--color-on-dark-muted);
		max-width: none;
		line-height: 1.5;
	}

	/* Guarantees */
	.gd {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
	}
	@media (min-width: 768px) {
		.gd {
			grid-template-columns: 1fr 1fr;
		}
	}
	.gd__h {
		margin: 0 0 var(--space-4);
		font-size: 1.2rem;
	}
	.gd__list {
		margin: 0 0 var(--space-5);
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.gd__list li {
		display: flex;
		gap: var(--space-3);
		color: var(--color-text);
		font-size: 0.95rem;
		line-height: 1.55;
	}
	.gd__list svg {
		flex-shrink: 0;
		margin-top: 0.4rem;
		color: var(--color-success);
	}
	.gd__tk {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		align-items: center;
	}
	.gd__tk-item {
		padding: var(--space-2);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		background: var(--color-surface);
		display: flex;
		align-items: center;
	}
	.gd__tk-item img {
		max-height: 32px;
		width: auto;
	}

	/* About */
	.about__inner {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-8);
		align-items: center;
	}
	@media (min-width: 800px) {
		.about__inner {
			grid-template-columns: 1.2fr 0.8fr;
		}
	}
	.about__p {
