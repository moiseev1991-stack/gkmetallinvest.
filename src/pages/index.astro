---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/ui/Card.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { siteName, siteUrl, contacts, orgAddress } from '../data/site';
import {
	heroBullets,
	heroProducts,
	capabilities,
	catalogCategories,
	popularDirections,
	solutions,
	homeServices,
	shipments,
	advantageGroups,
	trustItems,
	guarantees,
	deliveryItems,
	deliveryPartners,
	additionalProducts,
	aboutTeaser,
	longDescription,
	longDescriptionCta,
	partnerLogos,
	mainCtaBanner,
	pricingStrip,
} from '../data/homepage';
import pricelist from '../data/pricelist.json';

const totalSkus = Object.values(pricelist.hubs as Record<string, Array<any>>)
	.reduce((s, arr) => s + arr.length, 0);
const totalGrades = new Set<string>();
for (const hub of Object.values(pricelist.hubs as Record<string, Array<any>>)) {
	for (const sku of hub) if (sku.grade) totalGrades.add(sku.grade);
}
// Format pricelist.updatedAt (YYYY-MM-DD) → DD.MM.YYYY for the hero pill
const priceUpdatedDisplay = (() => {
	const m = String(pricelist.updatedAt || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
	return m ? `${m[3]}.${m[2]}.${m[1]}` : String(pricelist.updatedAt || '');
})();

const PLACEHOLDER_PRODUCT = '/img/placeholder-product.svg';
const PLACEHOLDER_TEAM = '/img/team/team.jpg';
const PLACEHOLDER_ILLUSTRATION = '/img/illustrations/not-found.svg';
const PLACEHOLDER_BANNER = '/img/placeholder-cta-banner.svg';
const PLACEHOLDER_PARTNER = '/img/placeholder-partner.svg';
const PLACEHOLDER_TK = '/img/placeholder-tk-logo.svg';

/* Organization + LocalBusiness JSON-LD — даёт Яндексу/Google визитку компании
   с телефоном, адресом, лого и часами работы в Knowledge Panel. */
const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': `${siteUrl}/#organization`,
	name: siteName,
	legalName: contacts.company,
	url: siteUrl,
	logo: `${siteUrl}/img/logo.png`,
	telephone: contacts.phone,
	email: contacts.email,
	taxID: contacts.inn,
	address: { '@type': 'PostalAddress', ...orgAddress },
	areaServed: 'RU',
};
const localBusinessJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${siteUrl}/#localbusiness`,
	name: siteName,
	url: siteUrl,
	telephone: contacts.phone,
	email: contacts.email,
	priceRange: '₽₽',
	address: { '@type': 'PostalAddress', ...orgAddress },
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '18:00',
		},
	],
};
const websiteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${siteUrl}/#website`,
	url: siteUrl,
	name: siteName,
	inLanguage: 'ru-RU',
	publisher: { '@id': `${siteUrl}/#organization` },
};
---

<BaseLayout
	title={siteName}
	description="Нержавеющий металлопрокат: лист, труба, рулон, круг, лента, декоративные листы. Услуги резки, перфорации, доставка по России. ГК Металлинвест."
	jsonLd={[organizationJsonLd, localBusinessJsonLd, websiteJsonLd]}
>
	<!-- HERO -->
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero__grid">
			<div class="hero__copy">
				<span class="hero__pill">
					<span class="hero__pill-dot" aria-hidden="true"></span>
					Прайс обновлён {priceUpdatedDisplay} · {totalSkus.toLocaleString('ru')} позиций
				</span>
				<h1 id="hero-title" class="hero__h1">
					Нержавеющий <span class="hero__h1-accent">металлопрокат</span><br />
					поставки по всей России
				</h1>
				<p class="hero__lead">
					Лист, труба, рулон, круг, проволока. Подбор марки и формата, обработка на заказ — от одной тонны до объёмных партий.
				</p>
				<ul class="hero__bullets" aria-label="Ключевые офферы">
					{
						heroBullets.map((t) => (
							<li>
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
									<path d="M2 7.5l3 3 7-7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
								<span>{t}</span>
							</li>
						))
					}
				</ul>
				<div class="hero__cta">
					<Button href="/zapros-kp/" variant="accent" size="lg">Запросить цену</Button>
					<Button href="/#catalog" variant="on-dark" size="lg">Смотреть каталог</Button>
				</div>
				<div class="hero__metrics" aria-label="Ключевые показатели">
					<div class="hero__metric">
						<span class="hero__metric-num">{totalGrades.size}+</span>
						<span class="hero__metric-label">марок стали</span>
					</div>
					<div class="hero__metric-divider" aria-hidden="true"></div>
					<div class="hero__metric">
						<span class="hero__metric-num">{totalSkus.toLocaleString('ru')}</span>
						<span class="hero__metric-label">позиций в прайсе</span>
					</div>
					<div class="hero__metric-divider" aria-hidden="true"></div>
					<div class="hero__metric">
						<span class="hero__metric-num">2–3 дня</span>
						<span class="hero__metric-label">экспресс-доставка</span>
					</div>
				</div>
			</div>
			<div class="hero__visual" aria-label="Ключевые товары">
				<ul class="hero-cards">
					{
						heroProducts.map((p, i) => (
							<li class={`hero-cards__slot hero-cards__slot--${i === 0 ? 'main' : i === 1 ? 'top' : 'bottom'}`}>
								<a class="hero-card" href={p.href}>
									<div class="hero-card__media">
										<img
											src={p.image ?? PLACEHOLDER_PRODUCT}
											alt={p.alt ?? p.title}
											loading="eager"
											decoding="async"
											width="480"
											height="360"
										/>
									</div>
									<div class="hero-card__body">
										<span class="hero-card__title">{p.title}</span>
										<span class="hero-card__hint">{p.hint}</span>
									</div>
									<span class="hero-card__arrow" aria-hidden="true">
										<svg width="16" height="16" viewBox="0 0 14 14" fill="none">
											<path d="M3 7h8m0 0L7 3m4 4l-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<!-- SHIPMENTS SLIDER -->
	<section class="section section--alt" aria-labelledby="ship-title">
		<div class="container">
			<div class="section-head section-head--center">
				<h2 id="ship-title" class="section-title">Последние отгрузки</h2>
				<p class="section-sub">Реальные видео с нашего склада — упаковка, погрузка, отгрузка под контролем нашей команды</p>
				<div class="ship-rating" aria-label="Средняя оценка отгрузок">
					<span class="ship-rating__stars" aria-hidden="true">★★★★★</span>
					<span class="ship-rating__text">4.9 · по отзывам клиентов</span>
				</div>
			</div>
			<div class="ship-slider" data-ship-slider>
				<button type="button" class="ship-slider__btn ship-slider__btn--prev" data-ship-prev aria-label="Назад">
					<svg width="22" height="22" viewBox="0 0 20 20" fill="none"><path d="M12 4l-6 6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</button>
				<div class="ship-slider__track" data-ship-track>
					{
						[...shipments, ...shipments].map((s, i) => {
							const isClone = i >= shipments.length;
							return (
								<article
									class="ship-card"
									aria-hidden={isClone ? 'true' : undefined}
								>
									<div class="ship-card__media">
										<video
											class="ship-card__video"
											src={`${s.video}#t=0.5`}
											poster={s.poster}
											preload="metadata"
											muted
											playsinline
											aria-label={s.title}
										/>
										{s.tag && <span class="ship-card__tag">{s.tag}</span>}
										<button
											type="button"
											class="ship-card__btn"
											data-ship-open={s.video}
											data-ship-title={s.title}
											aria-label={`Смотреть видео: ${s.title}`}
											tabindex={isClone ? -1 : undefined}
										>
											<svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><path d="M3 1.5v11l9-5.5z" /></svg>
											<span>Смотреть видео</span>
										</button>
									</div>
									<h3 class="ship-card__caption">{s.title}</h3>
								</article>
							);
						})
					}
				</div>
				<button type="button" class="ship-slider__btn ship-slider__btn--next" data-ship-next aria-label="Вперёд">
					<svg width="22" height="22" viewBox="0 0 20 20" fill="none"><path d="M8 4l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</button>
			</div>
		</div>

		<!-- Modal -->
		<div class="ship-modal" data-ship-modal hidden>
			<div class="ship-modal__backdrop" data-ship-close></div>
			<div class="ship-modal__inner">
				<button type="button" class="ship-modal__close" data-ship-close aria-label="Закрыть">
					<svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
				</button>
				<video class="ship-modal__video" data-ship-video controls playsinline preload="metadata"></video>
				<p class="ship-modal__title" data-ship-modal-title></p>
			</div>
		</div>
	</section>

	<!-- PRODUCTION CAPABILITIES -->
	<section class="section" aria-labelledby="cap-title">
		<div class="container">
			<span class="eyebrow">Производство</span>
			<h2 id="cap-title" class="section-title">Возможности на собственной площадке</h2>
			<p class="section-sub">Реальные компетенции — что делаем на оборудовании. Без маркетинговой воды.</p>
			<div class="cap-grid">
				{
					capabilities.map((c, i) => (
						<article class="cap-card">
							<div class="cap-card__head">
								<span class="cap-card__icon" aria-hidden="true">
									<Icon name={c.icon} size={36} />
								</span>
								<span class="cap-card__num">{String(i + 1).padStart(2, '0')}</span>
							</div>
							<h3 class="cap-card__title">{c.title}</h3>
							<p class="cap-card__text">{c.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- SOLUTIONS — 3 icon cards -->
	<section class="section" aria-labelledby="sol-title">
		<div class="container">
			<span class="eyebrow">Подход</span>
			<h2 id="sol-title" class="section-title">Решаем под вашу задачу</h2>
			<div class="sol-grid">
				{
					solutions.map((s) => (
						<article class="sol-card">
							<div class="sol-card__icon" aria-hidden="true">
								<Icon name={s.icon ?? 'gear'} size={40} />
							</div>
							<h3 class="sol-card__title">{s.title}</h3>
							<p class="sol-card__text">{s.text}</p>
							{s.cta && (
								<a class="sol-card__cta" href={s.cta.href}>
									{s.cta.label} →
								</a>
							)}
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ADVANTAGES -->
	<section class="section section--alt" aria-labelledby="adv-title">
		<div class="container">
			<span class="eyebrow">Почему мы</span>
			<h2 id="adv-title" class="section-title">Преимущества работы с ГК Металлинвест</h2>
			<div class="adv-grid">
				{
					advantageGroups.map((a, i) => (
						<article class="adv-card">
							<div class="adv-card__icon" aria-hidden="true">
								<Icon name={a.icon ?? 'shield-check'} size={34} />
							</div>
							<span class="adv-card__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="adv-card__title">{a.title}</h3>
							<p class="adv-card__text">{a.text}</p>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- CATALOG -->
	<section class="section" id="catalog" aria-labelledby="cat-title">
		<div class="container">
			<div class="section-head">
				<div>
					<span class="eyebrow">Каталог</span>
					<h2 id="cat-title" class="section-title">Категории нержавеющего проката</h2>
				</div>
				<Button href="/postavka-nerzhaveyushchego-metalloprokata/" variant="ghost">Все категории →</Button>
			</div>
			<div class="grid-cards">
				{catalogCategories.map((c) => <Card href={c.href} title={c.title} description={c.description} image={c.image} imageAlt={c.alt} />)}
			</div>
		</div>
	</section>

	<!-- POPULAR -->
	<section class="section section--alt" aria-labelledby="pop-title">
		<div class="container">
			<span class="eyebrow">Спрос</span>
			<h2 id="pop-title" class="section-title">Популярные направления</h2>
			<div class="pop-grid">
				{
					popularDirections.map((p) => (
						<a class="pop-card" href={p.href}>
							<span class="pop-card__label">{p.label}</span>
							<svg class="pop-card__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- NOT FOUND -->
	<section class="notfound" aria-labelledby="nf-title">
		<div class="container notfound__inner">
			<div class="notfound__copy">
				<span class="eyebrow eyebrow--accent">Помощь подбора</span>
				<h2 id="nf-title" class="notfound__h">Не нашли нужный товар?</h2>
				<p class="notfound__text">
					У нас <strong>более 10 000 наименований</strong> — отправьте смету, проверим наличие и предложим аналоги.
				</p>
				<div class="notfound__cta">
					<Button href="/zapros-kp/#lead-form" variant="accent">Отправить смету</Button>
					<Button href="/zapros-kp/" variant="secondary">Запросить наличие</Button>
				</div>
			</div>
			<div class="notfound__visual" aria-hidden="true">
				<img src={PLACEHOLDER_ILLUSTRATION} alt="" width="320" height="220" loading="lazy" decoding="async" />
			</div>
		</div>
	</section>

	<!-- SERVICES -->
	<section class="section" aria-labelledby="svc-title">
		<div class="container">
			<span class="eyebrow">Услуги</span>
			<h2 id="svc-title" class="section-title">Обработка металла под задачу</h2>
			<p class="section-sub">Полный коммерческий блок услуг — режем, шлифуем, перфорируем, выравниваем плоскостность.</p>
			<div class="svc-grid">
				{
					homeServices.map((s, i) => (
						<article class="svc-card">
							<div class="svc-card__icon" aria-hidden="true">
								{s.icon ? <img src={s.icon} alt="" width="28" height="28" /> : <span>{String(i + 1).padStart(2, '0')}</span>}
							</div>
							<h3 class="svc-card__title">
								<a href={s.href}>{s.title}</a>
							</h3>
							<p class="svc-card__text">{s.text}</p>
							<a class="svc-card__more" href={s.href}>
								Подробнее
								<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
									<path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</a>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<!-- ADDITIONAL PRODUCTS — Provoloka + DECO -->
	<section class="section section--alt" aria-labelledby="addp-title">
		<div class="container">
			<span class="eyebrow">Отдельные категории</span>
			<h2 id="addp-title" class="section-title">Проволока и декоративные листы</h2>
			<div class="addp-grid">
				{
					additionalProducts.map((p) => (
						<a class="addp-card" href={p.href}>
							<div class="addp-card__media">
								<img src={p.image ?? PLACEHOLDER_BANNER} alt={p.title} loading="lazy" decoding="async" width="600" height="400" />
							</div>
							<div class="addp-card__body">
								<h3 class="addp-card__title">{p.title}</h3>
								<p class="addp-card__sub">{p.subtitle}</p>
								<ul class="addp-card__bullets">
									{p.bullets.map((b) => <li>{b}</li>)}
								</ul>
								<span class="addp-card__more">
									Смотреть раздел
									<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
										<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</span>
							</div>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- MAIN CTA BANNER (with image) -->
	<section class="cta-banner" aria-labelledby="cta-banner-title">
		<div class="container cta-banner__inner">
			<div class="cta-banner__media">
				<img src={mainCtaBanner.image ?? PLACEHOLDER_BANNER} alt="" loading="lazy" decoding="async" width="600" height="400" />
			</div>
			<div class="cta-banner__copy">
				<span class="eyebrow eyebrow--accent">{mainCtaBanner.eyebrow}</span>
				<h2 id="cta-banner-title" class="cta-banner__h">{mainCtaBanner.title}</h2>
				<p class="cta-banner__text">{mainCtaBanner.text}</p>
				<Button href={mainCtaBanner.cta.href} variant="accent" size="lg">{mainCtaBanner.cta.label}</Button>
			</div>
		</div>
	</section>

	<!-- TRUST (dark) -->
	<section class="trust" aria-labelledby="trust-title">
		<div class="container">
			<span class="eyebrow eyebrow--accent">Стандарты</span>
			<h2 id="trust-title" class="trust__h">Опыт, документы и стандарты</h2>
			<div class="trust-grid">
				{
					trustItems.map((t) => (
						<div class="trust-card">
							<div class="trust-card__stat">{t.stat}</div>
							<p class="trust-card__text">{t.text}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- GUARANTEES + DELIVERY -->
	<section class="section" aria-labelledby="gd-title">
		<div class="container">
			<div class="gd">
				<div class="gd__col">
					<span class="eyebrow">Гарантии</span>
					<h3 class="gd__h">Чёткие условия отгрузки</h3>
					<ul class="gd__list">
						{
							guarantees.map((g) => (
								<li>
									<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
										<path d="M2 7.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
									<span>{g}</span>
								</li>
							))
						}
					</ul>
				</div>
				<div class="gd__col">
					<span class="eyebrow">Доставка</span>
					<h3 class="gd__h">По России и СНГ</h3>
					<ul class="gd__list">
						{
							deliveryItems.map((g) => (
								<li>
									<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
										<path d="M2 7.5l3 3 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
									<span>{g}</span>
								</li>
							))
						}
					</ul>
					<div class="gd__tk" aria-label="Транспортные компании">
						{
							deliveryPartners.map((tk) => (
								<div class="gd__tk-item" title={tk.name}>
									<img src={tk.logo ?? PLACEHOLDER_TK} alt={tk.name} loading="lazy" decoding="async" width="100" height="40" />
								</div>
							))
						}
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- ABOUT -->
	<section class="section section--alt about" aria-labelledby="about-title">
		<div class="container about__inner">
			<div class="about__text">
				<span class="eyebrow">О компании</span>
				<h2 id="about-title" class="section-title">Наша команда и компания</h2>
				<p class="about__p">{aboutTeaser}</p>
				<p class="about__more">
					<a href="/o-kompanii/">Подробнее о компании →</a>
				</p>
			</div>
			<div class="about__visual">
