---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
---

<BaseLayout title="О компании" description="ГК Металлинвест — поставки нержавеющего металлопроката и услуги обработки.">
	<div class="container page">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'О компании' }]} />
		<h1>О компании</h1>
		<p class="lead">
			Работаем с металлообработкой, строительством, пищевой и химической отраслями. Контент расширяется по мере
			согласования с маркетингом.
		</p>
	</div>
</BaseLayout>

<style>
	.page {
		padding-block: var(--space-8);
	}
	.lead {
		max-width: 65ch;
	}
</style>
