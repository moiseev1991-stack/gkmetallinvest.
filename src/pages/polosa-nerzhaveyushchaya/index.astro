---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import { getHubSkus } from '../../data/pricelist-helpers';

const skus = getHubSkus('polosa');
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Чем штрипс отличается от полосы?',
		a: 'Штрипс — узкая холоднокатаная лента, её размеры и марки задаёт ГОСТ 4986-79 (раздел «Лента нержавеющая»). Полоса — сортовой прокат прямоугольного сечения: горячекатаная по ГОСТ 103-2006 (толщина 4–80 мм, ширина 10–200 мм) и кованая по ГОСТ 4405. Подробнее — в статье «Полоса нержавеющая: размеры, ГОСТ, вес и марки».',
	},
	{
		q: 'Чем горячекатаная полоса отличается от калиброванной?',
		a: 'Горячекатаная полоса (ГОСТ 103-2006) — допуски шире, обычно используется в металлоконструкциях. Калиброванная — точные размеры, чистая поверхность, поставляется по согласованным документам (ГОСТ 5949-2018, п. 6). Нужный вариант и состояние поверхности уточняйте в заявке.',
	},
	{
		q: 'Можно ли заказать резку полосы в размер?',
		a: 'Резка полосы в размер возможна по заявке. Длину, допуск и количество заготовок уточняйте у менеджера при расчёте.',
	},
	{
		q: 'Какие документы выдаются на полосу?',
		a: 'Сертификат завода-изготовителя (вид 3.1 по ГОСТ 7566-2018) с указанием марки, плавки, размеров и партии. Стандарт, по которому изготовлена партия, указан в сертификате.',
	},
	{
		q: 'Что лучше для трубных хомутов — AISI 304 или 316L?',
		a: 'Для агрессивных сред (морская, хлориды, кислоты) — AISI 316L. Для общих условий — AISI 304 (08Х18Н10), он дешевле и достаточен в большинстве задач.',
	},
];
---

<CatalogHubTemplate
	title="Полоса нержавеющая — AISI 304, 30Х13 — цена за тонну"
	description="Нержавеющая полоса AISI 304 (08Х18Н10) и 30Х13 из каталога в Нижнем Новгороде: толщина 3–10 мм, ширина 20–100 мм, цена за тонну с НДС. Другие марки — по запросу."
	h1="Полоса нержавеющая"
	intro={`Нержавеющая полоса — сортовой прокат прямоугольного сечения (ГОСТ 103-2006, ГОСТ 5949-2018) для металлоконструкций, фурнитуры, бандажей и крепежа. В каталоге — AISI 304 (08Х18Н10) и 30Х13; другие марки — по запросу. ${skus.length} позиций: толщина 3–10 мм, ширина 20–100 мм. Узкая холоднокатаная лента (штрипс) — в разделе «Лента нержавеющая».`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Полоса нержавеющая' }]}
	hubHref="/polosa-nerzhaveyushchaya/"
	hubLabel="Полоса нержавеющая"
	hubKey="polosa"
	faq={faq}
>
	<PriceTable hub="polosa" title="Прайс на полосу нержавеющую" measure="толщина" />

	<HubExtras
		hubHref="/polosa-nerzhaveyushchaya/"
		hubLabel="Полоса нержавеющая"
		hubLabelGenitive="полосу нержавеющую"
		articles={[
			{ href: '/blog/polosa-nerzhaveyushchaya/', label: 'Полоса нержавеющая: размеры, ГОСТ, вес и марки' },
			{ href: '/blog/lenta-nerzhaveyushchaya-marki-i-gost-4986-79/', label: 'Лента нержавеющая: марки и ГОСТ 4986-79 (чем отличается от полосы)' },
			{ href: '/blog/aisi-304-vs-316l-vs-321/', label: 'AISI 304, 316L или 321: какую марку выбрать' },
			{ href: '/blog/chem-rezat-nerzhaveyku/', label: 'Чем резать нержавейку' },
			{ href: '/blog/kak-varit-nerzhaveyku/', label: 'Как варить нержавейку' },
		]}
		grades={grades}
	/>

	<section class="block">
		<h2>Размеры полосы нержавеющей — толщины и ширины</h2>
		<p>
			В каталоге — полоса толщиной <strong>3, 4, 5, 6, 8 и 10 мм</strong>. По ГОСТ 103-2006
			сортамент начинается с 4 мм, позиции толщиной 3 мм поставляются по согласованным размерам.
			Состояние поверхности и вид (горячекатаная, калиброванная) указывайте в заявке.
		</p>
		<ul class="list-plain">
			<li>Ширины в каталоге: 20, 25, 30, 35, 40, 50, 60, 80, 100 мм</li>
			<li>Длина хлыста — уточняйте при заказе</li>
			<li>Резка в размер — по заявке</li>
		</ul>
		<p>
			Узкая холоднокатаная лента (штрипс) по ГОСТ 4986-79 — в разделе
			<a href="/lenta-nerzhaveyushchaya/">«Лента нержавеющая»</a>.
		</p>
	</section>

	<section class="block">
		<h2>Марки и применение полосы</h2>
		<p>В каталоге полосы сейчас AISI 304 и 30Х13. Марки AISI 321, 316L и 430 поставляем по запросу.</p>
		<ul class="list-plain">
			<li>
				<strong>AISI 304 (08Х18Н10)</strong> — универсальная марка для большинства задач:
				фасадные накладки, упорные элементы, защитные планки, общая металлоконструкция.
			</li>
			<li>
				<strong>AISI 321 (12Х18Н10Т)</strong> — для узлов с нагревом выше 450 °C: огнеупорные
				крепления, теплосетевая обвязка, фланцевые проставки. Титан связывает углерод
				в карбиды TiC и снимает риск МКК после сварки.
			</li>
			<li>
				<strong>AISI 316L (03Х17Н14М3)</strong> — для агрессивных сред с хлоридами:
				химические крепления, морская архитектура, фармацевтическое оборудование.
				Молибден повышает питтинговую стойкость.
			</li>
			<li>
				<strong>AISI 430 (12Х17)</strong> — экономичная ферритная для интерьера и сухих
				условий: декоративная фурнитура, мебельная окантовка, корпуса бытовой техники.
			</li>
		</ul>
		<p>
			Полоса из нержавейки работает как крепёжный элемент металлоконструкций, заготовка
			под профилирование, фланцевая проставка, обвязка ёмкостей и резервуаров. В
			электротехнике узкая полоса AISI 304 редко идёт на шинопроводы — там, где важна
			коррозионная стойкость контактного узла.
		</p>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода-изготовителя (вид 3.1 по ГОСТ 7566-2018)</li>
			<li>Резка в размер по заявке</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Доставка по России — авто, ж/д, ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
</style>
