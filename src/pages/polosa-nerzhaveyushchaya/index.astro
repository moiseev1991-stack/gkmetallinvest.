---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import { getHubSkus } from '../../data/pricelist-helpers';

const skus = getHubSkus('polosa');
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Чем штрипс отличается от полосы?',
		a: 'Штрипс — узкая холоднокатаная лента шириной 4–50 мм по ГОСТ 4986, идёт сырьём на электросварные трубы и пружинные элементы. Полоса — общий термин для узкого листового проката: горячекатаная по ГОСТ 103 и холоднокатаная по ГОСТ 503, ширина до 200–300 мм, толщина 1–50 мм.',
	},
	{
		q: 'Чем горячекатаная полоса отличается от калиброванной?',
		a: 'Горячекатаная полоса (ГОСТ 103) — поверхность с окалиной, допуски шире, обычно используется в металлоконструкциях. Калиброванная (холоднотянутая) — точные размеры, чистая поверхность, идёт под лицевую отделку и фурнитуру.',
	},
	{
		q: 'Можно ли заказать резку полосы в размер?',
		a: 'Да, режем гильотиной или дисковой пилой в размер от 1 заготовки с точностью ±1 мм. Возможна торцовка и снятие заусенцев.',
	},
	{
		q: 'Какие документы выдаются на полосу?',
		a: 'Сертификат завода по ГОСТ 103 или EN 10058 с указанием марки, плавки, размеров и партии. Маркировка партии бирками на упаковке.',
	},
	{
		q: 'Что лучше для трубных хомутов — AISI 304 или 316L?',
		a: 'Для агрессивных сред (морская, хлориды, кислоты) — AISI 316L. Для общих условий — AISI 304 (08Х18Н10), он дешевле и достаточен в большинстве задач.',
	},
];
---

<CatalogHubTemplate
	title="Полоса нержавеющая ГК и ХК — AISI 304, 321, 430 — цена за тонну"
	description="Нержавеющая полоса и штрипс со склада в Нижнем Новгороде: ГК ГОСТ 103, ХК ГОСТ 4986/503. Толщины 1–50 мм, ширины 4–300 мм. AISI 304, 316L, 321, 430."
	h1="Полоса нержавеющая"
	intro={`Нержавеющая полоса горячекатаная (ГОСТ 103) и холоднокатаная (ГОСТ 4986, 503), включая штрипс под электросварные трубы. Полоса из нержавейки AISI 304, 316L, 321 и AISI 430 для металлоконструкций, фурнитуры, бандажей и крепежа. ${skus.length} типоразмеров в наличии: толщина 1–50 мм, ширина 4–300 мм.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Полоса нержавеющая' }]}
	hubHref="/polosa-nerzhaveyushchaya/"
	hubLabel="Полоса нержавеющая"
	hubKey="polosa"
	faq={faq}
>
	<PriceTable hub="polosa" title="Прайс на полосу нержавеющую" measure="толщина" />

	<HubExtras
		hubHref="/polosa-nerzhaveyushchaya/"
		hubLabel="Полоса нержавеющая"
		hubLabelGenitive="полосу нержавеющую"
		grades={grades}
	/>

	<section class="block">
		<h2>Размеры полосы нержавеющей — толщины и ширины</h2>
		<p>
			Горячекатаная полоса (ГК) по ГОСТ 103 идёт для сорта и металлоконструкций — толщины
			<strong>4, 5, 6, 8, 10, 12, 16, 20, 25 мм</strong> и выше. Поверхность с окалиной, допуски шире.
			Холоднокатаная полоса (ХК) — толщины <strong>1, 1,5, 2, 3, 4 мм</strong>, идёт под упругие
			ленты, пружинные задачи и лицевую отделку, где нужна чистая поверхность.
		</p>
		<ul class="list-plain">
			<li>Ширины: 20, 25, 30, 40, 50, 60, 80, 100, 120, 150, 200 мм</li>
			<li>Длины: 6 м стандарт, мерные нарезы под заказ от 1 заготовки</li>
			<li>Резка гильотиной или дисковой пилой ±1 мм</li>
		</ul>
		<p>
			Штрипс нержавеющий — узкая холоднокатаная полоса шириной <strong>4–50 мм</strong> по
			ГОСТ 4986 и ГОСТ 503. Идёт сырьём на электросварные трубы и пружинные элементы:
			стабильная толщина по длине рулона, кромка под сварочный шов. По запросу подбираем
			штрипс под конкретный диаметр трубы и стенку.
		</p>
	</section>

	<section class="block">
		<h2>Марки и применение полосы</h2>
		<ul class="list-plain">
			<li>
				<strong>AISI 304 (08Х18Н10)</strong> — универсальная марка для большинства задач:
				фасадные накладки, упорные элементы, защитные планки, общая металлоконструкция.
			</li>
			<li>
				<strong>AISI 321 (12Х18Н10Т)</strong> — для узлов с нагревом выше 450 °C: огнеупорные
				крепления, теплосетевая обвязка, фланцевые проставки. Титан связывает углерод
				в карбиды TiC и снимает риск МКК после сварки.
			</li>
			<li>
				<strong>AISI 316L (03Х17Н14М2)</strong> — для агрессивных сред с хлоридами:
				химические крепления, морская архитектура, фармацевтическое оборудование.
				Молибден повышает питтинговую стойкость.
			</li>
			<li>
				<strong>AISI 430 (08Х17)</strong> — экономичная ферритная для интерьера и сухих
				условий: декоративная фурнитура, мебельная окантовка, корпуса бытовой техники.
			</li>
		</ul>
		<p>
			Полоса из нержавейки работает как крепёжный элемент металлоконструкций, заготовка
			под профилирование, фланцевая проставка, обвязка ёмкостей и резервуаров. В
			электротехнике узкая полоса AISI 304 редко идёт на шинопроводы — там, где важна
			коррозионная стойкость контактного узла.
		</p>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода-изготовителя — ГОСТ 103 / EN 10058</li>
			<li>Резка в размер по заявке</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Доставка по России — авто, ж/д, ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
</style>
