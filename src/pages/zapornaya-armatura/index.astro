---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import ArmaturaLineCards from '../../components/ArmaturaLineCards.astro';
import HubRequest from '../../components/HubRequest.astro';
import { getArmaturaHub } from '../../data/armatura';

const hub = getArmaturaHub('zapornaya-armatura')!;
---

<CatalogHubTemplate
	title={hub.title}
	description={hub.description}
	h1={hub.h1}
	intro={hub.intro}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Запорная арматура' }]}
	faq={hub.faq}
>
	<ArmaturaLineCards hub={hub} />
	<HubRequest what="Запорная арматура: краны, задвижки, затворы, фильтры" />
</CatalogHubTemplate>
