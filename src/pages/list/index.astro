---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any).list as any[];
const totalSkus = skus.length;

/* Уникальные марки и поверхности, для плашек ниже PriceTable. */
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));
const surfaces = [...new Set(skus.map((s) => s.surface).filter(Boolean))] as string[];
surfaces.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Сколько стоит лист нержавеющий за тонну?',
		a: 'Цена зависит от марки, толщины и поверхности. AISI 304 (08Х18Н10) толщиной 1–3 мм — от 240 000 ₽/т с НДС, AISI 316L — от 380 000 ₽/т. Точную цену уточняйте у менеджера или смотрите в прайс-листе выше — он обновляется ежедневно.',
	},
	{
		q: 'В чём разница между AISI 304 и AISI 321?',
		a: 'AISI 304 (08Х18Н10) — универсальная аустенитная марка для большинства пищевых, архитектурных и общих задач. AISI 321 (12Х18Н10Т) стабилизирована титаном — выдерживает температуры до 800 °C без межкристаллитной коррозии. Если будут сварка + нагрев > 450 °C — берите 321.',
	},
	{
		q: 'Что значит 2B, BA, 4N — какие бывают поверхности листа?',
		a: '2B — матовая, базовая поверхность холоднокатаного листа. BA («зеркальная») — отжиг в защитной атмосфере, гладкая полированная. 4N — шлифование шкуркой с зернистостью 180–240, направленная сатиновая поверхность. Для декоративных задач берут BA или 4N с защитной плёнкой PI.',
	},
	{
		q: 'Минимальная партия отгрузки — есть ли розница?',
		a: 'Отгружаем от 0,1 т по розничной цене и от 1 т по оптовой. Резка в размер — от одного листа. Возможно комплектование одной отправкой нескольких марок и толщин.',
	},
	{
		q: 'Какие документы предоставляются на партию?',
		a: 'На каждую партию — сертификат завода-изготовителя и паспорт качества. По запросу копии в PDF/ЭДО до отгрузки, оригиналы вкладываем в груз или направляем курьером. Поддерживаем требования тендеров и госзакупок.',
	},
	{
		q: 'Доставка в Москву / СПб / регионы — какие сроки и способы?',
		a: 'Москва — 1–2 дня, СПб — 2–3 дня, Урал — 3–4 дня, Сибирь — 5–7 дней. Возим автотранспортом, ж/д контейнерами и через ТК (Деловые линии, ПЭК, СДЭК). Москва и Казань — попутный транспорт и собственные машины с ежедневной отгрузкой.',
	},
	{
		q: 'Можно ли заказать резку, перфорацию или полировку?',
		a: 'Да. Гильотинная и плазменная резка в размер до 12 м с точностью ±1 мм, перфорация по чертежу (круглая, щелевая, фигурная), полировка до зеркала Ra ≤ 0,4 мкм. Услуги добавляются в счёт отдельной строкой.',
	},
];
---

<CatalogHubTemplate
	title="Лист нержавеющий — купить в Нижнем Новгороде, цена за тонну с НДС"
	description="Лист нержавеющий AISI 304, 316L, 321, 430, 12Х18Н10Т. Холоднокатаный 0,4–4 мм, горячекатаный 5–60 мм, дуплекс, ПВЛ, профнастил. Резка в размер, доставка по России."
	h1="Лист нержавеющий"
	intro={`Холоднокатаный лист 0,4–4 мм с поверхностями 2B, BA, 4N и горячекатаный 5–60 мм со склада в Нижнем Новгороде. Никелесодержащие марки AISI 304, 316L, 321, безникелевые 430, 410S, дуплекс. В прайсе ниже — ${totalSkus} позиций с ценой за тонну (с НДС, наценка 5%) и розницей до 0,1 т.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Лист нержавеющий' }]}
	hubHref="/list/"
	hubLabel="Лист нержавеющий"
	hubKey="list"
	faq={faq}
>
	<PriceTable hub="list" title="Прайс на лист нержавеющий" measure="толщина" />

	<HubExtras
		hubHref="/list/"
		hubLabel="Лист нержавеющий"
		hubLabelGenitive="лист нержавеющий"
		grades={grades}
		surfaces={surfaces}
	/>

	<section class="block">
		<h2>Что входит в раздел</h2>
		<ul class="list-plain">
			<li><strong>Холоднокатаный (х/к)</strong> — толщина 0,4–4 мм, поверхность 2B, BA (зеркальная), 4N (шлифованная), DECO+PE с защитной плёнкой</li>
			<li><strong>Горячекатаный (г/к)</strong> — толщина 5–60 мм, листы по ГОСТ 19903 и стандартам AISI</li>
			<li><strong>Без никеля</strong> — ферритные AISI 430, 410S, 439 — для бытовых задач, кухонной техники, отделки</li>
			<li><strong>Дуплекс</strong> — двухфазная сталь с повышенной коррозионной стойкостью для морских и химических сред</li>
			<li><strong>ПВЛ (просечно-вытяжной)</strong> — для лестниц, площадок, защитных экранов</li>
			<li><strong>Профнастил</strong> — С8, С20 для кровли и вентилируемых фасадов</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Пищевая промышленность и фармацевтика — оборудование, ёмкости, трубопроводы (AISI 304, 316L)</li>
			<li>Архитектура и интерьер — фасады, перила, мебель (BA, 4N с плёнкой)</li>
			<li>Химия и нефтегаз — реакторы, теплообменники (AISI 316L, 321, дуплекс)</li>
			<li>Морские конструкции — палубное оборудование, корпуса (AISI 316L, 904L)</li>
			<li>Энергетика — паропроводы, котельное оборудование (AISI 321 / 12Х18Н10Т)</li>
		</ul>
	</section>

	<section class="block">
		<h2>Обработка под заявку</h2>
		<p>
			<a href="/uslugi/rezka-rulonov/">Гильотинная и плазменная резка</a> в размер до 12 м,
			<a href="/uslugi/perforaciya-listov/">перфорация</a> по чертежу,
			<a href="/uslugi/polirovka/">полировка и шлифование</a> до зеркального блеска.
			Резка от 1 листа, перфорация — от пробной партии.
		</p>
		<p>
			Рулон выделен в <a href="/rulon/">отдельную категорию</a> — там толщины и ширины с шагом
			500 мм для собственного раскроя.
		</p>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат качества завода-изготовителя на каждую партию</li>
			<li>Маркировка по ГОСТ 7566 и AISI / EN 10088</li>
			<li>Отгрузка со склада в Нижнем Новгороде в день оплаты</li>
			<li>Доставка автотранспортом, ж/д контейнерами, ТК — по всей России и СНГ</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
	.block p a { color: var(--color-primary-600); }

	.grade-grid {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		padding: 0;
		margin: var(--space-3) 0 0;
	}
	.grade-chip {
		display: inline-block;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.35rem 0.75rem;
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-text);
	}
	.grade-chip--accent {
		background: var(--color-primary-50);
		border-color: var(--color-primary-100);
		color: var(--color-primary-600);
	}

	.city-grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: var(--space-2);
		padding: 0;
		margin: var(--space-3) 0 0;
	}
	.city-chip {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: var(--space-2) var(--space-3);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out);
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.city-chip:hover {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		color: var(--color-primary-600);
		text-decoration: none;
	}
	.city-chip__sub {
		font-size: 0.74rem;
		color: var(--color-muted);
	}
	.city-chip:hover .city-chip__sub {
		color: var(--color-primary-500);
	}
</style>
