---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import { getHubSkus } from '../../data/pricelist-helpers';

const skus = getHubSkus('lenta');
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Чем лента отличается от штрипса и фольги?',
		a: 'Это узкий холоднокатаный прокат по ГОСТ 4986, разница только в толщине. Фольга — до 0,15 мм, лента (штрипс) — 0,15–0,8 мм и толще. Мы держим ленту толщиной 0,15–0,8 мм шириной 200 и 400 мм. Более тонкий прокат смотрите в разделе «Фольга».',
	},
	{
		q: 'Какие ширины ленты есть в наличии?',
		a: 'Стандартные ширины склада — 200 и 400 мм. Другие ширины (шаг 5 мм) получаем продольной резкой рулона под заявку от одного мотка.',
	},
	{
		q: 'Из каких марок бывает нержавеющая лента?',
		a: `В наличии ${grades.length} марок: аустенитные 12Х18Н10Т (AISI 321), 08Х18Н10 (AISI 304), 03Х17Н14М3 (AISI 316L), 12Х15Г9НД (AISI 201); ферритные и мартенситные 08Х17 (AISI 430), 20Х13 (AISI 420), 08Х13 (AISI 409); жаропрочные 20Х23Н18 (AISI 310) и другие. Полный список — в фильтре прайса по марке.`,
	},
	{
		q: 'Какая поверхность у ленты?',
		a: '2B (матовая), BA (зеркальная, с защитной плёнкой), 2BA (светлый отжиг), 4N (шлифованная) и PE (с защитной плёнкой). Поверхность выбирается в фильтре прайса.',
	},
	{
		q: 'Можно ли заказать резку ленты в размер по длине?',
		a: 'Да, режем мерными отрезами или отгружаем мотком. Минимальная партия — от одного мотка, рулон режем продольно под нужную ширину.',
	},
];
---

<CatalogHubTemplate
	title="Лента нержавеющая х/к — 200 и 400 мм, 0,15–0,8 мм — цена за тонну"
	description={`Нержавеющая лента (штрипс) х/к по ГОСТ 4986: толщина 0,15–0,8 мм, ширина 200 и 400 мм, ${grades.length} марок — AISI 304, 321, 316L, 430, 201, 310. Поверхности 2B, BA, 4N. Со склада в Нижнем Новгороде.`}
	h1="Лента нержавеющая"
	intro={`Лента нержавеющая холоднокатаная (штрипс) по ГОСТ 4986 — узкий прокат толщиной 0,15–0,8 мм, ширина 200 и 400 мм. ${grades.length} марок: аустенитные AISI 304, 321, 316L, ферритные AISI 430, 409, мартенситные AISI 420, жаропрочные AISI 310. ${skus.length} типоразмеров в наличии, продольная резка рулона под заявку.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Лента нержавеющая' }]}
	hubHref="/lenta/"
	hubLabel="Лента нержавеющая"
	hubKey="lenta"
	faq={faq}
>
	<PriceTable hub="lenta" title="Прайс на ленту нержавеющую" measure="толщина" />

	<HubExtras
		hubHref="/lenta/"
		hubLabel="Лента нержавеющая"
		hubLabelGenitive="ленту нержавеющую"
		grades={grades}
	/>

	<section class="block">
		<h2>Размеры ленты нержавеющей — толщины и ширины</h2>
		<p>
			Лента — узкий холоднокатаный прокат, который получают продольной резкой рулона.
			В наличии две стандартные ширины — <strong>200 и 400 мм</strong>, толщины
			<strong>0,15 — 0,8 мм</strong>. Более тонкий прокат (0,05–0,15 мм) — это
			<a href="/folga/">нержавеющая фольга</a>, более толстый и широкий — рулон и лист.
		</p>
		<ul class="list-plain">
			<li>Ширины: 200 и 400 мм (нестандартные — под заявку, шаг 5 мм)</li>
			<li>Толщины: 0,15; 0,2; 0,25; 0,3; 0,4; 0,5; 0,6; 0,7; 0,8 мм</li>
			<li>Поверхности: 2B (матовая), BA (зеркальная), 2BA, 4N, PE (с плёнкой)</li>
			<li>ГОСТ 4986 — лента холоднокатаная из коррозионностойкой стали</li>
			<li>Резка мерными отрезами или мотком, от одной единицы</li>
		</ul>
		<p class="note">
			Подробнее о технологии — на странице
			<a href="/lenta/proizvodstvo/">производство ленты и штрипса</a>.
		</p>
	</section>

	<section class="block">
		<h2>Марки и применение ленты</h2>
		<ul class="list-plain">
			<li>
				<strong>AISI 304 (08Х18Н10)</strong> — универсальная аустенитная марка:
				хомуты, бандажи, упругие элементы, обшивка и защитные планки.
			</li>
			<li>
				<strong>AISI 321 (12Х18Н10Т)</strong> — для узлов с нагревом выше 450 °C:
				компенсаторы, сильфоны, огнеупорная обвязка. Титан снимает риск МКК после сварки.
			</li>
			<li>
				<strong>AISI 316L (03Х17Н14М3)</strong> — для агрессивных сред с хлоридами:
				химическое и фармацевтическое оборудование, морская архитектура. Молибден
				повышает питтинговую стойкость.
			</li>
			<li>
				<strong>AISI 430 (08Х17)</strong> — экономичная ферритная для сухих условий:
				декоративная окантовка, корпуса техники, мебельная фурнитура.
			</li>
			<li>
				<strong>AISI 420 (20Х13)</strong> — мартенситная под закалку: пружины,
				ножевые и упругие элементы, где нужна твёрдость.
			</li>
		</ul>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода-изготовителя по ГОСТ 4986</li>
			<li>Продольная резка рулона под нужную ширину</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Доставка по России — авто, ж/д, ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.note { font-size: 0.92rem; color: var(--color-muted); max-width: 70ch; }
	.note a, .block a { color: var(--color-primary-600); }
</style>
