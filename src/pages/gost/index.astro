---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { gosts, gostCategories, gostSlug } from '../../data/gosts';

const title = 'ГОСТы на металлопрокат — справочник 112 стандартов в 6 категориях';
const description = 'Полный справочник ГОСТов на металлопрокат: 112 действующих стандартов в шести категориях. Прямые ссылки на PDF, отдельная страница на каждый ГОСТ.';

const grouped = gostCategories.map((c) => ({
	...c,
	items: gosts
		.filter((g) => g.cat === c.value)
		.sort((a, b) => a.num.localeCompare(b.num, 'ru', { numeric: true })),
}));

const totalGosts = gosts.length;

// Якорь первой категории — на него скроллит «активный» индикатор по умолчанию.
const firstCat = gostCategories[0].value;
---

<BaseLayout title={title} description={description}>
	<div class="container gost-idx">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'ГОСТы — справочник' }]} />

		<header class="gost-idx__hero">
			<span class="gost-idx__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<rect x="2" y="2" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4" />
					<path d="M5 6h6M5 9h6M5 12h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
				Справочник
			</span>
			<h1 class="gost-idx__h1">ГОСТы на металлопрокат</h1>
			<p class="gost-idx__lead">
				Полный перечень <strong>{totalGosts} действующих ГОСТов</strong> в шести категориях:
				качественный прокат, листовой, сортовой, трубный, трубопроводная арматура и цветные
				металлы. По каждому стандарту — отдельная страница со ссылкой на PDF
				и привязкой к разделу нашего каталога.
			</p>
		</header>

		<div class="gost-idx__layout">
			<aside class="gost-idx__side">
				<div class="gost-idx__search">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" />
						<path d="M14 14l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
					</svg>
					<input
						type="search"
						placeholder="Поиск по ГОСТам"
						data-gost-search
						aria-label="Поиск по номеру или названию ГОСТа"
					/>
				</div>

				<nav class="gost-idx__nav" aria-label="Категории">
					<ul>
						{grouped.map((g, i) => (
							<li>
								<a
									href={`#cat-${g.value}`}
									data-cat-link={g.value}
									class={i === 0 ? 'is-active' : ''}
								>
									<span class="gost-idx__nav-label">{g.label}</span>
									<span class="gost-idx__nav-count">{g.items.length}</span>
								</a>
							</li>
						))}
					</ul>
				</nav>

				<div class="gost-idx__nerzh">
					<div class="gost-idx__nerzh-title">Нержавейка — детальный разбор</div>
					<ul>
						<li><a href="#nerzh-list">Лист — 5582, 7350, 19903</a></li>
						<li><a href="#nerzh-truba">Труба — 9941, 9940, 11068</a></li>
						<li><a href="#nerzh-sort">Сорт — 5949</a></li>
						<li><a href="#nerzh-marki">Марки — 5632</a></li>
					</ul>
				</div>
			</aside>

			<main class="gost-idx__main" data-gost-main>
				<p class="gost-idx__empty" data-gost-empty hidden>
					По вашему запросу ничего не найдено. Очистите поиск или попробуйте другой ключ.
				</p>

				{grouped.map((g) => (
					<section class="gost-idx__cat" id={`cat-${g.value}`} data-cat={g.value}>
						<header class="gost-idx__cat-head">
							<h2 class="gost-idx__cat-title">{g.label}</h2>
							<span class="gost-idx__cat-count">{g.items.length} ГОСТов</span>
						</header>
						<p class="gost-idx__cat-descr">{g.descr}</p>

						<ol class="gost-idx__list">
							{g.items.map((item, idx) => (
								<li
									class="gost-idx__row"
									data-gost-row
									data-num={item.num.toLowerCase()}
									data-title={item.title.toLowerCase()}
								>
									<span class="gost-idx__row-idx">{idx + 1}.</span>
									<a class="gost-idx__row-link" href={`/gost/${gostSlug(item.num)}/`}>
										<span class="gost-idx__row-num">ГОСТ {item.num}</span>
										<span class="gost-idx__row-title">{item.title}</span>
									</a>
									{item.priority === 'core' && (
										<span class="gost-idx__row-badge" title="ГОСТ нашей нержавеющей тематики">●</span>
									)}
								</li>
							))}
						</ol>
					</section>
				))}

				<section class="gost-idx__nerzh-section" id="nerzh-detail">
					<header class="gost-idx__cat-head">
						<h2 class="gost-idx__cat-title">Детальный разбор — нержавеющий металлопрокат</h2>
						<span class="gost-idx__cat-count">5 ГОСТов</span>
					</header>
					<p class="gost-idx__cat-descr">
						По этим стандартам поставляется основная часть нашего ассортимента. Под каждым ГОСТом —
						какие марки попадают, типовые размеры и в каком разделе каталога искать прокат.
					</p>

					<div class="gost-idx__nerzh-grid">
						<a class="gost-idx__nerzh-card" href={`/gost/${gostSlug('5582-75')}/`} id="nerzh-list">
							<strong>ГОСТ 5582-75 / 7350-77 / 19903-2015</strong>
							<small>Нержавеющий лист: тонкий до 4 мм, толстый 4–50 мм, сортамент. AISI 304, 316L, 321, 430.</small>
						</a>
						<a class="gost-idx__nerzh-card" href={`/gost/${gostSlug('9941-81')}/`} id="nerzh-truba">
							<strong>ГОСТ 9941-81 / 9940-81 / 11068-81</strong>
							<small>Трубы нержавеющие: бесшовные холодно- и горячедеформированные, электросварные. Ø 5–325 мм.</small>
						</a>
						<a class="gost-idx__nerzh-card" href={`/gost/${gostSlug('8509-93')}/`} id="nerzh-sort">
							<strong>ГОСТ 8509-93 / 8510-86</strong>
							<small>Уголки горячекатаные равнополочные и неравнополочные — сортамент, размерные ряды.</small>
						</a>
						<a class="gost-idx__nerzh-card" href={`/gost/${gostSlug('5632-72')}/`} id="nerzh-marki">
							<strong>ГОСТ 5632-72</strong>
							<small>Базовый стандарт состава нержавеющих сталей: 200+ марок коррозионно-стойких и жаропрочных.</small>
						</a>
					</div>
				</section>

				<section class="gost-idx__legal">
					<p>
						PDF-копии стандартов размещены в справочных целях. Тексты ГОСТов охраняются
						авторским правом ФГБУ «Стандартинформ» — для официального применения
						используйте платные сервисы «Кодекс», «Техэксперт» или приобретайте
						копии у Стандартинформа.
					</p>
				</section>
			</main>
		</div>
	</div>

	<CtaSection
		title="Не нашли нужный ГОСТ или марку?"
		text="Менеджер пришлёт точные позиции с сертификатами под ваш ГОСТ и марку — в течение 30 минут."
	/>
</BaseLayout>

<script>
	const search = document.querySelector('[data-gost-search]') as HTMLInputElement | null;
	const empty = document.querySelector('[data-gost-empty]') as HTMLElement | null;
	const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-gost-row]'));
	const cats = Array.from(document.querySelectorAll<HTMLElement>('[data-cat]'));
	const links = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-link]'));

	function applySearch() {
		const q = (search?.value || '').toLowerCase().trim();
		let visible = 0;
		for (const row of rows) {
			const match =
				!q ||
				(row.dataset.num || '').includes(q) ||
				(row.dataset.title || '').includes(q);
			row.hidden = !match;
			if (match) visible++;
		}
		for (const cat of cats) {
			const hasVisible = Array.from(cat.querySelectorAll<HTMLElement>('[data-gost-row]'))
				.some((r) => !r.hidden);
			cat.hidden = !hasVisible;
		}
		if (empty) empty.hidden = visible > 0;
	}

	search?.addEventListener('input', applySearch);

	// Подсветка активной категории при скролле через IntersectionObserver.
	if ('IntersectionObserver' in window) {
		const headerH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--header-h') || '64', 10);
		const obs = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (e.isIntersecting) {
						const cat = (e.target as HTMLElement).dataset.cat;
						for (const link of links) {
							link.classList.toggle('is-active', link.dataset.catLink === cat);
						}
					}
				}
			},
			{ rootMargin: `-${headerH + 40}px 0px -60% 0px`, threshold: 0 }
		);
		for (const cat of cats) obs.observe(cat);
	}
</script>

<style>
	.gost-idx { padding-block: var(--space-8); min-width: 0; }
	.gost-idx__hero { margin-bottom: var(--space-7); max-width: 80ch; }
	.gost-idx__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		margin-bottom: var(--space-3);
	}
	.gost-idx__h1 {
		font-size: clamp(1.7rem, 3.5vw, 2.5rem);
		line-height: 1.15;
		letter-spacing: -0.02em;
		margin: 0 0 var(--space-3);
	}
	.gost-idx__lead { font-size: 1.05rem; line-height: 1.6; max-width: 75ch; color: var(--color-text); margin: 0; }

	/* Двухколоночный макет */
	.gost-idx__layout {
		display: grid;
		grid-template-columns: minmax(0, 280px) minmax(0, 1fr);
		gap: var(--space-6);
		align-items: start;
	}
	@media (max-width: 880px) {
		.gost-idx__layout { grid-template-columns: 1fr; gap: var(--space-4); }
	}

	/* Боковая колонка */
	.gost-idx__side {
		position: sticky;
		top: calc(var(--header-h, 64px) + 1rem);
		display: grid;
		gap: var(--space-3);
	}
	@media (max-width: 880px) { .gost-idx__side { position: static; } }

	.gost-idx__search {
		position: relative;
		display: flex;
		align-items: center;
	}
	.gost-idx__search svg {
		position: absolute;
		left: 0.85rem;
		color: var(--color-muted);
		pointer-events: none;
	}
	.gost-idx__search input {
		font: inherit;
		font-size: 0.92rem;
		padding: 0.6rem 0.8rem 0.6rem 2.4rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: #ffffff;
		color: var(--color-text);
		outline: none;
		width: 100%;
		transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.gost-idx__search input:focus {
		border-color: var(--color-primary-500);
		box-shadow: 0 0 0 3px var(--color-primary-100);
	}

	.gost-idx__nav {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: 0.4rem;
	}
	.gost-idx__nav ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.1rem; }
	.gost-idx__nav a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding: 0.55rem 0.7rem;
		border-radius: var(--radius-sm);
		text-decoration: none;
		color: var(--color-text);
		font-size: 0.92rem;
		transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}
	.gost-idx__nav a:hover {
		background: var(--color-primary-50);
		color: var(--color-primary);
		text-decoration: none;
	}
	.gost-idx__nav a.is-active {
		background: var(--color-primary-500);
		color: #ffffff;
		font-weight: 600;
	}
	.gost-idx__nav-label { flex: 1; min-width: 0; }
	.gost-idx__nav-count {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		opacity: 0.7;
	}
	.gost-idx__nav a.is-active .gost-idx__nav-count { opacity: 1; color: rgba(255, 255, 255, 0.9); }

	.gost-idx__nerzh {
		background: var(--color-primary-50);
		border: 1px solid var(--color-primary-100);
		border-radius: var(--radius-md);
		padding: var(--space-3) var(--space-4);
	}
	.gost-idx__nerzh-title {
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--color-primary);
		margin-bottom: 0.5rem;
	}
	.gost-idx__nerzh ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.3rem; }
	.gost-idx__nerzh a {
		font-size: 0.85rem;
		color: var(--color-primary-600);
		text-decoration: none;
		line-height: 1.4;
	}
	.gost-idx__nerzh a:hover { text-decoration: underline; }

	/* Главная колонка */
	.gost-idx__main { min-width: 0; }
	.gost-idx__empty {
		text-align: center;
		padding: var(--space-6);
		background: var(--color-surface);
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-muted);
		font-size: 0.95rem;
		margin-bottom: var(--space-4);
	}

	.gost-idx__cat, .gost-idx__nerzh-section { scroll-margin-top: calc(var(--header-h, 64px) + 1rem); margin-bottom: var(--space-8); }
	.gost-idx__cat-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-3);
		padding-bottom: var(--space-2);
		border-bottom: 2px solid var(--color-primary-100);
		margin-bottom: var(--space-2);
	}
	.gost-idx__cat-title { font-size: 1.25rem; margin: 0; letter-spacing: -0.01em; }
	.gost-idx__cat-count {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--color-muted);
		background: var(--color-surface);
		padding: 0.15rem 0.55rem;
		border-radius: var(--radius-pill);
		white-space: nowrap;
	}
	.gost-idx__cat-descr { color: var(--color-muted); max-width: 75ch; line-height: 1.6; margin: 0 0 var(--space-3); font-size: 0.9rem; }

	/* Список ГОСТов — пронумерованный, ссылка-полоса на каждой строке */
	.gost-idx__list {
		list-style: none;
		counter-reset: gost-counter;
		padding: 0;
		margin: 0;
	}
	.gost-idx__row {
		display: grid;
		grid-template-columns: 2.5rem minmax(0, 1fr) auto;
		gap: 0.4rem;
		align-items: baseline;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--color-border);
	}
	.gost-idx__row:hover { background: var(--color-bg, transparent); }
	.gost-idx__row-idx {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--color-muted);
		text-align: right;
		padding-right: 0.3rem;
	}
	.gost-idx__row-link {
		display: block;
		text-decoration: none;
		color: var(--color-primary-600);
		font-size: 0.95rem;
		line-height: 1.45;
	}
	.gost-idx__row-link:hover { text-decoration: underline; text-underline-offset: 2px; color: var(--color-primary); }
	.gost-idx__row-num {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-primary);
		margin-right: 0.3rem;
	}
	.gost-idx__row-title { color: var(--color-text); }
	.gost-idx__row-link:hover .gost-idx__row-title { color: var(--color-primary); }
	.gost-idx__row-badge {
		font-size: 0.75rem;
		color: var(--color-accent);
		line-height: 1;
		align-self: center;
	}

	/* Нержавейка — детальный разбор */
	.gost-idx__nerzh-section {
		background: linear-gradient(180deg, var(--color-primary-50) 0%, transparent 100%);
		border-radius: var(--radius-lg);
		padding: var(--space-4) var(--space-4) var(--space-2);
		margin-top: var(--space-8);
	}
	.gost-idx__nerzh-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 0.6rem;
		margin-top: var(--space-3);
	}
	.gost-idx__nerzh-card {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: var(--space-3) var(--space-4);
		background: #ffffff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		text-decoration: none;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.gost-idx__nerzh-card:hover {
		border-color: var(--color-primary-500);
		text-decoration: none;
		transform: translateY(-1px);
		box-shadow: var(--shadow-sm);
	}
	.gost-idx__nerzh-card strong { font-family: var(--font-mono); font-size: 0.92rem; color: var(--color-primary); }
	.gost-idx__nerzh-card small { font-size: 0.85rem; color: var(--color-muted); line-height: 1.45; }

	.gost-idx__legal {
		margin-top: var(--space-6);
		padding: var(--space-3) var(--space-4);
		font-size: 0.78rem;
		line-height: 1.55;
		color: var(--color-muted);
		background: var(--color-surface);
		border-left: 3px solid var(--color-border);
		border-radius: 0 var(--radius-md) var(--radius-md) 0;
		max-width: 80ch;
	}
	.gost-idx__legal a { color: var(--color-primary-600); }
</style>
