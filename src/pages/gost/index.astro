---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { gosts, gostCategories } from '../../data/gosts';

const title = 'ГОСТы на металлопрокат — справочник 112 стандартов в 6 категориях';
const description = 'Полный справочник ГОСТов на металлопрокат: 112 документов — листовой, сортовой, трубный, качественный, арматура, цветмет. Прямые ссылки на PDF. Детальный разбор ключевых нержавеющих ГОСТов.';

// Сгруппированный по категориям справочник для нижнего блока.
const grouped = gostCategories.map((c) => ({
	...c,
	items: gosts.filter((g) => g.cat === c.value),
}));

const totalGosts = gosts.length;

/* Структурированные данные для рендеринга 8 H2-блоков. У каждого — короткое
   описание (для list-блока сверху страницы как «оглавление») и развёрнутый
   текст. Это удобнее, чем повторять разметку для каждого ГОСТа. */
const sections = [
	{
		id: 'gost-5582-19903',
		anchor: 'ГОСТ 5582-75, 19903-2015',
		title: 'ГОСТ 5582-75 и ГОСТ 19903-2015 — тонколистовая нержавейка',
		summary: 'Холоднокатаный лист до 4 мм и горячекатаный сортамент.',
		hubHref: '/list/',
		hubLabel: 'хабе листа',
		text: [
			'ГОСТ 5582-75 регулирует тонколистовой холоднокатаный прокат толщиной до 4 мм из коррозионно-стойких и жаростойких сталей. ГОСТ 19903-2015 задаёт сортамент горячекатаного листа: толщины, ширину, длину, предельные отклонения.',
			'По этим стандартам поставляется большинство ходовых марок аустенитного и ферритного класса: AISI 304 (08Х18Н10), AISI 321 (12Х18Н10Т), AISI 316L (03Х17Н14М2), AISI 430 (08Х17). Типовые толщины холоднокатаного листа — 0,4; 0,5; 0,8; 1; 1,5; 2; 3; 4 мм, форматы 1000×2000 и 1250×2500 мм, поверхности 2B, BA, 4N. На нашем сайте этот сортамент собран в хабе листа.',
		],
	},
	{
		id: 'gost-7350',
		anchor: 'ГОСТ 7350-77',
		title: 'ГОСТ 7350-77 — толстолистовая нержавейка',
		summary: 'Лист от 4 до 50 мм, корпусные конструкции и ёмкости.',
		hubHref: '/list/',
		hubLabel: 'хаб листа',
		text: [
			'ГОСТ 7350-77 распространяется на толстолистовой горячекатаный и холоднокатаный прокат из коррозионно-стойких, жаростойких и жаропрочных сталей толщиной от 4 до 50 мм. Стандарт определяет химический состав, механические свойства, требования к поверхности и термообработке.',
			'Типовые марки по ГОСТ 7350 — 08Х18Н10 (AISI 304), 12Х18Н10Т (AISI 321), 03Х17Н14М2 (AISI 316L), 20Х23Н18 (AISI 310S), а также ферритные 08Х17 и 12Х17. Размерный ряд толстого листа — 4; 5; 6; 8; 10; 12; 14; 16; 20; 25; 30; 40; 50 мм; форматы 1500×6000 и 2000×6000 мм. Этот прокат идёт на корпусные конструкции, ёмкости, теплообменники, фланцевые заготовки.',
		],
	},
	{
		id: 'gost-9941-9940',
		anchor: 'ГОСТ 9941-81, 9940-81',
		title: 'ГОСТ 9941-81 и ГОСТ 9940-81 — бесшовные трубы',
		summary: 'Холодно- и горячедеформированные трубы Ø 5–325 мм.',
		hubHref: '/truba/',
		hubLabel: 'хабе трубы',
		text: [
			'ГОСТ 9941-81 — стандарт на бесшовные холоднодеформированные трубы из коррозионно-стойких сталей: тянутые и катаные на холодных станах. Регулирует диаметры 5–250 мм, толщины стенки 0,2–22 мм, точность размеров (П, В, Н), длины (немерные, мерные, кратные).',
			'ГОСТ 9940-81 — на бесшовные горячедеформированные трубы диаметром 57–325 мм со стенкой 3,5–32 мм. По обоим стандартам поставляются 12Х18Н10Т (AISI 321), 08Х18Н10 (AISI 304), 10Х17Н13М2Т, 03Х17Н14М2 (AISI 316L) и жаропрочная 20Х23Н18 (AISI 310S). Бесшовка по ГОСТ 9941 — рабочая лошадка тепловых сетей, котельной обвязки, химического и нефтегазового оборудования.',
		],
	},
	{
		id: 'gost-11068',
		anchor: 'ГОСТ 11068-81',
		title: 'ГОСТ 11068-81 — электросварные трубы',
		summary: 'Прямошовные ЭСВ-трубы Ø 8–102 мм, дешевле бесшовки на 20–40 %.',
		hubHref: '/truba/',
		hubLabel: 'общем хабе труб',
		text: [
			'ГОСТ 11068-81 регулирует электросварные прямошовные трубы из коррозионно-стойкой стали диаметром 8–102 мм со стенкой 0,5–4 мм. Их формируют из ленты или штрипса и сваривают продольным швом аргонодуговой сваркой (TIG) или плазменно-дуговым методом. Дешевле бесшовки на 20–40 % при сопоставимой коррозионной стойкости в большинстве сред.',
			'По ГОСТ 11068 идут марки AISI 304 (08Х18Н10), AISI 321 (12Х18Н10Т), AISI 316L (03Х17Н14М2), AISI 430 (08Х17). Применение — пищевые трубопроводы, перила и ограждения, декоративные конструкции, дымоходы, мебельные каркасы. Профильные трубы (квадрат, прямоугольник) для пищевых и архитектурных задач делают по тому же ГОСТ 11068 либо по ТУ заводов-изготовителей.',
		],
	},
	{
		id: 'gost-5949',
		anchor: 'ГОСТ 5949-2018',
		title: 'ГОСТ 5949-2018 — сортовой прокат (круг, квадрат, шестигранник)',
		summary: 'Круг 5–270 мм, квадрат, шестигранник, полоса.',
		hubHref: '/krug/',
		hubLabel: 'хабе круга',
		text: [
			'ГОСТ 5949-2018 — основной стандарт на сортовой и калиброванный прокат из нержавеющих и жаропрочных сталей: круг, квадрат, шестигранник, полоса. Регулирует диаметр круга 5–270 мм, стороны квадрата 8–200 мм, размер «под ключ» шестигранника 8–100 мм.',
			'Задаёт классы точности, состояние поставки (горячекатаный, кованый, калиброванный), требования к макроструктуре и обезуглероженному слою. Под этот стандарт поставляются 12Х18Н10Т (AISI 321), 08Х18Н10 (AISI 304), 03Х17Н14М2 (AISI 316L), мартенситные 20Х13, 30Х13, 40Х13, ферритная 12Х13, жаропрочная 20Х23Н18, супераустенитная 06ХН28МДТ. Круг и шестигранник идут под токарную обработку валов, осей, метизов, фланцевых заготовок.',
		],
	},
	{
		id: 'gost-18143',
		anchor: 'ГОСТ 18143-72',
		title: 'ГОСТ 18143-72 — проволока нержавеющая',
		summary: 'Тянутая проволока Ø 0,2–6 мм, мягкое и твёрдое состояние.',
		hubHref: '/provoloka/',
		hubLabel: 'хабе проволоки',
		text: [
			'ГОСТ 18143-72 регулирует тянутую проволоку из коррозионно-стойких и жаростойких сталей. Диаметры — от 0,2 до 6 мм, состояние поставки — мягкое (М), полутвёрдое, твёрдое. Стандарт определяет химический состав, временное сопротивление разрыву, относительное удлинение, требования к поверхности и упаковке (бухты, катушки).',
			'По ГОСТ 18143 идёт сварочная проволока 12Х18Н10Т, 08Х18Н10, 03Х17Н14М2 (AISI 304, 321, 316L) — для аргонодуговой сварки и автоматической сварки под флюсом. Отдельно по ГОСТ 2246 поставляется сварочная проволока специальных марок (Св-04Х19Н11М3, Св-06Х19Н9Т). Вязальная и пружинная проволока — те же марки, но в твёрдом состоянии.',
		],
	},
	{
		id: 'gost-4986',
		anchor: 'ГОСТ 4986-79',
		title: 'ГОСТ 4986-79 — лента нержавеющая холоднокатаная',
		summary: 'Толщина 0,05–4 мм, ширина 4–600 мм, штрипс под трубу.',
		hubHref: '/lenta/',
		hubLabel: 'хабе ленты',
		text: [
			'ГОСТ 4986-79 регулирует холоднокатаную ленту из коррозионно-стойких и жаростойких сталей. Толщины — 0,05–4 мм, ширина — 4–600 мм. Стандарт задаёт точность по толщине (нормальная, повышенная, высокая), классы поверхности (матовая, светлая, полированная), состояние (нагартованное, отожжённое).',
			'По ГОСТ 4986 поставляются AISI 304 (08Х18Н10), AISI 321 (12Х18Н10Т), AISI 316L (03Х17Н14М2), AISI 430 (08Х17), 20Х13, 30Х13, 40Х13. Узкая лента (штрипс) шириной до 600 мм — заготовка для электросварных труб, пружин, упругих элементов, ножевой стали, заклёпок, бритвенных лезвий. Тонкая лента 0,05–0,2 мм называется фольгой и идёт на прокладки, экраны, гофры теплообменников.',
		],
	},
	{
		id: 'gost-5632',
		anchor: 'ГОСТ 5632-2014',
		title: 'ГОСТ 5632-2014 — базовый стандарт состава нержавеющих сталей',
		summary: '200+ марок, химический состав и обозначения по российской системе.',
		hubHref: '/postavka-nerzhaveyushchego-metalloprokata/',
		hubLabel: 'сводном каталоге',
		text: [
			'ГОСТ 5632-2014 — фундамент всей системы российских стандартов на нержавейку. Не регулирует сортамент или размеры — только химический состав сталей и сплавов: 200 с лишним марок коррозионно-стойких, жаростойких и жаропрочных сталей с допустимыми границами содержания C, Cr, Ni, Mo, Ti, Mn, Si, S, P.',
			'Именно по этому ГОСТу прописаны российские обозначения 08Х18Н10, 12Х18Н10Т, 03Х17Н14М2, 08Х17, 20Х13, 30Х13, 40Х13, 12Х13, 20Х23Н18, 06ХН28МДТ. В сертификатах завода-изготовителя ссылка на ГОСТ 5632 идёт обязательно — это подтверждает, что химия плавки попадает в допуски. Зарубежные аналоги — AISI/ASTM A959 и EN 10088-1.',
		],
	},
];

const faq = [
	{
		q: 'По какому ГОСТу заказать нержавеющую трубу?',
		a: 'Для бесшовной — ГОСТ 9941-81 (холоднодеформированная) или ГОСТ 9940-81 (горячедеформированная). Для электросварной — ГОСТ 11068-81. Профильную (квадрат, прямоугольник) делают по ГОСТ 11068 либо по ТУ конкретного завода.',
	},
	{
		q: 'Чем отличается ГОСТ 5582 от ГОСТ 7350?',
		a: 'ГОСТ 5582-75 — тонкий холоднокатаный лист до 4 мм. ГОСТ 7350-77 — толстый горячекатаный и холоднокатаный лист от 4 до 50 мм. Разные станы прокатки, разные требования к поверхности и допускам.',
	},
	{
		q: 'По какому ГОСТу AISI 304, 316L и 321?',
		a: 'Состав AISI 304 (08Х18Н10), AISI 316L (03Х17Н14М2) и AISI 321 (12Х18Н10Т) прописан в ГОСТ 5632-2014. Прокат идёт по сортаментным ГОСТам: 5582 и 7350 на лист, 9941 и 9940 на бесшовные трубы, 5949 на круг и сорт, 18143 на проволоку, 4986 на ленту.',
	},
	{
		q: 'Можно ли в одну партию собрать прокат из 20Х13, 30Х13 и 40Х13?',
		a: 'Да. Все три мартенситные хромистые марки прописаны в ГОСТ 5632-2014 и поставляются по ГОСТ 5949-2018 (круг, квадрат, шестигранник) и ГОСТ 4986-79 (лента). Отличие — содержание углерода: 0,16–0,25 % у 20Х13, 0,26–0,35 % у 30Х13, 0,36–0,45 % у 40Х13. Чем выше C, тем выше твёрдость после закалки.',
	},
	{
		q: 'Какой ГОСТ закрывает жаропрочные марки 20Х23Н18 и 06ХН28МДТ?',
		a: 'Состав — ГОСТ 5632-2014. Сортовой прокат и круг — ГОСТ 5949-2018. Толстый лист 20Х23Н18 (AISI 310S) идёт по ГОСТ 7350-77, бесшовные трубы — по ГОСТ 9941 и 9940. Сплав 06ХН28МДТ (AISI 904L) — супераустенит для сернокислотных сред, чаще поставляется кругом и листом под заказ.',
	},
	{
		q: 'Что должно быть указано в сертификате завода?',
		a: 'Номер плавки, марка по ГОСТ 5632, ссылка на сортаментный ГОСТ (5582 / 7350 / 9941 / 5949 / 18143 / 4986), химический анализ, механические свойства, режим термообработки. Без сертификата с этими данными прокат не принимается на ответственные объекты.',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<BaseLayout title={title} description={description} jsonLd={faqJsonLd}>
	<div class="container gost">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'ГОСТы — справочник' }]} />

		<header class="gost__hero">
			<span class="gost__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<rect x="2" y="2" width="12" height="12" rx="1.5" stroke="currentColor" stroke-width="1.4" />
					<path d="M5 6h6M5 9h6M5 12h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
				Справочник
			</span>
			<h1 class="gost__h1">Справочник ГОСТов на металлопрокат</h1>
			<p class="gost__lead">
				Полный перечень из <strong>{totalGosts} действующих ГОСТов</strong> в шести категориях:
				качественный прокат, листовой, сортовой, трубный, трубопроводная арматура и цветные
				металлы. По каждому документу — прямая ссылка на PDF на meganorm.ru.
				Сверху — детальный разбор ключевых стандартов на нержавеющий прокат
				(9941, 5582, 7350, 5949, 5632) с указанием марок и каталожного раздела;
				внизу — полный справочник с фильтром по категории и поиском по номеру ГОСТа.
			</p>
		</header>

		<nav class="gost__toc" aria-label="Содержание">
			<div class="gost__toc-title">Детальный разбор — нержавейка</div>
			<ul>
				{sections.map((s) => (
					<li>
						<a href={`#${s.id}`}>
							<strong>{s.anchor}</strong>
							<span>{s.summary}</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<nav class="gost__cats" aria-label="Категории справочника">
			<div class="gost__toc-title">Полный справочник — {totalGosts} ГОСТов в 6 категориях</div>
			<ul>
				{grouped.map((g) => (
					<li>
						<a href={`#cat-${g.value}`}>
							<strong>{g.label}</strong>
							<span>{g.items.length} ГОСТов</span>
						</a>
					</li>
				))}
			</ul>
		</nav>

		<div class="gost__sections">
			{sections.map((s) => (
				<section class="gost__section" id={s.id}>
					<h2>{s.title}</h2>
					{s.text.map((p) => <p>{p}</p>)}
					<a class="gost__hub-link" href={s.hubHref}>
						<span>Смотреть прокат по этому ГОСТу в {s.hubLabel}</span>
						<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</a>
				</section>
			))}
		</div>

		<section class="gost__directory" id="directory" data-gost-directory>
			<div class="gost__directory-head">
				<h2 class="gost__directory-h2">Полный справочник ГОСТов</h2>
				<p class="gost__directory-lead">
					{totalGosts} действующих ГОСТов по металлопрокату в шести категориях.
					Каждая запись — номер, название и прямая ссылка на PDF документа.
					Где применимо — ссылка на соответствующий раздел нашего каталога.
				</p>

				<div class="gost__filter">
					<div class="gost__filter-search">
						<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
							<circle cx="7" cy="7" r="4.5" stroke="currentColor" stroke-width="1.5" />
							<path d="M14 14l-3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
						</svg>
						<input
							type="search"
							placeholder="Поиск по номеру или названию (например: 9941, лист, фланцы)"
							data-gost-search
							aria-label="Поиск по номеру или названию ГОСТа"
						/>
					</div>
					<div class="gost__filter-tabs" role="tablist">
						<button class="gost__filter-tab is-active" data-gost-tab="all" type="button">Все · {totalGosts}</button>
						{gostCategories.map((c) => {
							const cnt = gosts.filter((g) => g.cat === c.value).length;
							return (
								<button class="gost__filter-tab" data-gost-tab={c.value} type="button">
									{c.label} · {cnt}
								</button>
							);
						})}
					</div>
				</div>
			</div>

			<div class="gost__cat-list">
				{grouped.map((g) => (
					<div class="gost__cat" id={`cat-${g.value}`} data-gost-cat={g.value}>
						<header class="gost__cat-head">
							<h3 class="gost__cat-title">{g.label}</h3>
							<span class="gost__cat-count">{g.items.length} ГОСТов</span>
						</header>
						<p class="gost__cat-descr">{g.descr}</p>

						<ul class="gost__items">
							{g.items.map((item) => (
								<li
									class="gost__item"
									data-gost-item
									data-num={item.num.toLowerCase()}
									data-title={item.title.toLowerCase()}
									data-cat={item.cat}
									data-priority={item.priority || 'standard'}
								>
									<div class="gost__item-head">
										<span class="gost__item-num">ГОСТ {item.num}</span>
										{item.priority === 'core' && (
											<span class="gost__item-badge">наша тематика</span>
										)}
									</div>
									<div class="gost__item-title">{item.title}</div>
									<div class="gost__item-links">
										<a
											class="gost__item-pdf"
											href={item.pdf}
											target="_blank"
											rel="noopener nofollow"
										>
											<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
												<path d="M4 2h6l3 3v9H4V2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
