<script>
	const root = document.querySelector('[data-gost-directory]');
	if (root) {
		const searchInp = root.querySelector('[data-gost-search]') as HTMLInputElement | null;
		const tabs = Array.from(root.querySelectorAll('[data-gost-tab]')) as HTMLButtonElement[];
		const items = Array.from(root.querySelectorAll('[data-gost-item]')) as HTMLElement[];
		const cats = Array.from(root.querySelectorAll('[data-gost-cat]')) as HTMLElement[];
		const emptyEl = root.querySelector('[data-gost-empty]') as HTMLElement | null;

		let activeTab: string = 'all';
		let query: string = '';

		function normalize(s: string): string {
			return s.toLowerCase().trim();
		}

		function applyFilter() {
			const q = normalize(query);
			let visibleTotal = 0;

			for (const item of items) {
				const matchCat = activeTab === 'all' || item.dataset.cat === activeTab;
				const matchSearch =
					!q ||
					(item.dataset.num || '').includes(q) ||
					(item.dataset.title || '').includes(q);
				const visible = matchCat && matchSearch;
				item.hidden = !visible;
				if (visible) visibleTotal++;
			}

			// Спрячем категории без видимых элементов.
			for (const cat of cats) {
				const hasVisible = Array.from(cat.querySelectorAll<HTMLElement>('[data-gost-item]'))
					.some((i) => !i.hidden);
				cat.hidden = !hasVisible;
			}

			if (emptyEl) emptyEl.hidden = visibleTotal > 0;
		}

		for (const tab of tabs) {
			tab.addEventListener('click', () => {
				activeTab = tab.dataset.gostTab || 'all';
				for (const t of tabs) t.classList.toggle('is-active', t === tab);
				applyFilter();
			});
		}

		if (searchInp) {
			searchInp.addEventListener('input', () => {
				query = searchInp.value;
				applyFilter();
			});
		}
	}
</script>

