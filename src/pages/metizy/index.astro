---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubRequest from '../../components/HubRequest.astro';

const types = [
	{ title: 'Болты', desc: 'DIN 933 (полная резьба), DIN 931 (часть резьбы). М4–М48. AISI 304, 316.' },
	{ title: 'Гайки', desc: 'DIN 934 шестигранные, DIN 985 самоконтрящиеся, DIN 562 квадратные.' },
	{ title: 'Винты', desc: 'DIN 84 (цилиндрическая), DIN 7985 (полукруглая), DIN 7991 (потайная).' },
	{ title: 'Шайбы', desc: 'DIN 125 плоские, DIN 127 пружинные, DIN 9021 увеличенные, DIN 6798 стопорные.' },
	{ title: 'Шпильки', desc: 'DIN 975 (метровые), DIN 976 (с фланцем). Резьба М4–М36, до 1 м длиной.' },
	{ title: 'Саморезы', desc: 'DIN 7504 по металлу, DIN 7981 по дереву. AISI 304, 410.' },
	{ title: 'Заклёпки', desc: 'DIN 7337 вытяжные, DIN 660 с полукруглой головкой. AISI 304.' },
	{ title: 'Хомуты', desc: 'Червячные, силовые. DIN 3017, нержавеющая лента W4/W5.' },
];
---

<CatalogHubTemplate
	title="Метизы и крепёж нержавеющий"
	description="Крепёж из нержавеющей стали: болты, гайки, винты, шайбы, шпильки, саморезы. DIN и ГОСТ. AISI 304, AISI 316. Подбор и поставка под заявку."
	h1="Метизы и крепёж нержавеющий"
	intro="Полный ассортимент крепёжных изделий из нержавеющей стали по стандартам DIN, ISO, ГОСТ. Аустенитные марки A2 (AISI 304) и A4 (AISI 316). Поставка от мешка до контейнерной партии."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Метизы / Крепёж' }]}
>
	<HubRequest what="Метизы и крепёж нержавеющий" />

	<section class="block">
		<h2>Виды крепежа</h2>
		<div class="types-grid">
			{types.map((t) => (
				<article class="type-card">
					<h3>{t.title}</h3>
					<p>{t.desc}</p>
				</article>
			))}
		</div>
	</section>

	<section class="block">
		<h2>Маркировка по стандартам</h2>
		<ul class="list-plain">
			<li><strong>A2 (AISI 304)</strong> — общего назначения, кухня, мебель, открытые конструкции</li>
			<li><strong>A2-70</strong> — A2 с прочностью 700 МПа, увеличенная нагрузка</li>
			<li><strong>A4 (AISI 316)</strong> — морская среда, химия, фармацевтика</li>
			<li><strong>A4-80</strong> — A4 с прочностью 800 МПа, ответственные конструкции</li>
		</ul>
	</section>

	<section class="block">
		<h2>Что мы делаем под заказ</h2>
		<ul class="list-plain">
			<li>Подбор по чертежу или образцу</li>
			<li>Нестандартные размеры — токарные/фрезерные работы</li>
			<li>Покрытие (полировка, пассивирование)</li>
			<li>Документы — сертификаты завода + ТУ</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 65ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.types-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--space-3);
	}
	.type-card {
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.type-card h3 { margin: 0 0 var(--space-2); font-size: 1rem; color: var(--color-text); }
	.type-card p { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.5; }
</style>
