---
import ProductDetail from '../../components/ProductDetail.astro';
import MarkLanding from '../../components/MarkLanding.astro';
import pricelist from '../../data/pricelist.json';
import { marks } from '../../data/marks.ts';

export async function getStaticPaths() {
	const skus = (pricelist.hubs as any).krug as any[];
	const productPaths = skus.map((sku) => ({
		params: { slug: sku.slug },
		props: { kind: 'product', sku },
	}));

	const markPaths = marks
		.filter((m) => m.hubs.includes('krug'))
		.map((m) => ({ params: { slug: m.slug }, props: { kind: 'mark', mark: m } }));

	return [...markPaths, ...productPaths];
}

const props = Astro.props as any;
---

{props.kind === 'mark' ? (
	<MarkLanding
		mark={props.mark}
		hub="krug"
		hubLabel="Круг нержавеющий"
		hubLabelGenitive="круг нержавеющий"
		hubHref="/krug/"
		measure="диаметр"
	/>
) : (
	<ProductDetail
		sku={props.sku}
		hubLabel="Круг / Квадрат / Шестигранник"
		hubHref="/krug/"
		measureLabel="диаметр"
	/>
)}
