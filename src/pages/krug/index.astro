---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any).krug as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Чем отличается калиброванный круг h9/h11 от горячекатаного?',
		a: 'Калиброванный круг (h9/h11) — холоднотянутый или шлифованный, с точным диаметром по ISO. Идёт сразу под токарную обработку без черновой обточки. Горячекатаный — поверхность с окалиной, допуски шире, обычно требует обточки. Калиброванный дороже, но экономит время на обработку.',
	},
	{
		q: 'Какой круг подойдёт для термообработки и закалки?',
		a: 'Для деталей с закалкой берут жаропрочные мартенситные марки: 20Х13, 30Х13, 40Х13 (AISI 420). После закалки твёрдость достигает 50–55 HRC. Аустенитные AISI 304/316L/321 закалкой не упрочняются — для них используется наклёп.',
	},
	{
		q: 'Можно ли заказать резку круга в заготовку?',
		a: 'Да, режем дисковой и ленточной пилой от 1 заготовки с точностью ±0,5 мм. Возможна торцовка, фаска и предварительная обточка под чистовой размер.',
	},
	{
		q: 'Шестигранник — какие размеры есть в наличии?',
		a: 'Калиброванный шестигранник 6–60 мм по граням, под крепёж, фланцы и спецдетали. Марки 12Х18Н10Т, AISI 304, AISI 420. Для нестандартных размеров — изготовление под заявку.',
	},
	{
		q: 'Какие документы предоставляются?',
		a: 'Сертификат качества по ГОСТ 5949, EN 10088, ASTM A276. Маркировка плавки и партии на торце прутка. Возможна перебивка маркировки на длинные хлысты — для удобства склада клиента.',
	},
];
---

<CatalogHubTemplate
	title="Круг, квадрат, шестигранник нержавеющие — цена за тонну в Нижнем Новгороде"
	description="Сортовой нержавеющий прокат: круг калиброванный h9/h11, квадрат, шестигранник. AISI 304, 316L, 321, 12Х18Н10Т, 20Х13. 698 позиций в прайсе."
	h1="Круг / Квадрат / Шестигранник"
	intro={`Сортовой нержавеющий прокат для механической обработки: круги Ø 3–250 мм (калиброванные h9/h11 и горячекатаные), квадраты, шестигранники. Аустенитные AISI 304/316L/321/904L и жаропрочные 20Х13/40Х13/20Х23Н18 — всего ${skus.length} позиций в наличии со склада в Нижнем Новгороде.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Круг / Квадрат / Шестигранник' }]}
	hubHref="/krug/"
	hubLabel="Круг нержавеющий"
	hubKey="krug"
	faq={faq}
>
	<PriceTable hub="krug" title="Прайс на сортовой прокат" measure="диаметр" />

	<HubExtras
		hubHref="/krug/"
		hubLabel="Круг нержавеющий"
		hubLabelGenitive="круг нержавеющий"
		grades={grades}
	/>

	<section class="block">
		<h2>Что входит в раздел</h2>
		<ul class="list-plain">
			<li><strong>Круг никельсодержащий</strong> — AISI 304/304L, 316L, 316Ti, 321, 904L, 310S. Калиброванный h9/h11, горячекатаный, обточенный по DIN 1013</li>
			<li><strong>Круг жаропрочный (без никеля)</strong> — 08Х13, 12Х13, 20Х13, 30Х13, 40Х13. Для деталей с термообработкой</li>
			<li><strong>Квадрат</strong> — калиброванный h9/h11, под обработку резанием и шпонки</li>
			<li><strong>Шестигранник</strong> — калиброванный, под крепёж и фланцы. AISI 420, 12Х18Н10Т</li>
			<li><strong>ЭШП (электрошлаковый переплав)</strong> — для ответственных деталей</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Машиностроение — валы, оси, шпиндели, шестерни</li>
			<li>Метизы и крепёж — болты, шпильки, гайки из шестигранника</li>
			<li>Пищевая и фарма — мешалки, валы насосов (AISI 316L)</li>
			<li>Жаропрочные узлы — тэны, печи, котельная арматура (20Х13, 12Х18Н10Т)</li>
			<li>Медицинский инструмент — скальпели, пинцеты (AISI 420, 440C)</li>
		</ul>
	</section>

	<section class="block">
		<h2>Обработка под заявку</h2>
		<p>
			Резка дисковой пилой и ленточной — от 1 заготовки, в размер ±0,5 мм.
			Токарная обработка, фрезеровка по чертежу. Под полировку и шлифование —
			см. <a href="/uslugi/polirovka/">услуги</a>.
		</p>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат качества — ГОСТ 5949 / EN 10088 / ASTM A276</li>
			<li>Маркировка плавки на торце прутка</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Доставка автотранспортом и ТК по России</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
	.block p a { color: var(--color-primary-600); }
</style>
