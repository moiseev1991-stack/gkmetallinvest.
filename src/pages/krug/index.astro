---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any).krug as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Какой ГОСТ на круг нержавеющий?',
		a: 'Основной стандарт — ГОСТ 5949-2018 на сортовой нержавеющий прокат: круг, квадрат, шестигранник. Регулирует химсостав по ГОСТ 5632, мехсвойства, точность размеров и состояние поверхности. Для калиброванного круга повышенной точности действует ГОСТ 7417, для специальной отделки — ГОСТ 14955. Международные аналоги — ASTM A276 и A479.',
	},
	{
		q: 'Чем калиброванный круг отличается от горячекатаного?',
		a: 'Калиброванный круг (h9/h11) — холоднотянутый или шлифованный, с точным диаметром по ISO и ГОСТ 7417. Идёт сразу под токарную обработку без черновой обточки, припуск на чистовой проход — 0,3–0,8 мм. Горячекатаный — поверхность с окалиной, допуски шире, требует обточки. Калиброванный дороже на 15–25 %, но экономит время и металл на обработке.',
	},
	{
		q: 'Какой круг подойдёт для термообработки и закалки?',
		a: 'Для деталей с закалкой берут жаропрочные мартенситные марки: 20Х13, 30Х13, 40Х13 (AISI 420). После закалки твёрдость достигает 50–55 HRC. Аустенитные AISI 304/316L/321 закалкой не упрочняются — для них используется наклёп.',
	},
	{
		q: 'Можно ли заказать резку круга в заготовку?',
		a: 'Да, режем дисковой и ленточной пилой от 1 заготовки с точностью ±0,5 мм. Возможна торцовка, фаска и предварительная обточка под чистовой размер.',
	},
	{
		q: 'Шестигранник — какие размеры есть в наличии?',
		a: 'Калиброванный шестигранник 6–60 мм по граням, под крепёж, фланцы и спецдетали. Марки 12Х18Н10Т, AISI 304, AISI 420. Для нестандартных размеров — изготовление под заявку.',
	},
	{
		q: 'Какие документы предоставляются?',
		a: 'Сертификат качества по ГОСТ 5949, EN 10088, ASTM A276. Маркировка плавки и партии на торце прутка. Возможна перебивка маркировки на длинные хлысты — для удобства склада клиента.',
	},
];
---

<CatalogHubTemplate
	title="Круг, квадрат, шестигранник нержавеющие по ГОСТ 5949 — цена за тонну"
	description="Круг нержавеющий по ГОСТ 5949 Ø 3–270 мм, квадрат, шестигранник. Калиброванный h9/h11 и горячекатаный. Марки AISI 304, 316L, 321, 12Х18Н10Т, 20Х13."
	h1="Круг / Квадрат / Шестигранник"
	intro={`Сортовой нержавеющий прокат для механической обработки: круги Ø 3–250 мм (калиброванные h9/h11 и горячекатаные), квадраты, шестигранники. Аустенитные AISI 304/316L/321/904L и жаропрочные 20Х13/40Х13/20Х23Н18 — всего ${skus.length} позиций в наличии со склада в Нижнем Новгороде.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Круг / Квадрат / Шестигранник' }]}
	hubHref="/krug/"
	hubLabel="Круг нержавеющий"
	hubKey="krug"
	faq={faq}
>
	<PriceTable hub="krug" title="Прайс на сортовой прокат" measure="диаметр" />

	<HubExtras
		hubHref="/krug/"
		hubLabel="Круг нержавеющий"
		hubLabelGenitive="круг нержавеющий"
		grades={grades}
	/>

	<section class="block">
		<h2>Что входит в раздел</h2>
		<ul class="list-plain">
			<li><strong>Круг никельсодержащий</strong> — AISI 304/304L, 316L, 316Ti, 321, 904L, 310S. Калиброванный h9/h11, горячекатаный, обточенный по DIN 1013</li>
			<li><strong>Круг жаропрочный (без никеля)</strong> — 08Х13, 12Х13, 20Х13, 30Х13, 40Х13. Для деталей с термообработкой</li>
			<li><strong>Квадрат</strong> — калиброванный h9/h11, под обработку резанием и шпонки</li>
			<li><strong>Шестигранник</strong> — калиброванный, под крепёж и фланцы. AISI 420, 12Х18Н10Т</li>
			<li><strong>ЭШП (электрошлаковый переплав)</strong> — для ответственных деталей</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Машиностроение — валы, оси, шпиндели, шестерни</li>
			<li>Метизы и крепёж — болты, шпильки, гайки из шестигранника</li>
			<li>Пищевая и фарма — мешалки, валы насосов (AISI 316L)</li>
			<li>Жаропрочные узлы — тэны, печи, котельная арматура (20Х13, 12Х18Н10Т)</li>
			<li>Медицинский инструмент — скальпели, пинцеты (AISI 420, 440C)</li>
		</ul>
	</section>

	<section class="block">
		<h2>Обработка под заявку</h2>
		<p>
			Резка дисковой пилой и ленточной — от 1 заготовки, в размер ±0,5 мм.
			Токарная обработка, фрезеровка по чертежу. Под полировку и шлифование —
			см. <a href="/uslugi/polirovka/">услуги</a>.
		</p>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат качества — ГОСТ 5949 / EN 10088 / ASTM A276</li>
			<li>Маркировка плавки на торце прутка</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Доставка автотранспортом и ТК по России</li>
		</ul>
	</section>

	<section class="block">
		<h2>Размеры круга, квадрата, шестигранника по ГОСТ 5949</h2>
		<p>
			Сортовой нержавеющий прокат поставляем по ГОСТ 5949-2018 — основной стандарт
			на круг, квадрат и шестигранник из коррозионно-стойкой стали. Параллельно
			действуют ГОСТ 2590 (круг общего назначения), ГОСТ 8559 (квадрат) и
			ГОСТ 8560 (шестигранник). Калиброванный прокат повышенной точности
			с уменьшенным припуском под токарку идёт по ГОСТ 7417. Горячекатаный круг
			(ГК) — от Ø 25 мм, холоднотянутый и калиброванный (ХТ) — до Ø 60 мм.
			Прутки длиной 2–6 м, под заказ режем в мерные нарезы.
		</p>
		<ul class="list-plain">
			<li><strong>Круг нержавеющий</strong> — Ø 5; 6; 8; 10; 12; 14; 16; 18; 20; 22; 25; 28; 30; 35; 40; 45; 50; 55; 60; 70; 80; 90; 100; 110; 120; 140; 150; 160; 180; 200; 220; 250; 270 мм. Пруток нержавеющий и нержавейка круг — синонимы одной позиции</li>
			<li><strong>Квадрат нержавеющий</strong> — сторона 8; 10; 12; 14; 16; 18; 20; 25; 30; 40; 50; 60; 80; 100; 120; 150; 200 мм</li>
			<li><strong>Шестигранник нержавеющий</strong> — размер «под ключ» 8; 10; 12; 14; 17; 19; 22; 24; 27; 30; 36; 41; 46; 50; 60; 70; 80; 100 мм</li>
			<li>Ходовые диаметры прутка нержавеющего — 6, 12, 16, 20 мм для шпилек, осей и крепежа</li>
		</ul>
	</section>

	<section class="block">
		<h2>ГОСТы и сертификация сортового нержавеющего проката</h2>
		<p>
			ГОСТ 5949-2018 — главный стандарт на круг нержавеющий, пруток нержавеющий
			и шестигранник нержавеющий из аустенитных, ферритных и мартенситных марок.
			Регулирует химсостав (со ссылкой на ГОСТ 5632), мехсвойства, точность
			размеров и состояние поверхности. ГОСТ 7417 распространяется на
			калиброванный круг повышенной точности (h9/h11), ГОСТ 14955 —
			на пруток со специальной отделкой поверхности под механическую обработку.
			Международные аналоги — ASTM A276 и A479. В заводском сертификате на
			сортовой нержавеющий прокат указывается марка по ГОСТ 5632 и сортаментный
			ГОСТ под конкретный профиль.
		</p>
		<p>
			Применение круга: токарная обработка валов, осей, штоков, шпинделей,
			метизов и фланцевых заготовок. Жаропрочные марки 20Х13–40Х13 идут под
			закалку и режущий инструмент, аустенитные AISI 304/316L/321 — под
			ответственный крепёж в пищевой, химической и фармацевтической
			промышленности.
		</p>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
	.block p a { color: var(--color-primary-600); }
</style>
