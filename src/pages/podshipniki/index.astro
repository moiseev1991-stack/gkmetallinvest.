---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubRequest from '../../components/HubRequest.astro';

const types = [
	{ title: 'Шариковые радиальные', desc: 'AISI 440C, S316. ГОСТ 8338, ISO 15. Двухрядные, однорядные.' },
	{ title: 'Шариковые радиально-упорные', desc: 'Угол контакта 15°, 25°, 40°. Для осевых нагрузок.' },
	{ title: 'Роликовые конические', desc: 'ГОСТ 27365. Большие осевые и радиальные нагрузки.' },
	{ title: 'Роликовые сферические', desc: 'Самоустанавливающиеся. Для несоосных валов.' },
	{ title: 'Игольчатые', desc: 'С тонкими цилиндрическими роликами. Малый радиальный габарит.' },
	{ title: 'Шарнирные подшипники скольжения', desc: 'GE, GAC серии. Для качательных движений.' },
];
---

<CatalogHubTemplate
	title="Подшипники и промышленные компоненты из нержавейки"
	description="Нержавеющие подшипники (шариковые, роликовые, конические, сферические, игольчатые) и промышленные комплектующие. AISI 440C, 316. Подбор по чертежу или заявке."
	h1="Подшипники и промышленные компоненты"
	intro="Подшипники из нержавеющей стали для пищевой, фармацевтической, морской и химической промышленности — и сопутствующие промышленные компоненты под индивидуальные проекты. Материалы AISI 440C (мартенситная, твёрдая) и AISI 316 (аустенитная, морская). Подбор по типу, размерам и нагрузке."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Подшипники и промышленные компоненты' }]}
	hubKey="podshipniki"
	noindex
>
	<HubRequest what="Подшипники нержавеющие — все типы и размеры" />

	<section class="block">
		<h2>Типы подшипников</h2>
		<div class="types-grid">
			{types.map((t) => (
				<article class="type-card">
					<h3>{t.title}</h3>
					<p>{t.desc}</p>
				</article>
			))}
		</div>
	</section>

	<section class="block">
		<h2>Материалы</h2>
		<ul class="list-plain">
			<li><strong>AISI 440C</strong> — мартенситная, высокая твёрдость (58–60 HRC), стандарт для пищевой/фарма</li>
			<li><strong>AISI 316 / 316L</strong> — аустенитная, морская/химическая среда, немагнитная</li>
			<li><strong>AISI 304</strong> — общего назначения, для среднеагрессивных сред</li>
		</ul>
	</section>

	<section class="block">
		<h2>Когда нужны нержавеющие подшипники</h2>
		<ul class="list-plain">
			<li>Пищевая промышленность — соответствие FDA, мойка водой и моющими средствами</li>
			<li>Фармацевтика и медтехника — стерилизация автоклавом</li>
			<li>Морское оборудование — солёная среда, открытая палуба</li>
			<li>Химия — кислоты, щёлочи, агрессивные среды</li>
			<li>Криогенная техника — низкие температуры</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 65ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.types-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--space-3);
	}
	.type-card {
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.type-card h3 { margin: 0 0 var(--space-2); font-size: 1rem; color: var(--color-text); }
	.type-card p { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.5; }
</style>
