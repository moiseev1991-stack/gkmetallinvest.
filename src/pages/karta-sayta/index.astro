---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { navGroups, navServices } from '../../data/navigation';
import { cities } from '../../data/cities';
import { siteName } from '../../data/site';

const sections = [
	{
		title: 'Главные страницы',
		links: [
			{ href: '/', label: 'Главная' },
			{ href: '/o-kompanii/', label: 'О компании' },
			{ href: '/dostavka-i-oplata/', label: 'Доставка и оплата' },
			{ href: '/kontakty/', label: 'Контакты' },
			{ href: '/zapros-kp/', label: 'Запросить КП' },
		],
	},
	{
		title: 'Услуги',
		links: navServices,
	},
	{
		title: 'Юридическое',
		links: [
			{ href: '/politika-konfidencialnosti/', label: 'Политика конфиденциальности' },
			{ href: '/publichnaya-oferta/', label: 'Публичная оферта' },
			{ href: '/sertifikaty/', label: 'Сертификаты' },
		],
	},
];

/* Хабы с прайсом — для которых есть city-лендинги */
const hubsWithCities: Array<{ hub: string; label: string }> = [
	{ hub: 'list', label: 'Лист нержавеющий' },
	{ hub: 'truba', label: 'Труба нержавеющая' },
	{ hub: 'krug', label: 'Круг / Квадрат / Шестигранник' },
	{ hub: 'polosa', label: 'Полоса нержавеющая' },
	{ hub: 'rulon', label: 'Рулон нержавеющий' },
	{ hub: 'provoloka', label: 'Проволока нержавеющая' },
	{ hub: 'detali-truboprovoda', label: 'Детали трубопровода' },
	{ hub: 'ugolok-shveller', label: 'Уголок / Швеллер' },
];
---

<BaseLayout
	title="Карта сайта"
	description={`Структура сайта ${siteName} — все разделы каталога нержавеющего металлопроката, услуги, городские лендинги и информационные страницы в одном месте.`}
>
	<div class="container page">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Карта сайта' }]} />

		<header class="page__hero">
			<span class="eyebrow">Навигация</span>
			<h1>Карта сайта</h1>
			<p class="page__lead">
				Все разделы каталога, услуги, городские лендинги и информационные страницы.
				Если что-то не находится через меню — найдёте здесь.
			</p>
		</header>

		<section class="sm-block">
			<h2>Каталог</h2>
			<div class="sm-catalog">
				{navGroups.map((group) => (
					<div class="sm-catalog__group">
						<h3>{group.title}</h3>
						<ul>
							{group.items.map((item) => (
								<li>
									<a href={item.href}>{item.title}</a>
									{item.empty && <span class="sm-hint">по запросу</span>}
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		</section>

		<section class="sm-block">
			<h2>Городские лендинги</h2>
			<p class="sm-block__intro">Доставка нержавейки в крупные города России — со страницами под каждое направление.</p>
			<div class="sm-cities">
				{hubsWithCities.map((h) => (
					<div class="sm-cities__group">
						<a class="sm-cities__hub" href={`/${h.hub}/`}>{h.label}</a>
						<ul>
							{cities.map((c) => (
								<li><a href={`/${h.hub}/v-${c.slug}/`}>в {c.loc}</a></li>
							))}
						</ul>
					</div>
				))}
			</div>
		</section>

		{sections.map((s) => (
			<section class="sm-block">
				<h2>{s.title}</h2>
				<ul class="sm-list">
					{s.links.map((l) => (
						<li><a href={l.href}>{l.label}</a></li>
					))}
				</ul>
			</section>
		))}

		<p class="sm-foot">
			Для поисковых систем доступен <a href="/sitemap-index.xml">XML-sitemap</a>.
		</p>
	</div>
</BaseLayout>

<style>
	.page { padding-block: var(--space-8); }
	.page__hero { margin-bottom: var(--space-8); max-width: 80ch; }
	.page__lead {
		font-size: 1.02rem;
		max-width: 70ch;
		margin: var(--space-3) 0 0;
		color: var(--color-text);
		line-height: 1.55;
	}

	.sm-block { margin-bottom: var(--space-8); }
	.sm-block h2 {
		font-size: 1.25rem;
		margin: 0 0 var(--space-4);
		padding-bottom: var(--space-2);
		border-bottom: 1px solid var(--color-border);
		letter-spacing: -0.015em;
	}
	.sm-block__intro {
		margin: 0 0 var(--space-4);
		color: var(--color-muted);
		font-size: 0.94rem;
		max-width: 70ch;
	}

	.sm-catalog,
	.sm-cities {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-5) var(--space-6);
	}
	.sm-catalog__group h3,
	.sm-cities__hub {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--color-primary-600);
		margin: 0 0 var(--space-2);
		display: block;
		text-decoration: none;
	}
	.sm-cities__hub:hover { text-decoration: underline; }
	.sm-catalog__group ul,
	.sm-cities__group ul,
	.sm-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.4rem;
	}
	.sm-list {
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 0.5rem var(--space-5);
	}
	.sm-catalog__group li,
	.sm-cities__group li,
	.sm-list li {
		font-size: 0.93rem;
	}
	.sm-catalog__group a,
	.sm-cities__group a,
	.sm-list a {
		color: var(--color-text);
		text-decoration: none;
	}
	.sm-catalog__group a:hover,
	.sm-cities__group a:hover,
	.sm-list a:hover {
		color: var(--color-primary-600);
		text-decoration: underline;
	}
	.sm-hint {
		display: inline-block;
		margin-left: 0.4rem;
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-accent);
		background: var(--color-accent-100);
		padding: 0.05rem 0.35rem;
		border-radius: var(--radius-pill);
		vertical-align: middle;
	}

	.sm-foot {
		margin: var(--space-6) 0 0;
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
		font-size: 0.88rem;
		color: var(--color-muted);
	}
</style>
