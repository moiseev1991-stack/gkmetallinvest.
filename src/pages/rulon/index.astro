---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any).rulon as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));
const surfaces = [...new Set(skus.map((s) => s.surface).filter(Boolean))] as string[];
surfaces.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Что выгоднее — рулон или готовый лист?',
		a: 'Цена за тонну рулона на 5–10 % ниже, чем у листа того же качества. Если у вас есть собственный гильотинный или плазменный резак — рулон выгоднее. Если нужны 1–5 листов в размер — берите лист или закажите у нас резку из рулона.',
	},
	{
		q: 'Какие ширины рулона есть в наличии?',
		a: 'Ходовые ширины 1000, 1250, 1500 мм. Под заявку — 600 и 1219 мм. Внутренний диаметр шпули обычно 508 мм (стандарт для перемоточных станков).',
	},
	{
		q: 'Можно ли заказать резку рулона в лист или штрипс?',
		a: 'Да. Поперечная резка в лист — до 12 м длиной (точность ±1 мм). Продольная резка в штрипс — толщина до 4 мм, шаг ширины 5 мм. Минимальная партия — от одного хлыста / рулончика штрипса.',
	},
	{
		q: 'Что такое 2B, BA, 4N для рулона?',
		a: '2B — стандартная матовая поверхность холоднокатаного рулона. BA — зеркально-полированная после отжига в защитной атмосфере. 4N — направленный сатин шлифовкой. Для архитектурных и интерьерных задач — BA или 4N с защитной плёнкой PE.',
	},
	{
		q: 'Какие сертификаты выдаются на рулон?',
		a: 'Сертификат качества завода-изготовителя по ГОСТ 19904, EN 10088 или ASTM A240. Маркировка плавки и номера рулона. По запросу — заводская защитная плёнка PE/PVC.',
	},
];
---

<CatalogHubTemplate
	title="Рулон нержавеющий — AISI 304, 316L, 321, 12Х18Н10Т"
	description="Рулон нержавеющий 0,4–3 мм холоднокатаный с поверхностью 2B, BA, 4N. AISI 304, 316L, 321, 12Х18Н10Т. Ширины 1000, 1250, 1500 мм."
	h1="Рулон нержавеющий"
	intro="Холоднокатаный нержавеющий рулон толщиной 0,4–3 мм, ширина 1000, 1250, 1500 мм. Поставка для собственного раскроя в лист или штрипс. Никелесодержащие марки AISI 304, 316L, 321, 12Х18Н10Т. Поверхности 2B (матовая), BA (зеркальная), 4N (шлифованная), DECO+PE с защитной плёнкой."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Рулон нержавеющий' }]}
	hubHref="/rulon/"
	hubLabel="Рулон нержавеющий"
	faq={faq}
>
	<PriceTable hub="rulon" title="Прайс на рулон нержавеющий" measure="толщина" />

	<HubExtras
		hubHref="/rulon/"
		hubLabel="Рулон нержавеющий"
		hubLabelGenitive="рулон нержавеющий"
		grades={grades}
		surfaces={surfaces}
	/>

	<section class="block">
		<h2>Что входит в раздел</h2>
		<ul class="list-plain">
			<li><strong>Толщины</strong> — 0,4; 0,5; 0,6; 0,8; 1,0; 1,2; 1,5; 2,0; 2,5; 3,0 мм</li>
			<li><strong>Ширины</strong> — 1000, 1250, 1500 мм (ходовые), 600 и 1219 мм по заявке</li>
			<li><strong>Поверхности</strong> — 2B универсальная матовая, BA зеркальная для интерьеров, 4N шлифованная декоративная</li>
			<li><strong>Защитная плёнка PE</strong> с печатью или без — для архитектурного применения</li>
			<li><strong>Марки</strong> — AISI 304/304L, 316L, 321, 430, 12Х18Н10Т</li>
		</ul>
	</section>

	<section class="block">
		<h2>Резка из рулона</h2>
		<p>
			Из рулона мы делаем <a href="/uslugi/rezka-rulonov/">резку в лист</a>
			(длина до 12 м) и <a href="/lenta/proizvodstvo/">продольную резку в штрипс</a> с шагом 5 мм.
			Это даёт цену на 5–10% ниже готового листа той же толщины.
		</p>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Производство сэндвич-панелей и облицовочных элементов</li>
			<li>Заготовка под штамповку посуды, кухонного оборудования</li>
			<li>Кровля и фасады в премиум-сегменте</li>
			<li>Лента для упаковочного и медицинского оборудования</li>
		</ul>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода — ГОСТ 19904 / EN 10088 / ASTM A240</li>
			<li>Защитная плёнка PE / PVC по запросу</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Доставка автотранспортом и ж/д контейнерами</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
	.block p a { color: var(--color-primary-600); }
</style>
