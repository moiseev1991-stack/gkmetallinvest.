---
import CatalogCityHub from '../../components/CatalogCityHub.astro';
import { cities, cityBySlug } from '../../data/cities';

export async function getStaticPaths() {
	return cities.map((c) => ({ params: { city: c.slug } }));
}

const { city: citySlug } = Astro.params;
const city = cityBySlug[citySlug!];
---

<CatalogCityHub
	hub="polosa"
	hubLabel="Полоса нержавеющая"
	hubLabelGenitive="полосу нержавеющую"
	hubHref="/polosa/"
	measure="размер"
	city={city}
/>
