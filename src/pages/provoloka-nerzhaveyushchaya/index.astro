---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any).provoloka as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Какая проволока нужна под сварку AISI 304?',
		a: 'Под AISI 304 берут сварочную проволоку ER308L — с пониженным содержанием углерода (L) для стойкости к межкристаллитной коррозии после сварки. Под AISI 316L — ER316L; под 321 / 12Х18Н10Т — ER347 (по ГОСТ 2246-70 — Св-07Х19Н10Б).',
	},
	{
		q: 'Какая проволока подходит для сварки AISI 304 / 321 / 316L?',
		a: 'Подбор по основной марке: ER308L — для AISI 304 и 304L (по AWS A5.9), ER347 — для AISI 321 (12Х18Н10Т) со стабилизацией титаном, ER316L — для AISI 316/316L и кислотостойких задач. Для разнородной сварки нержавейки с углеродистой сталью — ER309L.',
	},
	{
		q: 'Чем отличается пружинная проволока?',
		a: 'Пружинная по EN 10270-3 (марка 1.4310, аналог AISI 302) имеет повышенный наклёп и предел упругости — выдерживает многократные изгибы без потери формы. Для пружин общего применения, упругих скоб, защёлок.',
	},
	{
		q: 'Минимальная партия — от какого веса заказ?',
		a: 'Отгружаем от 1 кг (бухта или катушка). Цена «от 1 кг» для тонкой проволоки — на странице товара. Возможна перемотка с фабричной катушки на маленькую бухту по запросу.',
	},
	{
		q: 'Подойдёт ли AISI 316L для морской воды?',
		a: 'Да, AISI 316L — лучший выбор для морской воды среди стандартных марок (молибден повышает стойкость к питтингу). Для агрессивных хлоридов (сточные воды, рассолы) — рассмотрите AISI 904L или дуплекс.',
	},
];
---

<CatalogHubTemplate
	title="Проволока нержавеющая — технологическая, пружинная, сварочная"
	description="Нержавеющая проволока 0,11–12 мм: AISI 304/316L/321 (12Х18Н10Т), сварочная ER308L/ER316L/ER347, пружинная по EN 10270-3. Купить от 1 кг."
	h1="Проволока нержавеющая"
	intro={`Проволока нержавеющая Ø 0,11–12 мм трёх назначений: технологическая (вязальная, сетчатая, для гибов), пружинная по EN 10270-3 и сварочная под полуавтомат / TIG. Аустенитные марки 12Х18Н10Т, AISI 304/316L/321 и сварочные ER308L/ER316L — ${skus.length} позиций в наличии в Нижнем Новгороде.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Проволока нержавеющая' }]}
	hubHref="/provoloka-nerzhaveyushchaya/"
	hubLabel="Проволока нержавеющая"
	hubKey="provoloka"
	faq={faq}
>
	<PriceTable hub="provoloka" title="Прайс на проволоку" measure="диаметр" />

	<HubExtras
		hubHref="/provoloka-nerzhaveyushchaya/"
		hubLabel="Проволока нержавеющая"
		hubLabelGenitive="проволоку нержавеющую"
		articles={[
			{ href: '/blog/provoloka-nerzhaveyushchaya/', label: 'Проволока нержавеющая: марки, ГОСТ 18143, сварочная и пружинная' },
			{ href: '/blog/svarka-nerzhaveyki-poluavtomatom/', label: 'Сварка нержавейки полуавтоматом: газ, проволока, режимы' },
			{ href: '/blog/kak-varit-nerzhaveyku/', label: 'Как варить нержавейку: электроды, проволока, режимы' },
			{ href: '/blog/magnitit-li-nerzhaveika/', label: 'Магнитится ли нержавейка' },
			{ href: '/blog/aisi-304-vs-316l-vs-321/', label: 'AISI 304, 316L или 321: какую марку выбрать' },
		]}
		grades={grades}
	/>

	<section class="block">
		<h2>Что входит в раздел</h2>
		<ul class="list-plain">
			<li><strong>Технологическая</strong> — 12Х18Н10Т, AISI 304/316L/321/310S/904L. Для вязки арматуры, плетения сеток, увязки</li>
			<li><strong>Пружинная (EN 10270-3)</strong> — 1.4310 (AISI 302). Для пружин и упругих элементов</li>
			<li><strong>Сварочная</strong> — ER308L (под AISI 304), ER316L (под 316L). Диаметры в каталоге — от 1,2 до 5 мм</li>
			<li><strong>Ферритная</strong> — AISI 410, 430. Недорогие хромистые марки для сред без высоких требований к коррозии</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Сетки тканые и сварные — фильтры, грохоты, защитные ограждения</li>
			<li>Сварка нержавеющих сталей — ручная TIG и полуавтоматическая MIG</li>
			<li>Метизные пружины и пружинные кольца</li>
			<li>Вязка арматуры в коррозионно-стойкой среде</li>
			<li>Плетение канатов и тросов морского применения</li>
		</ul>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода — ГОСТ 18143 / EN 10088-3</li>
			<li>Поставка бухтами и катушками от 1 кг</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Транспортные компании по всей России</li>
		</ul>
	</section>

	<section class="block">
		<h2>Типы нержавеющей проволоки: сварочная, вязальная, пружинная</h2>
		<p>Нержавеющая проволока делится на три назначения. Каждое — со своим стандартом, состоянием поставки и размерным рядом.</p>
		<ul class="list-plain">
			<li><strong>Сварочная</strong> — для TIG / MIG-сварки по ГОСТ 2246 и зарубежной классификации AWS A5.9. Типовые соответствия: ER308L = AISI 304 / 304L, ER316L = AISI 316L, ER347 = AISI 321 (12Х18Н10Т). Диаметры в каталоге — от 1,2 до 5 мм; формат поставки (бухта, катушка) уточняйте при заказе</li>
			<li><strong>Вязальная</strong> — мягкая термообработанная (отожжённая) проволока, Ø 0,5–3 мм. Для арматурных каркасов, увязки пакетов, бытовых задач, где нужна пластичность без пружинных свойств</li>
			<li><strong>Пружинная</strong> — холоднотянутая (нагартованная) проволока. Для пружин, упругих скоб, защёлок и фиксаторов в коррозионной среде</li>
		</ul>
		<p>Технические марки: AISI 304 (08Х18Н10), AISI 321 (12Х18Н10Т), AISI 316L (03Х17Н14М3), AISI 430 (12Х17). Для пружин — специальная пружинная проволока 1.4310 по EN 10270-3 (в таблицах её сопоставляют с AISI 301 и 302). Нержавейка проволока из аустенитных марок не магнитится в свежекатаном виде; после нагартовки появляется лёгкая магнитность.</p>
	</section>

	<section class="block">
		<h2>Диаметры и состояния поставки</h2>
		<p>Диапазон размеров — от 0,1 мм (тонкая ёмкостная и проволока для медицинских аппаратов) до 12 мм в нашем каталоге. Основной стандарт на тянутую проволоку из нержавейки — ГОСТ 18143-72 (диаметры 0,20–7,50 мм); подробно — в статье <a href="/blog/provoloka-nerzhaveyushchaya/">«Проволока нержавеющая: марки, ГОСТ 18143, сварочная и пружинная»</a>.</p>
		<ul class="list-plain">
			<li><strong>Термообработанная</strong> (вид Т — оксидированная, ТС — светлая) — мягкая, для вязки, формовки, плетения сеток</li>
			<li><strong>Повышенная точность по диаметру</strong> (П) — для деталей, где важен допуск</li>
			<li><strong>Холоднотянутая</strong> (вид Х, нагартованная) — повышенная прочность, для упругих элементов</li>
		</ul>
		<p>Упаковка — бухты и катушки; вес и тип упаковки согласуем при заказе.</p>
	</section>

	<section class="block">
		<h2>Сварочная проволока для нержавейки — какую марку выбрать</h2>
		<p>Сварочная нержавеющая проволока подбирается по основной марке свариваемой стали — состав присадки повторяет химию основного металла с поправкой на углерод и стабилизаторы.</p>
		<ul class="list-plain">
			<li><strong>ER308L</strong> (AISI 308L) — универсальный заполнитель для сварки AISI 304 / 304L. Самый ходовой типоразмер на складе</li>
			<li><strong>ER316L</strong> — для сварки AISI 316 / 316L, оборудования под пищевые кислоты и морскую воду</li>
			<li><strong>ER347</strong> — для сварки AISI 321 (12Х18Н10Т) и других стабилизированных титаном сталей; альтернатива — ER321</li>
			<li><strong>ER309L</strong> — для разнородной сварки нержавеющей стали с углеродистой и низколегированной</li>
		</ul>
		<p>Сварочная проволока в каталоге — диаметры от 1,2 до 5 мм. Проволока нержавеющая 12Х18Н10Т и AISI 321 в сварочном исполнении — ER347 (альтернатива ER321).</p>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
</style>
