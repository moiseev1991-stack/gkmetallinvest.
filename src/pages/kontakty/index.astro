---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { siteName, siteUrl, contacts, orgAddress } from '../../data/site';

const localBusinessJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${siteUrl}/#localbusiness`,
	name: siteName,
	legalName: contacts.company,
	url: siteUrl,
	logo: `${siteUrl}/img/logo.png`,
	telephone: contacts.phone,
	email: contacts.email,
	taxID: contacts.inn,
	priceRange: '₽₽',
	address: { '@type': 'PostalAddress', ...orgAddress },
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '09:00',
			closes: '18:00',
		},
	],
};

const channels = [
	{
		icon: 'phone',
		label: 'Телефон',
		value: contacts.phone,
		href: `tel:${contacts.phoneTel}`,
		hint: 'Звонок — самый быстрый канал. Менеджер примет заявку за 5 минут.',
	},
	{
		icon: 'mail',
		label: 'Email',
		value: contacts.email,
		href: `mailto:${contacts.email}`,
		hint: 'ТЗ, чертежи, спецификации — присылайте на почту, ответим в течение часа.',
	},
	{
		icon: 'form',
		label: 'Заявка на КП',
		value: 'Через форму',
		href: '/zapros-kp/#lead-form',
		hint: 'Опишите задачу — пришлём коммерческое предложение с ценой и сроками.',
	},
];

const requisites = [
	{ k: 'Юридическое лицо', v: contacts.company },
	{ k: 'ИНН', v: contacts.inn },
	{ k: 'КПП', v: '526001001' },
	{ k: 'ОГРН', v: '1165262052889' },
	{ k: 'Юр. адрес', v: contacts.address },
];

/* Координаты офиса для Яндекс.Карты: 603006, Нижний Новгород, Варварская 32. */
const yMapsSrc =
	'https://yandex.ru/map-widget/v1/?text=' +
	encodeURIComponent('Нижний Новгород, ул. Варварская, 32') +
	'&z=17&pt=44.00465,56.32849,pm2rdm';
---

<BaseLayout
	title="Контакты"
	description="Контакты ГК Металлинвест: телефон +7 (831) 281-26-60, email zakaz@gkmetallinvest.ru, офис в Нижнем Новгороде на ул. Варварской, 32. Режим работы пн-пт 9:00-18:00."
	jsonLd={localBusinessJsonLd}
>
	<div class="container page">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Контакты' }]} />

		<header class="page__hero">
			<span class="eyebrow">Контакты</span>
			<h1>Свяжитесь с нами</h1>
			<p class="page__lead">
				Менеджеры на связи в рабочие часы — отвечают на звонки, считают КП и подбирают марку
				под задачу. Если позиция есть на складе — отгружаем в день оплаты.
			</p>
		</header>

		<section class="contacts">
			<div class="contacts__channels">
				{channels.map((c) => (
					<a class="ch-card" href={c.href}>
						<span class="ch-card__ico" aria-hidden="true">
							{c.icon === 'phone' && (
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							)}
							{c.icon === 'mail' && (
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
							)}
							{c.icon === 'form' && (
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
							)}
						</span>
						<div>
							<span class="ch-card__label">{c.label}</span>
							<span class="ch-card__value">{c.value}</span>
							<span class="ch-card__hint">{c.hint}</span>
						</div>
					</a>
				))}
			</div>

			<aside class="hours">
				<header>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="10"/>
						<polyline points="12 6 12 12 16 14"/>
					</svg>
					<span>Режим работы</span>
				</header>
				<dl>
					<div><dt>Понедельник — пятница</dt><dd>09:00 — 18:00</dd></div>
					<div><dt>Суббота — воскресенье</dt><dd class="hours__off">выходной</dd></div>
				</dl>
				<p class="hours__note">Заявки с сайта и почты обрабатываем в первый рабочий день, обычно — в течение часа.</p>
			</aside>
		</section>

		<section class="map-section">
			<div class="map-info">
				<h2>Офис и склад</h2>
				<p class="addr">
					<strong>{contacts.address.replace('603006, ', '').replace(', помещ. П5, офис 417', '')}</strong>
					<br/>
					<span class="addr__zip">603006 · помещ. П5, офис 417</span>
				</p>
				<ul class="route">
					<li>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M6 6V4h12v2M6 18v2M18 18v2"/><circle cx="8" cy="14" r="1"/><circle cx="16" cy="14" r="1"/></svg>
						<span>Станция метро «Горьковская» — 7 минут пешком</span>
					</li>
					<li>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"/><path d="M6 11V7a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v4"/></svg>
						<span>Платная парковка на ул. Варварской и в БЦ</span>
					</li>
					<li>
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2C7.58 2 4 5.58 4 10c0 6 8 12 8 12s8-6 8-12c0-4.42-3.58-8-8-8z"/><circle cx="12" cy="10" r="3"/></svg>
						<span>Склад с отгрузками — адрес и проезд согласует менеджер при оформлении заказа</span>
					</li>
				</ul>
			</div>

			<div class="map-frame" aria-label="Карта: ул. Варварская, 32, Нижний Новгород">
				<iframe
					src={yMapsSrc}
					width="100%"
					height="100%"
					frameborder="0"
					allowfullscreen
					loading="lazy"
					title="Офис ГК Металлинвест на Яндекс.Картах"
				></iframe>
			</div>
		</section>

		<section class="reqs-section">
			<h2>Реквизиты для договора</h2>
			<dl class="reqs">
				{requisites.map((r) => (
					<>
						<dt>{r.k}</dt>
						<dd>{r.v}</dd>
					</>
				))}
			</dl>
			<p class="reqs__hint">Полную карточку контрагента и банковские реквизиты пришлём после оформления заявки.</p>
		</section>
	</div>

	<CtaSection
		title="Не нашли нужное?"
		text="Опишите задачу — менеджер подберёт марку, формат и логистику в течение 30 минут."
	/>
</BaseLayout>

<style>
	.page { padding-block: var(--space-8); }
	.page__hero { margin-bottom: var(--space-8); max-width: 80ch; }
	.page__lead {
		font-size: 1.05rem;
		max-width: 70ch;
		margin: var(--space-3) 0 0;
		color: var(--color-text);
		line-height: 1.6;
	}

	/* Каналы связи + режим */
	.contacts {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		margin-bottom: var(--space-8);
	}
	@media (min-width: 900px) {
		.contacts { grid-template-columns: 2fr 1fr; }
	}
	.contacts__channels {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: var(--space-3);
	}
	.ch-card {
		display: flex;
		gap: var(--space-3);
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: inherit;
		min-width: 0;
		transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.ch-card:hover {
		transform: translateY(-2px);
		border-color: var(--color-primary-100);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: inherit;
	}
	/* Текстовая колонка внутри карточки — обязательно min-width: 0,
	   иначе длинные слова без пробелов (email) вылезают за рамку. */
	.ch-card > div { min-width: 0; flex: 1; }
	.ch-card__ico {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 44px;
		width: 44px;
		height: 44px;
		border-radius: var(--radius-md);
		background: var(--color-primary-50);
		color: var(--color-primary-500);
	}
	.ch-card__label {
		display: block;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-subtle);
		margin-bottom: 0.1rem;
	}
	.ch-card__value {
		display: block;
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.2rem;
		overflow-wrap: anywhere;
		word-break: break-word;
	}
	.ch-card__hint {
		display: block;
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.4;
		overflow-wrap: anywhere;
	}

	.hours {
		padding: var(--space-4) var(--space-5);
		background: var(--color-primary-50);
		border: 1px solid var(--color-primary-100);
		border-radius: var(--radius-lg);
	}
	.hours header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: var(--space-3);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-primary-600);
	}
	.hours dl { margin: 0 0 var(--space-3); display: grid; gap: var(--space-2); }
	.hours dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
	.hours dt { font-size: 0.9rem; color: var(--color-muted); }
	.hours dd { margin: 0; font-family: var(--font-mono); font-weight: 600; color: var(--color-text); font-size: 0.95rem; }
	.hours__off { color: var(--color-subtle); font-weight: 400; font-style: italic; font-family: var(--font-sans); }
	.hours__note { margin: 0; font-size: 0.82rem; color: var(--color-muted); line-height: 1.45; }

	/* Карта + описание проезда */
	.map-section {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		margin-bottom: var(--space-8);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		overflow: hidden;
		box-shadow: var(--shadow-xs);
	}
	@media (min-width: 900px) {
		.map-section { grid-template-columns: 360px 1fr; }
	}
	.map-info { padding: var(--space-5); }
	.map-info h2 {
		margin: 0 0 var(--space-3);
		font-size: 1.15rem;
	}
	.addr {
		margin: 0 0 var(--space-4);
		color: var(--color-text);
		font-size: 0.96rem;
		line-height: 1.5;
		max-width: none;
	}
	.addr__zip {
		font-size: 0.85rem;
		color: var(--color-muted);
	}
	.route {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.6rem;
	}
	.route li {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		font-size: 0.88rem;
		color: var(--color-muted);
		line-height: 1.45;
	}
	.route svg {
		flex: 0 0 16px;
		margin-top: 2px;
		color: var(--color-primary-500);
	}
	.map-frame {
		min-height: 360px;
		background: var(--color-bg-elev);
	}
	.map-frame iframe { display: block; border: 0; min-height: 360px; }

	.reqs-section {
		padding: var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		margin-bottom: var(--space-8);
	}
	.reqs-section h2 {
		margin: 0 0 var(--space-4);
		font-size: 1.15rem;
	}
	.reqs {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: var(--space-2) var(--space-5);
		margin: 0;
		font-size: 0.93rem;
	}
	.reqs dt {
		color: var(--color-subtle);
		font-size: 0.82rem;
		font-weight: 500;
	}
	.reqs dd {
		margin: 0;
		color: var(--color-text);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
	.reqs__hint {
		margin: var(--space-4) 0 0;
		font-size: 0.82rem;
		color: var(--color-muted);
	}
	@media (max-width: 540px) {
		.reqs { grid-template-columns: 1fr; gap: 0.1rem var(--space-3); }
		.reqs dt { margin-top: var(--space-2); }
		.reqs dt:first-child { margin-top: 0; }
	}
</style>
