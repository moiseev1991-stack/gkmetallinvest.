---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { siteName, siteUrl, contacts, orgAddress, orgGeo, orgMapUrl } from '../../data/site';
import { offices, officeMapSrc, officeFullAddress } from '../../data/offices';

const openingHours = [
	{
		'@type': 'OpeningHoursSpecification',
		dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
		opens: '09:00',
		closes: '18:00',
	},
];

/* Ссылка на Яндекс.Карты (не виджет) для hasMap в schema.org. */
const officeMapLink = (query: string) =>
	'https://yandex.ru/maps/?text=' + encodeURIComponent(query);

/* Головной офис (Нижний Новгород) — основной LocalBusiness с координатами. */
const headOffice = offices.find((o) => o.isHead)!;
const branchOffices = offices.filter((o) => !o.isHead);

const headJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${siteUrl}/#localbusiness`,
	name: siteName,
	legalName: contacts.company,
	url: siteUrl,
	logo: `${siteUrl}/img/logo.png`,
	telephone: headOffice.phone ?? contacts.phone,
	email: headOffice.email ?? contacts.email,
	taxID: contacts.inn,
	priceRange: '₽₽',
	address: { '@type': 'PostalAddress', ...orgAddress },
	geo: { '@type': 'GeoCoordinates', latitude: orgGeo.latitude, longitude: orgGeo.longitude },
	hasMap: orgMapUrl,
	openingHoursSpecification: openingHours,
};

/* Филиалы — отдельные LocalBusiness, связаны с головным через parentOrganization. */
const branchJsonLd = branchOffices.map((o) => ({
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	'@id': `${siteUrl}/kontakty/#${o.slug}`,
	name: `${siteName} — ${o.city}`,
	parentOrganization: { '@id': `${siteUrl}/#localbusiness` },
	url: `${siteUrl}/kontakty/`,
	telephone: o.phone ?? contacts.phone,
	email: o.email ?? contacts.email,
	priceRange: '₽₽',
	address: {
		'@type': 'PostalAddress',
		streetAddress: o.street,
		addressLocality: o.city,
		...(o.region ? { addressRegion: o.region } : {}),
		postalCode: o.zip,
		addressCountry: 'RU',
	},
	hasMap: officeMapLink(o.mapQuery),
	openingHoursSpecification: openingHours,
}));

const jsonLd = [headJsonLd, ...branchJsonLd];

/* В email подмешиваем <wbr> после @ и перед .ru — браузер сможет
   перенести в логичном месте, а не посреди слова «gkmetallinvest». */
const emailHtml = contacts.email
	.replace('@', '@<wbr>')
	.replace(/\.([a-z]{2,})$/i, '<wbr>.$1');

const channels = [
	{
		icon: 'phone',
		label: 'Телефон',
		value: contacts.phone,
		href: `tel:${contacts.phoneTel}`,
		hint: 'Звонок — самый быстрый канал. Менеджер примет заявку за 5 минут.',
	},
	{
		icon: 'mail',
		label: 'Email',
		valueHtml: emailHtml,
		href: `mailto:${contacts.email}`,
		hint: 'ТЗ, чертежи, спецификации — присылайте на почту, ответим в течение часа.',
	},
	{
		icon: 'form',
		label: 'Заявка на КП',
		value: 'Через форму',
		href: '/zapros-kp/#lead-form',
		hint: 'Опишите задачу — пришлём коммерческое предложение с ценой и сроками.',
	},
] as Array<{
	icon: string;
	label: string;
	value?: string;
	valueHtml?: string;
	href: string;
	hint: string;
}>;

const requisites = [
	{ k: 'Юридическое лицо', v: contacts.company },
	{ k: 'ИНН', v: contacts.inn },
	{ k: 'КПП', v: '526001001' },
	{ k: 'ОГРН', v: '1165262052889' },
	{ k: 'Юр. адрес', v: contacts.address },
];
---

<BaseLayout
	title="Контакты"
	description="Контакты ГК Металлинвест: телефон +7 (831) 281-26-60, email zakaz@gkmetallinvest.ru. Офисы и склады в 7 городах — Нижний Новгород, Москва (Пушкино), Санкт-Петербург, Екатеринбург, Новосибирск, Ростов-на-Дону, Краснодар. Режим работы пн-пт 9:00-18:00."
	jsonLd={jsonLd}
>
	<div class="container page">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Контакты' }]} />

		<header class="page__hero">
			<span class="eyebrow">Контакты</span>
			<h1>Свяжитесь с нами</h1>
			<p class="page__lead">
				Менеджеры на связи в рабочие часы — отвечают на звонки, считают КП и подбирают марку
				под задачу. Если позиция есть на складе — отгружаем в день оплаты.
			</p>
		</header>

		<section class="contacts">
			<div class="contacts__channels">
				{channels.map((c) => (
					<a class="ch-card" href={c.href}>
						<span class="ch-card__ico" aria-hidden="true">
							{c.icon === 'phone' && (
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
							)}
							{c.icon === 'mail' && (
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
							)}
							{c.icon === 'form' && (
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="13" y2="17"/></svg>
							)}
						</span>
						<div>
							<span class="ch-card__label">{c.label}</span>
							{c.valueHtml
								? <span class="ch-card__value" set:html={c.valueHtml} />
								: <span class="ch-card__value">{c.value}</span>
							}
							<span class="ch-card__hint">{c.hint}</span>
						</div>
					</a>
				))}
			</div>

			<aside class="hours">
				<header>
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="10"/>
						<polyline points="12 6 12 12 16 14"/>
					</svg>
					<span>Режим работы</span>
				</header>
				<dl>
					<div><dt>Понедельник — пятница</dt><dd>09:00 — 18:00</dd></div>
					<div><dt>Суббота — воскресенье</dt><dd class="hours__off">выходной</dd></div>
				</dl>
				<p class="hours__note">Заявки с сайта и почты обрабатываем в первый рабочий день, обычно — в течение часа.</p>
			</aside>
		</section>

		<section class="offices">
			<header class="offices__head">
				<h2>Офисы и склады</h2>
				<p>Отгружаем со складов в {offices.length} городах. Выберите ближайший — адрес, карта и контакты ниже.</p>
			</header>

			<div class="offices__grid">
				{offices.map((o) => (
					<article class="office" id={o.slug}>
						<div class="office__info">
							<div class="office__media">
								{o.photo
									? <img src={o.photo} alt={`Офис ГК Металлинвест в городе ${o.city}`} loading="lazy" width="360" height="220" />
									: (
										<div class="office__ph" aria-hidden="true">
											<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
											<span>Фото офиса</span>
										</div>
									)
								}
							</div>

							<div class="office__text">
								<h3 class="office__city">
									{o.city}
									{o.isHead && <span class="office__badge">Головной офис</span>}
								</h3>
								<p class="office__addr">
									<strong>{o.street}</strong>
									<br/>
									<span class="office__zip">{o.zip}{o.region ? ` · ${o.region}` : ''}</span>
								</p>
								<dl class="office__contacts">
									<div>
										<dt>
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
										</dt>
										<dd><a href={`tel:${o.phoneTel ?? contacts.phoneTel}`}>{o.phone ?? contacts.phone}</a></dd>
									</div>
									<div>
										<dt>
											<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
										</dt>
										<dd><a href={`mailto:${o.email ?? contacts.email}`}>{o.email ?? contacts.email}</a></dd>
									</div>
								</dl>
							</div>
						</div>

						<div class="office__map" aria-label={`Карта: ${officeFullAddress(o)}`}>
							<iframe
								src={officeMapSrc(o)}
								width="100%"
								height="100%"
								frameborder="0"
								allowfullscreen
								loading="lazy"
								title={`Офис ГК Металлинвест — ${o.city} на Яндекс.Картах`}
							></iframe>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="reqs-section">
			<h2>Реквизиты для договора</h2>
			<dl class="reqs">
				{requisites.map((r) => (
					<>
						<dt>{r.k}</dt>
						<dd>{r.v}</dd>
					</>
				))}
			</dl>
			<p class="reqs__hint">Полную карточку контрагента и банковские реквизиты пришлём после оформления заявки.</p>
		</section>
	</div>

	<CtaSection
		title="Не нашли нужное?"
		text="Опишите задачу — менеджер подберёт марку, формат и логистику в течение 30 минут."
	/>
</BaseLayout>

<style>
	.page { padding-block: var(--space-8); }
	.page__hero { margin-bottom: var(--space-8); max-width: 80ch; }
	.page__lead {
		font-size: 1.05rem;
		max-width: 70ch;
		margin: var(--space-3) 0 0;
		color: var(--color-text);
		line-height: 1.6;
	}

	/* Каналы связи + режим */
	.contacts {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		margin-bottom: var(--space-8);
	}
	@media (min-width: 900px) {
		.contacts { grid-template-columns: 2fr 1fr; }
	}
	.contacts__channels {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
		gap: var(--space-3);
	}
	.ch-card {
		display: flex;
		gap: var(--space-3);
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		text-decoration: none;
		color: inherit;
		min-width: 0;
		transition: transform var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.ch-card:hover {
		transform: translateY(-2px);
		border-color: var(--color-primary-100);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		color: inherit;
	}
	/* Текстовая колонка внутри карточки — обязательно min-width: 0,
	   иначе длинные слова без пробелов (email) вылезают за рамку. */
	.ch-card > div { min-width: 0; flex: 1; }
	.ch-card__ico {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 40px;
		width: 40px;
		height: 40px;
		border-radius: var(--radius-md);
		background: var(--color-primary-50);
		color: var(--color-primary-500);
	}
	.ch-card__ico svg { width: 20px; height: 20px; }
	.ch-card__label {
		display: block;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-subtle);
		margin-bottom: 0.1rem;
	}
	.ch-card__value {
		display: block;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--color-text);
		margin-bottom: 0.25rem;
		/* break-word — мягкий перенос: ломает слова ТОЛЬКО когда без этого
		   контент вышел бы за рамку. В сочетании с <wbr> внутри email-а
		   браузер выбирает логичную точку переноса (после @, перед .ru). */
		overflow-wrap: break-word;
		line-height: 1.3;
	}
	.ch-card__hint {
		display: block;
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.4;
	}

	.hours {
		padding: var(--space-4) var(--space-5);
		background: var(--color-primary-50);
		border: 1px solid var(--color-primary-100);
		border-radius: var(--radius-lg);
	}
	.hours header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: var(--space-3);
		font-weight: 700;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-primary-600);
	}
	.hours dl { margin: 0 0 var(--space-3); display: grid; gap: var(--space-2); }
	.hours dl > div { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-3); }
	.hours dt { font-size: 0.9rem; color: var(--color-muted); }
	.hours dd { margin: 0; font-family: var(--font-mono); font-weight: 600; color: var(--color-text); font-size: 0.95rem; }
	.hours__off { color: var(--color-subtle); font-weight: 400; font-style: italic; font-family: var(--font-sans); }
	.hours__note { margin: 0; font-size: 0.82rem; color: var(--color-muted); line-height: 1.45; }

	/* Офисы по городам */
	.offices { margin-bottom: var(--space-8); }
	.offices__head { margin-bottom: var(--space-5); }
	.offices__head h2 { margin: 0 0 var(--space-2); font-size: 1.3rem; }
	.offices__head p { margin: 0; color: var(--color-muted); font-size: 0.95rem; max-width: 70ch; }

	.offices__grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
	}
	@media (min-width: 1100px) {
		.offices__grid { grid-template-columns: repeat(2, 1fr); }
	}

	.office {
		display: grid;
		grid-template-columns: 1fr;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		overflow: hidden;
		box-shadow: var(--shadow-xs);
	}
	.office__info { padding: var(--space-4) var(--space-5) var(--space-5); }

	/* Место под фото офиса — заказчик заменит плейсхолдер картинкой */
	.office__media {
		margin-bottom: var(--space-4);
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-elev);
		aspect-ratio: 16 / 9;
	}
	.office__media img { display: block; width: 100%; height: 100%; object-fit: cover; }
	.office__ph {
		width: 100%;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		color: var(--color-subtle);
		border: 1px dashed var(--color-border);
		border-radius: var(--radius-md);
	}
	.office__ph span { font-size: 0.8rem; letter-spacing: 0.02em; }

	.office__city {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 var(--space-2);
		font-size: 1.1rem;
	}
	.office__badge {
		font-size: 0.68rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-primary-600);
		background: var(--color-primary-50);
		border: 1px solid var(--color-primary-100);
		padding: 0.15rem 0.5rem;
		border-radius: var(--radius-sm);
	}
	.office__addr {
		margin: 0 0 var(--space-3);
		color: var(--color-text);
		font-size: 0.95rem;
		line-height: 1.5;
		max-width: none;
	}
	.office__zip { font-size: 0.85rem; color: var(--color-muted); }

	.office__contacts { margin: 0; display: grid; gap: 0.4rem; }
	.office__contacts > div { display: flex; align-items: center; gap: 0.55rem; }
	.office__contacts dt { display: inline-flex; color: var(--color-primary-500); flex: 0 0 auto; margin: 0; }
	.office__contacts dd { margin: 0; font-size: 0.92rem; }
	.office__contacts a { color: var(--color-text); text-decoration: none; font-weight: 500; }
	.office__contacts a:hover { color: var(--color-primary-600); text-decoration: underline; }

	.office__map {
		min-height: 260px;
		background: var(--color-bg-elev);
		border-top: 1px solid var(--color-border);
	}
	.office__map iframe { display: block; border: 0; min-height: 260px; }

	.reqs-section {
		padding: var(--space-5);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		margin-bottom: var(--space-8);
	}
	.reqs-section h2 {
		margin: 0 0 var(--space-4);
		font-size: 1.15rem;
	}
	.reqs {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: var(--space-2) var(--space-5);
		margin: 0;
		font-size: 0.93rem;
	}
	.reqs dt {
		color: var(--color-subtle);
		font-size: 0.82rem;
		font-weight: 500;
	}
	.reqs dd {
		margin: 0;
		color: var(--color-text);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}
	.reqs__hint {
		margin: var(--space-4) 0 0;
		font-size: 0.82rem;
		color: var(--color-muted);
	}
	@media (max-width: 540px) {
		.reqs { grid-template-columns: 1fr; gap: 0.1rem var(--space-3); }
		.reqs dt { margin-top: var(--space-2); }
		.reqs dt:first-child { margin-top: 0; }
	}
</style>
