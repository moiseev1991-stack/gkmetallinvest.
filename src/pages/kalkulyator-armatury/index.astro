---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';

const title = 'Калькулятор веса арматуры — ГОСТ 5781-82, А500С, А400, А240';
const description =
	'Онлайн-расчёт массы арматуры А500С / А400 / А240 по диаметру, длине и количеству. ' +
	'Таблица веса 1 метра арматуры Ø 6–36 мм по ГОСТ 5781-82. Обратный пересчёт от массы.';

/* ГОСТ 5781-82 — теоретическая масса 1 м арматуры периодического профиля.
   Значения одинаковы для классов А240, А400, А500С — класс прочности на массу не влияет. */
const armaturaRows = [
	{ d: 6, m1: 0.222, area: 28.3 },
	{ d: 8, m1: 0.395, area: 50.3 },
	{ d: 10, m1: 0.617, area: 78.5 },
	{ d: 12, m1: 0.888, area: 113.1 },
	{ d: 14, m1: 1.208, area: 153.9 },
	{ d: 16, m1: 1.578, area: 201.1 },
	{ d: 18, m1: 1.998, area: 254.5 },
	{ d: 20, m1: 2.466, area: 314.2 },
	{ d: 22, m1: 2.984, area: 380.1 },
	{ d: 25, m1: 3.853, area: 490.9 },
	{ d: 28, m1: 4.834, area: 615.8 },
	{ d: 32, m1: 6.313, area: 804.2 },
	{ d: 36, m1: 7.99, area: 1017.9 },
];

const klassy = [
	{
		value: 'A500C',
		label: 'А500С',
		gost: 'ГОСТ Р 52544-2006',
		applic: 'основной строительный класс — фундаменты, плиты, колонны, монолитные перекрытия',
	},
	{
		value: 'A400',
		label: 'А400 (A-III)',
		gost: 'ГОСТ 5781-82',
		applic: 'традиционный класс, применяется в типовых проектах и при реконструкции',
	},
	{
		value: 'A240',
		label: 'А240 (A-I)',
		gost: 'ГОСТ 5781-82',
		applic: 'гладкий пруток, монтажные элементы, хомуты, вязка',
	},
];

const faq = [
	{
		q: 'Сколько весит 1 метр арматуры Ø 12?',
		a: 'Один метр арматуры диаметром 12 мм весит 0,888 кг по ГОСТ 5781-82 — независимо от класса (А240, А400, А500С). Класс влияет на прочность, но не на массу: масса считается по номинальному диаметру с учётом стандартного периодического профиля. В практике строители округляют до 0,89 кг/м.',
	},
	{
		q: 'Какие диаметры арматуры выпускаются по ГОСТ 5781-82?',
		a: 'Стандартный ряд номинальных диаметров: 6, 8, 10, 12, 14, 16, 18, 20, 22, 25, 28, 32, 36, 40, 45, 50, 55, 60, 70, 80 мм. На практике массово применяются Ø 6–32 мм. Диаметры 40+ — для тяжёлых железобетонных конструкций по индивидуальным заказам.',
	},
	{
		q: 'В чём разница между А400 и А500С?',
		a: 'А400 (старое обозначение А-III) и А500С — разные классы прочности. А500С имеет нормированный предел текучести 500 МПа против 400 МПа у А400 и нормированную свариваемость (буква «С»). По массе для одного диаметра арматура идентична. А500С — действующий стандарт для нового строительства по ГОСТ Р 52544-2006.',
	},
	{
		q: 'Сколько метров арматуры в тонне?',
		a: 'Зависит от диаметра. Ø 10 — 1620 м/т (1000 / 0,617). Ø 12 — 1126 м/т. Ø 14 — 828 м/т. Ø 16 — 634 м/т. Ø 20 — 405 м/т. Ø 25 — 260 м/т. В калькуляторе выше — обратный пересчёт: введите массу в тоннах или килограммах, получите количество прутков заданной длины.',
	},
	{
		q: 'Бывает ли нержавеющая арматура?',
		a: 'Да. Нержавеющая арматура выпускается из марок AISI 304L, 316L и дуплекс 2205. Применяется в агрессивных средах: морские конструкции, мосты в прибрежных зонах, химические производства, объекты с проектным сроком службы 50+ лет. Стандартизирована по EN 10080 и ASTM A955. Стоимость в 8–15 раз выше углеродистой А500С, поэтому используется точечно. У нас в каталоге нержавеющего проката — поставка под заявку.',
	},
	{
		q: 'Учитываются ли поперечные рёбра в весе арматуры?',
		a: 'Да. Значения m₁ в ГОСТ 5781-82 — теоретическая масса с учётом стандартного периодического профиля (продольных рёбер и поперечных выступов). Это не «гладкий цилиндр» π·d²/4·ρ — в расчёт включён реальный объём ребристого стержня. Допустимое отклонение по массе — ±5 % по ГОСТ.',
	},
	{
		q: 'Длина прутка арматуры — какие стандартные?',
		a: 'По ГОСТ 5781-82 арматуру поставляют мерной длиной 6, 11,7 и 12 м, а также немерной длиной от 6 до 12 м. На стройплощадке Ø 6–10 мм часто идёт в бухтах длиной 50–200 м. В калькуляторе длина прутка задаётся вручную — можно вводить любое значение, в том числе дробное.',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const howToJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'Как рассчитать вес арматуры',
	description:
		'Расчёт массы арматурного стержня по номинальному диаметру и длине согласно ГОСТ 5781-82.',
	step: [
		{ '@type': 'HowToStep', name: 'Выбрать диаметр', text: 'Номинальный диаметр от 6 до 36 мм по ГОСТ 5781-82.' },
		{ '@type': 'HowToStep', name: 'Ввести длину прутка', text: 'Длина одного стержня — обычно 6, 11,7 или 12 м.' },
		{ '@type': 'HowToStep', name: 'Ввести количество', text: 'Число прутков в партии, либо ввести нужную массу для обратного пересчёта.' },
		{ '@type': 'HowToStep', name: 'Получить результат', text: 'Калькулятор покажет вес одного прутка и общий вес партии в килограммах или тоннах.' },
	],
};
---

<BaseLayout title={title} description={description} jsonLd={[faqJsonLd, howToJsonLd]}>
	<div class="container arm">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Калькулятор веса арматуры' }]} />

		<header class="arm__hero">
			<span class="arm__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4" />
					<path d="M2 5h1.5M2 8h1.5M2 11h1.5M12.5 5H14M12.5 8H14M12.5 11H14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
				ГОСТ 5781-82
			</span>
			<h1 class="arm__h1">Калькулятор веса <span class="arm__h1-accent">арматуры</span></h1>
			<p class="arm__lead">
				Расчёт массы арматурных стержней А500С, А400 и А240 по диаметру и длине.
				Используются справочные значения теоретической массы 1 погонного метра
				из ГОСТ 5781-82 — с учётом поперечного периодического профиля.
				Допуск по массе ±5 %.
			</p>
		</header>

		<section class="arm__widget" data-arm-root>
			<div class="arm__widget-inner">
				<div class="arm__form">
					<div class="arm__field">
						<label class="arm__label" for="arm-klass">Класс арматуры</label>
						<select class="arm__input" id="arm-klass" data-arm-klass>
							{klassy.map((k) => (
								<option value={k.value}>{k.label} — {k.gost}</option>
							))}
						</select>
						<p class="arm__hint" data-arm-klass-hint>{klassy[0].applic}</p>
					</div>

					<div class="arm__field">
						<label class="arm__label" for="arm-d">Номинальный диаметр, мм</label>
						<select class="arm__input" id="arm-d" data-arm-diameter>
							{armaturaRows.map((r) => (
								<option value={r.d} selected={r.d === 12}>
									Ø {r.d} — {r.m1.toLocaleString('ru-RU', { minimumFractionDigits: 3 })} кг/м
								</option>
							))}
						</select>
					</div>

					<div class="arm__row-2">
						<div class="arm__field">
							<label class="arm__label" for="arm-len">Длина прутка, м</label>
							<input class="arm__input" id="arm-len" type="number" inputmode="decimal" step="any" min="0.01" value="6" data-arm-length />
							<p class="arm__hint">Типовые: 6 · 11,7 · 12 м</p>
						</div>

						<div class="arm__field">
							<label class="arm__label" for="arm-qty">Количество прутков</label>
							<input class="arm__input" id="arm-qty" type="number" inputmode="decimal" step="any" min="1" value="1" data-arm-qty />
							<p class="arm__hint">Или укажите массу ниже</p>
						</div>
					</div>

					<div class="arm__field">
						<label class="arm__label" for="arm-mass">Нужная масса (обратный расчёт)</label>
						<div class="arm__mass-wrap">
							<input class="arm__input arm__mass-input" id="arm-mass" type="number" inputmode="decimal" step="any" min="0" placeholder="—" data-arm-mass />
							<select class="arm__mass-unit" data-arm-mass-unit aria-label="Единицы массы">
								<option value="t" selected>т</option>
								<option value="kg">кг</option>
							</select>
						</div>
						<p class="arm__hint">Введите массу — пересчитаем количество прутков заданной длины</p>
					</div>
				</div>

				<aside class="arm__result">
					<div class="arm__result-card">
						<div class="arm__result-eyebrow">Расчёт по ГОСТ 5781-82</div>

						<div class="arm__result-row">
							<span>Вес 1 метра</span>
							<strong data-arm-m1>—</strong>
						</div>
						<div class="arm__result-row">
							<span>Вес 1 прутка</span>
							<strong data-arm-prut>—</strong>
						</div>

						<div class="arm__result-total">
							<span class="arm__result-total-label">Общий вес партии</span>
							<div class="arm__result-total-value" data-arm-total>—</div>
							<div class="arm__result-total-sub" data-arm-total-sub></div>
						</div>

						<dl class="arm__result-meta">
							<div><dt>Сечение</dt><dd data-arm-area>—</dd></div>
							<div><dt>Общая длина</dt><dd data-arm-totlen>—</dd></div>
						</dl>

						<a class="arm__cta" href="/zapros-kp/?material=armatura-nerzh#lead-form" data-arm-cta>
							<span>Запросить КП на нержавеющую арматуру</span>
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>

						<p class="arm__result-foot">
							Теоретическая масса по ГОСТ. Фактическая отличается на ±5 % (допуск проката).
						</p>
					</div>
				</aside>
			</div>
		</section>

		<section class="arm__block">
			<h2 class="arm__h2">Сечение арматурного стержня</h2>
			<div class="arm__infographic">
				<svg viewBox="0 0 280 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Поперечное сечение арматурного стержня с указанием номинального диаметра D">
					<defs>
						<pattern id="armHatch" x="0" y="0" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
							<line x1="0" y1="0" x2="0" y2="9" stroke="var(--color-primary)" stroke-width="0.7" opacity="0.28" />
						</pattern>
					</defs>

					<line x1="30" y1="140" x2="250" y2="140" stroke="var(--color-subtle)" stroke-width="0.8" stroke-dasharray="10 3 2 3" />
					<line x1="140" y1="30" x2="140" y2="250" stroke="var(--color-subtle)" stroke-width="0.8" stroke-dasharray="10 3 2 3" />

					<circle cx="140" cy="140" r="80" fill="url(#armHatch)" stroke="var(--color-primary)" stroke-width="2.6" />

					<ellipse cx="220" cy="140" rx="5" ry="14" fill="url(#armHatch)" stroke="var(--color-primary)" stroke-width="1.6" />
					<ellipse cx="60" cy="140" rx="5" ry="14" fill="url(#armHatch)" stroke="var(--color-primary)" stroke-width="1.6" />

					<g stroke="var(--color-accent)" stroke-width="1.6" fill="none" stroke-linecap="round">
						<line x1="60" y1="226" x2="60" y2="246" stroke-dasharray="3 2" />
						<line x1="220" y1="226" x2="220" y2="246" stroke-dasharray="3 2" />
						<line x1="60" y1="240" x2="220" y2="240" />
					</g>
					<polygon points="60,240 72,234 72,246" fill="var(--color-accent)" />
					<polygon points="220,240 208,234 208,246" fill="var(--color-accent)" />

					<text x="140" y="263" text-anchor="middle" font-family="Inter, sans-serif" font-size="18" font-weight="600" fill="var(--color-accent)">D</text>
					<text x="140" y="22" text-anchor="middle" font-family="Inter, sans-serif" font-size="10" fill="var(--color-muted)" font-style="italic">периодический профиль · ГОСТ 5781-82</text>
				</svg>

				<div class="arm__infographic-legend">
					<h3>Обозначения</h3>
					<ul>
						<li><strong>D</strong> — номинальный диаметр (по гладкой части стержня)</li>
						<li>Боковые выступы — поперечные рёбра периодического профиля для сцепления с бетоном</li>
						<li>Осевые штрих-пунктирные линии — для центра сечения</li>
						<li>Штриховка 45° — стандартное обозначение разреза металла</li>
					</ul>
					<p class="arm__infographic-note">
						Профиль регламентирован ГОСТ 5781-82 (классы А-I…А-VI) и ГОСТ Р 52544-2006 (А500С).
						Геометрия рёбер влияет на сцепление с бетоном, но не на массу — она считается
						по номинальному диаметру с допуском ±5 %.
					</p>
				</div>
			</div>
		</section>

		<section class="arm__block">
			<h2 class="arm__h2">Таблица веса арматуры по ГОСТ 5781-82</h2>
			<p class="arm__block-lead">
				Теоретическая масса 1 метра арматуры с учётом периодического профиля.
				Значения одинаковы для А240, А400 и А500С — класс прочности на массу не влияет.
			</p>
			<div class="arm__table-wrap">
				<table class="arm__table">
					<thead>
						<tr>
							<th>Диаметр</th>
							<th>Масса 1 м, кг</th>
							<th>Сечение, мм²</th>
							<th>Длина в 1 т, м</th>
						</tr>
					</thead>
					<tbody>
						{armaturaRows.map((r) => (
							<tr>
								<td><strong>Ø {r.d}</strong></td>
								<td>{r.m1.toLocaleString('ru-RU', { minimumFractionDigits: 3 })}</td>
								<td>{r.area.toLocaleString('ru-RU', { maximumFractionDigits: 1 })}</td>
								<td>{Math.round(1000 / r.m1).toLocaleString('ru-RU')}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section class="arm__block">
			<h2 class="arm__h2">Классы арматуры</h2>
			<div class="arm__klassy">
				{klassy.map((k) => (
					<div class="arm__klass">
						<div class="arm__klass-head">
							<strong>{k.label}</strong>
							<span>{k.gost}</span>
						</div>
						<p>{k.applic}</p>
					</div>
				))}
			</div>
		</section>

		<section class="arm__block">
			<h2 class="arm__h2">Связанные инструменты и каталог</h2>
			<ul class="arm__related">
				<li>
					<a href="/kalkulyator-vesa/">
						<strong>Универсальный калькулятор веса проката</strong>
						<small>лист, труба, круг, проволока, полоса, уголок и другие 9 видов</small>
					</a>
				</li>
				<li>
					<a href="/gost/">
						<strong>Справочник ГОСТов</strong>
						<small>сортаменты, плотности, маркировка AISI ↔ ГОСТ</small>
					</a>
				</li>
				<li>
					<a href="/krug/">
						<strong>Круг нержавеющий</strong>
						<small>аналог гладкой арматуры в нержавеющем исполнении</small>
					</a>
				</li>
				<li>
					<a href="/provoloka/">
						<strong>Проволока нержавеющая</strong>
						<small>для вязки арматурного каркаса в нержавеющих конструкциях</small>
					</a>
				</li>
			</ul>
		</section>

		<section class="arm__faq">
			<h2 class="arm__h2">Частые вопросы</h2>
			<div class="arm__faq-list">
				{faq.map((f) => (
					<details class="arm__faq-item">
						<summary class="arm__faq-q">
							<span>{f.q}</span>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</section>
	</div>

	<CtaSection
		title="Нужна нержавеющая арматура?"
		text="Для агрессивных сред, морских конструкций, химпрома и объектов с длительным сроком службы поставляем нержавеющую арматуру AISI 304L / 316L и дуплекс 2205 под заявку. Менеджер пересчитает массу и пришлёт КП."
	/>
</BaseLayout>

<script>
	type ArmRow = { d: number; m1: number; area: number };

	const ROWS: ArmRow[] = [
		{ d: 6, m1: 0.222, area: 28.3 },
		{ d: 8, m1: 0.395, area: 50.3 },
		{ d: 10, m1: 0.617, area: 78.5 },
		{ d: 12, m1: 0.888, area: 113.1 },
		{ d: 14, m1: 1.208, area: 153.9 },
		{ d: 16, m1: 1.578, area: 201.1 },
		{ d: 18, m1: 1.998, area: 254.5 },
		{ d: 20, m1: 2.466, area: 314.2 },
		{ d: 22, m1: 2.984, area: 380.1 },
		{ d: 25, m1: 3.853, area: 490.9 },
		{ d: 28, m1: 4.834, area: 615.8 },
		{ d: 32, m1: 6.313, area: 804.2 },
		{ d: 36, m1: 7.99, area: 1017.9 },
	];

	const KLASS_HINTS: Record<string, string> = {
		A500C: 'основной строительный класс — фундаменты, плиты, колонны, монолитные перекрытия',
		A400: 'традиционный класс, применяется в типовых проектах и при реконструкции',
		A240: 'гладкий пруток, монтажные элементы, хомуты, вязка',
	};

	const root = document.querySelector('[data-arm-root]');
	if (root) {
		const klassSel = root.querySelector('[data-arm-klass]') as HTMLSelectElement;
		const klassHint = root.querySelector('[data-arm-klass-hint]') as HTMLElement;
		const dSel = root.querySelector('[data-arm-diameter]') as HTMLSelectElement;
		const lenInp = root.querySelector('[data-arm-length]') as HTMLInputElement;
		const qtyInp = root.querySelector('[data-arm-qty]') as HTMLInputElement;
		const massInp = root.querySelector('[data-arm-mass]') as HTMLInputElement;
		const massUnit = root.querySelector('[data-arm-mass-unit]') as HTMLSelectElement;

		const m1El = root.querySelector('[data-arm-m1]') as HTMLElement;
		const prutEl = root.querySelector('[data-arm-prut]') as HTMLElement;
		const totalEl = root.querySelector('[data-arm-total]') as HTMLElement;
		const totalSubEl = root.querySelector('[data-arm-total-sub]') as HTMLElement;
		const areaEl = root.querySelector('[data-arm-area]') as HTMLElement;
		const totLenEl = root.querySelector('[data-arm-totlen]') as HTMLElement;
		const ctaEl = root.querySelector('[data-arm-cta]') as HTMLAnchorElement;

		const fmt = new Intl.NumberFormat('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 3 });

		/* Какое поле редактировалось последним. mass → пересчитываем количество прутков от массы.
		   В остальных случаях — масса от количества. */
		let lastEdited: 'qty' | 'mass' = 'qty';

		function getRow(): ArmRow {
			const d = parseInt(dSel.value, 10);
			return ROWS.find((r) => r.d === d) ?? ROWS[3];
		}

		function recalc() {
			const row = getRow();
			const len = parseFloat(lenInp.value) || 0;
			let qty = parseFloat(qtyInp.value) || 0;

			const m1 = row.m1;
			const prutWeight = m1 * len;

			if (lastEdited === 'mass' && prutWeight > 0) {
				const massRaw = parseFloat(massInp.value) || 0;
				const massKg = massUnit.value === 't' ? massRaw * 1000 : massRaw;
				qty = massKg / prutWeight;
				if (qty > 0) qtyInp.value = String(+qty.toFixed(2));
				else qtyInp.value = '0';
			} else if (prutWeight > 0 && qty > 0) {
				const total = prutWeight * qty;
				const inT = massUnit.value === 't';
				massInp.value = String(+(inT ? total / 1000 : total).toFixed(3));
			} else {
				massInp.value = '';
			}

			const total = prutWeight * qty;

			m1El.textContent = `${fmt.format(m1)} кг`;
			prutEl.textContent = prutWeight > 0 ? `${fmt.format(prutWeight)} кг` : '—';

			if (total > 0) {
				if (total >= 1000) {
					totalEl.textContent = `${fmt.format(total / 1000)} т`;
					totalSubEl.textContent = `${fmt.format(total)} кг`;
				} else {
					totalEl.textContent = `${fmt.format(total)} кг`;
					totalSubEl.textContent = '';
				}
			} else {
				totalEl.textContent = '—';
				totalSubEl.textContent = '';
			}

			areaEl.textContent = `${row.area.toLocaleString('ru-RU', { maximumFractionDigits: 1 })} мм²`;
			totLenEl.textContent = qty > 0 && len > 0 ? `${fmt.format(qty * len)} м` : '—';

			if (ctaEl) {
				const params = new URLSearchParams({
					material: 'armatura-nerzh',
					diameter: String(row.d),
					qty: String(Math.max(0, Math.round(qty))),
					weight_kg: String(Math.max(0, Math.round(total))),
				});
				ctaEl.href = `/zapros-kp/?${params.toString()}#lead-form`;
			}
		}

		klassSel.addEventListener('change', () => {
			klassHint.textContent = KLASS_HINTS[klassSel.value] ?? '';
			recalc();
		});
		dSel.addEventListener('change', () => { lastEdited = 'qty'; recalc(); });
		lenInp.addEventListener('input', () => { lastEdited = 'qty'; recalc(); });
		qtyInp.addEventListener('input', () => { lastEdited = 'qty'; recalc(); });
		massInp.addEventListener('input', () => { lastEdited = 'mass'; recalc(); });
		massUnit.addEventListener('change', () => { lastEdited = 'qty'; recalc(); });

		recalc();
	}
</script>

