---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubRequest from '../../components/HubRequest.astro';

const brands = [
	{ name: 'ЦЛ-11', desc: 'Аустенитные стали типа Х18Н10Т. Высокая стойкость к МКК. Ø2,5–5 мм.' },
	{ name: 'ЭА-400/10У', desc: 'Универсальные для аустенитных нержавеек 12Х18Н9Т, 12Х18Н10Т. Ø3, 4, 5 мм.' },
	{ name: 'ОЗЛ-6', desc: 'Сталь 20Х23Н18 (жаропрочная). Сварка при высоких температурах.' },
	{ name: 'ОЗЛ-8', desc: 'Аналог ЦЛ-11. Для AISI 304 / 12Х18Н9. Стабильная дуга.' },
	{ name: 'ОЗЛ-25Б', desc: 'Жаропрочные сплавы на никелевой основе. До 1100 °C.' },
	{ name: 'НИИ-48Г', desc: 'Сварка разнородных сталей (углеродистая + нержавеющая).' },
];
---

<CatalogHubTemplate
	title="Электроды нержавеющие для сварки"
	description="Электроды нержавеющие: ЦЛ-11, ЭА-400/10У, ОЗЛ-6, ОЗЛ-8, ОЗЛ-25Б, НИИ-48Г. Для сварки коррозионностойких и жаропрочных сталей."
	h1="Электроды нержавеющие"
	intro="Покрытые электроды для ручной дуговой сварки коррозионностойких, кислотостойких и жаропрочных сталей. Диаметры 2,5–5 мм, упаковка 1, 4,5 и 5 кг. Запас на складе по основным маркам."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Электроды' }]}
	noindex
>
	<HubRequest what="Электроды нержавеющие (ЦЛ-11, ЭА-400/10У, ОЗЛ-8 и др.)" />

	<section class="block">
		<h2>Основные марки</h2>
		<div class="types-grid">
			{brands.map((b) => (
				<article class="type-card">
					<h3>{b.name}</h3>
					<p>{b.desc}</p>
				</article>
			))}
		</div>
	</section>

	<section class="block">
		<h2>Подбор под задачу</h2>
		<ul class="list-plain">
			<li><strong>AISI 304 / 12Х18Н9Т</strong> → ЦЛ-11, ОЗЛ-8, ЭА-400/10У</li>
			<li><strong>AISI 316L / 03Х17Н14М2</strong> → ЦЛ-11М, ОЗЛ-20, ЭА-902/14</li>
			<li><strong>AISI 321 / 12Х18Н10Т</strong> → ЦЛ-11, ЭА-400/10У</li>
			<li><strong>20Х23Н18 (жаропрочная)</strong> → ОЗЛ-6, ОЗЛ-9-1</li>
			<li><strong>Разнородные стали</strong> (нерж + углерод) → НИИ-48Г, АНЖР-2</li>
		</ul>
	</section>

	<section class="block">
		<h2>Поставка</h2>
		<ul class="list-plain">
			<li>Упаковка: вакуумные пачки 1 кг, картонные коробки 4,5 и 5 кг</li>
			<li>Сертификат завода-изготовителя на каждую партию</li>
			<li>Хранение в сухом помещении, гарантия 2 года</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 65ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.types-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: var(--space-3);
	}
	.type-card {
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
	}
	.type-card h3 { margin: 0 0 var(--space-2); font-size: 1rem; color: var(--color-text); }
	.type-card p { margin: 0; color: var(--color-muted); font-size: 0.92rem; line-height: 1.5; }
</style>
