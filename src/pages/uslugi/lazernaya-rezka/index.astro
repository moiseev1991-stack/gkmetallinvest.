---
import ServicePage from '../../../components/ServicePage.astro';

/* Факты от клиента (2026-09-24): услуга есть, режем в собственном цехе,
   цены не публикуем — считаем по чертежу. Характеристик станка (мощность,
   поле, толщины) клиент не давал — на странице их нет, не выдумываем. */

const specs = [
	{ label: 'Где режем', value: 'Собственный цех' },
	{ label: 'Основной материал', value: 'Нержавеющая сталь: AISI 304, 316L, 321, 430 и другие марки со склада' },
	{ label: 'Другие металлы', value: 'Чёрная сталь, алюминий — по запросу' },
	{ label: 'Исходные данные', value: 'Чертёж DXF, DWG, STEP, PDF или эскиз с размерами' },
	{ label: 'Стоимость', value: 'По чертежу: толщина, длина реза, число отверстий, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Чертёж', text: 'Присылаете файл или эскиз, марку стали, толщину и количество деталей. Если важна лицевая сторона листа — отметьте её.' },
	{ n: 2, title: 'Проверка и расчёт', text: 'Проверяем контур, отверстия и перемычки, раскладываем детали на листе, считаем стоимость и срок.' },
	{ n: 3, title: 'Металл', text: 'Подбираем лист нужной марки и толщины со своего склада — отдельно искать и везти металл на резку не нужно.' },
	{ n: 4, title: 'Резка', text: 'Режем по программе и сверяем размеры первой детали с чертежом.' },
	{ n: 5, title: 'Отгрузка', text: 'Упаковываем детали и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Какую нержавейку можно резать лазером?',
		a: 'Все основные марки листовой нержавейки: AISI 304, 316L, 321, 430, 201 и другие. На резку марка влияет мало — важнее толщина листа и состояние поверхности. Шлифованный и зеркальный лист режут в защитной плёнке, чтобы не повредить лицевую сторону.',
	},
	{
		q: 'В каком виде присылать чертёж?',
		a: 'Лучше всего DXF или DWG в масштабе 1:1 — по ним сразу готовится программа для станка. Подойдут STEP, PDF или эскиз с размерами, но на подготовку контура уйдёт больше времени. В заявке укажите марку, толщину, количество и лицевую сторону, если она важна.',
	},
	{
		q: 'Чем лазерная резка отличается от гидроабразивной?',
		a: 'Лазер режет за счёт нагрева: быстро, с узким резом и ровной кромкой, особенно на тонком и среднем листе. Гидроабразивная резка холодная — струя воды с абразивом не нагревает металл, поэтому её выбирают для толстого металла и деталей, где недопустима зона нагрева у кромки. Если сомневаетесь, какой способ нужен, — пришлите чертёж, подскажем.',
	},
	{
		q: 'Какая кромка у нержавейки после лазера?',
		a: 'Зависит от газа, в котором идёт резка. В азоте кромка получается светлой, без оксидной плёнки — её можно сразу сваривать и полировать. В кислороде или воздухе кромка темнеет. Если деталь пойдёт под сварку или кромка останется на виду, укажите это в заявке.',
	},
	{
		q: 'Можно ли заказать металл и резку вместе?',
		a: 'Да. Лист нужной марки и толщины берём со своего склада нержавеющего проката, режем и отгружаем готовые детали. Один поставщик и один срок — не нужно покупать металл отдельно и возить его на резку.',
	},
	{
		q: 'Сколько стоит лазерная резка?',
		a: 'Цена зависит от марки и толщины металла, общей длины реза, числа отверстий и количества деталей, поэтому считаем по чертежу. Пришлите файл — назовём стоимость и срок.',
	},
];

const pricingNote = `Стоимость считаем по чертежу. На неё влияют марка и толщина металла, общая длина реза, число врезок (каждое отверстие — отдельная врезка), количество деталей и требования к кромке. В партии одна деталь обходится дешевле: подготовка программы делится на весь объём.<br><br>Металл считаем отдельно по прайсу склада. Лист подбираем так, чтобы раскрой шёл с минимальным отходом.`;
---

<ServicePage
	title="Лазерная резка нержавейки и металла на заказ по чертежу"
	description="Лазерная резка нержавеющей стали и металла в собственном цехе: детали по чертежу DXF, DWG, STEP или эскизу. Лист со своего склада, расчёт по чертежу, доставка по России."
	h1="Лазерная резка нержавейки и металла"
	tagline="Детали по чертежу · собственный цех · металл со склада"
	intro={`<p>Режем листовую нержавеющую сталь и другие металлы на лазере в собственном цехе: детали по чертежу, развёртки под гибку, фланцы, пластины, панели и декоративные элементы. Лазерная резка нужна, когда у детали сложный контур, отверстия и пазы, а делать штамп невыгодно, и когда в партии нужны одинаковые детали.</p><p>Металл под заказ берём со своего склада нержавеющего проката: подбираем марку и толщину листа под раскрой, режем и отгружаем готовые детали. Лист и резку можно заказать вместе — не нужно искать металл отдельно и везти его на резку.</p><p>Для расчёта пришлите чертёж в DXF, DWG, STEP или PDF либо эскиз с размерами. Укажите марку стали, толщину, количество и требования к кромке — посчитаем стоимость и сроки.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'AISI 304 (08Х18Н10)',
		'AISI 316L (03Х17Н14М3)',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430 (12Х17)',
		'AISI 201',
		'Шлифованный и зеркальный лист',
		'Чёрная сталь — по запросу',
		'Алюминий — по запросу',
	]}
	applications={[
		'Детали пищевого и химического оборудования: панели, кожухи, крышки, перегородки',
		'Развёртки под гибку — корпуса, короба, лотки, кронштейны',
		'Фланцы, пластины, косынки, закладные детали',
		'Декоративные панели и элементы интерьера из шлифованного и зеркального листа',
		'Таблички, шильды, трафареты',
		'Заготовки под сварку и дальнейшую обработку',
	]}
	limitations={[
		'Возможность резки конкретной толщины и контура подтверждаем по чертежу при расчёте',
		'Отверстия меньше толщины листа и очень узкие перемычки могут потребовать правки контура',
		'Зеркальный и шлифованный лист режем в защитной плёнке — лицевую сторону укажите в заявке',
		'Резьба, точные посадки и фаски — отдельными операциями после резки',
	]}
	pricingNote={pricingNote}
	relatedTitle="Металл и смежные услуги"
	relatedHubs={[
		{ label: 'Лист нержавеющий', href: '/list-nerzhaveyushchiy/' },
		{ label: 'Декоративные листы', href: '/dekorativnye-listy/' },
		{ label: 'Гидроабразивная резка', href: '/uslugi/gidroabrazivnaya-rezka/' },
		{ label: 'Перфорация листов', href: '/uslugi/perforaciya-listov/' },
		{ label: 'Травление и пассивация', href: '/uslugi/travlenie-i-passivaciya/' },
	]}
	faq={faq}
/>
