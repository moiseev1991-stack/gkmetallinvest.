---
import ServicePage from '../../../components/ServicePage.astro';

const specs = [
	{ label: 'Услуга', value: 'Бесплатно при покупке у нас' },
	{ label: 'Срок ответа', value: 'до 30 минут в рабочее время' },
	{ label: 'Что входит', value: 'марка, формат, расчёт веса и стоимости' },
	{ label: 'Аналоги', value: 'AISI ↔ ГОСТ ↔ EN, импорт ↔ российский' },
	{ label: 'Документация', value: 'спецификация, чертёж приёмки' },
];

const process = [
	{ n: 1, title: 'Получаем ТЗ', text: 'Принимаем описание задачи, чертёж, спецификацию или просто список «нужно X для Y».' },
	{ n: 2, title: 'Анализ среды', text: 'Уточняем условия эксплуатации: температура, среда, нагрузка, ресурс, бюджет.' },
	{ n: 3, title: 'Подбор марки', text: 'Подбираем оптимальную марку: основная + 1–2 аналога с разным бюджетом. Российские и импортные аналоги по ГОСТ / AISI / EN.' },
	{ n: 4, title: 'Расчёт', text: 'Рассчитываем вес позиции, стоимость материала и обработки, сроки поставки.' },
	{ n: 5, title: 'КП', text: 'Присылаем коммерческое предложение с пояснениями. Если задача нестандартная — встречаемся или созваниваемся для обсуждения.' },
];

const faq = [
	{
		q: 'Бесплатно ли подбор?',
		a: 'Да, для задач, которые завершаются заказом материала у нас, услуга бесплатная. Если речь о консалтинге для конкурента или о расчёте «в стол» (без последующего заказа) — обсуждается отдельно. Обычно 5–10 % случаев — заказчик берёт материал в другом месте после нашего подбора, мы к этому относимся спокойно.',
	},
	{
		q: 'Чем 12Х18Н10Т отличается от AISI 321 — это одно и то же?',
		a: 'Это аналоги: оба — аустенитные стали, стабилизированные титаном, рабочие температуры до 800 °C. Состав почти одинаков (отличие в десятых долях процента), свойства взаимозаменяемы. В спецификации можно указывать любой из аналогов. Российская номенклатура 12Х18Н10Т — для тендерных и государственных закупок, AISI 321 — для интеграции в международные проекты.',
	},
	{
		q: 'Какую марку выбрать под пищевую промышленность?',
		a: 'Базовая марка — AISI 304 (08Х18Н10). Подходит для большинства пищевых задач: посуда, оборудование, ёмкости, трубопроводы общего назначения. Для контакта с кислотами, рассолами, маринадами и в средах с хлоридами — AISI 316L (молибден улучшает коррозионную стойкость). Для парового или термического оборудования > 600 °C — AISI 321.',
	},
	{
		q: 'Помогаете ли с расчётом нагрузки и прочности?',
		a: 'Базовые расчёты делаем — вес, ориентировочная прочность, выбор сечения. Для серьёзных конструкций (мосты, ёмкости под давлением, фасады зданий) — нужен расчёт по СП / ГОСТ от лицензированного инженера. Если у вас нет такого специалиста, подскажем партнёров.',
	},
	{
		q: 'Можно ли заказать ЭХП (электрохимическую полировку) или специальную термообработку?',
		a: 'Да. На своей площадке делаем ЭХП для пищевых и фармацевтических линий. Закалку и отпуск ответственных деталей (валы, шестерни, режущий инструмент из 20Х13, 40Х13) выполняем через сертифицированных партнёров. Включаем эти работы в общий расчёт КП.',
	},
	{
		q: 'А если позиции нет в прайсе — можно заказать?',
		a: 'Конечно. Прайс показывает 3500 SKU из наличия, но мы привозим под заказ: редкие марки (904L, дуплекс, прецизионные сплавы), нестандартные размеры (трубы Ø > 273 мм, листы > 60 мм), специфические передели (ASTM, JIS). Срок — от 7 до 30 дней в зависимости от позиции.',
	},
];

const pricingNote = `Услуга подбора — бесплатна для задач, которые завершаются заказом у нас. Время ответа на стандартное ТЗ — до 30 минут в рабочее время.<br><br>Для сложных проектов с подбором аналогов и расчётом — обсуждаем индивидуально, обычно в течение 1–2 рабочих дней. Если требуется выезд к заказчику для согласования спецификации — обсуждаем отдельно.`;
---

<ServicePage
	title="Подбор нержавеющей стали по техзаданию — марка, формат, аналоги"
	description="Бесплатный подбор марки нержавейки по среде, нагрузке, температуре. AISI ↔ ГОСТ ↔ EN, импортные и российские аналоги. Расчёт веса и стоимости. Ответ за 30 минут."
	h1="Подбор металла по техзаданию"
	tagline="Инженерная помощь до закупки"
	intro={`<p>Помогаем подобрать марку нержавейки под конкретную задачу: пищевая промышленность, химия, нефтегаз, архитектура, морские и термические среды. Принимаем ТЗ, чертежи или просто описание задачи — анализируем условия эксплуатации и предлагаем оптимальную марку с 1–2 альтернативами по разной цене.</p><p>Особенно полезно, когда заказчик впервые работает с нержавейкой: легко перепутать AISI 304 и AISI 316L, не заметить, что для +700 °C нужна 321 (12Х18Н10Т), а не универсальная 304. Мы знаем эти нюансы — за 9 лет работы прошли через тысячи проектов в разных отраслях.</p><p>Подбираем аналоги между российскими, американскими (AISI), европейскими (EN 10088) и японскими (JIS) обозначениями — это критично для тендерных закупок и проектов с импортными чертежами. Рассчитываем вес позиции по геометрии и стоимость материала и обработки. Услуга бесплатна для проектов, которые завершаются заказом у нас.</p>`}
	specs={specs}
	process={process}
	materials={[
		'AISI 201 / 304 / 304L / 316L / 316Ti / 321 / 904L',
		'12Х18Н10Т, 08Х18Н10, 03Х17Н14М2',
		'Жаропрочные: 20Х13, 40Х13, 20Х23Н18',
		'Безникелевые: AISI 430, 410S',
		'Дуплекс и супердуплекс',
		'Прецизионные сплавы',
		'Жаростойкие никелевые сплавы',
	]}
	applications={[
		'Пищевая, фармацевтическая, парфюмерная промышленность',
		'Химическая промышленность, нефтехимия, нефтегаз',
		'Энергетика — котельные, ТЭЦ, теплообменники',
		'Архитектура и интерьер — фасады, лестничные ограждения, малые формы',
		'Морские и судостроительные проекты',
		'Машиностроение и металлообработка',
		'Медицинский инструмент и оборудование',
	]}
	relatedHubs={[
		{ label: 'Запрос КП', href: '/zapros-kp/' },
		{ label: 'Контакты', href: '/kontakty/' },
		{ label: 'О компании', href: '/o-kompanii/' },
	]}
	faq={faq}
	pricingNote={pricingNote}
/>
