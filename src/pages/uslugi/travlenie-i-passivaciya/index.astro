---
import ServicePage from '../../../components/ServicePage.astro';

/* Факты от клиента (2026-09-24): пассивация и хим. травление нержавейки
   есть, собственный цех, цены не публикуем. Размеров ванн, составов и
   стандартов клиент не давал — не пишем. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Операции', value: 'Травление и пассивация — вместе или по отдельности' },
	{ label: 'Что обрабатываем', value: 'Сварные конструкции, ёмкости, трубы, детали, лист' },
	{ label: 'Материал', value: 'Нержавеющая сталь: AISI 304, 316L, 321, 430 и другие марки' },
	{ label: 'Исходные данные', value: 'Фото или чертёж, габариты, марка стали, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, форма, длина швов, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете фото или чертёж изделия, габариты, марку стали и количество.' },
	{ n: 2, title: 'Оценка', text: 'Смотрим швы, окалину и загрязнения, согласуем, что обрабатываем — изделие целиком или только швы.' },
	{ n: 3, title: 'Обезжиривание', text: 'Снимаем масла и загрязнения — иначе травление ляжет неравномерно.' },
	{ n: 4, title: 'Травление', text: 'Удаляем окалину и цвета побежалости, промываем.' },
	{ n: 5, title: 'Пассивация', text: 'Формируем защитный слой на чистой поверхности, промываем и сушим.' },
	{ n: 6, title: 'Отгрузка', text: 'Упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем травление отличается от пассивации?',
		a: 'Травление — очистка: кислотный состав снимает окалину, цвета побежалости и загрязнения вместе с тонким поверхностным слоем металла. Пассивация — защита: на чистой стали формируется плотная оксидная плёнка хрома, которая и делает сталь нержавеющей. Обычно операции идут подряд — сначала травление, потом пассивация.',
	},
	{
		q: 'Зачем пассивировать нержавейку, если она и так не ржавеет?',
		a: 'Нержавейку защищает тонкий слой оксида хрома. Сварка, резка и контакт с инструментом из обычной стали его нарушают: у шва выгорает хром, на поверхность попадают частицы железа. В этих местах и начинается ржавчина. Пассивация восстанавливает защитный слой.',
	},
	{
		q: 'Что такое цвета побежалости и нужно ли их убирать?',
		a: 'Это радужный налёт оксидов у сварного шва — от соломенного до синего. Под ним сталь обеднена хромом и хуже сопротивляется коррозии. У пищевого, химического и уличного оборудования цвета побежалости удаляют травлением.',
	},
	{
		q: 'Можно ли обработать только сварные швы?',
		a: 'Да, это частая задача. Если изделие будет работать в агрессивной среде, лучше обработать его целиком — тогда поверхность будет однородной по стойкости.',
	},
	{
		q: 'Уберёт ли травление царапины?',
		a: 'Нет. Травление снимает окалину и загрязнения, но глубокие царапины и забоины остаются — их сначала шлифуют. Для гладкой блестящей поверхности после травления делают электрохимическую полировку.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь обработки, форма (трубы и ёмкости сложнее листа), состояние поверхности, длина сварных швов и количество изделий.<br><br>Пришлите фото или чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Травление и пассивация нержавейки после сварки"
	description="Травление и пассивация нержавейки в собственном цехе: снимаем окалину и цвета побежалости после сварки, восстанавливаем защитный слой. Конструкции, ёмкости, трубы."
	h1="Травление и пассивация нержавеющей стали"
	tagline="После сварки · защита от коррозии · собственный цех"
	answer="ГК Металлинвест выполняет <strong>травление и пассивацию нержавеющей стали</strong> в собственном цехе. Травление снимает окалину и цвета побежалости после сварки, пассивация восстанавливает защитный слой оксида хрома — изделие не ржавеет по швам. Обрабатываем сварные конструкции, ёмкости, трубы и детали; стоимость считаем по фото или чертежу."
	facts={['Собственный цех', 'Швы или изделие целиком', 'Пищевое и химическое оборудование', 'Расчёт по фото']}
	cover="travlenie-i-passivaciya"
	coverAlt="Травление и пассивация нержавейки — что даёт обработка"
	intro={`<p>Травление и пассивация возвращают нержавейке коррозионную стойкость после сварки, резки, гибки и механической обработки. Травление снимает окалину, цвета побежалости у швов и загрязнения, пассивация формирует на очищенной стали ровный защитный слой оксида хрома. Без этого изделие может начать ржаветь по сварным швам и в местах контакта с инструментом.</p><p>Выполняем обе операции в собственном цехе — для сварных конструкций, ёмкостей, труб, деталей и листового проката. Чаще всего обработка нужна оборудованию пищевых, химических и фармацевтических производств, где сварной шов не должен становиться очагом коррозии.</p><p>Для расчёта пришлите фото или чертёж изделия, габариты, марку стали и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'AISI 304 / 304L',
		'AISI 316L',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430',
		'Дуплекс 2205',
		'Сварные швы',
		'Трубы и детали трубопровода',
	]}
	applications={[
		'Удаление окалины и цветов побежалости со сварных швов',
		'Пищевое оборудование: ёмкости, бункеры, столы, трубопроводы',
		'Химическое и фармацевтическое оборудование',
		'Детали после лазерной и плазменной резки, гибки и мехобработки',
		'Очистка от частиц железа после контакта с инструментом из углеродистой стали',
		'Подготовка поверхности перед электрохимической полировкой',
	]}
	limitations={[
		'Габариты изделия и способ обработки подтверждаем при расчёте',
		'Травление не убирает глубокие царапины и забоины — их сначала шлифуют',
		'Изделия с деталями из углеродистой стали (крепёж, закладные) обсуждаем заранее: кислотные составы их повреждают',
	]}
	pricingNote={pricingNote}
	relatedTitle="Металл и смежные услуги"
	relatedHubs={[
		{ label: 'Электрохимическая полировка', href: '/uslugi/elektrohimicheskaya-polirovka/' },
		{ label: 'Лазерная резка', href: '/uslugi/lazernaya-rezka/' },
		{ label: 'Труба нержавеющая', href: '/truba-nerzhaveyushchaya/' },
		{ label: 'Детали трубопровода', href: '/detali-truboprovoda/' },
		{ label: 'Лист нержавеющий', href: '/list-nerzhaveyushchiy/' },
	]}
	faq={faq}
/>
