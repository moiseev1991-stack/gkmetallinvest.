---
import ServicePage from '../../../components/ServicePage.astro';

const specs = [
	{ label: 'Зернистость абразива', value: 'P80 – P400' },
	{ label: 'Шероховатость Ra (на выходе)', value: '0,8 – 3,2 мкм' },
	{ label: 'Размер листа', value: 'до 1500 × 4000 мм' },
	{ label: 'Толщина листа', value: '0,5 – 12 мм' },
	{ label: 'Минимальная партия', value: 'от 1 листа' },
	{ label: 'Направление шлифовки', value: 'продольная, поперечная, диагональная' },
];

const process = [
	{ n: 1, title: 'Приёмка', text: 'Принимаем материал, замеряем исходную поверхность, согласовываем требования к Ra и направлению.' },
	{ n: 2, title: 'Грубая обдирка', text: 'P80–P120 — снимаем окалину, выравниваем грубые царапины и неровности после прокатки.' },
	{ n: 3, title: 'Средняя шлифовка', text: 'P180–P240 — формируем равномерную текстуру под покраску, склейку или финишную обработку.' },
	{ n: 4, title: 'Тонкая шлифовка', text: 'P320–P400 — для сатина 4N (направленный декоративный рисунок).' },
	{ n: 5, title: 'Контроль', text: 'Проверяем Ra профилометром, упаковываем с защитной плёнкой PE.' },
];

const faq = [
	{
		q: 'Чем шлифование отличается от полировки?',
		a: 'Шлифование — этап подготовки поверхности с зернистостью до P400 (Ra 0,8–3,2 мкм). Полировка — финишная обработка с зернистостью выше P600 и пастами, доводит до Ra ≤ 0,4 мкм (зеркало). Если нужно подготовить поверхность под покраску или склейку — достаточно шлифовки, если нужен блеск — продолжаем до полировки.',
	},
	{
		q: 'Какая зернистость нужна для пищевого исполнения?',
		a: 'Для пищевых ёмкостей и трубопроводов — Ra ≤ 0,8 мкм, что соответствует P320–P400. Для CIP-моек (стерильные процессы) — Ra ≤ 0,4 мкм, требуется дополнительная полировка после шлифовки.',
	},
	{
		q: 'Можно ли шлифовать листы со следами от прокатки и окалиной?',
		a: 'Да, это типовая задача. Грубая обдирка P80–P120 снимает окалину и видимые риски. После этого поверхность готова под покраску, склейку или дальнейшую обработку. Толщина «съёма» при обдирке — 0,1–0,3 мм; учитывайте при заказе материала.',
	},
	{
		q: 'Подходит ли шлифовка для удаления царапин на смонтированной конструкции?',
		a: 'Для локальной шлифовки на месте — да, обычно ручным инструментом. Глубокие царапины (> 0,5 мм) требуют шлифовки от P120 и могут оставить «след» в виде слегка утончённой зоны. Для лестничных ограждений и фасадов мы выезжаем на объект — обсуждается отдельно.',
	},
	{
		q: 'Какие размеры листов можете обработать?',
		a: 'Стационарный станок — до 1500 × 4000 мм. Толщина листа — от 0,5 мм до 12 мм. Для негабарита (длина > 4000 мм) — работаем ручным инструментом с гарантией Ra ±0,2 мкм от заявленного.',
	},
];

const pricingNote = `Стоимость шлифовки начинается от 400 ₽/м² для зернистости P240 на листе 1,5 мм AISI 304. Грубая обдирка с окалиной — от 600 ₽/м². Сатин 4N — от 700 ₽/м². Для партии от 50 м² — скидка 10 %.<br><br>Цена включает работу, абразивы и упаковку с защитной плёнкой. Материал — отдельно по нашему прайсу на лист.`;
---

<ServicePage
	title="Шлифование нержавеющей стали — подготовка поверхности под проект"
	description="Шлифовка листов нержавейки: P80–P400, Ra 0,8–3,2 мкм. Сатин 4N для интерьеров, подготовка под покраску и сварку. Лист до 1500×4000, толщины 0,5–12 мм."
	h1="Шлифование нержавеющей стали"
	tagline="Сатин 4N · подготовка поверхности · удаление окалины"
	intro={`<p>Шлифуем нержавеющие листы и сортовой прокат на ленточно-шлифовальных и широкоширнурных станках для подготовки поверхности под покраску, склейку, сварку или финишную полировку. Достигаем шероховатости Ra 0,8–3,2 мкм с разной зернистостью абразива.</p><p>Зернистость подбираем под задачу: P80–P120 для грубой обдирки (снятие окалины и видимых царапин), P180–P240 для средней (под покраску и сварку), P320–P400 для тонкой шлифовки и получения декоративного сатина 4N. Направление шлифовки — продольное, поперечное или диагональное по чертежу.</p><p>Работаем с листом до 1500 × 4000 мм и толщинами 0,5–12 мм. На каждую партию выдаём паспорт качества с замером Ra профилометром. При обработке на месте у заказчика — обсуждаем отдельно (обычно лестничные ограждения, фасадные элементы после монтажа).</p>`}
	specs={specs}
	process={process}
	materials={[
		'AISI 304 / 304L',
		'AISI 316L',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430',
		'Дуплекс',
		'AISI 201',
		'Лист 0,5–12 мм',
		'Рулон до 1500 мм',
		'Труба Ø 19–325 мм',
	]}
	applications={[
		'Сатин 4N для декоративных интерьерных панелей и фасадов',
		'Подготовка поверхности под порошковую покраску',
		'Снятие окалины с горячекатаного листа перед финишной обработкой',
		'Подготовка кромок и плоскостей под сварку',
		'Локальный ремонт царапин на смонтированных конструкциях',
		'Обработка торцов сортового проката после резки',
	]}
	limitations={[
		'Максимальная длина листа на станке — 4000 мм',
		'Для тонких листов (< 0,5 мм) применяем щадящие режимы — обсуждается отдельно',
		'Финишное зеркало (Ra < 0,4 мкм) — отдельная услуга «Полировка»',
	]}
	relatedHubs={[
		{ label: 'Лист нержавеющий', href: '/list-nerzhaveyushchiy/' },
		{ label: 'Рулон нержавеющий', href: '/rulon-nerzhaveyushchiy/' },
		{ label: 'Декоративные листы', href: '/dekorativnye-listy/' },
	]}
	faq={faq}
	pricingNote={pricingNote}
/>
