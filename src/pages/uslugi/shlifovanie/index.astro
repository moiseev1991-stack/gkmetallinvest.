---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
---

<BaseLayout title="Шлифование" description="Шлифование нержавеющего металлопроката.">
	<div class="container page">
		<Breadcrumbs
			items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/uslugi/' }, { label: 'Шлифование' }]}
		/>
		<h1>Шлифование</h1>
		<p class="lead">Заглушка раздела; ссылка из хаба услуг.</p>
	</div>
</BaseLayout>

<style>
	.page {
		padding-block: var(--space-8);
	}
</style>
