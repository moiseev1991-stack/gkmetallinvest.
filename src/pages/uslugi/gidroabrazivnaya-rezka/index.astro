---
import ServicePage from '../../../components/ServicePage.astro';

/* Факты от клиента (2026-09-24): услуга есть, собственный цех, цены не
   публикуем. Толщин, размеров стола и точности клиент не давал — не пишем. */

const specs = [
	{ label: 'Где режем', value: 'Собственный цех' },
	{ label: 'Способ', value: 'Струя воды с абразивом — без нагрева металла' },
	{ label: 'Основной материал', value: 'Нержавеющая сталь — лист со своего склада' },
	{ label: 'Другие металлы', value: 'По запросу' },
	{ label: 'Исходные данные', value: 'Чертёж DXF, DWG, STEP, PDF или эскиз с размерами' },
	{ label: 'Стоимость', value: 'По чертежу: толщина, длина реза, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Чертёж', text: 'Присылаете файл или эскиз, марку и толщину металла, количество деталей.' },
	{ n: 2, title: 'Проверка и расчёт', text: 'Проверяем контур и толщину, раскладываем детали на листе, считаем стоимость и срок.' },
	{ n: 3, title: 'Металл', text: 'Подбираем лист нужной марки и толщины со своего склада.' },
	{ n: 4, title: 'Резка', text: 'Режем по программе и сверяем размеры первой детали с чертежом.' },
	{ n: 5, title: 'Отгрузка', text: 'Упаковываем детали и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Когда выбирать гидроабразив, а когда лазер?',
		a: 'Гидроабразив — для толстого металла, закалённых и чувствительных к нагреву сплавов и деталей, у которых кромка пойдёт под сварку или точную обработку без зоны нагрева. Лазер — для тонкого и среднего листа с большим количеством отверстий: он быстрее и обычно дешевле. Если не уверены, пришлите чертёж — подскажем способ.',
	},
	{
		q: 'Нагревается ли металл при гидроабразивной резке?',
		a: 'Нет. Вода охлаждает зону реза, поэтому нет зоны термического влияния, окалины и цветов побежалости. Свойства металла у кромки остаются такими же, как у всего листа, — это важно для закалённых сталей и деталей под сварку.',
	},
	{
		q: 'Какую толщину можно резать?',
		a: 'Гидроабразив режет заметно более толстый металл, чем лазер. Возможность резки и точность для вашей детали подтвердим по чертежу — пришлите файл с маркой и толщиной.',
	},
	{
		q: 'Какая кромка получается после резки?',
		a: 'Матовая, ровная, без оплавления и окалины. На толстом металле возможен небольшой конус реза; если нужна точная посадка, закладывают припуск под механическую обработку.',
	},
	{
		q: 'Можно ли заказать металл и резку вместе?',
		a: 'Да. Лист нужной марки и толщины берём со своего склада нержавеющего проката, режем и отгружаем готовые детали — один поставщик и один срок.',
	},
];

const pricingNote = `Стоимость считаем по чертежу. Основное в цене — время работы станка: оно растёт с толщиной металла и длиной реза. Добавляются расход абразива, сложность контура и количество деталей.<br><br>Металл со склада считаем отдельно по прайсу.`;
---

<ServicePage
	title="Гидроабразивная резка металла на заказ по чертежу"
	description="Гидроабразивная резка металла в собственном цехе: холодный рез без нагрева кромки, нержавейка и толстый лист. Металл со своего склада, расчёт по чертежу."
	h1="Гидроабразивная резка металла"
	tagline="Холодный рез · толстый металл · по чертежу"
	intro={`<p>Режем металл струёй воды с абразивом в собственном цехе. Гидроабразивная резка — холодный процесс: металл не нагревается, поэтому у кромки нет зоны термического влияния, окалины и изменения структуры. Её выбирают для толстого металла, закалённых и чувствительных к нагреву сплавов и для деталей, которые дальше пойдут под сварку или точную обработку.</p><p>Основной материал — нержавеющая сталь со своего склада: подбираем лист под раскрой и режем детали по чертежу. Другие металлы — по запросу.</p><p>Для расчёта пришлите чертёж в DXF, DWG, STEP или PDF либо эскиз с размерами, марку, толщину и количество деталей.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'AISI 304 (08Х18Н10)',
		'AISI 316L (03Х17Н14М3)',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430 (12Х17)',
		'Дуплекс 2205',
		'Толстый лист',
		'Другие металлы — по запросу',
	]}
	applications={[
		'Детали из толстого листа, которые лазер режет медленно или с сильным нагревом',
		'Фланцы, пластины, основания и закладные',
		'Детали под сварку и механообработку — без зоны нагрева у кромки',
		'Заготовки из закалённых и жаропрочных сталей',
		'Декоративные элементы со сложным контуром',
	]}
	limitations={[
		'На тонком листе гидроабразив медленнее лазера — для тонких деталей с множеством отверстий обычно выгоднее лазерная резка',
		'Кромка матовая; на толстом металле возможен небольшой конус реза — для точных посадок нужна мехобработка',
		'Возможность резки конкретной толщины и точность подтверждаем по чертежу',
	]}
	pricingNote={pricingNote}
	relatedTitle="Металл и смежные услуги"
	relatedHubs={[
		{ label: 'Лист нержавеющий', href: '/list-nerzhaveyushchiy/' },
		{ label: 'Лазерная резка', href: '/uslugi/lazernaya-rezka/' },
		{ label: 'Перфорация листов', href: '/uslugi/perforaciya-listov/' },
		{ label: 'Плоское и круглое шлифование', href: '/uslugi/ploskoe-i-krugloe-shlifovanie/' },
	]}
	faq={faq}
/>
