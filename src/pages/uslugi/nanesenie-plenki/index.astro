---
import ServicePage from '../../../components/ServicePage.astro';

const specs = [
	{ label: 'Тип плёнки', value: 'PE 50–100 мкм, PVC до 200 мкм' },
	{ label: 'Ширина рулона плёнки', value: 'до 1500 мм' },
	{ label: 'Адгезия', value: 'низкая, средняя, высокая' },
	{ label: 'Печать', value: 'логотип / штрих-код / маркировка по заявке' },
	{ label: 'Совместимость с резкой', value: 'PE/PVC не плавится при гильотинной резке' },
	{ label: 'Срок защиты', value: 'до 6 месяцев под крышей' },
];

const process = [
	{ n: 1, title: 'Очистка', text: 'Обезжириваем поверхность листа или рулона, удаляем пыль и стружку.' },
	{ n: 2, title: 'Подача', text: 'Лист проходит через прижимные валы, плёнка раскатывается с барабана с натяжением.' },
	{ n: 3, title: 'Адгезия', text: 'Регулируем давление валов в зависимости от типа поверхности (2B / BA / 4N) — плёнка должна держаться, но сниматься без следа.' },
	{ n: 4, title: 'Контроль', text: 'Проверяем равномерность нанесения и отсутствие пузырей. Если есть — переклеиваем.' },
	{ n: 5, title: 'Маркировка', text: 'Наклеиваем бирку с партией, плавкой, размером и марками. Упаковываем для безопасной транспортировки.' },
];

const faq = [
	{
		q: 'Какую плёнку выбрать — PE или PVC?',
		a: 'PE (полиэтилен) 50–100 мкм — стандарт для большинства задач. Дешевле, легко клеится и снимается. Подходит для матовой 2B и зеркальной BA в обычных условиях транспортировки и хранения. PVC до 200 мкм — толще и прочнее, выдерживает гибку и штамповку, защищает зеркало 8K и сатин 4N от глубоких царапин. PVC дороже на 20–30 %.',
	},
	{
		q: 'Можно ли резать лист с плёнкой?',
		a: 'Да, PE и PVC плёнки не плавятся при гильотинной резке и плазменной резке — лист спокойно режется без снятия защиты. При лазерной резке тонких отверстий плёнка вблизи реза может оплавиться — для высокоточной перфорации лучше снять защиту в зоне рисунка.',
	},
	{
		q: 'Плёнка с печатью логотипа — реально?',
		a: 'Да, под партии от 1 тонны делаем плёнку с печатью вашего логотипа, наименования заказчика и штрих-кода. Это полезно для дистрибуторов и крупных проектов — защищает бренд и упрощает учёт на складе клиента. Стоимость флексопечати — индивидуально, обычно от 50 000 ₽ за тираж под клише.',
	},
	{
		q: 'Сколько времени плёнка защищает?',
		a: 'PE при хранении под крышей — до 6 месяцев. На улице под прямым солнцем — 1–2 месяца (плёнка становится хрупкой и может «приклеиться» намертво из-за УФ). После монтажа конструкции плёнку лучше снять в течение 1–2 недель.',
	},
	{
		q: 'Можно ли наклеить плёнку на смонтированную конструкцию?',
		a: 'Для разового нанесения — да, делаем «полевую» поклейку на лестничные ограждения, фасадные кассеты после монтажа, чтобы защитить от повреждений на стройплощадке. Цена — индивидуально, обычно от 200 ₽/м² с выездом на объект в пределах Нижегородской области и соседних регионов.',
	},
];

const pricingNote = `Стоимость нанесения PE плёнки — от 150 ₽/м² на листе 1,5 мм. PVC — от 250 ₽/м². Печать логотипа — индивидуально, в зависимости от тиража.<br><br>На партии от 100 м² — скидка 10 %. Если материал покупается у нас и плёнка ставится сразу после резки — стоимость нанесения снижается на 30 %.`;
---

<ServicePage
	title="Нанесение защитной плёнки на нержавеющий лист и рулон"
	description="Защитная плёнка PE 50–100 мкм и PVC до 200 мкм для зеркального и сатинированного листа. Защита при транспортировке, резке, монтаже. Печать логотипа от партии 1т."
	h1="Нанесение защитной плёнки"
	tagline="PE / PVC · печать логотипа · защита от царапин"
	intro={`<p>Наносим защитные плёнки PE 50–100 мкм и PVC до 200 мкм на нержавеющие листы и рулоны. Плёнка защищает от царапин и загрязнений при транспортировке, резке, штамповке и монтаже — особенно важно для декоративных поверхностей BA, 4N, 8K и для архитектурных проектов.</p><p>Работаем с шириной до 1500 мм. Регулируем адгезию плёнки в зависимости от типа поверхности листа: на матовой 2B используется плёнка с повышенным сцеплением, на зеркальной BA — с пониженным, чтобы плёнка снималась без следа от клея.</p><p>Для крупных заказчиков (дистрибуторов и производственных компаний) делаем плёнку с печатью логотипа, штрих-кода или наименования партии — это упрощает учёт на складе клиента и защищает бренд. Тираж под клише — от 1 тонны.</p>`}
	specs={specs}
	process={process}
	materials={[
		'AISI 304 / 304L',
		'AISI 316L',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430',
		'Поверхности 2B, BA, 4N, 8K',
		'Лист 0,4–6 мм',
		'Рулон до 1500 мм',
	]}
	applications={[
		'Защита зеркальной поверхности BA при транспортировке и монтаже фасадов',
		'Защита сатина 4N для лестничных ограждений и интерьерных панелей',
		'Маркировка партии — логотип / штрих-код для больших партий',
		'Защита от стружки и царапин при штамповке посуды',
		'Защита резного / перфорированного листа при монтаже на объекте',
		'Кровельные и фасадные кассеты — защита от строительной грязи',
	]}
	relatedHubs={[
		{ label: 'Декоративные листы', href: '/dekorativnye-listy/' },
		{ label: 'Лист нержавеющий', href: '/list/' },
		{ label: 'Рулон нержавеющий', href: '/rulon/' },
	]}
	faq={faq}
	pricingNote={pricingNote}
/>
