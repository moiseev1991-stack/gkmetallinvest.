---
import ServicePage from '../../../components/ServicePage.astro';

const specs = [
	{ label: 'Максимальная толщина листа', value: 'до 6 мм' },
	{ label: 'Размер обрабатываемого листа', value: 'до 1500 × 3000 мм' },
	{ label: 'Минимальный диаметр отверстия', value: 'от 1 мм (лазер), от 3 мм (КПП)' },
	{ label: 'Расстояние между отверстиями', value: 'от 1,5 диаметра' },
	{ label: 'Точность позиционирования', value: '±0,1 мм' },
	{ label: 'Минимальная партия', value: 'пробная партия — 1 лист' },
	{ label: 'Сертификат завода', value: 'сохраняется' },
];

const process = [
	{ n: 1, title: 'Чертёж', text: 'Принимаем чертёж в DXF/DWG/AI или эскиз с указанием шага и диаметра отверстий.' },
	{ n: 2, title: 'Программа', text: 'Раскраиваем чертёж в управляющую программу для лазера или КПП, оптимизируя путь инструмента.' },
	{ n: 3, title: 'Пробная партия', text: 'Делаем 1–3 пробных листа — согласуем результат с заказчиком, при необходимости корректируем.' },
	{ n: 4, title: 'Серийная партия', text: 'Перфорируем основной объём, контролируем размеры и качество кромок.' },
	{ n: 5, title: 'Отгрузка', text: 'Упаковка с защитой от царапин, сертификат завода + наш паспорт.' },
];

const faq = [
	{
		q: 'Что эффективнее — лазер или координатно-пробивной пресс (КПП)?',
		a: 'Лазер — для тонких листов (до 3 мм), мелких отверстий и сложных рисунков. Не создаёт механических напряжений и заусенцев. КПП — для толщин 1–6 мм и стандартных рисунков (круглая, щелевая, шестигранная перфорация); работает быстрее на больших партиях. Выбор делаем по объёму и геометрии.',
	},
	{
		q: 'Какие стандартные рисунки перфорации?',
		a: 'Круглая в шахматке (Rv), круглая в коридоре (Rc), квадратная (Qg), щелевая (Lv), фигурная (под звезду, шестиугольник, цветок). Соотношение «диаметр / шаг» по ГОСТ 14792. Под архитектурные задачи делаем фигурные узоры по эскизу — растяжку, градиент, логотипы.',
	},
	{
		q: 'Какие минимальные диаметры отверстий?',
		a: 'На лазере — от 1 мм при толщине 1 мм (правило: диаметр ≥ толщина). На КПП — от 3 мм. Минимальная перемычка (расстояние между отверстиями) — не менее 1,5 диаметра, иначе лист становится хрупким.',
	},
	{
		q: 'Можно ли заказать перфорацию листа толщиной 8–10 мм?',
		a: 'Лазером — нет (предельная толщина 6 мм). Толстые листы (8–20 мм) делаем плазменной резкой или гидроабразивом — это дольше и дороже, но позволяет получить нужный рисунок. Под такие задачи — индивидуальный расчёт.',
	},
	{
		q: 'Свой материал можно принести?',
		a: 'Да, перфорируем «давальческий» материал. Принесите листы — мы перфорируем по чертежу. Цена услуги для давальческого металла — на 20–30 % выше, чем при покупке у нас, так как мы не зарабатываем на материале.',
	},
	{
		q: 'Какие сроки?',
		a: 'Пробный лист — 2–3 рабочих дня. Серийная партия от 10 листов — 5–7 дней. Сложные архитектурные узоры с большим количеством отверстий — до 10 рабочих дней. Срок согласовываем после получения чертежа.',
	},
];

const pricingNote = `Стоимость перфорации зависит от количества отверстий, диаметра, толщины листа и материала. Базовые ориентиры: круглая перфорация Rv5-8 на листе 1,5 мм AISI 304 — от 3000 ₽/м². Сложные архитектурные рисунки и тонкие отверстия (диаметр меньше толщины) — индивидуальный расчёт.<br><br>На пробную партию (1–3 листа) — стандартная цена. Для серийных заказов от 50 листов — скидка 5–10 %. Цена материала в расчёт входит отдельно по нашему прайсу на лист.`;
---

<ServicePage
	title="Перфорация листов из нержавеющей стали — лазер и КПП"
	description="Перфорация нержавеющих листов на лазере и координатно-пробивном прессе. Толщины до 6 мм, отверстия от 1 мм, круглая/щелевая/фигурная. По чертежу от пробной партии."
	h1="Перфорация листов"
	tagline="Лазер · координатно-пробивной пресс · фигурные узоры"
	intro={`<p>Перфорируем нержавеющие листы на лазерных и координатно-пробивных станках под архитектурные, фильтрационные, акустические и декоративные задачи. Работаем с толщинами от 0,5 до 6 мм и листами размером до 1500 × 3000 мм. Принимаем чертежи в DXF, DWG, AI или работаем по эскизу.</p><p>Лазер используется для тонких листов (до 3 мм) и сложных рисунков с мелкими отверстиями. КПП — для стандартных перфораций с большим количеством одинаковых отверстий на средних толщинах: рабочий цикл быстрее, цена ниже. На лазере минимальный диаметр отверстия — 1 мм, на КПП — от 3 мм.</p><p>Делаем пробную партию из 1–3 листов перед серийным запуском, чтобы заказчик мог утвердить геометрию и качество кромки. На каждую партию выдаём сертификат завода на исходный лист и наш паспорт качества с результатами обмера.</p>`}
	specs={specs}
	process={process}
	materials={[
		'AISI 304 (08Х18Н10)',
		'AISI 316L',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430',
		'Толщины 0,5–6 мм',
		'Поверхности 2B, BA, 4N',
		'С защитной плёнкой',
	]}
	applications={[
		'Архитектурные фасады и навесные кассеты с фигурной перфорацией',
		'Звукопоглощающие панели для концертных залов, студий, офисов',
		'Фильтрационные сетки для нефтехимии, водоочистки, пищепрома',
		'Декоративные экраны радиаторов, лестничные ограждения',
		'Технологические корзины и контейнеры с дренажными отверстиями',
		'Грохоты и сита для сортировки сыпучих материалов',
	]}
	limitations={[
		'Максимальная толщина листа — 6 мм; для толстых задач используется гидроабразив',
		'Минимальное расстояние между отверстиями — 1,5 диаметра, иначе лист теряет прочность',
		'Большие архитектурные панели > 3000 мм длиной — режутся отдельным заказом',
	]}
	relatedHubs={[
		{ label: 'Лист нержавеющий', href: '/list/' },
		{ label: 'Декоративные листы', href: '/dekorativnye-listy/' },
	]}
	faq={faq}
	pricingNote={pricingNote}
/>
