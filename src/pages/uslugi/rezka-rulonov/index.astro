---
import ServicePage from '../../../components/ServicePage.astro';

const specs = [
	{ label: 'Длина листа после поперечной резки', value: 'до 12 000 мм' },
	{ label: 'Точность резки в размер', value: '±1 мм' },
	{ label: 'Толщина рулона (поперечная резка)', value: '0,4–4,0 мм' },
	{ label: 'Толщина для штрипса', value: 'до 4 мм' },
	{ label: 'Шаг ширины штрипса', value: 'от 5 мм' },
	{ label: 'Минимальная партия', value: 'от 1 хлыста / бухты' },
	{ label: 'Сертификат на партию', value: 'выдаётся' },
];

const process = [
	{ n: 1, title: 'ТЗ', text: 'Принимаем заявку: толщина, марка, длина листа или ширина штрипса, требуемое количество.' },
	{ n: 2, title: 'Подбор рулона', text: 'Подбираем рулон с подходящей толщиной и поверхностью из наличия или резервируем под заказ.' },
	{ n: 3, title: 'Раскрой', text: 'На станках поперечной или продольной резки разматываем рулон и режем в нужный формат.' },
	{ n: 4, title: 'Контроль', text: 'Проверяем размеры, торцы, маркируем партию и упаковываем.' },
	{ n: 5, title: 'Отгрузка', text: 'Отгружаем со склада в Нижнем Новгороде с сертификатами и УПД.' },
];

const faq = [
	{
		q: 'Что выгоднее — купить рулон и резать у вас или сразу взять листы?',
		a: 'Если вам нужно 5+ листов одного размера, цена за тонну выходит на 5–10% дешевле через резку рулона. Плюс из рулона мы можем сделать нестандартные длины — до 12 м без сварного шва, что для готовых листов невозможно. Если 1–2 листа стандартных длин — обычно проще взять готовые листы из раздела «Лист».',
	},
	{
		q: 'Какие толщины и ширины рулонов можете резать?',
		a: 'Поперечно режем толщины 0,4–4 мм, ширина рулона до 1500 мм. Продольная резка в штрипс — толщина до 4 мм, шаг ширины 5 мм. Под пружинную ленту толщиной 0,1–0,5 мм мы пускаем рулон через перемотку и калибровку — точность по ширине ±0,1 мм.',
	},
	{
		q: 'Сколько по времени занимает резка?',
		a: 'Стандартная партия (5–20 листов) — 1–2 рабочих дня. Большие партии или продольная резка в штрипс — 3–5 дней. Срок согласовываем при размещении заявки. На срочные заказы — по запросу.',
	},
	{
		q: 'Какая точность реза?',
		a: 'Поперечная резка в лист — длина ±1 мм. Продольная резка штрипса — ширина ±0,1 мм. Если требуется более точный размер (под автоматическую штамповку) — обсудим возможности дополнительной калибровки.',
	},
	{
		q: 'Сертификат завода сохраняется?',
		a: 'Да. На каждую партию после резки прикладываем сертификат завода на исходный рулон с указанием плавки. Для тендерных закупок — отдельно паспорт нашего производства с подписями и печатью.',
	},
	{
		q: 'Можно ли заказать резку рулона, который уже куплен в другом месте?',
		a: 'Да, режем «давальческий» материал. Принимаем рулон, режем по ТЗ, возвращаем готовый продукт. Цена услуги — по согласованию, обычно от 4 000 ₽/тонна для поперечной и от 6 000 ₽/тонна для продольной резки.',
	},
];

const pricingNote = `Стоимость резки рассчитывается отдельно для каждого заказа: зависит от толщины, марки, количества резов и формата. Базовые ориентиры: поперечная резка в лист — от 4 000 ₽/т, продольная в штрипс — от 6 000 ₽/т. Минимальный заказ услуги — 500 кг по весу рулона. <br><br>Если рулон покупается у нас — резка считается со скидкой 30 % от прайса, что обычно даёт цену готового листа на 5–10 % ниже, чем при покупке готовых листов того же формата.`;
---

<ServicePage
	title="Продольная и поперечная резка рулонов нержавеющей стали"
	description="Резка нержавеющих рулонов в лист до 12 м и штрипс до 4 мм. Точность ±1 мм, AISI 304/316L/321/430, сертификат на партию. Цена от 4000 ₽/т."
	h1="Продольная и поперечная резка рулонов"
	tagline="Рулон → лист или штрипс"
	heroImage="/img/catalog/rulon.jpg"
	heroImageAlt="Рулон нержавеющей стали в размотке — исходный материал для поперечной и продольной резки"
	intro={`<p>Принимаем нержавеющие рулоны в поперечную и продольную резку. Поперечная резка превращает рулон в листы заданной длины — от 500 мм до 12 м, что позволяет получить «длинный лист» без сварного шва. Продольная резка делит рулон по ширине на штрипсы — узкие полосы 5–500 мм с шагом 5 мм, которые идут на собственный раскрой или штамповку.</p><p>Работаем с толщинами 0,4–4 мм и марками AISI 304, 316L, 321, 430, 12Х18Н10Т, дуплекс. Точность реза ±1 мм по длине листа и ±0,1 мм по ширине штрипса. На каждую партию выдаём сертификат завода-изготовителя на исходный рулон и наш паспорт качества с результатами обмера.</p><p>Минимальная партия — 500 кг по весу. Для проектов с пробной партией — обсуждаем индивидуально. Цена услуги начинается от 4000 ₽/т на поперечную резку и от 6000 ₽/т на продольную в штрипс.</p>`}
	specs={specs}
	process={process}
	materials={[
		'AISI 304 (08Х18Н10)',
		'AISI 304L (03Х18Н11)',
		'AISI 316L (03Х17Н14М2)',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430 (08Х17)',
		'AISI 201',
		'Дуплекс',
		'Поверхности 2B, BA, 4N',
		'С защитной плёнкой PE / PVC',
	]}
	applications={[
		'Производство сэндвич-панелей и облицовочных кассет',
		'Заготовки для штамповки посуды, кухонного оборудования',
		'Кровельные и фасадные системы из нержавейки',
		'Лента для упаковочных автоматов и медтехники',
		'Заготовки для трубопроизводства из штрипса',
		'Электротехническая лента для нагревательных и резистивных элементов',
	]}
	limitations={[
		'Не работаем с толщинами свыше 4 мм — для таких задач используется горячекатаный лист',
		'Не режем углеродистую сталь и алюминий — только нержавеющие сплавы',
		'Минимальная партия — 500 кг по весу исходного рулона',
	]}
	relatedHubs={[
		{ label: 'Рулон нержавеющий', href: '/rulon-nerzhaveyushchiy/' },
		{ label: 'Лист нержавеющий', href: '/list-nerzhaveyushchiy/' },
		{ label: 'Лента / штрипс', href: '/lenta-nerzhaveyushchaya/' },
	]}
	faq={faq}
	pricingNote={pricingNote}
/>
