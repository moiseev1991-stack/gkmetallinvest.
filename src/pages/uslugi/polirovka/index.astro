---
import ServicePage from '../../../components/ServicePage.astro';

const specs = [
	{ label: 'Финальная шероховатость', value: 'Ra ≤ 0,4 мкм (зеркало)' },
	{ label: 'Поверхности', value: 'BA, 4N, 8K, сатин' },
	{ label: 'Толщина / диаметр', value: 'лист 0,5–6 мм, труба Ø 6–325 мм' },
	{ label: 'Максимальный размер листа', value: '1500 × 3000 мм' },
	{ label: 'Длина трубы', value: 'до 6000 мм' },
	{ label: 'Минимальная партия', value: 'от 1 листа / 1 трубы' },
	{ label: 'Стандарты', value: 'DIN, ASME BPE, ISO 4288' },
];

const process = [
	{ n: 1, title: 'Дефектовка', text: 'Принимаем материал, проверяем поверхность на царапины и риски, фиксируем исходную шероховатость.' },
	{ n: 2, title: 'Подготовка', text: 'Снимаем грубые риски на абразивах P80–P120, выравниваем плоскостность.' },
	{ n: 3, title: 'Промежуточная шлифовка', text: 'Постепенно повышаем зернистость: P180 → P240 → P320 → P400 — убираем следы предыдущих этапов.' },
	{ n: 4, title: 'Финишная полировка', text: 'Войлочные и сатиновые круги с пастой — выводим до требуемой Ra. Для зеркала — финишные пасты с алмазной крошкой.' },
	{ n: 5, title: 'Защита', text: 'Наносим защитную плёнку PE или PVC, упаковываем для безопасной транспортировки.' },
];

const faq = [
	{
		q: 'Чем отличается BA, 4N, 8K?',
		a: 'BA («Bright Annealed») — зеркальная поверхность, полученная отжигом в защитной атмосфере на заводе (Ra 0,05–0,2 мкм). 4N — направленный сатин шлифовкой зернистостью P180–P240 (Ra 0,4–0,8 мкм). 8K — зеркало, полученное многоступенчатой полировкой (Ra ≤ 0,05 мкм). 8K — самая трудоёмкая отделка, применяется в декоративных и медицинских задачах.',
	},
	{
		q: 'Можно ли отполировать трубу изнутри?',
		a: 'Да, для трубы Ø ≥ 50 мм делаем внутреннюю электрохимическую и механическую полировку до Ra ≤ 0,4 мкм (требования санитарного исполнения для пищевой и фармацевтической промышленности). Для меньших диаметров — только наружная полировка.',
	},
	{
		q: 'Сертификат качества с указанием Ra выдаётся?',
		a: 'Да, на каждую партию готовим паспорт качества с результатами измерения шероховатости профилометром (тип TR 200) по ISO 4288. Указывается Ra, Rz, Rmax — данные понадобятся для тендерных закупок и приёмки.',
	},
	{
		q: 'Как восстановить блеск на царапанной поверхности BA?',
		a: 'Поверхностные царапины глубиной до 0,2 мм убираются ручной полировкой пастой. Более глубокие — требуют шлифовки от P240 и повторной полировки до зеркала. Цена услуги — от 800 ₽/м². Подходит для лестничных ограждений, фасадов и других видимых элементов после монтажа.',
	},
	{
		q: 'Под пищевые требования (CIP) подойдёт?',
		a: 'Да, делаем полировку до Ra ≤ 0,8 мкм (стандарт ASME BPE для пищевых и фармацевтических трубопроводов). Электрохимическая полировка дополнительно убирает микротрещины — поверхность становится «зеркально-стерильной», на ней не задерживаются органические остатки.',
	},
	{
		q: 'Цена за квадратный метр?',
		a: 'Сатин 4N на листе 1,5 мм — от 600 ₽/м². Зеркало BA — от 1200 ₽/м². 8K — от 2500 ₽/м². Внутренняя полировка трубы Ø 50–150 мм — от 350 ₽/пог. м. Финальный расчёт — после оценки исходного состояния поверхности.',
	},
];

const pricingNote = `Стоимость полировки зависит от исходной шероховатости, требуемой финишной Ra и площади поверхности. Сатин 4N — от 600 ₽/м², зеркало BA — от 1200 ₽/м², 8K — от 2500 ₽/м². Электрохимическая полировка для пищевых линий — индивидуальный расчёт.<br><br>На партии от 50 м² — скидка 10 %. Если материал покупается у нас — снижение цены полировки на 15 %.`;
---

<ServicePage
	title="Полировка нержавеющей стали — до зеркала Ra ≤ 0,4 мкм"
	description="Полировка листов и труб из нержавейки: сатин 4N, зеркало BA, финишная 8K. Электрохимия для пищевых линий. Лист до 1500×3000, труба Ø 6–325. Паспорт Ra."
	h1="Полировка нержавеющей стали"
	tagline="Зеркало BA · сатин 4N · финишное 8K"
	intro={`<p>Полируем нержавеющие листы и трубы под архитектурные, пищевые, фармацевтические и интерьерные задачи. Достигаем шероховатости Ra ≤ 0,4 мкм для пищевой промышленности и Ra ≤ 0,05 мкм для декоративных и медицинских поверхностей класса 8K. Работаем с листом до 1500 × 3000 мм и трубой Ø 6–325 мм длиной до 6 м.</p><p>Полировочный процесс — от 3 до 5 этапов с постепенным повышением зернистости абразива (P80 → P120 → P180 → P240 → P320 → P400 → финишная паста). На каждом этапе убираем риски от предыдущего, чтобы поверхность стала равномерной. Для зеркала 8K — финишные пасты с алмазной крошкой и войлочные круги.</p><p>Для пищевых и фармацевтических линий применяем электрохимическую полировку — она дополнительно убирает микротрещины, на которых могут задерживаться органические остатки. Поверхность становится «зеркально-стерильной» по требованиям ASME BPE и DIN.</p>`}
	specs={specs}
	process={process}
	materials={[
		'AISI 304 / 304L',
		'AISI 316L (для пищевых)',
		'AISI 321 (12Х18Н10Т)',
		'AISI 430 (декор)',
		'Дуплекс',
		'AISI 201',
		'Лист 0,5–6 мм',
		'Труба Ø 6–325 мм',
	]}
	applications={[
		'Архитектурные фасады и лестничные ограждения — зеркало BA или сатин 4N',
		'Технологические ёмкости и реакторы пищевой промышленности — Ra ≤ 0,8 мкм по ASME BPE',
		'Фармацевтические трубопроводы и стерильные линии — электрохимия + Ra ≤ 0,4 мкм',
		'Декоративные интерьеры — отели, рестораны, бутики — 8K',
		'Медицинский инструмент и хирургические столы — 8K',
		'Декоративные элементы автомобилей и яхт',
	]}
	limitations={[
		'Максимальная длина листа — 3000 мм; более длинные обрабатываются составной полировкой',
		'Внутренняя полировка трубы — только для Ø ≥ 50 мм',
		'Слишком тонкие листы (< 0,5 мм) могут деформироваться при механической полировке — применяем щадящие режимы',
	]}
	relatedHubs={[
		{ label: 'Лист нержавеющий', href: '/list-nerzhaveyushchiy/' },
		{ label: 'Декоративные листы', href: '/dekorativnye-listy/' },
		{ label: 'Труба нержавеющая', href: '/truba-nerzhaveyushchaya/' },
	]}
	faq={faq}
	pricingNote={pricingNote}
/>
