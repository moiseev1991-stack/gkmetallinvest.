---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: серебрение — № 19 в его списке, собственный цех. Цены не
   публикуем; толщин и размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Гальваническое серебро' },
	{ label: 'Основа', value: 'Медь, латунь, бронза; сталь — по подслою' },
	{ label: 'Назначение', value: 'Электрический контакт, высокочастотные детали, пайка' },
	{ label: 'Исходные данные', value: 'Чертёж или фото, толщина слоя, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь и толщина слоя — серебро заметная часть цены' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, материал, толщину слоя и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем зоны покрытия и толщину, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем, активируем поверхность, при необходимости наносим подслой.' },
	{ n: 4, title: 'Серебрение', text: 'Наносим серебро в гальванической ванне.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем покрытие, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Зачем серебрить контакты?',
		a: 'Серебро лучше всех металлов проводит ток. Посеребрённый контакт даёт низкое переходное сопротивление, меньше греется и дольше работает. Поэтому серебрят силовые контакты, шины и детали высокочастотной техники.',
	},
	{
		q: 'Почему серебро темнеет и страшно ли это?',
		a: 'На воздухе серебро реагирует с сернистыми соединениями и покрывается тёмной плёнкой. Для силовых контактов это обычно не критично, для слаботочных и внешнего вида — важно, поэтому хранение и защиту обсуждаем заранее.',
	},
	{
		q: 'Чем серебрение отличается от золочения?',
		a: 'Серебро дешевле и лучше проводит ток, но со временем темнеет. Золото не окисляется и держит стабильный контакт годами, поэтому его выбирают для слаботочных и ответственных контактов.',
	},
	{
		q: 'Можно ли серебрить стальные детали?',
		a: 'Можно, но по подслою меди или никеля — напрямую на сталь серебро держится плохо.',
	},
];

const pricingNote = `Стоимость считаем по изделию. Главное в цене — площадь покрытия и толщина слоя серебра. Добавляются подслой, форма и количество деталей.<br><br>Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Серебрение деталей на заказ — гальваническое покрытие серебром"
	description="Гальваническое серебрение в собственном цехе: контакты, шины, токоведущие и высокочастотные детали. Низкое переходное сопротивление, хорошая паяемость. Медь, латунь, бронза. Расчёт по фото или чертежу."
	h1="Серебрение"
	tagline="Контакты · шины · ВЧ-детали · собственный цех"
	answer="ГК Металлинвест выполняет <strong>гальваническое серебрение</strong> в собственном цехе. Серебро — лучший проводник тока среди металлов: покрытие даёт низкое переходное сопротивление контактов и хорошую паяемость. Серебрим контакты, шины, токоведущие и высокочастотные детали из меди, латуни и бронзы; стоимость считаем по чертежу или фото."
	facts={['Собственный цех', 'Низкое сопротивление контакта', 'Медь, латунь, бронза', 'Расчёт по фото']}
	cover="serebrenie"
	coverAlt="Серебрение контактов, шин и высокочастотных деталей"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Серебрение — гальваническое нанесение слоя серебра. Серебро лучше всех металлов проводит ток и тепло, поэтому покрытие снижает переходное сопротивление контактов и потери в высокочастотных цепях, хорошо паяется и отражает свет.</p><p>Серебрим в собственном цехе контакты, шины, токоведущие детали, детали высокочастотной и электротехнической аппаратуры. Основа — медь, латунь и бронза; на сталь серебро наносят по подслою.</p><p>Для расчёта пришлите чертёж или фото деталей, материал, толщину слоя и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Медь',
		'Латунь',
		'Бронза',
		'Сталь — по подслою',
	]}
	applications={[
		'Электрические контакты и разъёмы',
		'Шины и токоведущие детали',
		'Детали высокочастотной техники',
		'Детали под пайку',
	]}
	limitations={[
		'На воздухе серебро со временем темнеет — условия хранения и защиту обсуждаем заранее',
		'Цена сильно зависит от толщины слоя — серебро наносят только там, где оно нужно',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Гальваническое золочение', href: '/uslugi/galvanicheskie-pokrytiya/zolochenie/' },
		{ label: 'Оловянирование (лужение)', href: '/uslugi/galvanicheskie-pokrytiya/olovyanirovanie/' },
		{ label: 'Меднение', href: '/uslugi/galvanicheskie-pokrytiya/mednenie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
