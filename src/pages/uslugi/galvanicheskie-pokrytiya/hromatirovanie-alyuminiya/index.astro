---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: химическое оксидирование алюминия (электропроводное) —
   № 15 в его списке, собственный цех. Главный запрос кластера —
   «хроматирование». Цены не публикуем. Размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Электропроводная конверсионная плёнка (химическое оксидирование)' },
	{ label: 'Основа', value: 'Алюминий и его сплавы' },
	{ label: 'Размеры детали', value: 'Почти не меняются — плёнка очень тонкая' },
	{ label: 'Назначение', value: 'Защита от коррозии, электрический контакт, основа под окраску' },
	{ label: 'Исходные данные', value: 'Чертёж или фото, марка сплава, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, форма, количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, марку сплава и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем назначение покрытия, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем, травим и осветляем поверхность.' },
	{ n: 4, title: 'Оксидирование', text: 'Погружаем детали в раствор без тока — на поверхности образуется тонкая плёнка.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем сплошность покрытия, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем хроматирование отличается от анодирования?',
		a: 'Анодирование идёт под током и даёт толстую твёрдую плёнку, которая изолирует поверхность. Хроматирование (химическое оксидирование) идёт без тока и даёт очень тонкую плёнку: она защищает от коррозии и под окраску, но сохраняет электрический контакт и почти не меняет размеры.',
	},
	{
		q: 'Проводит ли покрытие ток?',
		a: 'Да, поэтому его и называют электропроводным. Это главная причина выбирать хроматирование для корпусов электроники, экранов и деталей заземления.',
	},
	{
		q: 'Можно ли красить деталь после хроматирования?',
		a: 'Да, плёнка хорошо держит грунт и краску — хроматирование часто делают именно как подготовку алюминия под окраску.',
	},
	{
		q: 'Защищает ли хроматирование от износа?',
		a: 'Нет, плёнка тонкая и от истирания не защищает. Для трущихся деталей нужно анодирование, лучше твёрдое.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, форма деталей и количество.<br><br>Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Хроматирование алюминия — электропроводное оксидирование"
	description="Хроматирование (электропроводное химическое оксидирование) алюминия в собственном цехе: защита от коррозии, электрический контакт, основа под окраску. Корпуса электроники, экраны, шасси. Расчёт по фото."
	h1="Хроматирование алюминия"
	tagline="Электропроводное химическое оксидирование"
	answer="ГК Металлинвест выполняет <strong>хроматирование (электропроводное химическое оксидирование) алюминия</strong> в собственном цехе. Тонкая плёнка защищает алюминий от коррозии, служит основой под окраску и, в отличие от анодирования, проводит ток — поэтому её выбирают для корпусов электроники и деталей с электрическим контактом. Стоимость считаем по чертежу или фото."
	facts={['Собственный цех', 'Проводит ток', 'Основа под окраску', 'Расчёт по фото']}
	cover="hromatirovanie-alyuminiya"
	coverAlt="Хроматирование алюминия — электропроводное химическое оксидирование"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Хроматирование — химическое оксидирование алюминия: деталь погружают в раствор без тока, и на поверхности образуется тонкая конверсионная плёнка. Она защищает алюминий от коррозии, улучшает сцепление краски и, в отличие от анодной плёнки, не изолирует поверхность — сохраняет электрический контакт.</p><p>Выполняем электропроводное химическое оксидирование алюминия и его сплавов в собственном цехе. Покрытие выбирают для корпусов радиоэлектронной аппаратуры, экранов, шасси, деталей заземления и для подготовки алюминия под окраску.</p><p>Для расчёта пришлите чертёж или фото деталей, марку сплава и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Деформируемые алюминиевые сплавы',
		'Корпуса и шасси',
		'Детали после механообработки',
		'Литейные сплавы — по запросу',
	]}
	applications={[
		'Корпуса и шасси радиоэлектронной аппаратуры',
		'Экраны и детали заземления',
		'Детали под окраску и склейку',
		'Детали, где анодирование недопустимо из-за изоляции',
	]}
	limitations={[
		'Плёнка тонкая и от истирания не защищает — для износа нужно анодирование',
		'Защита от коррозии слабее, чем у анодирования — на улице деталь обычно окрашивают',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Анодирование алюминия', href: '/uslugi/galvanicheskie-pokrytiya/anodirovanie/' },
		{ label: 'Анодирование титана', href: '/uslugi/galvanicheskie-pokrytiya/anodirovanie-titana/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
