---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: химическое никелирование — № 5 в его списке, собственный
   цех. Цены не публикуем. Толщин, твёрдости и размеров ванн не давал — не
   пишем. План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Никель-фосфор, химическое осаждение без тока' },
	{ label: 'Слой', value: 'Одинаковой толщины по всей поверхности, в пазах и отверстиях' },
	{ label: 'Основа', value: 'Сталь, медь и латунь; алюминий — по запросу' },
	{ label: 'Исходные данные', value: 'Чертёж с требуемой толщиной слоя, материал, количество' },
	{ label: 'Стоимость', value: 'По чертежу: площадь, толщина слоя, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Чертёж', text: 'Присылаете чертёж с требуемой толщиной слоя, материал и количество деталей.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем толщину и допуски, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и активируем поверхность.' },
	{ n: 4, title: 'Никелирование', text: 'Выдерживаем детали в растворе до нужной толщины слоя.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем покрытие, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем химическое никелирование отличается от гальванического?',
		a: 'Гальваническое идёт под током — слой толще на кромках и тоньше в углублениях. Химическое идёт без тока, реакция одинакова по всей поверхности, поэтому слой ровный везде: на резьбе, в пазах, отверстиях и внутренних каналах.',
	},
	{
		q: 'Какие детали лучше никелировать химически?',
		a: 'Детали сложной формы, с глухими отверстиями и внутренними полостями, и точные детали с жёсткими допусками — там, где неравномерный слой недопустим.',
	},
	{
		q: 'Насколько твёрдое покрытие?',
		a: 'Никель-фосфорный слой твёрже гальванического никеля и хорошо сопротивляется износу. После термообработки его твёрдость дополнительно растёт.',
	},
	{
		q: 'Почему толстый слой обходится дороже?',
		a: 'Химический никель осаждается медленно, поэтому время обработки и расход раствора растут с толщиной слоя. Толщину подбирают по задаче — для защиты от коррозии и для износа она разная.',
	},
];

const pricingNote = `Стоимость считаем по чертежу. На цену влияют площадь поверхности, толщина слоя (она определяет время обработки), форма и количество деталей.<br><br>Пришлите чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Химическое никелирование деталей — равномерный слой без тока"
	description="Химическое никелирование в собственном цехе: равномерный никель-фосфорный слой на деталях сложной формы, в пазах, отверстиях и полостях. Износостойкость и защита от коррозии. Расчёт по чертежу."
	h1="Химическое никелирование"
	tagline="Равномерный слой · сложная форма · без тока"
	answer="ГК Металлинвест выполняет <strong>химическое никелирование</strong> в собственном цехе. Никель осаждается из раствора без тока, поэтому слой одинаковой толщины ложится везде — на кромках, в пазах, отверстиях и внутренних полостях. Покрытие твёрдое, износостойкое и защищает от коррозии; стоимость считаем по чертежу."
	facts={['Собственный цех', 'Равномерный слой', 'Сложная форма и отверстия', 'Расчёт по чертежу']}
	cover="himicheskoe-nikelirovanie"
	coverAlt="Химическое никелирование — равномерный слой без тока"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Химическое никелирование — осаждение сплава никеля с фосфором из раствора без электрического тока. Реакция идёт на всей поверхности, которую смачивает раствор, поэтому толщина слоя одинакова на кромках, в углублениях, резьбе и внутренних каналах — там, где гальванический никель ложится неравномерно.</p><p>Выполняем химическое никелирование в собственном цехе для деталей сложной формы, точных деталей с жёсткими допусками и деталей, которым нужны износостойкость и защита от коррозии.</p><p>Для расчёта пришлите чертёж с требуемой толщиной слоя, материал и количество деталей.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая и легированная сталь',
		'Медь и латунь',
		'Алюминий — по запросу',
		'Детали сложной формы',
	]}
	applications={[
		'Детали гидравлики и пневматики',
		'Пресс-формы и оснастка',
		'Детали с резьбой, пазами и глухими отверстиями',
		'Точные детали с жёсткими допусками',
		'Детали насосов и арматуры',
	]}
	limitations={[
		'Слой осаждается медленно — толстые покрытия дольше и дороже',
		'Толщина слоя одинакова по всей детали — её учитывают в допусках',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Гальваническое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/nikelirovanie/' },
		{ label: 'Твёрдое хромирование', href: '/uslugi/galvanicheskie-pokrytiya/tverdoe-hromirovanie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
