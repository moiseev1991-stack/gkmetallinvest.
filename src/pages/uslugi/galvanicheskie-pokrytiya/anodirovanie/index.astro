---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: анодирование алюминия (бцв, ч, нхр, нв), твёрдое
   20–40 и 40–60 мкм, эматалирование, хромовое (№ 10, 11, 13, 14 в его
   списке), собственный цех. Цены не публикуем. Размеров ванн и сплавов,
   которые клиент не называл, не пишем. План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Бесцветное', value: 'Защитное покрытие, сохраняет естественный вид металла' },
	{ label: 'Чёрное', value: 'Декоративное покрытие, поглощает свет' },
	{ label: 'С наполнением в воде (нв)', value: 'Поры плёнки закрыты — выше стойкость к коррозии' },
	{ label: 'С наполнением в хроматах (нхр)', value: 'Повышенная защита от коррозии, желтоватый оттенок' },
	{ label: 'Твёрдое 20–40 и 40–60 мкм', value: 'Толстый износостойкий слой для трущихся деталей' },
	{ label: 'Эматалирование', value: 'Непрозрачная эмалевидная плёнка — декоративная и защитная' },
	{ label: 'Хромовое', value: 'Тонкая плёнка для точных деталей и сборок' },
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Стоимость', value: 'По чертежу или фото: площадь, вид, толщина, количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, марку сплава, вид анодирования и количество.' },
	{ n: 2, title: 'Согласование', text: 'Уточняем вид, толщину, наполнение и места крепления на подвеске, считаем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем, травим и осветляем поверхность.' },
	{ n: 4, title: 'Анодирование', text: 'Выращиваем оксидную плёнку нужного вида и толщины.' },
	{ n: 5, title: 'Окрашивание и наполнение', text: 'При необходимости окрашиваем в чёрный и закрываем поры — в воде или растворе хроматов.' },
	{ n: 6, title: 'Контроль и отгрузка', text: 'Проверяем внешний вид, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем твёрдое анодирование отличается от обычного?',
		a: 'Обычное анодирование даёт тонкую защитную или декоративную плёнку. Твёрдое идёт в охлаждённом электролите и даёт толстый плотный слой — 20–40 или 40–60 мкм. Он заметно твёрже и износостойче, поэтому его применяют для трущихся деталей.',
	},
	{
		q: 'Что значит наполнение анодной плёнки?',
		a: 'Анодная плёнка пористая. Наполнение закрывает поры — в горячей воде (нв) или в растворе хроматов (нхр). После этого плёнка лучше защищает от коррозии и не впитывает загрязнения.',
	},
	{
		q: 'Что такое эматалирование?',
		a: 'Разновидность анодирования, при которой получается непрозрачная плёнка, похожая на эмаль или фарфор. Её выбирают как декоративное и одновременно защитное покрытие.',
	},
	{
		q: 'Меняется ли размер детали после анодирования?',
		a: 'Да. Плёнка растёт примерно наполовину внутрь металла и наполовину наружу, поэтому размер увеличивается примерно на половину толщины слоя на сторону. Для твёрдого анодирования это учитывают в допусках; посадочные места можно защитить от покрытия.',
	},
	{
		q: 'Можно ли анодировать детали после сварки?',
		a: 'Можно, но шов и зона сварки после анодирования могут отличаться по цвету от основного металла. Если внешний вид важен, это обсуждаем заранее.',
	},
];

const pricingNote = `Стоимость считаем по чертежу или фото. На цену влияют площадь поверхности, вид анодирования (твёрдое дороже обычного), толщина слоя, окрашивание и наполнение, форма и количество деталей.<br><br>Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Анодирование алюминия на заказ — бесцветное, чёрное, твёрдое"
	description="Анодирование алюминия в собственном цехе: бесцветное и чёрное, с наполнением в воде и хроматах, твёрдое 20–40 и 40–60 мкм, эматалирование, хромовое. Расчёт по чертежу или фото."
	h1="Анодирование алюминия"
	tagline="Бесцветное · чёрное · твёрдое 20–60 мкм · собственный цех"
	answer="ГК Металлинвест выполняет <strong>анодирование алюминия и его сплавов</strong> в собственном цехе: бесцветное и чёрное, с наполнением в воде или в растворе хроматов, твёрдое анодирование толщиной 20–40 и 40–60 мкм, эматалирование и хромовое анодирование. Анодная плёнка защищает алюминий от коррозии и износа; стоимость считаем по чертежу или фото деталей."
	facts={['Собственный цех', 'Бесцветное и чёрное', 'Твёрдое 20–60 мкм', 'Расчёт по чертежу']}
	cover="anodirovanie"
	coverAlt="Анодирование алюминия — бесцветное, чёрное, твёрдое 20–60 мкм"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Анодирование — электрохимическое окисление поверхности алюминия: деталь служит анодом в электролите, и на ней вырастает оксидная плёнка, прочно связанная с металлом. Она защищает от коррозии, повышает твёрдость и износостойкость поверхности, служит электроизоляцией и основой под окраску и склейку.</p><p>Выполняем в собственном цехе все основные виды: бесцветное и чёрное анодирование с наполнением в воде или в растворе хроматов, твёрдое анодирование толщиной 20–40 и 40–60 мкм, эматалирование и хромовое анодирование.</p><p>Для расчёта пришлите чертёж или фото деталей, марку сплава, вид анодирования и количество.</p>`}
	specsTitle="Виды анодирования"
	specs={specs}
	process={process}
	materials={[
		'Деформируемые алюминиевые сплавы',
		'Профиль и лист',
		'Детали после механообработки',
		'Литейные сплавы — по запросу',
	]}
	applications={[
		'Корпуса приборов и электроники',
		'Профиль и детали фасадов, интерьера и мебели',
		'Трущиеся детали — направляющие, втулки, поршни (твёрдое анодирование)',
		'Детали оптики и приборов — чёрное анодирование',
		'Электроизоляция поверхности алюминиевых деталей',
		'Основа под окраску и склейку',
	]}
	limitations={[
		'В местах крепления детали на подвеске остаются небольшие точки без покрытия — место согласуем заранее',
		'Твёрдое анодирование увеличивает размер детали — учитывайте в допусках',
		'Сплавы с высоким содержанием кремния и меди анодируются хуже — возможна неравномерность цвета',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Хроматирование алюминия', href: '/uslugi/galvanicheskie-pokrytiya/hromatirovanie-alyuminiya/' },
		{ label: 'Анодирование титана', href: '/uslugi/galvanicheskie-pokrytiya/anodirovanie-titana/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
