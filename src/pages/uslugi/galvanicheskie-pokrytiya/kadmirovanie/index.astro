---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: кадмирование бесцветное и хроматированное, фосфатированное,
   фосфатированное с оксидированием (№ 2, 21, 22, 24 в его списке), собственный
   цех. Цены не публикуем. Толщин и размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Бесцветное (бцв)', value: 'Светлое защитное покрытие' },
	{ label: 'Хроматированное (хр)', value: 'Повышенная стойкость к коррозии' },
	{ label: 'Фосфатированное', value: 'Основа под окраску и смазку, в том числе с оксидированием' },
	{ label: 'Основа', value: 'Углеродистая и легированная сталь' },
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Исходные данные', value: 'Чертёж с обозначением покрытия, материал, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, вид покрытия, количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж с обозначением покрытия, материал и количество деталей.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем вид покрытия и требования к резьбе, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и травим поверхность.' },
	{ n: 4, title: 'Кадмирование', text: 'Наносим слой кадмия в гальванической ванне.' },
	{ n: 5, title: 'Доводка покрытия', text: 'Хроматируем или фосфатируем — по обозначению в чертеже.' },
	{ n: 6, title: 'Контроль и отгрузка', text: 'Проверяем внешний вид, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем кадмирование отличается от цинкования?',
		a: 'Оба покрытия защищают сталь электрохимически. Кадмий лучше держится во влажной и морской атмосфере, его продукты коррозии не образуют объёмного налёта, кадмированная резьба легко свинчивается, а покрытие хорошо паяется. Цинк дешевле и безопаснее, поэтому его применяют шире.',
	},
	{
		q: 'Где применяют кадмирование?',
		a: 'Там, где его требует конструкторская документация: крепёж и детали авиационной, морской и специальной техники, электрические разъёмы, детали, работающие в морском климате.',
	},
	{
		q: 'Безопасно ли кадмиевое покрытие?',
		a: 'Кадмий токсичен. Поэтому кадмирование не применяют для деталей, контактирующих с пищевыми продуктами и питьевой водой, — только для технических изделий по документации.',
	},
	{
		q: 'Что даёт фосфатирование после кадмирования?',
		a: 'Фосфатная плёнка поверх кадмия служит основой под лакокрасочное покрытие и удерживает смазку. Вариант с оксидированием дополнительно повышает защитные свойства.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, вид покрытия (бесцветное, хроматированное, фосфатированное), форма и количество деталей.<br><br>Пришлите чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Кадмирование деталей на заказ — бесцветное, хроматированное"
	description="Гальваническое кадмирование стальных деталей в собственном цехе: бесцветное и хроматированное, фосфатированное, с оксидированием. Защита от коррозии во влажной и морской среде. Расчёт по чертежу."
	h1="Кадмирование"
	tagline="Бесцветное · хроматированное · фосфатированное"
	answer="ГК Металлинвест выполняет <strong>гальваническое кадмирование</strong> стальных деталей в собственном цехе: бесцветное и хроматированное, а также фосфатированное и фосфатированное с оксидированием. Кадмий защищает сталь от коррозии во влажной и морской среде, а кадмированная резьба легко свинчивается. Стоимость считаем по чертежу или фото деталей."
	facts={['Собственный цех', 'Бесцветное и хроматированное', 'Морская и влажная среда', 'Расчёт по чертежу']}
	cover="kadmirovanie"
	coverAlt="Кадмирование — бесцветное, хроматированное, фосфатированное"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Кадмирование — гальваническое покрытие стали кадмием. Как и цинк, кадмий защищает сталь электрохимически, но лучше ведёт себя во влажной и морской атмосфере, а его продукты коррозии не образуют объёмного налёта. Кадмированный крепёж легко свинчивается, покрытие хорошо паяется.</p><p>Выполняем кадмирование в собственном цехе: бесцветное и хроматированное, фосфатированное и фосфатированное с оксидированием. Кадмирование применяют там, где его требует конструкторская документация — чаще всего для деталей авиационной, морской и специальной техники.</p><p>Для расчёта пришлите чертёж с обозначением покрытия, материал и количество деталей.</p>`}
	specsTitle="Виды и условия"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая сталь',
		'Легированная сталь',
		'Крепёж и метизы',
		'Детали по конструкторской документации',
	]}
	applications={[
		'Крепёж и детали авиационной и морской техники',
		'Детали, работающие во влажной и морской атмосфере',
		'Резьбовые соединения, которые нужно разбирать',
		'Электрические разъёмы и детали под пайку',
		'Детали по документации с кадмиевым покрытием',
	]}
	limitations={[
		'Кадмий токсичен — покрытие не применяют для деталей, контактирующих с пищевыми продуктами и питьевой водой',
		'Для высокопрочных сталей после кадмирования нужен отпуск для удаления водорода — обсуждаем заранее',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Цинкование', href: '/uslugi/galvanicheskie-pokrytiya/cinkovanie/' },
		{ label: 'Гальваническое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/nikelirovanie/' },
		{ label: 'Фосфатирование', href: '/uslugi/galvanicheskie-pokrytiya/fosfatirovanie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
