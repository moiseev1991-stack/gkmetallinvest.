---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: золочение — № 20 в его списке, собственный цех. Цены не
   публикуем; толщин и размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Гальваническое золото' },
	{ label: 'Подслой', value: 'Никель — барьер и износостойкость', href: '/uslugi/galvanicheskie-pokrytiya/nikelirovanie/' },
	{ label: 'Основа', value: 'Медь, латунь, бронза; сталь — по подслою' },
	{ label: 'Назначение', value: 'Контакты, электроника, декоративные изделия' },
	{ label: 'Исходные данные', value: 'Чертёж или фото, толщина слоя, зоны покрытия, количество' },
	{ label: 'Стоимость', value: 'По изделию: в первую очередь толщина слоя и площадь' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, материал, толщину слоя и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем зоны покрытия и толщину, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем, активируем поверхность и наносим никелевый подслой.' },
	{ n: 4, title: 'Золочение', text: 'Наносим золото в гальванической ванне.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем покрытие, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Зачем золотить контакты?',
		a: 'Золото не окисляется и не темнеет, поэтому контакт годами сохраняет стабильно низкое сопротивление. Это важно для слаботочных цепей и разъёмов, где даже тонкая оксидная плёнка мешает сигналу.',
	},
	{
		q: 'Зачем нужен никелевый подслой?',
		a: 'Никель служит барьером: не даёт меди диффундировать в золото и портить контакт, а также повышает износостойкость тонкого золотого слоя.',
	},
	{
		q: 'Можно ли золотить только часть детали?',
		a: 'Да, покрытие можно ограничить нужной зоной — например, контактной площадкой. Это заметно снижает стоимость; возможность уточняем по чертежу.',
	},
	{
		q: 'Чем золочение отличается от серебрения?',
		a: 'Серебро дешевле и лучше проводит ток, но темнеет. Золото дороже, зато не окисляется — его выбирают для ответственных и слаботочных контактов и для декоративных изделий.',
	},
];

const pricingNote = `Стоимость считаем по изделию. Главное в цене — толщина слоя золота и площадь покрытия, поэтому золото наносят только там, где оно нужно. Добавляются подслой, форма и количество деталей.<br><br>Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Гальваническое золочение деталей на заказ"
	description="Гальваническое золочение в собственном цехе: контакты и разъёмы, детали электроники и приборов, декоративные изделия. Золото не окисляется и не темнеет. Расчёт по фото или чертежу."
	h1="Гальваническое золочение"
	tagline="Контакты · электроника · не темнеет"
	answer="ГК Металлинвест выполняет <strong>гальваническое золочение</strong> в собственном цехе. Золото не окисляется и не темнеет, поэтому годами сохраняет стабильно низкое сопротивление контакта — его наносят на контакты, разъёмы и детали электроники, а также на декоративные изделия. Стоимость зависит в первую очередь от толщины слоя; считаем по чертежу или фото."
	facts={['Собственный цех', 'Не окисляется', 'Контакты и разъёмы', 'Расчёт по фото']}
	cover="zolochenie"
	coverAlt="Гальваническое золочение контактов и деталей электроники"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Гальваническое золочение — нанесение тонкого слоя золота на детали в электролите. Золото не окисляется на воздухе и не вступает в реакцию с большинством сред, поэтому покрытие долго сохраняет внешний вид и стабильное переходное сопротивление — даже на слаботочных контактах, где любая оксидная плёнка мешает сигналу.</p><p>Золотим в собственном цехе контакты и разъёмы, детали радиоэлектроники и приборов, а также декоративные изделия. Обычно золото наносят по подслою никеля — он служит барьером и повышает износостойкость.</p><p>Для расчёта пришлите чертёж или фото деталей, материал, толщину слоя и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Медь',
		'Латунь',
		'Бронза',
		'Сталь — по подслою',
	]}
	applications={[
		'Контакты и разъёмы',
		'Детали радиоэлектроники и приборов',
		'Слаботочные контакты с высокими требованиями к надёжности',
		'Декоративные изделия и фурнитура',
	]}
	limitations={[
		'Цена почти целиком зависит от толщины слоя и площади — золото наносят только там, где оно нужно',
		'Тонкий слой мягкий — для часто сочленяемых контактов толщину подбираем под ресурс',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Серебрение', href: '/uslugi/galvanicheskie-pokrytiya/serebrenie/' },
		{ label: 'Гальваническое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/nikelirovanie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
