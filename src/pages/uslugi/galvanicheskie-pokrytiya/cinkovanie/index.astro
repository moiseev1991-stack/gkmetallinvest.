---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: цинкование бесцветное, хроматированное, чёрное (№ 1 в
   его списке), собственный цех; цена — «минимальная 39 ₽ за кг, смотря
   какой цинк и какое изделие». Толщин и размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Цена', value: 'от 39 ₽ за килограмм деталей' },
	{ label: 'Бесцветное (бцв)', value: 'Светлое покрытие с голубоватым оттенком' },
	{ label: 'Хроматированное (хр)', value: 'Радужное покрытие, выше стойкость к коррозии' },
	{ label: 'Чёрное', value: 'Декоративное покрытие с защитой от коррозии' },
	{ label: 'Основа', value: 'Углеродистая и низколегированная сталь' },
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Исходные данные', value: 'Чертёж или фото, вид цинкования, вес или количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, вид цинкования, количество или вес партии.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем вид покрытия и требования к резьбе, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и травим поверхность — от этого зависит сцепление цинка.' },
	{ n: 4, title: 'Цинкование', text: 'Наносим слой цинка в гальванической ванне.' },
	{ n: 5, title: 'Доводка покрытия', text: 'Хроматируем или окрашиваем в чёрный — по выбранному виду.' },
	{ n: 6, title: 'Контроль и отгрузка', text: 'Проверяем внешний вид, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Сколько стоит цинкование?',
		a: 'От 39 ₽ за килограмм деталей. Итоговая цена зависит от вида цинкования (бесцветное, хроматированное, чёрное), формы и размера деталей, толщины покрытия и объёма партии. Пришлите чертёж или фото и вес партии — посчитаем.',
	},
	{
		q: 'Чем отличаются бесцветное, хроматированное и чёрное цинкование?',
		a: 'Все три защищают сталь цинком, разница — в обработке после цинкования. Бесцветное — светлое, с голубоватым оттенком. Хроматированное — радужное и заметно стойче к коррозии. Чёрное выбирают, когда важен внешний вид.',
	},
	{
		q: 'Защищает ли цинк, если покрытие поцарапано?',
		a: 'Да. Цинк активнее железа, поэтому в месте царапины корродирует он, а не сталь. Это главное отличие цинка от лакокрасочного покрытия и от никеля.',
	},
	{
		q: 'Чем гальваническое цинкование отличается от горячего?',
		a: 'Горячее цинкование — погружение в расплав цинка: толстый слой, его применяют для крупных металлоконструкций. Гальваническое даёт тонкий ровный слой и подходит для крепежа и точных деталей — резьба и размеры почти не меняются.',
	},
	{
		q: 'Можно ли цинковать пружины и закалённые детали?',
		a: 'Можно, но у высокопрочной стали при цинковании есть риск водородного охрупчивания. Для таких деталей после цинкования нужен отпуск — это обсуждаем заранее.',
	},
];

const pricingNote = `<strong>Цинкование — от 39 ₽ за килограмм деталей.</strong> Итоговая цена зависит от вида цинкования (бесцветное, хроматированное, чёрное), формы и размера деталей, толщины покрытия и объёма партии.<br><br>Пришлите чертёж или фото и вес партии — назовём стоимость и срок.`;
---

<ServicePage
	title="Цинкование металла на заказ — от 39 ₽/кг"
	description="Гальваническое цинкование деталей в собственном цехе: бесцветное, хроматированное (радужное) и чёрное. Цена от 39 ₽/кг, расчёт по чертежу или фото и весу партии."
	h1="Гальваническое цинкование"
	tagline="От 39 ₽/кг · бесцветное · хроматированное · чёрное"
	answer="ГК Металлинвест выполняет <strong>гальваническое цинкование</strong> стальных деталей в собственном цехе: бесцветное, хроматированное и чёрное. <strong>Цена — от&nbsp;39&nbsp;₽ за килограмм</strong>, итог зависит от вида цинкования, формы деталей и партии. Цинк защищает сталь от коррозии даже при царапинах; для расчёта пришлите чертёж или фото и вес партии."
	facts={['Собственный цех', 'От 39 ₽/кг', 'Бесцветное, радужное, чёрное', 'Расчёт по весу партии']}
	cover="cinkovanie"
	coverAlt="Гальваническое цинкование от 39 ₽/кг — бесцветное, хроматированное, чёрное"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Гальваническое цинкование — нанесение слоя цинка на стальные детали в электролите. Цинк активнее железа, поэтому защищает сталь электрохимически: даже если покрытие поцарапано, коррозия идёт по цинку, а не по стали. После цинкования поверхность обычно хроматируют — это повышает стойкость и задаёт цвет.</p><p>Цинкуем в собственном цехе крепёж, кронштейны, пластины, корпуса и другие стальные детали. Виды покрытия — бесцветное, хроматированное и чёрное. Цена — от 39 ₽ за килограмм деталей.</p><p>Для расчёта пришлите чертёж или фото деталей, вид цинкования, количество или общий вес партии.</p>`}
	specsTitle="Виды и условия"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая сталь',
		'Низколегированная сталь',
		'Крепёж и метизы',
		'Штампованные детали',
		'Пластины и кронштейны',
	]}
	applications={[
		'Крепёж и метизы',
		'Кронштейны, скобы, пластины',
		'Детали машин и оборудования',
		'Электротехнические детали и корпуса',
		'Детали, работающие на улице и во влажных помещениях',
	]}
	limitations={[
		'Высокопрочные стали склонны к водородному охрупчиванию — для пружин и закалённых деталей нужен отпуск после цинкования',
		'Толщину покрытия учитывают в посадке точной резьбы — такие детали обсуждаем заранее',
		'Цена «от 39 ₽/кг» — минимальная; итог зависит от вида цинкования, деталей и партии',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Кадмирование', href: '/uslugi/galvanicheskie-pokrytiya/kadmirovanie/' },
		{ label: 'Гальваническое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/nikelirovanie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
