---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: химическое оксидирование стали с промасливанием — № 9 в
   его списке, собственный цех. Главный запрос кластера — «воронение
   металла». Цены не публикуем; размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Чёрная оксидная плёнка с промасливанием' },
	{ label: 'Основа', value: 'Углеродистая и низколегированная сталь' },
	{ label: 'Размеры детали', value: 'Практически не меняются — резьба и посадки сохраняются' },
	{ label: 'Защита', value: 'От коррозии в помещении, при хранении и перевозке' },
	{ label: 'Исходные данные', value: 'Фото или чертёж, материал, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, форма, количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете фото или чертёж деталей, материал и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем требования к виду и защите, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и травим поверхность — от этого зависит ровность цвета.' },
	{ n: 4, title: 'Оксидирование', text: 'Обрабатываем детали в горячем растворе до ровного чёрного цвета.' },
	{ n: 5, title: 'Промасливание', text: 'Пропитываем плёнку маслом — оно закрывает поры и защищает от коррозии.' },
	{ n: 6, title: 'Контроль и отгрузка', text: 'Проверяем цвет, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Что такое воронение?',
		a: 'Так в обиходе называют химическое оксидирование стали: на поверхности образуется тонкая плёнка оксидов железа чёрного или тёмно-синего цвета. Промышленное оксидирование идёт в горячем щелочном растворе, после чего деталь промасливают.',
	},
	{
		q: 'Защищает ли оксидирование от ржавчины?',
		a: 'В помещении, при хранении и перевозке — да, если сохранена масляная плёнка. Для работы на улице и во влажной среде оксидирования недостаточно — там нужны цинкование или окраска.',
	},
	{
		q: 'Меняется ли размер детали?',
		a: 'Практически нет: оксидная плёнка очень тонкая — порядка микрона. Поэтому оксидируют детали с точными посадками и резьбой.',
	},
	{
		q: 'Чем оксидирование отличается от фосфатирования?',
		a: 'Оксидирование даёт тонкую чёрную плёнку — это защитно-декоративное покрытие без изменения размеров. Фосфатирование даёт более толстую кристаллическую плёнку, которая лучше держит краску и смазку.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, форма и количество деталей.<br><br>Пришлите фото или чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Оксидирование стали (воронение) на заказ — с промасливанием"
	description="Химическое оксидирование (воронение) стальных деталей с промасливанием в собственном цехе: чёрное защитно-декоративное покрытие без изменения размеров. Крепёж, инструмент, детали машин. Расчёт по фото."
	h1="Оксидирование стали (воронение)"
	tagline="Чёрное покрытие · с промасливанием · собственный цех"
	answer="ГК Металлинвест выполняет <strong>химическое оксидирование (воронение) стали с промасливанием</strong> в собственном цехе. На поверхности образуется тонкая чёрная оксидная плёнка, а масло закрывает её поры — деталь получает ровный чёрный цвет и защиту от коррозии в помещении, размеры практически не меняются. Стоимость считаем по фото или чертежу."
	facts={['Собственный цех', 'Чёрный цвет', 'Размеры не меняются', 'Расчёт по фото']}
	cover="oksidirovanie-stali"
	coverAlt="Оксидирование стали (воронение) с промасливанием"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Химическое оксидирование стали (воронение) — обработка деталей в горячем щелочном растворе, после которой на поверхности образуется тонкая плёнка оксидов железа чёрного цвета. Плёнка пористая, поэтому после оксидирования деталь промасливают: масло закрывает поры и заметно повышает защиту от коррозии.</p><p>Оксидируем в собственном цехе крепёж, инструмент, детали машин, приборов и оборудования. Покрытие выбирают, когда нужен ровный чёрный цвет, защита от коррозии в помещении и неизменные размеры — плёнка настолько тонкая, что не влияет на посадки и резьбу.</p><p>Для расчёта пришлите фото или чертёж деталей, материал и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая сталь',
		'Низколегированная сталь',
		'Крепёж и метизы',
		'Инструмент',
		'Детали после механообработки',
	]}
	applications={[
		'Крепёж и метизы',
		'Инструмент и оснастка',
		'Детали машин и приборов',
		'Детали, где нужен чёрный неотражающий цвет',
		'Детали с точными посадками и резьбой',
	]}
	limitations={[
		'Защита рассчитана на помещение — на улице и во влажной среде оксидирование не заменяет цинкование или окраску',
		'Защита держится на масляной плёнке — после обезжиривания она снижается',
		'Высоколегированные и нержавеющие стали оксидируются иначе — обсуждаем отдельно',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Фосфатирование', href: '/uslugi/galvanicheskie-pokrytiya/fosfatirovanie/' },
		{ label: 'Цинкование', href: '/uslugi/galvanicheskie-pokrytiya/cinkovanie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
