---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: гальваническое никелирование блестящее (№ 4 в его
   списке), собственный цех. Цены не публикуем. Толщин и размеров ванн не
   давал — не пишем. План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Блестящий гальванический никель' },
	{ label: 'Основа', value: 'Сталь, медь, латунь; другие металлы — по запросу' },
	{ label: 'Назначение', value: 'Защита от коррозии, декоративный вид, подслой' },
	{ label: 'Сложная форма', value: 'Равномерный слой в пазах и отверстиях — химическое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/himicheskoe-nikelirovanie/' },
	{ label: 'Исходные данные', value: 'Чертёж или фото, материал, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, толщина слоя, количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, материал, требования к покрытию и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем толщину и внешний вид, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и активируем поверхность — царапины и риски убираем до никелирования.' },
	{ n: 4, title: 'Никелирование', text: 'Наносим блестящий никель в гальванической ванне.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем внешний вид, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем гальваническое никелирование отличается от химического?',
		a: 'Гальваническое идёт под током: слой блестящий, но толще на кромках и тоньше во внутренних углах и отверстиях. Химическое идёт без тока — слой одинаковой толщины по всей детали, поэтому его выбирают для сложной формы и точных допусков.',
	},
	{
		q: 'Защищает ли никель сталь от ржавчины?',
		a: 'Да, но никель — катодное покрытие для стали: если слой повреждён, сталь в этом месте может ржаветь. Поэтому для защиты стали важны толщина и сплошность покрытия.',
	},
	{
		q: 'Можно ли никелировать медь и латунь?',
		a: 'Да, никель хорошо ложится на медь и латунь — его наносят для защиты от потемнения, повышения твёрдости поверхности и как подслой под серебро и золото.',
	},
	{
		q: 'Зачем никель под хромом?',
		a: 'Декоративный хром очень тонкий. Блеск и защиту от коррозии даёт слой никеля под ним, а хром защищает никель от потускнения и добавляет твёрдости.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, толщина слоя, требования к блеску, форма и количество деталей.<br><br>Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Никелирование металла на заказ — блестящее гальваническое"
	description="Гальваническое блестящее никелирование деталей из стали, меди и латуни в собственном цехе: защита от коррозии, декоративный вид, подслой. Расчёт по чертежу или фото."
	h1="Гальваническое никелирование"
	tagline="Блестящий никель · защита и декоративный вид"
	answer="ГК Металлинвест выполняет <strong>гальваническое никелирование</strong> в собственном цехе — блестящее никелевое покрытие стальных, медных и латунных деталей. Никель защищает от коррозии, даёт твёрдую блестящую поверхность и служит подслоем под другие покрытия. Стоимость считаем по чертежу или фото деталей."
	facts={['Собственный цех', 'Блестящее покрытие', 'Сталь, медь, латунь', 'Расчёт по фото']}
	cover="nikelirovanie"
	coverAlt="Гальваническое никелирование — блестящий никель на стали, меди и латуни"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Гальваническое никелирование — нанесение слоя никеля на детали в электролите под током. Блестящее никелирование даёт гладкое зеркальное покрытие: оно защищает металл от коррозии, повышает твёрдость поверхности и хорошо выглядит. Никель часто служит и подслоем — под хромирование, серебрение, золочение.</p><p>Никелируем в собственном цехе детали из стали, меди и латуни: крепёж, фурнитуру, корпуса, детали приборов и оборудования. Для деталей сложной формы, где нужен одинаковый слой в пазах и отверстиях, есть химическое никелирование — оно наносится без тока.</p><p>Для расчёта пришлите чертёж или фото деталей, материал, требования к покрытию и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая сталь',
		'Медь',
		'Латунь',
		'Другие металлы — по запросу',
	]}
	applications={[
		'Фурнитура и декоративные детали',
		'Крепёж и метизы',
		'Детали приборов и электроники',
		'Детали оборудования, работающие во влажной среде',
		'Подслой под хромирование, серебрение и золочение',
	]}
	limitations={[
		'Гальванический слой тоньше во внутренних углах и глубоких отверстиях — для сложной формы подходит химическое никелирование',
		'Блеск повторяет исходную поверхность — царапины и риски убирают до никелирования',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Химическое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/himicheskoe-nikelirovanie/' },
		{ label: 'Твёрдое хромирование', href: '/uslugi/galvanicheskie-pokrytiya/tverdoe-hromirovanie/' },
		{ label: 'Цинкование', href: '/uslugi/galvanicheskie-pokrytiya/cinkovanie/' },
		{ label: 'Меднение', href: '/uslugi/galvanicheskie-pokrytiya/mednenie/' },
		{ label: 'Гальваническое золочение', href: '/uslugi/galvanicheskie-pokrytiya/zolochenie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
