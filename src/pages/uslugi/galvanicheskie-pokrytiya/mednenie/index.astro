---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: меднение — № 3 в его списке, собственный цех. Цены не
   публикуем; толщин и размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Гальваническая медь' },
	{ label: 'Основа', value: 'Сталь, латунь; другие металлы — по запросу' },
	{ label: 'Назначение', value: 'Подслой, электропроводность, пайка, защита при цементации' },
	{ label: 'Исходные данные', value: 'Чертёж или фото, назначение покрытия, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, толщина слоя, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, материал, назначение покрытия и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем толщину и какие зоны покрывать, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и травим поверхность, изолируем места без покрытия.' },
	{ n: 4, title: 'Меднение', text: 'Наносим слой меди в гальванической ванне.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем покрытие, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Зачем нужен медный подслой?',
		a: 'Медь хорошо сцепляется со сталью и выравнивает поверхность. Никель, хром, олово и серебро по медному подслою ложатся ровнее и держатся прочнее, а общая защита детали становится лучше.',
	},
	{
		q: 'Почему медь защищает сталь при цементации?',
		a: 'Медь не пропускает углерод. Если покрыть медью участки, которые должны остаться мягкими — например, резьбу, — при цементации они не насытятся углеродом и не закалятся.',
	},
	{
		q: 'Можно ли использовать медь как финишное покрытие?',
		a: 'Можно, но на воздухе медь темнеет. Если нужен её цвет надолго, покрытие закрывают лаком; для контактов и пайки медь чаще покрывают оловом или серебром.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, толщина слоя, нужна ли изоляция отдельных зон, форма и количество деталей.<br><br>Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Меднение деталей на заказ — гальваническое покрытие медью"
	description="Гальваническое меднение в собственном цехе: подслой под никель, хром, олово и серебро, электропроводящее покрытие, защита участков стали при цементации. Расчёт по чертежу или фото."
	h1="Меднение"
	tagline="Подслой · электропроводность · защита при цементации"
	answer="ГК Металлинвест выполняет <strong>гальваническое меднение</strong> в собственном цехе. Медный слой служит подслоем под никель, хром, олово и серебро, улучшает электропроводность и паяемость поверхности и защищает участки стальных деталей при цементации. Стоимость считаем по чертежу или фото деталей."
	facts={['Собственный цех', 'Подслой под покрытия', 'Электропроводность', 'Расчёт по фото']}
	cover="mednenie"
	coverAlt="Меднение — подслой, электропроводность, защита при цементации"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Меднение — гальваническое нанесение слоя меди на детали. Медь мягкая, пластичная, отлично проводит ток, хорошо сцепляется со сталью и служит надёжной основой для других покрытий. Поэтому меднение чаще всего применяют как подслой — под никель, хром, олово, серебро.</p><p>Выполняем меднение в собственном цехе для стальных и латунных деталей. Кроме подслоя, меднение применяют для повышения электропроводности и паяемости поверхности и для местной защиты стальных деталей при цементации — медь не пропускает углерод.</p><p>Для расчёта пришлите чертёж или фото деталей, материал, назначение покрытия и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая сталь',
		'Легированная сталь',
		'Латунь',
		'Другие металлы — по запросу',
	]}
	applications={[
		'Подслой под никелирование и хромирование',
		'Подслой под оловянирование и серебрение',
		'Токопроводящие детали',
		'Местная защита стали при цементации',
		'Детали под пайку',
	]}
	limitations={[
		'На воздухе медь темнеет — как финишное покрытие её закрывают лаком или другим металлом',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Оловянирование (лужение)', href: '/uslugi/galvanicheskie-pokrytiya/olovyanirovanie/' },
		{ label: 'Гальваническое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/nikelirovanie/' },
		{ label: 'Серебрение', href: '/uslugi/galvanicheskie-pokrytiya/serebrenie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
