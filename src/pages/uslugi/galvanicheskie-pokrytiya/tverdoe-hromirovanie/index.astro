---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: хромирование твёрдое (№ 18 в его списке), круглая
   шлифовка (№ 28) — обе в собственном цехе. Цены не публикуем. Толщин слоя
   и размеров ванн клиент не давал — не пишем. План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Твёрдый износостойкий хром' },
	{ label: 'Детали', value: 'Штоки, валы, оси, плунжеры, пальцы' },
	{ label: 'После хромирования', value: 'Шлифовка в размер — круглое шлифование в том же цехе', href: '/uslugi/ploskoe-i-krugloe-shlifovanie/' },
	{ label: 'Исходные данные', value: 'Чертёж с размерами, допусками и толщиной слоя' },
	{ label: 'Стоимость', value: 'По чертежу: площадь, толщина слоя, шлифовка, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Чертёж', text: 'Присылаете чертёж с размерами, допусками и толщиной слоя, материал и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Проверяем припуски под хром и шлифовку, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Шлифуем поверхность под хромирование, обезжириваем, изолируем места без покрытия.' },
	{ n: 4, title: 'Хромирование', text: 'Наращиваем слой твёрдого хрома.' },
	{ n: 5, title: 'Шлифовка в размер', text: 'Выводим размер и шероховатость по чертежу.' },
	{ n: 6, title: 'Контроль и отгрузка', text: 'Проверяем размеры, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем твёрдое хромирование отличается от декоративного?',
		a: 'Декоративный хром — тонкий блестящий слой поверх никеля, его наносят ради внешнего вида. Твёрдый хром наносят толстым слоем прямо на сталь ради свойств поверхности: твёрдости, износостойкости и низкого трения.',
	},
	{
		q: 'Зачем шлифовать деталь после хромирования?',
		a: 'Хром ложится неравномерно — толще на кромках и выступах. Шлифовка выводит точный размер и нужную шероховатость. Поэтому хромирование и шлифовку планируют вместе, с припуском по чертежу.',
	},
	{
		q: 'Можно ли восстановить изношенный шток хромированием?',
		a: 'Да, это типовая ремонтная задача: изношенную поверхность шлифуют, наращивают хром и шлифуют в номинальный размер. Возможность зависит от величины износа — оценим по чертежу или замерам.',
	},
	{
		q: 'Защищает ли твёрдый хром от коррозии?',
		a: 'Хром стоек к коррозии, но в твёрдом слое есть сетка микротрещин. Для деталей, работающих в агрессивной или морской среде, толщину слоя и подслой обсуждаем отдельно.',
	},
];

const pricingNote = `Стоимость считаем по чертежу. На цену влияют площадь хромируемой поверхности, толщина слоя, нужна ли шлифовка до и после хромирования, и количество деталей.<br><br>Пришлите чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Твёрдое хромирование деталей на заказ — штоки, валы, оси"
	description="Твёрдое (износостойкое) хромирование штоков гидроцилиндров, валов и осей в собственном цехе. Шлифовка в размер после хромирования, восстановление изношенных деталей. Расчёт по чертежу."
	h1="Твёрдое хромирование"
	tagline="Штоки · валы · оси · шлифовка в размер"
	answer="ГК Металлинвест выполняет <strong>твёрдое хромирование</strong> стальных деталей в собственном цехе — штоков гидроцилиндров, валов, осей, плунжеров. Толстый слой хрома даёт высокую твёрдость, износостойкость и низкое трение; после хромирования детали шлифуем в размер. Стоимость считаем по чертежу."
	facts={['Собственный цех', 'Штоки, валы, оси', 'Шлифовка в размер', 'Расчёт по чертежу']}
	cover="tverdoe-hromirovanie"
	coverAlt="Твёрдое хромирование штоков, валов и осей — шлифовка в размер"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Твёрдое (износостойкое) хромирование — электролитическое нанесение толстого слоя хрома на стальные детали. В отличие от тонкого декоративного хрома, твёрдый хром наносят ради свойств поверхности: высокой твёрдости, износостойкости, низкого коэффициента трения и стойкости к коррозии.</p><p>Хромируем в собственном цехе штоки гидро- и пневмоцилиндров, валы, оси, плунжеры, пальцы. Хромирование применяют и при ремонте — чтобы восстановить изношенную посадочную поверхность. После нанесения деталь шлифуют в размер — круглое шлифование выполняем здесь же.</p><p>Для расчёта пришлите чертёж с размерами, допусками и требуемой толщиной слоя, материал и количество деталей.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Конструкционная сталь',
		'Легированная сталь',
		'Закалённая сталь',
		'Нержавеющая сталь — по запросу',
	]}
	applications={[
		'Штоки гидро- и пневмоцилиндров',
		'Валы и оси с посадками под подшипники и уплотнения',
		'Плунжеры насосов',
		'Пресс-формы и штампы',
		'Ремонт — восстановление изношенных поверхностей',
	]}
	limitations={[
		'Хром повторяет рельеф поверхности — перед хромированием её шлифуют',
		'Толщину слоя и припуск под шлифовку согласуем по чертежу',
		'Для высокопрочных сталей после хромирования нужен отпуск для удаления водорода — обсуждаем заранее',
		'Размеры и массу деталей для ванн подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные услуги и покрытия"
	relatedHubs={[
		{ label: 'Плоское и круглое шлифование', href: '/uslugi/ploskoe-i-krugloe-shlifovanie/' },
		{ label: 'Гальваническое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/nikelirovanie/' },
		{ label: 'Химическое никелирование', href: '/uslugi/galvanicheskie-pokrytiya/himicheskoe-nikelirovanie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
