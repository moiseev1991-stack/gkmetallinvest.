---
import ServicePage from '../../../components/ServicePage.astro';

/* Факты от клиента (2026-09-24): гальваника в собственном цехе; список
   покрытий — из его перечня направлений (docs/seo/klastery-uslug/
   00-vse-napravleniya-i-vydacha.xlsx). Цена — только у цинкования:
   «минимальная 39 ₽ за кг, смотря какой цинк и какое изделие». Остальные
   покрытия — по расчёту. Размеров ванн и толщин (кроме твёрдого
   анодирования, которое клиент указал сам) не давал — не пишем. */

const specs = [
	{ label: 'Цинкование — от 39 ₽/кг', value: 'Бесцветное, хроматированное, чёрное — защита стали от коррозии' },
	{ label: 'Кадмирование', value: 'Бесцветное и хроматированное, фосфатированное, с оксидированием' },
	{ label: 'Никелирование', value: 'Гальваническое блестящее и химическое — защита и декоративный вид' },
	{ label: 'Твёрдое хромирование', value: 'Износостойкий слой для штоков, валов, осей' },
	{ label: 'Анодирование алюминия', value: 'Бесцветное и чёрное, с наполнением; твёрдое 20–40 и 40–60 мкм; хромовое; эматалирование' },
	{ label: 'Анодирование титана', value: 'Цветное (аноцвет)' },
	{ label: 'Оксидирование', value: 'Химическое оксидирование стали с промасливанием; электропроводное оксидирование алюминия' },
	{ label: 'Фосфатирование', value: 'С оксидированием — защита и основа под окраску' },
	{ label: 'Меднение', value: 'Подслой и электропроводящее покрытие' },
	{ label: 'Оловянирование', value: 'Олово и олово-висмут (матовое) — под пайку и электрический контакт' },
	{ label: 'Серебрение и золочение', value: 'Контакты и токопроводящие детали' },
	{ label: 'Свинцевание', value: 'По запросу' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, материал, вид покрытия, толщину слоя и количество или вес партии.' },
	{ n: 2, title: 'Согласование', text: 'Уточняем покрытие и толщину под условия работы детали, считаем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и травим поверхность — от этого зависит сцепление покрытия.' },
	{ n: 4, title: 'Нанесение', text: 'Наносим покрытие, при необходимости — пассивацию, промасливание или наполнение.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем внешний вид, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Сколько стоит цинкование?',
		a: 'От 39 ₽ за килограмм деталей. Итоговая цена зависит от вида цинкования (бесцветное, хроматированное, чёрное), формы и размера деталей, толщины покрытия и объёма партии. Пришлите чертёж или фото и вес партии — посчитаем.',
	},
	{
		q: 'Какое покрытие выбрать для защиты стали от коррозии?',
		a: 'Для большинства стальных деталей — цинкование с хроматированием: цинк защищает сталь даже при царапинах. Если нужна ещё и износостойкость — твёрдое хромирование, если важен внешний вид — никелирование.',
	},
	{
		q: 'Что такое твёрдое хромирование?',
		a: 'Толстый слой хрома на стальных деталях — штоках гидроцилиндров, валах, осях. Он даёт высокую твёрдость и износостойкость. После нанесения деталь обычно шлифуют в размер — круглое шлифование тоже выполняем.',
	},
	{
		q: 'Чем анодирование отличается от покраски?',
		a: 'Анодирование не наносит слой сверху, а превращает поверхность алюминия в оксидную плёнку. Она прочно связана с металлом, не отслаивается, защищает от коррозии и может быть бесцветной или чёрной. Твёрдое анодирование даёт слой 20–60 мкм для деталей, работающих на износ.',
	},
	{
		q: 'Что нужно для расчёта?',
		a: 'Чертёж или фото деталей, материал, вид покрытия и толщина слоя, количество или общий вес партии. Если не знаете, какое покрытие нужно, опишите условия работы детали — подберём.',
	},
];

const pricingNote = `<strong>Цинкование — от 39 ₽ за килограмм деталей.</strong> Цена зависит от вида цинкования, формы и размера деталей, толщины покрытия и объёма партии.<br><br>Остальные покрытия считаем по изделию: площадь поверхности, толщина слоя, металл покрытия (серебро и золото дороже), количество. Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Гальванические покрытия на заказ — цинкование от 39 ₽/кг"
	description="Гальваника в собственном цехе: цинкование от 39 ₽/кг, никелирование, твёрдое хромирование, анодирование алюминия и титана, оксидирование, серебрение."
	h1="Гальванические покрытия"
	tagline="Цинкование от 39 ₽/кг · никель · хром · анодирование"
	intro={`<p>Наносим гальванические и химические покрытия на металлические детали в собственном цехе: защитные, износостойкие, электропроводящие и декоративные. Покрытие подбираем под задачу — защиту от коррозии, твёрдость и износ, пайку и электрический контакт, внешний вид.</p><p>Цинкование — от 39 ₽ за килограмм. Итоговая цена зависит от вида цинкования (бесцветное, хроматированное, чёрное), формы и размера деталей и объёма партии. Остальные покрытия считаем по изделию.</p><p>Для расчёта пришлите чертёж или фото детали, материал, вид покрытия, толщину слоя и количество.</p>`}
	specsTitle="Какие покрытия наносим"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая и легированная сталь',
		'Нержавеющая сталь',
		'Алюминий и его сплавы',
		'Титан',
		'Медь и латунь',
	]}
	applications={[
		'Крепёж, кронштейны, корпуса — цинкование и кадмирование',
		'Штоки гидроцилиндров, валы, оси — твёрдое хромирование',
		'Корпуса, профили и детали из алюминия — анодирование и оксидирование',
		'Контакты, шины, токопроводящие детали — серебрение, золочение, олово',
		'Детали под пайку — оловянирование',
		'Декоративные детали — никелирование, цветное анодирование титана',
	]}
	limitations={[
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
		'Толщину покрытия на тонкостенных и сложных деталях согласуем по чертежу',
		'Цена «от 39 ₽/кг» — для цинкования; остальные покрытия — по расчёту',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные услуги"
	relatedHubs={[
		{ label: 'Плоское и круглое шлифование', href: '/uslugi/ploskoe-i-krugloe-shlifovanie/' },
		{ label: 'Травление и пассивация', href: '/uslugi/travlenie-i-passivaciya/' },
		{ label: 'Электрохимическая полировка', href: '/uslugi/elektrohimicheskaya-polirovka/' },
		{ label: 'Лазерная резка', href: '/uslugi/lazernaya-rezka/' },
	]}
	faq={faq}
/>
