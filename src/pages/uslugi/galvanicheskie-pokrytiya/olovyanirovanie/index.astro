---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: оловянирование и олово-висмут матовое — № 16 и № 17 в его
   списке, собственный цех. Главный запрос кластера — «лужение». Цены не
   публикуем; толщин и размеров ванн не давал — не пишем.
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Олово', value: 'Защита от окисления, паяемость, электрический контакт' },
	{ label: 'Олово-висмут (матовое)', value: 'Матовое покрытие, стабильнее при хранении и на холоде' },
	{ label: 'Основа', value: 'Медь, латунь, бронза; сталь — по запросу' },
	{ label: 'Исходные данные', value: 'Чертёж или фото, вид покрытия, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, толщина слоя, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете чертёж или фото деталей, материал, вид покрытия и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем назначение — пайка или контакт — и толщину, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и активируем поверхность.' },
	{ n: 4, title: 'Покрытие', text: 'Наносим олово или олово-висмут в гальванической ванне.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Проверяем покрытие, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Зачем лудить медные шины и контакты?',
		a: 'Медь на воздухе окисляется и темнеет, а оксидная плёнка ухудшает контакт и пайку. Слой олова защищает медь, сохраняет низкое переходное сопротивление соединения и паяемость детали при хранении.',
	},
	{
		q: 'Чем олово-висмут отличается от чистого олова?',
		a: 'Сплав олово-висмут даёт матовое покрытие и стабильнее чистого олова при длительном хранении и низких температурах. Его выбирают для деталей, которые долго лежат перед пайкой или работают на холоде.',
	},
	{
		q: 'Можно ли лудить стальные детали?',
		a: 'Можно, обычно по подслою меди или никеля — он улучшает сцепление олова со сталью. Такие детали обсуждаем по чертежу.',
	},
	{
		q: 'Подходит ли олово для трущихся деталей?',
		a: 'Нет, олово мягкое и быстро истирается. Для износостойкости нужны никель или твёрдый хром.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, вид покрытия, толщина слоя, форма и количество деталей.<br><br>Пришлите чертёж или фото — назовём стоимость и срок.`;
---

<ServicePage
	title="Оловянирование (лужение) деталей — олово и олово-висмут"
	description="Гальваническое оловянирование (лужение) в собственном цехе: олово и матовое олово-висмут для пайки и электрического контакта. Медь, латунь, бронза. Расчёт по фото или чертежу."
	h1="Оловянирование (лужение)"
	tagline="Олово · олово-висмут · под пайку и контакт"
	answer="ГК Металлинвест выполняет <strong>гальваническое оловянирование (лужение)</strong> в собственном цехе, в том числе матовым сплавом олово-висмут. Олово защищает медь и латунь от окисления, сохраняет паяемость и надёжный электрический контакт — поэтому им покрывают шины, клеммы, контакты и детали под пайку. Стоимость считаем по чертежу или фото."
	facts={['Собственный цех', 'Олово и олово-висмут', 'Под пайку и контакт', 'Расчёт по фото']}
	cover="olovyanirovanie"
	coverAlt="Оловянирование (лужение) — олово и олово-висмут"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Оловянирование (лужение) — гальваническое нанесение слоя олова на детали. Олово мягкое, хорошо паяется и проводит ток и не окисляется на воздухе так, как медь, поэтому покрытие сохраняет паяемость деталей при хранении и обеспечивает надёжный электрический контакт.</p><p>Выполняем в собственном цехе оловянирование и покрытие сплавом олово-висмут — матовым, без блеска. Висмут делает покрытие стабильнее при хранении и низких температурах.</p><p>Для расчёта пришлите чертёж или фото деталей, материал, вид покрытия и количество.</p>`}
	specsTitle="Покрытия и условия"
	specs={specs}
	process={process}
	materials={[
		'Медь',
		'Латунь',
		'Бронза',
		'Сталь — по запросу',
	]}
	applications={[
		'Шины и токоведущие детали',
		'Клеммы, наконечники, контакты',
		'Выводы и детали под пайку',
		'Детали электротехнического оборудования',
	]}
	limitations={[
		'Олово мягкое — для трущихся и износостойких поверхностей не подходит',
		'Стальные детали покрывают по подслою — обсуждаем по чертежу',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Меднение', href: '/uslugi/galvanicheskie-pokrytiya/mednenie/' },
		{ label: 'Серебрение', href: '/uslugi/galvanicheskie-pokrytiya/serebrenie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
