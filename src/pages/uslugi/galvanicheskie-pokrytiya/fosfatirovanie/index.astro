---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: химическое фосфатирование с оксидированием — № 23 в его
   списке, собственный цех. Цены не публикуем; размеров ванн и толщин не
   давал — не пишем. План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Фосфатная плёнка, в том числе с оксидированием' },
	{ label: 'Основа', value: 'Углеродистая и низколегированная сталь' },
	{ label: 'Назначение', value: 'Основа под окраску, удержание смазки, защита от коррозии' },
	{ label: 'Размеры детали', value: 'Меняются незначительно' },
	{ label: 'Исходные данные', value: 'Фото или чертёж, назначение покрытия, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, форма, количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете фото или чертёж деталей, материал, назначение покрытия и количество.' },
	{ n: 2, title: 'Расчёт', text: 'Уточняем, пойдёт ли деталь под окраску или в масло, называем стоимость и срок.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и травим поверхность.' },
	{ n: 4, title: 'Фосфатирование', text: 'Обрабатываем детали в растворе фосфатов, при необходимости — с оксидированием.' },
	{ n: 5, title: 'Промасливание или сушка', text: 'Пропитываем маслом или сушим под окраску.' },
	{ n: 6, title: 'Контроль и отгрузка', text: 'Проверяем сплошность покрытия, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Зачем фосфатировать деталь перед покраской?',
		a: 'Фосфатная плёнка шероховатая и пористая — краска проникает в неё и держится намного прочнее, чем на гладком металле. Если краску повредить, коррозия под ней расползается медленнее.',
	},
	{
		q: 'Защищает ли фосфат от коррозии сам по себе?',
		a: 'Слабо. Хорошую защиту фосфатная плёнка даёт вместе с маслом или краской — поэтому после фосфатирования деталь либо промасливают, либо окрашивают.',
	},
	{
		q: 'Что даёт сочетание с оксидированием?',
		a: 'Покрытие получается темнее и плотнее, а после промасливания лучше защищает от коррозии. Такой вариант выбирают, когда деталь не красят, а используют с маслом.',
	},
	{
		q: 'Чем фосфатирование отличается от оксидирования?',
		a: 'Оксидирование даёт тонкую чёрную плёнку без изменения размеров. Фосфатирование — более толстую кристаллическую плёнку, которая лучше держит краску и смазку и облегчает приработку трущихся деталей.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, вид обработки (с оксидированием или без), форма и количество деталей.<br><br>Пришлите фото или чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Фосфатирование металла на заказ — в том числе с оксидированием"
	description="Химическое фосфатирование стальных деталей в собственном цехе, в том числе с оксидированием: основа под окраску и смазку, защита от коррозии. Расчёт по фото или чертежу."
	h1="Фосфатирование"
	tagline="С оксидированием · основа под краску · собственный цех"
	answer="ГК Металлинвест выполняет <strong>химическое фосфатирование стали</strong>, в том числе с оксидированием, в собственном цехе. Фосфатная плёнка прочно держит краску и смазку, вместе с ними защищает от коррозии и облегчает приработку трущихся деталей. Стоимость считаем по фото или чертежу деталей."
	facts={['Собственный цех', 'С оксидированием', 'Основа под краску', 'Расчёт по фото']}
	cover="fosfatirovanie"
	coverAlt="Фосфатирование стали, в том числе с оксидированием"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Фосфатирование — химическая обработка стали в растворе фосфатов, после которой на поверхности образуется мелкокристаллическая плёнка нерастворимых фосфатов. Сама по себе она пористая, поэтому её пропитывают маслом или окрашивают — вместе с ними фосфат даёт хорошую защиту от коррозии.</p><p>Выполняем в собственном цехе фосфатирование стальных деталей, в том числе в сочетании с оксидированием. Фосфатирование применяют как подготовку под окраску, для удержания смазки на трущихся деталях и для защиты крепежа.</p><p>Для расчёта пришлите фото или чертёж деталей, материал, назначение покрытия и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Углеродистая сталь',
		'Низколегированная сталь',
		'Крепёж и метизы',
		'Штампованные детали',
	]}
	applications={[
		'Подготовка стальных деталей под порошковую и жидкую окраску',
		'Трущиеся детали — удержание смазки и приработка',
		'Крепёж и метизы',
		'Детали, которые хранят и перевозят в масле',
	]}
	limitations={[
		'Без масла или краски фосфатная плёнка защищает слабо',
		'Плёнка матовая серо-чёрная — это не декоративное покрытие',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Оксидирование стали (воронение)', href: '/uslugi/galvanicheskie-pokrytiya/oksidirovanie-stali/' },
		{ label: 'Цинкование', href: '/uslugi/galvanicheskie-pokrytiya/cinkovanie/' },
		{ label: 'Кадмирование', href: '/uslugi/galvanicheskie-pokrytiya/kadmirovanie/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
