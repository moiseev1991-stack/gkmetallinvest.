---
import ServicePage from '../../../../components/ServicePage.astro';

/* Факты от клиента: анодирование титана (аноцвет) — № 12 в его списке,
   собственный цех. Цены не публикуем. Палитру и размеры ванн клиент не
   давал — цвет описываем через физику процесса, оттенок «по образцу».
   План — PLAN-galvanika.md. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Покрытие', value: 'Цветная оксидная плёнка — аноцвет' },
	{ label: 'Цвет', value: 'Задаётся напряжением: от золотистого и бронзового до фиолетового и синего' },
	{ label: 'Оттенок', value: 'Согласуем по образцу до запуска партии' },
	{ label: 'Основа', value: 'Титан и титановые сплавы' },
	{ label: 'Исходные данные', value: 'Фото или чертёж, марка титана, цвет, количество' },
	{ label: 'Стоимость', value: 'По изделию: площадь, форма, количество' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете фото или чертёж деталей, марку титана, нужный цвет и количество.' },
	{ n: 2, title: 'Образец', text: 'Подбираем режим и согласуем оттенок на образце.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем и травим поверхность — от её состояния зависит ровность цвета.' },
	{ n: 4, title: 'Анодирование', text: 'Выращиваем оксидную плёнку при заданном напряжении — одинаковый цвет на всей партии.' },
	{ n: 5, title: 'Контроль и отгрузка', text: 'Сверяем цвет с образцом, упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Почему титан окрашивается без краски?',
		a: 'На поверхности вырастает тонкая прозрачная оксидная плёнка. Свет отражается от её верхней и нижней границы, и лучи складываются — получается цвет, как у радужной плёнки на воде. Цвет зависит от толщины плёнки, а толщина — от напряжения.',
	},
	{
		q: 'Какие цвета можно получить?',
		a: 'С ростом напряжения цвет идёт от бронзового и золотистого к фиолетовому, синему и голубому, затем к жёлтым, розовым и зелёным оттенкам. Точный оттенок согласуем по образцу.',
	},
	{
		q: 'Стойкий ли цвет?',
		a: 'Плёнка не отслаивается и не выцветает на свету — красителя в ней нет. Но она очень тонкая, поэтому при сильном трении и абразивном износе цвет может стереться.',
	},
	{
		q: 'Чем анодирование титана отличается от анодирования алюминия?',
		a: 'У алюминия плёнка толстая и пористая, цвет ей придают красителем. У титана плёнка тонкая, а цвет получается без красителя — за счёт её толщины.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, форма деталей, количество и требования к однородности цвета.<br><br>Пришлите фото или чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Анодирование титана на заказ — цветное, аноцвет"
	description="Цветное анодирование титана (аноцвет) в собственном цехе: цвет без краски — от золотистого до синего и фиолетового. Детали, крепёж, декоративные изделия, цветовая маркировка. Расчёт по фото."
	h1="Анодирование титана"
	tagline="Аноцвет · цвет без краски · собственный цех"
	answer="ГК Металлинвест выполняет <strong>цветное анодирование титана (аноцвет)</strong> в собственном цехе. Цвет получается без краски — за счёт тонкой оксидной плёнки, толщина которой задаётся напряжением: от золотистого до фиолетового и синего. Покрытие не отслаивается и не выцветает; стоимость считаем по фото или чертежу деталей."
	facts={['Собственный цех', 'Цвет без краски', 'Титан и его сплавы', 'Расчёт по фото']}
	cover="anodirovanie-titana"
	coverAlt="Анодирование титана — аноцвет, цвет без краски"
	parent={{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' }}
	intro={`<p>Анодирование титана (аноцвет) — электрохимическое окисление поверхности титана. На нём вырастает тонкая прозрачная оксидная плёнка, и свет, отражаясь от неё, даёт цвет — как радужная плёнка на воде. Цвет зависит от толщины плёнки, а толщина — от напряжения, поэтому одинаковый режим даёт одинаковый цвет на всей партии.</p><p>Выполняем цветное анодирование титана в собственном цехе: детали, крепёж, декоративные изделия. Кроме цвета, анодирование используют для маркировки — чтобы различать детали по размеру или назначению.</p><p>Для расчёта пришлите фото или чертёж деталей, марку титана, нужный цвет и количество.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Титан ВТ1-0',
		'Титановые сплавы (ВТ6 и другие)',
		'Крепёж и детали',
		'Изделия после механообработки',
	]}
	applications={[
		'Декоративные детали и изделия',
		'Титановый крепёж — различение по цвету',
		'Детали оборудования — цветовая маркировка по назначению',
		'Изделия, где нужен цвет без краски и лака',
	]}
	limitations={[
		'Цвет зависит от поверхности: на полированной он ярче, на матовой — глубже; образец согласуем до партии',
		'Плёнка тонкая — при абразивном износе цвет может стираться',
		'Размер ванн и максимальные габариты деталей подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Смежные покрытия"
	relatedHubs={[
		{ label: 'Анодирование алюминия', href: '/uslugi/galvanicheskie-pokrytiya/anodirovanie/' },
		{ label: 'Хроматирование алюминия', href: '/uslugi/galvanicheskie-pokrytiya/hromatirovanie-alyuminiya/' },
		{ label: 'Все гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
	]}
	faq={faq}
/>
