---
import ServicePage from '../../../components/ServicePage.astro';

/* Факты от клиента (2026-09-24): электрохимическое полирование нержавейки
   и электроплазменная полировка есть (№ 6 и № 7 в его списке), собственный
   цех, цены не публикуем. Размеров ванн и достижимой шероховатости клиент
   не давал — не пишем. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Методы', value: 'Электрохимическая (ЭХП) и электроплазменная полировка' },
	{ label: 'Что обрабатываем', value: 'Детали, ёмкости, трубы и фитинги, сварные узлы' },
	{ label: 'Материал', value: 'Нержавеющая сталь: AISI 304, 316L, 321 и другие марки' },
	{ label: 'Исходные данные', value: 'Фото или чертёж, габариты, марка, требования к поверхности' },
	{ label: 'Стоимость', value: 'По изделию: площадь, форма, исходное состояние, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Заявка', text: 'Присылаете фото или чертёж изделия, габариты, марку стали и требования к поверхности.' },
	{ n: 2, title: 'Оценка', text: 'Смотрим исходную поверхность: нужна ли шлифовка перед полировкой, какой метод подходит.' },
	{ n: 3, title: 'Подготовка', text: 'Обезжириваем, при необходимости шлифуем риски и снимаем окалину со швов.' },
	{ n: 4, title: 'Полировка', text: 'Полируем электрохимическим или электроплазменным методом.' },
	{ n: 5, title: 'Промывка и контроль', text: 'Промываем, сушим, проверяем равномерность блеска.' },
	{ n: 6, title: 'Отгрузка', text: 'Упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Чем электрохимическая полировка отличается от механической?',
		a: 'Механическая полировка выравнивает поверхность абразивом и пастами. Электрохимическая снимает тонкий слой металла током в электролите — сильнее всего на микровыступах. Абразив и загрязнения не вдавливаются в металл, сложная форма обрабатывается равномерно, а на поверхности сразу формируется пассивный слой.',
	},
	{
		q: 'Что такое электроплазменная полировка?',
		a: 'Разновидность электролитной обработки: изделие погружают в слабый водный раствор солей, и у поверхности под напряжением возникает парогазовая оболочка с электрическими разрядами. Метод работает на малоагрессивных растворах и хорошо полирует мелкие детали и детали сложной формы.',
	},
	{
		q: 'Зачем пищевому оборудованию электрополировка?',
		a: 'На гладкой поверхности без микротрещин и вдавленного абразива меньше задерживаются продукт и бактерии, её быстрее отмыть. Заодно формируется пассивный слой, который повышает коррозионную стойкость.',
	},
	{
		q: 'Нужно ли шлифовать изделие перед ЭХП?',
		a: 'Если на поверхности есть риски, царапины или окалина — да. ЭХП выравнивает микрорельеф, но глубокие дефекты не убирает. Что нужно конкретному изделию, скажем по фото.',
	},
	{
		q: 'Можно ли сделать ЭХП после сварки?',
		a: 'Да, но сначала со швов удаляют окалину и цвета побежалости — травлением или шлифовкой. После этого электрополировка выравнивает шов и зону вокруг него по блеску.',
	},
];

const pricingNote = `Стоимость считаем по изделию. На цену влияют площадь поверхности, форма, исходное состояние (нужна ли предварительная шлифовка), требования к блеску и количество изделий.<br><br>Пришлите фото или чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Электрохимическая полировка нержавейки — электрополировка"
	description="Электрохимическая полировка (электрополировка) нержавейки в собственном цехе: гладкая чистая поверхность для пищевого и фармацевтического оборудования."
	h1="Электрохимическая полировка нержавейки"
	tagline="Электрополировка · электроплазменная полировка · собственный цех"
	answer="ГК Металлинвест выполняет <strong>электрохимическую полировку нержавейки</strong> (ЭХП, электрополировку) и электроплазменную полировку в собственном цехе. ЭХП выравнивает поверхность без абразива, делает её гладкой и чистой и формирует пассивный слой — это нужно ёмкостям, трубам и деталям пищевых и фармацевтических производств. Стоимость считаем по фото или чертежу."
	facts={['Собственный цех', 'ЭХП и электроплазменная', 'Пищевое и фарм. оборудование', 'Расчёт по фото']}
	cover="elektrohimicheskaya-polirovka"
	coverAlt="Электрохимическая полировка нержавейки — что даёт полировка"
	intro={`<p>Электрохимическая полировка (ЭХП, электрополировка) — анодное растворение поверхности нержавейки в электролите. Ток сильнее всего снимает металл на микровыступах, поэтому поверхность выравнивается, становится гладкой и блестящей, а на ней формируется плотный пассивный слой. В отличие от механической полировки, ЭХП не вдавливает абразив в металл и равномерно обрабатывает сложную форму.</p><p>Выполняем электрохимическую и электроплазменную полировку в собственном цехе. Основная задача — оборудование, где важны чистота и гигиена поверхности: ёмкости, трубопроводы и детали пищевых, молочных, фармацевтических и медицинских производств.</p><p>Для расчёта пришлите фото или чертёж изделия, габариты, марку стали и требования к поверхности.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'AISI 304 / 304L',
		'AISI 316L',
		'AISI 316Ti',
		'AISI 321 (12Х18Н10Т)',
		'Трубы и отводы',
		'Детали сложной формы',
		'Сварные узлы',
	]}
	applications={[
		'Ёмкости, танки и трубопроводы пищевых и молочных производств',
		'Фармацевтическое и медицинское оборудование',
		'Детали сложной формы, которые трудно отполировать механически',
		'Сварные узлы после травления — выравнивание шва по блеску',
		'Поверхности, где важны меньшее налипание продукта и лёгкая мойка',
		'Декоративные изделия — равномерный блеск по всей поверхности',
	]}
	limitations={[
		'ЭХП выравнивает микрорельеф, но не убирает глубокие царапины — их сначала шлифуют',
		'Результат зависит от исходной поверхности и марки стали — требования к блеску согласуем до работы',
		'Габариты изделия подтверждаем при расчёте',
	]}
	pricingNote={pricingNote}
	relatedTitle="Металл и смежные услуги"
	relatedHubs={[
		{ label: 'Механическая полировка', href: '/uslugi/polirovka/' },
		{ label: 'Травление и пассивация', href: '/uslugi/travlenie-i-passivaciya/' },
		{ label: 'Труба нержавеющая', href: '/truba-nerzhaveyushchaya/' },
		{ label: 'Детали трубопровода', href: '/detali-truboprovoda/' },
	]}
	faq={faq}
/>
