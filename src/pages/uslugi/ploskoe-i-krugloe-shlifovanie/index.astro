---
import ServicePage from '../../../components/ServicePage.astro';

/* Факты от клиента (2026-09-24): «шлифовка продольная» и «шлифовка круглая»
   есть (№ 27 и № 28 в его списке), собственный цех, цены не публикуем.
   «Продольная» — плоское шлифование на станке с продольным ходом стола:
   так же услугу называют в выдаче («плоская шлифовка») и у БВБ Механики
   («плоскошлифовальные работы»). Станков, размеров и допусков клиент не
   давал — не пишем. Декоративная шлифовка листа — отдельная страница
   /uslugi/shlifovanie/. */

const specs = [
	{ label: 'Где выполняем', value: 'Собственный цех' },
	{ label: 'Виды', value: 'Плоское (продольное) и круглое наружное шлифование' },
	{ label: 'Детали', value: 'Плиты, пластины, планки, валы, оси, штоки, втулки' },
	{ label: 'Материалы', value: 'Нержавеющая, конструкционная и закалённая сталь; другие — по запросу' },
	{ label: 'Исходные данные', value: 'Чертёж с размерами, допусками и шероховатостью' },
	{ label: 'Стоимость', value: 'По чертежу: размеры, припуск, точность, количество' },
	{ label: 'Доставка', value: 'По России или самовывоз' },
];

const process = [
	{ n: 1, title: 'Чертёж', text: 'Присылаете чертёж с размерами, допусками и шероховатостью, материал и количество.' },
	{ n: 2, title: 'Проверка и расчёт', text: 'Проверяем припуск и требования к точности, считаем стоимость и срок.' },
	{ n: 3, title: 'Шлифование', text: 'Шлифуем плоскости или наружные поверхности тел вращения в размер.' },
	{ n: 4, title: 'Контроль', text: 'Проверяем размеры по чертежу.' },
	{ n: 5, title: 'Отгрузка', text: 'Упаковываем и отправляем по России или отдаём самовывозом.' },
];

const faq = [
	{
		q: 'Что такое продольная шлифовка?',
		a: 'Так часто называют плоское шлифование: деталь закрепляют на столе станка, стол ходит вперёд-назад под вращающимся кругом, и за несколько проходов круг снимает металл по всей плоскости. Так получают ровные и параллельные поверхности плит, пластин и планок.',
	},
	{
		q: 'Чем круглое шлифование отличается от токарной обработки?',
		a: 'Токарная обработка снимает основной припуск резцом, шлифование — финишная операция абразивным кругом. Оно даёт более точный размер, меньшее биение и более гладкую поверхность и обрабатывает закалённую сталь, которую резцом не взять.',
	},
	{
		q: 'Нужно ли оставлять припуск под шлифовку?',
		a: 'Да. Шлифовка снимает немного металла, поэтому после токарной или фрезерной обработки на размер оставляют небольшой припуск — обычно десятые доли миллиметра на сторону. Точное значение зависит от детали; если сомневаетесь, пришлите чертёж.',
	},
	{
		q: 'Шлифуете ли детали после хромирования?',
		a: 'Да. Штоки и валы после твёрдого хромирования шлифуют, чтобы вывести размер и получить гладкую поверхность покрытия. Само хромирование тоже выполняем — см. «Гальванические покрытия».',
	},
	{
		q: 'Чем эта услуга отличается от шлифования листа?',
		a: 'Здесь речь о станочной шлифовке деталей в точный размер. Декоративная шлифовка листа нержавейки (сатин, подготовка под покраску) — отдельная услуга «Шлифование нержавеющей стали».',
	},
];

const pricingNote = `Стоимость считаем по чертежу. На цену влияют размеры и число шлифуемых поверхностей, припуск, требования к точности и шероховатости, материал и твёрдость, количество деталей.<br><br>Пришлите чертёж — назовём стоимость и срок.`;
---

<ServicePage
	title="Плоское и круглое шлифование деталей на заказ"
	description="Плоская (продольная) и круглая шлифовка металлических деталей в собственном цехе: плиты, пластины, валы, штоки, оси. Шлифовка после закалки и хромирования. Расчёт по чертежу."
	h1="Плоское и круглое шлифование"
	tagline="Продольная (плоская) и круглая шлифовка · по чертежу"
	answer="ГК Металлинвест выполняет <strong>плоское (продольное) и круглое шлифование</strong> металлических деталей в собственном цехе. Плоское шлифование — для плит, пластин и планок, круглое — для валов, осей, штоков и втулок, в том числе после закалки и хромирования. Стоимость считаем по чертежу с размерами, допусками и шероховатостью."
	facts={['Собственный цех', 'Плоское и круглое', 'После закалки и хромирования', 'Расчёт по чертежу']}
	cover="ploskoe-i-krugloe-shlifovanie"
	coverAlt="Плоское и круглое шлифование деталей — что шлифуем"
	intro={`<p>Шлифуем металлические детали в собственном цехе. Плоское (продольное) шлифование — для плоских поверхностей: плит, пластин, планок, фланцев, торцов. Круглое шлифование — для наружных поверхностей тел вращения: валов, осей, штоков, пальцев, втулок.</p><p>Шлифовка — финишная механическая обработка. Она доводит деталь до размера по чертежу, убирает биение и неплоскостность и даёт ровную поверхность с низкой шероховатостью. Её делают после токарной и фрезерной обработки, закалки и нанесения покрытий.</p><p>Для расчёта пришлите чертёж с размерами, допусками и требованиями к шероховатости, материал и количество деталей.</p>`}
	specsTitle="Условия заказа"
	specs={specs}
	process={process}
	materials={[
		'Нержавеющая сталь',
		'Конструкционная сталь',
		'Закалённая сталь',
		'Детали после хромирования',
		'Другие металлы — по запросу',
	]}
	applications={[
		'Плиты, пластины и основания — плоскостность и параллельность сторон',
		'Валы, оси, пальцы — посадочные поверхности под подшипники и уплотнения',
		'Штоки гидроцилиндров — шлифовка до и после твёрдого хромирования',
		'Детали после закалки — доводка размера после термообработки',
		'Ремонт — восстановление изношенных поверхностей по чертежу',
	]}
	limitations={[
		'Шлифовка снимает десятые и сотые доли миллиметра — на деталь оставляют припуск после предварительной обработки',
		'Внутреннее шлифование отверстий — уточняйте при расчёте',
		'Размеры и массу деталей, которые можно установить на станок, подтверждаем по чертежу',
	]}
	pricingNote={pricingNote}
	relatedTitle="Металл и смежные услуги"
	relatedHubs={[
		{ label: 'Круг нержавеющий', href: '/krug-nerzhaveyushchiy/' },
		{ label: 'Шлифование листа', href: '/uslugi/shlifovanie/' },
		{ label: 'Гальванические покрытия', href: '/uslugi/galvanicheskie-pokrytiya/' },
		{ label: 'Гидроабразивная резка', href: '/uslugi/gidroabrazivnaya-rezka/' },
	]}
	faq={faq}
/>
