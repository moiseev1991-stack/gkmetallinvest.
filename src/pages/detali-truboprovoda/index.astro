---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any)['detali-truboprovoda'] as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Чем плоский фланец отличается от воротникового?',
		a: 'Плоский фланец (ГОСТ 12820) — приваривается внахлёст к трубе через продольный шов. Воротниковый (ГОСТ 12821) — имеет коническую шейку, приваривается встык — выдерживает более высокие давления и циклические нагрузки. Воротниковые применяются на PN ≥ 25.',
	},
	{
		q: 'Какие давления и температуры для AISI 304 / 316L?',
		a: 'AISI 304 — до PN 40 (40 атм) и температуры до 425 °C. AISI 316L — до PN 40 и температуры до 525 °C, и стойкость к хлоридам выше. Для пара высокого давления и температур > 600 °C — AISI 321 / 12Х18Н10Т.',
	},
	{
		q: 'Делаете ли вы лестничные ограждения под заказ?',
		a: 'Сами стойки и комплектующие — отгружаем со склада. Сборка ограждений «под ключ» — через партнёров-монтажников из Нижнего Новгорода и Москвы. Подскажем подрядчика под ваш проект и пришлём 3D-сборку перед заказом.',
	},
	{
		q: 'Можно ли заказать поштучно — без минимальной партии?',
		a: 'Да, цена в прайсе указана за 1 шт. Минимальной партии нет — отгружаем фланцы и фитинги в одном-двух экземплярах, если они в наличии.',
	},
];
---

<CatalogHubTemplate
	title="Детали трубопровода нержавеющие — фланцы, отводы, тройники, лестничные"
	description="Фланцы плоские/воротниковые, отводы 90°, переходы, тройники, заглушки, задвижки, клапаны. Лестничные ограждения нержавеющие. Цена за штуку."
	h1="Детали трубопровода и ограждения"
	intro={`Самый разнообразный раздел: 16 подкатегорий и ${skus.length} позиций. Здесь и классическая трубопроводная арматура (фланцы, отводы, тройники, переходы, заглушки, задвижки), и комплектующие нержавеющих лестничных ограждений (стойки, поручни, держатели, стеклодержатели, наконечники). Стали 12Х18Н10Т, AISI 304, AISI 316L. Цена за штуку с наценкой 5%.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Детали трубопровода' }]}
	hubHref="/detali-truboprovoda/"
	hubLabel="Детали трубопровода"
	hubKey="detali-truboprovoda"
	faq={faq}
>
	<PriceTable hub="detali-truboprovoda" title="Прайс на детали трубопровода и ограждения" measure="размер" />

	<HubExtras
		hubHref="/detali-truboprovoda/"
		hubLabel="Детали трубопровода"
		hubLabelGenitive="детали трубопровода"
		grades={grades}
	/>

	<section class="block">
		<h2>Трубопроводная арматура</h2>
		<ul class="list-plain">
			<li><strong>Фланцы</strong> плоские (ГОСТ 12820) и воротниковые (ГОСТ 12821) — 145 позиций. DN 15–500, PN 6–40</li>
			<li><strong>Отводы 90°</strong> — крутоизогнутые ГОСТ 17375. AISI 304, 316L, 12Х18Н10Т</li>
			<li><strong>Переходы</strong> — концентрические и эксцентрические, ГОСТ 17378</li>
			<li><strong>Тройники</strong> — равнопроходные и переходные, ГОСТ 17376</li>
			<li><strong>Заглушки</strong> — приварные эллиптические и плоские</li>
			<li><strong>Задвижки и клапаны</strong> — затворы поворотные, обратные клапаны</li>
		</ul>
	</section>

	<section class="block">
		<h2>Комплектующие лестничных ограждений</h2>
		<ul class="list-plain">
			<li><strong>Стойки и крепления</strong> — пристенные, для стекла, для поручней</li>
			<li><strong>Держатели ригеля</strong> и наконечники поручня</li>
			<li><strong>Стеклодержатели</strong> для зашивки лестничных пролётов стеклом</li>
			<li><strong>Декоративные элементы</strong> — низ стойки, повороты, соединители</li>
			<li><strong>Заглушки и фланцы настенные</strong> для сборки конструкций под стандарты EN 1090</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Технологические трубопроводы пищевой, фарма, химической отраслей</li>
			<li>Лестничные и пандусные ограждения торговых центров, офисов, жилья премиум</li>
			<li>Парапеты и ограждения мостов, набережных</li>
			<li>Стеклянные пролёты с нерж. стойками — конференц-залы, лестницы</li>
		</ul>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода-изготовителя на каждую партию</li>
			<li>Маркировка стали и стандарта (ГОСТ / DIN / EN)</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Самовывоз, доставка автотранспортом и ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
</style>
