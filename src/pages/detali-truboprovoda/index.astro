---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any)['detali-truboprovoda'] as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Чем плоский фланец отличается от воротникового?',
		a: 'Плоский фланец (ГОСТ 12820) — приваривается внахлёст к трубе через продольный шов. Воротниковый (ГОСТ 12821) — имеет коническую шейку, приваривается встык — выдерживает более высокие давления и циклические нагрузки. Воротниковые применяются на PN ≥ 25.',
	},
	{
		q: 'Какие давления и температуры для AISI 304 / 316L?',
		a: 'AISI 304 — до PN 40 (40 атм) и температуры до 425 °C. AISI 316L — до PN 40 и температуры до 525 °C, и стойкость к хлоридам выше. Для пара высокого давления и температур > 600 °C — AISI 321 / 12Х18Н10Т.',
	},
	{
		q: 'Делаете ли вы лестничные ограждения под заказ?',
		a: 'Сами стойки и комплектующие — отгружаем со склада. Сборка ограждений «под ключ» — через партнёров-монтажников из Нижнего Новгорода и Москвы. Подскажем подрядчика под ваш проект и пришлём 3D-сборку перед заказом.',
	},
	{
		q: 'Можно ли заказать поштучно — без минимальной партии?',
		a: 'Да, цена в прайсе указана за 1 шт. Минимальной партии нет — отгружаем фланцы и фитинги в одном-двух экземплярах, если они в наличии.',
	},
];
---

<CatalogHubTemplate
	title="Детали трубопровода: отводы, фланцы, тройники, переходы, заглушки"
	description="Отводы, фланцы, тройники, переходы и заглушки нержавеющие AISI 304/321/316L. ГОСТ 17375, 33259, 17376, 17378, 17379. Ду 15–600. Цена за штуку."
	h1="Детали трубопровода и ограждения"
	intro={`Самый разнообразный раздел: 16 подкатегорий и ${skus.length} позиций. Здесь и классическая трубопроводная арматура (фланцы, отводы, тройники, переходы, заглушки, задвижки), и комплектующие нержавеющих лестничных ограждений (стойки, поручни, держатели, стеклодержатели, наконечники). Стали 12Х18Н10Т, AISI 304, AISI 316L. Цена за штуку с наценкой 5%.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Детали трубопровода' }]}
	hubHref="/detali-truboprovoda/"
	hubLabel="Детали трубопровода"
	hubKey="detali-truboprovoda"
	faq={faq}
>
	<PriceTable hub="detali-truboprovoda" title="Прайс на детали трубопровода и ограждения" measure="размер" />

	<HubExtras
		hubHref="/detali-truboprovoda/"
		hubLabel="Детали трубопровода"
		hubLabelGenitive="детали трубопровода"
		grades={grades}
	/>

	<section class="block">
		<h2>Отводы нержавеющие</h2>
		<p>
			Отводы нержавеющие — гнутые и штампованные элементы для поворота трассы трубопровода. Бесшовные крутоизогнутые отводы по ГОСТ 17375 (радиус 1,0–1,5 Ду), короткие штампосварные по ГОСТ 30753, отводы малого Ду по ГОСТ 17380. Углы 45°, 60°, 90°, реже 180°. Диаметры Ду 15–600 мм. Марки: AISI 304 (08Х18Н10), AISI 321 (12Х18Н10Т), AISI 316L (03Х17Н14М2) — стандартный выбор под пищёвку, химию и теплосети соответственно.
		</p>
		<p>
			Нержавеющий отвод сохраняет проходное сечение на повороте и работает наравне с трубой по давлению. Используется в технологических трубопроводах пищевых, фармацевтических и химических производств, в теплотрассах и системах горячего водоснабжения. Поставляем отводы нержавеющие со склада в Нижнем Новгороде с сертификатом завода-изготовителя.
		</p>
	</section>

	<section class="block">
		<h2>Фланцы нержавеющие</h2>
		<p>
			Фланцы нержавеющие — плоские приварные (тип 01, ГОСТ 33259, ранее ГОСТ 12820), воротниковые приварные встык (тип 11, ГОСТ 33259, ранее ГОСТ 12821) и глухие. Условные давления Ру 6 / 10 / 16 / 25 / 40 атм, диаметры Ду 10–600 мм. Уплотнительные поверхности — B (выступ), D (паз), E (шип), F (под прокладку овального сечения). Марки AISI 304, AISI 321, AISI 316L.
		</p>
		<p>
			Плоский фланец дешевле и проще в монтаже на низких давлениях, воротниковый держит Ру 25–40 атм и циклические нагрузки на встыковом шве. По запросу комплектуем нержавеющий фланец крепежом (шпильки, гайки) и паронитовыми или фторопластовыми прокладками под рабочую среду. Фланцы нержавеющие купить можно поштучно — минимальной партии нет.
		</p>
	</section>

	<section class="block">
		<h2>Переходы нержавеющие</h2>
		<p>
			Переходы нержавеющие — фасонные детали для соединения труб разных диаметров. Концентрические (соосные, для вертикальных участков) и эксцентрические (со смещением оси, для горизонтальных трубопроводов, где нужно избежать застойных зон по нижней образующей). Изготавливаются по ГОСТ 17378 из аустенитных сталей AISI 304 и AISI 321. Типовые типоразмеры от Ду 25×15 до Ду 300×200 мм.
		</p>
		<p>
			Применяются на узлах редукции в технологических трубопроводах, при переходе магистрали на меньшее сечение, при подключении к арматуре нестандартного Ду. Нержавеющий переход сваривается с трубой встык — геометрия совпадает с ГОСТ 17375 на отводы и ГОСТ 17376 на тройники, что упрощает сборку узла.
		</p>
	</section>

	<section class="block">
		<h2>Тройники нержавеющие</h2>
		<p>
			Тройники нержавеющие — узловые детали для ответвления трубопровода под 90°. Равнопроходные (Т-образные, диаметр магистрали равен диаметру отвода) и переходные (с уменьшенным боковым отводом). ГОСТ 17376 на бесшовные крутоизогнутые тройники. Изготавливаются штамповкой из трубной заготовки или сваркой. Марки AISI 304, AISI 321, AISI 316L. Размерный ряд Ду 15–600 мм.
		</p>
		<p>
			Применение нержавеющих тройников — узлы ответвления магистрали, коллекторы пара и горячей воды, парораздаточные гребёнки, обвязка теплообменников и насосных станций. Поставляем тройники нержавеющие со склада с сертификатом по составу и механическим характеристикам.
		</p>
	</section>

	<section class="block">
		<h2>Заглушки нержавеющие</h2>
		<p>
			Заглушки нержавеющие — приварные эллиптические по ГОСТ 17379 (стандартная форма для трубопроводов давления), плоские круглые и отбортованные. Закрывают концы трубопроводов в тупиковых точках, патрубки технологических ёмкостей, выходы коллекторов и резервные отводы под будущее подключение. Марки AISI 304, AISI 321, AISI 316L. Размерный ряд Ду 15–600 мм.
		</p>
		<p>
			Эллиптическая заглушка держит давление наравне с трубой и применяется на ответственных трубопроводах. Плоская — для атмосферных и низконапорных участков. Нержавеющий лючок-заглушка с фланцевым креплением подбирается под доступ для обслуживания и промывки. Отгрузка со склада в Нижнем Новгороде, доставка ТК по РФ.
		</p>
	</section>

	<section class="block">
		<h2>Комплектующие лестничных ограждений</h2>
		<ul class="list-plain">
			<li><strong>Стойки и крепления</strong> — пристенные, для стекла, для поручней</li>
			<li><strong>Держатели ригеля</strong> и наконечники поручня</li>
			<li><strong>Стеклодержатели</strong> для зашивки лестничных пролётов стеклом</li>
			<li><strong>Декоративные элементы</strong> — низ стойки, повороты, соединители</li>
			<li><strong>Заглушки и фланцы настенные</strong> для сборки конструкций под стандарты EN 1090</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Технологические трубопроводы пищевой, фарма, химической отраслей</li>
			<li>Лестничные и пандусные ограждения торговых центров, офисов, жилья премиум</li>
			<li>Парапеты и ограждения мостов, набережных</li>
			<li>Стеклянные пролёты с нерж. стойками — конференц-залы, лестницы</li>
		</ul>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода-изготовителя на каждую партию</li>
			<li>Маркировка стали и стандарта (ГОСТ / DIN / EN)</li>
			<li>Отгрузка со склада в Нижнем Новгороде</li>
			<li>Самовывоз, доставка автотранспортом и ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
</style>
