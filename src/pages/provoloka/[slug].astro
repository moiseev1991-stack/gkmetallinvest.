---
import ProductDetail from '../../components/ProductDetail.astro';
import pricelist from '../../data/pricelist.json';

export async function getStaticPaths() {
	const skus = (pricelist.hubs as any).provoloka as any[];
	return skus.map((sku) => ({ params: { slug: sku.slug }, props: { sku } }));
}

const { sku } = Astro.props;
---

<ProductDetail
	sku={sku}
	hubLabel="Проволока нержавеющая"
	hubHref="/provoloka/"
	measureLabel="диаметр"
/>
