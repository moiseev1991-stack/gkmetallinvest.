---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any)['ugolok-shveller'] as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Резку уголка и швеллера в размер делаете?',
		a: 'Да, режем дисковой пилой в размер от 1 хлыста с точностью ±1 мм. Возможен раскрой по чертежу с фасочными надрезами под сварку.',
	},
	{
		q: 'Какие марки используются для нержавеющего профиля?',
		a: 'Основные — AISI 304 (08Х18Н10) и AISI 316L. Для жаростойкого исполнения — AISI 321 / 12Х18Н10Т. Чисто декоративные элементы — допустимо AISI 430 (ферритная, безникелевая, дешевле).',
	},
	{
		q: 'Подойдёт ли уголок 50×50×5 для каркаса оборудования?',
		a: 'Для опор и каркасов лёгкого оборудования (стол, рама, навес) — да. Для нагруженных конструкций — расчёт по ГОСТ 14249 / СП 16.13330. Уточняйте у инженера проекта или присылайте ТЗ — подскажем сечение.',
	},
	{
		q: 'Чем уголок 40×40 отличается от 50×50 по нагрузке?',
		a: 'Момент сопротивления сечения у 50×50×5 примерно в 1,8 раза выше, чем у 40×40×4. Для перильного ограждения берут 40×40×4, для рамного каркаса под оборудование 200–400 кг — 50×50×5. Под динамические нагрузки — расчёт от инженера.',
	},
	{
		q: 'Из какой марки заказать уголок и швеллер для пищевого производства?',
		a: 'Для контакта со средой по СанПиН — AISI 304 (08Х18Н10). Для сварных каркасов, где после сварки нет термообработки, — AISI 321 (12Х18Н10Т) с титаном против МКК. Для агрессивных моющих средств с хлоридами — AISI 316L (03Х17Н14М2).',
	},
	{
		q: 'Какие документы выдаются?',
		a: 'Сертификат завода по ГОСТ 8509 (уголок равнополочный), ГОСТ 8510 (неравнополочный) или ГОСТ 8240 / ТУ заводов (швеллер). Маркировка плавки и партии. По запросу — копии до отгрузки через ЭДО.',
	},
];
---

<CatalogHubTemplate
	title="Уголок и швеллер нержавеющие — AISI 304, 316L, 12Х18Н10Т"
	description="Уголок нержавеющий 20×20…200×200 (ГОСТ 8509/8510) и швеллер нержавеющий №5–№20 из нержавейки. AISI 304, 316L, 12Х18Н10Т. Резка в размер, доставка по РФ."
	h1="Уголок / Швеллер нержавеющий"
	intro="Сортовой нержавеющий профильный прокат для каркасов, опор и обвязок в коррозионно-стойком исполнении. Уголок равнополочный 20×20…100×100 мм и швеллер №№ 8, 10, 12, 14, 16, 18, 20. Стандартные длины 6 м, резка в размер по заявке. Никелесодержащие марки AISI 304, 316L, 12Х18Н10Т."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Уголок / Швеллер' }]}
	hubHref="/ugolok-shveller/"
	hubLabel="Уголок и швеллер нержавеющий"
	hubKey="ugolok-shveller"
	faq={faq}
>
	<PriceTable hub="ugolok-shveller" title="Прайс на уголок и швеллер" measure="размер" />

	<HubExtras
		hubHref="/ugolok-shveller/"
		hubLabel="Уголок и швеллер"
		hubLabelGenitive="уголок и швеллер нержавеющие"
		grades={grades}
	/>

	<section class="block">
		<h2>Уголок нержавеющий — размеры и марки</h2>
		<p>
			Уголок нержавеющий выпускается в двух исполнениях: равнополочный (45° равные стороны) по ГОСТ 8509
			и неравнополочный (45° разные стороны) по ГОСТ 8510. Химический состав сорта — по ГОСТ 5949. Размерный
			ряд равнополочного — от 20×20×3 до 200×200×30 мм, неравнополочного — от 25×16×3 до 200×125×16 мм.
			Стандартная длина хлыста — 6 м, мерные нарезы режем под заказ.
		</p>
		<p>
			Марки: AISI 304 (08Х18Н10) — базовая аустенитная под общие задачи; AISI 321 (12Х18Н10Т) — стабилизирована
			титаном, держит сварку и температуры до 600 °C; AISI 316L (03Х17Н14М2) — с молибденом, под хлориды
			и кислые среды. Купить уголок нержавеющий можно от 1 хлыста, розница от 0,1 т.
		</p>
		<p>
			Где применяют уголок из нержавейки: каркасы перильных ограждений, рамные конструкции в пищёвке и фарме,
			обвязка ёмкостей и резервуаров, бортики поддонов, опорные элементы оборудования.
		</p>
	</section>

	<section class="block">
		<h2>Швеллер нержавеющий — размеры и применение</h2>
		<p>
			Швеллер нержавеющий — П-образный профиль. Прокатный швеллер по ГОСТ 8240 нормирует углеродистую сталь;
			фактическая поставка нержавейки идёт по ТУ заводов либо швеллер гнут из листа на листогибочном прессе.
			Типоразмеры: №5, №6,5, №8, №10, №12, №14, №16, №18, №20 (номер — высота стенки в см). Длины — 6–12 м.
		</p>
		<p>
			Марки нержавеющего швеллера: AISI 304 — общее назначение, AISI 321 (12Х18Н10Т) — сварные узлы и нагрев,
			AISI 316L — коррозионные среды с хлоридами. Швеллер нержавеющий купить можно по позициям из прайса
			выше или заявкой на гибку по чертежу.
		</p>
		<p>
			Применение: каркасы пищевого и фармацевтического оборудования, опорные направляющие транспортёров,
			обвязка резервуаров, металлоконструкции в коррозионных средах химпрома и морских объектов.
		</p>
	</section>

	<section class="block">
		<h2>Сортамент</h2>
		<ul class="list-plain">
			<li><strong>Уголок равнополочный</strong> — 20×20×3, 25×25×3, 32×32×3, 40×40×4, 50×50×5, 63×63×6, 75×75×6, 100×100×8</li>
			<li><strong>Швеллер</strong> — №№ 8, 10, 12, 14, 16, 18, 20</li>
			<li><strong>Длины</strong> — 6000 мм; резка в размер с шагом 1 мм по заявке</li>
		</ul>
	</section>

	<section class="block">
		<h2>Применение</h2>
		<ul class="list-plain">
			<li>Каркасы оборудования пищевой, фармацевтической промышленности</li>
			<li>Опоры и стойки для трубопроводов в агрессивной среде</li>
			<li>Архитектурные элементы — обвязки витражей, перил</li>
			<li>Морские и прибрежные конструкции</li>
		</ul>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода — ГОСТ 8240 (швеллер), ГОСТ 8509 (уголок)</li>
			<li>Резка в размер по чертежу или заявке</li>
			<li>Отгрузка из Нижнего Новгорода</li>
			<li>Доставка автотранспортом и ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.block p {
		color: var(--color-muted);
		max-width: 70ch;
		margin: 0 0 var(--space-3) 0;
	}
	.block p:last-child { margin-bottom: 0; }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
</style>
