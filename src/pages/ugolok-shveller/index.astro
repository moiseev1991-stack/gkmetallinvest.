---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any)['ugolok-shveller'] as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const faq = [
	{
		q: 'Резку уголка и швеллера в размер делаете?',
		a: 'Да, режем дисковой пилой в размер от 1 хлыста с точностью ±1 мм. Возможен раскрой по чертежу с фасочными надрезами под сварку.',
	},
	{
		q: 'Какие марки используются для нержавеющего профиля?',
		a: 'Основные — AISI 304 (08Х18Н10) и AISI 316L. Для жаростойкого исполнения — AISI 321 / 12Х18Н10Т. Чисто декоративные элементы — допустимо AISI 430 (ферритная, безникелевая, дешевле).',
	},
	{
		q: 'Подойдёт ли уголок 50×50×5 для каркаса оборудования?',
		a: 'Для опор и каркасов лёгкого оборудования (стол, рама, навес) — да. Для нагруженных конструкций — расчёт по ГОСТ 14249 / СП 16.13330. Уточняйте у инженера проекта или присылайте ТЗ — подскажем сечение.',
	},
	{
		q: 'Чем уголок 40×40 отличается от 50×50 по нагрузке?',
		a: 'Момент сопротивления сечения у 50×50×5 примерно в 1,8 раза выше, чем у 40×40×4. Для перильного ограждения берут 40×40×4, для рамного каркаса под оборудование 200–400 кг — 50×50×5. Под динамические нагрузки — расчёт от инженера.',
	},
	{
		q: 'Из какой марки заказать уголок и швеллер для пищевого производства?',
		a: 'Для контакта со средой по СанПиН — AISI 304 (08Х18Н10). Для сварных каркасов, где после сварки нет термообработки, — AISI 321 (12Х18Н10Т) с титаном против МКК. Для агрессивных моющих средств с хлоридами — AISI 316L (03Х17Н14М2).',
	},
	{
		q: 'Какие документы выдаются?',
		a: 'На каждую партию — сертификат качества завода-изготовителя с указанием марки стали и номера плавки. По запросу присылаем копии до отгрузки через ЭДО.',
	},
];
---

<CatalogHubTemplate
	title="Уголок и швеллер нержавеющие — AISI 304, 316L, 12Х18Н10Т"
	description="Уголок нержавеющий равнополочный 20×20…100×100 и гнутый швеллер 80×40…140×60 из нержавейки AISI 304, 316L, 321. Резка в размер, доставка по РФ."
	h1="Уголок / Швеллер нержавеющий"
	intro="Сортовой нержавеющий профильный прокат. Уголок равнополочный от 20×3 до 100×10 мм и гнутый швеллер 80×40…140×60 мм. Стандартная длина хлыста 6 м, резка в размер по заявке. Марки AISI 304 (08Х18Н10), 316L, 321 (12Х18Н10Т)."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Уголок / Швеллер' }]}
	hubHref="/ugolok-shveller/"
	hubLabel="Уголок и швеллер нержавеющий"
	hubKey="ugolok-shveller"
	faq={faq}
>
	<PriceTable hub="ugolok-shveller" title="Прайс на уголок и швеллер" measure="размер" />

	<HubExtras
		hubHref="/ugolok-shveller/"
		hubLabel="Уголок и швеллер"
		hubLabelGenitive="уголок и швеллер нержавеющие"
		grades={grades}
	/>

	<section class="block">
		<h2>Уголок нержавеющий — размеры и марки</h2>
		<p>
			Уголок нержавеющий выпускается равнополочным (полки равной ширины) по ГОСТ 8509 и неравнополочным
			(полки разной ширины) по ГОСТ 8510. Полки соединены под углом 90°. Химический состав сорта — по ГОСТ 5949.
			В наличии равнополочный ряд от 20×3 до 100×10 мм; неравнополочный уголок поставляем под заказ.
			Стандартная длина хлыста — 6 м, мерные нарезы режем под заказ.
		</p>
		<p>
			Марки: AISI 304 (08Х18Н10) — базовая аустенитная под общие задачи; AISI 321 (12Х18Н10Т) — стабилизирована
			титаном, держит сварку и нагрев; AISI 316L (03Х17Н14М2) — с молибденом, под хлориды и кислые среды.
			Купить уголок нержавеющий можно от 1 хлыста, розница от 0,1 т.
		</p>
	</section>

	<section class="block">
		<h2>Швеллер нержавеющий — размеры и марки</h2>
		<p>
			Мы поставляем только гнутый нержавеющий швеллер — П-образный профиль, согнутый из листа на
			листогибочном прессе (ГОСТ 8278-83 на гнутые равнополочные швеллеры). Прокатный горячекатаный швеллер
			с типоразмерами №10У, №10П и т. п. нормирует ГОСТ 8240, но этот стандарт распространяется на
			углеродистую сталь — в нержавейке такой профиль серийно не катают.
		</p>
		<p>
			В наличии гнутые сечения 80×40×5, 100×50×5, 120×60×6, 140×60×7 мм (по высоте стенки — аналоги
			прокатных №8, №10, №12, №14). Длина хлыста 6 м. Марки: AISI 304 (08Х18Н10) — общее назначение,
			AISI 321 (12Х18Н10Т) — сварные узлы и нагрев, AISI 316L — коррозионные среды с хлоридами.
			Швеллер купить можно по позициям из прайса выше или заявкой на гибку по чертежу.
		</p>
	</section>

	<section class="block">
		<h2>Сортамент</h2>
		<ul class="list-plain">
			<li><strong>Уголок равнополочный</strong> (ГОСТ 8509) — 20×3, 25×3, 30×3, 30×4, 35×3, 40×3, 40×4, 50×4, 50×5, 60×5, 60×6, 70×5, 70×6, 70×7, 75×5, 80×8, 100×6, 100×10</li>
			<li><strong>Уголок неравнополочный</strong> (ГОСТ 8510) — под заказ</li>
			<li><strong>Швеллер гнутый</strong> (ГОСТ 8278) — 80×40×5, 100×50×5, 120×60×6, 140×60×7</li>
			<li><strong>Длины</strong> — 6000 мм; резка в размер с шагом 1 мм по заявке</li>
		</ul>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат качества завода-изготовителя на каждую партию — марка стали и номер плавки</li>
			<li>Резка в размер по чертежу или заявке</li>
			<li>Отгрузка из Нижнего Новгорода</li>
			<li>Доставка автотранспортом и ТК</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.block p {
		color: var(--color-muted);
		max-width: 70ch;
		margin: 0 0 var(--space-3) 0;
	}
	.block p:last-child { margin-bottom: 0; }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
</style>
