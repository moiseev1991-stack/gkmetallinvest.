		<section class="calc__block">
			<h2 class="calc__h2">Специализированные калькуляторы</h2>
			<p class="calc__hub-lead">Для арматуры, балки, швеллера и других видов проката — отдельные страницы с расчётом по ГОСТ-таблицам и без ручного ввода размеров.</p>
			<ul class="calc__hubs">
				<li><a href="/kalkulyator-armatury/">Калькулятор веса арматуры — ГОСТ 5781-82, А240/А400/А500С<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-shvellera/">Калькулятор веса швеллера — ГОСТ 8240-97, 5П…40П<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-balki/">Калькулятор веса двутавровой балки — ГОСТ 8239-89, №10–60<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-otvoda/">Калькулятор веса отвода — ГОСТ 17375-2001, R=1.0D/1.5D<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-flantsa/">Калькулятор веса фланца — ГОСТ 33259-2015 / 12820-80<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-riflenogo-lista/">Калькулятор веса рифлёного листа — ГОСТ 8568-77, ромб и чечевица<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-pvl/">Калькулятор веса ПВЛ — ГОСТ 8706-78, ПВЛ-406…610<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-ovalnoy-truby/">Калькулятор веса плоскоовальной трубы — нержавейка AISI 304/316L<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-setki/">Калькулятор веса сетки — тканая и сварная, ГОСТ 3826/23279<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
				<li><a href="/kalkulyator-rulona/">Калькулятор веса рулона нержавейки — по диаметру намотки<svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></a></li>
			</ul>
		</section>

		<section class="calc__faq">
			<h2 class="calc__h2">Частые вопросы</h2>
			<div class="calc__faq-list">
				{faq.map((f) => (
					<details class="calc__faq-item">
						<summary class="calc__faq-q">
							<span>{f.q}</span>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</section>
	</div>

	<CtaSection
		title="Не нашли нужный формат?"
		text="Менеджер пересчитает вес по чертежу и пришлёт КП — даже под нестандартные позиции."
	/>
</BaseLayout>

<script>
	type Shape = 'list' | 'krug' | 'kvadrat' | 'shestigrannik' | 'truba' | 'truba-pryam' | 'provoloka' | 'polosa' | 'ugolok';

	const DENSITIES: Record<string, number> = {
		austenitic: 7.9,
		ferritic: 7.7,
		martensitic: 7.7,
		duplex: 7.8,
	};

	const SHAPE_LABEL: Record<Shape, string> = {
		list: 'Лист',
		krug: 'Круг',
		kvadrat: 'Квадрат',
		shestigrannik: 'Шестигранник',
		truba: 'Труба круглая',
		'truba-pryam': 'Труба профильная',
		provoloka: 'Проволока',
		polosa: 'Полоса',
		ugolok: 'Уголок',
	};

	const GRADE_LABEL: Record<string, string> = {
		austenitic: 'Аустенитная',
		ferritic: 'Ферритная',
		martensitic: 'Мартенситная',
		duplex: 'Дуплекс',
		custom: 'Своя плотность',
	};

	/* Какие поля показываем под каждый вид проката. По умолчанию значение в мм;
	   для длинномера длина в метрах (правка клиента 24.06.2026: «210000 мм»
	   на профильной трубе — неудобно, естественнее «6 м»). Внутри все формулы
	   работают в мм, getDim сам конвертирует. */
	type FieldUnit = 'mm' | 'm';
	const FIELDS: Record<Shape, { unit: 'pcs' | 'meter' | 'sheet'; fields: { key: string; label: string; def?: number; valueUnit?: FieldUnit }[] }> = {
		list: { unit: 'sheet', fields: [
			{ key: 'thickness', label: 'Толщина, мм', def: 1 },
			{ key: 'width', label: 'Ширина, мм', def: 1000 },
			{ key: 'length', label: 'Длина, мм', def: 2000 },
		]},
		polosa: { unit: 'pcs', fields: [
			{ key: 'thickness', label: 'Толщина, мм', def: 4 },
			{ key: 'width', label: 'Ширина, мм', def: 40 },
			{ key: 'length', label: 'Длина, м', def: 6, valueUnit: 'm' },
		]},
		krug: { unit: 'meter', fields: [
			{ key: 'diameter', label: 'Диаметр, мм', def: 20 },
			{ key: 'length', label: 'Длина, м', def: 1, valueUnit: 'm' },
		]},
		kvadrat: { unit: 'meter', fields: [
			{ key: 'side', label: 'Сторона, мм', def: 20 },
			{ key: 'length', label: 'Длина, м', def: 1, valueUnit: 'm' },
		]},
		shestigrannik: { unit: 'meter', fields: [
			{ key: 'side', label: 'Размер «под ключ» (через грани), мм', def: 22 },
			{ key: 'length', label: 'Длина, м', def: 1, valueUnit: 'm' },
		]},
		truba: { unit: 'meter', fields: [
			{ key: 'diameter', label: 'Наружный диаметр, мм', def: 50 },
			{ key: 'wall', label: 'Стенка, мм', def: 2 },
			{ key: 'length', label: 'Длина, м', def: 6, valueUnit: 'm' },
		]},
		'truba-pryam': { unit: 'meter', fields: [
			{ key: 'side_a', label: 'Сторона A, мм', def: 40 },
			{ key: 'side_b', label: 'Сторона B, мм', def: 20 },
			{ key: 'wall', label: 'Стенка, мм', def: 2 },
			{ key: 'length', label: 'Длина, м', def: 6, valueUnit: 'm' },
		]},
		provoloka: { unit: 'meter', fields: [
			{ key: 'diameter', label: 'Диаметр, мм', def: 1 },
			{ key: 'length', label: 'Длина, м', def: 1, valueUnit: 'm' },
		]},
		ugolok: { unit: 'meter', fields: [
			{ key: 'side_a', label: 'Полка A, мм', def: 50 },
			{ key: 'side_b', label: 'Полка B, мм', def: 50 },
			{ key: 'thickness', label: 'Толщина, мм', def: 5 },
			{ key: 'length', label: 'Длина, м', def: 6, valueUnit: 'm' },
		]},
	};

	const UNIT_LABELS: Record<'pcs' | 'meter' | 'sheet', string> = {
		pcs: 'шт',
		meter: 'м',
		sheet: 'лист',
	};

	const root = document.querySelector('[data-calc-root]');
	const densityRow = root?.querySelector('[data-calc-density-row]') as HTMLElement | null;
	const densityInput = root?.querySelector('[data-calc-density]') as HTMLInputElement | null;
	const dimsEl = root?.querySelector('[data-calc-dims]') as HTMLElement | null;
	const qtyInput = root?.querySelector('[data-calc-qty]') as HTMLInputElement | null;
	const qtyHint = root?.querySelector('[data-calc-qty-hint]') as HTMLElement | null;
	const massInput = root?.querySelector('[data-calc-mass]') as HTMLInputElement | null;
	const massUnitSel = root?.querySelector('[data-calc-mass-unit]') as HTMLSelectElement | null;
	const massHintUnit = root?.querySelector('[data-calc-mass-hint-unit]') as HTMLElement | null;
	const unitWeightEl = root?.querySelector('[data-calc-unit-weight]') as HTMLElement | null;
	const totalEl = root?.querySelector('[data-calc-total]') as HTMLElement | null;
	const totalSubEl = root?.querySelector('[data-calc-total-sub]') as HTMLElement | null;
	const volumeEl = root?.querySelector('[data-calc-volume]') as HTMLElement | null;
	const densityDisplay = root?.querySelector('[data-calc-density-display]') as HTMLElement | null;
	const ctaEl = root?.querySelector('[data-calc-cta]') as HTMLAnchorElement | null;
	const qtyMinus = root?.querySelector('[data-calc-qty-minus]') as HTMLButtonElement | null;
	const qtyPlus = root?.querySelector('[data-calc-qty-plus]') as HTMLButtonElement | null;
	const copyBtn = root?.querySelector('[data-calc-copy]') as HTMLButtonElement | null;
	const copyText = root?.querySelector('[data-calc-copy-text]') as HTMLElement | null;

	const UNIT_HINT: Record<'pcs' | 'meter' | 'sheet', string> = {
		pcs: 'штук',
		meter: 'метров',
		sheet: 'листов',
	};

	let currentShape: Shape = 'list';
	let currentGrade = 'austenitic';
	/* Какое поле редактировалось последним: количество или масса.
	   Определяет направление пересчёта — другое поле обновляется автоматически. */
	let lastEdited: 'qty' | 'mass' = 'qty';

	if (root && dimsEl && qtyInput && qtyHint && unitWeightEl && totalEl) {
		const fmt = new Intl.NumberFormat('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 3 });
		const fmtVol = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 4 });

		function getDensity(): number {
			if (currentGrade === 'custom') return parseFloat(densityInput?.value || '7.9') || 7.9;
			return DENSITIES[currentGrade] ?? 7.9;
		}

		function renderDims() {
			const cfg = FIELDS[currentShape];
			dimsEl!.innerHTML = '';
			cfg.fields.forEach((f) => {
				const wrap = document.createElement('div');
				wrap.className = 'calc__field';
				const lbl = document.createElement('label');
				lbl.className = 'calc__label';
				lbl.setAttribute('for', `calc-${f.key}`);
				lbl.textContent = f.label;
				const inp = document.createElement('input');
				inp.className = 'calc__input';
				inp.id = `calc-${f.key}`;
				inp.type = 'number';
				inp.inputMode = 'decimal';
				inp.step = 'any';
				inp.min = '0.01';
				inp.dataset.dim = f.key;
				if (f.valueUnit) inp.dataset.valueUnit = f.valueUnit;
				inp.value = String(f.def ?? '');
				/* Изменение размера — пересчёт идёт от количества к массе. */
				inp.addEventListener('input', () => { lastEdited = 'qty'; recalc(); });
				wrap.appendChild(lbl);
				wrap.appendChild(inp);
				dimsEl!.appendChild(wrap);
			});
			qtyHint!.textContent = UNIT_LABELS[cfg.unit];
			if (massHintUnit) massHintUnit.textContent = UNIT_HINT[cfg.unit];
		}

		function getDim(key: string): number {
			const el = dimsEl!.querySelector(`[data-dim="${key}"]`) as HTMLInputElement | null;
			if (!el) return 0;
			const raw = parseFloat(el.value) || 0;
			/* Формулы геометрии работают в мм; поля с valueUnit="m" пользователь
			   вводит в метрах — приводим к мм. */
			return el.dataset.valueUnit === 'm' ? raw * 1000 : raw;
		}

		function calcVolumeMm3(): number {
			const shape = currentShape;
			switch (shape) {
				case 'list':
				case 'polosa': {
					return getDim('thickness') * getDim('width') * getDim('length');
				}
				case 'krug':
				case 'provoloka': {
					const d = getDim('diameter');
					return Math.PI * (d / 2) ** 2 * getDim('length');
				}
				case 'kvadrat': {
					const a = getDim('side');
					return a * a * getDim('length');
				}
				case 'shestigrannik': {
					const s = getDim('side');
					return (Math.sqrt(3) / 2) * s * s * getDim('length');
				}
				case 'truba': {
					const D = getDim('diameter');
					const wall = getDim('wall');
					const L = getDim('length');
					if (wall >= D / 2) return 0;
					return Math.PI * (D - wall) * wall * L;
				}
				case 'truba-pryam': {
					const a = getDim('side_a');
					const b = getDim('side_b');
					const wall = getDim('wall');
					const L = getDim('length');
					if (wall >= Math.min(a, b) / 2) return 0;
					return 2 * (a + b - 2 * wall) * wall * L;
				}
				case 'ugolok': {
					const a = getDim('side_a');
					const b = getDim('side_b');
					const t = getDim('thickness');
					const L = getDim('length');
					if (t >= Math.min(a, b)) return 0;
					/* Уголок с полками a и b: средняя линия (a + b − t) × толщина × длина.
					   При a = b = равнополочный, при a ≠ b — неравнополочный. */
					return (a + b - t) * t * L;
				}
			}
			return 0;
		}

		function calcUnitWeight(): number {
			/* Объём V (мм³) × ρ (г/см³) / 10⁶ = масса (кг). */
			return calcVolumeMm3() * getDensity() / 1e6;
		}

		function recalc() {
			const unitW = calcUnitWeight();
			let qty = parseFloat(qtyInput!.value) || 0;

			/* Двусторонняя связь Количество ⇄ Масса.
			   Если последним редактировали массу — qty пересчитывается из неё.
			   Иначе — масса пересчитывается из qty. */
			if (lastEdited === 'mass' && massInput && unitW > 0) {
				const massRaw = parseFloat(massInput.value) || 0;
				const massKg = massUnitSel?.value === 't' ? massRaw * 1000 : massRaw;
				qty = massKg / unitW;
				if (qty > 0) qtyInput!.value = String(+qty.toFixed(3));
				else qtyInput!.value = '0';
			} else if (massInput && unitW > 0 && qty > 0) {
				const totalKg = unitW * qty;
				const inT = massUnitSel?.value === 't';
				massInput.value = String(+(inT ? totalKg / 1000 : totalKg).toFixed(3));
			} else if (massInput && (qty <= 0 || unitW <= 0)) {
				massInput.value = '';
			}

			const total = unitW * qty;
			const rho = getDensity();
			const volMm3 = calcVolumeMm3();

			unitWeightEl!.textContent = unitW > 0 ? `${fmt.format(unitW)} кг` : '—';

			if (total > 0) {
				if (total >= 1000) {
					totalEl!.textContent = `${fmt.format(total / 1000)} т`;
					totalSubEl!.textContent = `${fmt.format(total)} кг`;
				} else {
					totalEl!.textContent = `${fmt.format(total)} кг`;
					totalSubEl!.textContent = '';
				}
			} else {
				totalEl!.textContent = '—';
				totalSubEl!.textContent = '';
			}

			if (densityDisplay) densityDisplay.textContent = `${rho.toString().replace('.', ',')} г/см³`;
			if (volumeEl) {
				const volTotalMm3 = volMm3 * qty;
				if (volTotalMm3 > 0) {
					const m3 = volTotalMm3 / 1e9;
					if (m3 >= 0.001) {
						volumeEl.textContent = `${fmtVol.format(m3)} м³`;
					} else {
						const dm3 = volTotalMm3 / 1e6;
						volumeEl.textContent = `${fmtVol.format(dm3)} дм³`;
					}
				} else {
					volumeEl.textContent = '—';
				}
			}

			if (ctaEl) {
				const params = new URLSearchParams({
					shape: currentShape,
					qty: String(qty),
					weight_kg: String(Math.round(total)),
				});
				ctaEl.href = `/zapros-kp/?${params.toString()}#lead-form`;
			}
		}

		/* Кнопки-плитки видов проката */
		root.querySelectorAll('[data-calc-shape-btn]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const k = (btn as HTMLElement).dataset.calcShapeBtn as Shape;
				if (!k) return;
				currentShape = k;
				root!.querySelectorAll('[data-calc-shape-btn]').forEach((b) => {
					const active = (b as HTMLElement).dataset.calcShapeBtn === k;
					b.classList.toggle('calc__shape--active', active);
					b.setAttribute('aria-checked', active ? 'true' : 'false');
				});
				root!.querySelectorAll('[data-shape-svg]').forEach((el) => {
					el.classList.toggle('is-active', (el as HTMLElement).dataset.shapeSvg === k);
				});
				lastEdited = 'qty';
				renderDims();
				recalc();
			});
		});

		/* Кнопки-плитки групп марок */
		root.querySelectorAll('[data-calc-grade-btn]').forEach((btn) => {
			btn.addEventListener('click', () => {
				const k = (btn as HTMLElement).dataset.calcGradeBtn as string;
				if (!k) return;
				currentGrade = k;
				root!.querySelectorAll('[data-calc-grade-btn]').forEach((b) => {
					const active = (b as HTMLElement).dataset.calcGradeBtn === k;
					b.classList.toggle('calc__grade--active', active);
					b.setAttribute('aria-checked', active ? 'true' : 'false');
				});
				if (densityRow) densityRow.hidden = k !== 'custom';
				if (k !== 'custom' && densityInput) {
					densityInput.value = String(DENSITIES[k] ?? 7.9);
				}
				/* Подкрашиваем виджет в тон группы — через data-tone на корне */
				(root as HTMLElement).dataset.gradeTone = k;
				lastEdited = 'qty';
				recalc();
			});
		});

		densityInput?.addEventListener('input', () => { lastEdited = 'qty'; recalc(); });
		qtyInput.addEventListener('input', () => { lastEdited = 'qty'; recalc(); });
		massInput?.addEventListener('input', () => { lastEdited = 'mass'; recalc(); });
		/* Смена единицы массы: пересчитываем поле к новой единице,
		   ведущим оставляем количество. */
		massUnitSel?.addEventListener('change', () => { lastEdited = 'qty'; recalc(); });

		qtyMinus?.addEventListener('click', () => {
			lastEdited = 'qty';
			const v = parseFloat(qtyInput.value) || 0;
			const next = Math.max(0.01, v - 1);
			qtyInput.value = String(Number.isInteger(next) ? next : +next.toFixed(2));
			recalc();
		});
		qtyPlus?.addEventListener('click', () => {
			lastEdited = 'qty';
			const v = parseFloat(qtyInput.value) || 0;
			qtyInput.value = String(v + 1);
			recalc();
		});

		copyBtn?.addEventListener('click', async () => {
			const shape = SHAPE_LABEL[currentShape];
			const grade = GRADE_LABEL[currentGrade];
			const rho = getDensity();
			const unit = calcUnitWeight();
			const qty = parseFloat(qtyInput.value) || 0;
			const total = unit * qty;
			const dims = Array.from(dimsEl!.querySelectorAll('[data-dim]'))
				.map((el) => {
					const inp = el as HTMLInputElement;
					const lbl = dimsEl!.querySelector(`label[for="${inp.id}"]`);
					return `${lbl?.textContent ?? inp.dataset.dim}: ${inp.value}`;
				})
				.join('; ');
			const text =
				`${shape} (${grade}, ρ=${rho} г/см³)\n` +
				`${dims}\n` +
				`Вес 1 ед.: ${fmt.format(unit)} кг\n` +
				`Кол-во: ${qty} ${UNIT_LABELS[FIELDS[currentShape].unit]}\n` +
				`Общий вес: ${total >= 1000 ? fmt.format(total / 1000) + ' т (' + fmt.format(total) + ' кг)' : fmt.format(total) + ' кг'}`;
			try {
				await navigator.clipboard.writeText(text);
				if (copyText) {
					const prev = copyText.textContent;
					copyText.textContent = 'Скопировано';
					setTimeout(() => { if (copyText) copyText.textContent = prev ?? 'Скопировать расчёт'; }, 1600);
				}
			} catch (e) {
				/* clipboard mode unavailable — silent fallback */
			}
		});

		renderDims();
		recalc();
	}
</script>

<style>
	.calc { padding-block: var(--space-8); min-width: 0; }

	/* ---------- Hero ---------- */
	.calc__hero { margin-bottom: var(--space-7); max-width: 80ch; }
	.calc__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		margin-bottom: var(--space-3);
	}
	.calc__h1 {
		font-size: clamp(1.7rem, 3.5vw, 2.5rem);
		line-height: 1.15;
		margin: 0 0 var(--space-3);
		letter-spacing: -0.02em;
	}
	.calc__h1-accent {
		background: linear-gradient(135deg, var(--color-primary-500), var(--color-primary));
		-webkit-background-clip: text;
		background-clip: text;
		-webkit-text-fill-color: transparent;
		color: transparent;
	}
	.calc__lead { font-size: 1.05rem; line-height: 1.6; max-width: 70ch; color: var(--color-text); margin: 0 0 var(--space-4); }
	.calc__perks {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.calc__perks li {
		font-size: 0.85rem;
		color: var(--color-muted);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 0.4rem 0.75rem;
		border-radius: var(--radius-pill);
	}
	.calc__perks strong { color: var(--color-primary-500); font-weight: 700; }

	/* ---------- Widget ---------- */
	.calc__widget {
		position: relative;
		background: linear-gradient(180deg, #ffffff 0%, var(--color-bg) 100%);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-xl);
		padding: var(--space-6);
		margin-bottom: var(--space-10);
		box-shadow: var(--shadow-md);
		overflow: hidden;
	}
	.calc__widget-glow {
		position: absolute;
		inset: -50%;
		background:
			radial-gradient(40% 30% at 80% 10%, rgba(28, 75, 128, 0.10), transparent 70%),
			radial-gradient(35% 30% at 5% 95%, rgba(196, 101, 27, 0.08), transparent 70%);
		pointer-events: none;
		z-index: 0;
	}
	.calc__widget-inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
		gap: var(--space-6);
	}
	@media (max-width: 900px) {
		.calc__widget { padding: var(--space-4); }
		.calc__widget-inner { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
	}

	/* ---------- Steps ---------- */
	.calc__step {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-3);
	}
	.calc__step--mt { margin-top: var(--space-5); }
	.calc__step-num {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		background: var(--color-primary-500);
		color: #fff;
		font-weight: 700;
		font-size: 0.85rem;
		display: grid;
		place-items: center;
		flex-shrink: 0;
		box-shadow: 0 0 0 4px var(--color-primary-50);
	}
	.calc__step-title {
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--color-text);
	}

	/* ---------- Shapes grid ---------- */
	.calc__shapes {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
		gap: 0.5rem;
	}
	.calc__shape {
		appearance: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0.85rem 0.4rem 0.7rem;
		cursor: pointer;
		color: var(--color-muted);
		transition: all var(--dur-fast) var(--ease-out);
		min-height: 84px;
		font: inherit;
	}
	.calc__shape:hover {
		border-color: var(--color-primary-400);
		color: var(--color-primary-500);
		transform: translateY(-1px);
	}
	.calc__shape--active {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		color: var(--color-primary);
		box-shadow: 0 0 0 3px rgba(28, 75, 128, 0.10);
	}
	.calc__shape-icon {
		color: inherit;
		opacity: 0.9;
	}
	.calc__shape-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-align: center;
		line-height: 1.15;
	}

	/* ---------- Grades grid ---------- */
	.calc__grades {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
		gap: 0.5rem;
	}
	.calc__grade {
		appearance: none;
		display: flex;
		align-items: center;
		gap: 0.65rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0.7rem 0.85rem;
		cursor: pointer;
		text-align: left;
		color: var(--color-text);
		transition: all var(--dur-fast) var(--ease-out);
		font: inherit;
	}
	.calc__grade:hover { border-color: var(--color-primary-400); transform: translateY(-1px); }
	.calc__grade--active {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		box-shadow: 0 0 0 3px rgba(28, 75, 128, 0.08);
	}
	.calc__grade-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		flex-shrink: 0;
		border: 2px solid transparent;
		background: var(--color-border-strong);
		transition: all var(--dur-fast) var(--ease-out);
	}
	.calc__grade[data-tone="austenitic"] .calc__grade-dot { background: #4f9c7a; }
	.calc__grade[data-tone="ferritic"] .calc__grade-dot { background: #6c7d92; }
	.calc__grade[data-tone="martensitic"] .calc__grade-dot { background: #8b7250; }
	.calc__grade[data-tone="duplex"] .calc__grade-dot { background: #b76a3b; }
	.calc__grade[data-tone="custom"] .calc__grade-dot {
		background: linear-gradient(135deg, #4f9c7a, #6c7d92, #8b7250, #b76a3b);
	}
	.calc__grade--active .calc__grade-dot {
		box-shadow: 0 0 0 3px var(--color-primary-100);
	}
	.calc__grade-text { display: flex; flex-direction: column; min-width: 0; gap: 0.05rem; }
	.calc__grade-text strong { font-size: 0.9rem; line-height: 1.2; color: var(--color-text); font-weight: 600; }
	.calc__grade-text small { font-size: 0.76rem; color: var(--color-muted); line-height: 1.25; }

	/* ---------- Fields ---------- */
	.calc__field { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
	.calc__field--inline {
		grid-column: 1 / -1;
		max-width: 260px;
		margin-top: var(--space-3);
	}
	.calc__field--qty { margin-top: var(--space-4); max-width: 280px; }
	.calc__label {
		font-size: 0.74rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-subtle);
	}
	.calc__input {
		font: inherit;
		font-size: 0.95rem;
		padding: 0.65rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		color: var(--color-text);
		outline: none;
		transition: border-color var(--dur-fast) var(--ease-out),
			box-shadow var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out);
		min-width: 0;
		width: 100%;
		appearance: none;
		-webkit-appearance: none;
	}
	.calc__input:focus {
		border-color: var(--color-primary-500);
		box-shadow: 0 0 0 3px var(--color-primary-100);
		background: #fff;
	}

	.calc__dims {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 0.6rem;
	}

	/* ---------- Quantity stepper ---------- */
	.calc__qty-wrap {
		display: grid;
		grid-template-columns: 36px minmax(0, 1fr) 36px auto;
		align-items: stretch;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
		transition: border-color var(--dur-fast) var(--ease-out);
	}
	.calc__qty-wrap:focus-within { border-color: var(--color-primary-500); box-shadow: 0 0 0 3px var(--color-primary-100); }
	.calc__qty-step {
		background: transparent;
		border: 0;
		font-size: 1.2rem;
		font-weight: 600;
		cursor: pointer;
		color: var(--color-muted);
		display: grid;
		place-items: center;
		transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}
	.calc__qty-step:hover { background: var(--color-primary-50); color: var(--color-primary-500); }
	.calc__qty-input {
		border: 0 !important;
		border-radius: 0 !important;
		background: transparent !important;
		text-align: center;
		font-weight: 600;
		font-size: 1rem;
		padding-inline: 0.5rem !important;
		box-shadow: none !important;
	}
	.calc__qty-input:focus { background: transparent !important; }
	.calc__qty-unit {
		padding: 0 0.85rem;
		display: grid;
		place-items: center;
		font-size: 0.85rem;
		color: var(--color-muted);
		border-left: 1px solid var(--color-border);
		background: var(--color-bg-elev);
	}

	/* ---------- Mass input (обратный пересчёт) ---------- */
	.calc__field--mass { margin-top: var(--space-3); max-width: 280px; }
	.calc__mass-wrap {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: stretch;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		overflow: hidden;
		transition: border-color var(--dur-fast) var(--ease-out);
	}
	.calc__mass-wrap:focus-within { border-color: var(--color-primary-500); box-shadow: 0 0 0 3px var(--color-primary-100); }
	.calc__mass-input {
		border: 0 !important;
		border-radius: 0 !important;
		background: transparent !important;
		text-align: center;
		font-weight: 600;
		font-size: 1rem;
		padding-inline: 0.5rem !important;
		box-shadow: none !important;
	}
	.calc__mass-input:focus { background: transparent !important; }
	.calc__mass-unit-sel {
		border: 0;
		border-left: 1px solid var(--color-border);
		background: var(--color-bg-elev);
		padding: 0 0.5rem 0 0.85rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		cursor: pointer;
		appearance: none;
		-webkit-appearance: none;
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='none'><path d='M4 6l4 4 4-4' stroke='%23667' stroke-width='1.4' stroke-linecap='round' stroke-linejoin='round'/></svg>");
		background-repeat: no-repeat;
		background-position: right 0.45rem center;
		background-size: 0.9rem;
		padding-right: 1.6rem;
	}
	.calc__mass-unit-sel:focus { outline: none; }
	.calc__mass-hint {
		font-size: 0.78rem;
		color: var(--color-muted);
		margin: 0.45rem 0 0;
		line-height: 1.4;
	}

	/* ---------- Result card ---------- */
	.calc__result {
		position: sticky;
		top: calc(var(--header-h) + 1rem);
		align-self: flex-start;
	}
	@media (max-width: 900px) {
		.calc__result { position: static; }
	}
	.calc__result-card {
		background: var(--grad-hero);
		color: var(--color-on-dark);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		box-shadow: var(--shadow-glow);
		position: relative;
		overflow: hidden;
	}
	.calc__result-card::before {
		content: '';
		position: absolute;
		inset: -50%;
		background: var(--grad-hero-glow);
		pointer-events: none;
	}
	.calc__result-card > * { position: relative; z-index: 1; }

	/* ---------- Schema (вид сечения выбранного проката) ---------- */
	.calc__result-schema {
		margin: 0 calc(var(--space-5) * -1) var(--space-4);
		padding: var(--space-4) var(--space-4) var(--space-3);
		background: rgba(255, 255, 255, 0.04);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}
	.calc__schema-svg {
		display: none;
		width: 100%;
		height: auto;
		max-height: 200px;
	}
	.calc__schema-svg.is-active { display: block; }

	.calc__result-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent-100);
		margin-bottom: var(--space-4);
		opacity: 0.95;
	}
	.calc__result-row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-3);
		padding: 0.6rem 0;
		border-bottom: 1px dashed rgba(255, 255, 255, 0.15);
	}
	.calc__result-row span { font-size: 0.85rem; color: var(--color-on-dark-muted); }
	.calc__result-row strong {
		font-family: var(--font-mono);
		font-size: 1rem;
		color: #fff;
		font-weight: 600;
	}

	.calc__result-total { padding: var(--space-4) 0 var(--space-3); }
	.calc__result-total-label {
		display: block;
		font-size: 0.85rem;
		color: var(--color-on-dark-muted);
		margin-bottom: 0.35rem;
	}
	.calc__result-total-value {
		font-family: var(--font-mono);
		font-size: clamp(2.2rem, 4.6vw, 3.2rem);
		font-weight: 700;
		line-height: 1.05;
		color: var(--color-accent-100);
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}
	.calc__result-total-sub {
		font-family: var(--font-mono);
		font-size: 0.92rem;
		color: var(--color-on-dark-muted);
		margin-top: 0.25rem;
		min-height: 1.2em;
	}

	.calc__result-meta {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--space-3);
		margin: var(--space-4) 0 var(--space-4);
		padding-top: var(--space-3);
		border-top: 1px solid rgba(255, 255, 255, 0.12);
	}
	.calc__result-meta div { min-width: 0; }
	.calc__result-meta dt {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--color-on-dark-muted);
		margin-bottom: 0.2rem;
	}
	.calc__result-meta dd {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: #fff;
		margin: 0;
		overflow-wrap: anywhere;
	}

	.calc__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		text-align: center;
		padding: 0.85rem 1rem;
		background: var(--grad-cta-warm);
		color: #fff;
		font-weight: 600;
		text-decoration: none;
		border-radius: var(--radius-md);
		font-size: 0.95rem;
		transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
		box-shadow: var(--shadow-warm-glow);
	}
	.calc__cta:hover {
		color: #fff;
		text-decoration: none;
		transform: translateY(-1px);
		box-shadow: 0 14px 36px rgba(196, 101, 27, 0.35);
	}
	.calc__cta svg { transition: transform var(--dur-fast) var(--ease-out); }
	.calc__cta:hover svg { transform: translateX(2px); }

	.calc__copy {
		appearance: none;
		background: transparent;
		border: 1px solid rgba(255, 255, 255, 0.18);
		color: var(--color-on-dark);
		font: inherit;
		font-size: 0.85rem;
		padding: 0.55rem 0.85rem;
		border-radius: var(--radius-md);
		cursor: pointer;
		margin-top: 0.6rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		width: 100%;
		transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.calc__copy:hover { background: rgba(255, 255, 255, 0.06); border-color: rgba(255, 255, 255, 0.3); }

	.calc__result-foot {
		margin: var(--space-4) 0 0;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-on-dark-muted);
		opacity: 0.85;
	}

	/* ---------- Section heads ---------- */
	.calc__block { margin-bottom: var(--space-10); }
	.calc__h2 {
		font-size: 1.5rem;
		margin-bottom: var(--space-4);
		letter-spacing: -0.01em;
	}

	/* ---------- Density rows ---------- */
	.calc__density {
		display: grid;
		gap: 0.6rem;
		max-width: 900px;
	}
	.calc__density-row {
		display: grid;
		grid-template-columns: minmax(160px, 1.1fr) minmax(0, 2.4fr) auto;
		align-items: center;
		gap: var(--space-4);
		padding: 0.85rem var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
	}
	.calc__density-row:hover {
		border-color: var(--color-primary-400);
		transform: translateX(2px);
	}
	@media (max-width: 640px) {
		.calc__density-row { grid-template-columns: minmax(0, 1fr); gap: 0.5rem; }
	}
	.calc__density-group { display: flex; align-items: center; gap: 0.55rem; min-width: 0; }
	.calc__density-group strong { font-size: 0.95rem; font-weight: 600; }
	.calc__density-badge {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		flex-shrink: 0;
	}
	.calc__density-row[data-tone="austenitic"] .calc__density-badge { background: #4f9c7a; }
	.calc__density-row[data-tone="ferritic"] .calc__density-badge { background: #6c7d92; }
	.calc__density-row[data-tone="martensitic"] .calc__density-badge { background: #8b7250; }
	.calc__density-row[data-tone="duplex"] .calc__density-badge { background: #b76a3b; }
	.calc__density-row[data-tone="heat"] .calc__density-badge { background: #c4651b; }
	.calc__density-marks { font-size: 0.88rem; color: var(--color-muted); line-height: 1.4; }
	.calc__density-val {
		font-family: var(--font-mono);
		font-size: 1.15rem;
		font-weight: 700;
		color: var(--color-primary);
		white-space: nowrap;
	}
	.calc__density-val span { font-size: 0.75rem; color: var(--color-muted); font-weight: 400; margin-left: 0.2rem; }

	/* ---------- Hub chips ---------- */
	.calc__hub-lead { color: var(--color-muted); margin: 0 0 var(--space-3); }
	.calc__hubs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}
	.calc__hubs a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.55rem 0.95rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-primary);
		font-weight: 500;
		font-size: 0.92rem;
		text-decoration: none;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.calc__hubs a svg { color: var(--color-subtle); transition: transform var(--dur-fast) var(--ease-out); }
	.calc__hubs a:hover {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		text-decoration: none;
	}
	.calc__hubs a:hover svg { transform: translateX(2px); color: var(--color-primary-500); }

	/* ---------- FAQ ---------- */
	.calc__faq { margin-bottom: var(--space-8); }
	.calc__faq-list { display: grid; gap: 0.6rem; max-width: 80ch; }
	.calc__faq-item {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: var(--space-3) var(--space-4);
		transition: border-color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
	}
	.calc__faq-item[open] {
		border-color: var(--color-primary-100);
		background: var(--color-primary-50);
	}
	.calc__faq-q {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		font-weight: 600;
		color: var(--color-text);
		cursor: pointer;
		list-style: none;
	}
	.calc__faq-q::-webkit-details-marker { display: none; }
	.calc__faq-q svg {
		flex-shrink: 0;
		color: var(--color-muted);
		transition: transform var(--dur-fast) var(--ease-out);
	}
	.calc__faq-item[open] .calc__faq-q svg { transform: rotate(180deg); }
