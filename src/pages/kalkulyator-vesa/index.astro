---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { siteUrl, siteName } from '../../data/site';

const title = 'Калькулятор веса нержавеющего металлопроката — лист, труба, круг';
const description = 'Онлайн-расчёт веса нержавеющего металлопроката: лист, труба, круг, квадрат, шестигранник, проволока, полоса, уголок. Плотность по маркам AISI / ГОСТ.';

const faq = [
	{
		q: 'Какая плотность у нержавейки разных марок?',
		a: 'Аустенитные стали (AISI 304, 316L, 321, 12Х18Н10Т, 201) — 7,9 г/см³. Ферритные (AISI 430, 410, 439) — 7,7 г/см³. Мартенситные (AISI 420, 440) — 7,7 г/см³. Двухфазные (дуплекс) — 7,8 г/см³. Эти значения мы и используем в калькуляторе.',
	},
	{
		q: 'Какова плотность 12Х18Н10Т / AISI 321?',
		a: 'Плотность 12Х18Н10Т (AISI 321) — 7,9 г/см³, или 7900 кг/м³. Такая же плотность у AISI 304 (08Х18Н10), 316L, 316Ti и других аустенитных нержавеющих сталей с содержанием никеля 8–14 %. Для сравнения: ферритные марки (AISI 430, 410) — 7,7 г/см³, мартенситные (20Х13, 40Х13) — 7,7 г/см³, дуплексные двухфазные — 7,8 г/см³. При выборе марки в калькуляторе выше плотность подставляется автоматически.',
	},
	{
		q: 'Откуда берётся вес квадратного метра листа?',
		a: 'По формуле: толщина (м) × площадь (м²) × плотность (кг/м³). Для листа 1 мм AISI 304: 0,001 × 1 × 7900 = 7,9 кг/м². Для 2 мм — 15,8 кг/м², для 3 мм — 23,7 кг/м² и так далее.',
	},
	{
		q: 'Какая температура плавления нержавейки?',
		a: 'Температура плавления нержавеющей стали — 1400–1450 °C для аустенитных марок (AISI 304, 316L, 321) и 1480–1530 °C для ферритных (AISI 430). Точное значение зависит от химического состава и содержания примесей. Не путать с рабочей температурой эксплуатации: AISI 304 выдерживает длительно до +800 °C, AISI 321 — до +800 °C благодаря стабилизации титаном, жаропрочная AISI 310S (20Х23Н18) — до +1100 °C. На заводе сталь разливается при 1450–1550 °C.',
	},
	{
		q: 'Что такое удельный вес нержавейки и чем отличается от плотности?',
		a: 'В инженерной практике металлопроката «удельный вес» обычно означает то же, что плотность — 7,7–7,9 г/см³ для нержавейки, то есть массу единицы объёма. Строго по физике плотность измеряется в кг/м³ (масса/объём), а удельный вес — в Н/м³ (вес/объём), и они отличаются на множитель g = 9,81 м/с². На практике в прайсах и ГОСТах под «удельным весом стали» подразумевается именно плотность в кг/м³. Калькулятор использует плотность в г/см³ для пересчёта объёма в килограммы.',
	},
	{
		q: 'Как рассчитать вес трубы?',
		a: 'Формула: m = π × (D − S) × S × L × ρ, где D — наружный диаметр, S — толщина стенки, L — длина, ρ — плотность. Для трубы Ø 50 × 2 длиной 1 м из AISI 304: π × (50−2) × 2 × 1000 × 7,9 / 10⁶ = 2,38 кг/м.',
	},
	{
		q: 'Можно ли использовать расчёт для коммерческого предложения?',
		a: 'Да, как первичная оценка. Реальный вес партии может отличаться на ±0,5–1 % из-за допусков прокатки по толщине. В коммерческом предложении мы используем теоретический вес по ГОСТ — тот же, что показывает калькулятор.',
	},
	{
		q: 'Подходит ли для углеродистой и оцинкованной стали?',
		a: 'Калькулятор настроен на нержавейку. Для углеродистой стали плотность 7,85 г/см³, для оцинкованной — 7,85 г/см³ + ~0,03 кг/м² на цинк. Если нужен расчёт под чёрный металл — отметьте в поле «Другая плотность», вес пересчитается.',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const howToJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'Как рассчитать вес нержавеющего металлопроката',
	description: 'Пошаговый расчёт веса листа, трубы, круга, проволоки и других видов нержавеющего проката по их геометрии и плотности материала.',
	step: [
		{ '@type': 'HowToStep', name: 'Выбрать вид проката', text: 'Лист, рулон, труба, круг, квадрат, шестигранник, проволока, полоса или уголок.' },
		{ '@type': 'HowToStep', name: 'Ввести размеры', text: 'Толщину, диаметр, ширину, длину или другие параметры в миллиметрах.' },
		{ '@type': 'HowToStep', name: 'Выбрать марку стали', text: 'AISI 304, 316L, 321, 430, дуплекс — плотность подставляется автоматически.' },
		{ '@type': 'HowToStep', name: 'Получить результат', text: 'Калькулятор покажет вес единицы (кг/м или кг/м²) и общий вес заданного количества.' },
	],
};

/* Виды проката + SVG-иконки для плиток-селектора. Иконки — линейные, на 28×28,
   stroke=currentColor, чтобы менять цвет при активном состоянии через CSS. */
const shapes = [
	{ key: 'list', label: 'Лист', hubHref: '/list-nerzhaveyushchiy/' },
	{ key: 'truba', label: 'Труба круглая', hubHref: '/truba-nerzhaveyushchaya/' },
	{ key: 'truba-pryam', label: 'Труба профильная', hubHref: '/truba-nerzhaveyushchaya/' },
	{ key: 'krug', label: 'Круг', hubHref: '/krug-nerzhaveyushchiy/' },
	{ key: 'kvadrat', label: 'Квадрат', hubHref: '/krug-nerzhaveyushchiy/' },
	{ key: 'shestigrannik', label: 'Шестигранник', hubHref: '/krug-nerzhaveyushchiy/' },
	{ key: 'polosa', label: 'Полоса', hubHref: '/polosa-nerzhaveyushchaya/' },
	{ key: 'provoloka', label: 'Проволока', hubHref: '/provoloka-nerzhaveyushchaya/' },
	{ key: 'ugolok', label: 'Уголок', hubHref: '/ugolok-shveller-nerzhaveyushchiy/' },
];

const densityRows = [
	{ group: 'Аустенитные', marks: 'AISI 304, 304L, 316L, 316Ti, 321, 12Х18Н10Т, 201, 904L', density: '7,9', tone: 'austenitic' },
	{ group: 'Ферритные', marks: 'AISI 430, 410S, 439, 08Х17', density: '7,7', tone: 'ferritic' },
	{ group: 'Мартенситные', marks: 'AISI 420, 440, 20Х13, 30Х13, 40Х13', density: '7,7', tone: 'martensitic' },
	{ group: 'Двухфазные', marks: 'Дуплекс, супердуплекс', density: '7,8', tone: 'duplex' },
	{ group: 'Жаропрочные', marks: 'AISI 310S, 20Х23Н18', density: '7,9', tone: 'heat' },
];

const hubs = [
	{ href: '/list-nerzhaveyushchiy/', label: 'Лист' },
	{ href: '/truba-nerzhaveyushchaya/', label: 'Труба' },
	{ href: '/krug-nerzhaveyushchiy/', label: 'Круг' },
	{ href: '/rulon-nerzhaveyushchiy/', label: 'Рулон' },
	{ href: '/polosa-nerzhaveyushchaya/', label: 'Полоса' },
	{ href: '/provoloka-nerzhaveyushchaya/', label: 'Проволока' },
	{ href: '/ugolok-shveller-nerzhaveyushchiy/', label: 'Уголок / швеллер' },
	{ href: '/detali-truboprovoda/', label: 'Детали трубопровода' },
];
---

<BaseLayout title={title} description={description} jsonLd={[faqJsonLd, howToJsonLd]}>
	<div class="container calc">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Калькулятор веса' }]} />

		<header class="calc__hero">
			<span class="calc__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<rect x="2" y="2" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.4" />
					<path d="M5 6h6M5 9h2M9 9h2M5 12h2M9 12h2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
				</svg>
				Инструмент
			</span>
			<h1 class="calc__h1">Калькулятор веса <span class="calc__h1-accent">нержавеющего металлопроката</span></h1>
			<p class="calc__lead">
				Считает вес листа, трубы, круга, проволоки, полосы, уголка и других видов нержавейки
				по размерам и марке стали. Плотность подставляется автоматически — от 7,7 до 7,9 г/см³.
				Удельный вес нержавеющей стали в расчётах — это та же плотность, выраженная в килограммах на кубический метр.
			</p>
			<ul class="calc__perks">
				<li><strong>9</strong> видов проката</li>
				<li><strong>4</strong> группы марок + своя плотность</li>
				<li><strong>1 сек</strong> от ввода до результата</li>
				<li><strong>±0,5%</strong> от теоретического веса ГОСТ</li>
			</ul>
		</header>

		<section class="calc__widget" data-calc-root>
			<div class="calc__widget-glow" aria-hidden="true"></div>

			<div class="calc__widget-inner">
				<div class="calc__form">
					<div class="calc__step">
						<div class="calc__step-num">1</div>
						<div class="calc__step-title">Выберите вид проката</div>
					</div>
					<div class="calc__shapes" role="radiogroup" aria-label="Вид проката">
						{shapes.map((s) => (
							<button
								type="button"
								class={`calc__shape${s.key === 'list' ? ' calc__shape--active' : ''}`}
								data-calc-shape-btn={s.key}
								role="radio"
								aria-checked={s.key === 'list' ? 'true' : 'false'}
							>
								<span class="calc__shape-icon" aria-hidden="true">
									{s.key === 'list' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<path d="M5 22l12-9 14 5v8L19 31 5 26v-4z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
											<path d="M5 22l14 5 12-9" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
										</svg>
									)}
									{s.key === 'truba' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<ellipse cx="18" cy="9" rx="11" ry="3.5" stroke="currentColor" stroke-width="1.7" />
											<path d="M7 9v18a11 3.5 0 0 0 22 0V9" stroke="currentColor" stroke-width="1.7" />
											<ellipse cx="18" cy="27" rx="11" ry="3.5" stroke="currentColor" stroke-width="1.7" />
											<ellipse cx="18" cy="9" rx="6.5" ry="2" stroke="currentColor" stroke-width="1.3" opacity="0.55" />
										</svg>
									)}
									{s.key === 'truba-pryam' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											{/* Изометрическая профильная труба: видим переднюю грань, верхнюю и правую — со стенкой */}
											<path d="M6 12l6-4h17l-6 4H6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
											<path d="M6 12v17l6 4h17V16l-6-4" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
											<path d="M23 16v17l6-4" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
											{/* Внутренний контур — показывает стенку */}
											<path d="M9 14l4-3h13M9 14v14M13 11v18" stroke="currentColor" stroke-width="1.2" opacity="0.6" stroke-linejoin="round" />
										</svg>
									)}
									{s.key === 'krug' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<circle cx="18" cy="18" r="11" stroke="currentColor" stroke-width="1.7" />
											<circle cx="18" cy="18" r="6" stroke="currentColor" stroke-width="1.3" opacity="0.5" />
										</svg>
									)}
									{s.key === 'kvadrat' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<rect x="7" y="7" width="22" height="22" rx="2" stroke="currentColor" stroke-width="1.7" />
											<path d="M7 7l22 22M29 7L7 29" stroke="currentColor" stroke-width="1" opacity="0.35" />
										</svg>
									)}
									{s.key === 'shestigrannik' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<path d="M18 5l11 6.5v13L18 31 7 24.5v-13L18 5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
											<path d="M18 12l5 3v6l-5 3-5-3v-6l5-3z" stroke="currentColor" stroke-width="1.2" opacity="0.5" stroke-linejoin="round" />
										</svg>
									)}
									{s.key === 'polosa' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<rect x="4" y="14" width="28" height="8" rx="1.5" stroke="currentColor" stroke-width="1.7" />
											<path d="M4 18h28" stroke="currentColor" stroke-width="1" opacity="0.35" />
										</svg>
									)}
									{s.key === 'provoloka' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<path d="M4 18c2 -4 5 -4 7 0s4 4 6 0 5 -4 7 0 5 4 8 0" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
											<circle cx="4" cy="18" r="1.2" fill="currentColor" />
											<circle cx="32" cy="18" r="1.2" fill="currentColor" />
										</svg>
									)}
									{s.key === 'ugolok' && (
										<svg width="36" height="36" viewBox="0 0 36 36" fill="none">
											<path d="M8 6h4v22h20v4H8V6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
										</svg>
									)}
								</span>
								<span class="calc__shape-label">{s.label}</span>
							</button>
						))}
					</div>

					<div class="calc__step calc__step--mt">
						<div class="calc__step-num">2</div>
						<div class="calc__step-title">Марка стали</div>
					</div>
					<div class="calc__grades" role="radiogroup" aria-label="Группа марок">
						<button type="button" class="calc__grade calc__grade--active" data-calc-grade-btn="austenitic" data-tone="austenitic" role="radio" aria-checked="true">
							<span class="calc__grade-dot" aria-hidden="true"></span>
							<span class="calc__grade-text">
								<strong>Аустенитные</strong>
								<small>304 · 316L · 321 · 201 — 7,9</small>
							</span>
						</button>
						<button type="button" class="calc__grade" data-calc-grade-btn="ferritic" data-tone="ferritic" role="radio" aria-checked="false">
							<span class="calc__grade-dot" aria-hidden="true"></span>
							<span class="calc__grade-text">
								<strong>Ферритные</strong>
								<small>430 · 410S · 439 — 7,7</small>
							</span>
						</button>
						<button type="button" class="calc__grade" data-calc-grade-btn="martensitic" data-tone="martensitic" role="radio" aria-checked="false">
							<span class="calc__grade-dot" aria-hidden="true"></span>
							<span class="calc__grade-text">
								<strong>Мартенситные</strong>
								<small>420 · 440 · 20Х13 — 7,7</small>
							</span>
						</button>
						<button type="button" class="calc__grade" data-calc-grade-btn="duplex" data-tone="duplex" role="radio" aria-checked="false">
							<span class="calc__grade-dot" aria-hidden="true"></span>
							<span class="calc__grade-text">
								<strong>Дуплекс</strong>
								<small>двухфазные — 7,8</small>
							</span>
						</button>
						<button type="button" class="calc__grade" data-calc-grade-btn="custom" data-tone="custom" role="radio" aria-checked="false">
							<span class="calc__grade-dot" aria-hidden="true"></span>
							<span class="calc__grade-text">
								<strong>Другая</strong>
								<small>ввести плотность</small>
							</span>
						</button>
					</div>

					<div class="calc__field calc__field--inline" data-calc-density-row hidden>
						<label class="calc__label" for="calc-density">Плотность, г/см³</label>
						<input class="calc__input" id="calc-density" type="number" inputmode="decimal" step="0.01" data-calc-density value="7.9" />
					</div>

					<div class="calc__step calc__step--mt">
						<div class="calc__step-num">3</div>
						<div class="calc__step-title">Размеры и количество</div>
					</div>
					<div class="calc__dims" data-calc-dims>
						<!-- поля по виду проката рендерятся JS -->
					</div>

					<div class="calc__field calc__field--qty">
						<label class="calc__label" for="calc-qty">Количество</label>
						<div class="calc__qty-wrap">
							<button type="button" class="calc__qty-step" data-calc-qty-minus aria-label="Меньше">−</button>
							<input class="calc__input calc__qty-input" id="calc-qty" type="number" inputmode="decimal" step="any" data-calc-qty value="1" min="0.01" />
							<button type="button" class="calc__qty-step" data-calc-qty-plus aria-label="Больше">+</button>
							<span class="calc__qty-unit" data-calc-qty-hint>шт</span>
						</div>
					</div>

					<div class="calc__field calc__field--mass">
						<label class="calc__label" for="calc-mass">Или нужная масса</label>
						<div class="calc__mass-wrap">
							<input class="calc__input calc__mass-input" id="calc-mass" type="number" inputmode="decimal" step="any" data-calc-mass min="0" placeholder="—" />
							<select class="calc__mass-unit-sel" data-calc-mass-unit aria-label="Единицы массы">
								<option value="t" selected>т</option>
								<option value="kg">кг</option>
							</select>
						</div>
						<p class="calc__mass-hint">Введите нужную массу — пересчитаем, сколько <span data-calc-mass-hint-unit>штук</span> взять</p>
					</div>
				</div>

				<aside class="calc__result" data-calc-result>
					<div class="calc__result-card">
						<div class="calc__result-schema" aria-hidden="true">
							<svg width="0" height="0" style="position:absolute" aria-hidden="true">
								<defs>
									<pattern id="cvHatch" patternUnits="userSpaceOnUse" width="6" height="6" patternTransform="rotate(45)">
										<line x1="0" y1="0" x2="0" y2="6" stroke="rgba(255,255,255,0.32)" stroke-width="1" />
									</pattern>
									<marker id="cvArr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
										<path d="M0 0 L10 5 L0 10 z" fill="var(--color-accent-100)" />
									</marker>
								</defs>
							</svg>

							{/* 1. Лист — диметрия параллелепипеда: длина L, ширина B, толщина t. */}
							<svg class="calc__schema-svg is-active" data-shape-svg="list" viewBox="0 0 300 180" fill="none">
								<polygon points="50,130 50,118 220,118 220,130" fill="url(#cvHatch)" stroke="rgba(255,255,255,0.92)" stroke-width="1.6" stroke-linejoin="round" />
								<polygon points="50,118 90,90 260,90 220,118" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.92)" stroke-width="1.6" stroke-linejoin="round" />
								<polygon points="220,118 260,90 260,102 220,130" fill="url(#cvHatch)" stroke="rgba(255,255,255,0.92)" stroke-width="1.6" stroke-linejoin="round" />
								<line x1="50" y1="150" x2="220" y2="150" stroke="var(--color-accent-100)" stroke-width="1.2" marker-start="url(#cvArr)" marker-end="url(#cvArr)" />
								<text x="135" y="166" fill="var(--color-accent-100)" font-family="Inter,sans-serif" font-size="13" text-anchor="middle" font-weight="600">L — длина</text>
								<line x1="232" y1="138" x2="272" y2="110" stroke="var(--color-accent-100)" stroke-width="1.2" marker-start="url(#cvArr)" marker-end="url(#cvArr)" />
								<text x="280" y="108" fill="var(--color-accent-100)" font-family="Inter,sans-serif" font-size="13" font-weight="600">B</text>
