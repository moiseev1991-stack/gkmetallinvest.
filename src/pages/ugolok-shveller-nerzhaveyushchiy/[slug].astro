---
import ProductDetail from '../../components/ProductDetail.astro';
import MarkLanding from '../../components/MarkLanding.astro';
import pricelist from '../../data/pricelist.json';
import { marks } from '../../data/marks.ts';

export async function getStaticPaths() {
	const skus = (pricelist.hubs as any)['ugolok-shveller'] as any[];
	const productPaths = skus.map((sku) => ({
		params: { slug: sku.slug },
		props: { kind: 'product', sku },
	}));

	const markPaths = marks
		.filter((m) => m.hubs.includes('ugolok-shveller'))
		.map((m) => ({ params: { slug: m.slug }, props: { kind: 'mark', mark: m } }));

	return [...markPaths, ...productPaths];
}

const props = Astro.props as any;
---

{props.kind === 'mark' ? (
	<MarkLanding
		mark={props.mark}
		hub="ugolok-shveller"
		hubLabel="Уголок и швеллер нержавеющий"
		hubLabelGenitive="уголок и швеллер нержавеющие"
		hubHref="/ugolok-shveller-nerzhaveyushchiy/"
		measure="размер"
	/>
) : (
	<ProductDetail
		sku={props.sku}
		hubLabel="Уголок / Швеллер нержавеющий"
		hubHref="/ugolok-shveller-nerzhaveyushchiy/"
		measureLabel="размер"
	/>
)}
