---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import HubExtras from '../../components/HubExtras.astro';
import PriceTable from '../../components/PriceTable.astro';
import pricelist from '../../data/pricelist.json';

const skus = (pricelist.hubs as any).rulon as any[];
const grades = [...new Set(skus.map((s) => s.grade).filter(Boolean))] as string[];
grades.sort((a, b) => String(a).localeCompare(String(b), 'ru'));
const surfaces = [...new Set(skus.map((s) => s.surface).filter(Boolean))] as string[];
surfaces.sort((a, b) => String(a).localeCompare(String(b), 'ru'));

const prices = skus.map((s) => Number(s.price)).filter((p) => p > 0);
const productJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: 'Рулон нержавеющий',
	description: 'Рулонная нержавеющая сталь AISI 430, 304, 201, 321, 316L, 409L толщиной 0,4–6 мм, ширина 1000–1500 мм. Цена указана за тонну.',
	category: 'Рулонная нержавеющая сталь',
	url: 'https://gkmetallinvest.ru/rulon-nerzhaveyushchiy/',
	offers: {
		'@type': 'AggregateOffer',
		priceCurrency: 'RUB',
		lowPrice: Math.min(...prices),
		highPrice: Math.max(...prices),
		offerCount: prices.length,
	},
};

const faq = [
	{
		q: 'Что выгоднее — рулон или готовый лист?',
		a: 'Рулон выгоден, если вы сами режете металл (гильотина, плазма, штамповка) или вам нужна лента и полосы нужной ширины. Если нужны несколько листов в размер — берите лист или закажите резку из рулона. Цену за тонну сравнивайте в прайсе: она зависит от марки, толщины и поверхности.',
	},
	{
		q: 'Какие ширины рулона есть в каталоге?',
		a: 'В каталоге ширины 1000, 1250 и 1500 мм, у отдельных позиций — 1219 и 1240 мм. Внутренний диаметр и массу рулона уточняйте у менеджера: по ГОСТ 19904-90 внутренний диаметр рулона 500–1000 мм, масса 1,5–20 т.',
	},
	{
		q: 'Можно ли заказать резку рулона в лист или штрипс?',
		a: 'Да, это услуга «Резка рулонов». Продольная резка в ленту — толщина до 4 мм, шаг ширины 5 мм; поперечная резка в лист — до 12 м длиной, точность ±1 мм. Партия от 500 кг, свыше 4 мм не режем.',
	},
	{
		q: 'Что такое 2B, BA, 4N для рулона?',
		a: '2B — стандартная матовая поверхность холоднокатаного рулона. BA — зеркально-полированная после отжига в защитной атмосфере. 4N — направленный сатин шлифовкой. Для архитектурных и интерьерных задач выбирают BA или 4N; наличие защитной плёнки уточняйте при заказе.',
	},
	{
		q: 'Какие сертификаты выдаются на рулон?',
		a: 'Сертификат завода-изготовителя (вид 3.1 по ГОСТ 7566-2018) с номером плавки и рулона. Стандарт, по которому изготовлен рулон, указан в сертификате.',
	},
	{
		q: 'Как купить нержавеющую сталь в рулоне?',
		a: 'Выберите в прайсе марку, толщину, ширину и поверхность, укажите объём в тоннах и город доставки и отправьте заявку. Менеджер подтвердит позицию и пришлёт предложение с сертификатом завода-изготовителя (вид 3.1 по ГОСТ 7566-2018). Если нужны лист или лента, резку из рулона можно заказать вместе с покупкой.',
	},
	{
		q: 'Чем рулон нержавейки отличается от ленты?',
		a: 'Размером и стандартом. Лента — холоднокатаный прокат по ГОСТ 4986-79 толщиной 0,05–2,0 мм и шириной 6–410 мм. Рулон — широкий прокат: по ГОСТ 19904-90 ширина от 500 мм, толщина 0,35–3,5 мм. Узкую ленту из рулона получают продольной резкой.',
	},
];
---

<CatalogHubTemplate
	title="Рулон нержавеющий: купить, цена за тонну, AISI 430, 304, 201"
	description="Рулон нержавеющий 0,4–6 мм, ширина 1000–1500 мм: AISI 430, 304, 201, 321, 316L, 409L. Цена за тонну, продольная и поперечная резка, доставка по России."
	h1="Рулон нержавеющий"
	intro="Рулонная нержавеющая сталь (рулон нержавейки) толщиной 0,4–6 мм, ширина 1000, 1250 и 1500 мм. Рулон нужен для собственного раскроя в лист и ленту, штамповки и гибки. В каталоге AISI 430, 304/304L, 201, 321, 316L, 409L и другие марки, поверхности 2B, BA, 4N, No1. Резку рулонов в лист и ленту выполняем по заявке."
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Рулон нержавеющий' }]}
	hubHref="/rulon-nerzhaveyushchiy/"
	hubLabel="Рулон нержавеющий"
	hubKey="rulon"
	faq={faq}
	extraJsonLd={productJsonLd}
>
	<PriceTable hub="rulon" title="Прайс на рулон нержавеющий" measure="толщина" />

	<HubExtras
		hubHref="/rulon-nerzhaveyushchiy/"
		hubLabel="Рулон нержавеющий"
		hubLabelGenitive="рулон нержавеющий"
		articles={[
			{ href: '/blog/rulon-nerzhaveyushchiy/', label: 'Рулон нержавеющий: ширины, толщины, ГОСТ, вес и резка' },
			{ href: '/blog/list-nerzhaveyushchiy-4-5-6-8-10-mm/', label: 'Лист нержавеющий 4–10 мм: размеры, вес, ГОСТ, резка' },
			{ href: '/blog/list-nerzhaveyushchiy-1-2-3-mm/', label: 'Лист нержавеющий 1, 2 и 3 мм: размеры, вес, марки' },
			{ href: '/blog/poverhnosti-nerzhaveyushchego-lista/', label: 'Поверхности: 2B, BA, 4N, 8K, HL' },
			{ href: '/blog/aisi-304-vs-316l-vs-321/', label: 'AISI 304, 316L или 321: какую марку выбрать' },
			{ href: '/blog/ves-nerzhaveyushchego-lista-tablica/', label: 'Вес листа нержавейки: таблица по толщине и формату' },
			{ href: '/blog/stal-08h18n10/', label: 'Сталь 08Х18Н10 (AISI 304): ГОСТ, состав, аналоги' },
		]}
		grades={grades}
		surfaces={surfaces}
	/>

	<section class="block">
		<h2>Размеры рулона: ширина, толщина, масса</h2>
		<p>
			В каталоге рулоны толщиной 0,4–6 мм и шириной 1000, 1250, 1500 мм. Холоднокатаный рулон
			поставляется по ГОСТ 19904-90 (толщина 0,35–3,5 мм), горячекатаный — по ГОСТ 19903. Узкие ленты
			и полосы нужной ширины получают продольной резкой рулона.
		</p>
		<ul class="list-plain">
			<li><strong>Внутренний диаметр и масса рулона</strong> — уточняйте у менеджера (по ГОСТ 19904-90: 500–1000 мм и 1,5–20 т)</li>
			<li><strong>Поверхности</strong> — 2B матовая, BA зеркальная, 4N шлифованная сатиновая</li>
			<li><strong>Защитная плёнка</strong> — уточняйте при заказе</li>
			<li><strong>Марки</strong> — AISI 430, 304/304L, 201/202, 321, 316L, 310S, 409L, 439, 444</li>
		</ul>
	</section>

	<section class="block">
		<h2>Рулон или лист: что выгоднее</h2>
		<ul class="list-plain">
			<li><strong>Раскрой в большом количестве.</strong> Заготовка штампуется из рулона без остановок на смену листа.</li>
			<li><strong>Нестандартная длина.</strong> Лист режут в любую длину, а не только в стандартные 2000, 2500 и 3000 мм.</li>
			<li><strong>Продольная резка.</strong> Из широкого рулона получают ленты и полосы нужной ширины.</li>
			<li><strong>Покупка на тонны.</strong> Цена в прайсе указана в рублях за тонну, на больших партиях это удобнее, чем считать листы.</li>
		</ul>
		<p>
			Нужно несколько листов стандартного формата? Берите готовый <a href="/list-nerzhaveyushchiy/">лист нержавеющий</a>.
			Массу листов и рулона считает <a href="/blog/ves-nerzhaveyushchego-lista-tablica/">таблица веса листа</a> и
			<a href="/kalkulyator-rulona/">калькулятор рулона</a>.
		</p>
	</section>

	<section class="block">
		<h2>ГОСТ на нержавеющий рулон</h2>
		<p>
			Размеры холоднокатаного рулона задаёт <a href="/gost/19904-90/">ГОСТ 19904-90</a> (ширина от 500 мм, толщина 0,35–3,5 мм,
			масса рулона 1,5–20 т), горячекатаного — <a href="/gost/19903-2015/">ГОСТ 19903-2015</a>. Марки и состав — в
			<a href="/gost/5632-2014/">ГОСТ 5632-2014</a>. Какой стандарт нужен для листа, ленты, трубы и круга, и что чем заменено,
			собрано в статье <a href="/blog/gost-na-nerzhaveyushchuyu-stal/">ГОСТ на нержавеющую сталь</a>.
		</p>
	</section>

	<section class="block">
		<h2>Как купить рулон нержавеющий: что указать в заявке</h2>
		<ul class="list-plain">
			<li><strong>Марка:</strong> AISI 304 или 08Х18Н10, 430, 201, 321 и другие. Российские аналоги — в статье <a href="/blog/analogi-marok-nerzhaveyki/">аналоги марок</a></li>
			<li><strong>Размер:</strong> толщина и ширина, при нестандартном размере допуск</li>
			<li><strong>Поверхность и плёнка:</strong> 2B, BA, 4N, No1, нужна ли защитная плёнка</li>
			<li><strong>Стандарт:</strong> ГОСТ 19904-90 или 19903-2015 и класс точности по толщине</li>
			<li><strong>Объём и доставка:</strong> тонны, нужна ли резка, город доставки</li>
		</ul>
		<p>Полный разбор рулона — в статье <a href="/blog/rulon-nerzhaveyushchiy/">рулон нержавеющий: ширины, толщины, ГОСТ, вес и резка</a>.</p>
	</section>

	<section class="block">
		<h2>Резка из рулона</h2>
		<p>
			Из рулона мы делаем <a href="/uslugi/rezka-rulonov/">резку в лист</a>
			(длина до 12 м) и <a href="/lenta-nerzhaveyushchaya/proizvodstvo/">продольную резку в ленту</a> с шагом ширины 5 мм (толщина до 4 мм).
		</p>
	</section>

	<section class="block">
		<h2>Применение рулона нержавеющего</h2>
		<p>
			Нержавейка в рулонах — исходное сырьё для штамповочных и гибочных линий: мойки,
			бытовая техника, кухонные плиты, корпуса посуды. Продольная резка даёт ленту нужной ширины с шагом 5 мм. Поперечная резка переводит рулонную нержавеющую сталь
			в лист — корпуса оборудования, фасады, облицовка. Тонкие толщины 0,4–0,6 мм идут
			на сэндвич-панели и кровельные доборы; 1–3 мм — на ёмкости, посуду и
			архитектурные элементы.
		</p>
	</section>

	<section class="block">
		<h2>Документы и поставка</h2>
		<ul class="list-plain">
			<li>Сертификат завода-изготовителя (вид 3.1 по ГОСТ 7566-2018)</li>
			<li>Защитная плёнка — уточняйте при заказе</li>
			<li>Склад и срок отгрузки указаны по каждой позиции в прайсе</li>
			<li>Доставка автотранспортом и ж/д контейнерами</li>
		</ul>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.list-plain {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
	.list-plain strong { color: var(--color-text); }
	.block p { max-width: 70ch; color: var(--color-muted); }
	.block p a { color: var(--color-primary-600); }
</style>
