---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import ArmaturaLineCards from '../../components/ArmaturaLineCards.astro';
import HubRequest from '../../components/HubRequest.astro';
import { getArmaturaHub } from '../../data/armatura';

const hub = getArmaturaHub('truboprovodnye-detali')!;
---

<CatalogHubTemplate
	title={hub.title}
	description={hub.description}
	h1={hub.h1}
	intro={hub.intro}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Детали трубопровода' }]}
	faq={hub.faq}
>
	<ArmaturaLineCards hub={hub} />
	<HubRequest what="Детали трубопровода: фланцы, отводы, тройники, переходы, заглушки, крепёж" />
</CatalogHubTemplate>
