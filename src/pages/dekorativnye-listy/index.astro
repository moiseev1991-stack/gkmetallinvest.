---
import CatalogHubTemplate from '../../components/CatalogHubTemplate.astro';
import PriceTable from '../../components/PriceTable.astro';
import { getHubSkus } from '../../data/pricelist-helpers';
import { DEKOR_SURFACE_META, DEKOR_GROUP_LABELS } from '../../data/dekor-listy';

const skus = getHubSkus('dekorativnye-listy');
const totalSkus = skus.length;

/* Свотчи поверхностей для блока ниже (SEO: закрываем оба варианта запроса —
   «DK8» и «нержавейка чёрное зеркало»). CSS-текстуры и тексты — из
   DEKOR_SURFACE_META, группируем по фактуре. */
const dkGroups = Object.entries(DEKOR_GROUP_LABELS)
	.map(([key, label]) => ({
		key,
		label,
		items: Object.entries(DEKOR_SURFACE_META)
			.filter(([, m]) => m.group === key)
			.map(([code, m]) => ({ code, ...m })),
	}))
	.filter((g) => g.items.length > 0);

/* Плоский список всех поверхностей — единая галерея-сетка (без рваных
   секций-строк, где у одиночных групп была одна карточка на всю ширину).
   Тип фактуры выводим тегом на самой карточке. */
const dkItems = dkGroups.flatMap((g) => g.items.map((it) => ({ ...it, groupLabel: g.label })));

const faq = [
	{
		q: 'Что такое декоративный лист из нержавейки и чем он отличается от обычного?',
		a: 'Декоративный лист — это нержавеющая сталь (обычно AISI 304) с особой финишной поверхностью: суперзеркало 8K, чёрное зеркало (Black Mirror), золотое зеркало, шлифовка №4 или узорный рельеф DECO. Применяется в отделке лифтов, касс, интерьеров, рекламных конструкций. От обычного листа отличается обработкой поверхности, а не маркой стали.',
	},
	{
		q: 'Чем зеркало отличается от суперзеркала 8K и Black Mirror?',
		a: 'Зеркало (Mirror) — стандартная зеркальная полировка (её ищите в разделе нержавеющих листов). Суперзеркало 8K — полировка повышенного класса с более глубоким и чистым глянцем. Black Mirror — зеркальная поверхность с чёрным PVD-покрытием, золотое зеркало — с золотым PVD. Цветные покрытия наносятся поверх полировки и не меняют марку стали.',
	},
	{
		q: 'Что такое узорные листы DECO?',
		a: 'DECO — листы с рельефным рисунком (тиснением): DECO 1 «Изморозь», галька, ромбическая сетка, линейные борозды, волновые фактуры 5WL/6WL. Рельеф маскирует отпечатки и царапины, поэтому узорные листы удобны для проходных зон — лифтов, входных групп, стеновых панелей.',
	},
	{
		q: 'В каких форматах поставляются декоративные листы?',
		a: 'Основные форматы — 1219×2438 и 1250×2500 мм; зеркало, 8K и золото также бывают 1500×3000 мм. Толщина 0,5–1,5 мм, марки AISI 304, AISI 316L (для влажных зон и фасадов) и AISI 430. Поставляются с защитной плёнкой для перевозки и монтажа без царапин. Наличие и цену конкретной позиции уточняйте у менеджера.',
	},
];
---

<CatalogHubTemplate
	title="Декоративные листы из нержавеющей стали — 8K, Black Mirror, золото, DECO"
	description="Декоративные нержавеющие листы AISI 304/316L: суперзеркало 8K, чёрное зеркало (Black Mirror), золотое зеркало, шлифовка №4, узорные DECO. Формат 1219×2438 и 1250×2500. Раздел в наполнении — цены и наличие по запросу."
	h1="Декоративные листы из нержавеющей стали"
	intro={`Декоративная нержавейка AISI 304/316L: суперзеркало 8K, чёрное зеркало (Black Mirror), золотое зеркало, шлифовка №4 и узорные листы DECO — для отделки лифтов, касс, интерьеров и фасадов. Обычное зеркало (Mirror/BA) — в разделе нержавеющих листов. Фильтр по поверхности ниже понимает и рыночные коды (8K, DECO 1), и русские названия. Раздел в наполнении — точные цены и наличие уточняйте у менеджера.`}
	breadcrumbs={[{ label: 'Главная', href: '/' }, { label: 'Декоративные листы' }]}
	hubKey="dekorativnye-listy"
	faq={faq}
	noindex
>
	<PriceTable hub="dekorativnye-listy" title="Декоративные листы нержавеющие" measure="толщина" />

	<section class="block dk-surfaces">
		<h2>Поверхности декоративных листов</h2>
		<p>
			Люди ищут декоративную нержавейку по-разному: одни вбивают «8K» или «DECO 1», другие —
			«суперзеркало» или «изморозь». В фильтре и на страницах товаров указываем оба варианта.
			Для узорных листов показаны фото образцов фактуры; 8K, чёрное и золотое зеркало —
			условная CSS-визуализация оттенка.
		</p>
		<ul class="dk-grid">
			{dkItems.map((it) => (
				<li class="dk-card">
					<div class="dk-card__media">
						{it.img
							? <img class="dk-card__swatch" src={it.img} alt={`Фактура ${it.code} — ${it.ru}`} loading="lazy" width="320" height="200" />
							: <span class="dk-card__swatch" style={`background:${it.swatch}`} aria-hidden="true"></span>}
						<span class="dk-card__type">{it.groupLabel}</span>
					</div>
					<div class="dk-card__body">
						<span class="dk-card__code">{it.code}</span>
						<span class="dk-card__ru">{it.ru}</span>
						<span class="dk-card__short">{it.short}</span>
					</div>
				</li>
			))}
		</ul>
		<p class="dk-note">
			Список пополняется. Нужной поверхности нет в таблице — <a href="/zapros-kp/">отправьте заявку</a>,
			подберём под задачу.
		</p>
	</section>
</CatalogHubTemplate>

<style>
	.block { margin-bottom: var(--space-8); }
	.block h2 { font-size: 1.15rem; margin-bottom: var(--space-3); }
	.block p { max-width: 70ch; color: var(--color-muted); }
	.block p a { color: var(--color-primary-600); }

	.dk-grid {
		list-style: none;
		padding: 0;
		margin: var(--space-5) 0 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
		gap: var(--space-4);
	}
	.dk-card {
		display: flex;
		flex-direction: column;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		overflow: hidden;
		transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
	}
	.dk-card:hover {
		border-color: var(--color-primary-200, var(--color-border));
		box-shadow: 0 8px 22px rgba(15, 23, 42, 0.1);
		transform: translateY(-2px);
	}
	.dk-card__media {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}
	.dk-card__swatch {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
	}
	.dk-card__type {
		position: absolute;
		top: 8px;
		left: 8px;
		font-size: 0.66rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: #fff;
		background: rgba(15, 23, 42, 0.6);
		-webkit-backdrop-filter: blur(2px);
		backdrop-filter: blur(2px);
		padding: 0.2rem 0.5rem;
		border-radius: 999px;
		line-height: 1.2;
	}
	.dk-card__body {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: var(--space-3);
		min-width: 0;
	}
	.dk-card__code {
		font-family: var(--font-mono);
		font-weight: 700;
		color: var(--color-text);
		line-height: 1.2;
	}
	.dk-card__ru { font-size: 0.9rem; color: var(--color-text); }
	.dk-card__short {
		margin-top: 0.15rem;
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.35;
	}
	.dk-note { font-size: 0.92rem; margin-top: var(--space-5); }
</style>
