---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';

const title = 'Калькулятор веса рулона нержавейки — по диаметру намотки';
const description =
	'Расчёт массы и длины ленты в рулоне нержавейки по внешнему диаметру D, диаметру шпули d, ' +
	'ширине и толщине. Формула m = π·(D²−d²)·B·ρ/4. AISI 304, 316L, 430.';

const materials = [
	{ value: 'aisi304', label: 'Нержавейка AISI 304 / 08Х18Н10', rho: 7930, applic: 'базовое исполнение — рулонная нержавейка 2B' },
	{ value: 'aisi316l', label: 'Нержавейка AISI 316L', rho: 8000, applic: 'хлориды, химия, морская среда' },
	{ value: 'aisi430', label: 'Нержавейка AISI 430', rho: 7700, applic: 'ферритная, для декора и техники' },
	{ value: 'st3', label: 'Сталь Ст3 / х/к ленточная сталь', rho: 7850, applic: 'оцинкованный рулон, чёрный металл' },
];

const faq = [
	{
		q: 'Как узнать вес рулона нержавейки без весов?',
		a: 'Замерьте штангенциркулем внешний диаметр D рулона по торцу (по внешнему виткy), диаметр шпули d (внутренний диаметр посадки), ширину рулона B и толщину ленты t (или возьмите её из паспорта). Подставьте в формулу m = π·(D²−d²)·B·ρ/4 — где ρ плотность материала. Калькулятор делает то же автоматически. Точность ±2 % от реальной массы — этого достаточно для приёмки и учёта.',
	},
	{
		q: 'Как посчитать длину ленты в рулоне?',
		a: 'L = π·(D²−d²) / (4·t), где D — внешний диаметр рулона, d — диаметр шпули, t — толщина ленты. Все размеры в одних единицах. Например, для рулона D = 1200 мм, d = 508 мм, t = 1,0 мм длина ≈ 928 м. Это упрощение по «архимедовой спирали с шагом t» — в реальности из-за микро-зазоров между витками длина на 0,5–2 % меньше.',
	},
	{
		q: 'Какие стандартные шпули у рулонной нержавейки?',
		a: 'Самые ходовые — 508 мм (20 дюймов, импортные рулоны), 500 мм и 400 мм (отечественные станы). Реже встречаются 350 мм для тонких лент и 600 мм для широких рулонов. На некоторых производствах применяется шпуля 762 мм (30 дюймов). Размер шпули обычно указан в маркировке партии.',
	},
	{
		q: 'Какие типовые ширины и толщины рулонной нержавейки?',
		a: 'Стандартные ширины рулона: 1000, 1250, 1500 мм (соответствуют ширине листа после роспуска). Реже — 500, 600, 800 мм для лент. Толщины: 0,4; 0,5; 0,6; 0,8; 1,0; 1,2; 1,5; 2,0; 2,5; 3,0 мм. Самые ходовые на рынке — 0,5–1,5 мм для пищевого оборудования и архитектуры. Мы делаем продольную резку рулонов нержавейки в размер ленты от 50 мм по ширине.',
	},
	{
		q: 'Точна ли формула для рулона?',
		a: 'Точность ±1–2 % от реальной массы. Расхождение даёт неравномерность намотки, микро-зазоры между витками, прокладка бумаги (для зеркальной нержавейки BA). Для приёмки рулонов на склад этого достаточно — формула стандартно применяется на металлобазах для учёта остатков и при отсутствии паспорта.',
	},
	{
		q: 'По какому ГОСТ выпускают рулонную нержавейку?',
		a: 'Холоднокатаный рулон — ГОСТ 5582-75 (тонколистовой) и ГОСТ 19903-2015 (сортамент). Поверхности 2B (матовая базовая), BA (зеркальная отжиг с яркой поверхностью), 4N (шлифованная). Марки AISI 304, 316L, 321, 430. На отгрузку даётся сертификат по составу, механическим характеристикам и геометрии.',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const howToJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'Как рассчитать вес рулона нержавейки',
	step: [
		{ '@type': 'HowToStep', name: 'Замерить внешний диаметр D', text: 'Штангенциркулем по торцу рулона.' },
		{ '@type': 'HowToStep', name: 'Указать диаметр шпули d', text: 'Типовые 400, 500, 508 мм.' },
		{ '@type': 'HowToStep', name: 'Ввести ширину B и толщину t', text: 'В мм. Толщина — из паспорта или микрометром.' },
		{ '@type': 'HowToStep', name: 'Выбрать материал', text: 'AISI 304, 316L, 430 или Ст3.' },
		{ '@type': 'HowToStep', name: 'Получить результат', text: 'Калькулятор покажет массу рулона и длину намотанной ленты.' },
	],
};
---

<BaseLayout title={title} description={description} jsonLd={[faqJsonLd, howToJsonLd]}>
	<div class="container rul">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Калькулятор веса рулона' }]} />

		<header class="rul__hero">
			<span class="rul__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.4" />
					<circle cx="8" cy="8" r="2.5" stroke="currentColor" stroke-width="1.4" />
				</svg>
				ГОСТ 5582-75
			</span>
			<h1 class="rul__h1">Калькулятор веса <span class="rul__h1-accent">рулона нержавейки</span></h1>
			<p class="rul__lead">
				Расчёт массы и длины ленты в рулоне по внешнему диаметру, шпуле, ширине и толщине.
				Формула m = π·(D² − d²)·B·ρ / 4 для массы, L = π·(D² − d²) / (4·t) для длины.
				Применяется на металлобазах для приёмки рулонов и учёта остатков
				без весов и паспорта.
			</p>
		</header>

		<section class="rul__widget" data-rul-root>
			<div class="rul__widget-inner">
				<div class="rul__form">
					<div class="rul__field">
						<label class="rul__label" for="rul-mat">Материал</label>
						<select class="rul__input" id="rul-mat" data-rul-material>
							{materials.map((m) => (
								<option value={m.value} data-rho={m.rho} selected={m.value === 'aisi304'}>
									{m.label} — ρ {(m.rho / 1000).toLocaleString('ru-RU', { minimumFractionDigits: 2 })} г/см³
								</option>
							))}
						</select>
						<p class="rul__hint" data-rul-mat-hint>{materials[0].applic}</p>
					</div>

					<div class="rul__row-2">
						<div class="rul__field">
							<label class="rul__label" for="rul-D">Внешний диаметр D, мм</label>
							<input class="rul__input" id="rul-D" type="number" inputmode="decimal" step="any" min="0" value="1200" data-rul-D />
							<p class="rul__hint">штангенциркулем по торцу</p>
						</div>
						<div class="rul__field">
							<label class="rul__label" for="rul-d">Шпуля d, мм</label>
							<input class="rul__input" id="rul-d" type="number" inputmode="decimal" step="any" min="0" value="508" data-rul-d />
							<p class="rul__hint">типовые 400 / 500 / 508</p>
						</div>
					</div>

					<div class="rul__row-2">
						<div class="rul__field">
							<label class="rul__label" for="rul-B">Ширина рулона B, мм</label>
							<input class="rul__input" id="rul-B" type="number" inputmode="decimal" step="any" min="0" value="1250" data-rul-B />
							<p class="rul__hint">типовые 1000 / 1250 / 1500</p>
						</div>
						<div class="rul__field">
							<label class="rul__label" for="rul-t">Толщина ленты t, мм</label>
							<input class="rul__input" id="rul-t" type="number" inputmode="decimal" step="any" min="0" value="1.0" data-rul-t />
							<p class="rul__hint">типовые 0,4–3,0 мм</p>
						</div>
					</div>

					<div class="rul__field">
						<label class="rul__label" for="rul-qty">Количество рулонов</label>
						<input class="rul__input" id="rul-qty" type="number" inputmode="numeric" step="1" min="1" value="1" data-rul-qty />
						<p class="rul__hint">для расчёта партии</p>
					</div>
				</div>

				<aside class="rul__result">
					<div class="rul__result-card">
						<div class="rul__result-eyebrow">Расчёт по диаметру намотки</div>

						<div class="rul__result-row">
							<span>Длина ленты</span>
							<strong data-rul-len>—</strong>
						</div>
						<div class="rul__result-row">
							<span>Витков ≈</span>
							<strong data-rul-vit>—</strong>
						</div>

						<div class="rul__result-total">
							<span class="rul__result-total-label">Масса 1 рулона</span>
							<div class="rul__result-total-value" data-rul-mass>—</div>
							<div class="rul__result-total-sub" data-rul-mass-sub></div>
						</div>

						<dl class="rul__result-meta">
							<div><dt>Площадь развёртки</dt><dd data-rul-area>—</dd></div>
							<div><dt>Масса партии</dt><dd data-rul-total>—</dd></div>
						</dl>

						<a class="rul__cta" href="/zapros-kp/?material=rulon-nerzh#lead-form">
							<span>Запросить КП на рулон</span>
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>

						<p class="rul__result-foot">
							Точность ±1–2 % за счёт неравномерности намотки и микро-зазоров.
						</p>
					</div>
				</aside>
			</div>
		</section>

		<section class="rul__block">
			<h2 class="rul__h2">Геометрия рулона</h2>
			<div class="rul__infographic">
				<svg viewBox="0 0 320 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Схема рулона: торец с диаметром D, шпуля d, ширина B">
					<defs>
						<pattern id="rulHatch" x="0" y="0" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
							<line x1="0" y1="0" x2="0" y2="9" stroke="var(--color-primary)" stroke-width="0.7" opacity="0.3" />
						</pattern>
					</defs>

					<circle cx="100" cy="110" r="80" fill="url(#rulHatch)" stroke="var(--color-primary)" stroke-width="2.4" />
					<circle cx="100" cy="110" r="30" fill="#ffffff" stroke="var(--color-primary)" stroke-width="2" />

					<g stroke="var(--color-primary)" stroke-width="0.4" opacity="0.4" fill="none">
						<circle cx="100" cy="110" r="40" />
						<circle cx="100" cy="110" r="50" />
						<circle cx="100" cy="110" r="60" />
						<circle cx="100" cy="110" r="70" />
					</g>

					<line x1="20" y1="110" x2="180" y2="110" stroke="var(--color-subtle)" stroke-width="0.7" stroke-dasharray="6 2 1 2" />
					<line x1="100" y1="30" x2="100" y2="190" stroke="var(--color-subtle)" stroke-width="0.7" stroke-dasharray="6 2 1 2" />

					<g stroke="var(--color-accent)" stroke-width="1.3" fill="none" stroke-linecap="round">
						<line x1="20" y1="205" x2="180" y2="205" />
					</g>
					<polygon points="20,205 30,201 30,209" fill="var(--color-accent)" />
					<polygon points="180,205 170,201 170,209" fill="var(--color-accent)" />
					<text x="100" y="220" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="var(--color-accent)">D</text>

					<text x="100" y="115" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="var(--color-primary)">d</text>

					<g transform="translate(220, 50)">
						<rect x="0" y="0" width="50" height="120" fill="url(#rulHatch)" stroke="var(--color-primary)" stroke-width="2" />
						<rect x="0" y="50" width="50" height="20" fill="#ffffff" stroke="var(--color-primary)" stroke-width="1.4" />

						<g stroke="var(--color-accent)" stroke-width="1.2" fill="none" stroke-linecap="round">
							<line x1="-10" y1="0" x2="-10" y2="120" />
						</g>
						<polygon points="-10,0 -14,10 -6,10" fill="var(--color-accent)" />
						<polygon points="-10,120 -14,110 -6,110" fill="var(--color-accent)" />
						<text x="-20" y="64" text-anchor="middle" font-family="Inter, sans-serif" font-size="13" font-weight="600" fill="var(--color-accent)">B</text>
						<text x="25" y="183" text-anchor="middle" font-family="Inter, sans-serif" font-size="9" fill="var(--color-muted)" font-style="italic">вид сбоку</text>
					</g>

					<text x="312" y="14" text-anchor="end" font-family="Inter, sans-serif" font-size="10" fill="var(--color-muted)" font-style="italic">ГОСТ 5582-75</text>
				</svg>

				<div class="rul__infographic-legend">
					<h3>Обозначения</h3>
					<ul>
						<li><strong>D</strong> — внешний диаметр рулона (по последнему витку)</li>
						<li><strong>d</strong> — диаметр шпули (внутренний посадочный)</li>
						<li><strong>B</strong> — ширина рулона</li>
						<li><strong>t</strong> — толщина ленты (из паспорта или микрометром)</li>
					</ul>
					<p class="rul__infographic-note">
						<strong>Масса:</strong> m = π·(D² − d²)·B·ρ / 4 × 10⁻⁹ кг<br />
						<strong>Длина:</strong> L = π·(D² − d²) / (4·t) мм<br />
						<strong>Витков:</strong> N ≈ (D − d) / (2·t)
					</p>
				</div>
			</div>
		</section>

		<section class="rul__block">
			<h2 class="rul__h2">Контрольные примеры расчёта</h2>
			<div class="rul__table-wrap">
				<table class="rul__table">
					<thead>
						<tr>
							<th>D / d / B / t, мм</th>
							<th>Материал</th>
							<th>Масса, кг</th>
							<th>Длина ленты, м</th>
							<th>Витков</th>
						</tr>
					</thead>
					<tbody>
						<tr><td>1200 / 508 / 1250 / 1,0</td><td>AISI 304</td><td>9 203 (≈ 9,2 т)</td><td>928</td><td>346</td></tr>
						<tr><td>800 / 400 / 1000 / 0,5</td><td>AISI 304</td><td>2 990 (≈ 3,0 т)</td><td>754</td><td>400</td></tr>
						<tr><td>1500 / 508 / 1250 / 2,0</td><td>AISI 316L</td><td>15 645 (≈ 15,6 т)</td><td>782</td><td>248</td></tr>
						<tr><td>900 / 500 / 1500 / 0,8</td><td>AISI 304</td><td>5 196 (≈ 5,2 т)</td><td>687</td><td>250</td></tr>
					</tbody>
				</table>
			</div>
		</section>

		<section class="rul__block">
			<h2 class="rul__h2">Связанное</h2>
			<ul class="rul__related">
				<li>
					<a href="/rulon/">
						<strong>Рулон нержавеющий — каталог</strong>
						<small>0,4–8 мм, ширина 500–1500, AISI 304/321/430</small>
					</a>
				</li>
				<li>
					<a href="/lenta-nerzhaveyushchaya/">
						<strong>Лента нержавеющая</strong>
						<small>штрипс из рулона, по запросу</small>
					</a>
				</li>
				<li>
					<a href="/uslugi/rezka-rulonov/">
						<strong>Резка рулонов</strong>
						<small>продольная резка в ленту от 50 мм по ширине</small>
					</a>
				</li>
				<li>
					<a href="/kalkulyator-vesa/">
						<strong>Универсальный калькулятор веса</strong>
						<small>9 видов проката</small>
					</a>
				</li>
			</ul>
		</section>

		<section class="rul__faq">
			<h2 class="rul__h2">Частые вопросы</h2>
			<div class="rul__faq-list">
				{faq.map((f) => (
					<details class="rul__faq-item">
						<summary class="rul__faq-q">
							<span>{f.q}</span>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</section>
	</div>

	<CtaSection
		title="Нужен рулон нержавейки?"
		text="Рулоны нержавеющие AISI 304, 321, 316L, 430 со склада. Толщины 0,4–8 мм, ширина 500–1500. Продольная резка в ленту от 50 мм. Доставка автотранспортом и ТК по РФ."
	/>
</BaseLayout>

<script>
	const root = document.querySelector('[data-rul-root]');
	if (root) {
		const matSel = root.querySelector('[data-rul-material]') as HTMLSelectElement;
		const matHint = root.querySelector('[data-rul-mat-hint]') as HTMLElement;
		const DInp = root.querySelector('[data-rul-D]') as HTMLInputElement;
		const dInp = root.querySelector('[data-rul-d]') as HTMLInputElement;
		const BInp = root.querySelector('[data-rul-B]') as HTMLInputElement;
		const tInp = root.querySelector('[data-rul-t]') as HTMLInputElement;
		const qtyInp = root.querySelector('[data-rul-qty]') as HTMLInputElement;

		const lenEl = root.querySelector('[data-rul-len]') as HTMLElement;
		const vitEl = root.querySelector('[data-rul-vit]') as HTMLElement;
		const massEl = root.querySelector('[data-rul-mass]') as HTMLElement;
		const massSubEl = root.querySelector('[data-rul-mass-sub]') as HTMLElement;
		const areaEl = root.querySelector('[data-rul-area]') as HTMLElement;
		const totalEl = root.querySelector('[data-rul-total]') as HTMLElement;

		const MAT_HINTS: Record<string, string> = {
			aisi304: 'базовое исполнение — рулонная нержавейка 2B',
			aisi316l: 'хлориды, химия, морская среда',
			aisi430: 'ферритная, для декора и техники',
			st3: 'оцинкованный рулон, чёрный металл',
		};

		const fmt = new Intl.NumberFormat('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 3 });
		const fmt0 = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 0 });
		const fmt1 = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 });

		function recalc() {
			const D = parseFloat(DInp.value) || 0;
			const d = parseFloat(dInp.value) || 0;
			const B = parseFloat(BInp.value) || 0;
			const t = parseFloat(tInp.value) || 0;
			const qty = parseFloat(qtyInp.value) || 0;
			const matOpt = matSel.selectedOptions[0];
			const rho = parseFloat(matOpt?.dataset.rho || '7930') || 7930;

			let mass = 0;
			let lenM = 0;
			let vit = 0;
			let area = 0;

			if (D > d && d > 0 && B > 0) {
				const ringArea = Math.PI * (D * D - d * d) / 4; // мм²
				const volume = ringArea * B; // мм³
				mass = volume * rho / 1e9; // кг
				if (t > 0) {
					lenM = ringArea / t / 1000; // м
					vit = (D - d) / (2 * t);
					area = lenM * B / 1000; // м² развёртки
				}
			}

			const total = mass * qty;

			lenEl.textContent = lenM > 0 ? `${fmt1.format(lenM)} м` : '—';
			vitEl.textContent = vit > 0 ? `${fmt0.format(vit)} шт` : '—';

			if (mass > 0) {
				if (mass >= 1000) {
					massEl.textContent = `${fmt.format(mass / 1000)} т`;
					massSubEl.textContent = `${fmt0.format(mass)} кг`;
				} else {
					massEl.textContent = `${fmt.format(mass)} кг`;
					massSubEl.textContent = '';
				}
			} else {
				massEl.textContent = '—';
				massSubEl.textContent = '';
			}

			areaEl.textContent = area > 0 ? `${fmt1.format(area)} м²` : '—';
			totalEl.textContent = total > 0
				? (total >= 1000 ? `${fmt.format(total / 1000)} т` : `${fmt.format(total)} кг`)
				: '—';
		}

		matSel.addEventListener('change', () => {
			matHint.textContent = MAT_HINTS[matSel.value] || '';
			recalc();
		});
		[DInp, dInp, BInp, tInp, qtyInp].forEach((el) => el.addEventListener('input', recalc));

		recalc();
	}
</script>

