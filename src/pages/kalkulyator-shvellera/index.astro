---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';

const title = 'Калькулятор веса швеллера — ГОСТ 8240-97, стальной и нержавеющий';
const description =
	'Расчёт массы швеллера по номеру профиля и длине. Таблица веса 1 м швеллера 5П…40П ' +
	'по ГОСТ 8240-97. Расчёт стального и нержавеющего швеллера, обратный пересчёт от массы.';

/* ГОСТ 8240-97 — теоретическая масса 1 м швеллера горячекатаного.
   П — с параллельными гранями полок, У — с уклоном внутренних граней полок.
   П и У одного номера имеют одинаковую массу. h — высота, b — ширина полки,
   tw — толщина стенки, tf — средняя толщина полки. */
const shvellerRows = [
	{ num: '5П',   m1: 4.84,  h: 50,  b: 32,  tw: 4.4,  tf: 7.0  },
	{ num: '6.5П', m1: 5.90,  h: 65,  b: 36,  tw: 4.4,  tf: 7.2  },
	{ num: '8П',   m1: 7.05,  h: 80,  b: 40,  tw: 4.5,  tf: 7.4  },
	{ num: '10П',  m1: 8.59,  h: 100, b: 46,  tw: 4.5,  tf: 7.6  },
	{ num: '12П',  m1: 10.40, h: 120, b: 52,  tw: 4.8,  tf: 7.8  },
	{ num: '14П',  m1: 12.30, h: 140, b: 58,  tw: 4.9,  tf: 8.1  },
	{ num: '16П',  m1: 14.20, h: 160, b: 64,  tw: 5.0,  tf: 8.4  },
	{ num: '16аП', m1: 15.30, h: 160, b: 68,  tw: 5.0,  tf: 9.0  },
	{ num: '18П',  m1: 16.30, h: 180, b: 70,  tw: 5.1,  tf: 8.7  },
	{ num: '18аП', m1: 17.40, h: 180, b: 74,  tw: 5.1,  tf: 9.3  },
	{ num: '20П',  m1: 18.40, h: 200, b: 76,  tw: 5.2,  tf: 9.0  },
	{ num: '22П',  m1: 21.00, h: 220, b: 82,  tw: 5.4,  tf: 9.5  },
	{ num: '24П',  m1: 24.00, h: 240, b: 90,  tw: 5.6,  tf: 10.0 },
	{ num: '27П',  m1: 27.70, h: 270, b: 95,  tw: 6.0,  tf: 10.5 },
	{ num: '30П',  m1: 31.80, h: 300, b: 100, tw: 6.5,  tf: 11.0 },
	{ num: '33П',  m1: 36.50, h: 330, b: 105, tw: 7.0,  tf: 11.7 },
	{ num: '36П',  m1: 41.90, h: 360, b: 110, tw: 7.5,  tf: 12.6 },
	{ num: '40П',  m1: 48.30, h: 400, b: 115, tw: 8.0,  tf: 13.5 },
];

const materials = [
	{ value: 'st3',     label: 'Сталь Ст3 / 09Г2С',           rho: 7850, gost: 'ГОСТ 535-2005', applic: 'строительный швеллер общего назначения' },
	{ value: 'aisi304', label: 'Нержавейка AISI 304 / 08Х18Н10', rho: 7900, gost: 'ГОСТ 5949-2018', applic: 'пищевая, химическая, фармацевтическая промышленность' },
	{ value: 'aisi316l', label: 'Нержавейка AISI 316L / 03Х17Н14М2', rho: 7900, gost: 'ГОСТ 5949-2018', applic: 'агрессивные среды, морская вода, хлориды' },
	{ value: 'aisi430', label: 'Нержавейка AISI 430 / 08Х17',    rho: 7700, gost: 'ГОСТ 5632-2014', applic: 'ферритная — пищевое и бытовое оборудование' },
];

const faq = [
	{
		q: 'Чем отличается швеллер П от У?',
		a: 'П — с параллельными гранями полок (внутренняя и наружная плоскости полки параллельны). У — с уклоном внутренних граней полок 4–10 %. Профиль П удобнее для болтовых соединений и сварки, У — традиционный горячекатаный профиль. По массе одного номера П и У идентичны: 10П = 10У = 8,59 кг/м. По нагрузочной способности профиль П немного жёстче из-за большего момента инерции.',
	},
	{
		q: 'Сколько весит 1 метр швеллера 10П?',
		a: 'Один метр швеллера 10П весит 8,59 кг по ГОСТ 8240-97. То же — для 10У. В практике строители округляют до 8,6 кг/м. Высота h = 100 мм, ширина полки b = 46 мм, толщина стенки tw = 4,5 мм, средняя толщина полки tf = 7,6 мм.',
	},
	{
		q: 'Какие размеры швеллера выпускаются по ГОСТ?',
		a: 'Стандартный ряд от 5 до 40 — номер равен высоте профиля в сантиметрах. 5, 6.5, 8, 10, 12, 14, 16, 16а, 18, 18а, 20, 22, 24, 27, 30, 33, 36, 40. Литерой «а» обозначены усиленные варианты (увеличенная ширина полки). По специальному заказу выпускаются 45, 50, 60.',
	},
	{
		q: 'Какая плотность у нержавеющего швеллера?',
		a: 'Аустенитный нержавеющий швеллер (AISI 304, 316L, 321, 12Х18Н10Т) — 7,9 г/см³. Ферритный (AISI 430) — 7,7 г/см³. Углеродистая сталь Ст3 / 09Г2С — 7,85 г/см³. В калькуляторе плотность подставляется автоматически при выборе материала. Разница в массе нержавеющего и стального швеллера одного номера — менее 1 %.',
	},
	{
		q: 'Как рассчитать вес швеллера, которого нет в ГОСТ-таблице?',
		a: 'Для гнутого или нестандартного швеллера используйте универсальный калькулятор веса проката с режимом «уголок» или формулу: A = h × tw + 2 × (b − tw) × tf, m₁ = A × ρ / 10⁶. Где h — высота профиля, b — ширина полки, tw — толщина стенки, tf — толщина полки (всё в мм), ρ — плотность (кг/м³). Формула без учёта галтелей, расхождение с ГОСТ-таблицей до 3 %.',
	},
	{
		q: 'Можно ли заказать нержавеющий швеллер по ГОСТ-сортаменту?',
		a: 'Да. Нержавеющий швеллер выпускается по ГОСТ 5949-2018 (сортовой нержавеющий прокат) с теми же типоразмерами, что и углеродистый по ГОСТ 8240-97. Чаще встречается в виде гнутого профиля (формованного из листа) — он легче катаного, точнее по размерам и доступен в коротких партиях. В нашем каталоге — раздел «Уголок и швеллер».',
	},
	{
		q: 'Сколько метров швеллера 10П в одной тонне?',
		a: 'При массе 8,59 кг/м: 1000 / 8,59 ≈ 116,4 м. Это около 19 хлыстов длиной 6 м или 10 хлыстов длиной 11,7 м. Для других номеров: 5П — 207 м/т, 14П — 81 м/т, 20П — 54 м/т, 30П — 31 м/т, 40П — 21 м/т. В калькуляторе выше — обратный пересчёт «масса → количество хлыстов».',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faq.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const howToJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'HowTo',
	name: 'Как рассчитать вес швеллера',
	description: 'Расчёт массы швеллера по номеру профиля, длине и материалу согласно ГОСТ 8240-97.',
	step: [
		{ '@type': 'HowToStep', name: 'Выбрать материал', text: 'Углеродистая сталь или нержавейка — плотность подставится автоматически.' },
		{ '@type': 'HowToStep', name: 'Выбрать номер швеллера', text: 'От 5 до 40 по ГОСТ 8240-97. Номер равен высоте профиля в сантиметрах.' },
		{ '@type': 'HowToStep', name: 'Указать длину и количество', text: 'Длина хлыста — обычно 6, 11,7 или 12 м. Количество — число хлыстов в партии.' },
		{ '@type': 'HowToStep', name: 'Получить результат', text: 'Вес 1 м, вес хлыста и общий вес партии в килограммах или тоннах.' },
	],
};

---

<BaseLayout title={title} description={description} jsonLd={[faqJsonLd, howToJsonLd]}>
	<div class="container shv">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Калькулятор веса швеллера' }]} />

		<header class="shv__hero">
			<span class="shv__eyebrow">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<path d="M3 2v12M3 2h6M3 14h6M9 5v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
				</svg>
				ГОСТ 8240-97
			</span>
			<h1 class="shv__h1">Калькулятор веса <span class="shv__h1-accent">швеллера</span></h1>
			<p class="shv__lead">
				Расчёт массы швеллера от 5 до 40 номера по ГОСТ 8240-97. Поддерживается
				углеродистая сталь (Ст3, 09Г2С) и нержавейка (AISI 304, 316L, 430).
				Подходит для расчёта прайса, доставки и сметы по металлоконструкциям.
			</p>
		</header>

		<section class="shv__widget" data-shv-root>
			<div class="shv__widget-inner">
				<div class="shv__form">
					<div class="shv__field">
						<label class="shv__label" for="shv-mat">Материал</label>
						<select class="shv__input" id="shv-mat" data-shv-material>
							{materials.map((m) => (
								<option value={m.value} data-rho={m.rho} selected={m.value === 'st3'}>
									{m.label} — ρ {(m.rho / 1000).toLocaleString('ru-RU', { minimumFractionDigits: 2 })} г/см³
								</option>
							))}
						</select>
						<p class="shv__hint" data-shv-mat-hint>{materials[0].applic}</p>
					</div>

					<div class="shv__field">
						<label class="shv__label" for="shv-num">Номер швеллера</label>
						<select class="shv__input" id="shv-num" data-shv-num>
							{shvellerRows.map((r) => (
								<option value={r.num} selected={r.num === '10П'}>
									№{r.num} — h {r.h} × b {r.b} — {r.m1.toLocaleString('ru-RU', { minimumFractionDigits: 2 })} кг/м (Ст3)
								</option>
							))}
						</select>
						<p class="shv__hint">Литера «а» — усиленный профиль с увеличенной полкой</p>
					</div>

					<div class="shv__row-2">
						<div class="shv__field">
							<label class="shv__label" for="shv-len">Длина хлыста, м</label>
							<input class="shv__input" id="shv-len" type="number" inputmode="decimal" step="any" min="0.01" value="6" data-shv-length />
							<p class="shv__hint">Типовые: 6 · 11,7 · 12 м</p>
						</div>

						<div class="shv__field">
							<label class="shv__label" for="shv-qty">Количество хлыстов</label>
							<input class="shv__input" id="shv-qty" type="number" inputmode="decimal" step="any" min="1" value="1" data-shv-qty />
							<p class="shv__hint">Или укажите массу ниже</p>
						</div>
					</div>

					<div class="shv__field">
						<label class="shv__label" for="shv-mass">Нужная масса (обратный расчёт)</label>
						<div class="shv__mass-wrap">
							<input class="shv__input shv__mass-input" id="shv-mass" type="number" inputmode="decimal" step="any" min="0" placeholder="—" data-shv-mass />
							<select class="shv__mass-unit" data-shv-mass-unit aria-label="Единицы массы">
								<option value="t" selected>т</option>
								<option value="kg">кг</option>
							</select>
						</div>
						<p class="shv__hint">Введите массу — пересчитаем количество хлыстов заданной длины</p>
					</div>
				</div>

				<aside class="shv__result">
					<div class="shv__result-card">
						<div class="shv__result-eyebrow">Расчёт по ГОСТ 8240-97</div>

						<div class="shv__result-row">
							<span>Вес 1 метра</span>
							<strong data-shv-m1>—</strong>
						</div>
						<div class="shv__result-row">
							<span>Вес 1 хлыста</span>
							<strong data-shv-hlyst>—</strong>
						</div>

						<div class="shv__result-total">
							<span class="shv__result-total-label">Общий вес партии</span>
							<div class="shv__result-total-value" data-shv-total>—</div>
							<div class="shv__result-total-sub" data-shv-total-sub></div>
						</div>

						<dl class="shv__result-meta">
							<div><dt>Профиль</dt><dd data-shv-profile>—</dd></div>
							<div><dt>Общая длина</dt><dd data-shv-totlen>—</dd></div>
						</dl>

						<a class="shv__cta" href="/ugolok-shveller/" data-shv-cta>
							<span>Нержавеющий швеллер в каталоге</span>
							<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
								<path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</a>

						<p class="shv__result-foot">
							Теоретическая масса. Фактический вес отличается на ±2,5 % (допуск проката по ГОСТ).
						</p>
					</div>
				</aside>
			</div>
		</section>

		<section class="shv__block">
			<h2 class="shv__h2">Сечение швеллера</h2>
			<div class="shv__infographic">
				<svg viewBox="0 0 280 280" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Поперечное сечение швеллера: высота h, ширина полки b, толщина стенки tw, толщина полки tf">
					<defs>
						<pattern id="shvHatch" x="0" y="0" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
							<line x1="0" y1="0" x2="0" y2="9" stroke="var(--color-primary)" stroke-width="0.7" opacity="0.28" />
						</pattern>
					</defs>

					{/* П-образное сечение швеллера с открытой стороной вправо.
					    Web: x=80..92 (стенка), top flange: y=60..75, bottom flange: y=205..220. */}
					<path d="M 80 60 L 175 60 L 175 75 L 92 75 L 92 205 L 175 205 L 175 220 L 80 220 Z"
						fill="url(#shvHatch)" stroke="var(--color-primary)" stroke-width="2.4" stroke-linejoin="round" />

					{/* Размер h — слева */}
					<g stroke="var(--color-accent)" stroke-width="1.4" fill="none" stroke-linecap="round">
						<line x1="55" y1="60" x2="55" y2="220" />
						<line x1="50" y1="60" x2="80" y2="60" stroke-dasharray="3 2" />
						<line x1="50" y1="220" x2="80" y2="220" stroke-dasharray="3 2" />
					</g>
					<polygon points="55,60 51,72 59,72" fill="var(--color-accent)" />
					<polygon points="55,220 51,208 59,208" fill="var(--color-accent)" />
					<text x="40" y="146" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="var(--color-accent)" transform="rotate(-90 40 146)">h</text>

					{/* Размер b — сверху */}
					<g stroke="var(--color-accent)" stroke-width="1.4" fill="none" stroke-linecap="round">
						<line x1="80" y1="40" x2="175" y2="40" />
						<line x1="80" y1="35" x2="80" y2="60" stroke-dasharray="3 2" />
						<line x1="175" y1="35" x2="175" y2="60" stroke-dasharray="3 2" />
					</g>
					<polygon points="80,40 92,36 92,44" fill="var(--color-accent)" />
					<polygon points="175,40 163,36 163,44" fill="var(--color-accent)" />
					<text x="127" y="32" text-anchor="middle" font-family="Inter, sans-serif" font-size="14" font-weight="600" fill="var(--color-accent)">b</text>

					{/* Размер tw — толщина стенки (выноска внутрь) */}
					<g stroke="var(--color-accent)" stroke-width="1.2" fill="none">
						<line x1="80" y1="140" x2="92" y2="140" />
					</g>
					<text x="120" y="135" font-family="Inter, sans-serif" font-size="11" font-style="italic" fill="var(--color-accent)">tw</text>
					<line x1="116" y1="140" x2="93" y2="140" stroke="var(--color-accent)" stroke-width="0.8" />

					{/* Размер tf — толщина полки */}
					<g stroke="var(--color-accent)" stroke-width="1.2" fill="none">
						<line x1="200" y1="60" x2="200" y2="75" />
					</g>
					<text x="206" y="71" font-family="Inter, sans-serif" font-size="11" font-style="italic" fill="var(--color-accent)">tf</text>
					<line x1="204" y1="67" x2="200" y2="67" stroke="var(--color-accent)" stroke-width="0.8" />

					<text x="260" y="270" text-anchor="end" font-family="Inter, sans-serif" font-size="10" fill="var(--color-muted)" font-style="italic">ГОСТ 8240-97</text>
				</svg>

				<div class="shv__infographic-legend">
					<h3>Обозначения</h3>
					<ul>
						<li><strong>h</strong> — высота профиля (равна номеру швеллера в см)</li>
						<li><strong>b</strong> — ширина полки</li>
						<li><strong>tw</strong> — толщина стенки</li>
						<li><strong>tf</strong> — средняя толщина полки</li>
						<li>Штриховка 45° — стандартное обозначение разреза металла</li>
					</ul>
					<p class="shv__infographic-note">
						Профиль П — параллельные грани полок (показан). Профиль У отличается
						внутренним уклоном полок 4–10 %, но имеет ту же массу для одного номера.
					</p>
				</div>
			</div>
		</section>

		<section class="shv__block">
			<h2 class="shv__h2">Таблица веса швеллера по ГОСТ 8240-97</h2>
			<p class="shv__block-lead">
				Размеры и теоретическая масса 1 м швеллера горячекатаного (плотность стали 7,85 г/см³).
				Для нержавеющего швеллера значения скорректируются автоматически в виджете расчёта.
			</p>
			<div class="shv__table-wrap">
				<table class="shv__table">
					<thead>
						<tr>
							<th>Номер</th>
							<th>h, мм</th>
							<th>b, мм</th>
							<th>tw, мм</th>
							<th>tf, мм</th>
							<th>Масса 1 м, кг</th>
							<th>В 1 т, м</th>
						</tr>
					</thead>
					<tbody>
						{shvellerRows.map((r) => (
							<tr>
								<td><strong>№{r.num}</strong></td>
								<td>{r.h}</td>
								<td>{r.b}</td>
								<td>{r.tw.toLocaleString('ru-RU', { minimumFractionDigits: 1 })}</td>
								<td>{r.tf.toLocaleString('ru-RU', { minimumFractionDigits: 1 })}</td>
								<td>{r.m1.toLocaleString('ru-RU', { minimumFractionDigits: 2 })}</td>
								<td>{Math.round(1000 / r.m1).toLocaleString('ru-RU')}</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</section>

		<section class="shv__block">
			<h2 class="shv__h2">Материалы для швеллера</h2>
			<div class="shv__mat-cards">
				{materials.map((m) => (
					<div class="shv__mat-card">
						<div class="shv__mat-head">
							<strong>{m.label}</strong>
							<span>ρ {(m.rho / 1000).toLocaleString('ru-RU', { minimumFractionDigits: 2 })} г/см³</span>
						</div>
						<p>{m.applic}</p>
						<small>{m.gost}</small>
					</div>
				))}
			</div>
		</section>

		<section class="shv__block">
			<h2 class="shv__h2">Связанное в каталоге и инструментах</h2>
			<ul class="shv__related">
				<li>
					<a href="/ugolok-shveller/">
						<strong>Нержавеющий уголок и швеллер</strong>
