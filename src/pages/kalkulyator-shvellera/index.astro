<script>
	type ShvRow = { num: string; m1: number; h: number; b: number; tw: number; tf: number };

	const ROWS: ShvRow[] = [
		{ num: '5П',   m1: 4.84,  h: 50,  b: 32,  tw: 4.4,  tf: 7.0  },
		{ num: '6.5П', m1: 5.90,  h: 65,  b: 36,  tw: 4.4,  tf: 7.2  },
		{ num: '8П',   m1: 7.05,  h: 80,  b: 40,  tw: 4.5,  tf: 7.4  },
		{ num: '10П',  m1: 8.59,  h: 100, b: 46,  tw: 4.5,  tf: 7.6  },
		{ num: '12П',  m1: 10.40, h: 120, b: 52,  tw: 4.8,  tf: 7.8  },
		{ num: '14П',  m1: 12.30, h: 140, b: 58,  tw: 4.9,  tf: 8.1  },
		{ num: '16П',  m1: 14.20, h: 160, b: 64,  tw: 5.0,  tf: 8.4  },
		{ num: '16аП', m1: 15.30, h: 160, b: 68,  tw: 5.0,  tf: 9.0  },
		{ num: '18П',  m1: 16.30, h: 180, b: 70,  tw: 5.1,  tf: 8.7  },
		{ num: '18аП', m1: 17.40, h: 180, b: 74,  tw: 5.1,  tf: 9.3  },
		{ num: '20П',  m1: 18.40, h: 200, b: 76,  tw: 5.2,  tf: 9.0  },
		{ num: '22П',  m1: 21.00, h: 220, b: 82,  tw: 5.4,  tf: 9.5  },
		{ num: '24П',  m1: 24.00, h: 240, b: 90,  tw: 5.6,  tf: 10.0 },
		{ num: '27П',  m1: 27.70, h: 270, b: 95,  tw: 6.0,  tf: 10.5 },
		{ num: '30П',  m1: 31.80, h: 300, b: 100, tw: 6.5,  tf: 11.0 },
		{ num: '33П',  m1: 36.50, h: 330, b: 105, tw: 7.0,  tf: 11.7 },
		{ num: '36П',  m1: 41.90, h: 360, b: 110, tw: 7.5,  tf: 12.6 },
		{ num: '40П',  m1: 48.30, h: 400, b: 115, tw: 8.0,  tf: 13.5 },
	];

	/* Плотность Ст3 принята в табличных m1 ГОСТ 8240-97.
	   При смене материала пересчитываем m1 пропорционально плотности. */
	const RHO_REF = 7850;

	const MAT_HINTS: Record<string, string> = {
		st3: 'строительный швеллер общего назначения',
		aisi304: 'пищевая, химическая, фармацевтическая промышленность',
		aisi316l: 'агрессивные среды, морская вода, хлориды',
		aisi430: 'ферритная — пищевое и бытовое оборудование',
	};

	const root = document.querySelector('[data-shv-root]');
	if (root) {
		const matSel = root.querySelector('[data-shv-material]') as HTMLSelectElement;
		const matHint = root.querySelector('[data-shv-mat-hint]') as HTMLElement;
		const numSel = root.querySelector('[data-shv-num]') as HTMLSelectElement;
		const lenInp = root.querySelector('[data-shv-length]') as HTMLInputElement;
		const qtyInp = root.querySelector('[data-shv-qty]') as HTMLInputElement;
		const massInp = root.querySelector('[data-shv-mass]') as HTMLInputElement;
		const massUnit = root.querySelector('[data-shv-mass-unit]') as HTMLSelectElement;

		const m1El = root.querySelector('[data-shv-m1]') as HTMLElement;
		const hlystEl = root.querySelector('[data-shv-hlyst]') as HTMLElement;
		const totalEl = root.querySelector('[data-shv-total]') as HTMLElement;
		const totalSubEl = root.querySelector('[data-shv-total-sub]') as HTMLElement;
		const profileEl = root.querySelector('[data-shv-profile]') as HTMLElement;
		const totLenEl = root.querySelector('[data-shv-totlen]') as HTMLElement;

		const fmt = new Intl.NumberFormat('ru-RU', { minimumFractionDigits: 2, maximumFractionDigits: 3 });

		let lastEdited: 'qty' | 'mass' = 'qty';

		function getRow(): ShvRow {
			return ROWS.find((r) => r.num === numSel.value) ?? ROWS[3];
		}

		function getRho(): number {
			const opt = matSel.selectedOptions[0];
			return parseFloat(opt?.dataset.rho || '7850') || 7850;
		}

		function recalc() {
			const row = getRow();
			const len = parseFloat(lenInp.value) || 0;
			let qty = parseFloat(qtyInp.value) || 0;

			const rho = getRho();
			/* m1 пересчитывается пропорционально плотности относительно Ст3. */
			const m1 = row.m1 * (rho / RHO_REF);
			const hlystWeight = m1 * len;

			if (lastEdited === 'mass' && hlystWeight > 0) {
				const massRaw = parseFloat(massInp.value) || 0;
				const massKg = massUnit.value === 't' ? massRaw * 1000 : massRaw;
				qty = massKg / hlystWeight;
				if (qty > 0) qtyInp.value = String(+qty.toFixed(2));
				else qtyInp.value = '0';
			} else if (hlystWeight > 0 && qty > 0) {
				const total = hlystWeight * qty;
				const inT = massUnit.value === 't';
				massInp.value = String(+(inT ? total / 1000 : total).toFixed(3));
			} else {
				massInp.value = '';
			}

			const total = hlystWeight * qty;

			m1El.textContent = `${fmt.format(m1)} кг`;
			hlystEl.textContent = hlystWeight > 0 ? `${fmt.format(hlystWeight)} кг` : '—';

			if (total > 0) {
				if (total >= 1000) {
					totalEl.textContent = `${fmt.format(total / 1000)} т`;
					totalSubEl.textContent = `${fmt.format(total)} кг`;
				} else {
					totalEl.textContent = `${fmt.format(total)} кг`;
					totalSubEl.textContent = '';
				}
			} else {
				totalEl.textContent = '—';
				totalSubEl.textContent = '';
			}

			profileEl.textContent = `№${row.num} · h ${row.h} мм`;
			totLenEl.textContent = qty > 0 && len > 0 ? `${fmt.format(qty * len)} м` : '—';
		}

		matSel.addEventListener('change', () => {
			matHint.textContent = MAT_HINTS[matSel.value] ?? '';
			recalc();
		});
		numSel.addEventListener('change', () => { lastEdited = 'qty'; recalc(); });
		lenInp.addEventListener('input', () => { lastEdited = 'qty'; recalc(); });
		qtyInp.addEventListener('input', () => { lastEdited = 'qty'; recalc(); });
		massInp.addEventListener('input', () => { lastEdited = 'mass'; recalc(); });
		massUnit.addEventListener('change', () => { lastEdited = 'qty'; recalc(); });

		recalc();
	}
</script>

