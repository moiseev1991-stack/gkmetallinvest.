---
import Button from './ui/Button.astro';
import { contacts } from '../data/site';

interface Props {
	what?: string;
}
const { what } = Astro.props;
---

<aside class="hub-soon" role="status">
	<div class="hub-soon__badge">Раздел в наполнении</div>
	<h2 class="hub-soon__title">ТОВАР СКОРО ПОЯВИТСЯ</h2>
	{what && <p class="hub-soon__what">{what}</p>}
	<p class="hub-soon__text">
		Этого раздела пока нет в открытом каталоге. Если нужна позиция уже сейчас — оставьте заявку или
		позвоните, менеджер пришлёт наличие и цену в течение 30 минут.
	</p>
	<div class="hub-soon__cta">
		<Button href="/zapros-kp/#lead-form" variant="primary">Запросить наличие и цену</Button>
		<a class="hub-soon__phone" href={`tel:${contacts.phoneTel}`}>{contacts.phone}</a>
	</div>
</aside>

<style>
	.hub-soon {
		text-align: center;
		background: var(--color-primary-50);
		border: 2px dashed var(--color-primary-100);
		border-radius: var(--radius-lg);
		padding: var(--space-10) var(--space-6);
		margin: var(--space-6) 0 var(--space-8);
	}
	.hub-soon__badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-primary-600);
		background: var(--color-primary-100);
		padding: 0.35rem 0.9rem;
		border-radius: var(--radius-pill);
		margin-bottom: var(--space-4);
	}
	.hub-soon__title {
		margin: 0 0 var(--space-3);
		font-size: clamp(1.6rem, 4vw, 2.4rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-primary-600);
		line-height: 1.1;
	}
	.hub-soon__what {
		margin: 0 0 var(--space-3);
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--color-text);
	}
	.hub-soon__text {
		margin: 0 auto var(--space-5);
		max-width: 60ch;
		color: var(--color-muted);
		font-size: 0.98rem;
	}
	.hub-soon__cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-3);
	}
	.hub-soon__phone {
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--color-primary-600);
		text-decoration: none;
	}
	.hub-soon__phone:hover {
		text-decoration: underline;
	}
</style>
