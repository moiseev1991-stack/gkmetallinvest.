---
/* Счётчики и верификации, перенесены со старого сайта gkmetallinvest.ru.
 * Мета-верификации Яндекс.Вебмастера рендерятся всегда (нужны для подтверждения
 * прав на домен ещё до запуска). Сами счётчики (Метрика, GA4, Mail.ru) грузятся
 * только на боевом сайте (когда siteNoindex=false), чтобы трафик с временных
 * адресов Timeweb/Vercel/localhost не пачкал статистику. */
import { siteNoindex } from '../data/site';
---

<meta name="yandex-verification" content="65446952578956f8" />
<meta name="yandex-verification" content="e8e4fa95672572dc" />
<meta name="google-site-verification" content="iO2tPEbi4ZyqCIHd5zfPSWFZfUbofGqqhqhTP9R4tkY" />
<meta name="msvalidate.01" content="CE786B4895642D0D8F4F389F90B18CC6" />

{!siteNoindex && (
	<>
		{/* Коллтрекинг подменяет номер и почту уже в браузере: до подмены посетитель
		   видит исходные контакты, поэтому соединение с Roistat открываем заранее,
