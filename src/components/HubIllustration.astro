---
/**
 * Hero-иллюстрация хаба. Использует реальные фотографии металлоизделий
 * из public/img/catalog/ — это понятнее и убедительнее любых SVG-фигур.
 *
 * Если фото для конкретного хаба нет (новый раздел без ассетов) —
 * рендерится плейсхолдер с инициалом, чтобы вёрстка не уезжала.
 */
interface Props {
	hub:
		| 'list'
		| 'truba'
		| 'krug'
		| 'rulon'
		| 'polosa'
		| 'provoloka'
		| 'detali-truboprovoda'
		| 'ugolok-shveller'
		| 'metizy'
		| 'podshipniki'
		| 'lestnichnye-ograzhdeniya'
		| 'dekorativnye-listy'
		| 'lenta'
		| 'folga'
		| 'elektrody';
	class?: string;
}
const { hub, class: className = '' } = Astro.props;

/* Маппинг хаб → путь к картинке. Файлы лежат в public/img/catalog/.
   Если для хаба фотографии нет, ключ отсутствует — рендерим плейсхолдер. */
const IMG: Partial<Record<Props['hub'], string>> = {
	list: '/img/catalog/list.png',
	truba: '/img/catalog/truba.png',
	krug: '/img/catalog/krug.jpg',
	rulon: '/img/catalog/rulon.png',
	polosa: '/img/catalog/polosa.jpg',
	provoloka: '/img/catalog/provoloka.jpg',
	'detali-truboprovoda': '/img/catalog/detali-truboprovoda.jpg',
	'ugolok-shveller': '/img/catalog/ugolok-shveller.jpg',
	'dekorativnye-listy': '/img/catalog/dekorativnye.webp',
	lenta: '/img/catalog/lenta.png',
	folga: '/img/catalog/folga.jpg',
	metizy: '/img/catalog/metizy/cover.webp',
	podshipniki: '/img/catalog/podshipniki/cover.webp',
	elektrody: '/img/catalog/elektrody/cover.webp',
};

/* Подписи на акцентной плашке под/над изображением — характерные параметры
   раздела. Для пустых хабов плашка может быть пустой. */
const TAG: Record<Props['hub'], { mark: string; sub: string }> = {
	list: { mark: 'AISI 304', sub: 'толщина 0,4–60 мм · поверхности 2B / BA / 4N' },
	truba: { mark: 'AISI 321', sub: 'Ø 6–273 мм · стенка 1–16 мм' },
	krug: { mark: 'h9 / h11', sub: 'Ø 5–250 мм · калиброванный и горячекатаный' },
	rulon: { mark: '0,4–3 мм', sub: 'ширина 1000–1500 мм · 2B / BA / 4N' },
	polosa: { mark: '4–50 мм', sub: 'ширина 25–300 мм · ГОСТ 103' },
	provoloka: { mark: 'Ø 0,1–6 мм', sub: 'сварочная · вязальная · пружинная' },
	'detali-truboprovoda': { mark: 'ГОСТ 12820', sub: 'фланцы · отводы · тройники · задвижки' },
	'ugolok-shveller': { mark: 'ГОСТ 8509 · 8240', sub: 'равнополочный уголок · швеллер №№ 8–20' },
	'dekorativnye-listy': { mark: 'BA · 4N · 8K', sub: 'с защитной плёнкой PE / PVC' },
	lenta: { mark: 'штрипс', sub: 'толщина 0,05–4 мм · шаг ширины 5 мм' },
	folga: { mark: 'фольга', sub: 'тонкая нержавеющая, по запросу' },
	metizy: { mark: 'A2 / A4', sub: 'болты · гайки · шпильки · DIN / ГОСТ' },
	podshipniki: { mark: 'AISI 440C', sub: 'шариковые · роликовые · игольчатые' },
	elektrody: { mark: 'ЦЛ-11', sub: 'ОЗЛ-8 · ЭА-400 · 2,5–5 мм' },
	'lestnichnye-ograzhdeniya': { mark: 'EN 1090', sub: 'стойки · поручни · стеклодержатели' },
};

const src = IMG[hub];
const { mark, sub } = TAG[hub];
const PLACEHOLDER_LETTER: Record<Props['hub'], string> = {
	list: 'Л',
	truba: 'Т',
	krug: 'К',
	rulon: 'Р',
	polosa: 'П',
	provoloka: 'Пр',
	'detali-truboprovoda': 'Д',
	'ugolok-shveller': 'У',
	'dekorativnye-listy': 'Д',
	lenta: 'Л',
	folga: 'Ф',
	metizy: 'М',
	podshipniki: 'П',
	elektrody: 'Э',
	'lestnichnye-ograzhdeniya': 'О',
};
---

<figure class={`hub-illo ${className}`.trim()}>
	{src ? (
		<img
			class="hub-illo__img"
			src={src}
			alt=""
			loading="lazy"
			decoding="async"
			width="640"
			height="480"
		/>
	) : (
		<div class="hub-illo__placeholder" aria-hidden="true">
			<span>{PLACEHOLDER_LETTER[hub]}</span>
		</div>
	)}
	<figcaption class="hub-illo__cap">
		<span class="hub-illo__mark">{mark}</span>
		<span class="hub-illo__sub">{sub}</span>
	</figcaption>
</figure>

<style>
	.hub-illo {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		margin: 0;
		max-width: 460px;
		width: 100%;
	}
	.hub-illo__img {
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		border-radius: var(--radius-md);
		background: var(--color-bg-elev);
		display: block;
	}
	.hub-illo__placeholder {
		width: 100%;
		aspect-ratio: 4 / 3;
		display: flex;
		align-items: center;
		justify-content: center;
		background: linear-gradient(135deg, var(--color-primary-50), var(--color-primary-100));
		border: 1px dashed var(--color-primary-100);
		border-radius: var(--radius-md);
		color: var(--color-primary-500);
		font-family: var(--font-mono);
		font-size: 4rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.hub-illo__cap {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0 var(--space-1);
	}
	.hub-illo__mark {
		display: inline-block;
		align-self: flex-start;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 700;
		padding: 0.3rem 0.75rem;
		background: var(--color-accent);
		color: #ffffff;
		border-radius: var(--radius-pill);
		line-height: 1.2;
	}
	.hub-illo__sub {
		font-size: 0.82rem;
		color: var(--color-muted);
		line-height: 1.4;
	}
</style>
