---
/**
 * SVG-инфографика под конкретный хаб каталога. В отличие от просто картинки,
 * каждая иллюстрация показывает характерные размеры и параметры товара —
 * как мини-чертёж: с размерными линиями, подписями типа «толщина 0,4–60 мм»,
 * «Ø 6–273 мм», маркой стали.
 *
 * Цвета и градиенты — через CSS-токены проекта; формы — изометрические,
 * пропорции близки к реальным металлоизделиям.
 */
interface Props {
	hub:
		| 'list'
		| 'truba'
		| 'krug'
		| 'rulon'
		| 'polosa'
		| 'provoloka'
		| 'detali-truboprovoda'
		| 'ugolok-shveller'
		| 'metizy'
		| 'podshipniki'
		| 'lestnichnye-ograzhdeniya'
		| 'dekorativnye-listy'
		| 'lenta'
		| 'folga'
		| 'elektrody';
	class?: string;
}
const { hub, class: className = '' } = Astro.props;

/* Общие константы стиля */
const STEEL_STROKE = '#3d4a5e';
const NAVY = '#0a1f3d';
const ACCENT = '#c4651b';
const LABEL = '#5a6878';
---

<svg
	class={`hub-illo ${className}`.trim()}
	viewBox="0 0 400 280"
	xmlns="http://www.w3.org/2000/svg"
	aria-hidden="true"
	role="presentation"
>
	<defs>
		<linearGradient id={`gr-steel-${hub}`} x1="0" x2="1" y1="0" y2="1">
			<stop offset="0%" stop-color="#f1f5fb" />
			<stop offset="30%" stop-color="#d8dfeb" />
			<stop offset="60%" stop-color="#aab5c5" />
			<stop offset="100%" stop-color="#7d8a9d" />
		</linearGradient>
		<linearGradient id={`gr-steel-h-${hub}`} x1="0" x2="0" y1="0" y2="1">
			<stop offset="0%" stop-color="#e8ecf2" />
			<stop offset="40%" stop-color="#c0c9d6" />
			<stop offset="100%" stop-color="#8c98ab" />
		</linearGradient>
		<linearGradient id={`gr-end-${hub}`} x1="0" x2="1" y1="0" y2="1">
			<stop offset="0%" stop-color="#bcc7d6" />
			<stop offset="100%" stop-color="#6d7a8e" />
		</linearGradient>
		<linearGradient id={`gr-mirror-${hub}`} x1="0" x2="0.7" y1="0" y2="1">
			<stop offset="0%" stop-color="#ffffff" />
			<stop offset="35%" stop-color="#dee5ee" />
			<stop offset="55%" stop-color="#f4f7fb" />
			<stop offset="80%" stop-color="#aab5c5" />
			<stop offset="100%" stop-color="#dfe5ed" />
		</linearGradient>
		<linearGradient id={`gr-shine-${hub}`} x1="0" x2="1" y1="0" y2="0">
			<stop offset="0%" stop-color="rgba(255,255,255,0)" />
			<stop offset="50%" stop-color="rgba(255,255,255,0.9)" />
			<stop offset="100%" stop-color="rgba(255,255,255,0)" />
		</linearGradient>
		<radialGradient id={`gr-disc-${hub}`} cx="0.35" cy="0.35" r="0.7">
			<stop offset="0%" stop-color="#f4f7fb" />
			<stop offset="60%" stop-color="#c0c9d6" />
			<stop offset="100%" stop-color="#6d7a8e" />
		</radialGradient>
		<filter id={`f-soft-${hub}`} x="-20%" y="-20%" width="140%" height="140%">
			<feGaussianBlur stdDeviation="1.2" />
		</filter>
	</defs>

	<style>{`
		.lab { font: 600 11px var(--font-mono, ui-monospace, monospace); fill: ${LABEL}; }
		.lab-sm { font: 500 9.5px var(--font-mono, ui-monospace, monospace); fill: ${LABEL}; }
		.lab-tag { font: 700 10px var(--font-sans, system-ui); fill: ${NAVY}; }
		.tag-bg { fill: #ffffff; stroke: ${LABEL}; stroke-width: 0.7; }
		.tag-bg-accent { fill: ${ACCENT}; }
		.tag-fg-accent { fill: #ffffff; }
		.dim { stroke: ${LABEL}; stroke-width: 0.7; fill: none; }
		.dim-arr { fill: ${LABEL}; }
		.outline { fill: none; stroke: ${STEEL_STROKE}; stroke-width: 1.2; }
	`}</style>

	{hub === 'list' && (
		<g>
			{/* стопка из 4 листов с виден ракурс торца + размерные подписи */}
			<g transform="translate(60 88)">
				{[0, 1, 2, 3].map((i) => {
					const dy = i * 18;
					const tone = ['#cbd5e3', '#c0cbdc', '#b8c3d5', '#aeb9cb'][i];
					return (
						<g transform={`translate(0 ${dy})`}>
							<polygon
								points={`0,40 220,40 252,18 32,18`}
								fill={tone}
								stroke={STEEL_STROKE}
								stroke-width="0.9"
								stroke-linejoin="round"
							/>
							<polygon
								points={`220,40 252,18 252,28 220,50`}
								fill={`url(#gr-end-${hub})`}
								stroke={STEEL_STROKE}
								stroke-width="0.9"
							/>
							<line x1="0" y1="40" x2="220" y2="40" stroke={STEEL_STROKE} stroke-width="0.9" />
							<rect x="6" y="22" width="200" height="3" fill={`url(#gr-shine-${hub})`} opacity="0.5" />
						</g>
					);
				})}
			</g>
			{/* размерная вертикаль — толщина */}
			<g transform="translate(28 95)">
				<line class="dim" x1="0" y1="0" x2="0" y2="86" />
				<polygon class="dim-arr" points="0,0 -3,5 3,5" />
				<polygon class="dim-arr" points="0,86 -3,81 3,81" />
				<line class="dim" x1="-4" y1="0" x2="6" y2="0" />
				<line class="dim" x1="-4" y1="86" x2="6" y2="86" />
				<text class="lab-sm" x="-30" y="50" transform="rotate(-90 -30 50)">0,4–60 мм</text>
			</g>
			{/* tag марки */}
			<g transform="translate(255 220)">
				<rect class="tag-bg-accent" x="0" y="0" width="92" height="22" rx="11" />
				<text class="lab-tag tag-fg-accent" x="46" y="15" text-anchor="middle">AISI 304</text>
			</g>
			<text class="lab" x="60" y="260">Холоднокатаный · горячекатаный · ПВЛ</text>
		</g>
	)}

	{hub === 'truba' && (
		<g>
			{/* большая бесшовная труба с торцом и стенкой + сварной шов */}
			<g transform="translate(60 90)">
				{/* тело */}
				<rect x="36" y="0" width="240" height="110" fill={`url(#gr-steel-h-${hub})`} />
				{/* шов */}
				<line x1="36" y1="40" x2="276" y2="40" stroke={STEEL_STROKE} stroke-width="0.6" stroke-dasharray="2 3" opacity="0.5" />
				{/* блик */}
				<rect x="36" y="4" width="240" height="14" fill={`url(#gr-shine-${hub})`} opacity="0.65" />
				{/* левый торец — диск с отверстием */}
				<ellipse cx="36" cy="55" rx="38" ry="55" fill={`url(#gr-end-${hub})`} stroke={STEEL_STROKE} stroke-width="1.2" />
				<ellipse cx="36" cy="55" rx="22" ry="35" fill={NAVY} />
				<ellipse cx="34" cy="50" rx="20" ry="32" fill="none" stroke="#3a4a62" stroke-width="0.7" />
				{/* правый торец */}
				<ellipse cx="276" cy="55" rx="38" ry="55" fill={`url(#gr-disc-${hub})`} stroke={STEEL_STROKE} stroke-width="1.2" />
				<ellipse cx="276" cy="55" rx="22" ry="35" fill={NAVY} />
				{/* верхнее и нижнее ребро */}
				<line x1="36" y1="0" x2="276" y2="0" stroke={STEEL_STROKE} stroke-width="1" />
				<line x1="36" y1="110" x2="276" y2="110" stroke={STEEL_STROKE} stroke-width="1" />
			</g>
			{/* размерные подписи */}
			<g>
				<line class="dim" x1="35" y1="60" x2="35" y2="200" />
				<line class="dim" x1="22" y1="200" x2="48" y2="200" />
				<text class="lab" x="35" y="216" text-anchor="middle">Ø 6–273 мм</text>
			</g>
			<g transform="translate(96 56)">
				<line class="dim" x1="0" y1="0" x2="36" y2="0" />
				<polygon class="dim-arr" points="0,0 5,-3 5,3" />
				<polygon class="dim-arr" points="36,0 31,-3 31,3" />
				<text class="lab-sm" x="18" y="-4" text-anchor="middle">стенка 1–16 мм</text>
			</g>
			<g transform="translate(255 220)">
				<rect class="tag-bg-accent" x="0" y="0" width="92" height="22" rx="11" />
				<text class="lab-tag tag-fg-accent" x="46" y="15" text-anchor="middle">AISI 321</text>
			</g>
			<text class="lab" x="60" y="260">Бесшовная · ЭСВ · профильная</text>
		</g>
	)}

	{hub === 'krug' && (
		<g>
			{/* круг + квадрат + шестигранник — три типа сортового проката */}
			{/* круг */}
			<g transform="translate(80 80)">
				<rect x="30" y="0" width="240" height="48" fill={`url(#gr-steel-h-${hub})`} />
				<rect x="30" y="2" width="240" height="6" fill={`url(#gr-shine-${hub})`} opacity="0.7" />
				<ellipse cx="30" cy="24" rx="20" ry="24" fill={`url(#gr-disc-${hub})`} stroke={STEEL_STROKE} stroke-width="1.1" />
				<ellipse cx="30" cy="24" rx="13" ry="16" fill="none" stroke={STEEL_STROKE} stroke-width="0.5" opacity="0.5" />
				<ellipse cx="270" cy="24" rx="20" ry="24" fill={`url(#gr-end-${hub})`} stroke={STEEL_STROKE} stroke-width="1.1" />
				<line x1="30" y1="0" x2="270" y2="0" stroke={STEEL_STROKE} stroke-width="0.9" />
				<line x1="30" y1="48" x2="270" y2="48" stroke={STEEL_STROKE} stroke-width="0.9" />
			</g>
			{/* квадрат (повёрнутый ромбом) */}
			<g transform="translate(80 152)">
				<polygon points="30,18 270,18 270,42 30,42" fill={`url(#gr-steel-h-${hub})`} stroke={STEEL_STROKE} stroke-width="1" />
				<polygon points="30,18 12,30 12,54 30,42" fill={`url(#gr-end-${hub})`} stroke={STEEL_STROKE} stroke-width="1" />
				<polygon points="30,42 12,54 252,54 270,42" fill="#a5b1c4" stroke={STEEL_STROKE} stroke-width="1" />
				<rect x="32" y="20" width="236" height="4" fill={`url(#gr-shine-${hub})`} opacity="0.6" />
			</g>
			{/* шестигранник — торец */}
			<g transform="translate(330 178)">
				<polygon points="0,-22 19,-11 19,11 0,22 -19,11 -19,-11" fill={`url(#gr-disc-${hub})`} stroke={STEEL_STROKE} stroke-width="1" />
				<polygon points="0,-12 11,-6 11,6 0,12 -11,6 -11,-6" fill="none" stroke={STEEL_STROKE} stroke-width="0.5" opacity="0.5" />
			</g>
			<g>
				<text class="lab" x="200" y="68" text-anchor="middle">круг · квадрат · шестигранник</text>
				<line class="dim" x1="50" y1="90" x2="50" y2="138" />
				<polygon class="dim-arr" points="50,90 47,95 53,95" />
				<polygon class="dim-arr" points="50,138 47,133 53,133" />
				<text class="lab-sm" x="22" y="116" transform="rotate(-90 22 116)">Ø 5–250 мм</text>
			</g>
			<g transform="translate(60 230)">
				<rect class="tag-bg-accent" x="0" y="0" width="92" height="22" rx="11" />
				<text class="lab-tag tag-fg-accent" x="46" y="15" text-anchor="middle">калиброванный</text>
			</g>
			<text class="lab" x="162" y="245">h9 / h11 — под токарную</text>
		</g>
	)}

	{hub === 'rulon' && (
		<g>
			{/* рулон, изометрия с разматывающимся листом */}
			<g transform="translate(70 50)">
				{/* боковая сторона диска */}
				<ellipse cx="70" cy="80" rx="68" ry="68" fill={`url(#gr-disc-${hub})`} stroke={STEEL_STROKE} stroke-width="1.4" />
				{/* спираль слоёв */}
				<ellipse cx="70" cy="80" rx="58" ry="58" fill="none" stroke="#7d8a9d" stroke-width="0.5" />
				<ellipse cx="70" cy="80" rx="48" ry="48" fill="none" stroke="#7d8a9d" stroke-width="0.5" />
				<ellipse cx="70" cy="80" rx="38" ry="38" fill="none" stroke="#7d8a9d" stroke-width="0.5" />
				<ellipse cx="70" cy="80" rx="28" ry="28" fill="none" stroke="#7d8a9d" stroke-width="0.5" />
				{/* центральное отверстие */}
				<ellipse cx="70" cy="80" rx="18" ry="18" fill={NAVY} />
				<ellipse cx="68" cy="78" rx="17" ry="17" fill="none" stroke="#3a4a62" stroke-width="0.7" />
				{/* выходящий хвост листа */}
				<path d="M138 80 L138 95 L300 92 L300 76 Z" fill={`url(#gr-steel-h-${hub})`} stroke={STEEL_STROKE} stroke-width="1" />
				<rect x="140" y="78" width="158" height="3" fill={`url(#gr-shine-${hub})`} opacity="0.6" />
				{/* лёгкий блик на катушке */}
				<ellipse cx="50" cy="50" rx="22" ry="14" fill="rgba(255,255,255,0.5)" />
			</g>
			<g>
				<line class="dim" x1="50" y1="60" x2="50" y2="196" />
				<polygon class="dim-arr" points="50,60 47,65 53,65" />
				<polygon class="dim-arr" points="50,196 47,191 53,191" />
				<text class="lab-sm" x="22" y="128" transform="rotate(-90 22 128)">ширина 1000–1500 мм</text>
			</g>
			<g transform="translate(255 215)">
				<rect class="tag-bg-accent" x="0" y="0" width="100" height="22" rx="11" />
				<text class="lab-tag tag-fg-accent" x="50" y="15" text-anchor="middle">0,4–3 мм</text>
			</g>
			<text class="lab" x="60" y="255">Холоднокатаный · 2B · BA · 4N · DECO</text>
		</g>
	)}

	{hub === 'polosa' && (
		<g>
			{/* три длинные полосы разной ширины в перспективе */}
			<g transform="translate(50 70)">
				{[
					{ y: 0, w: 12, tone: '#cbd5e3' },
					{ y: 38, w: 20, tone: '#c0cbdc' },
					{ y: 90, w: 30, tone: '#aeb9cb' },
				].map((p) => (
					<g transform={`translate(0 ${p.y})`}>
						<polygon points={`0,${p.w} 270,${p.w} 296,2 26,2`} fill={p.tone} stroke={STEEL_STROKE} stroke-width="1" />
						<polygon points={`270,${p.w} 296,2 296,${p.w - 4} 270,${p.w + 16}`} fill={`url(#gr-end-${hub})`} stroke={STEEL_STROKE} stroke-width="1" />
						<polygon points={`0,${p.w} 270,${p.w} 270,${p.w + 16} 0,${p.w + 16}`} fill={`url(#gr-steel-h-${hub})`} stroke={STEEL_STROKE} stroke-width="1" />
						<rect x="8" y={p.w + 1} width="258" height="3" fill={`url(#gr-shine-${hub})`} opacity="0.5" />
					</g>
				))}
			</g>
			<g>
				<text class="lab" x="200" y="60" text-anchor="middle">горячекатаная · калиброванная</text>
				<line class="dim" x1="30" y1="76" x2="30" y2="190" />
				<polygon class="dim-arr" points="30,76 27,81 33,81" />
				<polygon class="dim-arr" points="30,190 27,185 33,185" />
				<text class="lab-sm" x="6" y="132" transform="rotate(-90 6 132)">ширина 25–300 мм</text>
			</g>
			<g transform="translate(255 230)">
				<rect class="tag-bg-accent" x="0" y="0" width="100" height="22" rx="11" />
				<text class="lab-tag tag-fg-accent" x="50" y="15" text-anchor="middle">4–50 мм</text>
			</g>
			<text class="lab" x="60" y="255">ГОСТ 103 · EN 10058 · AISI 304/316L</text>
		</g>
	)}

	{hub === 'provoloka' && (
		<g>
			{/* катушка с проволокой и сама проволока кольцом */}
			<g transform="translate(50 75)">
				{/* барабан катушки сбоку */}
				<ellipse cx="105" cy="65" rx="105" ry="58" fill={`url(#gr-end-${hub})`} stroke={STEEL_STROKE} stroke-width="1.3" />
				<ellipse cx="105" cy="65" rx="105" ry="48" fill={`url(#gr-steel-${hub})`} />
				{/* витки проволоки */}
				{Array.from({ length: 22 }).map((_, i) => {
					const yOff = 24 + i * 3.2;
					const dxa = i * 0.25;
					return (
						<ellipse
							cx="105"
							cy={yOff}
							rx={105 - Math.abs(11 - i) * 1.8 - dxa}
							ry={1.6}
							fill="none"
							stroke="#5a6878"
							stroke-width="0.45"
							opacity="0.6"
						/>
					);
				})}
				{/* блик сверху */}
				<ellipse cx="80" cy="22" rx="80" ry="9" fill="rgba(255,255,255,0.65)" />
				{/* нижний край барабана */}
				<path d="M0 65 A105 58 0 0 0 210 65" fill="none" stroke={STEEL_STROKE} stroke-width="1.3" />
				{/* отходящая проволока */}
				<path d="M195 90 Q230 105 240 125 Q250 145 290 145" fill="none" stroke={ACCENT} stroke-width="2" stroke-linecap="round" />
				<circle cx="290" cy="145" r="3.5" fill={ACCENT} />
			</g>
			<g transform="translate(255 220)">
				<rect class="tag-bg-accent" x="0" y="0" width="100" height="22" rx="11" />
				<text class="lab-tag tag-fg-accent" x="50" y="15" text-anchor="middle">Ø 0,1–6 мм</text>
			</g>
			<text class="lab" x="60" y="250">Сварочная · вязальная · пружинная</text>
		</g>
	)}

	{hub === 'detali-truboprovoda' && (
		<g>
			{/* фланец слева + отвод 90° справа */}
			<g transform="translate(40 60)">
				{/* фланец */}
				<ellipse cx="65" cy="80" rx="60" ry="60" fill={`url(#gr-disc-${hub})`} stroke={STEEL_STROKE} stroke-width="1.3" />
				<ellipse cx="65" cy="80" rx="46" ry="46" fill={`url(#gr-steel-${hub})`} stroke={STEEL_STROKE} stroke-width="0.9" />
				<ellipse cx="65" cy="80" rx="22" ry="22" fill={NAVY} />
				{Array.from({ length: 8 }).map((_, i) => {
					const a = (i * Math.PI) / 4;
					const x = 65 + Math.cos(a) * 53;
					const y = 80 + Math.sin(a) * 53;
					return <circle cx={x} cy={y} r="4" fill={NAVY} stroke={STEEL_STROKE} stroke-width="0.6" />;
				})}
				{/* блик на фланце */}
				<ellipse cx="48" cy="55" rx="20" ry="10" fill="rgba(255,255,255,0.55)" />
			</g>
			<g transform="translate(200 70)">
				{/* отвод 90° */}
				<path
					d="M0 0 L0 50 Q0 90 40 90 L90 90 L90 124 L116 124 L116 90 Q116 0 40 0 Z"
					fill={`url(#gr-steel-${hub})`}
					stroke={STEEL_STROKE}
					stroke-width="1.3"
				/>
				<path
					d="M12 0 L12 50 Q12 78 40 78 L102 78 L102 0 Q102 0 60 0 Z"
					fill="none"
					stroke={STEEL_STROKE}
					stroke-width="0.5"
					opacity="0.5"
				/>
				<ellipse cx="0" cy="14" rx="5" ry="14" fill={NAVY} />
				<ellipse cx="103" cy="124" rx="13" ry="3.5" fill={NAVY} />
			</g>
			<g transform="translate(60 220)">
				<rect class="tag-bg-accent" x="0" y="0" width="120" height="22" rx="11" />
				<text class="lab-tag tag-fg-accent" x="60" y="15" text-anchor="middle">ГОСТ 12820</text>
			</g>
			<text class="lab" x="190" y="235">фланцы · отводы · тройники · задвижки</text>
		</g>
	)}

	{hub === 'ugolok-shveller' && (
		<g>
			{/* уголок в изометрии + швеллер */}
			<g transform="translate(50 60)">
				{/* лицевая полка */}
				<polygon points="0,140 0,30 80,0 80,12 16,38 16,140" fill={`url(#gr-steel-h-${hub})`} stroke={STEEL_STROKE} stroke-width="1.2" />
				{/* нижняя полка */}
				<polygon points="0,140 130,140 130,128 16,128 16,140" fill={`url(#gr-end-${hub})`} stroke={STEEL_STROKE} stroke-width="1.2" />
				{/* боковина (изометрический торец) */}
				<polygon points="80,0 130,-12 130,128 80,12" fill={`url(#gr-steel-${hub})`} stroke={STEEL_STROKE} stroke-width="1" />
				<polygon points="130,-12 144,-20 144,116 130,128" fill="#a5b1c4" stroke={STEEL_STROKE} stroke-width="0.9" />
			</g>
			<g transform="translate(220 75)">
