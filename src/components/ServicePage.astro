---
/**
 * Шаблон страницы одной услуги: hero, что делаем, оборудование, материалы,
 * процесс, прайс, FAQ, СTA. Принимает контент через props — мы хотим, чтобы
 * каждая услуга имела уникальный наполненный контент (600+ слов) для SEO.
 *
 * Service JSON-LD рендерится автоматически на основе пропсов.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaSection from './CtaSection.astro';
import Button from './ui/Button.astro';
import { siteName, siteUrl, contacts } from '../data/site';
import servicePanels from '../data/service-panels.json';

interface SpecRow {
	label: string;
	value: string;
	href?: string; // подпись строки — ссылка на подробную страницу
}
interface StepRow {
	n: number;
	title: string;
	text: string;
}
interface FaqRow {
	q: string;
	a: string;
}

interface Props {
	title: string; // SEO title
	description: string; // SEO description
	h1: string;
	tagline: string; // короткая подпись над H1
	intro: string; // 2-3 абзаца
	heroImage?: string; // фото по теме услуги — рендерится справа от текста в hero
	heroImageAlt?: string; // alt для фото (по умолчанию = h1)
	/** Короткий ответ «что за услуга и как заказать» (HTML, 2–3 предложения) —
	 *  стоит сразу под H1, чтобы его брали нейросети и быстрые ответы поиска. */
	answer?: string;
	facts?: string[]; // 3–4 коротких факта под ответом
	/** Слаг услуги: превью 1200×630 /img/services/<cover>.png идёт в og:image
	 *  (scripts/make-blog-cover.mjs, SERVICE_COVERS), а список справа в первом
	 *  экране берётся из src/data/service-panels.json — те же строки, что на
	 *  превью. Есть список — первый экран тёмный, в стиле превью. */
	cover?: string;
	coverAlt?: string;
	specs: SpecRow[]; // спецификация / характеристики
	specsTitle?: string; // заголовок блока specs, по умолчанию «Технические параметры»
	process: StepRow[]; // 4-6 шагов
	materials: string[]; // марки и материалы, с которыми работаем
	applications: string[]; // области применения
	limitations?: string[]; // ограничения / что не делаем
	relatedHubs: { label: string; href: string }[]; // связанные товарные хабы
	relatedTitle?: string; // заголовок блока relatedHubs, по умолчанию «Связанные товарные категории»
	/** Раздел-родитель для вложенных страниц (гальваника внутри «Гальванических
	 *  покрытий») — промежуточное звено в хлебных крошках. */
	parent?: { label: string; href: string };
	faq: FaqRow[];
	pricingNote?: string; // абзац про ценообразование
}
const {
	title,
	description,
	h1,
	tagline,
	intro,
	heroImage,
	heroImageAlt,
	answer,
	facts = [],
	cover,
	coverAlt,
	specs,
	specsTitle = 'Технические параметры',
	process,
	materials,
	applications,
	limitations,
	relatedHubs,
	relatedTitle = 'Связанные товарные категории',
	parent,
	faq,
	pricingNote,
} = Astro.props;

const path = Astro.url.pathname;
/* Сменили картинку под тем же именем — поднять версию, иначе браузеры и
   CDN ещё год будут показывать старую. */
const COVER_VER = 1;
const coverWebp = cover ? `/img/services/${cover}.webp?v=${COVER_VER}` : undefined;
const coverPng = cover ? `/img/services/${cover}.png?v=${COVER_VER}` : undefined;
type Panel = { head: string; items: { k: string; v: string; hi?: boolean }[] };
const panel: Panel | undefined = cover ? (servicePanels as Record<string, Panel>)[cover] : undefined;
const fullUrl = `${siteUrl.replace(/\/$/, '')}${path}`;

const serviceJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: h1,
	description,
	url: fullUrl,
	serviceType: tagline,
	...(coverPng ? { image: `${siteUrl.replace(/\/$/, '')}${coverPng}` } : {}),
	areaServed: { '@type': 'Country', name: 'Россия' },
	provider: {
		'@type': 'Organization',
		name: siteName,
		telephone: contacts.phone,
		address: {
			'@type': 'PostalAddress',
			addressLocality: 'Нижний Новгород',
			addressCountry: 'RU',
		},
	},
};

const faqJsonLd = faq && faq.length
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: faq.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
	  }
	: null;

const jsonLd = faqJsonLd ? [serviceJsonLd, faqJsonLd] : serviceJsonLd;
---

<BaseLayout title={title} description={description} image={coverPng} jsonLd={jsonLd}>
	<div class="container svc-page">
		<Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/uslugi/' }, ...(parent ? [parent] : []), { label: h1 }]} />

		{panel ? (
			<header class="svc-hero">
				<div class="svc-hero__text">
					<span class="svc-hero__tag">{tagline}</span>
					<h1 class="svc-hero__h1">{h1}</h1>
					{answer && (
						<section class="svc-hero__answer" aria-labelledby="svc-answer-title">
							<h2 id="svc-answer-title" class="svc-hero__answer-title">Коротко об услуге</h2>
							<p class="svc-hero__answer-text" set:html={answer} />
							{facts.length > 0 && (
								<ul class="svc-hero__facts">
									{facts.map((f) => <li>{f}</li>)}
								</ul>
							)}
						</section>
					)}
					<div class="svc-page__cta">
						<Button href="/zapros-kp/#lead-form" variant="accent" size="lg">Отправить чертёж на расчёт</Button>
						<Button href={`tel:${contacts.phoneTel}`} variant="on-dark" size="lg">{contacts.phone}</Button>
					</div>
				</div>
				<aside class="svc-hero__panel" aria-labelledby="svc-panel-head">
					<div id="svc-panel-head" class="svc-hero__panel-head">{panel.head}</div>
					<dl class="svc-hero__rows">
						{panel.items.map((it) => (
							<div class={`svc-hero__row${it.hi ? ' svc-hero__row--hi' : ''}`}>
								<dt>{it.k}</dt>
								<dd>{it.v}</dd>
							</div>
						))}
					</dl>
				</aside>
			</header>
		) : (
			<header class={`svc-page__hero${heroImage ? ' svc-page__hero--with-image' : ''}`}>
				<div class="svc-page__hero-text">
					<span class="svc-page__tag">{tagline}</span>
					<h1>{h1}</h1>
					{answer ? (
						<section class="svc-answer" aria-labelledby="svc-answer-title">
							<h2 id="svc-answer-title" class="svc-answer__title">Коротко об услуге</h2>
							<p class="svc-answer__text" set:html={answer} />
							{facts.length > 0 && (
								<ul class="svc-answer__facts">
									{facts.map((f) => <li>{f}</li>)}
								</ul>
							)}
						</section>
					) : (
						<p class="svc-page__lead" set:html={intro} />
					)}
					{/* Первый экран: сразу два способа обратиться — отправить чертёж или позвонить. */}
					<div class="svc-page__cta">
						<Button href="/zapros-kp/#lead-form" variant="accent" size="lg">Отправить чертёж на расчёт</Button>
						<Button href={`tel:${contacts.phoneTel}`} variant="secondary" size="lg">{contacts.phone}</Button>
					</div>
				</div>
				{heroImage && (
					<div class="svc-page__hero-media">
						<img src={heroImage} alt={heroImageAlt || h1} width="440" height="430" loading="eager" />
					</div>
				)}
			</header>
		)}
		{answer && <div class="svc-page__intro" set:html={intro} />}

		<section class="svc-page__block">
			<h2>{specsTitle}</h2>
			<dl class="svc-page__specs">
				{specs.map((s) => (
					<div class="svc-page__spec-row">
						<dt>{s.href ? <a class="svc-page__spec-link" href={s.href}>{s.label} →</a> : s.label}</dt>
						<dd>{s.value}</dd>
					</div>
				))}
			</dl>
		</section>

		<section class="svc-page__block">
			<h2>Материалы, с которыми работаем</h2>
			<ul class="svc-page__chips">
				{materials.map((m) => <li><span class="svc-page__chip">{m}</span></li>)}
			</ul>
		</section>

		<section class="svc-page__block">
			<h2>Применение</h2>
			<ul class="svc-page__list">
				{applications.map((a) => <li>{a}</li>)}
			</ul>
		</section>

		{limitations && limitations.length > 0 && (
			<section class="svc-page__block svc-page__block--note">
				<h2>Ограничения и нюансы</h2>
				<ul class="svc-page__list">
					{limitations.map((l) => <li>{l}</li>)}
				</ul>
			</section>
		)}

		<section class="svc-page__block">
			<h2>Как работаем</h2>
			<ol class="svc-page__steps">
				{process.map((p) => (
					<li class="svc-page__step">
						<span class="svc-page__step-n">{p.n}</span>
						<div>
							<h3>{p.title}</h3>
							<p>{p.text}</p>
						</div>
					</li>
				))}
			</ol>
		</section>

		{pricingNote && (
			<section class="svc-page__block svc-page__pricing">
				<h2>Стоимость</h2>
				<p set:html={pricingNote} />
				<p class="svc-page__pricing-cta">
					<a href="/zapros-kp/#lead-form">Отправить ТЗ — пришлём расчёт</a>
				</p>
			</section>
		)}

		<section class="svc-page__block">
			<h2>{relatedTitle}</h2>
			<ul class="svc-page__related">
				{relatedHubs.map((r) => (
					<li><a class="svc-page__related-link" href={r.href}>{r.label} →</a></li>
				))}
			</ul>
		</section>

		<section class="svc-page__block svc-page__faq">
			<h2>Частые вопросы</h2>
			<div class="svc-page__faq-list">
				{faq.map((f) => (
					<details class="svc-page__faq-item">
						<summary class="svc-page__faq-q">
							<span>{f.q}</span>
							<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p>{f.a}</p>
					</details>
				))}
			</div>
		</section>
	</div>

	<CtaSection
		title={`Запросить расчёт услуги «${h1.toLowerCase()}»`}
		text="Пришлите чертёж или опишите задачу — рассчитаем стоимость и сроки в течение часа."
	/>
</BaseLayout>

<style>
	.svc-page { padding-block: var(--space-8); min-width: 0; }
	.svc-page__hero { margin-bottom: var(--space-8); max-width: 80ch; }
	/* Тёмный первый экран в стиле превью услуги: слева H1, короткий ответ и
	   кнопки, справа список из service-panels.json. Цвета — как на превью
	   (scripts/make-blog-cover.mjs), чтобы страница и превью были одним целым. */
	.svc-hero {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(300px, 440px);
		gap: var(--space-7);
		align-items: center;
		padding: clamp(1.5rem, 4vw, 3.25rem);
		margin-bottom: var(--space-7);
		border-radius: 22px;
		overflow: hidden;
		color: #e7eef7;
		background:
			radial-gradient(55% 70% at 90% 0%, rgba(196, 101, 27, 0.26), transparent 60%),
			linear-gradient(135deg, #1c4b80 0%, #11304f 50%, #0a1f3d 100%);
		box-shadow: var(--shadow-md);
	}
	.svc-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(rgba(108, 125, 146, 0.12) 1px, transparent 1px),
			linear-gradient(90deg, rgba(108, 125, 146, 0.12) 1px, transparent 1px);
		background-size: 60px 60px;
		pointer-events: none;
	}
	.svc-hero::after {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 5px;
		background: #c4651b;
	}
	.svc-hero > * { position: relative; z-index: 1; min-width: 0; }
	.svc-hero__tag {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #f2a25c;
	}
	.svc-hero__h1 {
		color: #fff;
		margin: 0.6rem 0 0;
		font-size: clamp(1.9rem, 4vw, 3rem);
		line-height: 1.1;
	}
	.svc-hero__answer {
		margin-top: var(--space-5);
		padding-left: var(--space-4);
		border-left: 3px solid #c4651b;
	}
	.svc-hero__answer-title {
		font-size: 0.75rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #a5b1c4;
		margin: 0 0 0.45rem;
	}
	.svc-hero__answer-text { margin: 0; font-size: 1.05rem; line-height: 1.6; color: #dbe4ef; }
	.svc-hero__answer-text :global(strong) { color: #fff; }
	.svc-hero__facts {
		list-style: none;
		margin: var(--space-3) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: #fff;
	}
	.svc-hero__facts li::before { content: '✓'; margin-right: 0.4rem; color: #f2a25c; }
	.svc-hero__panel {
		background: rgba(10, 31, 61, 0.55);
		border: 1px solid rgba(108, 125, 146, 0.45);
		border-radius: 18px;
		padding: var(--space-5);
	}
	.svc-hero__panel-head {
		color: #f2a25c;
		font-weight: 700;
		font-size: 1.05rem;
		padding-bottom: var(--space-3);
		margin-bottom: var(--space-4);
		border-bottom: 1px solid rgba(108, 125, 146, 0.4);
	}
	.svc-hero__rows { margin: 0; display: grid; gap: 0.6rem; }
	.svc-hero__row {
		padding: 0.75rem 1rem;
		border-radius: 10px;
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(108, 125, 146, 0.35);
	}
	.svc-hero__row--hi { background: rgba(255, 255, 255, 0.12); border-color: #c4651b; }
	.svc-hero__row dt {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: #a5b1c4;
	}
	.svc-hero__row dd { margin: 0.2rem 0 0; font-size: 1.05rem; font-weight: 700; color: #fff; }
	@media (max-width: 900px) {
		.svc-hero { grid-template-columns: minmax(0, 1fr); gap: var(--space-5); }
	}

	/* Короткий ответ — как в статьях блога: его берут нейросети и быстрые ответы. */
	.svc-answer {
		background: var(--color-primary-50);
		border: 1px solid var(--color-primary-100);
		border-left: 4px solid var(--color-primary-500);
		border-radius: var(--radius-lg);
		padding: var(--space-4) var(--space-5);
		margin: var(--space-4) 0 0;
	}
	.svc-answer__title {
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-600);
		margin: 0 0 var(--space-2);
	}
	.svc-answer__text { font-size: 1.05rem; line-height: 1.6; margin: 0; color: var(--color-text); }
	.svc-answer__facts {
		list-style: none;
		margin: var(--space-3) 0 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.1rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-primary-600);
	}
	.svc-answer__facts li::before { content: '✓'; margin-right: 0.4rem; color: var(--color-accent-600); }

	.svc-page__cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
		margin-top: var(--space-5);
	}
	@media (max-width: 480px) {
		.svc-page__cta :global(.btn) { width: 100%; justify-content: center; }
	}

	.svc-page__intro { max-width: 80ch; margin-bottom: var(--space-8); color: var(--color-muted); line-height: 1.65; }
	.svc-page__intro :global(p) { margin: 0 0 var(--space-3); }
	.svc-page__hero--with-image {
		max-width: none;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
		gap: var(--space-6);
		align-items: center;
	}
	.svc-page__hero-media {
		display: flex;
		align-items: center;
		justify-content: center;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-4);
	}
	.svc-page__hero-media img {
		display: block;
		width: 100%;
		height: auto;
		max-width: 280px;
	}
	@media (max-width: 720px) {
		.svc-page__hero--with-image {
			grid-template-columns: 1fr;
			gap: var(--space-4);
		}
		.svc-page__hero-media {
			order: -1;
			max-width: 320px;
		}
	}
	.svc-page__tag {
		display: inline-block;
		font-size: 0.74rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-accent);
		margin-bottom: var(--space-2);
	}
	.svc-page__lead {
		font-size: 1.05rem;
		line-height: 1.65;
		max-width: 75ch;
		color: var(--color-text);
	}
	.svc-page__lead :global(p) {
		margin: 0 0 var(--space-3);
		color: var(--color-text);
	}

	.svc-page__block { margin-bottom: var(--space-8); }
	.svc-page__block h2 {
		font-size: 1.2rem;
		margin-bottom: var(--space-3);
	}
	.svc-page__block--note {
		background: var(--color-accent-100);
		border: 1px solid var(--color-accent);
		border-color: var(--color-accent);
		border-radius: var(--radius-md);
		padding: var(--space-4) var(--space-5);
	}
	.svc-page__block--note h2 { color: var(--color-accent-600); }

	.svc-page__specs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: var(--space-3);
		margin: 0;
		padding: var(--space-4);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
	}
	/* Каждая «строка» = ячейка с двумя уровнями (label / value), а не flex-row.
	   Это устойчиво к длинным значениям — они не дробятся по буквам, как
	   было при flex space-between с overflow-wrap: anywhere. */
	.svc-page__spec-row {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: var(--space-2) 0;
		border-bottom: 1px solid var(--color-border);
		min-width: 0;
	}
	.svc-page__spec-row:last-child { border-bottom: 0; }
	.svc-page__spec-row dt {
		font-size: 0.74rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-subtle);
	}
	.svc-page__spec-link { color: var(--color-primary-500); text-decoration: none; }
	.svc-page__spec-link:hover { text-decoration: underline; }
	.svc-page__spec-row dd {
		font-variant-numeric: tabular-nums;
		margin: 0;
		font-weight: 700;
		color: var(--color-text);
		font-size: 0.95rem;
		line-height: 1.3;
		overflow-wrap: break-word;
		min-width: 0;
	}

	.svc-page__chips {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
	}
	.svc-page__chip {
		display: inline-block;
		font-size: 0.85rem;
		font-weight: 600;
		padding: 0.35rem 0.75rem;
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
	}

	.svc-page__list {
		margin: 0;
