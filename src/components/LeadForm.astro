---
import Field from './ui/Field.astro';
import Button from './ui/Button.astro';
interface Props {
	id?: string;
}
const { id = 'lead-form' } = Astro.props;
---

<section class="lead" id={id} aria-labelledby="lead-title">
	<div class="container">
		<div class="lead__box">
			<div class="lead__copy">
				<h2 id="lead-title" class="lead__h">Оставьте заявку</h2>
				<p class="lead__promise">
					Менеджер свяжется в течение <strong>30 минут</strong> и предложит лучшие цены и сроки.
				</p>
				<p class="lead__sub">
					Цены на металлопрокат меняются ежедневно — чтобы узнать точную стоимость по вашему проекту, оставьте
					заявку.
				</p>
				<form class="lead__form" method="post" action="#" data-static-form>
					<Field label="Имя" name="name" required />
					<Field label="Телефон" name="phone" type="tel" required />
					<Field label="Email" name="email" type="email" required />
					<Field
						label="Описание заказа"
						name="message"
						rows={4}
						placeholder="Вид товара, марка стали, размеры, количество, дополнительные требования"
						required
					/>
					<label class="lead__consent">
						<input type="checkbox" name="consent_pd" required />
						<span>
							Я даю <a href="/soglasie/" target="_blank" rel="noopener">согласие на обработку
							персональных данных</a> (имя, телефон, e-mail) в целях обработки заявки
							в соответствии с <a href="/politika-konfidencialnosti/" target="_blank" rel="noopener">Политикой
							конфиденциальности</a>.
						</span>
					</label>
					<label class="lead__consent lead__consent--optional">
						<input type="checkbox" name="consent_marketing" value="yes" />
						<span>
							Согласен на получение информационных и рекламных сообщений
							о новинках, акциях и спецпредложениях ГК «Металлинвест» по e-mail,
							SMS и в мессенджерах (ч. 1 ст. 18 Федерального закона № 38-ФЗ
							«О рекламе»). Отказаться можно в любой момент по ссылке
							в письме или письмом на zakaz@gkmetallinvest.ru.
						</span>
					</label>
					<Button type="submit">Отправить заявку</Button>
				</form>
			</div>
			<div class="lead__map" aria-label="Карта офиса ГК Металлинвест">
				<iframe
					src="https://yandex.ru/map-widget/v1/?text=%D0%9D%D0%B8%D0%B6%D0%BD%D0%B8%D0%B9%20%D0%9D%D0%BE%D0%B2%D0%B3%D0%BE%D1%80%D0%BE%D0%B4%2C%20%D1%83%D0%BB.%20%D0%92%D0%B0%D1%80%D0%B2%D0%B0%D1%80%D1%81%D0%BA%D0%B0%D1%8F%2C%2032&z=17"
					width="100%"
					height="100%"
					frameborder="0"
					allowfullscreen="true"
					loading="lazy"
					title="Карта: 603006, Нижний Новгород, ул. Варварская, 32"
				></iframe>
				<a
					class="lead__map-link"
					href="https://yandex.ru/maps/-/CPSRJLLQ"
					target="_blank"
					rel="noopener"
				>
					Открыть в Яндекс.Картах →
				</a>
			</div>
		</div>
	</div>
</section>

<style>
	.lead {
		padding: var(--space-12) 0;
	}
	.lead__box {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
		overflow: hidden;
	}
	@media (min-width: 880px) {
		.lead__box {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		}
	}
	.lead__copy {
		padding: var(--space-8);
	}
	.lead__h {
		margin-bottom: var(--space-2);
	}
	.lead__promise {
		margin: 0 0 var(--space-2);
		font-size: 1rem;
		color: var(--color-text);
		max-width: none;
	}
	.lead__promise strong {
		color: var(--color-accent);
	}
	.lead__sub {
		margin: 0 0 var(--space-6);
		font-size: 0.95rem;
	}
	.lead__consent {
		display: flex;
		align-items: flex-start;
		gap: 0.6rem;
		margin: 0 0 var(--space-4);
		font-size: 0.78rem;
		line-height: 1.5;
		color: var(--color-muted);
		cursor: pointer;
	}
	.lead__consent input[type='checkbox'] {
		flex-shrink: 0;
		width: 16px;
		height: 16px;
		margin-top: 2px;
		accent-color: var(--color-primary-500, #2c63a8);
		cursor: pointer;
	}
	.lead__consent span { max-width: 56ch; }
	.lead__consent a { color: var(--color-primary-600); }
	.lead__consent a:hover { text-decoration: underline; }
	.lead__consent--optional { margin-top: calc(var(--space-2) * -1); }
	.lead__consent--optional span { color: var(--color-subtle, #6c7686); }
	.lead__map {
		position: relative;
		min-height: 360px;
		background: var(--color-surface-alt, #f1f4f8);
		border-top: 1px solid var(--color-border);
	}
	@media (min-width: 880px) {
		.lead__map {
			border-top: none;
			border-left: 1px solid var(--color-border);
			min-height: 100%;
		}
	}
	.lead__map iframe {
		width: 100%;
		height: 100%;
		min-height: 360px;
		display: block;
		border: 0;
	}
	.lead__map-link {
		position: absolute;
		left: var(--space-4);
		bottom: var(--space-4);
		padding: 0.45rem 0.8rem;
		font-size: 0.78rem;
		font-weight: 500;
		color: var(--color-text);
		background: rgba(255, 255, 255, 0.94);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		text-decoration: none;
		box-shadow: var(--shadow-sm);
		backdrop-filter: blur(6px);
	}
	.lead__map-link:hover {
		background: #fff;
	}
</style>
