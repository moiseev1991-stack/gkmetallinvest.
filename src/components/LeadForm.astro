---
import Field from './ui/Field.astro';
import Button from './ui/Button.astro';
interface Props {
	id?: string;
}
const { id = 'lead-form' } = Astro.props;
---

<section class="lead" id={id} aria-labelledby="lead-title">
	<div class="container lead__box">
		<h2 id="lead-title" class="lead__h">Оставьте заявку</h2>
		<p class="lead__promise">
			Менеджер свяжется в течение <strong>30 минут</strong> и предложит лучшие цены и сроки.
		</p>
		<p class="lead__sub">
			Цены на металлопрокат меняются ежедневно — чтобы узнать точную стоимость по вашему проекту, оставьте
			заявку.
		</p>
		<form class="lead__form" method="post" action="#" data-static-form>
			<Field label="Имя" name="name" required />
			<Field label="Телефон" name="phone" type="tel" required />
			<Field label="Email" name="email" type="email" required />
			<Field
				label="Описание заказа"
				name="message"
				rows={4}
				placeholder="Вид товара, марка стали, размеры, количество, дополнительные требования"
				required
			/>
			<p class="lead__privacy">
				Нажимая «Отправить», вы соглашаетесь с
				<a href="/politika-konfidencialnosti/">политикой конфиденциальности</a>
				и обработкой персональных данных.
			</p>
			<Button type="submit">Отправить заявку</Button>
		</form>
	</div>
</section>

<style>
	.lead {
		padding: var(--space-12) 0;
	}
	.lead__box {
		max-width: 560px;
		margin-inline: auto;
		padding: var(--space-8);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-sm);
	}
	.lead__h {
		margin-bottom: var(--space-2);
	}
	.lead__promise {
		margin: 0 0 var(--space-2);
		font-size: 1rem;
		color: var(--color-text);
		max-width: none;
	}
	.lead__promise strong {
		color: var(--color-accent);
	}
	.lead__sub {
		margin: 0 0 var(--space-6);
		font-size: 0.95rem;
	}
	.lead__privacy {
		font-size: 0.75rem;
		color: var(--color-muted);
		margin: 0 0 var(--space-4);
		max-width: none;
	}
</style>
