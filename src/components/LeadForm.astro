---
import Field from './ui/Field.astro';
import Button from './ui/Button.astro';
import { offices, officeMapSrc, officeFullAddress } from '../data/offices';
interface Props {
	id?: string;
}
const { id = 'lead-form' } = Astro.props;

// Города для переключателя офиса (карта + адрес меняются на клиенте).
const mapsUrl = (query: string) =>
	`https://yandex.ru/maps/?text=${encodeURIComponent(query)}`;
const defaultOffice = offices[0];
---

<section class="lead" id={id} aria-labelledby="lead-title">
	<div class="container">
		<div class="lead__box">
			<div class="lead__copy">
				<h2 id="lead-title" class="lead__h">Оставьте заявку</h2>
				<p class="lead__promise">
					Менеджер свяжется в течение <strong>30 минут</strong> и предложит лучшие цены и сроки.
				</p>
				<p class="lead__sub">
					Цены на металлопрокат меняются ежедневно — чтобы узнать точную стоимость по вашему проекту, оставьте
					заявку.
				</p>
				<div class="lead__office">
					<label class="lead__region-label" for="lead-region">Ваш город:</label>
					<select id="lead-region" class="lead__region" aria-label="Выберите ближайший офис">
						{offices.map((office, i) => (
							<option
								value={office.slug}
								data-src={officeMapSrc(office)}
								data-address={officeFullAddress(office)}
								data-maps={mapsUrl(office.mapQuery)}
								selected={i === 0}
							>{office.menuCity || office.city}</option>
						))}
					</select>
					<p class="lead__address">
						Ближайший офис: <span id="lead-address">{officeFullAddress(defaultOffice)}</span>
					</p>
				</div>
				<form class="lead__form" method="post" action="/send.php" enctype="multipart/form-data" data-lead-form>
					<input
						class="lead__hp"
						type="text"
						name="company_site"
						tabindex="-1"
						autocomplete="off"
						aria-hidden="true"
					/>
					<input type="hidden" name="page" value="" />
					<input type="hidden" name="city" value="" />
					<Field label="Имя" name="name" required />
					<Field label="Телефон" name="phone" type="tel" required />
					<Field label="Email (необязательно)" name="email" type="email" />
					<Field
						label="Описание заказа"
						name="message"
						rows={4}
						placeholder="Вид товара, марка стали, размеры, количество, дополнительные требования"
						required
					/>
					<div class="lead__file">
						<label class="lead__file-label" for="lead-attachment">Прикрепить файл <span>(необязательно)</span></label>
						<input
							id="lead-attachment"
							class="lead__file-input"
							type="file"
							name="attachment"
							accept=".pdf,.txt,.doc,.docx,.xls,.xlsx,.csv,.jpg,.jpeg,.png"
							data-lead-file
						/>
						<p class="lead__file-hint">Спецификация, чертёж или список: PDF, TXT, Word, Excel, JPG, PNG, до 5 МБ.</p>
					</div>
					<label class="lead__consent">
						<input type="checkbox" name="consent_pd" required />
						<span>
							Я даю <a href="/soglasie/" target="_blank" rel="noopener">согласие на обработку
							персональных данных</a> (имя, телефон, e-mail) в целях обработки заявки
							в соответствии с <a href="/politika-konfidencialnosti/" target="_blank" rel="noopener">Политикой
							конфиденциальности</a>.
						</span>
					</label>
					<label class="lead__consent lead__consent--optional">
						<input type="checkbox" name="consent_marketing" value="yes" />
						<span>
							Согласен на получение информационных и рекламных сообщений
							о новинках, акциях и спецпредложениях ГК «Металлинвест» по e-mail,
							SMS и в мессенджерах (ч. 1 ст. 18 Федерального закона № 38-ФЗ
							«О рекламе»). Отказаться можно в любой момент по ссылке
							в письме или письмом на zakaz@gkmetallinvest.ru.
						</span>
					</label>
					<div id={`${id}-captcha`} data-lead-captcha></div>
					{(import.meta.env.PUBLIC_RECAPTCHA_SITEKEY || import.meta.env.PUBLIC_SMARTCAPTCHA_SITEKEY) && (
						<p class="lead__captcha-note">
							{import.meta.env.PUBLIC_RECAPTCHA_SITEKEY ? (
								<>
									Форма защищена reCAPTCHA: действуют
									<a href="https://policies.google.com/privacy" target="_blank" rel="noopener">Политика конфиденциальности</a>
									и
									<a href="https://policies.google.com/terms" target="_blank" rel="noopener">Условия использования</a> Google.
								</>
							) : (
								<>Форма защищена Яндекс SmartCaptcha.</>
							)}
						</p>
					)}
					<Button type="submit">Отправить заявку</Button>
					<p class="lead__status" data-lead-status hidden role="status" aria-live="polite"></p>
					<script is:inline>
						// Пока основной скрипт формы не загрузился, кнопка неактивна: иначе браузер отправил бы форму
						// обычным способом, мимо проверок и капчи. Основной скрипт снимает блокировку при запуске.
						(function () {
							var f = document.currentScript && document.currentScript.closest('form');
							var b = f && f.querySelector('button[type="submit"]');
							if (!b) return;
							b.disabled = true;
							b.setAttribute('data-lead-wait', '1');
							setTimeout(function () {
								var s = f.querySelector('[data-lead-status]');
								if (b.hasAttribute('data-lead-wait') && s) {
									s.textContent = 'Форма ещё загружается. Если кнопка не нажимается, обновите страницу или напишите на zakaz@gkmetallinvest.ru';
									s.hidden = false;
									s.className = 'lead__status is-err';
								}
							}, 20000);
						})();
					</script>
				</form>
				<dialog class="lead-modal" data-lead-modal aria-labelledby="lead-modal-title">
					<div class="lead-modal__box">
						<h3 id="lead-modal-title" class="lead-modal__title">Спасибо!</h3>
						<p class="lead-modal__text">Ваше сообщение отправлено. Менеджер свяжется с вами в течение 30 минут.</p>
						<button type="button" class="lead-modal__close" data-lead-modal-close>Закрыть</button>
					</div>
				</dialog>
			</div>
			<div class="lead__map" aria-label="Карта офиса ГК Металлинвест">
				<iframe
					id="lead-map-frame"
					src={officeMapSrc(defaultOffice)}
					width="100%"
					height="100%"
					frameborder="0"
					allowfullscreen="true"
					loading="lazy"
					title="Карта офиса ГК Металлинвест"
				></iframe>
				<a
					id="lead-map-link"
					class="lead__map-link"
					href={mapsUrl(defaultOffice.mapQuery)}
					target="_blank"
					rel="noopener"
				>
					Открыть в Яндекс.Картах →
				</a>
			</div>
		</div>
	</div>
</section>

<script>
	// Переключение офиса: меняем карту, адрес и ссылку по выбранному городу.
	// Синхронизировано с переключателем города в шапке через общий ключ
	// localStorage 'mi_city' и событие 'mi:city' (выбрал в шапке → тут тоже сменилось).
	{
		const CITY_KEY = 'mi_city';
		const region = document.getElementById('lead-region') as HTMLSelectElement | null;
		const frame = document.getElementById('lead-map-frame') as HTMLIFrameElement | null;
		const address = document.getElementById('lead-address');
		const mapLink = document.getElementById('lead-map-link') as HTMLAnchorElement | null;

		const applyOption = (opt: HTMLOptionElement | undefined) => {
			if (!opt) return;
			if (frame && opt.dataset.src) frame.src = opt.dataset.src;
			if (address && opt.dataset.address) address.textContent = opt.dataset.address;
			if (mapLink && opt.dataset.maps) mapLink.href = opt.dataset.maps;
		};

		const syncTo = (slug: string) => {
			if (!region || region.value === slug) return;
			const opt = Array.from(region.options).find((o) => o.value === slug);
			if (opt) {
				region.value = slug;
				applyOption(opt);
			}
		};

		if (region) {
			// Восстанавливаем ранее выбранный город (тот же ключ, что и в шапке).
			const saved = localStorage.getItem(CITY_KEY);
			if (saved) syncTo(saved);

			region.addEventListener('change', () => {
				const opt = region.options[region.selectedIndex];
				localStorage.setItem(CITY_KEY, region.value);
				applyOption(opt);
				document.dispatchEvent(new CustomEvent('mi:city', { detail: { slug: region.value } }));
			});
		}

		// Город сменили в шапке — подхватываем карту/адрес здесь.
		document.addEventListener('mi:city', (e) => {
			const slug = (e as CustomEvent<{ slug: string }>).detail?.slug;
			if (slug) syncTo(slug);
		});
	}

	// Roistat («Заявки с форм сайта») перехватывает отправку формы и после передачи лида у себя вызывает
	// HTMLFormElement.prototype.submit: браузер уходит на /send.php мимо нашей отправки, валидации и капчи
	// (человек видит голый ответ сервера, а наш fetch обрывается). Для нашей формы такой вызов гасим:
	// заявку отправляет только обработчик ниже.
	const nativeFormSubmit = HTMLFormElement.prototype.submit;
	HTMLFormElement.prototype.submit = function (this: HTMLFormElement) {
		if (this.hasAttribute('data-lead-form')) return;
		return nativeFormSubmit.call(this);
	};

	// Отправка заявки на /send.php (PHP-обработчик на Timeweb) без перезагрузки.
	document.querySelectorAll<HTMLFormElement>('form[data-lead-form]').forEach((form) => {
		const status = form.querySelector<HTMLElement>('[data-lead-status]');
		const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');

		const setStatus = (text: string, kind: 'ok' | 'err' | '') => {
			if (!status) return;
			status.textContent = text;
			status.hidden = !text;
			status.classList.toggle('is-ok', kind === 'ok');
			status.classList.toggle('is-err', kind === 'err');
		};

		// Скрипт загрузился и обработчик ниже подключён: снимаем блокировку кнопки (её ставит встроенный скрипт формы).
		if (btn?.hasAttribute('data-lead-wait')) {
			btn.disabled = false;
			btn.removeAttribute('data-lead-wait');
			setStatus('', '');
		}

		// Всплывающее окно «Спасибо» поверх формы после успешной отправки.
		const modal = form.parentElement?.querySelector<HTMLDialogElement>('dialog[data-lead-modal]') ?? null;
		const showThanks = (): boolean => {
			if (!modal || typeof modal.showModal !== 'function') return false;
			try {
				if (!modal.open) modal.showModal();
				return true;
			} catch {
				return false;
			}
		};
		modal?.querySelector('[data-lead-modal-close]')?.addEventListener('click', () => modal.close());
		modal?.addEventListener('click', (e) => {
			// клик по затемнению вокруг окна закрывает его
			if (e.target === modal) modal.close();
		});

		// Вложение: до 5 МБ и только разрешённые форматы (сервер проверяет ещё раз).
		const MAX_FILE = 5 * 1024 * 1024;
		const ALLOWED = ['pdf', 'txt', 'doc', 'docx', 'xls', 'xlsx', 'csv', 'jpg', 'jpeg', 'png'];
		const fileInput = form.querySelector<HTMLInputElement>('input[data-lead-file]');
		const fileProblem = (): string => {
			const f = fileInput?.files?.[0];
			if (!f) return '';
			const ext = (f.name.split('.').pop() || '').toLowerCase();
			if (!ALLOWED.includes(ext)) return 'Этот формат файла не принимаем. Приложите PDF, TXT, Word, Excel, JPG или PNG.';
			if (f.size > MAX_FILE) return 'Файл больше 5 МБ. Приложите файл меньшего размера или отправьте его на zakaz@gkmetallinvest.ru';
			return '';
		};
		fileInput?.addEventListener('change', () => {
			const problem = fileProblem();
			if (problem && fileInput) fileInput.value = '';
			setStatus(problem, problem ? 'err' : '');
		});

		const SERVER_ERRORS: Record<string, string> = {
			file_size: 'Файл больше 5 МБ. Приложите файл меньшего размера или отправьте его на zakaz@gkmetallinvest.ru',
			file_type: 'Этот формат файла не принимаем. Приложите PDF, TXT, Word, Excel, JPG или PNG.',
			file: 'Не удалось принять файл. Попробуйте другой файл или отправьте заявку без него.',
			captcha: 'Проверка «я не робот» не пройдена. Обновите страницу и попробуйте ещё раз или напишите на zakaz@gkmetallinvest.ru',
		};

		// Капча (невидимая). Провайдер выбирается ключом, заданным при сборке:
		//   PUBLIC_RECAPTCHA_SITEKEY    — Google reCAPTCHA v3 (приоритет);
		//   PUBLIC_SMARTCAPTCHA_SITEKEY — Яндекс SmartCaptcha.
		// Сервер при этом требует токен (send-config.php: captcha_provider/captcha_secret).
		// Без ключей капчи нет и форма работает как раньше.
		const RC_KEY = (import.meta.env.PUBLIC_RECAPTCHA_SITEKEY as string | undefined) || '';
		const YC_KEY = (import.meta.env.PUBLIC_SMARTCAPTCHA_SITEKEY as string | undefined) || '';
		const CAPTCHA: '' | 'google' | 'yandex' = RC_KEY ? 'google' : YC_KEY ? 'yandex' : '';
		const captchaBox = form.querySelector<HTMLElement>('[data-lead-captcha]');
		const CAPTCHA_FAIL =
			'Не удалось пройти проверку «я не робот». Попробуйте ещё раз или напишите на zakaz@gkmetallinvest.ru';
		let captchaLoading: Promise<void> | null = null;

		// Скрипт капчи грузим с таймаутом: если google.com/Яндекс недоступен или завис, форма не должна висеть.
		const addScript = (src: string, timeoutMs = 10000): Promise<boolean> =>
			new Promise<boolean>((resolve) => {
				const s = document.createElement('script');
				const t = setTimeout(() => resolve(false), timeoutMs);
				s.src = src;
				s.async = true;
				s.onload = () => {
					clearTimeout(t);
					resolve(true);
				};
				s.onerror = () => {
					clearTimeout(t);
					resolve(false);
				};
				document.head.appendChild(s);
			});

		// Яндекс SmartCaptcha: виджет рисуется один раз, токен берётся через execute().
		let ycId: number | null = null;
		let ycWait: ((token: string) => void) | null = null;
		const loadYandex = async (): Promise<void> => {
			const w = window as any;
			if (!w.smartCaptcha) await addScript('https://smartcaptcha.cloud.yandex.ru/captcha.js');
			try {
				if (w.smartCaptcha && ycId === null && captchaBox) {
					ycId = w.smartCaptcha.render(captchaBox.id, {
						sitekey: YC_KEY,
						invisible: true,
						hl: 'ru',
						callback: (token: string) => {
							ycWait?.(token);
						},
					});
				}
			} catch {
				// виджет не поднялся: заявка уйдёт без токена, форма покажет понятную ошибку
			}
		};
		const yandexToken = (): Promise<string> => {
			const w = window as any;
			if (ycId === null || !w.smartCaptcha) return Promise.resolve('');
			return new Promise<string>((resolve) => {
				const t = setTimeout(() => {
					ycWait = null;
					resolve('');
				}, 60000);
				ycWait = (token) => {
					clearTimeout(t);
					ycWait = null;
					resolve(token);
				};
				try {
					w.smartCaptcha.execute(ycId);
				} catch {
					clearTimeout(t);
					ycWait = null;
					resolve('');
				}
			});
		};

		// Google reCAPTCHA v3: токен живёт 2 минуты, поэтому запрашиваем его в момент отправки.
		const loadGoogle = async (): Promise<void> => {
			const w = window as any;
			if (w.grecaptcha?.execute) return;
			const q = '/recaptcha/api.js?render=' + encodeURIComponent(RC_KEY);
			// google.com, а при недоступности — зеркало recaptcha.net
			if (!(await addScript('https://www.google.com' + q))) await addScript('https://www.recaptcha.net' + q);
		};
		const googleToken = (): Promise<string> => {
			const g = (window as any).grecaptcha;
			if (!g || !g.ready) return Promise.resolve('');
			return new Promise<string>((resolve) => {
				const t = setTimeout(() => resolve(''), 15000);
				g.ready(() => {
					g.execute(RC_KEY, { action: 'lead' }).then(
						(token: string) => {
							clearTimeout(t);
							resolve(token);
						},
						() => {
							clearTimeout(t);
							resolve('');
						},
					);
				});
			});
		};

		const loadCaptcha = (): Promise<void> => {
			if (!CAPTCHA) return Promise.resolve();
			if (!captchaLoading) captchaLoading = CAPTCHA === 'google' ? loadGoogle() : loadYandex();
			return captchaLoading;
		};
		if (CAPTCHA) {
			// Подгружаем заранее, как только человек начал заполнять форму.
			form.addEventListener('focusin', () => void loadCaptcha(), { once: true });
		}
		const getCaptchaToken = async (): Promise<{ field: string; token: string }> => {
			await loadCaptcha();
			return CAPTCHA === 'google'
				? { field: 'g-recaptcha-response', token: await googleToken() }
				: { field: 'smart-token', token: await yandexToken() };
		};
		const resetCaptcha = () => {
			const w = window as any;
			if (CAPTCHA !== 'yandex' || ycId === null || !w.smartCaptcha) return;
			try {
				w.smartCaptcha.reset(ycId);
			} catch {
				// не критично: токен одноразовый, следующая отправка создаст новый
			}
		};

		// Фото сжимаем в браузере (до 2400 px, JPEG): письмо легче, загрузка быстрее и реже обрывается.
		const COMPRESS_FROM = 700 * 1024;
		const compressImage = async (file: File): Promise<File> => {
			const ext = (file.name.split('.').pop() || '').toLowerCase();
			if (!['jpg', 'jpeg', 'png'].includes(ext) || file.size <= COMPRESS_FROM) return file;
			try {
				const bmp = await createImageBitmap(file);
				const k = Math.min(1, 2400 / Math.max(bmp.width, bmp.height));
				const w = Math.max(1, Math.round(bmp.width * k));
				const h = Math.max(1, Math.round(bmp.height * k));
				const canvas = document.createElement('canvas');
				canvas.width = w;
				canvas.height = h;
				const ctx = canvas.getContext('2d');
				if (!ctx) return file;
				ctx.fillStyle = '#fff';
				ctx.fillRect(0, 0, w, h);
				ctx.drawImage(bmp, 0, 0, w, h);
				bmp.close?.();
				const blob = await new Promise<Blob | null>((res) => canvas.toBlob(res, 'image/jpeg', 0.85));
				if (!blob || blob.size >= file.size) return file;
				const base = file.name.replace(/\.[^.]+$/, '') || 'foto';
				return new File([blob], base + '.jpg', { type: 'image/jpeg' });
			} catch {
				return file;
			}
		};

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			if (!form.checkValidity()) {
				form.reportValidity();
				return;
			}
			const problem = fileProblem();
			if (problem) {
				setStatus(problem, 'err');
				return;
			}

			// Подставляем страницу и выбранный город в скрытые поля.
			const pageEl = form.querySelector<HTMLInputElement>('input[name="page"]');
			if (pageEl) pageEl.value = location.pathname + location.search;
			const cityEl = form.querySelector<HTMLInputElement>('input[name="city"]');
			const region = document.getElementById('lead-region') as HTMLSelectElement | null;
			if (cityEl && region) {
				cityEl.value = region.options[region.selectedIndex]?.text || region.value;
			}

			const label = btn?.textContent || 'Отправить заявку';
			if (btn) { btn.disabled = true; btn.textContent = 'Отправляем…'; }
			setStatus('', '');

			const ctrl = new AbortController();
			let timer: ReturnType<typeof setTimeout> | undefined;
			try {
				const fd = new FormData(form);
				const picked = fd.get('attachment');
				if (picked instanceof File && picked.size > 0) {
					fd.set('attachment', await compressImage(picked));
				}
				if (CAPTCHA) {
					const { field, token } = await getCaptchaToken();
					if (!token) {
						setStatus(CAPTCHA_FAIL, 'err');
						return;
					}
					fd.set(field, token);
				}
				timer = setTimeout(() => ctrl.abort(), 90000);
				const res = await fetch(form.action, {
					method: 'POST',
					body: fd,
					headers: { Accept: 'application/json' },
					signal: ctrl.signal,
				});
				const json = await res.json().catch(() => ({ ok: false }));
				if (res.ok && json.ok) {
					form.reset();
					if (showThanks()) setStatus('', '');
					else setStatus('Заявка отправлена! Менеджер свяжется с вами в течение 30 минут.', 'ok');
				} else {
					setStatus(
						SERVER_ERRORS[json.error as string] ||
							'Не удалось отправить. Позвоните нам или напишите на zakaz@gkmetallinvest.ru',
						'err',
					);
				}
			} catch {
				setStatus(
					'Сервер сейчас отвечает медленно. Данные в форме сохранены: нажмите «Отправить» ещё раз или напишите на zakaz@gkmetallinvest.ru',
					'err',
				);
			} finally {
				clearTimeout(timer);
