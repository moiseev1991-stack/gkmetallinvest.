---
interface Props {
	name: string;
	size?: number;
	class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props;
const sw = 1.6;
---

{name === 'tube' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<ellipse cx="6" cy="6" rx="3.5" ry="2" stroke="currentColor" stroke-width={sw} />
		<ellipse cx="6" cy="6" rx="1.4" ry="0.8" stroke="currentColor" stroke-width={sw} />
		<path d="M2.5 6v12c0 1.1 1.6 2 3.5 2s3.5-.9 3.5-2V6" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
		<ellipse cx="17" cy="9" rx="3.5" ry="2" stroke="currentColor" stroke-width={sw} />
		<ellipse cx="17" cy="9" rx="1.4" ry="0.8" stroke="currentColor" stroke-width={sw} />
		<path d="M13.5 9v9c0 1.1 1.6 2 3.5 2s3.5-.9 3.5-2V9" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
	</svg>
)}

{name === 'cut-sheet' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<rect x="3" y="6" width="14" height="12" rx="1.5" stroke="currentColor" stroke-width={sw} />
		<path d="M3 11h14M3 14h14" stroke="currentColor" stroke-width={sw} stroke-dasharray="2 2" stroke-linecap="round" />
		<path d="M19 4l3 3-7 7-3-3z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" fill="none" />
		<path d="M16 7l3 3" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
	</svg>
)}

{name === 'strip' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<circle cx="7" cy="12" r="5" stroke="currentColor" stroke-width={sw} />
		<circle cx="7" cy="12" r="1.6" stroke="currentColor" stroke-width={sw} />
		<path d="M12 9.5h9M12 12h9M12 14.5h9" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
		<path d="M19 4l2 2-2 2M19 16l2 2-2 2" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0" />
	</svg>
)}

{name === 'grind' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<rect x="3" y="6" width="18" height="12" rx="1.5" stroke="currentColor" stroke-width={sw} />
		<circle cx="7.5" cy="10" r="0.9" fill="currentColor" />
		<circle cx="12" cy="10" r="0.9" fill="currentColor" />
		<circle cx="16.5" cy="10" r="0.9" fill="currentColor" />
		<circle cx="7.5" cy="14" r="0.9" fill="currentColor" />
		<circle cx="12" cy="14" r="0.9" fill="currentColor" />
		<circle cx="16.5" cy="14" r="0.9" fill="currentColor" />
	</svg>
)}

{name === 'warehouse' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<path d="M3 10l9-5 9 5v10H3z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M7 20v-6h10v6" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M7 17h10" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
	</svg>
)}

{name === 'gear' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<circle cx="12" cy="12" r="3.2" stroke="currentColor" stroke-width={sw} />
		<path d="M12 2.5v3M12 18.5v3M2.5 12h3M18.5 12h3M5.2 5.2l2.1 2.1M16.7 16.7l2.1 2.1M5.2 18.8l2.1-2.1M16.7 7.3l2.1-2.1" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
	</svg>
)}

{name === 'globe' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width={sw} />
		<path d="M3 12h18M12 3c2.8 3 4 6 4 9s-1.2 6-4 9c-2.8-3-4-6-4-9s1.2-6 4-9z" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}

{name === 'truck-fast' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<path d="M3 16V7h11v9" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M14 10h4l3 3v3h-7z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<circle cx="7.5" cy="17.5" r="1.7" stroke="currentColor" stroke-width={sw} />
		<circle cx="17" cy="17.5" r="1.7" stroke="currentColor" stroke-width={sw} />
		<path d="M1 10h4M1 13h3" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
	</svg>
)}

{name === 'handshake' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<path d="M3 13l3-3 3 1 3-2 3 2 3-1 3 3" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M9 14l2.5-2.5a1.4 1.4 0 012 0l3.5 3.5-1.3 1.3a1.4 1.4 0 01-2 0L11 14" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M14 17.3l1 1a1.3 1.3 0 002-.1M16 19.3a1.3 1.3 0 002 0l.5-.5" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
	</svg>
)}

{name === 'layers' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<path d="M12 3l9 5-9 5-9-5z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M3 12l9 5 9-5M3 16l9 5 9-5" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
	</svg>
)}

{name === 'scale' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<path d="M12 3v17M5 20h14" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
		<path d="M5 6l-2.5 6h5z M19 6l-2.5 6h5z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M5 6l7-1 7 1" stroke="currentColor" stroke-width={sw} stroke-linecap="round" />
	</svg>
)}

{name === 'shield-check' && (
	<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="none" class={cls} aria-hidden="true">
		<path d="M12 3l8 3v6c0 4.5-3.4 8.4-8 9.5-4.6-1.1-8-5-8-9.5V6z" stroke="currentColor" stroke-width={sw} stroke-linejoin="round" />
		<path d="M8.5 12l2.5 2.5L16 9.5" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round" />
	</svg>
)}
