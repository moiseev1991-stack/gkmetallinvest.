---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaSection from './CtaSection.astro';
import pricelist from '../data/pricelist.json';
import { getHubSkus, getDetailDimensions, getSkuSeoBits } from '../data/pricelist-helpers';
import { catalogImage } from '../data/catalog-images.mjs';
import { siteName, siteUrl, contacts } from '../data/site';
import { cities } from '../data/cities';

interface SKU {
	hub: string;
	sub: string;
	grade: string;
	roll: string | null;
	alloy: string | null;
	surface: string | null;
	size: string;
	unit: string;
	price: number | null;
	priceUnit?: number | null;
	slug: string;
	name?: string;
	dlina?: string | null;
	fact?: string | null;
	ostatok?: number | null;
	/* Только для полосы: добавляются normalizePolosaSku в pricelist-helpers. */
	width?: number;
	thickness?: number;
}

interface Props {
	sku: SKU;
	hubLabel: string;
	hubHref: string;
	measureLabel: string;
}

const { sku, hubLabel, hubHref, measureLabel } = Astro.props;

const SUB_LABELS: Record<string, string> = {
	// list / rulon / polosa
	nikelesod: 'Никелесодержащий',
	beznikelya: 'Без никеля',
	duplex: 'Дуплекс',
	profnastil: 'Профнастил',
	pvl: 'ПВЛ — просечно-вытяжной',
	// krug
	zharoprochnyj: 'Жаропрочный',
	kvadrat: 'Квадрат',
	nikelevyj: 'Никелесодержащий',
	shestigrannik: 'Шестигранник',
	// truba
	besshovnaya: 'Бесшовная',
	elsvarnaya: 'Электросварная',
	'elsvarnaya-kvadrat': 'Электросварная квадратная',
	'elsvarnaya-pryamougolnaya': 'Электросварная прямоугольная',
	perforirovannaya: 'Перфорированная',
	// provoloka
	osnovnaya: 'Проволока',
	// ugolok-shveller
	shveller: 'Швеллер',
	ugolok: 'Уголок',
	'ugolok-ravnopolochnyy': 'Уголок равнополочный',
	'ugolok-neravnopolochnyy': 'Уголок неравнополочный',
	'shveller-gnutyy': 'Швеллер гнутый',
	// detali-truboprovoda
	flanec: 'Фланец',
	'flanec-nastennyy': 'Фланец настенный',
	otvod: 'Отвод',
	troynik: 'Тройник',
	perehod: 'Переход',
	zaglushka: 'Заглушка поручня',
	zadvizhka: 'Задвижка',
	klapan: 'Клапан',
	povoroty: 'Отвод поручня',
	nakonechniki: 'Наконечник',
	// detali-truboprovoda — ограждения / лестничные элементы
	'dekorativnyy-niz': 'Декоративный низ',
	'derzhatel-rigelya': 'Держатель ригеля',
	'krepleniya-stoek': 'Крепление стоек',
	'lestn-osnovnye': 'Лестничные элементы',
	pristennye: 'Пристенный крепёж',
	stekloderzhateli: 'Стеклодержатель',
};

const subLabel = SUB_LABELS[sku.sub] ?? sku.sub;
const surface = sku.surface ?? '';
const roll = sku.roll ?? '';

/* Фактические описания типов фитингов — взяты из текстов на хабе
   /detali-truboprovoda/index.astro. Для ограждений (lestn-osnovnye,
   povoroty, derzhatel-rigelya и т.п.) описания не делаем — нет
   проверенного источника. */
const SUB_DESCRIPTIONS: Record<string, string> = {
	otvod: 'Гнутые и штампованные элементы для поворота трассы трубопровода под углами 45°, 60°, 90°, реже 180°. Бесшовные крутоизогнутые — ГОСТ 17375 (R = 1,0–1,5 Ду), штампосварные — ГОСТ 30753, малого Ду — ГОСТ 17380. Сохраняют проходное сечение и работают наравне с трубой по давлению.',
	flanec: 'Плоские приварные (тип 01, ГОСТ 33259, ранее ГОСТ 12820) и воротниковые приварные встык (тип 11, ГОСТ 33259, ранее ГОСТ 12821). Условные давления Ру 6 / 10 / 16 / 25 / 40 атм. Плоский фланец проще в монтаже на низких давлениях, воротниковый держит Ру 25–40 и циклические нагрузки на встыковом шве.',
	'flanec-nastennyy': 'Декоративный фланец для крепления нержавеющих стоек ограждения к стене или полу. Скрывает точку крепления и придаёт сборке завершённый вид. Под стандартный диаметр стойки 38/42/50,8 мм.',
	troynik: 'Узловая деталь для ответвления магистрали под 90°. Равнопроходные (Т-образные, диаметр магистрали равен диаметру отвода) и переходные (с уменьшенным боковым отводом). ГОСТ 17376 на бесшовные крутоизогнутые. Применяются на коллекторах пара и горячей воды, парораздаточных гребёнках, обвязке теплообменников.',
	perehod: 'Фасонная деталь для соединения труб разных диаметров. Концентрические — соосные, для вертикальных участков. Эксцентрические — со смещением оси, для горизонтальных трубопроводов (исключают застойную зону по нижней образующей). ГОСТ 17378.',
	zaglushka: 'Декоративная заглушка для торца нержавеющей трубы ограждения — поручня или стойки. Внешняя (надевается на трубу), внутренняя (вставляется внутрь — литая или штампованная), плоская сварная и сферическая сварная. Финиш — зеркало или шлифовка. Под стандартные диаметры поручня 12 / 16 / 25,4 / 38 / 42,4 / 50,8 мм.',
	zadvizhka: 'Задвижка нержавеющая клиновая — запорная арматура с клином-затвором, перемещающимся перпендикулярно потоку при вращении маховика. Маркировка 30нж41нж по ГОСТ 4666: 30 — задвижка клиновая, нж — нержавеющий корпус и клин, 41 — индекс модели. Условное давление Ру 16 атм, размерный ряд Ду 50–300 мм. Класс герметичности «А» по ГОСТ 9544 (нулевая протечка в закрытом положении). Присоединение фланцевое, привод — ручной маховик. Применяются на магистралях нержавеющих трубопроводов, линиях подачи воды, пара и слабоагрессивных сред в пищевой, химической и фармацевтической промышленности.',
	klapan: 'Клапан запорный нержавеющий — фланцевая запорная арматура для перекрытия потока в трубопроводах. Затвор тарельчатого типа прижимается к седлу при вращении маховика. Маркировка 15нж по ГОСТ 4666: 15 — клапан запорный, нж — нержавеющий корпус и затвор. В нашем прайсе две серии: 15нж22нж — Ру 40 атм и 15нж65нж — Ру 16 атм, размерный ряд Ду 15–150 мм. Присоединение фланцевое, привод ручной. По сравнению с задвижкой клапан компактнее и допускает работу при более высоких давлениях, но даёт большее гидравлическое сопротивление потоку.',
	povoroty: 'Отвод поручня — гнутый 90° (реже под другим углом) элемент для нержавеющей трубы ограждения. Под сварку с поручнем, регулируемые внешние/внутренние варианты. Финиш — зеркало. Диаметры 12–50,8 мм, стенка 1,2–1,5 мм. Не путать с трубопроводным отводом по ГОСТ 17375.',
};
const subDescription = SUB_DESCRIPTIONS[sku.sub] ?? null;

const titleParts = [hubLabel, sku.grade, sku.size ? `${sku.size} мм` : ''].filter(Boolean);
const fullTitle = titleParts.join(' · ');

/* ===== Computed metadata: aliases (AISI ↔ ГОСТ), composition, applications ===== */
const GRADE_ALIASES: Record<string, string[]> = {
	'AISI 304': ['08Х18Н10', '12Х18Н10'],
	'AISI 304L': ['03Х18Н11'],
	'AISI 316L': ['03Х17Н14М2'],
	'AISI 316Ti': ['10Х17Н13М2Т'],
	'AISI 321': ['12Х18Н10Т', '08Х18Н10Т'],
	'AISI 430': ['08Х17', '12Х17'],
	'AISI 201': ['12Х15Г9НД'],
	'AISI 410': ['08Х13', '12Х13'],
	'AISI 420': ['20Х13', '30Х13', '40Х13'],
	'AISI 904L': ['06ХН28МДТ'],
	'AISI 310S': ['20Х23Н18'],
	'08Х18Н10': ['AISI 304'],
	'12Х18Н10Т': ['AISI 321'],
	'08Х18Н10Т': ['AISI 321'],
	'03Х17Н14М2': ['AISI 316L'],
	'10Х17Н13М2Т': ['AISI 316Ti'],
	'08Х17': ['AISI 430'],
	'20Х13': ['AISI 420'],
	'06ХН28МДТ': ['AISI 904L'],
	'20Х23Н18': ['AISI 310S'],
};

const GRADE_INFO: Record<string, { applications: string; props: string }> = {
	'AISI 304': {
		applications: 'Используется в пищевой, фармацевтической, архитектурной и трубопроводной промышленности, а также для ёмкостного оборудования.',
		props: 'Аустенитная универсальная. Хорошо сваривается, штампуется, корроз­ионно­стойкая в большинстве сред.',
	},
	'AISI 316L': {
		applications: 'Применяется в морской, химической и фармацевтической промышленности — повышенная стойкость к хлоридам.',
		props: 'Аустенитная с молибденом. Низкоуглеродистая (L) — стойкость к МКК после сварки.',
	},
	'AISI 321': {
		applications: 'Используется в высокотемпературных средах: теплообменники, оборудование ТЭЦ и химической промышленности при рабочих температурах до 800 °C.',
		props: 'Аустенитная стабилизированная титаном. Рабочие температуры до 800 °C.',
	},
	'12Х18Н10Т': {
		applications: 'Российская марка (ГОСТ 5632), зарубежный аналог — AISI 321. Применяется для высокотемпературного и химического оборудования.',
		props: 'Аустенитная Cr-Ni-Ti. Гост 5632-72. До 800 °C, стойкость к МКК.',
	},
	'AISI 430': {
		applications: 'Используется в бытовой технике, отделке интерьера и для производства посуды.',
		props: 'Ферритная, экономичная, магнитная. Низкая ударная вязкость при минусе.',
	},
	'AISI 201': {
		applications: 'Применяется для интерьерной отделки, мебели, поручней и бюджетных конструкций.',
		props: 'Аустенитная с пониженным никелем (Mn-замещение). Уступает 304 по коррозии.',
	},
	'AISI 420': {
		applications: 'Используется для производства ножей, лопаток турбин, режущего и медицинского инструмента.',
		props: 'Мартенситная, закаливаемая. Высокая твёрдость после термообработки.',
	},
};

/* Density / weight calculation per geometry. ρ = 7.9 г/см³ для нержавейки. */
const RHO = 7.9; // g/cm³
function fmtNum(n: number, digits = 2): string {
	return new Intl.NumberFormat('ru-RU', { minimumFractionDigits: digits, maximumFractionDigits: digits }).format(n);
}
/* В прайсе размеры толщины приходят с русской запятой как разделитель
   («0,4», «1,5»). Стандартный parseFloat обрывает на запятой и возвращает 0,
   из-за чего вычисление веса для листа/круга/проволоки/рулона давало 0
   и «Вес 1 м²» вообще не отображался. */
function parseNum(s: string | number | null | undefined): number {
	return parseFloat(String(s ?? '').replace(',', '.'));
}

let weightLine: { label: string; value: string } | null = null;
/* Вес 1 пог. м (кг). Заполняется только для длинномера (круг/квадрат/шестигранник,
   труба, проволока) — нужен и для отображения, и для пересчёта в калькуляторе
   при выборе режима «пог. м». Для листа меряем кг/м² — это в калькуляторе
   не используется, режима «пог. м» нет. */
let kgPerMeter: number | null = null;

if (sku.hub === 'list' && sku.size) {
	const t = parseNum(sku.size);
	if (Number.isFinite(t) && t > 0) {
		// Вес 1 м² = t (мм) × ρ (кг/м³) × 1м² = t × 7.9 кг/м²
		const kgM2 = t * RHO;
		weightLine = { label: 'Вес 1 м²', value: `${fmtNum(kgM2, 2)} кг` };
	}
}

/* Вес 1 шт (кг). Для листа — толщина × ширина × длина × ρ из размеров в имени.
   Для длинномера (круг/труба/уголок-швеллер) — kgPerMeter × длина хлыста.
   Запрос клиента 2026-06-24: переключатель «шт ↔ т» в калькуляторе. */
let kgPerPiece: number | null = null;

if (sku.hub === 'list' && sku.size && sku.unit === 'т') {
	const t = parseNum(sku.size);
	if (Number.isFinite(t) && t > 0) {
		const nameStr = String(sku.name ?? '').replace(/[хХXx]/g, 'x');
		/* Берём 3-числовой шаблон толщина×ширина×длина. Если 2-числовой —
		   позиция уже отфильтрована getHubSkus как рулон-стайл, сюда не дойдёт. */
		const m = nameStr.match(/(\d+(?:[.,]\d+)?)x(\d+(?:[.,]\d+)?)x(\d+(?:[.,]\d+)?)/);
		if (m) {
			const w = parseNum(m[2]);
			const l = parseNum(m[3]);
			if (Number.isFinite(w) && Number.isFinite(l) && w > 0 && l > 0) {
				kgPerPiece = (t * w * l * RHO) / 1_000_000;
			}
		}
	}
}
if (sku.hub === 'krug' && sku.size) {
	const d = parseNum(sku.size);
	if (Number.isFinite(d) && d > 0) {
		// Площадь сечения зависит от подкатегории.
		// d — диаметр для круга, сторона квадрата или размер «под ключ» шестигранника.
		let areaMm2: number;
		if (sku.sub === 'kvadrat') {
			// квадрат: A = a²
			areaMm2 = d * d;
		} else if (sku.sub === 'shestigrannik') {
			// шестигранник «под ключ» S: A = S² × √3 / 2 ≈ 0.866 × S²
			areaMm2 = d * d * Math.sqrt(3) / 2;
		} else {
			// круг (включая никелесодержащий/жаропрочный sub): A = π × (d/2)²
			areaMm2 = Math.PI * (d / 2) ** 2;
		}
		// масса 1 пог. м, кг = площадь(мм²) × ρ(г/см³) / 1000
		kgPerMeter = (areaMm2 * RHO) / 1000;
		weightLine = { label: 'Вес 1 пог. м', value: `${fmtNum(kgPerMeter, 2)} кг` };
	}
}
if (sku.hub === 'truba' && sku.size) {
	// truba size: "Ø100.0 × 2"
	const m = sku.size.match(/Ø?\s*([\d.]+)\s*×\s*([\d.]+)/);
	if (m) {
		const D = parseNum(m[1]);
		const w = parseNum(m[2]);
		if (Number.isFinite(D) && Number.isFinite(w) && D > 0 && w > 0 && w < D / 2) {
			// труба: m = π × (D − w) × w × ρ × 1000 (D, w в мм; m в кг/м)
			kgPerMeter = (Math.PI * (D - w) * w * RHO) / 1000;
			weightLine = { label: 'Вес 1 пог. м', value: `${fmtNum(kgPerMeter, 2)} кг` };
		}
	}
}
if (sku.hub === 'provoloka' && sku.size) {
	const d = parseNum(sku.size);
	if (Number.isFinite(d) && d > 0) {
		kgPerMeter = (Math.PI * (d / 2) ** 2 * RHO) / 1000;
		weightLine = { label: 'Вес 1 пог. м', value: `${fmtNum(kgPerMeter, 3)} кг` };
	}
}

/* Для длинномера с известной длиной хлыста (труба/круг/уголок-швеллер) —
   вес 1 шт = kgPerMeter × длина в метрах. Значения dlina вроде «н/д» отсеиваем. */
if (kgPerPiece == null && kgPerMeter != null && kgPerMeter > 0 && sku.dlina) {
	const lenMm = parseNum(sku.dlina);
	if (Number.isFinite(lenMm) && lenMm > 0) {
		kgPerPiece = kgPerMeter * (lenMm / 1000);
	}
}

/* Aliases for the displayed grade (matches anywhere in the grade string) */
const aliases: string[] = [];
const gradeUp = (sku.grade || '').toUpperCase();
for (const [key, list] of Object.entries(GRADE_ALIASES)) {
	if (gradeUp.includes(key.toUpperCase())) {
		for (const alt of list) if (!gradeUp.includes(alt.toUpperCase())) aliases.push(alt);
	}
}
const gradeMeta = (() => {
	for (const key of Object.keys(GRADE_INFO)) {
		if (gradeUp.includes(key.toUpperCase())) return GRADE_INFO[key];
	}
	return null;
})();

/* Детали трубопровода в прайсе имеют sku.size = только первое число
   обозначения; полный размер (Ø × стенка, исполнение × Ду × Ру и т.д.)
   вытаскиваем из имени. */
const detailDims = getDetailDimensions(sku);

const sizeForDescription = detailDims?.descriptionInline
	? `, ${detailDims.descriptionInline}`
	: sku.size
		? `, ${sku.hub === 'polosa' || sku.hub === 'truba' ? sku.size : `${measureLabel} ${sku.size}`} мм`
		: '';
const description = `${hubLabel}${sku.grade ? ` ${sku.grade}` : ''}${roll ? `, ${roll}` : ''}${surface ? `, ${surface}` : ''}${sizeForDescription}. Цена ${sku.price ? `от ${new Intl.NumberFormat('ru-RU').format(sku.price)} ₽/${sku.unit}` : 'по запросу'}.`;

const fmt = (p: number | null) => (p == null ? null : new Intl.NumberFormat('ru-RU').format(p));

const detailRows: { label: string; value: string }[] = [];
if (sku.grade) detailRows.push({ label: 'Марка стали', value: sku.grade });
// «Категория» (subLabel) уже отрисована в eyebrow над H1 — здесь не дублируем.
if (roll) detailRows.push({ label: 'Передел', value: roll });
if (surface) detailRows.push({ label: 'Поверхность', value: surface });

/* Для запорной арматуры (klapan, zadvizhka) — вытаскиваем из имени всё
   что там стандартно зашифровано: маркировку (15нж22нж / 30нж41нж),
   Ду, Ру, класс герметичности. Это то, что у Медекс/Сантехкомплекта в
   шапке таблицы характеристик. Парсим из sku.name — никаких выдумок. */
if (sku.unit === 'шт' && (sku.sub === 'klapan' || sku.sub === 'zadvizhka')) {
	const n = String(sku.name ?? '');
	/* `\b` в JS работает по ASCII — между «нж» и цифрой границы нет, поэтому
	   опираемся на пробелы/начало/конец строки. */
	const mModel = n.match(/(?:^|\s)(\d{2}нж\d{2}нж?)(?=\s|$)/i);
	if (mModel) detailRows.push({ label: 'Маркировка по ГОСТ 4666', value: mModel[1] });
	const mDu = n.match(/Ду\s*(\d+)/i);
	if (mDu) detailRows.push({ label: 'Условный проход Ду', value: `${mDu[1]} мм` });
	const mRu = n.match(/Ру\s*(\d+)/i);
	if (mRu) detailRows.push({ label: 'Условное давление Ру', value: `${mRu[1]} атм` });
	const mCls = n.match(/класс\s*([А-ЯA-Z])/i);
	if (mCls) detailRows.push({ label: 'Класс герметичности', value: `${mCls[1].toUpperCase()} (ГОСТ 9544)` });
	detailRows.push({ label: 'Присоединение', value: 'фланцевое' });
	detailRows.push({ label: 'Привод', value: 'ручной маховик' });
	detailRows.push({ label: 'Материал корпуса', value: 'нержавеющая сталь' });
	if (sku.country) detailRows.push({ label: 'Производитель', value: sku.country });
}
// «Тип сплава» обычно дублирует «Категорию» (никелесодержащий/без никеля).
// Показываем, только если отличается от subLabel.
if (sku.alloy && sku.alloy.toLowerCase() !== subLabel.toLowerCase()) {
	detailRows.push({ label: 'Тип сплава', value: sku.alloy });
}
if ((sku.hub === 'polosa' || sku.hub === 'lenta') && sku.width != null && sku.thickness != null) {
	/* У полосы и ленты две существенные размерности — показываем раздельно,
	   чтобы не было лжи «Толщина 20 мм» там, где 20 — это ширина. */
	detailRows.push({ label: 'Ширина', value: `${sku.width} мм` });
