	   Иначе раздел показывал бы «другие ширины», а пользователь ждёт толщин. */
	const n = sku.hub === 'polosa' && s.thickness != null ? s.thickness : sizeNum(s.size);
	if (!Number.isFinite(n)) continue;
	if (!_sizeMap.has(n)) _sizeMap.set(n, s);
}
const otherSizes = [..._sizeMap.entries()]
	.sort(([a], [b]) => a - b)
	.map(([, s]) => s);
/* В чипах «других толщин» для полосы показываем именно толщину, а не полную
   геометрию (там у каждой ширины своя строка SKU, нам нужны уникальные толщины). */
function otherSizeChipLabel(s: SKU): string {
	if (sku.hub === 'polosa' && s.thickness != null) return `${s.thickness} мм`;
	return `${s.size} мм`;
}

/* CTA — передаём slug и (опц.) объём, чтобы форма заявки могла предзаполниться
