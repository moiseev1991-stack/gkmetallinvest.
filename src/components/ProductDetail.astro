---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaSection from './CtaSection.astro';
import pricelist from '../data/pricelist.json';
import { siteName, siteUrl, contacts } from '../data/site';
import { cities } from '../data/cities';

interface SKU {
	hub: string;
	sub: string;
	grade: string;
	roll: string | null;
	alloy: string | null;
	surface: string | null;
	size: string;
	unit: string;
	price: number | null;
	priceUnit?: number | null;
	slug: string;
	name?: string;
	dlina?: string | null;
	fact?: string | null;
	ostatok?: number | null;
}

interface Props {
	sku: SKU;
	hubLabel: string;
	hubHref: string;
	measureLabel: string;
}

const { sku, hubLabel, hubHref, measureLabel } = Astro.props;

const SUB_LABELS: Record<string, string> = {
	// list / rulon / polosa
	nikelesod: 'Никелесодержащий',
	beznikelya: 'Без никеля',
	duplex: 'Дуплекс',
	profnastil: 'Профнастил',
	pvl: 'ПВЛ — просечно-вытяжной',
	// krug
	zharoprochnyj: 'Жаропрочный',
	kvadrat: 'Квадрат',
	nikelevyj: 'Никелесодержащий',
	shestigrannik: 'Шестигранник',
	// truba
	besshovnaya: 'Бесшовная',
	elsvarnaya: 'Электросварная',
	'elsvarnaya-kvadrat': 'Электросварная квадратная',
	'elsvarnaya-pryamougolnaya': 'Электросварная прямоугольная',
	perforirovannaya: 'Перфорированная',
	// provoloka
	osnovnaya: 'Проволока',
	// ugolok-shveller
	shveller: 'Швеллер',
	ugolok: 'Уголок',
	// detali-truboprovoda
	flanec: 'Фланец',
	'flanec-nastennyy': 'Фланец настенный',
	otvod: 'Отвод',
	troynik: 'Тройник',
	perehod: 'Переход',
	zaglushka: 'Заглушка',
	zadvizhka: 'Задвижка',
	klapan: 'Клапан',
	povoroty: 'Поворот',
	nakonechniki: 'Наконечник',
	// detali-truboprovoda — ограждения / лестничные элементы
	'dekorativnyy-niz': 'Декоративный низ',
	'derzhatel-rigelya': 'Держатель ригеля',
	'krepleniya-stoek': 'Крепление стоек',
	'lestn-osnovnye': 'Лестничные элементы',
	pristennye: 'Пристенный крепёж',
	stekloderzhateli: 'Стеклодержатель',
};

const subLabel = SUB_LABELS[sku.sub] ?? sku.sub;
const surface = sku.surface ?? '';
const roll = sku.roll ?? '';

const titleParts = [hubLabel, sku.grade, sku.size ? `${sku.size} мм` : ''].filter(Boolean);
const fullTitle = titleParts.join(' · ');

/* ===== Computed metadata: aliases (AISI ↔ ГОСТ), composition, applications ===== */
const GRADE_ALIASES: Record<string, string[]> = {
	'AISI 304': ['08Х18Н10', '12Х18Н10'],
	'AISI 304L': ['03Х18Н11'],
	'AISI 316L': ['03Х17Н14М2'],
	'AISI 316Ti': ['10Х17Н13М2Т'],
	'AISI 321': ['12Х18Н10Т', '08Х18Н10Т'],
	'AISI 430': ['08Х17', '12Х17'],
	'AISI 201': ['12Х15Г9НД'],
	'AISI 410': ['08Х13', '12Х13'],
	'AISI 420': ['20Х13', '30Х13', '40Х13'],
	'AISI 904L': ['06ХН28МДТ'],
	'AISI 310S': ['20Х23Н18'],
	'08Х18Н10': ['AISI 304'],
	'12Х18Н10Т': ['AISI 321'],
	'08Х18Н10Т': ['AISI 321'],
	'03Х17Н14М2': ['AISI 316L'],
	'10Х17Н13М2Т': ['AISI 316Ti'],
	'08Х17': ['AISI 430'],
	'20Х13': ['AISI 420'],
	'06ХН28МДТ': ['AISI 904L'],
	'20Х23Н18': ['AISI 310S'],
};

const GRADE_INFO: Record<string, { applications: string; props: string }> = {
	'AISI 304': {
		applications: 'Пищевая, фармацевтика, архитектура, ёмкости и трубопроводы.',
		props: 'Аустенитная универсальная. Хорошо сваривается, штампуется, корроз­ионно­стойкая в большинстве сред.',
	},
	'AISI 316L': {
		applications: 'Морская, химическая, фармацевтическая отрасли. Хлоридостойкая.',
		props: 'Аустенитная с молибденом. Низкоуглеродистая (L) — стойкость к МКК после сварки.',
	},
	'AISI 321': {
		applications: 'Высокотемпературные среды, тепло­обменники, ТЭЦ, химия.',
		props: 'Аустенитная стабилизированная титаном. Рабочие температуры до 800 °C.',
	},
	'12Х18Н10Т': {
		applications: 'Российский аналог AISI 321. Работа при высоких температурах, химоборудование.',
		props: 'Аустенитная Cr-Ni-Ti. Гост 5632-72. До 800 °C, стойкость к МКК.',
	},
	'AISI 430': {
		applications: 'Бытовая техника, отделка интерьера, посуда.',
		props: 'Ферритная, экономичная, магнитная. Низкая ударная вязкость при минусе.',
	},
	'AISI 201': {
		applications: 'Отделка, мебель, поручни, бюджетные конструкции.',
		props: 'Аустенитная с пониженным никелем (Mn-замещение). Уступает 304 по коррозии.',
	},
	'AISI 420': {
		applications: 'Ножи, лопатки турбин, режущий инструмент, медицинский инструмент.',
		props: 'Мартенситная, закаливаемая. Высокая твёрдость после термообработки.',
	},
};

/* Density / weight calculation per geometry. ρ = 7.9 г/см³ для нержавейки. */
const RHO = 7.9; // g/cm³
function fmtNum(n: number, digits = 2): string {
	return new Intl.NumberFormat('ru-RU', { minimumFractionDigits: digits, maximumFractionDigits: digits }).format(n);
}

let weightLine: { label: string; value: string } | null = null;
/* Вес 1 пог. м (кг). Заполняется только для длинномера (круг/квадрат/шестигранник,
   труба, проволока) — нужен и для отображения, и для пересчёта в калькуляторе
   при выборе режима «пог. м». Для листа меряем кг/м² — это в калькуляторе
   не используется, режима «пог. м» нет. */
let kgPerMeter: number | null = null;

if (sku.hub === 'list' && sku.size) {
	const t = parseFloat(sku.size);
	if (Number.isFinite(t) && t > 0) {
		// Вес 1 м² = t (мм) × ρ (кг/м³) × 1м² = t × 7.9 кг/м²
		const kgM2 = t * RHO;
		weightLine = { label: 'Вес 1 м²', value: `${fmtNum(kgM2, 2)} кг` };
	}
}
if (sku.hub === 'krug' && sku.size) {
	const d = parseFloat(sku.size);
	if (Number.isFinite(d) && d > 0) {
		// Площадь сечения зависит от подкатегории.
		// d — диаметр для круга, сторона квадрата или размер «под ключ» шестигранника.
		let areaMm2: number;
		if (sku.sub === 'kvadrat') {
			// квадрат: A = a²
			areaMm2 = d * d;
		} else if (sku.sub === 'shestigrannik') {
			// шестигранник «под ключ» S: A = S² × √3 / 2 ≈ 0.866 × S²
			areaMm2 = d * d * Math.sqrt(3) / 2;
		} else {
			// круг (включая никелесодержащий/жаропрочный sub): A = π × (d/2)²
			areaMm2 = Math.PI * (d / 2) ** 2;
		}
		// масса 1 пог. м, кг = площадь(мм²) × ρ(г/см³) / 1000
		kgPerMeter = (areaMm2 * RHO) / 1000;
		weightLine = { label: 'Вес 1 пог. м', value: `${fmtNum(kgPerMeter, 2)} кг` };
	}
}
if (sku.hub === 'truba' && sku.size) {
	// truba size: "Ø100.0 × 2"
	const m = sku.size.match(/Ø?\s*([\d.]+)\s*×\s*([\d.]+)/);
	if (m) {
		const D = parseFloat(m[1]);
		const w = parseFloat(m[2]);
		if (Number.isFinite(D) && Number.isFinite(w) && D > 0 && w > 0 && w < D / 2) {
			// труба: m = π × (D − w) × w × ρ × 1000 (D, w в мм; m в кг/м)
			kgPerMeter = (Math.PI * (D - w) * w * RHO) / 1000;
			weightLine = { label: 'Вес 1 пог. м', value: `${fmtNum(kgPerMeter, 2)} кг` };
		}
	}
}
if (sku.hub === 'provoloka' && sku.size) {
	const d = parseFloat(sku.size);
	if (Number.isFinite(d) && d > 0) {
		kgPerMeter = (Math.PI * (d / 2) ** 2 * RHO) / 1000;
		weightLine = { label: 'Вес 1 пог. м', value: `${fmtNum(kgPerMeter, 3)} кг` };
	}
}

/* Aliases for the displayed grade (matches anywhere in the grade string) */
const aliases: string[] = [];
const gradeUp = (sku.grade || '').toUpperCase();
for (const [key, list] of Object.entries(GRADE_ALIASES)) {
	if (gradeUp.includes(key.toUpperCase())) {
		for (const alt of list) if (!gradeUp.includes(alt.toUpperCase())) aliases.push(alt);
	}
}
const gradeMeta = (() => {
	for (const key of Object.keys(GRADE_INFO)) {
		if (gradeUp.includes(key.toUpperCase())) return GRADE_INFO[key];
	}
	return null;
})();

const description = `${hubLabel}${sku.grade ? ` ${sku.grade}` : ''}${roll ? `, ${roll}` : ''}${surface ? `, ${surface}` : ''}${
	sku.size ? `, ${measureLabel} ${sku.size} мм` : ''
}. Цена ${sku.price ? `от ${new Intl.NumberFormat('ru-RU').format(sku.price)} ₽/${sku.unit}` : 'по запросу'}.`;

const fmt = (p: number | null) => (p == null ? null : new Intl.NumberFormat('ru-RU').format(p));

const detailRows: { label: string; value: string }[] = [
	{ label: 'Марка стали', value: sku.grade },
];
// «Категория» (subLabel) уже отрисована в eyebrow над H1 — здесь не дублируем.
if (roll) detailRows.push({ label: 'Передел', value: roll });
if (surface) detailRows.push({ label: 'Поверхность', value: surface });
// «Тип сплава» обычно дублирует «Категорию» (никелесодержащий/без никеля).
// Показываем, только если отличается от subLabel.
if (sku.alloy && sku.alloy.toLowerCase() !== subLabel.toLowerCase()) {
	detailRows.push({ label: 'Тип сплава', value: sku.alloy });
}
if (sku.size) detailRows.push({ label: measureLabel.charAt(0).toUpperCase() + measureLabel.slice(1), value: `${sku.size} мм` });
if (sku.dlina) detailRows.push({ label: 'Длина', value: `${sku.dlina} мм` });
detailRows.push({ label: 'Единица измерения', value: sku.unit });
if (weightLine) detailRows.push(weightLine);
if (sku.fact) detailRows.push({ label: 'Склад', value: sku.fact });
if (sku.ostatok != null) detailRows.push({ label: 'Остаток на складе', value: `${sku.ostatok} ${sku.unit}` });
if (aliases.length) detailRows.push({ label: 'Аналоги марки', value: aliases.join(', ') });

// Cross-sell: which obrabotki applicable to this hub
const SERVICES_BY_HUB: Record<string, Array<{ href: string; label: string; desc: string }>> = {
	list: [
		{ href: '/uslugi/rezka-rulonov/', label: 'Резка в размер', desc: 'до 12 м, ±1 мм' },
		{ href: '/uslugi/perforaciya-listov/', label: 'Перфорация', desc: 'круглая, щелевая, по чертежу' },
		{ href: '/uslugi/polirovka/', label: 'Полировка', desc: 'до зеркала Ra ≤ 0,4 мкм' },
	],
	rulon: [
		{ href: '/uslugi/rezka-rulonov/', label: 'Резка в лист', desc: 'до 12 м длиной' },
		{ href: '/lenta/proizvodstvo/', label: 'Резка в штрипс', desc: 'шаг 5 мм, толщина до 4 мм' },
	],
	truba: [
		{ href: '/uslugi/rezka-rulonov/', label: 'Резка в размер', desc: 'от 1 шт ±1 мм' },
		{ href: '/uslugi/polirovka/', label: 'Полировка', desc: 'снаружи и внутри' },
	],
	krug: [
		{ href: '/uslugi/rezka-rulonov/', label: 'Резка в заготовку', desc: 'дисковой и ленточной пилой' },
	],
	provoloka: [
		{ href: '/uslugi/rezka-rulonov/', label: 'Перемотка с катушки', desc: 'на бухты от 1 кг' },
	],
};
const services = SERVICES_BY_HUB[sku.hub] || [];

// Category image (one per sub) — pre-uniqueized from mc.ru.
const imgPath = `/img/catalog/${sku.hub}/${sku.sub}.webp`;
const imgAlt = `${hubLabel} ${sku.grade || ''} ${sku.size ? sku.size + ' мм' : ''}`.trim();

// 6 близких позиций по той же марке/переделу — для блока «Похожие позиции»
const allSkus = (pricelist.hubs as any)[sku.hub] as SKU[];
const related = allSkus
	.filter((s) => s.slug !== sku.slug && s.grade === sku.grade && (s.roll ?? '') === (sku.roll ?? ''))
	.slice(0, 6);

/* Другие размеры этой же марки + поверхности — компактный список ссылок
   («другие толщины»). Дедуплицируем по числовому значению size, режем дубли -N. */
function sizeNum(v: any): number {
	const m = String(v ?? '').match(/-?\d+(?:[.,]\d+)?/);
	return m ? parseFloat(m[0].replace(',', '.')) : NaN;
}
const _sizeMap = new Map<number, SKU>();
for (const s of allSkus) {
	if (s.slug === sku.slug) continue;
	if (s.grade !== sku.grade) continue;
	if ((s.surface ?? '') !== (sku.surface ?? '')) continue;
	if ((s.roll ?? '') !== (sku.roll ?? '')) continue;
	if (/-\d+$/.test(s.slug)) continue; // дубль партии
	const n = sizeNum(s.size);
	if (!Number.isFinite(n)) continue;
	if (!_sizeMap.has(n)) _sizeMap.set(n, s);
}
const otherSizes = [..._sizeMap.entries()]
	.sort(([a], [b]) => a - b)
	.map(([, s]) => s);

/* CTA — передаём slug и (опц.) объём, чтобы форма заявки могла предзаполниться
   и трекать конверсии по конкретной позиции. */
const ctaHref = `/zapros-kp/?sku=${encodeURIComponent(sku.slug)}#lead-form`;

/* FAQ-блок: 4-6 универсальных вопросов с подстановкой марки/толщины.
   Отдаём FAQPage JSON-LD — это даёт rich snippets в выдаче Яндекса/Google. */
const faqItems = (() => {
	const items: { q: string; a: string }[] = [];
	items.push({
		q: `Какой минимальный объём заказа ${hubLabel.toLowerCase()} ${sku.grade}?`,
		a: `Отгружаем от розничной нормы — 0,1 ${sku.unit} (с розничной ценой) и от 1 ${sku.unit} по оптовой цене. Возможна резка под ваш размер и комплектация одной отправкой нескольких марок.`,
	});
	items.push({
		q: 'Какие документы предоставляются на партию?',
		a: 'На каждую партию — сертификат завода-изготовителя и паспорт качества. По запросу — копии в формате PDF/ЭДО до отгрузки, оригиналы вкладываются в груз или направляются курьером.',
	});
	if (aliases.length) {
		items.push({
			q: `Чем ${sku.grade} отличается от ${aliases[0]}?`,
			a: `${sku.grade} и ${aliases[0]} — взаимозаменяемые марки по составу и характеристикам (российская и зарубежная номенклатура). Используются под одни и те же задачи; в спецификации можно указывать любой из аналогов.`,
		});
	}
	items.push({
		q: 'Сколько действует цена в коммерческом предложении?',
		a: `Цена в прайсе ориентировочная и обновляется ежедневно. В КП фиксируем цену на 5 рабочих дней — этого достаточно для согласования и оплаты счёта.`,
	});
	items.push({
		q: 'Можно ли заказать резку, перфорацию или полировку этой позиции?',
		a: `Да. ${hubLabel} режем в размер до 12 м (точность ±1 мм), перфорируем по чертежу, полируем до зеркала Ra ≤ 0,4 мкм. Услуги добавляются в счёт отдельной строкой.`,
	});
	items.push({
		q: 'Доставка по России — какие способы и сроки?',
		a: 'Авто и ж/д контейнерные отправки, попутный транспорт и собственные машины, СДЭК / ПЭК / «Деловые линии». Срок в Москву — 1–2 дня, СПб — 2–3, Урал — 3–4, Сибирь — 5–7 рабочих дней.',
	});
	return items;
})();
const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};

const breadcrumbs = [
	{ label: 'Главная', href: '/' },
	{ label: hubLabel, href: hubHref },
	{ label: `${sku.grade}${sku.size ? ` · ${sku.size} мм` : ''}` },
];

/* Duplicate slugs (-2/-3/-N) — это тот же товар с другой партии/остатком.
   На основной slug ставим себя сам, на дубли — canonical на основной + noindex,
   чтобы поисковики не считали 594 группы карточек дублирующимся контентом. */
const dupMatch = sku.slug.match(/-(\d+)$/);
const dupIdx = dupMatch ? parseInt(dupMatch[1], 10) : 0;
const isDup = dupIdx >= 2;
const baseSlug = isDup ? sku.slug.replace(/-\d+$/, '') : sku.slug;
const canonicalPath = `${hubHref}${baseSlug}/`;

/* SEO-title начинается с размера в естественной форме — это ловит размерные
   хвосты Wordstat: «лист нержавеющий 1 мм», «пруток нержавеющий 12мм» и т.д.
   Формат: «Лист нержавеющий 1 мм AISI 304 — купить в Нижнем Новгороде». */

// «0.4» / «0,4» → «0,4» (российский формат: запятая вместо точки)
function ruNum(s: string): string {
	return s.replace('.', ',');
}

// Извлекает главный размер из sku.size по типу хаба.
// Возвращает строку вида «1 мм», «Ø 50 × 2», «20 мм» — для подстановки в title.
function extractMainSize(hub: string, size: string | null | undefined): string {
	if (!size) return '';
	const raw = String(size).trim();
	// Для трубы: формат «Ø6 × 1» / «Ø100.0 × 2» → «Ø 6 × 1 мм»
	if (hub === 'truba') {
		const m = raw.match(/Ø?\s*([\d.,]+)\s*[×x]\s*([\d.,]+)/i);
		if (m) return `Ø ${ruNum(m[1])} × ${ruNum(m[2])} мм`;
		const m1 = raw.match(/Ø?\s*([\d.,]+)/);
		if (m1) return `Ø ${ruNum(m1[1])} мм`;
		return raw;
	}
	// Лист в рулоне: «0,4 × 1000» → первое число (толщина) — это и есть ключ.
	// Лист / полоса / уголок / круг / проволока / детали — первое число.
	const m = raw.match(/([\d.,]+)/);
	if (m) {
		const n = ruNum(m[1]);
		return `${n} мм`;
	}
	return raw;
}

// Короткое обозначение марки для title:
// «AISI 304 (08Х18Н10)» → «AISI 304»
// «AISI 201 12Х15Г9НД» → «AISI 201»
// «12Х18Н10Т» → «12Х18Н10Т» (без изменений)
function shortGrade(grade: string | null | undefined): string {
	if (!grade) return '';
	let g = String(grade).trim();
	// Отрезаем скобку: «AISI 304 (08Х18Н10)» → «AISI 304»
	const p = g.indexOf('(');
	if (p >= 0) g = g.slice(0, p).trim();
	// Если в строке два обозначения через пробел («AISI 201 12Х15Г9НД»),
	// оставляем только AISI-часть как более узнаваемую.
	const aisiMatch = g.match(/^(AISI\s*\S+)/i);
	if (aisiMatch) return aisiMatch[1].replace(/\s+/g, ' ');
	return g;
}

const mainSize = extractMainSize(sku.hub, sku.size);
const shortGradeLabel = shortGrade(sku.grade);

// Title с размером и маркой первыми. Цель — полный <title> ≤ 70 знаков
// (BaseLayout приклеит « — ГК Металлинвест» = 19 знаков, значит наш part ≤ 51).
const titleSeo = (() => {
	const head = [hubLabel, mainSize, shortGradeLabel].filter(Boolean).join(' ');
	const BUDGET = 51; // 70 − длина « — ГК Металлинвест»
	const longSuffix = ' — купить в Нижнем Новгороде';
	const midSuffix = ' — купить за тонну с НДС';
	const shortSuffix = ' — купить';
	if ((head + longSuffix).length <= BUDGET) return head + longSuffix;
	if ((head + midSuffix).length <= BUDGET) return head + midSuffix;
	if ((head + shortSuffix).length <= BUDGET) return head + shortSuffix;
	// Если даже самый короткий хвост не влезает — отдаём только head.
	// (Превышение бюджета приемлемо, т.к. размер+марка важнее.)
	return head;
})();

const fmtPrice = (p: number | null | undefined) =>
	p == null ? null : new Intl.NumberFormat('ru-RU').format(p);
const priceLine = sku.price
	? `от ${fmtPrice(sku.price)} ₽/${sku.unit}`
	: 'цена по запросу';
// ostatok приходит в исходных единицах (часто в кг для тонн — даёт значения
// типа «314060 т», что выглядит абсурдно в description). Поэтому показываем
// «в наличии» / «под заказ» без числа — это надёжнее в SERP.
const stockPhrase = (sku.ostatok != null && sku.ostatok > 0) || sku.fact
	? 'в наличии'
	: 'под заказ';
// Description 140-160 знаков с размером и маркой в первой фразе.
const seoDescription = (() => {
	const head = [hubLabel, mainSize, shortGradeLabel].filter(Boolean).join(' ');
	const full = `${head} — ${stockPhrase}. Сертификат завода, отгрузка из Нижнего Новгорода, доставка по РФ. Цена ${priceLine}.`;
	if (full.length <= 160) return full;
	const mid = `${head} — ${stockPhrase}. Сертификат завода, отгрузка из Нижнего Новгорода. Цена ${priceLine}.`;
	if (mid.length <= 160) return mid;
	return `${head} — ${stockPhrase}. Сертификат завода. Цена ${priceLine}.`;
})();

/* Product / Offer JSON-LD. На дубли тоже отдаём — но т.к. они носят canonical
   на основной, поисковики не сделают два rich snippet'а на один товар.
   `mpn` не отдаём: у нас нет настоящего Manufacturer Part Number, а slug
   к этому полю отношения не имеет — Google Search Console ругается. */
const productJsonLd: Record<string, any> = {
	'@context': 'https://schema.org/',
	'@type': 'Product',
	name: titleSeo,
	description: seoDescription,
	sku: sku.slug,
	category: `${hubLabel}${subLabel ? ' · ' + subLabel : ''}`,
	brand: { '@type': 'Brand', name: siteName },
	url: `${siteUrl}${canonicalPath}`,
	image: [`${siteUrl}${imgPath}`],
};
if (sku.grade) productJsonLd.material = sku.grade;
if (sku.price != null) {
	const offer: Record<string, any> = {
		'@type': 'Offer',
		price: sku.price,
		priceCurrency: 'RUB',
		availability:
			sku.ostatok != null && sku.ostatok > 0
				? 'https://schema.org/InStock'
				: 'https://schema.org/PreOrder',
		url: `${siteUrl}${canonicalPath}`,
		seller: {
			'@type': 'Organization',
			name: contacts.company,
			telephone: contacts.phone,
		},
	};
	if (sku.unit) offer.priceSpecification = {
		'@type': 'UnitPriceSpecification',
		price: sku.price,
		priceCurrency: 'RUB',
		referenceQuantity: { '@type': 'QuantitativeValue', value: 1, unitText: sku.unit },
	};
	productJsonLd.offers = offer;
}
---

<BaseLayout
	title={titleSeo}
	description={seoDescription}
	canonical={canonicalPath}
	noindex={isDup}
	image={imgPath}
	type="product"
	jsonLd={[productJsonLd, faqJsonLd]}
>
	<div class="container product">
		<Breadcrumbs items={breadcrumbs} />

		<header class="product__head">
			<figure class="product__media">
				<img
					src={imgPath}
					alt={imgAlt}
					width="640"
					height="640"
					loading="eager"
					fetchpriority="high"
					decoding="async"
					onerror="this.style.display='none'; this.parentElement.classList.add('product__media--missing');"
				/>
			</figure>

			<div class="product__title-wrap">
				{subLabel && subLabel.toLowerCase() !== hubLabel.toLowerCase() && (
						<span class="product__eyebrow">{subLabel}</span>
					)}
				<h1 class="product__title">
					<span class="product__title-hub">{hubLabel}</span>
					<span class="product__title-grade">{sku.grade}</span>
					{sku.size && <span class="product__size">{sku.size} мм</span>}
				</h1>

				{(roll || surface || sku.alloy) && (
					<p class="product__tags">
						{roll && <span class="tag">{roll}</span>}
						{surface && <span class="tag tag--accent">{surface}</span>}
						{sku.alloy && <span class="tag">{sku.alloy}</span>}
					</p>
				)}

				{sku.fact && (
					<p class="product__stock">
						<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
							<circle cx="7" cy="7" r="3.5" fill="var(--color-success, #16a34a)" />
						</svg>
						В наличии — {sku.fact}{sku.ostatok != null && ` · ${sku.ostatok} ${sku.unit}`}
					</p>
				)}

				{/* Лид-абзац: марка + формат, краткое описание из gradeMeta. Заполняет
				    середину hero — без него title-wrap был визуально пуст. */}
				<p class="product__lead">
					{hubLabel} {sku.grade}{surface ? ` · ${surface}` : ''}{sku.size ? `, ${sku.hub === 'truba' ? sku.size : `${measureLabel} ${sku.size}`} мм` : ''}.
					{gradeMeta ? ` ${gradeMeta.applications}` : ` Поставка со склада в Нижнем Новгороде, доставка по России. Сертификат завода-изготовителя на каждую партию.`}
				</p>

				{/* Key facts grid: 2-4 ключевых параметра крупно — вес, аналоги,
				    единица. Из data, без хардкода. */}
				<dl class="product__keys">
					{weightLine && (
						<div class="product__key">
							<dt>{weightLine.label}</dt>
							<dd>{weightLine.value}</dd>
						</div>
					)}
					{aliases.length > 0 && (
						<div class="product__key">
							<dt>Аналог</dt>
							<dd>{aliases[0]}</dd>
						</div>
					)}
					<div class="product__key">
						<dt>Единица</dt>
						<dd>{sku.unit}</dd>
					</div>
					{sku.dlina && (
						<div class="product__key">
							<dt>Длина</dt>
							<dd>{sku.dlina} мм</dd>
						</div>
					)}
				</dl>
			</div>

			<aside class="product__price" data-product-price>
				{sku.price ? (
					<>
						<span class="product__price-label">Цена от 1 {sku.unit}</span>
						<span class="product__price-value">{fmt(sku.price)} ₽</span>
						<span class="product__price-unit">за {sku.unit} (с НДС)</span>
						{sku.priceUnit != null && sku.priceUnit !== sku.price && (
							<span class="product__price-retail">
								Розница до 0,1 {sku.unit} · <strong>{fmt(sku.priceUnit)} ₽</strong>/{sku.unit}
							</span>
						)}

						<div class="calc">
							<div class="calc__head">
								<label class="calc__label" for={`calc-${sku.slug}`} data-calc-label>Расчёт по объёму, {sku.unit}</label>
								{kgPerMeter != null && kgPerMeter > 0 && (
									<div class="calc__modes" role="group" aria-label="Единица расчёта">
										<button type="button" class="calc__mode calc__mode--active" data-calc-mode="unit" aria-pressed="true">{sku.unit}</button>
										<button type="button" class="calc__mode" data-calc-mode="meter" aria-pressed="false">пог. м</button>
									</div>
								)}
							</div>
							<div class="calc__row">
								<input
									id={`calc-${sku.slug}`}
									class="calc__input"
									type="number"
									inputmode="decimal"
									step="0.1"
									min="0.1"
									placeholder="1"
									data-calc-input
									data-unit-price={sku.price}
									data-retail-price={sku.priceUnit ?? sku.price}
									data-unit={sku.unit}
									data-kg-per-m={kgPerMeter != null ? kgPerMeter.toFixed(4) : ''}
								/>
								<span class="calc__unit" data-calc-unit>{sku.unit}</span>
							</div>
							<div class="calc__result" data-calc-result>Введите объём — посчитаем сумму</div>
						</div>
					</>
				) : (
					<>
						<span class="product__price-label">Цена</span>
						<span class="product__price-on-request">по запросу</span>
					</>
				)}
				<a href={ctaHref} class="product__cta" data-product-cta data-base-href={ctaHref}>Запросить КП</a>
				<a href="tel:+78312812660" class="product__call">+7 (831) 281-26-60</a>
			</aside>
		</header>

		<section class="product__grid">
			<div>
				<h2>Характеристики</h2>
				<dl class="specs">
					{detailRows.map((r) => (
						<>
							<dt>{r.label}</dt>
							<dd>{r.value}</dd>
						</>
					))}
				</dl>
			</div>

			<div>
				<h2>Условия поставки</h2>
				<ul class="conditions">
					<li>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<rect x="1" y="3" width="15" height="13" rx="1" />
							<path d="M16 8h4l3 3v5h-7" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" />
						</svg>
						<span>Отгрузка со склада в Нижнем Новгороде в день оплаты</span>
					</li>
					<li>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20" />
						</svg>
						<span>Доставка по России — авто, ж/д контейнеры, ТК</span>
					</li>
					<li>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><path d="M9 13l2 2 4-4" />
						</svg>
						<span>Сертификат завода и паспорт качества на каждую партию</span>
					</li>
					<li>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="6" cy="6" r="3" /><circle cx="6" cy="18" r="3" /><line x1="20" y1="4" x2="8.12" y2="15.88" /><line x1="14.47" y1="14.48" x2="20" y2="20" /><line x1="8.12" y1="8.12" x2="12" y2="12" />
						</svg>
						<span>Резка в размер, перфорация, полировка — по запросу</span>
					</li>
					<li>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" />
						</svg>
						<span>Цена актуальна на {pricelist.updatedAt}, фиксируется в КП на 5 рабочих дней</span>
					</li>
				</ul>
			</div>
		</section>

		{gradeMeta && (
			<section class="grade-info">
				<h2>О марке</h2>
				<div class="grade-info__grid">
					<div>
						<h3>Свойства</h3>
						<p>{gradeMeta.props}</p>
					</div>
					<div>
						<h3>Применение</h3>
						<p>{gradeMeta.applications}</p>
					</div>
				</div>
			</section>
		)}

		{services.length > 0 && (
			<section class="services">
				<h2>Услуги по этой позиции</h2>
				<div class="services__grid">
					{services.map((s) => (
						<a class="services__card" href={s.href}>
							<span class="services__title">{s.label}</span>
							<span class="services__desc">{s.desc}</span>
							<span class="services__arrow" aria-hidden="true">→</span>
						</a>
					))}
				</div>
			</section>
		)}

		{otherSizes.length > 1 && (
			<section class="other-sizes">
				<h2>Другие {measureLabel === 'диаметр' ? 'диаметры' : measureLabel === 'Ø × стенка' ? 'размеры' : 'толщины'} для {sku.grade}{surface && ` · ${surface}`}</h2>
				<ul class="other-sizes__list">
					{otherSizes.map((s) => (
						<li>
							{s.slug === sku.slug ? (
								<span class="other-sizes__chip other-sizes__chip--active">{s.size} мм</span>
							) : (
								<a class="other-sizes__chip" href={`${hubHref}${s.slug}/`}>{s.size} мм</a>
							)}
						</li>
					))}
				</ul>
			</section>
		)}

		{related.length > 0 && (
			<section class="related">
				<h2>Похожие позиции — {sku.grade}{roll && `, ${roll}`}</h2>
				<div class="related__grid">
					{related.map((r) => (
						<a class="related__card" href={`${hubHref}${r.slug}/`}>
							<img
								class="related__img"
								src={`/img/catalog/${r.hub}/${r.sub}.webp`}
								alt={`${r.grade} ${r.size || ''}`.trim()}
								width="120"
								height="120"
								loading="lazy"
								onerror="this.style.display='none';"
							/>
							<div class="related__body">
								<span class="related__title">{r.grade}{r.size && ` · ${r.size} мм`}</span>
								<span class="related__meta">{[SUB_LABELS[r.sub] ?? r.sub, r.surface].filter(Boolean).join(' · ')}</span>
								<span class="related__price">
									{r.price ? `${fmt(r.price)} ₽/${r.unit}` : 'по запросу'}
								</span>
							</div>
						</a>
					))}
				</div>
				<p class="related__back">
					<a href={hubHref}>← Все позиции «{hubLabel}»</a>
				</p>
			</section>
		)}

		<section class="delivery-cities" aria-labelledby="delivery-cities-title">
			<h2 id="delivery-cities-title">Доставка в ваш город</h2>
			<p class="delivery-cities__lead">
				Отгружаем со склада в Нижнем Новгороде. Стоимость доставки рассчитывается отдельно,
				цена на товар одинаковая для всех регионов.
			</p>
			<ul class="delivery-cities__grid">
				{cities.map((c) => (
					<li>
						<a class="delivery-cities__chip" href={`${hubHref}v-${c.slug}/`}>
							<span class="delivery-cities__city">{c.name}</span>
							<span class="delivery-cities__transit">{c.transit}</span>
						</a>
					</li>
				))}
			</ul>
		</section>

		<section class="faq">
			<h2>Частые вопросы</h2>
			<div class="faq__list">
				{faqItems.map((f) => (
					<details class="faq__item">
						<summary class="faq__q">
							<span>{f.q}</span>
							<svg class="faq__chev" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
								<path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
							</svg>
						</summary>
						<p class="faq__a">{f.a}</p>
					</details>
				))}
			</div>
		</section>
	</div>

	{sku.price && (
		<div class="product-sticky" data-product-sticky aria-label="Цена и заявка">
			<div class="product-sticky__price">
				<span class="product-sticky__num">{fmt(sku.price)} ₽</span>
				<span class="product-sticky__unit">/{sku.unit}</span>
			</div>
			<a class="product-sticky__cta" href={ctaHref} data-product-sticky-cta data-base-href={ctaHref}>Запросить КП</a>
		</div>
	)}

	<script>
		(function () {
			const root = document.querySelector('[data-product-price]');
			if (!root) return;
			const input = root.querySelector('[data-calc-input]');
			const result = root.querySelector('[data-calc-result]');
			const labelEl = root.querySelector('[data-calc-label]');
			const unitEl = root.querySelector('[data-calc-unit]');
			const modeButtons = Array.from(root.querySelectorAll('[data-calc-mode]'));
			const cta = document.querySelector('[data-product-cta]');
			const stickyCta = document.querySelector('[data-product-sticky-cta]');
			if (!input || !result) return;

			const unitPrice = parseFloat(input.dataset.unitPrice || '0');
			const retailPrice = parseFloat(input.dataset.retailPrice || String(unitPrice));
			const unit = input.dataset.unit || 'т';
			const kgPerM = parseFloat(input.dataset.kgPerM || '0');
			const fmt = new Intl.NumberFormat('ru-RU');
			const fmt3 = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 3 });
			const baseHref = cta?.dataset.baseHref || cta?.getAttribute('href') || '/zapros-kp/';

			// 'unit' — пользователь вводит в единице товара (обычно т).
			// 'meter' — пользователь вводит в пог. м, пересчёт идёт через kgPerM.
			let mode = 'unit';

			function setMode(next) {
				mode = next;
				modeButtons.forEach((b) => {
					const active = b.dataset.calcMode === mode;
					b.classList.toggle('calc__mode--active', active);
					b.setAttribute('aria-pressed', String(active));
				});
				const labelUnit = mode === 'meter' ? 'пог. м' : unit;
				if (labelEl) labelEl.textContent = `Расчёт по объёму, ${labelUnit}`;
				if (unitEl) unitEl.textContent = labelUnit;
				input.placeholder = mode === 'meter' ? '10' : '1';
				recalc();
			}

			modeButtons.forEach((btn) => {
				btn.addEventListener('click', () => setMode(btn.dataset.calcMode));
			});

			function recalc() {
				const raw = (input.value || '').replace(',', '.').trim();
				const qty = parseFloat(raw);
				if (!isFinite(qty) || qty <= 0) {
					result.textContent = 'Введите объём — посчитаем сумму';
					result.classList.remove('calc__result--ok');
					if (cta) cta.setAttribute('href', baseHref);
					if (stickyCta) stickyCta.setAttribute('href', baseHref);
					return;
				}

				// Приводим введённое к нативной единице товара (тоннам).
				// Если выбрано «пог. м» и есть kgPerM — пересчитываем.
				let qtyInUnit = qty;
				let extraHint = '';
				if (mode === 'meter' && kgPerM > 0) {
					qtyInUnit = (qty * kgPerM) / 1000;
					extraHint = ` · ≈ ${fmt3.format(qtyInUnit)} ${unit}`;
				} else if (mode === 'unit' && kgPerM > 0 && unit === 'т') {
					// Подсказка обратного пересчёта: «1 т ≈ X пог. м»
					const meters = (qty * 1000) / kgPerM;
					extraHint = ` · ≈ ${fmt.format(Math.round(meters))} пог. м`;
				}

				const price = qtyInUnit < 1 ? retailPrice : unitPrice;
				const total = Math.round(qtyInUnit * price);
				const tier = qtyInUnit < 1 ? 'розница' : 'оптовая цена';
				result.innerHTML = `<strong>${fmt.format(total)} ₽</strong> <span class="calc__hint">≈ ${fmt.format(price)} ₽/${unit} · ${tier}${extraHint}</span>`;
				result.classList.add('calc__result--ok');

				const sep = baseHref.includes('?') ? '&' : '?';
				// В форму запроса КП передаём количество в нативной единице (т) —
				// менеджер видит понятную ему величину. Если был режим «м»,
				// дополнительно прикладываем m=<метры>, чтобы не потерять контекст.
				const qtyParam = qtyInUnit.toFixed(3);
				let newHref = baseHref.replace('#lead-form', '') + `${sep}qty=${encodeURIComponent(qtyParam)}`;
				if (mode === 'meter') newHref += `&m=${encodeURIComponent(qty)}`;
				newHref += '#lead-form';
				if (cta) cta.setAttribute('href', newHref);
				if (stickyCta) stickyCta.setAttribute('href', newHref);
			}
			input.addEventListener('input', recalc);
		})();
	</script>

	<CtaSection
		title="Уточнить цену и наличие"
		text="Менеджер подтвердит остаток на складе, рассчитает резку и логистику до вашего адреса."
	/>
</BaseLayout>

<style>
	.product {
		padding-block: var(--space-8);
	}
	.product__head {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-6);
		padding: var(--space-6);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		margin-bottom: var(--space-8);
	}
	@media (min-width: 900px) {
		.product__head {
			grid-template-columns: 280px 1fr 260px;
			align-items: start;
		}
	}
	.product__media {
		margin: 0;
		border-radius: var(--radius-md);
		overflow: hidden;
		background: var(--color-bg-elev, #f5f5f7);
		border: 1px solid var(--color-border);
		aspect-ratio: 1 / 1;
		display: flex;
		align-items: center;
		justify-content: center;
		position: relative;
	}
	.product__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.product__media--missing::before {
		content: '🔩';
		font-size: 4rem;
		opacity: 0.25;
	}
	.product__media-caption {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 0.4rem 0.7rem;
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #fff;
		background: linear-gradient(0deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 100%);
		line-height: 1.3;
	}
	.product__stock {
		margin: var(--space-3) 0 0;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--color-text);
		background: var(--color-success-50, #f0fdf4);
		border: 1px solid var(--color-success-100, #dcfce7);
		padding: 0.35rem 0.7rem;
		border-radius: var(--radius-pill);
	}

	.product__title-wrap {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		min-width: 0;
	}
	.product__title-wrap > * { margin: 0; }

	.product__lead {
		font-size: 0.95rem;
		line-height: 1.55;
		color: var(--color-muted);
		max-width: 60ch;
	}

	.product__keys {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
		gap: var(--space-2);
		padding: var(--space-3);
		background: var(--color-bg-elev);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		margin: 0;
	}
	.product__key {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}
	.product__key dt {
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-subtle);
	}
	.product__key dd {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--color-text);
		overflow-wrap: anywhere;
	}

	.product__price-retail {
		display: block;
		margin-top: 0.5rem;
		font-size: 0.82rem;
		color: var(--color-muted);
	}
	.product__price-retail strong {
		color: var(--color-text);
		font-weight: 700;
		font-family: var(--font-mono);
	}
	.product__eyebrow {
		display: block;
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-subtle);
		margin-bottom: var(--space-2);
	}
	.product__title {
		margin: 0 0 var(--space-3);
		font-size: clamp(1.5rem, 2.6vw, 2rem);
		letter-spacing: -0.015em;
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4em;
		line-height: 1.15;
	}
	.product__title-hub {
		font-weight: 500;
		color: var(--color-muted);
	}
	.product__title-hub::after {
		content: '·';
		margin-left: 0.4em;
		color: var(--color-border);
	}
	.product__title-grade {
		font-weight: 700;
		color: var(--color-text);
	}
	.product__size {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 0.7em;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.2rem 0.7rem;
		border-radius: var(--radius-pill);
	}
	.product__tags {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	.tag {
		font-size: 0.82rem;
		padding: 0.25rem 0.7rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-muted);
		background: var(--color-bg-elev);
	}
	.tag--accent {
		border-color: var(--color-accent);
		color: var(--color-accent);
		background: transparent;
	}
	.product__price {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		min-width: 220px;
		padding: var(--space-4);
		border: 1px solid var(--color-primary-100);
		border-radius: var(--radius-md);
		background: var(--color-primary-50);
	}
	.product__price-label {
		font-size: 0.78rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-subtle);
	}
	.product__price-value {
		font-family: var(--font-mono);
		font-size: 1.65rem;
		font-weight: 700;
		color: var(--color-text);
		line-height: 1.1;
	}
	.product__price-unit {
		font-size: 0.85rem;
		color: var(--color-muted);
		margin-bottom: var(--space-3);
	}
	.product__price-on-request {
		font-size: 1.25rem;
		font-weight: 600;
		color: var(--color-accent);
		margin-bottom: var(--space-3);
	}
	.product__cta {
		display: inline-block;
		text-align: center;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 0.75rem 1.2rem;
		background: var(--color-primary-500);
		color: #fff;
		border-radius: var(--radius-sm);
		text-decoration: none;
		transition: background var(--dur-fast) var(--ease-out);
	}
	.product__cta:hover {
		background: var(--color-primary-600);
	}
	.product__call {
		display: inline-block;
		text-align: center;
		font-family: var(--font-mono);
		font-size: 0.92rem;
		color: var(--color-primary-500);
		text-decoration: none;
		margin-top: var(--space-2);
	}
	.product__call:hover {
		text-decoration: underline;
	}

	.product__grid {
		display: grid;
		gap: var(--space-6);
		grid-template-columns: 1fr;
		margin-bottom: var(--space-8);
	}
	@media (min-width: 720px) {
		.product__grid {
			grid-template-columns: 1fr 1fr;
		}
	}
	.product__grid h2 {
		font-size: 1.15rem;
		margin: 0 0 var(--space-4);
	}
	.specs {
		display: grid;
		grid-template-columns: max-content 1fr;
		gap: var(--space-2) var(--space-4);
		margin: 0;
		font-size: 0.94rem;
	}
	.specs dt {
		color: var(--color-subtle);
		font-size: 0.85rem;
	}
	.specs dd {
		margin: 0;
		color: var(--color-text);
		font-weight: 500;
	}
	.conditions {
		margin: 0;
		padding: 0;
		list-style: none;
		color: var(--color-muted);
		font-size: 0.94rem;
		display: grid;
		gap: var(--space-3);
	}
	.conditions li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		line-height: 1.45;
	}
	.conditions svg {
		flex: 0 0 20px;
		margin-top: 2px;
		color: var(--color-primary-500);
	}

	.grade-info {
		padding: var(--space-6);
		background: var(--color-primary-50);
		border: 1px solid var(--color-primary-100);
		border-radius: var(--radius-md);
		margin-bottom: var(--space-8);
	}
	.grade-info h2 {
		font-size: 1.15rem;
		margin: 0 0 var(--space-4);
	}
	.grade-info__grid {
		display: grid;
		gap: var(--space-5);
		grid-template-columns: 1fr;
	}
	@media (min-width: 720px) {
		.grade-info__grid { grid-template-columns: 1fr 1fr; }
	}
	.grade-info h3 {
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.07em;
		color: var(--color-subtle);
		margin: 0 0 var(--space-2);
	}
	.grade-info p {
		margin: 0;
		color: var(--color-text);
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.services {
		margin-bottom: var(--space-8);
	}
	.services h2 {
		font-size: 1.15rem;
		margin: 0 0 var(--space-4);
	}
	.services__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: var(--space-3);
	}
	.services__card {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: auto auto;
		gap: 0.2rem 0.5rem;
		padding: var(--space-4);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		text-decoration: none;
		color: inherit;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.services__card:hover {
		border-color: var(--color-primary-500);
		transform: translateY(-2px);
		box-shadow: var(--shadow-sm);
	}
	.services__title {
		font-weight: 600;
		font-size: 0.98rem;
		color: var(--color-text);
	}
	.services__desc {
		grid-column: 1 / -1;
		font-size: 0.85rem;
		color: var(--color-muted);
	}
	.services__arrow {
		color: var(--color-primary-500);
		font-size: 1.1rem;
		font-weight: 700;
		justify-self: end;
	}

	.related {
		margin-bottom: var(--space-8);
	}
	.related h2 {
		font-size: 1.15rem;
		margin: 0 0 var(--space-4);
	}
	.related__grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: var(--space-3);
	}
	.related__card {
		display: flex;
		flex-direction: row;
		gap: var(--space-3);
		padding: var(--space-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		text-decoration: none;
		color: inherit;
		transition: border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
	}
	.related__img {
		flex: 0 0 64px;
		width: 64px;
		height: 64px;
		object-fit: cover;
		border-radius: var(--radius-sm);
		background: var(--color-bg-elev, #f5f5f7);
	}
	.related__body {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		min-width: 0;
		flex: 1;
	}
	.related__card:hover {
		border-color: var(--color-primary-500);
		transform: translateY(-2px);
	}
	.related__title {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.related__meta {
		font-size: 0.8rem;
		color: var(--color-subtle);
	}
	.related__price {
		margin-top: var(--space-2);
		font-family: var(--font-mono);
		font-size: 0.92rem;
		color: var(--color-primary-500);
		font-weight: 600;
	}
	.related__back {
		margin-top: var(--space-4);
		font-size: 0.92rem;
	}
	.related__back a {
		color: var(--color-primary-500);
		text-decoration: none;
		font-weight: 500;
	}
	.related__back a:hover {
		text-decoration: underline;
	}

	/* Калькулятор стоимости — в правой колонке цены */
	.calc {
		margin: var(--space-3) 0 var(--space-4);
		padding-top: var(--space-3);
		border-top: 1px dashed var(--color-primary-100);
	}
	.calc__head {
		display: block;
		margin-bottom: 0.5rem;
	}
	.calc__label {
		display: block;
		font-size: 0.74rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-subtle);
		margin-bottom: 0.4rem;
	}
	.calc__modes {
		display: flex;
		width: 100%;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 3px;
		gap: 2px;
	}
	.calc__mode {
		flex: 1;
		appearance: none;
		border: 0;
		background: transparent;
		font: inherit;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--color-muted);
		padding: 0.5rem 0.6rem;
		border-radius: calc(var(--radius-sm) - 2px);
		cursor: pointer;
		transition: background var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out),
			box-shadow var(--dur-fast) var(--ease-out);
	}
	.calc__mode:hover:not(.calc__mode--active) {
		background: var(--color-bg-elev, #f5f5f7);
		color: var(--color-text);
	}
	.calc__mode--active {
		background: var(--color-primary-500);
		color: #fff;
		box-shadow: 0 1px 3px rgba(15, 23, 42, 0.18);
	}
	.calc__row {
		display: flex;
		align-items: stretch;
		gap: 0.4rem;
		background: #fff;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		padding: 0.1rem 0.6rem;
		transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.calc__row:focus-within {
		border-color: var(--color-primary-500);
		box-shadow: 0 0 0 3px var(--color-primary-100);
	}
	.calc__input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: none;
		background: transparent;
		font: inherit;
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		padding: 0.45rem 0;
		-moz-appearance: textfield;
		appearance: textfield;
	}
	.calc__input::-webkit-outer-spin-button,
	.calc__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
	.calc__unit {
		align-self: center;
		font-size: 0.85rem;
		color: var(--color-muted);
		font-weight: 500;
	}
	.calc__result {
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--color-muted);
		line-height: 1.3;
	}
	.calc__result--ok strong {
		font-family: var(--font-mono);
		font-size: 1.05rem;
		color: var(--color-primary-600);
		display: block;
		margin-bottom: 0.1rem;
	}
	.calc__hint {
		font-size: 0.78rem;
		color: var(--color-subtle);
	}

	/* Другие толщины — компактные чипы */
	.other-sizes { margin-bottom: var(--space-8); }
	.other-sizes h2 { font-size: 1.15rem; margin: 0 0 var(--space-4); }
	.other-sizes__list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.other-sizes__chip {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 64px;
		padding: 0.45rem 0.85rem;
		border-radius: var(--radius-pill);
		border: 1px solid var(--color-border);
		background: var(--color-surface);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-text);
		text-decoration: none;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.other-sizes__chip:hover {
		border-color: var(--color-primary-500);
		color: var(--color-primary-600);
		text-decoration: none;
	}
	.other-sizes__chip--active {
		background: var(--color-primary-500);
		border-color: var(--color-primary-500);
		color: #fff;
		cursor: default;
	}

	/* Доставка в города */
	.delivery-cities { margin-bottom: var(--space-8); }
	.delivery-cities h2 { font-size: 1.15rem; margin: 0 0 var(--space-2); }
	.delivery-cities__lead {
		max-width: 70ch;
		color: var(--color-muted);
		margin: 0 0 var(--space-4);
	}
	.delivery-cities__grid {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: var(--space-2);
		padding: 0;
		margin: 0;
	}
	.delivery-cities__chip {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding: var(--space-2) var(--space-3);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text);
		text-decoration: none;
		transition: border-color var(--dur-fast) var(--ease-out),
			background var(--dur-fast) var(--ease-out);
		min-width: 0;
		overflow-wrap: anywhere;
	}
	.delivery-cities__chip:hover {
		border-color: var(--color-primary-500);
		background: var(--color-primary-50);
		color: var(--color-primary-600);
		text-decoration: none;
	}
	.delivery-cities__city {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.delivery-cities__transit {
		font-size: 0.74rem;
		color: var(--color-muted);
	}
	.delivery-cities__chip:hover .delivery-cities__transit {
		color: var(--color-primary-500);
	}

	/* FAQ */
	.faq { margin-bottom: var(--space-8); }
	.faq h2 { font-size: 1.15rem; margin: 0 0 var(--space-4); }
	.faq__list {
		display: grid;
		gap: var(--space-2);
	}
	.faq__item {
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		transition: border-color var(--dur-fast) var(--ease-out);
	}
	.faq__item[open] {
		border-color: var(--color-primary-100);
	}
	.faq__q {
		list-style: none;
		cursor: pointer;
		padding: var(--space-3) var(--space-4);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		font-weight: 600;
		font-size: 0.97rem;
		color: var(--color-text);
		line-height: 1.4;
	}
	.faq__q::-webkit-details-marker { display: none; }
	.faq__chev {
		color: var(--color-subtle);
		flex: 0 0 auto;
		transition: transform var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}
	.faq__item[open] .faq__chev {
		transform: rotate(180deg);
		color: var(--color-primary-500);
	}
	.faq__a {
		margin: 0;
		padding: 0 var(--space-4) var(--space-4);
		color: var(--color-muted);
		font-size: 0.93rem;
		line-height: 1.55;
		max-width: 70ch;
	}

	/* Sticky-цена на мобиле — перекрывает общий MobileStickyBar для product detail */
	.product-sticky {
		display: none;
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 51;
		padding: var(--space-2) var(--space-3);
		padding-bottom: calc(var(--space-2) + env(safe-area-inset-bottom, 0));
		background: rgba(255, 255, 255, 0.97);
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-top: 1px solid var(--color-border);
		box-shadow: 0 -4px 20px rgba(15, 23, 42, 0.08);
		gap: var(--space-3);
		align-items: center;
	}
	@media (max-width: 767px) {
		.product-sticky { display: flex; }
	}
	.product-sticky__price {
		display: flex;
		align-items: baseline;
		gap: 0.2rem;
		font-family: var(--font-mono);
	}
	.product-sticky__num {
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-text);
	}
	.product-sticky__unit {
		font-size: 0.8rem;
		color: var(--color-muted);
	}
	.product-sticky__cta {
		flex: 1;
