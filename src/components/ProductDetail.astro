const imgPath = catalogImage(sku.hub, sku.sub);
const imgAlt = [hubLabel, sku.grade, sku.size ? `${sku.size} мм` : ''].filter(Boolean).join(' ');

// 6 близких позиций по той же марке/переделу — для блока «Похожие позиции»
// Идём через getHubSkus, чтобы данные были согласованы с PriceTable и
