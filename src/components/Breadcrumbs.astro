---
import { siteUrl } from '../data/site';

interface Crumb {
	label: string;
	href?: string;
}
interface Props {
	items: Crumb[];
}
const { items } = Astro.props;

const base = siteUrl.replace(/\/$/, '');
const toAbs = (path: string) => (path.startsWith('http') ? path : `${base}${path.startsWith('/') ? '' : '/'}${path}`);

const currentPath = Astro.url.pathname;

const breadcrumbJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: items.map((item, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: item.label,
		item: toAbs(item.href ?? currentPath),
	})),
};
---

<nav class="crumbs" aria-label="Хлебные крошки">
	<ol class="crumbs__list">
		{
			items.map((item, i) => (
				<li class="crumbs__item">
					{i > 0 && <span class="crumbs__sep" aria-hidden="true">/</span>}
					{item.href ? (
						<a href={item.href}>{item.label}</a>
					) : (
						<span class="crumbs__current">{item.label}</span>
					)}
				</li>
			))
		}
	</ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

<style>
	.crumbs {
		margin-bottom: var(--space-4);
		font-size: 0.875rem;
	}
	.crumbs__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.crumbs__sep {
		color: var(--color-muted);
	}
	.crumbs__current {
		color: var(--color-muted);
	}
</style>
