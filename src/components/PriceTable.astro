---
import pricelist from '../data/pricelist.json';

interface Props {
	hub: 'list' | 'krug' | 'provoloka' | 'detali-truboprovoda' | 'truba';
	title?: string;
	measure?: 'толщина' | 'диаметр' | 'размер' | 'Ø × стенка';
}

const { hub, title = 'Прайс-лист', measure = 'размер' } = Astro.props;

const allSkus: any[] = (pricelist.hubs as any)[hub] ?? [];

const SUB_LABELS: Record<string, string> = {
	nikelesod: 'Никелесодержащий',
	beznikelya: 'Без никеля',
	zharoprochnyj: 'Жаропрочный круг',
	kvadrat: 'Квадрат',
	nikelevyj: 'Круг',
	shestigrannik: 'Шестигранник',
	osnovnaya: 'Проволока',
	flanec: 'Фланцы',
	otvod: 'Отводы',
	elsvarnaya: 'Электросварная',
	besshovnaya: 'Бесшовная',
};

function uniq<T>(arr: T[]): T[] {
	return [...new Set(arr)].filter((x) => x !== null && x !== undefined && x !== '') as T[];
}

const subCounts: Record<string, number> = {};
for (const s of allSkus) subCounts[s.sub] = (subCounts[s.sub] || 0) + 1;
const subTabs = Object.entries(subCounts)
	.map(([sub, count]) => ({ sub, count, label: SUB_LABELS[sub] ?? sub }))
	.sort((a, b) => b.count - a.count);

const grades = uniq(allSkus.map((s) => s.grade)).sort((a: any, b: any) =>
	String(a).localeCompare(String(b), 'ru'),
);
const rolls = uniq(allSkus.map((s) => s.roll)) as string[];
const surfaces = uniq(allSkus.map((s) => s.surface)) as string[];

function fmtPrice(p: number | null) {
	if (p == null) return null;
	return new Intl.NumberFormat('ru-RU').format(p);
}

const PAGE_SIZE = 30;
const showSubTabs = subTabs.length > 1;
---

<section class="pt" data-hub={hub}>
	<header class="pt__head">
		<div>
			<h2 class="pt__title">{title}</h2>
			<p class="pt__sub">
				Цены ориентировочные на {pricelist.updatedAt}. До тонны — указано с наценкой,
				объём от тонны — выгоднее, уточняйте у менеджера.
			</p>
		</div>
		<span class="pt__count" data-pt-count>{allSkus.length} позиций</span>
	</header>

	{
		showSubTabs && (
			<nav class="pt__tabs" aria-label="Подкатегории">
				<button type="button" class="pt__tab pt__tab--active" data-pt-tab="">
					Все <span class="pt__tab-count">{allSkus.length}</span>
				</button>
				{subTabs.map((t) => (
					<button type="button" class="pt__tab" data-pt-tab={t.sub}>
						{t.label} <span class="pt__tab-count">{t.count}</span>
					</button>
				))}
			</nav>
		)
	}

	<div class="pt__filters">
		<div class="pt__field pt__field--search">
			<svg class="pt__search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
				<path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
			</svg>
			<input
				id={`${hub}-q`}
				type="search"
				placeholder="Поиск: марка, размер, AISI 304, 12Х18Н10Т…"
				data-pt-q
				autocomplete="off"
			/>
		</div>
		{
			rolls.length > 1 && (
				<div class="pt__field">
					<select id={`${hub}-roll`} data-pt-roll aria-label="Передел">
						<option value="">Передел: все</option>
						{rolls.map((r) => (
							<option value={r}>{r}</option>
						))}
					</select>
				</div>
			)
		}
		{
			surfaces.length > 1 && (
				<div class="pt__field">
					<select id={`${hub}-surface`} data-pt-surface aria-label="Поверхность">
						<option value="">Поверхность: все</option>
						{surfaces.map((s) => (
							<option value={s}>{s}</option>
						))}
					</select>
				</div>
			)
		}
		{
			grades.length > 1 && (
				<div class="pt__field">
					<select id={`${hub}-grade`} data-pt-grade aria-label="Марка">
						<option value="">Марка: все</option>
						{grades.map((g) => (
							<option value={g}>{g}</option>
						))}
					</select>
				</div>
			)
		}
		<button type="button" class="pt__reset" data-pt-reset>Сбросить</button>
	</div>

	<div class="pt__wrap">
		<table class="pt__table">
			<thead>
				<tr>
					<th>Марка</th>
					<th>{measure}</th>
					<th class="pt__th-price">Цена</th>
					<th class="pt__th-action">&nbsp;</th>
				</tr>
			</thead>
			<tbody data-pt-body></tbody>
		</table>
	</div>

	<div class="pt__pager" data-pt-pager hidden>
		<button type="button" class="pt__page-btn" data-pt-prev aria-label="Предыдущая страница">‹</button>
		<div class="pt__pages" data-pt-pages></div>
		<button type="button" class="pt__page-btn" data-pt-next aria-label="Следующая страница">›</button>
	</div>

	<p class="pt__empty" data-pt-empty hidden>Ничего не найдено по фильтрам — попробуйте сбросить.</p>
</section>

<script define:vars={{ hub, allSkus, PAGE_SIZE, SUB_LABELS }}>
	const root = document.querySelector(`.pt[data-hub="${hub}"]`);
	if (root) {
		const fmt = (p) => (p == null ? null : new Intl.NumberFormat('ru-RU').format(p));
		const body = root.querySelector('[data-pt-body]');
		const countEl = root.querySelector('[data-pt-count]');
		const emptyEl = root.querySelector('[data-pt-empty]');
		const resetBtn = root.querySelector('[data-pt-reset]');
		const pager = root.querySelector('[data-pt-pager]');
		const pagesEl = root.querySelector('[data-pt-pages]');
		const prevBtn = root.querySelector('[data-pt-prev]');
		const nextBtn = root.querySelector('[data-pt-next]');
		const tabs = Array.from(root.querySelectorAll('[data-pt-tab]'));

		const inputs = {
			q: root.querySelector('[data-pt-q]'),
			roll: root.querySelector('[data-pt-roll]'),
			surface: root.querySelector('[data-pt-surface]'),
			grade: root.querySelector('[data-pt-grade]'),
		};

		const state = { sub: '', page: 1 };

		function escapeHtml(s) {
			return String(s ?? '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}

		function rowMatches(s, f) {
			if (state.sub && s.sub !== state.sub) return false;
			if (f.roll && (s.roll || '') !== f.roll) return false;
			if (f.surface && (s.surface || '') !== f.surface) return false;
			if (f.grade && s.grade !== f.grade) return false;
			if (f.q) {
				const hay = `${s.grade} ${SUB_LABELS[s.sub] || s.sub} ${s.roll || ''} ${s.surface || ''} ${s.size}`.toLowerCase();
				if (!hay.includes(f.q)) return false;
			}
			return true;
		}

		function buildPager(totalPages, current) {
			if (totalPages <= 1) {
				pager.hidden = true;
				return;
			}
			pager.hidden = false;
			prevBtn.disabled = current <= 1;
			nextBtn.disabled = current >= totalPages;

			// Compact pager: 1 … (cur-1) cur (cur+1) … last
			const pages = new Set([1, totalPages, current, current - 1, current + 1]);
			const sorted = [...pages].filter((n) => n >= 1 && n <= totalPages).sort((a, b) => a - b);
			let html = '';
			let prev = 0;
			for (const n of sorted) {
				if (prev && n - prev > 1) html += '<span class="pt__gap">…</span>';
				html += `<button type="button" class="pt__page${n === current ? ' pt__page--active' : ''}" data-page="${n}">${n}</button>`;
				prev = n;
			}
			pagesEl.innerHTML = html;
			pagesEl.querySelectorAll('[data-page]').forEach((b) => {
				b.addEventListener('click', () => {
					state.page = Number(b.getAttribute('data-page'));
					render();
					root.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});
			});
		}

		function render() {
			const f = {
				q: (inputs.q?.value || '').trim().toLowerCase(),
				roll: inputs.roll?.value || '',
				surface: inputs.surface?.value || '',
				grade: inputs.grade?.value || '',
			};
			const filtered = allSkus.filter((s) => rowMatches(s, f));
			const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
			if (state.page > totalPages) state.page = totalPages;
			const start = (state.page - 1) * PAGE_SIZE;
			const visible = filtered.slice(start, start + PAGE_SIZE);

			countEl.textContent = `${filtered.length} позиций`;
			emptyEl.hidden = filtered.length > 0;

			body.innerHTML = visible
				.map((s) => {
					// Hide sub-label in row when tab already shows it (tab is active and not "all").
					// Otherwise include sub. Always show roll + surface as secondary tags.
					const tags = [];
					if (!state.sub) {
						const subLabel = SUB_LABELS[s.sub] || s.sub;
						if (subLabel) tags.push(escapeHtml(subLabel));
					}
					if (s.roll) tags.push(escapeHtml(s.roll));
					if (s.surface) tags.push(escapeHtml(s.surface));
					const tagsHtml = tags.length
						? `<span class="pt__sub-tag">${tags.join(' · ')}</span>`
						: '';
					const price = s.price
						? `<strong>${fmt(s.price)}</strong> <span class="pt__unit">₽/${escapeHtml(s.unit)}</span>`
						: '<span class="pt__on-request">по запросу</span>';
					return `<tr>
						<td class="pt__cell-grade">
							<span class="pt__grade">${escapeHtml(s.grade)}</span>
							${tagsHtml}
						</td>
						<td class="pt__cell-num"><span class="pt__cell-num-inner">${escapeHtml(s.size)}<span class="pt__cell-num-suffix">мм</span></span></td>
						<td class="pt__cell-price">${price}</td>
						<td class="pt__cell-action"><a href="/${hub}/${escapeHtml(s.slug)}/" class="pt__cta">Подробнее →</a></td>
					</tr>`;
				})
				.join('');

			buildPager(totalPages, state.page);
		}

		Object.values(inputs).forEach((el) => {
			if (!el) return;
			const ev = el.tagName === 'SELECT' ? 'change' : 'input';
			el.addEventListener(ev, () => {
				state.page = 1;
				render();
			});
		});

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const sub = tab.getAttribute('data-pt-tab') || '';
				state.sub = sub;
				state.page = 1;
				tabs.forEach((t) => t.classList.toggle('pt__tab--active', t === tab));
				render();
			});
		});

		prevBtn?.addEventListener('click', () => {
			if (state.page > 1) {
				state.page--;
				render();
				root.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});
		nextBtn?.addEventListener('click', () => {
			state.page++;
			render();
			root.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});

		resetBtn?.addEventListener('click', () => {
			Object.values(inputs).forEach((el) => {
				if (!el) return;
				el.value = '';
			});
			state.sub = '';
			state.page = 1;
			tabs.forEach((t, i) => t.classList.toggle('pt__tab--active', i === 0));
			render();
		});

		render();
	}
</script>

<style>
	.pt {
		margin-block: var(--space-8);
	}
	.pt__head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-5);
	}
	.pt__title {
		margin: 0 0 var(--space-1);
		font-size: 1.4rem;
		letter-spacing: -0.015em;
	}
	.pt__sub {
		margin: 0;
		font-size: 0.88rem;
		color: var(--color-muted);
		max-width: 60ch;
	}
	.pt__count {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		font-weight: 500;
		white-space: nowrap;
	}

	/* Subcategory tabs */
	.pt__tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}
	.pt__tab {
		font: inherit;
		font-size: 0.92rem;
		font-weight: 500;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.55rem 0.95rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-text);
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.pt__tab:hover {
		border-color: var(--color-primary-500);
		color: var(--color-primary-600);
	}
	.pt__tab--active {
		background: var(--color-primary-500);
		border-color: var(--color-primary-500);
		color: var(--color-on-dark);
	}
	.pt__tab--active:hover {
		color: var(--color-on-dark);
	}
	.pt__tab-count {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		opacity: 0.8;
	}

	/* Filters bar */
	.pt__filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		align-items: stretch;
		margin-bottom: var(--space-4);
	}
	.pt__field {
		display: flex;
		align-items: stretch;
		min-width: 0;
	}
	.pt__field--search {
		flex: 1 1 280px;
		position: relative;
	}
	.pt__search-icon {
		position: absolute;
		left: 0.85rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--color-subtle);
		pointer-events: none;
	}
	.pt__field--search input {
		width: 100%;
		padding-left: 2.4rem;
	}
	.pt__field input,
	.pt__field select {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		color: var(--color-text);
		outline: none;
		min-width: 0;
		width: 100%;
		transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.pt__field input:focus,
	.pt__field select:focus {
		border-color: var(--color-primary-500);
		box-shadow: 0 0 0 3px var(--color-primary-100);
	}
	.pt__reset {
		font: inherit;
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--color-muted);
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0.6rem 1rem;
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
		white-space: nowrap;
	}
	.pt__reset:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	/* Table */
	.pt__wrap {
		overflow-x: auto;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04), 0 8px 24px -12px rgba(15, 23, 42, 0.08);
	}
	.pt__table {
		width: 100%;
		border-collapse: separate;
		border-spacing: 0;
		font-size: 1rem;
		min-width: 720px;
		table-layout: auto;
	}
	.pt__table thead th {
		position: sticky;
		top: 0;
		z-index: 1;
		text-align: left;
		padding: 1rem 1.25rem;
		font-weight: 600;
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-subtle);
		background: var(--color-bg-elev);
		border-bottom: 2px solid var(--color-border);
		white-space: nowrap;
	}
	.pt__th-price,
	.pt__th-action {
		text-align: right;
	}
	.pt__table tbody td {
		padding: 1.15rem 1.25rem;
		border-bottom: 1px solid var(--color-border);
		vertical-align: middle;
		background: var(--color-surface);
		transition: background var(--dur-fast) var(--ease-out);
	}
	.pt__table tbody tr:nth-child(even) td {
		background: #fafbfc;
	}
	.pt__table tbody tr:last-child td {
		border-bottom: 0;
	}
	.pt__table tbody tr:hover td {
		background: var(--color-primary-50);
	}
	.pt__cell-grade {
		min-width: 280px;
	}
	.pt__grade {
		display: block;
		font-weight: 600;
		font-size: 1.05rem;
		color: var(--color-text);
		line-height: 1.3;
		letter-spacing: -0.005em;
	}
	.pt__sub-tag {
		display: block;
		font-size: 0.85rem;
		color: var(--color-subtle);
		margin-top: 4px;
	}
	.pt__cell-num {
		font-family: var(--font-mono);
		font-size: 1rem;
		font-weight: 600;
		color: var(--color-text);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.pt__cell-num-inner {
		display: inline-flex;
		align-items: baseline;
		gap: 0.25rem;
		padding: 0.4rem 0.8rem;
		background: #eef2f7;
		border-radius: var(--radius-md);
		font-size: 1rem;
		font-weight: 600;
	}
	.pt__cell-num-suffix {
		font-family: var(--font-sans);
		font-size: 0.78rem;
		color: var(--color-subtle);
		font-weight: 500;
	}
	.pt__cell-price {
		text-align: right;
		font-family: var(--font-mono);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.pt__cell-price strong {
		font-weight: 700;
		color: var(--color-text);
		font-size: 1.15rem;
		letter-spacing: -0.01em;
	}
	.pt__unit {
		font-size: 0.82rem;
		color: var(--color-subtle);
		font-weight: 500;
		margin-left: 0.2rem;
	}
	.pt__on-request {
		font-family: var(--font-sans);
		font-size: 0.9rem;
		color: var(--color-accent);
		font-weight: 600;
	}
	.pt__cell-action {
		text-align: right;
		white-space: nowrap;
	}
	.pt__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--color-primary-500);
		text-decoration: none;
		padding: 0.55rem 0.95rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		transition: all var(--dur-fast) var(--ease-out);
	}
	.pt__cta:hover {
		color: var(--color-on-dark);
		background: var(--color-primary-500);
		border-color: var(--color-primary-500);
		text-decoration: none;
	}

	/* Pagination */
	.pt__pager {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-5);
	}
	.pt__page-btn,
	.pt__page {
		font: inherit;
		font-size: 0.9rem;
		font-weight: 500;
		min-width: 38px;
		height: 38px;
		padding: 0 0.6rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		color: var(--color-text);
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.pt__page-btn:hover:not(:disabled),
	.pt__page:hover {
		border-color: var(--color-primary-500);
		color: var(--color-primary-600);
	}
	.pt__page-btn:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
	.pt__page--active {
		background: var(--color-primary-500);
		border-color: var(--color-primary-500);
		color: var(--color-on-dark);
	}
	.pt__page--active:hover {
		background: var(--color-primary-600);
		border-color: var(--color-primary-600);
		color: var(--color-on-dark);
	}
	.pt__pages {
		display: flex;
		gap: var(--space-1);
	}
	.pt__gap {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 24px;
		color: var(--color-subtle);
	}

	.pt__empty {
		text-align: center;
		color: var(--color-muted);
		font-size: 0.95rem;
		padding: var(--space-5);
		margin: var(--space-4) 0 0;
	}
</style>
