---
import pricelist from '../data/pricelist.json';

interface Props {
	hub: 'list' | 'krug' | 'provoloka' | 'detali-truboprovoda' | 'truba';
	title?: string;
	measure?: 'толщина' | 'диаметр' | 'размер' | 'Ø × стенка';
}

const { hub, title = 'Прайс-лист', measure = 'размер' } = Astro.props;

const allSkus: any[] = (pricelist.hubs as any)[hub] ?? [];

const SUB_LABELS: Record<string, string> = {
	nikelesod: 'Никелесодержащий',
	beznikelya: 'Без никеля',
	zharoprochnyj: 'Жаропрочный круг',
	kvadrat: 'Квадрат',
	nikelevyj: 'Круг',
	shestigrannik: 'Шестигранник',
	osnovnaya: 'Проволока',
	flanec: 'Фланцы',
	otvod: 'Отводы',
	elsvarnaya: 'Электросварная',
	besshovnaya: 'Бесшовная',
};

function uniq<T>(arr: T[]): T[] {
	return [...new Set(arr)].filter((x) => x !== null && x !== undefined && x !== '') as T[];
}

const subCounts: Record<string, number> = {};
for (const s of allSkus) subCounts[s.sub] = (subCounts[s.sub] || 0) + 1;
const subTabs = Object.entries(subCounts)
	.map(([sub, count]) => ({ sub, count, label: SUB_LABELS[sub] ?? sub }))
	.sort((a, b) => b.count - a.count);

const grades = uniq(allSkus.map((s) => s.grade)).sort((a: any, b: any) =>
	String(a).localeCompare(String(b), 'ru'),
);
const rolls = uniq(allSkus.map((s) => s.roll)) as string[];
const surfaces = uniq(allSkus.map((s) => s.surface)) as string[];

function fmtPrice(p: number | null) {
	if (p == null) return null;
	return new Intl.NumberFormat('ru-RU').format(p);
}

const PAGE_SIZE = 15;
const showSubTabs = subTabs.length > 1;
---

<section class="pt" data-hub={hub}>
	<header class="pt__head">
		<div>
			<h2 class="pt__title">{title}</h2>
			<p class="pt__sub">
				Цены ориентировочные на {pricelist.updatedAt}. До тонны — указано с наценкой,
				объём от тонны — выгоднее, уточняйте у менеджера.
			</p>
		</div>
		<span class="pt__count" data-pt-count>{allSkus.length} позиций</span>
	</header>

	{
		showSubTabs && (
			<nav class="pt__tabs" aria-label="Подкатегории">
				<button type="button" class="pt__tab pt__tab--active" data-pt-tab="">
					Все <span class="pt__tab-count">{allSkus.length}</span>
				</button>
				{subTabs.map((t) => (
					<button type="button" class="pt__tab" data-pt-tab={t.sub}>
						{t.label} <span class="pt__tab-count">{t.count}</span>
					</button>
				))}
			</nav>
		)
	}

	<div class="pt__filters">
		<div class="pt__field pt__field--search">
			<svg class="pt__search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
				<circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
				<path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
			</svg>
			<input
				id={`${hub}-q`}
				type="search"
				placeholder="Поиск: марка, размер, AISI 304, 12Х18Н10Т…"
				data-pt-q
				autocomplete="off"
			/>
		</div>
		{
			rolls.length > 1 && (
				<div class="pt__field">
					<select id={`${hub}-roll`} data-pt-roll aria-label="Передел">
						<option value="">Передел: все</option>
						{rolls.map((r) => (
							<option value={r}>{r}</option>
						))}
					</select>
				</div>
			)
		}
		{
			surfaces.length > 1 && (
				<div class="pt__field">
					<select id={`${hub}-surface`} data-pt-surface aria-label="Поверхность">
						<option value="">Поверхность: все</option>
						{surfaces.map((s) => (
							<option value={s}>{s}</option>
						))}
					</select>
				</div>
			)
		}
		{
			grades.length > 1 && (
				<div class="pt__field">
					<select id={`${hub}-grade`} data-pt-grade aria-label="Марка">
						<option value="">Марка: все</option>
						{grades.map((g) => (
							<option value={g}>{g}</option>
						))}
					</select>
				</div>
			)
		}
		<button type="button" class="pt__reset" data-pt-reset>Сбросить</button>
	</div>

	<div class="pt__list" data-pt-body></div>

	<div class="pt__pager" data-pt-pager hidden>
		<button type="button" class="pt__page-btn" data-pt-prev aria-label="Предыдущая страница">‹</button>
		<div class="pt__pages" data-pt-pages></div>
		<button type="button" class="pt__page-btn" data-pt-next aria-label="Следующая страница">›</button>
	</div>

	<p class="pt__empty" data-pt-empty hidden>Ничего не найдено по фильтрам — попробуйте сбросить.</p>
</section>

<script define:vars={{ hub, allSkus, PAGE_SIZE, SUB_LABELS }}>
	const root = document.querySelector(`.pt[data-hub="${hub}"]`);
	if (root) {
		const fmt = (p) => (p == null ? null : new Intl.NumberFormat('ru-RU').format(p));
		const body = root.querySelector('[data-pt-body]');
		const countEl = root.querySelector('[data-pt-count]');
		const emptyEl = root.querySelector('[data-pt-empty]');
		const resetBtn = root.querySelector('[data-pt-reset]');
		const pager = root.querySelector('[data-pt-pager]');
		const pagesEl = root.querySelector('[data-pt-pages]');
		const prevBtn = root.querySelector('[data-pt-prev]');
		const nextBtn = root.querySelector('[data-pt-next]');
		const tabs = Array.from(root.querySelectorAll('[data-pt-tab]'));

		const inputs = {
			q: root.querySelector('[data-pt-q]'),
			roll: root.querySelector('[data-pt-roll]'),
			surface: root.querySelector('[data-pt-surface]'),
			grade: root.querySelector('[data-pt-grade]'),
		};

		const state = { sub: '', page: 1 };

		function escapeHtml(s) {
			return String(s ?? '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}

		function rowMatches(s, f) {
			if (state.sub && s.sub !== state.sub) return false;
			if (f.roll && (s.roll || '') !== f.roll) return false;
			if (f.surface && (s.surface || '') !== f.surface) return false;
			if (f.grade && s.grade !== f.grade) return false;
			if (f.q) {
				const hay = `${s.grade} ${SUB_LABELS[s.sub] || s.sub} ${s.roll || ''} ${s.surface || ''} ${s.size}`.toLowerCase();
				if (!hay.includes(f.q)) return false;
			}
			return true;
		}

		function buildPager(totalPages, current) {
			if (totalPages <= 1) {
				pager.hidden = true;
				return;
			}
			pager.hidden = false;
			prevBtn.disabled = current <= 1;
			nextBtn.disabled = current >= totalPages;

			// Compact pager: 1 … (cur-1) cur (cur+1) … last
			const pages = new Set([1, totalPages, current, current - 1, current + 1]);
			const sorted = [...pages].filter((n) => n >= 1 && n <= totalPages).sort((a, b) => a - b);
			let html = '';
			let prev = 0;
			for (const n of sorted) {
				if (prev && n - prev > 1) html += '<span class="pt__gap">…</span>';
				html += `<button type="button" class="pt__page${n === current ? ' pt__page--active' : ''}" data-page="${n}">${n}</button>`;
				prev = n;
			}
			pagesEl.innerHTML = html;
			pagesEl.querySelectorAll('[data-page]').forEach((b) => {
				b.addEventListener('click', () => {
					state.page = Number(b.getAttribute('data-page'));
					render();
					root.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});
			});
		}

		function groupSkus(skus) {
			const groups = new Map();
			for (const s of skus) {
				const key = `${s.grade}|${s.roll || ''}|${s.surface || ''}|${s.sub}`;
				let g = groups.get(key);
				if (!g) {
					g = {
						grade: s.grade,
						roll: s.roll,
						surface: s.surface,
						sub: s.sub,
						unit: s.unit,
						items: [],
						minPrice: Infinity,
						maxPrice: -Infinity,
					};
					groups.set(key, g);
				}
				g.items.push(s);
				if (s.price != null) {
					if (s.price < g.minPrice) g.minPrice = s.price;
					if (s.price > g.maxPrice) g.maxPrice = s.price;
				}
			}
			// Sort each group's items by numeric size
			for (const g of groups.values()) {
				g.items.sort((a, b) => {
					const na = parseFloat(String(a.size).replace(/^Ø/, '').replace(/×.*/, ''));
					const nb = parseFloat(String(b.size).replace(/^Ø/, '').replace(/×.*/, ''));
					return (Number.isFinite(na) ? na : 0) - (Number.isFinite(nb) ? nb : 0);
				});
			}
			return [...groups.values()];
		}

		function priceLabel(g) {
			if (!Number.isFinite(g.minPrice)) {
				return '<span class="pt__on-request">по запросу</span>';
			}
			if (g.minPrice === g.maxPrice) {
				return `<strong>${fmt(g.minPrice)}</strong> <span class="pt__unit">₽/${escapeHtml(g.unit)}</span>`;
			}
			return `<strong>${fmt(g.minPrice)}–${fmt(g.maxPrice)}</strong> <span class="pt__unit">₽/${escapeHtml(g.unit)}</span>`;
		}

		function render() {
			const f = {
				q: (inputs.q?.value || '').trim().toLowerCase(),
				roll: inputs.roll?.value || '',
				surface: inputs.surface?.value || '',
				grade: inputs.grade?.value || '',
			};
			const filtered = allSkus.filter((s) => rowMatches(s, f));
			const groups = groupSkus(filtered);

			const totalPages = Math.max(1, Math.ceil(groups.length / PAGE_SIZE));
			if (state.page > totalPages) state.page = totalPages;
			const start = (state.page - 1) * PAGE_SIZE;
			const visible = groups.slice(start, start + PAGE_SIZE);

			countEl.textContent = `${filtered.length} позиций · ${groups.length} групп`;
			emptyEl.hidden = filtered.length > 0;

			body.innerHTML = visible
				.map((g) => {
					const tags = [];
					if (!state.sub) {
						const subLabel = SUB_LABELS[g.sub] || g.sub;
						if (subLabel) tags.push(escapeHtml(subLabel));
					}
					if (g.roll) tags.push(escapeHtml(g.roll));
					if (g.surface) tags.push(escapeHtml(g.surface));
					const tagsHtml = tags.length
						? `<div class="pt-card__tags">${tags.map((t) => `<span class="pt-card__tag">${t}</span>`).join('')}</div>`
						: '';

					// Render up to 24 size pills inline; if more, show a "+N" overflow.
					const SHOW = 24;
					const head = g.items.slice(0, SHOW);
					const overflow = g.items.length - head.length;
					const pills = head
						.map((s) => {
							const priceTooltip = s.price ? `${fmt(s.price)} ₽/${s.unit}` : 'по запросу';
							return `<a class="pt-pill" href="/${hub}/${escapeHtml(s.slug)}/" title="${escapeHtml(priceTooltip)}">${escapeHtml(s.size)}<span class="pt-pill__suffix">мм</span></a>`;
						})
						.join('');
					const overflowHtml = overflow > 0
						? `<span class="pt-pill pt-pill--more">+${overflow}</span>`
						: '';

					const sizeWord = ['list'].includes(hub) ? 'Толщины' : (hub === 'truba' ? 'Размеры (Ø×стенка)' : 'Размеры');

					return `<article class="pt-card">
						<header class="pt-card__head">
							<div>
								<h3 class="pt-card__grade">${escapeHtml(g.grade)}</h3>
								${tagsHtml}
							</div>
							<div class="pt-card__price">${priceLabel(g)}</div>
						</header>
						<div class="pt-card__sizes">
							<span class="pt-card__sizes-label">${sizeWord} · ${g.items.length}</span>
							<div class="pt-card__pills">${pills}${overflowHtml}</div>
						</div>
					</article>`;
				})
				.join('');

			buildPager(totalPages, state.page);
		}

		Object.values(inputs).forEach((el) => {
			if (!el) return;
			const ev = el.tagName === 'SELECT' ? 'change' : 'input';
			el.addEventListener(ev, () => {
				state.page = 1;
				render();
			});
		});

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const sub = tab.getAttribute('data-pt-tab') || '';
				state.sub = sub;
				state.page = 1;
				tabs.forEach((t) => t.classList.toggle('pt__tab--active', t === tab));
				render();
			});
		});

		prevBtn?.addEventListener('click', () => {
			if (state.page > 1) {
				state.page--;
				render();
				root.scrollIntoView({ behavior: 'smooth', block: 'start' });
			}
		});
		nextBtn?.addEventListener('click', () => {
			state.page++;
			render();
			root.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});

		resetBtn?.addEventListener('click', () => {
			Object.values(inputs).forEach((el) => {
				if (!el) return;
				el.value = '';
			});
			state.sub = '';
			state.page = 1;
			tabs.forEach((t, i) => t.classList.toggle('pt__tab--active', i === 0));
			render();
		});

		render();
	}
</script>

<style is:global>
	.pt {
		margin-block: var(--space-8);
	}
	.pt__head {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-bottom: var(--space-5);
	}
	.pt__title {
		margin: 0 0 var(--space-1);
		font-size: 1.4rem;
		letter-spacing: -0.015em;
	}
	.pt__sub {
		margin: 0;
		font-size: 0.88rem;
		color: var(--color-muted);
		max-width: 60ch;
	}
	.pt__count {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		color: var(--color-primary-500);
		background: var(--color-primary-50);
		padding: 0.3rem 0.7rem;
		border-radius: var(--radius-pill);
		font-weight: 500;
		white-space: nowrap;
	}

	/* Subcategory tabs */
	.pt__tabs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-bottom: var(--space-4);
		padding-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}
	.pt__tab {
		font: inherit;
		font-size: 0.92rem;
		font-weight: 500;
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.55rem 0.95rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-text);
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
	}
	.pt__tab:hover {
		border-color: var(--color-primary-500);
		color: var(--color-primary-600);
	}
	.pt__tab--active {
		background: var(--color-primary-500);
		border-color: var(--color-primary-500);
		color: var(--color-on-dark);
	}
	.pt__tab--active:hover {
		color: var(--color-on-dark);
	}
	.pt__tab-count {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		opacity: 0.8;
	}

	/* Filters bar */
	.pt__filters {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		align-items: stretch;
		margin-bottom: var(--space-4);
	}
	.pt__field {
		display: flex;
		align-items: stretch;
		min-width: 0;
	}
	.pt__field--search {
		flex: 1 1 280px;
		position: relative;
	}
	.pt__search-icon {
		position: absolute;
		left: 0.85rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--color-subtle);
		pointer-events: none;
	}
	.pt__field--search input {
		width: 100%;
		padding-left: 2.4rem;
	}
	.pt__field input,
	.pt__field select {
		font: inherit;
		font-size: 0.9rem;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		background: var(--color-surface);
		color: var(--color-text);
		outline: none;
		min-width: 0;
		width: 100%;
		transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
	}
	.pt__field input:focus,
	.pt__field select:focus {
		border-color: var(--color-primary-500);
		box-shadow: 0 0 0 3px var(--color-primary-100);
	}
	.pt__reset {
		font: inherit;
		font-size: 0.88rem;
		font-weight: 500;
		color: var(--color-muted);
		background: transparent;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		padding: 0.6rem 1rem;
		cursor: pointer;
		transition: all var(--dur-fast) var(--ease-out);
		white-space: nowrap;
	}
	.pt__reset:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}

	/* Catalog card list */
	.pt__list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
	}
	.pt-card {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		padding: 1.4rem 1.6rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-xs);
		transition: border-color var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
	}
	.pt-card:hover {
		border-color: var(--color-primary-500);
		box-shadow: var(--shadow-md);
	}
	.pt-card__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-4);
		flex-wrap: wrap;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--color-border);
	}
	.pt-card__grade {
		margin: 0 0 0.4rem;
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--color-text);
		line-height: 1.2;
	}
	.pt-card__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.pt-card__tag {
		display: inline-block;
		font-size: 0.78rem;
		font-weight: 500;
		padding: 0.2rem 0.65rem;
		background: var(--color-steel-100);
		color: var(--color-steel);
		border-radius: var(--radius-pill);
	}
	.pt-card__price {
		text-align: right;
		font-family: var(--font-mono);
		white-space: nowrap;
		font-variant-numeric: tabular-nums;
	}
	.pt-card__price strong {
		display: inline-block;
		font-weight: 800;
		color: var(--color-text);
		font-size: 1.3rem;
		letter-spacing: -0.015em;
	}
	.pt-card__sizes {
		display: grid;
		gap: 0.6rem;
	}
	.pt-card__sizes-label {
		font-size: 0.74rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-subtle);
	}
	.pt-card__pills {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	/* Size pill — clickable, leads to per-SKU page */
	.pt-pill {
		display: inline-flex;
		align-items: baseline;
		gap: 0.25rem;
		padding: 0.5rem 0.85rem;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		font-family: var(--font-mono);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--color-text);
		text-decoration: none;
		font-variant-numeric: tabular-nums;
		transition: all var(--dur-fast) var(--ease-out);
		white-space: nowrap;
	}
	.pt-pill:hover {
		background: var(--color-primary-500);
		border-color: var(--color-primary-500);
		color: #fff;
		transform: translateY(-1px);
		box-shadow: var(--shadow-sm);
		text-decoration: none;
	}
	.pt-pill__suffix {
		font-family: var(--font-sans);
		font-size: 0.72rem;
		font-weight: 500;
		opacity: 0.7;
	}
	.pt-pill--more {
		background: transparent;
		border-style: dashed;
		color: var(--color-muted);
		cursor: default;
	}

	.pt__unit {
		font-family: var(--font-sans);
		font-size: 0.85rem;
		color: var(--color-accent);
		font-weight: 600;
		margin-left: 0.25rem;
	}
	.pt__on-request {
		font-family: var(--font-sans);
		font-size: 1rem;
		color: var(--color-accent);
		font-weight: 700;
	}

	/* legacy table styles kept inert for now (no .pt__wrap in template) */
	.pt__wrap {
		display: none;
	}
	.pt__table {
		width: 100%;
