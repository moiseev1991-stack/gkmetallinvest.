---
import pricelist from '../data/pricelist.json';

interface Props {
	hub:
		| 'list'
		| 'krug'
		| 'provoloka'
		| 'detali-truboprovoda'
		| 'truba'
		| 'polosa'
		| 'ugolok-shveller'
		| 'podshipniki'
		| 'rulon'
		| 'elektrody';
	title?: string;
	measure?: 'толщина' | 'диаметр' | 'размер' | 'Ø × стенка';
}

const { hub, title = 'Прайс-лист', measure = 'размер' } = Astro.props;

const allSkus: any[] = (pricelist.hubs as any)[hub] ?? [];

const SUB_LABELS: Record<string, string> = {
	nikelesod: 'Никелесодержащий',
	beznikelya: 'Без никеля',
	zharoprochnyj: 'Жаропрочный круг',
	kvadrat: 'Квадрат',
	nikelevyj: 'Круг',
	shestigrannik: 'Шестигранник',
	osnovnaya: 'Проволока',
	flanec: 'Фланцы',
	otvod: 'Отводы',
	troynik: 'Тройники',
	perehod: 'Переходы',
	zaglushka: 'Заглушки',
	zadvizhka: 'Задвижки',
	shtutser: 'Штуцеры',
	klapan: 'Клапаны и затворы',
	prochee: 'Прочее',
	lestnichnye: 'Лестничные ограждения',
	elsvarnaya: 'Электросварная',
	'elsvarnaya-kvadrat': 'Электросварная квадратная',
	'elsvarnaya-pryamougolnaya': 'Электросварная прямоугольная',
	besshovnaya: 'Бесшовная',
	perforirovannaya: 'Перфорированная',
	duplex: 'Duplex',
	profnastil: 'Профнастил',
	pvl: 'ПВЛ',
	ugolok: 'Уголок',
	shveller: 'Швеллер',
	krepyozh: 'Крепёж',
};

function uniq<T>(arr: T[]): T[] {
	return [...new Set(arr)].filter((x) => x !== null && x !== undefined && x !== '') as T[];
}

function sizeNum(s: unknown): number {
	const m = String(s ?? '').match(/-?\d+(?:[.,]\d+)?/);
	return m ? parseFloat(m[0].replace(',', '.')) : NaN;
}

const grades = uniq(allSkus.map((s) => s.grade)).sort((a: any, b: any) =>
	String(a).localeCompare(String(b), 'ru'),
);
const facts = uniq(allSkus.map((s) => s.fact)).sort((a: any, b: any) =>
	String(a).localeCompare(String(b), 'ru'),
);
const subs = uniq(allSkus.map((s) => s.sub)).sort((a: any, b: any) =>
	(SUB_LABELS[a] ?? a).localeCompare(SUB_LABELS[b] ?? b, 'ru'),
);
const surfaces = uniq(allSkus.map((s) => s.surface)).sort((a: any, b: any) =>
	String(a).localeCompare(String(b), 'ru'),
);
const rolls = uniq(allSkus.map((s) => s.roll)).sort((a: any, b: any) =>
	String(a).localeCompare(String(b), 'ru'),
);
const sizeNums = allSkus.map((s) => sizeNum(s.size)).filter((n) => !Number.isNaN(n));
const hasSizeRange = sizeNums.length > 0;
const sizeRangeMin = hasSizeRange ? Math.min(...sizeNums) : 0;
const sizeRangeMax = hasSizeRange ? Math.max(...sizeNums) : 0;
const sizePh = (n: number) =>
	Number.isInteger(n) ? String(n) : String(+n.toFixed(2)).replace('.', ',');

// Skip columns that carry no signal for this hub.
const hasDlina = allSkus.some((s) => s.dlina !== null && s.dlina !== undefined && s.dlina !== '');
const hasFact = allSkus.some((s) => s.fact);
// Show second price column only when most SKUs actually have two distinct
// prices — a handful of exceptions out of hundreds (e.g. detali-truboprovoda)
// don't justify a noisy duplicate column.
const _differingPrices = allSkus.filter((s) => s.price != null && s.priceUnit != null && s.price !== s.priceUnit).length;
const hasUniquePrices = allSkus.length > 0 && _differingPrices / allSkus.length > 0.5;
const hasOstatok = allSkus.some((s) => s.ostatok);

const PAGE_SIZE = 50;
const unitDefault = allSkus[0]?.unit ?? 'т';

const updatedAtDisplay = (() => {
	const m = String(pricelist.updatedAt || '').match(/^(\d{4})-(\d{2})-(\d{2})$/);
	if (!m) return String(pricelist.updatedAt || '');
	const months = ['января','февраля','марта','апреля','мая','июня','июля','августа','сентября','октября','ноября','декабря'];
	return `${parseInt(m[3], 10)} ${months[parseInt(m[2], 10) - 1]} ${m[1]}`;
})();

const measureLabel = measure === 'Ø × стенка' ? 'Ø × ст.' : 'Размер';
---

<section class="pt" data-hub={hub}>
	<header class="pt__head">
		<div>
			<h2 class="pt__title">{title}</h2>
			<p class="pt__sub">
				Цены с наценкой 5% на {updatedAtDisplay}. Цены ориентировочные — наличие
				и финальную цену уточняйте у менеджера.
			</p>
		</div>
		<span class="pt__count" data-pt-count>{allSkus.length} позиций</span>
	</header>

	<div class="pt__panel">
		<div class="pt__filters">
			<label class="pt__field pt__field--search">
				<svg class="pt__search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
					<circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
					<path d="M11 11l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
				</svg>
				<input
					id={`${hub}-q`}
					type="search"
					placeholder="Поиск по марке, размеру, названию"
					data-pt-q
					autocomplete="off"
				/>
			</label>

			{
				subs.length > 1 && (
					<label class="pt__field pt__field--select" data-pt-label="Тип">
						<span class="pt__label">Тип</span>
						<select id={`${hub}-sub`} data-pt-sub aria-label="Тип">
							<option value="">все</option>
							{subs.map((s) => (
								<option value={s}>{SUB_LABELS[s] ?? s}</option>
							))}
						</select>
					</label>
				)
			}
			{
				grades.length > 1 && (
					<label class="pt__field pt__field--select" data-pt-label="Марка">
						<span class="pt__label">Марка</span>
						<select id={`${hub}-grade`} data-pt-grade aria-label="Марка">
							<option value="">все</option>
							{grades.map((g) => (
								<option value={g}>{g}</option>
							))}
						</select>
					</label>
				)
			}
			{
				surfaces.length > 1 && (
					<label class="pt__field pt__field--select" data-pt-label="Поверхность">
						<span class="pt__label">Поверхность</span>
						<select id={`${hub}-surface`} data-pt-surface aria-label="Поверхность">
							<option value="">все</option>
							{surfaces.map((s) => (
								<option value={s}>{s}</option>
							))}
						</select>
					</label>
				)
			}
			{
				rolls.length > 1 && (
					<label class="pt__field pt__field--select" data-pt-label="Прокат">
						<span class="pt__label">Прокат</span>
						<select id={`${hub}-roll`} data-pt-roll aria-label="Прокат">
							<option value="">все</option>
							{rolls.map((r) => (
								<option value={r}>{r}</option>
							))}
						</select>
					</label>
				)
			}
			{
				hasSizeRange && (
					<div class="pt__field pt__field--range" role="group" aria-label={`${measure} от и до, мм`}>
						<span class="pt__label">{measureLabel}, мм</span>
						<div class="pt__range-row">
							<input
								type="number"
								inputmode="decimal"
								step="any"
								min={sizeRangeMin}
								max={sizeRangeMax}
								placeholder={sizePh(sizeRangeMin)}
								aria-label={`${measure} от`}
								data-pt-size-min
							/>
							<span class="pt__range-sep" aria-hidden="true">–</span>
							<input
								type="number"
								inputmode="decimal"
								step="any"
								min={sizeRangeMin}
								max={sizeRangeMax}
								placeholder={sizePh(sizeRangeMax)}
								aria-label={`${measure} до`}
								data-pt-size-max
							/>
						</div>
					</div>
				)
			}
			{
				facts.length > 1 && (
					<label class="pt__field pt__field--select" data-pt-label="Склад">
						<span class="pt__label">Склад</span>
						<select id={`${hub}-fact`} data-pt-fact aria-label="Склад">
							<option value="">все</option>
							{facts.map((f) => (
								<option value={f}>{f}</option>
							))}
						</select>
					</label>
				)
			}
			{
				hasOstatok && (
					<label class="pt__field pt__field--toggle">
						<input type="checkbox" data-pt-instock />
						<span class="pt__toggle-track" aria-hidden="true"><span class="pt__toggle-dot"></span></span>
						<span class="pt__toggle-text">Только в наличии</span>
					</label>
				)
			}
		</div>

		<div class="pt__chips" data-pt-chips hidden></div>
	</div>

	<div class="pt__table-wrap">
		<table class="pt__table">
			<colgroup>
				<col class="pt__col-name" />
				<col class="pt__col-size" />
				<col class="pt__col-grade" />
				{hasDlina && <col class="pt__col-len" />}
				{hasFact && <col class="pt__col-fact" />}
				{hasUniquePrices && <col class="pt__col-price" />}
				<col class="pt__col-price pt__col-price--main" />
				<col class="pt__col-act" />
			</colgroup>
			<thead>
				<tr>
					<th class="pt__th" data-sort="name">
						<span class="pt__th-inner">Продукция<span class="pt__sort" aria-hidden="true">
							<svg width="8" height="12" viewBox="0 0 8 12" fill="none">
								<path class="pt__sort-up" d="M4 1.5l3 3.5H1z" fill="currentColor" />
								<path class="pt__sort-dn" d="M4 10.5l3 -3.5H1z" fill="currentColor" />
							</svg>
						</span></span>
					</th>
					<th class="pt__th pt__th--num" data-sort="size">
						<span class="pt__th-inner">{measureLabel}<span class="pt__sort" aria-hidden="true">
							<svg width="8" height="12" viewBox="0 0 8 12" fill="none">
								<path class="pt__sort-up" d="M4 1.5l3 3.5H1z" fill="currentColor" />
								<path class="pt__sort-dn" d="M4 10.5l3 -3.5H1z" fill="currentColor" />
							</svg>
						</span></span>
					</th>
					<th class="pt__th" data-sort="grade">
						<span class="pt__th-inner">Марка<span class="pt__sort" aria-hidden="true">
							<svg width="8" height="12" viewBox="0 0 8 12" fill="none">
								<path class="pt__sort-up" d="M4 1.5l3 3.5H1z" fill="currentColor" />
								<path class="pt__sort-dn" d="M4 10.5l3 -3.5H1z" fill="currentColor" />
							</svg>
						</span></span>
					</th>
					{hasDlina && <th class="pt__th pt__th--num"><span class="pt__th-inner">Длина</span></th>}
					{hasFact && <th class="pt__th"><span class="pt__th-inner">Склад</span></th>}
					{hasUniquePrices && (
						<th class="pt__th pt__th--price" data-sort="priceUnit">
							<span class="pt__th-inner">
								<span>Цена <span class="pt__th-unit">₽/{unitDefault}</span><span class="pt__th-hint">розн.</span></span>
								<span class="pt__sort" aria-hidden="true">
									<svg width="8" height="12" viewBox="0 0 8 12" fill="none">
										<path class="pt__sort-up" d="M4 1.5l3 3.5H1z" fill="currentColor" />
										<path class="pt__sort-dn" d="M4 10.5l3 -3.5H1z" fill="currentColor" />
									</svg>
								</span>
							</span>
						</th>
					)}
					<th class="pt__th pt__th--price pt__th--main" data-sort="price">
						<span class="pt__th-inner">
							<span>Цена <span class="pt__th-unit">₽/{unitDefault}</span>{hasUniquePrices && <span class="pt__th-hint">от 1т</span>}</span>
							<span class="pt__sort" aria-hidden="true">
								<svg width="8" height="12" viewBox="0 0 8 12" fill="none">
									<path class="pt__sort-up" d="M4 1.5l3 3.5H1z" fill="currentColor" />
									<path class="pt__sort-dn" d="M4 10.5l3 -3.5H1z" fill="currentColor" />
								</svg>
							</span>
						</span>
					</th>
					<th class="pt__th pt__th--act"><span class="sr-only">Действие</span></th>
				</tr>
			</thead>
			<tbody data-pt-body></tbody>
		</table>
	</div>

	<div class="pt__pager" data-pt-pager hidden>
		<button type="button" class="pt__page-btn" data-pt-prev aria-label="Предыдущая страница">‹</button>
		<div class="pt__pages" data-pt-pages></div>
		<button type="button" class="pt__page-btn" data-pt-next aria-label="Следующая страница">›</button>
	</div>

	<p class="pt__empty" data-pt-empty hidden>Ничего не найдено по фильтрам — попробуйте сбросить.</p>
</section>

<script define:vars={{ hub, allSkus, PAGE_SIZE, SUB_LABELS, HAS_DLINA: hasDlina, HAS_FACT: hasFact, HAS_UNIQUE_PRICES: hasUniquePrices }}>
	const root = document.querySelector(`.pt[data-hub="${hub}"]`);
	if (root) {
		const fmt = (p) => (p == null ? null : new Intl.NumberFormat('ru-RU').format(p));
		const body = root.querySelector('[data-pt-body]');
		const countEl = root.querySelector('[data-pt-count]');
		const emptyEl = root.querySelector('[data-pt-empty]');
		const chipsEl = root.querySelector('[data-pt-chips]');
		const pager = root.querySelector('[data-pt-pager]');
		const pagesEl = root.querySelector('[data-pt-pages]');
		const prevBtn = root.querySelector('[data-pt-prev]');
		const nextBtn = root.querySelector('[data-pt-next]');

		const inputs = {
			q: root.querySelector('[data-pt-q]'),
			sub: root.querySelector('[data-pt-sub]'),
			grade: root.querySelector('[data-pt-grade]'),
			surface: root.querySelector('[data-pt-surface]'),
			roll: root.querySelector('[data-pt-roll]'),
			fact: root.querySelector('[data-pt-fact]'),
			sizeMin: root.querySelector('[data-pt-size-min]'),
			sizeMax: root.querySelector('[data-pt-size-max]'),
			inStock: root.querySelector('[data-pt-instock]'),
		};

		const state = { page: 1, sortKey: null, sortDir: 'asc' };

		function escapeHtml(s) {
			return String(s ?? '')
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}

		function sizeNum(s) {
			const m = String(s ?? '').match(/-?\d+(?:[.,]\d+)?/);
			return m ? parseFloat(m[0].replace(',', '.')) : NaN;
		}

		function rowMatches(s, f) {
			if (f.sub && (s.sub || '') !== f.sub) return false;
			if (f.grade && s.grade !== f.grade) return false;
			if (f.surface && (s.surface || '') !== f.surface) return false;
			if (f.roll && (s.roll || '') !== f.roll) return false;
			if (f.fact && (s.fact || '') !== f.fact) return false;
			if (f.inStock && !s.ostatok) return false;
			if (f.sizeMin != null || f.sizeMax != null) {
				const n = sizeNum(s.size);
				if (Number.isNaN(n)) return false;
				if (f.sizeMin != null && n < f.sizeMin) return false;
				if (f.sizeMax != null && n > f.sizeMax) return false;
			}
			if (f.q) {
				const hay = `${s.name || ''} ${s.grade || ''} ${SUB_LABELS[s.sub] || s.sub || ''} ${s.roll || ''} ${s.surface || ''} ${s.size || ''}`.toLowerCase();
				if (!hay.includes(f.q)) return false;
			}
			return true;
		}

		function sortRows(rows) {
			if (!state.sortKey) return rows;
			const dir = state.sortDir === 'asc' ? 1 : -1;
			const key = state.sortKey;
			return [...rows].sort((a, b) => {
				let va = a[key];
				let vb = b[key];
				if (key === 'size') { va = sizeNum(va); vb = sizeNum(vb); }
				if (typeof va === 'number' || typeof vb === 'number') {
					if (va == null || Number.isNaN(va)) return 1;
					if (vb == null || Number.isNaN(vb)) return -1;
					return (va - vb) * dir;
				}
				return String(va ?? '').localeCompare(String(vb ?? ''), 'ru') * dir;
			});
		}

		function buildPager(totalPages, current) {
			if (totalPages <= 1) { pager.hidden = true; return; }
			pager.hidden = false;
			prevBtn.disabled = current <= 1;
			nextBtn.disabled = current >= totalPages;
			const pages = new Set([1, totalPages, current, current - 1, current + 1]);
			const sorted = [...pages].filter((n) => n >= 1 && n <= totalPages).sort((a, b) => a - b);
			let html = '';
			let prev = 0;
			for (const n of sorted) {
				if (prev && n - prev > 1) html += '<span class="pt__gap">…</span>';
				html += `<button type="button" class="pt__page${n === current ? ' pt__page--active' : ''}" data-page="${n}">${n}</button>`;
				prev = n;
			}
			pagesEl.innerHTML = html;
			pagesEl.querySelectorAll('[data-page]').forEach((b) => {
				b.addEventListener('click', () => {
					state.page = Number(b.getAttribute('data-page'));
					render();
					root.scrollIntoView({ behavior: 'smooth', block: 'start' });
				});
			});
		}

		function renderRow(s) {
			const name = s.name || `${SUB_LABELS[s.sub] || s.sub || ''} ${s.grade || ''}`.trim();
			const priceUnitCell = s.priceUnit != null ? `<strong>${fmt(s.priceUnit)}</strong>` : '<span class="pt__on-request">по запросу</span>';
			const priceCell = s.price != null ? `<strong>${fmt(s.price)}</strong>` : '<span class="pt__on-request">по запросу</span>';
			const sizeSuffix = String(s.size).startsWith('Ø') ? '' : ' <span class="pt__unit-suffix">мм</span>';
			const dlinaTd = HAS_DLINA
				? `<td class="pt__cell-num pt__cell-muted" data-label="Длина">${escapeHtml(s.dlina || '—')}</td>`
				: '';
			const factTd = HAS_FACT
				? `<td class="pt__cell-fact" data-label="Склад"><span class="pt__fact">${escapeHtml(s.fact || '—')}</span>${s.ostatok ? `<span class="pt__ost"><span class="pt__ost-dot" aria-hidden="true"></span>${s.ostatok}</span>` : ''}</td>`
				: '';
			const priceUnitTd = HAS_UNIQUE_PRICES
				? `<td class="pt__cell-price" data-label="Цена розн.">${priceUnitCell}</td>`
				: '';
			const priceLabel = HAS_UNIQUE_PRICES ? 'Цена от 1т' : 'Цена';
			return `<tr class="pt__row">
				<td class="pt__cell-name" data-label="Продукция"><a class="pt__name-link" href="/${hub}/${escapeHtml(s.slug)}/">${escapeHtml(name)}</a></td>
				<td class="pt__cell-num" data-label="Размер">${escapeHtml(s.size)}${sizeSuffix}</td>
				<td class="pt__cell-grade" data-label="Марка">${escapeHtml(s.grade || '—')}</td>
				${dlinaTd}
				${factTd}
				${priceUnitTd}
				<td class="pt__cell-price pt__cell-price--accent" data-label="${priceLabel}">${priceCell}</td>
				<td class="pt__cell-act"><a class="pt__cta" href="/zapros-kp/#lead-form?sku=${encodeURIComponent(s.slug)}" aria-label="Запросить КП по этой позиции" title="Запросить КП">
					<svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path d="M3 8h9M8 4l4 4-4 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a></td>
			</tr>`;
		}

		function buildChips(f) {
			const chips = [];
			if (f.q) chips.push({ key: 'q', label: `«${f.q}»` });
			if (f.sub) chips.push({ key: 'sub', label: `Тип: ${SUB_LABELS[f.sub] || f.sub}` });
			if (f.grade) chips.push({ key: 'grade', label: `Марка: ${f.grade}` });
			if (f.surface) chips.push({ key: 'surface', label: `Поверхность: ${f.surface}` });
			if (f.roll) chips.push({ key: 'roll', label: `Прокат: ${f.roll}` });
			if (f.fact) chips.push({ key: 'fact', label: `Склад: ${f.fact}` });
			if (f.inStock) chips.push({ key: 'inStock', label: 'В наличии' });
			if (f.sizeMin != null || f.sizeMax != null) {
				const lo = f.sizeMin != null ? String(f.sizeMin).replace('.', ',') : '…';
				const hi = f.sizeMax != null ? String(f.sizeMax).replace('.', ',') : '…';
				chips.push({ key: 'size', label: `Размер: ${lo}–${hi} мм` });
			}
			if (!chips.length) { chipsEl.hidden = true; chipsEl.innerHTML = ''; return; }
			chipsEl.hidden = false;
			chipsEl.innerHTML = chips
				.map((c) => `<button type="button" class="pt__chip" data-chip="${c.key}">${escapeHtml(c.label)}<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 2l6 6M8 2l-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></button>`)
				.join('') + '<button type="button" class="pt__chip pt__chip--reset" data-chip="all">Сбросить все</button>';

			chipsEl.querySelectorAll('[data-chip]').forEach((b) => {
				b.addEventListener('click', () => {
					const key = b.getAttribute('data-chip');
					if (key === 'all') { resetAll(); return; }
					if (key === 'q' && inputs.q) inputs.q.value = '';
					else if (key === 'size') {
						if (inputs.sizeMin) inputs.sizeMin.value = '';
						if (inputs.sizeMax) inputs.sizeMax.value = '';
					}
					else if (key === 'inStock' && inputs.inStock) inputs.inStock.checked = false;
					else if (inputs[key]) inputs[key].value = '';
					state.page = 1;
					render();
				});
			});
		}

		function resetAll() {
			if (inputs.q) inputs.q.value = '';
			['sub','grade','surface','roll','fact','sizeMin','sizeMax'].forEach((k) => { if (inputs[k]) inputs[k].value = ''; });
			if (inputs.inStock) inputs.inStock.checked = false;
			state.sortKey = null; state.sortDir = 'asc'; state.page = 1;
			render();
		}

		function render() {
			const parseRange = (el) => {
				const v = el?.value;
				if (v === '' || v == null) return null;
				const n = parseFloat(String(v).replace(',', '.'));
				return Number.isNaN(n) ? null : n;
			};
			const f = {
				q: (inputs.q?.value || '').trim().toLowerCase(),
				sub: inputs.sub?.value || '',
				grade: inputs.grade?.value || '',
				surface: inputs.surface?.value || '',
				roll: inputs.roll?.value || '',
				fact: inputs.fact?.value || '',
				sizeMin: parseRange(inputs.sizeMin),
				sizeMax: parseRange(inputs.sizeMax),
				inStock: !!inputs.inStock?.checked,
			};
			const filtered = sortRows(allSkus.filter((s) => rowMatches(s, f)));

			const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));
			if (state.page > totalPages) state.page = totalPages;
			const start = (state.page - 1) * PAGE_SIZE;
			const visible = filtered.slice(start, start + PAGE_SIZE);

			countEl.textContent = `${filtered.length} позиций`;
			emptyEl.hidden = filtered.length > 0;
			body.innerHTML = visible.map(renderRow).join('');
			buildPager(totalPages, state.page);
			buildChips(f);

			root.querySelectorAll('[data-sort]').forEach((th) => {
				const key = th.getAttribute('data-sort');
				th.classList.toggle('pt__th--sorted', state.sortKey === key);
				th.classList.toggle('pt__th--asc', state.sortKey === key && state.sortDir === 'asc');
				th.classList.toggle('pt__th--desc', state.sortKey === key && state.sortDir === 'desc');
			});

			Object.entries(inputs).forEach(([k, el]) => {
				if (!el) return;
				const fld = el.closest('.pt__field');
				if (!fld) return;
				let active = false;
				if (el.type === 'checkbox') active = !!el.checked;
				else active = !!(el.value && el.value !== '');
				fld.classList.toggle('pt__field--active', active);
			});
		}

		root.querySelectorAll('[data-sort]').forEach((th) => {
			th.addEventListener('click', () => {
				const key = th.getAttribute('data-sort');
				if (state.sortKey === key) {
					state.sortDir = state.sortDir === 'asc' ? 'desc' : 'asc';
				} else {
					state.sortKey = key;
					state.sortDir = 'asc';
				}
				state.page = 1;
				render();
			});
		});

		Object.values(inputs).forEach((el) => {
			if (!el) return;
			let ev = 'input';
			if (el.tagName === 'SELECT') ev = 'change';
			if (el.type === 'checkbox') ev = 'change';
			el.addEventListener(ev, () => { state.page = 1; render(); });
		});
		prevBtn?.addEventListener('click', () => { if (state.page > 1) { state.page--; render(); root.scrollIntoView({ behavior: 'smooth', block: 'start' }); } });
		nextBtn?.addEventListener('click', () => { state.page++; render(); root.scrollIntoView({ behavior: 'smooth', block: 'start' }); });

		render();
	}
</script>

