---
import { navGroups, navTop, navServices } from '../data/navigation';
import { siteName, contacts } from '../data/site';
import Button from './ui/Button.astro';

const path = Astro.url.pathname;

/** href "/list/" активен на /list/, /list/aisi-304…/, /list/v-moskve/.
 *  href "/" активен только на главной. */
const isActive = (href: string) => {
	if (href === '/') return path === '/';
	const norm = href.endsWith('/') ? href : href + '/';
	return path === norm || path.startsWith(norm);
};

const catalogHrefs = navGroups.flatMap((g) => g.items.map((i) => i.href));
const inCatalog = catalogHrefs.some((h) => isActive(h));

const serviceHrefs = navServices.map((s) => s.href);
const inServices = isActive('/uslugi/') || serviceHrefs.some((h) => isActive(h));
---

<header class="head">
	<div class="head__strip">
		<div class="container head__strip-inner">
			<span class="head__location" aria-hidden="true">
				<svg width="14" height="14" viewBox="0 0 16 16" fill="none">
					<path d="M8 14s5-4.5 5-8a5 5 0 10-10 0c0 3.5 5 8 5 8z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
					<circle cx="8" cy="6" r="1.6" stroke="currentColor" stroke-width="1.4" />
				</svg>
				Нижний Новгород · доставка по РФ
			</span>
			<a class="head__strip-link" href={`tel:${contacts.phoneTel}`}>{contacts.phone}</a>
			<a class="head__strip-link" href={`mailto:${contacts.email}`}>{contacts.email}</a>
		</div>
	</div>

	<div class="container head__inner">
		<div class="head__brand">
			<a class="head__logo" href="/" aria-label={siteName}>
				<img class="head__logo-img" src="/img/logo.png" alt={siteName} width="44" height="44" />
				<span class="head__logo-text">
					<span class="head__logo-name">{siteName}</span>
					<span class="head__logo-tag">нержавеющий металлопрокат</span>
				</span>
			</a>
			<a class="head__mob-phone" href={`tel:${contacts.phoneTel}`} aria-label="Позвонить">
				<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
					<path d="M3.5 4.5c0 7 5 12 12 12l1.5-3-3.5-1.5-1 1c-2-1-3.5-2.5-4.5-4.5l1-1L7.5 4 4.5 5.5z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
				</svg>
			</a>
		</div>

		<button type="button" class="head__burger" aria-expanded="false" aria-controls="nav-drawer" id="nav-toggle">
			<span class="sr-only">Меню</span>
			<span class="head__burger-icon"></span>
		</button>

		<div class="head__nav-backdrop" data-nav-backdrop aria-hidden="true"></div>
		<div class="head__nav-wrap" id="nav-drawer">
			<nav class="head__nav" aria-label="Основное">
				<div class="mega">
					<button type="button" class={`mega__trigger${inCatalog ? ' mega__trigger--active' : ''}`} aria-expanded="false" id="mega-btn" aria-current={inCatalog ? 'page' : undefined}>
						Каталог
						<svg width="12" height="12" viewBox="0 0 12 12" fill="none">
							<path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<div class="mega__panel" id="mega-panel" hidden>
						<div class="mega__groups">
							{
								navGroups.map((group) => (
									<section class="mega__group">
										<header class="mega__group-head">
											<span class="mega__group-title">{group.title}</span>
											{group.hint && <span class="mega__group-hint">{group.hint}</span>}
										</header>
										<ul class="mega__group-list">
											{group.items.map((item) => {
												const active = isActive(item.href);
												return (
													<li class={`mega__item-wrap${item.empty ? ' mega__item-wrap--empty' : ''}${active ? ' mega__item-wrap--active' : ''}`}>
														<a class="mega__item" href={item.href} aria-current={active ? 'page' : undefined}>
															<span class="mega__item-row">
																<span class="mega__item-name">{item.title}</span>
																{item.empty && <span class="mega__hint">по запросу</span>}
															</span>
															{item.meta && <span class="mega__item-meta">{item.meta}</span>}
														</a>
													</li>
												);
											})}
										</ul>
									</section>
								))
							}
						</div>
						<div class="mega__svc">
							<span class="mega__svc-title">Услуги</span>
							<ul>
								{
									navServices.map((s) => (
										<li>
											<a class={isActive(s.href) ? 'mega__svc-link--active' : ''} href={s.href} aria-current={isActive(s.href) ? 'page' : undefined}>{s.label}</a>
										</li>
									))
								}
							</ul>
						</div>
					</div>
				</div>
				{navTop.map((l) => (
					<a
						class={`head__link${isActive(l.href) ? ' head__link--active' : ''}`}
						href={l.href}
						aria-current={isActive(l.href) ? 'page' : undefined}
					>
						{l.label}
					</a>
				))}
				<a
					class={`head__link${inServices ? ' head__link--active' : ''}`}
					href="/uslugi/"
					aria-current={inServices ? 'page' : undefined}
				>
					Услуги
				</a>
			</nav>
			<div class="head__cta">
				<Button href="/zapros-kp/#lead-form" variant="ghost" size="sm">Заявка</Button>
				<Button href="/zapros-kp/" variant="primary" size="sm">Запросить цену</Button>
			</div>
		</div>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const drawer = document.getElementById('nav-drawer');
	const megaBtn = document.getElementById('mega-btn');
	const megaPanel = document.getElementById('mega-panel');

	const backdrop = document.querySelector('[data-nav-backdrop]');
	const closeDrawer = () => {
		drawer?.classList.remove('head__nav-wrap--open');
		backdrop?.classList.remove('head__nav-backdrop--open');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.style.overflow = '';
	};

	toggle?.addEventListener('click', () => {
		const open = drawer?.classList.toggle('head__nav-wrap--open');
		backdrop?.classList.toggle('head__nav-backdrop--open', !!open);
		toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
		document.body.style.overflow = open ? 'hidden' : '';
	});
	backdrop?.addEventListener('click', closeDrawer);

	megaBtn?.addEventListener('click', () => {
		if (!megaPanel || !megaBtn) return;
		const isHidden = megaPanel.hasAttribute('hidden');
		if (isHidden) {
			megaPanel.removeAttribute('hidden');
			megaBtn.setAttribute('aria-expanded', 'true');
		} else {
			megaPanel.setAttribute('hidden', '');
			megaBtn.setAttribute('aria-expanded', 'false');
		}
	});

	document.addEventListener('click', (e) => {
		if (!megaPanel || !megaBtn) return;
		const target = e.target as Node;
		// На мобиле мегапанель — часть drawer'а; не закрываем её при клике внутри drawer.
		if (drawer?.contains(target)) return;
		if (!megaPanel.contains(target) && !megaBtn.contains(target)) {
			megaPanel.setAttribute('hidden', '');
			megaBtn.setAttribute('aria-expanded', 'false');
		}
	});

	// Закрываем drawer при клике на любую ссылку внутри — иначе пользователь
	// нажал ссылку, ушёл на новую страницу, drawer открылся обратно (но скролл body
	// остался заблокированным до релоада).
	drawer?.querySelectorAll('a').forEach((a) => {
		a.addEventListener('click', () => {
			if (drawer.classList.contains('head__nav-wrap--open')) closeDrawer();
		});
	});

	// Esc закрывает drawer
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && drawer?.classList.contains('head__nav-wrap--open')) closeDrawer();
	});
</script>

<style>
	.head {
		position: sticky;
		top: 0;
		z-index: 40;
		background: #ffffff;
		border-bottom: 1px solid var(--color-border);
		/* backdrop-filter здесь использовался для «glassmorphism» эффекта,
		   но он создаёт новый containing block для position:fixed детей —
		   из-за этого мобильный drawer прилипал к шапке вместо viewport.
		   Полностью убран. */
	}

	.head__strip {
		display: none;
		background: var(--color-primary-600);
		color: var(--color-on-dark-muted);
		font-size: 0.8rem;
	}
	@media (min-width: 768px) {
		.head__strip {
			display: block;
		}
	}
	.head__strip-inner {
		display: flex;
		align-items: center;
		gap: var(--space-5);
		min-height: var(--header-strip-h);
	}
	.head__location {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-right: auto;
	}
	.head__location svg {
		opacity: 0.75;
	}
	.head__strip-link {
		color: var(--color-on-dark);
		text-decoration: none;
		font-weight: 500;
	}
	.head__strip-link:hover {
		color: #fff;
		text-decoration: underline;
	}

	.head__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		min-height: var(--header-h);
	}
	.head__brand {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-width: 0;
	}
	.head__logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		text-decoration: none;
		color: var(--color-text);
	}
	.head__logo:hover {
		color: var(--color-primary-500);
		text-decoration: none;
	}
	.head__logo-img {
		width: 44px;
		height: 44px;
		object-fit: contain;
		display: block;
		flex-shrink: 0;
	}
	.head__logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}
	.head__logo-name {
		font-weight: 700;
		font-size: 1.05rem;
		letter-spacing: -0.015em;
	}
	.head__logo-tag {
		font-size: 0.72rem;
		color: var(--color-muted);
		font-weight: 500;
		margin-top: 2px;
	}
	@media (max-width: 480px) {
		.head__logo-tag {
			display: none;
		}
	}

	.head__mob-phone {
		display: none;
		width: 40px;
		height: 40px;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-md);
		background: var(--color-primary-50);
		color: var(--color-primary-500);
	}
	@media (max-width: 1023px) {
		.head__mob-phone {
			display: inline-flex;
		}
	}

	.head__burger {
		display: none;
		background: none;
		border: 0;
		padding: var(--space-2);
		cursor: pointer;
		color: var(--color-text);
	}
	.head__burger-icon {
		display: block;
		width: 22px;
		height: 2px;
		background: currentColor;
		border-radius: 1px;
		box-shadow:
			0 -7px 0 currentColor,
			0 7px 0 currentColor;
	}

	/* Drawer backdrop — затемнённая подложка под открытым меню. На десктопе скрыт. */
	.head__nav-backdrop {
		display: none;
	}

	@media (max-width: 1023px) {
		.head__burger {
			display: block;
			margin-left: auto;
		}
		.head__nav-backdrop {
			display: block;
			position: fixed;
			top: var(--header-h);
			left: 0;
			right: 0;
			bottom: 0;
			background: rgba(15, 26, 43, 0.55);
			backdrop-filter: blur(2px);
			opacity: 0;
			pointer-events: none;
			transition: opacity var(--dur-base) var(--ease-out);
			z-index: 38;
		}
		.head__nav-backdrop--open {
			opacity: 1;
			pointer-events: auto;
		}
		.head__nav-wrap {
			position: fixed !important;
			top: var(--header-h);
			right: 0;
			bottom: 0;
			left: auto;
			width: min(86vw, 360px);
			background: var(--color-surface);
			padding: var(--space-5);
			display: flex !important;
			flex-direction: column;
			gap: var(--space-4);
			overflow-y: auto;
			-webkit-overflow-scrolling: touch;
			transform: translateX(100%);
			transition: transform var(--dur-base) var(--ease-out);
			z-index: 39;
			box-shadow: -12px 0 28px rgba(15, 26, 43, 0.18);
			border-left: 1px solid var(--color-border);
		}
		.head__nav-wrap--open {
			transform: translateX(0);
		}
		/* Внутри drawer — пункты в столбик, чтобы было читаемо */
		.head__nav-wrap .head__nav {
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			width: 100%;
		}
		.head__nav-wrap .head__link {
			display: block;
			padding: var(--space-3) 0;
			border-bottom: 1px solid var(--color-border);
			font-size: 1rem;
			border-left: 0;
		}
		.head__nav-wrap .head__link--active {
			border-bottom-color: var(--color-primary-500);
		}
		.head__nav-wrap .mega {
			border-bottom: 1px solid var(--color-border);
		}
		.head__nav-wrap .mega__trigger {
			width: 100%;
			justify-content: space-between;
			padding: var(--space-3) 0;
			font-size: 1rem;
		}
	}
	@media (min-width: 1024px) {
		.head__nav-wrap {
			display: flex;
			align-items: center;
			gap: var(--space-5);
			flex: 1;
			justify-content: flex-end;
		}
	}

	.head__nav {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2) var(--space-5);
	}
	.head__link {
		color: var(--color-text);
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		padding: 0.4rem 0;
		border-bottom: 2px solid transparent;
		transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
	}
	.head__link:hover {
		color: var(--color-primary-500);
		border-bottom-color: var(--color-primary-500);
		text-decoration: none;
	}
	.head__link--active {
		color: var(--color-primary-600);
		border-bottom-color: var(--color-primary-500);
	}

	.mega {
		position: relative;
	}
	.mega__trigger {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		background: none;
		border: 0;
		font: inherit;
		font-weight: 600;
		font-size: 0.95rem;
		cursor: pointer;
		color: var(--color-text);
		padding: 0.4rem 0;
	}
	.mega__trigger:hover {
		color: var(--color-primary-500);
	}
	.mega__trigger--active {
		color: var(--color-primary-600);
		position: relative;
	}
	.mega__trigger--active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 16px;
		bottom: -2px;
		height: 2px;
		background: var(--color-primary-500);
		border-radius: 2px;
	}
	.mega__panel {
		position: absolute;
		top: calc(100% + 14px);
		left: -1rem;
		min-width: min(94vw, 980px);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		padding: var(--space-5) var(--space-6) var(--space-4);
	}
	.mega__panel[hidden] { display: none; }
	@media (max-width: 1023px) {
		.mega__panel {
			position: static;
			min-width: 0;
			box-shadow: none;
			border: 1px solid var(--color-border);
			padding: var(--space-4);
			margin-top: var(--space-3);
		}
	}

	/* Структурированные группы каталога — 4 колонки на десктопе */
	.mega__groups {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-5) var(--space-6);
	}
	.mega__group { min-width: 0; }
	.mega__group-head {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		padding-bottom: var(--space-2);
		margin-bottom: var(--space-3);
		border-bottom: 1px solid var(--color-border);
	}
	.mega__group-title {
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-600);
	}
	.mega__group-hint {
		font-size: 0.78rem;
		color: var(--color-subtle);
		font-weight: 400;
	}
	.mega__group-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.mega__item-wrap { margin: 0; }
	.mega__item {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 0.45rem 0.55rem;
		margin-left: -0.55rem;
		margin-right: -0.55rem;
		border-radius: var(--radius-sm);
		text-decoration: none;
		color: var(--color-text);
		transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
	}
	.mega__item:hover {
		background: var(--color-primary-50);
		color: var(--color-primary-600);
		text-decoration: none;
	}
	.mega__item-wrap--active .mega__item {
		background: var(--color-primary-50);
		color: var(--color-primary-600);
		box-shadow: inset 3px 0 0 var(--color-primary-500);
	}
	.mega__item-wrap--active .mega__item-name {
		color: var(--color-primary-600);
		font-weight: 700;
	}
	.mega__svc-link--active {
		color: var(--color-primary-600) !important;
		background: var(--color-primary-50) !important;
		font-weight: 600;
	}
	.mega__item-row {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-weight: 600;
		font-size: 0.92rem;
		line-height: 1.25;
	}
	.mega__item-name { color: inherit; }
	.mega__item-meta {
		font-size: 0.76rem;
		color: var(--color-subtle);
		line-height: 1.3;
	}
	.mega__item:hover .mega__item-meta { color: var(--color-muted); }

	/* «По запросу» — тоньше, но не выглядит «выключенным» */
	.mega__item-wrap--empty .mega__item-name { color: var(--color-muted); }
	.mega__item-wrap--empty .mega__item:hover .mega__item-name { color: var(--color-primary-600); }
	.mega__hint {
		display: inline-block;
		font-size: 0.62rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-accent);
		background: var(--color-accent-100);
		padding: 0.1rem 0.4rem;
		border-radius: var(--radius-pill);
		vertical-align: middle;
		white-space: nowrap;
	}

	.mega__svc {
		margin-top: var(--space-5);
		padding-top: var(--space-4);
		border-top: 1px solid var(--color-border);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3) var(--space-5);
	}
	.mega__svc-title {
		font-weight: 700;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-primary-600);
	}
	.mega__svc ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.5rem;
		font-size: 0.88rem;
	}
	.mega__svc a {
		color: var(--color-muted);
		text-decoration: none;
		padding: 0.25rem 0.6rem;
		border-radius: var(--radius-pill);
		background: var(--color-bg-elev);
		transition: all var(--dur-fast) var(--ease-out);
	}
	.mega__svc a:hover {
		color: var(--color-primary-600);
		background: var(--color-primary-50);
		text-decoration: none;
	}

	.head__cta {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}
	@media (max-width: 1023px) {
		.head__cta {
			margin-top: var(--space-4);
			padding-top: var(--space-4);
			border-top: 1px solid var(--color-border);
		}
	}
</style>
