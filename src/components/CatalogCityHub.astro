---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaSection from './CtaSection.astro';
import PriceTable from './PriceTable.astro';
import type { CityInfo } from '../data/cities';
import { contacts } from '../data/site';

interface Props {
	hub:
		| 'list'
		| 'krug'
		| 'truba'
		| 'polosa'
		| 'rulon'
		| 'provoloka'
		| 'detali-truboprovoda'
		| 'ugolok-shveller';
	hubLabel: string; // «Лист нержавеющий»
	hubLabelGenitive: string; // «листа нержавеющего»
	hubHref: string; // /list/
	measure: 'толщина' | 'диаметр' | 'размер' | 'Ø × стенка';
	city: CityInfo;
}
const { hub, hubLabel, hubLabelGenitive, hubHref, measure, city } = Astro.props;

const title = `${hubLabel} в ${city.loc} — купить с доставкой из Нижнего Новгорода`;
const description = `${hubLabel} с доставкой в ${city.from}. Отправка ${city.transit}, попутный транспорт и собственные машины. Сертификаты завода, отгрузка из НН. ${contacts.phone}.`;
const h1 = `${hubLabel} в ${city.loc}`;
const intro = `Поставляем ${hubLabelGenitive.toLowerCase()} в ${city.from} со склада в Нижнем Новгороде. Расстояние ${city.distance.toLocaleString('ru-RU')} км, типовой срок доставки — ${city.transit}. Прайс ниже актуален для отгрузки в ${city.from} — цены те же, что и для других регионов России, доставка считается отдельно.`;

const breadcrumbs = [
	{ label: 'Главная', href: '/' },
	{ label: hubLabel, href: hubHref },
	{ label: `в ${city.loc}` },
];
---

<BaseLayout title={title} description={description} type="website">
	<div class="container city">
		<Breadcrumbs items={breadcrumbs} />
		<h1>{h1}</h1>
		<p class="city__intro">{intro}</p>

		<section class="city__delivery">
			<h2>Доставка в {city.from}</h2>
			<dl class="city__facts">
				<div>
					<dt>Расстояние от склада</dt>
					<dd>{city.distance.toLocaleString('ru-RU')} км (Нижний Новгород)</dd>
				</div>
				<div>
					<dt>Срок доставки</dt>
					<dd>{city.transit}</dd>
				</div>
				{city.region && (
					<div>
						<dt>Регион</dt>
						<dd>{city.region}</dd>
					</div>
				)}
			</dl>
			<ul class="city__highlights">
				{city.highlights.map((h) => <li>{h}</li>)}
			</ul>
		</section>

		<PriceTable hub={hub} title={`Прайс на ${hubLabelGenitive.toLowerCase()}`} measure={measure} />

		<CtaSection
			title={`Нужен ${hubLabel.toLowerCase()} в ${city.loc}?`}
			text="Оставьте заявку — подтвердим наличие, рассчитаем доставку и пришлём документы."
		/>
	</div>
</BaseLayout>

<style>
	.city { padding-block: var(--space-8); }
	.city__intro {
		font-size: 1.05rem;
		max-width: 70ch;
		margin-bottom: var(--space-6);
	}
	.city__delivery {
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		padding: var(--space-5);
		margin-bottom: var(--space-6);
	}
	.city__delivery h2 {
		margin-top: 0;
		font-size: 1.15rem;
	}
	.city__facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: var(--space-4);
		margin: 0 0 var(--space-4);
	}
	.city__facts dt {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-subtle);
		margin-bottom: 0.2rem;
	}
	.city__facts dd {
		margin: 0;
		font-weight: 600;
		color: var(--color-text);
	}
	.city__highlights {
		margin: 0;
		padding-left: 1.2rem;
		color: var(--color-muted);
		max-width: 70ch;
		display: grid;
		gap: var(--space-2);
	}
</style>
