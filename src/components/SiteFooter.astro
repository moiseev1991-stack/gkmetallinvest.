---
import { navCatalog, navServices } from '../data/navigation';
import { contacts, siteName } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => {
	if (href === '/') return path === '/';
	const norm = href.endsWith('/') ? href : href + '/';
	return path === norm || path.startsWith(norm);
};
---

<footer class="foot">
	<div class="container foot__top">
		<div class="foot__brand">
			<a class="foot__logo" href="/" aria-label={siteName}>
				<img class="foot__logo-img" src="/img/logo.png" alt={siteName} width="44" height="44" />
				<span class="foot__logo-text">
					<span class="foot__title">{siteName}</span>
					<span class="foot__tag">нержавеющий металлопрокат</span>
				</span>
			</a>
			<p class="foot__about">Поставка нержавеющего металлопроката от листа до проволоки. Резка, перфорация, доставка по всей России.</p>
			<address class="foot__addr">
				{contacts.address}
				<br />
				<span>{contacts.company} · ИНН {contacts.inn}</span>
			</address>
		</div>

		<div class="foot__col">
			<span class="foot__h">Каталог</span>
			<ul>
				{
					navCatalog.map((c) => (
						<li>
							<a class={isActive(c.href) ? 'foot__link--active' : ''} href={c.href} aria-current={isActive(c.href) ? 'page' : undefined}>{c.title}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="foot__col">
			<span class="foot__h">Услуги</span>
			<ul>
				{
					navServices.map((s) => (
						<li>
							<a class={isActive(s.href) ? 'foot__link--active' : ''} href={s.href} aria-current={isActive(s.href) ? 'page' : undefined}>{s.label}</a>
						</li>
					))
				}
			</ul>
		</div>

		<div class="foot__col">
			<span class="foot__h">Информация</span>
			<ul>
				{[
					{ href: '/o-kompanii/', label: 'О компании' },
					{ href: '/dostavka-i-oplata/', label: 'Доставка и оплата' },
					{ href: '/kontakty/', label: 'Контакты' },
					{ href: '/zapros-kp/', label: 'Запросить КП' },
					{ href: '/kalkulyator-vesa/', label: 'Калькулятор веса' },
					{ href: '/karta-sayta/', label: 'Карта сайта' },
				].map((l) => (
					<li><a class={isActive(l.href) ? 'foot__link--active' : ''} href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
				))}
			</ul>
			<p class="foot__contact">
				<a href={`tel:${contacts.phoneTel}`} class="foot__phone">{contacts.phone}</a>
				<a href={`mailto:${contacts.email}`}>{contacts.email}</a>
			</p>
		</div>
	</div>

	<div class="foot__legal">
		<div class="container foot__legal-inner">
			<span>© {new Date().getFullYear()} {siteName}. Все права защищены.</span>
			<span class="foot__legal-links">
				<a href="/politika-konfidencialnosti/">Политика обработки ПДн</a>
				<a href="/soglasie/">Согласие на обработку ПДн</a>
				<a href="/cookies/">Использование cookie</a>
				<a href="/publichnaya-oferta/">Публичная оферта</a>
				<a href="/sertifikaty/">Сертификаты</a>
				<a href="/karta-sayta/">Карта сайта</a>
			</span>
		</div>
	</div>
</footer>

<style>
	.foot {
		margin-top: var(--space-16);
		background: #0a1f3d;
		background-image: linear-gradient(180deg, #0a1f3d 0%, #0e2a52 100%);
		color: var(--color-on-dark-muted);
		position: relative;
		overflow: hidden;
	}
	.foot::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		transform: translateX(-50%);
		width: 60%;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(244, 162, 97, 0.5), transparent);
	}
	.foot__top {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1.2fr;
		gap: var(--space-8);
		padding-top: var(--space-12);
		padding-bottom: var(--space-10);
	}
	@media (max-width: 1024px) {
		.foot__top {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-7) var(--space-8);
		}
		.foot__brand {
			grid-column: 1 / -1;
		}
	}
	@media (max-width: 540px) {
		.foot__top {
			grid-template-columns: 1fr;
			gap: var(--space-6);
		}
	}

	.foot__logo {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		margin-bottom: var(--space-3);
		text-decoration: none;
		color: #fff;
	}
	.foot__logo:hover { color: #fff; text-decoration: none; }
	.foot__logo-img {
		width: 44px;
		height: 44px;
		object-fit: contain;
		display: block;
		flex-shrink: 0;
		filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
	}
	.foot__logo-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}
	.foot__title {
		color: #fff;
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	.foot__tag {
		color: var(--color-on-dark-muted);
		font-size: 0.72rem;
		font-weight: 500;
		margin-top: 2px;
	}
	.foot__about {
		font-size: 0.9rem;
		max-width: 38ch;
		color: var(--color-on-dark-muted);
		line-height: 1.6;
		margin-bottom: var(--space-4);
	}
	.foot__addr {
		font-size: 0.85rem;
		color: var(--color-on-dark-muted);
		font-style: normal;
		line-height: 1.6;
	}
	.foot__addr span {
		color: var(--color-subtle);
	}

	.foot__col {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}
	.foot__h {
		display: block;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: #fff;
	}
	.foot ul {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		font-size: 0.9rem;
	}
	.foot a {
		color: var(--color-on-dark-muted);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out);
		overflow-wrap: anywhere;
	}
	.foot a:hover {
		color: #fff;
		text-decoration: none;
	}
	.foot__link--active {
		color: #fff;
		font-weight: 600;
		position: relative;
		padding-left: 12px;
	}
	.foot__link--active::before {
		content: '';
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--color-accent, #c4651b);
	}
	.foot__contact {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
		margin: 0;
		font-size: 0.9rem;
		max-width: none;
	}
	.foot__phone {
		color: #fff;
		font-weight: 600;
		font-size: 1.05rem;
	}

	.foot__legal {
		border-top: 1px solid rgba(255, 255, 255, 0.08);
		padding: var(--space-5) 0;
		font-size: 0.82rem;
	}
	.foot__legal-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: center;
		gap: var(--space-3);
	}
	.foot__legal-links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-4);
	}
</style>
