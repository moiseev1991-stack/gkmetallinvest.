---
import Button from './ui/Button.astro';
interface Props {
	title: string;
	text?: string;
}
const { title, text } = Astro.props;
---

<section class="cta">
	<div class="container cta__inner">
		<div>
			<h2 class="cta__title">{title}</h2>
			{text && <p class="cta__text">{text}</p>}
		</div>
		<div class="cta__actions">
			<Button href="/zapros-kp/">Запросить КП</Button>
			<Button href={`tel:+78312812660`} variant="secondary">Позвонить</Button>
		</div>
	</div>
</section>

<style>
	.cta {
		padding: var(--space-8) 0;
		background: linear-gradient(135deg, var(--color-accent-subtle), transparent);
		border-block: 1px solid var(--color-border);
	}
	.cta__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-6);
	}
	.cta__title {
		margin-bottom: var(--space-2);
		font-size: 1.35rem;
	}
	.cta__text {
		margin: 0;
		max-width: 42ch;
	}
	.cta__actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-3);
	}
</style>
